{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.reactive/schemas/reactive-plan.schema.json",
  "title": "Reactive Plan V2",
  "description": "The redesign runtime plan serialized by ReactivePlan.Render()",
  "type": "object",
  "required": ["version", "planId", "contracts", "objects", "bindings", "workflows"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "planId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/CapabilityContract" }
    },
    "objects": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/RuntimeObject" }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/FieldBinding" }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/Workflow" }
    }
  },
  "$defs": {
    "CapabilityContract": {
      "type": "object",
      "required": ["kind", "resolver", "members"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["component", "element", "event-object", "service"]
        },
        "resolver": {
          "type": "string",
          "enum": ["native-element", "fusion-instance", "event-object", "context-object"]
        },
        "members": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ContractMember" }
        },
        "events": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/EventContract" }
        }
      }
    },
    "ContractMember": {
      "oneOf": [
        { "$ref": "#/$defs/PropertyMember" },
        { "$ref": "#/$defs/MethodMember" }
      ]
    },
    "PropertyMember": {
      "type": "object",
      "required": ["kind", "path", "shape", "access"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "property" },
        "path": {
          "type": "array",
          "items": { "$ref": "#/$defs/PathSegment" }
        },
        "shape": { "$ref": "#/$defs/ValueShape" },
        "access": {
          "type": "string",
          "enum": ["read", "write", "readwrite"]
        }
      }
    },
    "MethodMember": {
      "type": "object",
      "required": ["kind", "path"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "method" },
        "path": {
          "type": "array",
          "items": { "$ref": "#/$defs/PathSegment" }
        },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValueShape" }
        },
        "returns": {
          "oneOf": [
            { "$ref": "#/$defs/ValueShape" },
            { "const": "void" }
          ]
        }
      }
    },
    "EventContract": {
      "type": "object",
      "required": ["channel"],
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "eventObject": { "$ref": "#/$defs/EventObjectReference" },
        "data": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ValueExpr" }
        }
      }
    },
    "EventObjectReference": {
      "type": "object",
      "required": ["contract"],
      "additionalProperties": false,
      "properties": {
        "contract": { "type": "string", "minLength": 1 }
      }
    },
    "RuntimeObject": {
      "type": "object",
      "required": ["contract"],
      "additionalProperties": false,
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "elementId": { "type": "string", "minLength": 1 }
      }
    },
    "FieldBinding": {
      "type": "object",
      "required": ["object", "valueMember", "shape"],
      "additionalProperties": false,
      "properties": {
        "object": { "type": "string", "minLength": 1 },
        "valueMember": { "type": "string", "minLength": 1 },
        "shape": { "$ref": "#/$defs/ValueShape" }
      }
    },
    "ValueShape": {
      "oneOf": [
        { "$ref": "#/$defs/ScalarValueShape" },
        { "$ref": "#/$defs/ArrayValueShape" },
        { "$ref": "#/$defs/ObjectValueShape" },
        { "$ref": "#/$defs/AnyValueShape" }
      ]
    },
    "ScalarValueShape": {
      "type": "object",
      "required": ["kind", "type"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "scalar" },
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "date", "raw"]
        }
      }
    },
    "ArrayValueShape": {
      "type": "object",
      "required": ["kind", "item"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "array" },
        "item": { "$ref": "#/$defs/ValueShape" }
      }
    },
    "ObjectValueShape": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "object" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ValueShape" }
        },
        "additional": { "type": "boolean" }
      }
    },
    "AnyValueShape": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "any" }
      }
    },
    "ValueExpr": {
      "oneOf": [
        { "$ref": "#/$defs/LiteralValueExpr" },
        { "$ref": "#/$defs/BindingValueExpr" },
        { "$ref": "#/$defs/MemberValueExpr" },
        { "$ref": "#/$defs/ContextValueExpr" },
        { "$ref": "#/$defs/ObjectValueExpr" },
        { "$ref": "#/$defs/ArrayValueExpr" },
        { "$ref": "#/$defs/ConvertValueExpr" }
      ]
    },
    "LiteralValueExpr": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "literal" },
        "value": {}
      }
    },
    "BindingValueExpr": {
      "type": "object",
      "required": ["kind", "binding"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "binding" },
        "binding": { "type": "string", "minLength": 1 }
      }
    },
    "MemberValueExpr": {
      "type": "object",
      "required": ["kind", "object", "member"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "member" },
        "object": { "type": "string", "minLength": 1 },
        "member": { "type": "string", "minLength": 1 }
      }
    },
    "ContextValueExpr": {
      "type": "object",
      "required": ["kind", "scope"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "context" },
        "scope": {
          "type": "string",
          "enum": ["event", "response", "request", "local"]
        },
        "path": {
          "type": "array",
          "items": { "$ref": "#/$defs/PathSegment" }
        }
      }
    },
    "ObjectValueExpr": {
      "type": "object",
      "required": ["kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "object" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ValueExpr" }
        }
      }
    },
    "ArrayValueExpr": {
      "type": "object",
      "required": ["kind", "items"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "array" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValueExpr" }
        }
      }
    },
    "ConvertValueExpr": {
      "type": "object",
      "required": ["kind", "value", "to"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "convert" },
        "value": { "$ref": "#/$defs/ValueExpr" },
        "to": { "$ref": "#/$defs/ValueShape" }
      }
    },
    "BindingMapValueExpr": {
      "type": "object",
      "required": ["kind", "include"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "binding-map" },
        "include": {
          "oneOf": [
            { "const": "all" },
            {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        }
      }
    },
    "PlanPredicate": {
      "oneOf": [
        { "$ref": "#/$defs/ComparePredicate" },
        { "$ref": "#/$defs/AllPredicate" },
        { "$ref": "#/$defs/AnyPredicate" },
        { "$ref": "#/$defs/NotPredicate" },
        { "$ref": "#/$defs/ConfirmPredicate" }
      ]
    },
    "ComparePredicate": {
      "type": "object",
      "required": ["kind", "left", "op"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "compare" },
        "left": { "$ref": "#/$defs/ValueExpr" },
        "op": {
          "type": "string",
          "enum": [
            "eq", "neq", "gt", "gte", "lt", "lte",
            "truthy", "falsy", "is-null", "not-null",
            "is-empty", "not-empty",
            "in", "not-in", "between",
            "array-contains",
            "contains", "starts-with", "ends-with", "matches", "min-length"
          ]
        },
        "right": { "$ref": "#/$defs/ValueExpr" },
        "as": { "$ref": "#/$defs/ValueShape" },
        "itemAs": { "$ref": "#/$defs/ValueShape" }
      }
    },
    "AllPredicate": {
      "type": "object",
      "required": ["kind", "terms"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "all" },
        "terms": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanPredicate" }
        }
      }
    },
    "AnyPredicate": {
      "type": "object",
      "required": ["kind", "terms"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "any" },
        "terms": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanPredicate" }
        }
      }
    },
    "NotPredicate": {
      "type": "object",
      "required": ["kind", "term"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "not" },
        "term": { "$ref": "#/$defs/PlanPredicate" }
      }
    },
    "ConfirmPredicate": {
      "type": "object",
      "required": ["kind", "message"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "confirm" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "Workflow": {
      "type": "object",
      "required": ["when", "run"],
      "additionalProperties": false,
      "properties": {
        "when": { "$ref": "#/$defs/PlanSubscription" },
        "run": { "$ref": "#/$defs/PlanAction" }
      }
    },
    "PlanSubscription": {
      "oneOf": [
        { "$ref": "#/$defs/DomReadySubscription" },
        { "$ref": "#/$defs/DocumentEventSubscription" },
        { "$ref": "#/$defs/ObjectEventSubscription" },
        { "$ref": "#/$defs/ServerPushSubscription" },
        { "$ref": "#/$defs/SignalRSubscription" }
      ]
    },
    "DomReadySubscription": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "dom-ready" }
      }
    },
    "DocumentEventSubscription": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "document-event" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "ObjectEventSubscription": {
      "type": "object",
      "required": ["kind", "object", "event"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "object-event" },
        "object": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 }
      }
    },
    "ServerPushSubscription": {
      "type": "object",
      "required": ["kind", "url"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "server-push" },
        "url": { "type": "string", "minLength": 1 },
        "eventType": { "type": "string", "minLength": 1 }
      }
    },
    "SignalRSubscription": {
      "type": "object",
      "required": ["kind", "hubUrl", "method"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "signalr" },
        "hubUrl": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "PlanAction": {
      "oneOf": [
        { "$ref": "#/$defs/SequenceAction" },
        { "$ref": "#/$defs/BranchAction" },
        { "$ref": "#/$defs/ParallelAction" },
        { "$ref": "#/$defs/SetAction" },
        { "$ref": "#/$defs/CallAction" },
        { "$ref": "#/$defs/DispatchAction" },
        { "$ref": "#/$defs/RequestAction" },
        { "$ref": "#/$defs/InjectAction" },
        { "$ref": "#/$defs/ShowValidationErrorsAction" }
      ]
    },
    "SequenceAction": {
      "type": "object",
      "required": ["kind", "steps"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "sequence" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanAction" }
        }
      }
    },
    "BranchAction": {
      "type": "object",
      "required": ["kind", "cases"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "branch" },
        "cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/BranchCase" }
        }
      }
    },
    "BranchCase": {
      "type": "object",
      "required": ["run"],
      "additionalProperties": false,
      "properties": {
        "when": { "$ref": "#/$defs/PlanPredicate" },
        "run": { "$ref": "#/$defs/PlanAction" }
      }
    },
    "ParallelAction": {
      "type": "object",
      "required": ["kind", "steps"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "parallel" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanAction" }
        },
        "onSettled": { "$ref": "#/$defs/PlanAction" }
      }
    },
    "SetAction": {
      "type": "object",
      "required": ["kind", "target", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "set" },
        "target": { "$ref": "#/$defs/ActionTarget" },
        "value": { "$ref": "#/$defs/ValueExpr" }
      }
    },
    "CallAction": {
      "type": "object",
      "required": ["kind", "target"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "call" },
        "target": { "$ref": "#/$defs/ActionTarget" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValueExpr" }
        }
      }
    },
    "DispatchAction": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "dispatch" },
        "name": { "type": "string", "minLength": 1 },
        "detail": { "$ref": "#/$defs/ValueExpr" }
      }
    },
    "RequestAction": {
      "type": "object",
      "required": ["kind", "request"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "request" },
        "request": { "$ref": "#/$defs/RequestPlan" }
      }
    },
    "InjectAction": {
      "type": "object",
      "required": ["kind", "object"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "inject" },
        "object": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/ValueExpr" }
      }
    },
    "ShowValidationErrorsAction": {
      "type": "object",
      "required": ["kind", "formId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "show-validation-errors" },
        "formId": { "type": "string", "minLength": 1 }
      }
    },
    "ActionTarget": {
      "type": "object",
      "required": ["object", "member"],
      "additionalProperties": false,
      "properties": {
        "object": { "type": "string", "minLength": 1 },
        "member": { "type": "string", "minLength": 1 }
      }
    },
    "RequestPlan": {
      "type": "object",
      "required": ["method", "url"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE"]
        },
        "url": { "type": "string" },
        "input": { "$ref": "#/$defs/RequestInput" },
        "validation": { "$ref": "#/$defs/RequestValidation" },
        "before": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanAction" }
        },
        "onSuccess": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResponseHandlerPlan" }
        },
        "onError": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResponseHandlerPlan" }
        },
        "onSettled": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanAction" }
        },
        "next": { "$ref": "#/$defs/RequestPlan" }
      }
    },
    "RequestInput": {
      "type": "object",
      "required": ["transport", "value"],
      "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["query", "json", "form-data"]
        },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/ValueExpr" },
            { "$ref": "#/$defs/BindingMapValueExpr" }
          ]
        }
      }
    },
    "RequestValidation": {
      "type": "object",
      "required": ["formId", "fields"],
      "additionalProperties": false,
      "properties": {
        "formId": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/RequestValidationField" }
        }
      }
    },
    "RequestValidationField": {
      "type": "object",
      "required": ["binding", "rules"],
      "additionalProperties": false,
      "properties": {
        "binding": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/RequestValidationRule" }
        }
      }
    },
    "RequestValidationRule": {
      "type": "object",
      "required": ["rule", "message"],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "required", "empty",
            "minLength", "maxLength",
            "email", "regex", "url", "creditCard",
            "range", "exclusiveRange",
            "min", "max", "gt", "lt",
            "equalTo", "notEqual", "notEqualTo",
            "atLeastOne"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "constraint": {},
        "otherBinding": { "type": "string", "minLength": 1 },
        "as": { "$ref": "#/$defs/ValueShape" },
        "when": { "$ref": "#/$defs/PlanPredicate" }
      }
    },
    "ResponseHandlerPlan": {
      "type": "object",
      "required": ["run"],
      "additionalProperties": false,
      "properties": {
        "statusCode": { "type": "integer" },
        "run": { "$ref": "#/$defs/PlanAction" }
      }
    },
    "PathSegment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["prop"],
          "additionalProperties": false,
          "properties": {
            "prop": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["index"],
          "additionalProperties": false,
          "properties": {
            "index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
