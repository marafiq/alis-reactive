{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.reactive/schemas/reactive-plan.schema.json",
  "title": "Reactive Plan",
  "description": "The runtime plan produced by the domain model and executed by the browser runtime.",
  "type": "object",
  "required": ["version", "planId", "types", "components", "behaviors"],
  "properties": {
    "version": { "const": 3 },
    "planId": { "type": "string", "minLength": 1 },
    "partId": { "type": "string", "minLength": 1 },
    "types": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/JsType" }
    },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Component" }
    },
    "behaviors": {
      "type": "array",
      "items": { "$ref": "#/$defs/Behavior" }
    }
  },
  "$defs": {
    "JsType": {
      "type": "object",
      "required": ["properties", "methods", "events"],
      "properties": {
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Property" }
        },
        "methods": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Method" }
        },
        "events": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Event" }
        }
      }
    },
    "Property": {
      "type": "object",
      "required": ["path", "shape", "access"],
      "properties": {
        "path": { "$ref": "#/$defs/Path" },
        "shape": { "$ref": "#/$defs/Shape" },
        "access": {
          "type": "string",
          "enum": ["read", "write", "readwrite"]
        }
      }
    },
    "Method": {
      "type": "object",
      "required": ["path", "args", "returns"],
      "properties": {
        "path": { "$ref": "#/$defs/Path" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/Shape" }
        },
        "returns": { "$ref": "#/$defs/Shape" }
      }
    },
    "Event": {
      "type": "object",
      "required": ["channel"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "payloadType": { "type": "string", "minLength": 1 }
      }
    },
    "Component": {
      "type": "object",
      "required": ["id", "vendor", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "vendor": {
          "type": "string",
          "enum": ["native", "fusion"]
        },
        "type": { "type": "string", "minLength": 1 },
        "bindingPath": { "type": "string" },
        "valueMember": { "type": "string" },
        "container": { "$ref": "#/$defs/ContainerScope" }
      }
    },
    "ContainerScope": {
      "type": "object",
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "validationRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComponentValidation" }
        }
      }
    },
    "ComponentValidation": {
      "type": "object",
      "required": ["component", "value", "rules"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/ValueProducer" },
        "serverFieldName": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValidationRule" }
        }
      }
    },
    "ValidationRule": {
      "type": "object",
      "required": ["name", "message"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "required", "empty",
            "minLength", "maxLength",
            "email", "regex", "url", "creditCard",
            "range", "exclusiveRange",
            "min", "max", "gt", "lt",
            "equalTo", "notEqual", "notEqualTo",
            "atLeastOne"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "constraint": { "$ref": "#/$defs/ValueProducer" },
        "otherValue": { "$ref": "#/$defs/ValueProducer" },
        "when": { "$ref": "#/$defs/Condition" },
        "shape": { "$ref": "#/$defs/Shape" }
      }
    },
    "Source": {
      "oneOf": [
        { "$ref": "#/$defs/ComponentSource" },
        { "$ref": "#/$defs/PayloadSource" },
        { "$ref": "#/$defs/UrlSource" },
        { "$ref": "#/$defs/PluginSource" }
      ]
    },
    "ComponentSource": {
      "type": "object",
      "required": ["kind", "component"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "component" },
        "component": { "type": "string", "minLength": 1 }
      }
    },
    "PayloadSource": {
      "type": "object",
      "required": ["kind", "scope"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "payload" },
        "scope": {
          "type": "string",
          "enum": ["event", "success", "error", "request", "dispatch", "local"]
        },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "UrlSource": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "url" }
      }
    },
    "PluginSource": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "plugin" },
        "name": { "type": "string", "minLength": 1, "pattern": "^\\S+$" }
      }
    },
    "Behavior": {
      "type": "object",
      "required": ["startsWhen", "reaction"],
      "properties": {
        "startsWhen": { "$ref": "#/$defs/StartsWhen" },
        "reaction": { "$ref": "#/$defs/Reaction" }
      }
    },
    "StartsWhen": {
      "oneOf": [
        { "$ref": "#/$defs/PageReadyTrigger" },
        { "$ref": "#/$defs/DocumentEventTrigger" },
        { "$ref": "#/$defs/ComponentEventTrigger" },
        { "$ref": "#/$defs/ServerPushTrigger" },
        { "$ref": "#/$defs/SignalRTrigger" }
      ]
    },
    "PageReadyTrigger": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "page-ready" }
      }
    },
    "DocumentEventTrigger": {
      "type": "object",
      "required": ["kind", "event"],
      "properties": {
        "kind": { "const": "document-event" },
        "event": { "type": "string", "minLength": 1 },
        "payloadType": { "type": "string", "minLength": 1 }
      }
    },
    "ComponentEventTrigger": {
      "type": "object",
      "required": ["kind", "component", "event"],
      "properties": {
        "kind": { "const": "component-event" },
        "component": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 }
      }
    },
    "ServerPushTrigger": {
      "type": "object",
      "required": ["kind", "url"],
      "properties": {
        "kind": { "const": "server-push" },
        "url": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "payloadType": { "type": "string", "minLength": 1 }
      }
    },
    "SignalRTrigger": {
      "type": "object",
      "required": ["kind", "hubUrl", "method"],
      "properties": {
        "kind": { "const": "signalr" },
        "hubUrl": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "payloadType": { "type": "string", "minLength": 1 }
      }
    },
    "Reaction": {
      "oneOf": [
        { "$ref": "#/$defs/SequenceReaction" },
        { "$ref": "#/$defs/ParallelReaction" },
        { "$ref": "#/$defs/BranchReaction" },
        { "$ref": "#/$defs/SetReaction" },
        { "$ref": "#/$defs/CallReaction" },
        { "$ref": "#/$defs/RequestReaction" },
        { "$ref": "#/$defs/DispatchReaction" },
        { "$ref": "#/$defs/InjectReaction" },
        { "$ref": "#/$defs/ShowValidationErrorsReaction" }
      ]
    },
    "SequenceReaction": {
      "type": "object",
      "required": ["kind", "steps"],
      "properties": {
        "kind": { "const": "sequence" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reaction" }
        }
      }
    },
    "ParallelReaction": {
      "type": "object",
      "required": ["kind", "steps"],
      "properties": {
        "kind": { "const": "parallel" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reaction" }
        },
        "onSettled": { "$ref": "#/$defs/Reaction" }
      }
    },
    "BranchReaction": {
      "type": "object",
      "required": ["kind", "cases"],
      "properties": {
        "kind": { "const": "branch" },
        "cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/BranchCase" }
        }
      }
    },
    "BranchCase": {
      "type": "object",
      "required": ["reaction"],
      "properties": {
        "when": { "$ref": "#/$defs/Condition" },
        "reaction": { "$ref": "#/$defs/Reaction" }
      }
    },
    "SetReaction": {
      "type": "object",
      "required": ["kind", "on", "property", "value"],
      "properties": {
        "kind": { "const": "set" },
        "on": { "$ref": "#/$defs/Source" },
        "property": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/ValueProducer" }
      }
    },
    "CallReaction": {
      "type": "object",
      "required": ["kind", "on", "method", "args"],
      "properties": {
        "kind": { "const": "call" },
        "on": { "$ref": "#/$defs/Source" },
        "method": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValueProducer" }
        }
      }
    },
    "RequestReaction": {
      "type": "object",
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "request" },
        "request": { "$ref": "#/$defs/Request" }
      }
    },
    "DispatchReaction": {
      "type": "object",
      "required": ["kind", "event", "data"],
      "properties": {
        "kind": { "const": "dispatch" },
        "event": { "type": "string", "minLength": 1 },
        "data": { "$ref": "#/$defs/ValueProducer" },
        "payloadType": { "type": "string", "minLength": 1 }
      }
    },
    "InjectReaction": {
      "type": "object",
      "required": ["kind", "component", "value"],
      "properties": {
        "kind": { "const": "inject" },
        "component": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/ValueProducer" }
      }
    },
    "ShowValidationErrorsReaction": {
      "type": "object",
      "required": ["kind", "container"],
      "properties": {
        "kind": { "const": "show-validation-errors" },
        "container": { "type": "string", "minLength": 1 }
      }
    },
    "Request": {
      "type": "object",
      "required": ["method", "url", "before", "success", "error", "complete", "headers", "routeParams"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]
        },
        "url": { "type": "string" },
        "headers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ValueProducer" }
        },
        "routeParams": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-zA-Z0-9_]+$" },
          "additionalProperties": { "$ref": "#/$defs/ValueProducer" }
        },
        "container": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/RequestInput" },
        "before": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reaction" }
        },
        "success": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResponseHandler" }
        },
        "error": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResponseHandler" }
        },
        "complete": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reaction" }
        },
        "next": { "$ref": "#/$defs/Request" }
      }
    },
    "RequestInput": {
      "oneOf": [
        { "$ref": "#/$defs/GatherInput" },
        { "$ref": "#/$defs/ValueInput" }
      ]
    },
    "GatherInput": {
      "type": "object",
      "required": ["kind", "components", "transport"],
      "properties": {
        "kind": { "const": "gather" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/GatherField" }
        },
        "transport": {
          "type": "string",
          "enum": ["query", "json", "form-data"]
        },
        "statics": { "$ref": "#/$defs/ValueProducer" },
        "includeAll": { "type": "boolean" }
      }
    },
    "ValueInput": {
      "type": "object",
      "required": ["kind", "value", "transport"],
      "properties": {
        "kind": { "const": "value" },
        "value": { "$ref": "#/$defs/ValueProducer" },
        "transport": {
          "type": "string",
          "enum": ["query", "json", "form-data"]
        }
      }
    },
    "GatherField": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/ValueProducer" }
      }
    },
    "ResponseHandler": {
      "type": "object",
      "required": ["reaction"],
      "properties": {
        "status": { "type": "integer" },
        "reaction": { "$ref": "#/$defs/Reaction" }
      }
    },
    "ValueProducer": {
      "oneOf": [
        { "$ref": "#/$defs/LiteralProducer" },
        { "$ref": "#/$defs/ReadProducer" },
        { "$ref": "#/$defs/ObjectProducer" },
        { "$ref": "#/$defs/ArrayProducer" },
        { "$ref": "#/$defs/NoneProducer" }
      ]
    },
    "LiteralProducer": {
      "type": "object",
      "required": ["kind", "value", "shape"],
      "properties": {
        "kind": { "const": "literal" },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "shape": { "$ref": "#/$defs/Shape" }
      }
    },
    "ReadProducer": {
      "type": "object",
      "required": ["kind", "from", "member", "path", "shape", "args"],
      "properties": {
        "kind": { "const": "read" },
        "from": { "$ref": "#/$defs/Source" },
        "member": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/Path" },
        "shape": { "$ref": "#/$defs/Shape" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValueProducer" }
        }
      }
    },
    "ObjectProducer": {
      "type": "object",
      "required": ["kind", "fields", "shape"],
      "properties": {
        "kind": { "const": "object" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ValueProducer" }
        },
        "shape": { "$ref": "#/$defs/Shape" }
      }
    },
    "ArrayProducer": {
      "type": "object",
      "required": ["kind", "items", "shape"],
      "properties": {
        "kind": { "const": "array" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValueProducer" }
        },
        "shape": { "$ref": "#/$defs/Shape" }
      }
    },
    "NoneProducer": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "none" }
      }
    },
    "Condition": {
      "oneOf": [
        { "$ref": "#/$defs/CompareCondition" },
        { "$ref": "#/$defs/AllCondition" },
        { "$ref": "#/$defs/AnyCondition" },
        { "$ref": "#/$defs/NotCondition" },
        { "$ref": "#/$defs/ConfirmCondition" },
        { "$ref": "#/$defs/NoneCondition" }
      ]
    },
    "CompareCondition": {
      "type": "object",
      "required": ["kind", "left", "op", "right", "shape", "itemShape"],
      "properties": {
        "kind": { "const": "compare" },
        "left": { "$ref": "#/$defs/ValueProducer" },
        "op": {
          "type": "string",
          "enum": [
            "eq", "neq", "gt", "gte", "lt", "lte",
            "truthy", "falsy", "is-null", "not-null",
            "is-empty", "not-empty",
            "in", "not-in", "between",
            "array-contains",
            "contains", "starts-with", "ends-with", "matches", "min-length"
          ]
        },
        "right": { "$ref": "#/$defs/ValueProducer" },
        "shape": { "$ref": "#/$defs/Shape" },
        "itemShape": { "$ref": "#/$defs/Shape" }
      }
    },
    "AllCondition": {
      "type": "object",
      "required": ["kind", "terms"],
      "properties": {
        "kind": { "const": "all" },
        "terms": {
          "type": "array",
          "items": { "$ref": "#/$defs/Condition" }
        }
      }
    },
    "AnyCondition": {
      "type": "object",
      "required": ["kind", "terms"],
      "properties": {
        "kind": { "const": "any" },
        "terms": {
          "type": "array",
          "items": { "$ref": "#/$defs/Condition" }
        }
      }
    },
    "NotCondition": {
      "type": "object",
      "required": ["kind", "term"],
      "properties": {
        "kind": { "const": "not" },
        "term": { "$ref": "#/$defs/Condition" }
      }
    },
    "ConfirmCondition": {
      "type": "object",
      "required": ["kind", "message"],
      "properties": {
        "kind": { "const": "confirm" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "NoneCondition": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "none" }
      }
    },
    "Shape": {
      "oneOf": [
        { "$ref": "#/$defs/StringShape" },
        { "$ref": "#/$defs/NumberShape" },
        { "$ref": "#/$defs/BooleanShape" },
        { "$ref": "#/$defs/DateShape" },
        { "$ref": "#/$defs/RawShape" },
        { "$ref": "#/$defs/ArrayShape" },
        { "$ref": "#/$defs/ObjectShape" },
        { "$ref": "#/$defs/NullableShape" },
        { "$ref": "#/$defs/AnyShape" },
        { "$ref": "#/$defs/NoneShape" }
      ]
    },
    "StringShape": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "string" } }
    },
    "NumberShape": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "number" } }
    },
    "BooleanShape": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "boolean" } }
    },
    "DateShape": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "date" } }
    },
    "RawShape": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "raw" } }
    },
    "ArrayShape": {
      "type": "object",
      "required": ["kind", "item"],
      "properties": {
        "kind": { "const": "array" },
        "item": { "$ref": "#/$defs/Shape" }
      }
    },
    "ObjectShape": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "object" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Shape" }
        },
        "additional": { "type": "boolean" }
      }
    },
    "NullableShape": {
      "type": "object",
      "required": ["kind", "inner"],
      "properties": {
        "kind": { "const": "nullable" },
        "inner": { "$ref": "#/$defs/Shape" }
      }
    },
    "AnyShape": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "any" } }
    },
    "NoneShape": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "none" } }
    },
    "Path": {
      "type": "array",
      "items": { "$ref": "#/$defs/PathSegment" }
    },
    "PathSegment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "property" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "index"],
          "properties": {
            "kind": { "const": "index" },
            "index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
