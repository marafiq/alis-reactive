<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <LangVersion>8</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>AlisReactive</PackageId>
        <IsPackable>true</IsPackable>
        <PackageDescription>Core reactive framework for building plan-driven browser UIs with C# fluent builders and JSON-serialized reactive plans.</PackageDescription>
        <PackageTags>reactive;blazor;aspnetcore;fluent-api;plan-driven</PackageTags>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="System.Text.Json" Version="9.*" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Schemas\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Ship JS/CSS as NuGet content files with a configurable output path -->
    <ItemGroup>
        <None Include="assets\js\alis-reactive.js" Pack="true" PackagePath="buildTransitive\assets\js\" />
        <None Include="assets\css\design-system.css" Pack="true" PackagePath="buildTransitive\assets\css\" />
        <None Include="build\Alis.Reactive.targets" Pack="true" PackagePath="buildTransitive\" />
        <None Include="build\Alis.Reactive.targets" Pack="true" PackagePath="build\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alis.Reactive.Fusion" />
        <InternalsVisibleTo Include="Alis.Reactive.Native" />
        <InternalsVisibleTo Include="Alis.Reactive.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.Native.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.Fusion.UnitTests" />
    </ItemGroup>

</Project>
