<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>8</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <PackageDescription>Core reactive framework for building plan-driven browser UIs with C# fluent builders and JSON-serialized reactive plans.</PackageDescription>
        <PackageTags>reactive;blazor;aspnetcore;fluent-api;plan-driven</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Schemas\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Ship the sandbox-built JS/CSS directly so the package and sandbox share one runtime artifact. -->
    <ItemGroup>
        <None Include="..\Alis.Reactive.SandboxApp\wwwroot\js\alis-reactive.js"
              Link="assets\js\alis-reactive.js"
              Pack="true"
              PackagePath="buildTransitive\assets\js\" />
        <None Include="..\Alis.Reactive.SandboxApp\wwwroot\css\design-system.css"
              Link="assets\css\design-system.css"
              Pack="true"
              PackagePath="buildTransitive\assets\css\" />
        <None Include="build\Alis.Reactive.targets" Pack="true" PackagePath="buildTransitive\" />
        <None Include="build\Alis.Reactive.targets" Pack="true" PackagePath="build\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alis.Reactive.Components" />
        <InternalsVisibleTo Include="Alis.Reactive.Fusion" />
        <InternalsVisibleTo Include="Alis.Reactive.Native" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator.UnitTests" />
    </ItemGroup>

    <Target Name="BuildPackagedClientAssets" BeforeTargets="Pack">
        <Exec Command="npm run build:package-assets" WorkingDirectory="$(MSBuildProjectDirectory)\.." />
    </Target>

</Project>
