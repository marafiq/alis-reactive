<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <LangVersion>8</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>AlisReactive</PackageId>
        <IsPackable>true</IsPackable>
        <PackageDescription>Core reactive framework for building plan-driven browser UIs with C# fluent builders and JSON-serialized reactive plans.</PackageDescription>
        <PackageTags>reactive;aspnetcore;mvc;fluent-api;plan-driven</PackageTags>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="System.Text.Json" Version="9.*" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Schemas\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Ship the runtime JS bundle (built by npm in the sibling
         Alis.Reactive.Assets tree). The design-system CSS is shipped separately
         by the AlisReactive.DesignSystem package. The asset is packed under
         BOTH build\ and buildTransitive\:
           build\          : required by packages.config consumers (net48 classic).
           buildTransitive\: required so PackageReference consumers flow the
                             targets + assets through transitive dependencies.
         The copy mechanism is the shared build\AlisReactiveAssets.targets,
         packed under this package's id name so NuGet auto-imports it. -->
    <ItemGroup>
        <!-- npm emits the bundle under dist\ with a literal "dev" version token so
             the sandbox serves it at the same URL pattern a net10 consumer uses
             (~/scripts/alis-reactive.{version}.js). PackagePath strips the "dev"
             token so the NuGet ships the unversioned name; the shared targets
             then writes the consumer's real version on copy-to-wwwroot. -->
        <None Include="$(AlisAssetsDist)\scripts\alis-reactive.dev.js"   Pack="true" PackagePath="build\assets\js\alis-reactive.js" />
        <None Include="$(AlisAssetsDist)\scripts\alis-reactive.dev.js"   Pack="true" PackagePath="buildTransitive\assets\js\alis-reactive.js" />
        <None Include="..\build\AlisReactiveAssets.targets" Pack="true" PackagePath="build\AlisReactive.targets" />
        <None Include="..\build\AlisReactiveAssets.targets" Pack="true" PackagePath="buildTransitive\AlisReactive.targets" />
    </ItemGroup>

    <!-- Verify the JS bundle exists before Pack. The bundle is produced by
         'npm run build:all' from the repo root. Pack does NOT invoke npm;
         consumers do not need Node.js for `dotnet pack`. CI orchestrates
         npm + dotnet as separate steps. -->
    <Target Name="VerifyBundlesExistBeforePack" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('$(AlisAssetsDist)\scripts\alis-reactive.dev.js')"
               Text="alis-reactive.dev.js bundle not found. Run 'npm run build:all' from the repo root before packing." />
    </Target>

    <!-- Bundle Roslyn analyzers so consumers get compile-time DSL checks (ALIS001-ALIS008) -->
    <ItemGroup>
        <None Include="..\Alis.Reactive.Analyzers\bin\$(Configuration)\netstandard2.0\Alis.Reactive.Analyzers.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alis.Reactive.Fusion" />
        <InternalsVisibleTo Include="Alis.Reactive.Native" />
        <InternalsVisibleTo Include="Alis.Reactive.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.Native.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.Fusion.UnitTests" />
    </ItemGroup>

</Project>
