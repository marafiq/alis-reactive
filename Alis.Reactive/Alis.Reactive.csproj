<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <LangVersion>8</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>AlisReactive</PackageId>
        <IsPackable>true</IsPackable>
        <PackageDescription>Core reactive framework for building plan-driven browser UIs with C# fluent builders and JSON-serialized reactive plans.</PackageDescription>
        <PackageTags>reactive;aspnetcore;mvc;fluent-api;plan-driven</PackageTags>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="System.Text.Json" Version="9.*" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Schemas\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Ship JS/CSS (built by npm in the sibling Alis.Reactive.Assets project)
         as NuGet content files. Assets and the targets file are packed under
         BOTH build\ and buildTransitive\:
           build\          : required by packages.config consumers (net48 classic).
                             Classic NuGet auto-imports build\*.targets and resolves
                             $(MSBuildThisFileDirectory)assets\* relative to it.
           buildTransitive\: required so PackageReference consumers flow the targets
                             + assets through transitive dependencies.
         PackagePath uses explicit file paths (no trailing separator) — a trailing
         backslash produces ZIP entries with an empty segment that macOS/Linux
         normalize on extraction but Windows does not. -->
    <ItemGroup>
        <!-- npm emits bundles under dist\ with a literal "dev" version token so
             the sandbox serves them at the same URL pattern a net10 consumer
             uses (~/scripts/alis-reactive.{version}.js). PackagePath here
             strips the "dev" token so the NuGet ships the unversioned name;
             AlisReactive.targets then writes the consumer's real version on
             copy-to-wwwroot. Identical surface end-to-end. -->
        <None Include="..\Alis.Reactive.Assets\dist\scripts\alis-reactive.dev.js"   Pack="true" PackagePath="build\assets\js\alis-reactive.js" />
        <None Include="..\Alis.Reactive.Assets\dist\css\design-system.dev.css"      Pack="true" PackagePath="build\assets\css\design-system.css" />
        <None Include="..\Alis.Reactive.Assets\dist\scripts\alis-reactive.dev.js"   Pack="true" PackagePath="buildTransitive\assets\js\alis-reactive.js" />
        <None Include="..\Alis.Reactive.Assets\dist\css\design-system.dev.css"      Pack="true" PackagePath="buildTransitive\assets\css\design-system.css" />
        <None Include="build\AlisReactive.targets" Pack="true" PackagePath="build\AlisReactive.targets" />
        <None Include="build\AlisReactive.targets" Pack="true" PackagePath="buildTransitive\AlisReactive.targets" />
    </ItemGroup>

    <!-- Verify JS/CSS bundles exist before Pack. The bundles are produced by
         'npm run build:all' from the repo root. Pack does NOT invoke npm;
         consumers do not need Node.js for `dotnet pack`. CI orchestrates
         npm + dotnet as separate steps. -->
    <Target Name="VerifyBundlesExistBeforePack" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\Alis.Reactive.Assets\dist\scripts\alis-reactive.dev.js')"
               Text="alis-reactive.dev.js bundle not found. Run 'npm run build:all' from the repo root before packing." />
        <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\Alis.Reactive.Assets\dist\css\design-system.dev.css')"
               Text="design-system.dev.css bundle not found. Run 'npm run build:all' from the repo root before packing." />
    </Target>

    <!-- Bundle Roslyn analyzers so consumers get compile-time DSL checks (ALIS001-ALIS008) -->
    <ItemGroup>
        <None Include="..\Alis.Reactive.Analyzers\bin\$(Configuration)\netstandard2.0\Alis.Reactive.Analyzers.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alis.Reactive.Fusion" />
        <InternalsVisibleTo Include="Alis.Reactive.Native" />
        <InternalsVisibleTo Include="Alis.Reactive.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.Native.UnitTests" />
        <InternalsVisibleTo Include="Alis.Reactive.Fusion.UnitTests" />
    </ItemGroup>

</Project>
