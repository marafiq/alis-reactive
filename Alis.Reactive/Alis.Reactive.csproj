<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The Razor SDK makes this a Razor class library, so the runtime script ships as a static web
         asset. There are no Razor files to compile. -->

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>AlisReactive</PackageId>
        <IsPackable>true</IsPackable>
        <PackageDescription>Core reactive framework for building plan-driven browser UIs with C# fluent builders and JSON-serialized Reactive Plans.</PackageDescription>
        <PackageTags>reactive;aspnetcore;mvc;fluent-api;plan-driven</PackageTags>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- net48 ships the same DSL: plan domain (builders, plan model, JSON serialization,
         validation metadata) AND the Razor/Html authoring layer. The authoring layer
         binds to ASP.NET MVC5 (System.Web.Mvc) on net48 instead of ASP.NET Core. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="System.Text.Json" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
        <Reference Include="System.Web" />
    </ItemGroup>

    <!-- The runtime script npm builds into Alis.Reactive.Assets/dist, served at
         ~/_content/AlisReactive/js/alis-reactive.js (net10) and copied to
         Content\AlisReactive\js\alis-reactive.js (net48). Where and how:
         build\AlisReactiveStaticWebAssets.targets. -->
    <ItemGroup>
        <AlisReactiveStaticWebAsset Include="$(AlisAssetsDist)\scripts\alis-reactive.dev.js" RelativePath="js/alis-reactive.js" />
    </ItemGroup>

    <Import Project="..\build\AlisReactiveStaticWebAssets.targets" />

    <!-- Bundle Roslyn analyzers so consumers get compile-time DSL checks (ALIS001-ALIS009) -->
    <ItemGroup>
        <None Include="..\Alis.Reactive.Analyzers\bin\$(Configuration)\netstandard2.0\Alis.Reactive.Analyzers.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

    <!-- The typed-API analyzer (ALIS009) runs on the core's own public surface. -->
    <ItemGroup>
        <ProjectReference Include="..\Alis.Reactive.Analyzers\Alis.Reactive.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alis.Reactive.PlanContractGenerator" />
        <InternalsVisibleTo Include="Alis.Reactive.FluentValidator" />
        <!-- native-validation-summary places a form's summary, and the page's record of summaries is internal. -->
        <InternalsVisibleTo Include="Alis.Reactive.NativeTagHelpers" />
        <InternalsVisibleTo Include="Alis.Reactive.PlanTests" />
    </ItemGroup>

</Project>
