<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PROVER 2 — domain serialize determinism dogfood.
    Drives the REAL Alis.Reactive public DSL (Html.On / ReactivePlan / builders /
    p.Get / p.When / Element / Dispatch / Component / Native extensions) through the
    REAL ReactivePlanSerializer (ReactivePlan.Render()), then proves:
      DET-STABLE     — Render() twice is byte-identical per plan (>= 30 varied plans).
      DET-CAMELCASE  — property names are camelCase; node `kind` tokens emit verbatim.
      DET-KIND-PRESENT — every serialized polymorphic node carries a non-empty `kind`.
      DET-CONGRUENT  — two independently-built structurally-identical plans match byte-for-byte.

    References the REAL Alis.Reactive + Alis.Reactive.Native projects (net10.0 leg) via
    ProjectReference — no internal ctors, public DSL only. Deliberately NOT in any .slnx,
    and isolated from repo-root Directory.Build.* via the local empty ones.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Alis.Reactive.Dogfood.Determinism</RootNamespace>
    <AssemblyName>DeterminismDomain</AssemblyName>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- The real projects multi-target net48;net10.0; pin the reference to the net10.0 leg. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\Alis.Reactive\Alis.Reactive.csproj" SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference Include="..\..\..\..\..\Alis.Reactive.Native\Alis.Reactive.Native.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

</Project>
