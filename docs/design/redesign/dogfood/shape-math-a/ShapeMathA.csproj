<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The proven port uses raw nint-free numerics; keep warnings non-fatal so the
         harness focuses on the algebra, not on the linked source's pre-existing warnings. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" Version="4.7.0" />
  </ItemGroup>

  <!-- LINK the REAL framework source — never re-implement. Laws E1..F2 run against
       exactly the bytes that ship in Alis.Reactive. -->
  <ItemGroup>
    <Compile Include="..\..\..\..\..\Alis.Reactive\PlanModel\Shape.cs">
      <Link>RealSource\Shape.cs</Link>
    </Compile>
    <Compile Include="..\..\..\..\..\Alis.Reactive\PlanModel\ShapeContractCompatibility.cs">
      <Link>RealSource\ShapeContractCompatibility.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- LINK the PROVEN port of the TS shape-convert engine (round-3 dogfood certified
       behavior-identical to shape-convert.ts). Used only for the P1..P3 apply/convert laws. -->
  <ItemGroup>
    <Compile Include="..\shape-v3\ShapeConvert.cs">
      <Link>ProvenPort\ShapeConvert.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
