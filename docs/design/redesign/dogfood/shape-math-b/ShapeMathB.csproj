<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Do NOT treat warnings as errors: the linked real source may carry warnings
         we must not patch; this harness only OBSERVES behavior. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Only the files we explicitly Compile Include, plus Program.cs in this dir. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harness own file. -->
    <Compile Include="Program.cs" />

    <!-- THE REAL SOURCE — linked, not copied, not re-implemented. -->
    <Compile Include="../../../../../Alis.Reactive/PlanModel/Shape.cs"
             Link="REAL/Shape.cs" />
    <Compile Include="../../../../../Alis.Reactive/PlanModel/ShapeContractCompatibility.cs"
             Link="REAL/ShapeContractCompatibility.cs" />

    <!-- The PROVEN C# port of the TS apply/convert engine (round-3 dogfood certified). -->
    <Compile Include="../shape-v3/ShapeConvert.cs"
             Link="PORT/ShapeConvert.cs" />
  </ItemGroup>

</Project>
