<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spec-only dogfood proof of the Shape kernel.
    Built ONLY from docs/design/redesign/scaffold/Shape.md + the Shape fixtures
    in docs/design/redesign/scaffold/_fixtures.md. No current source was read.
    Deliberately NOT added to any .slnx — fully self-contained.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Alis.Reactive.Dogfood.Shape</RootNamespace>
    <AssemblyName>ShapeDogfood</AssemblyName>
    <!-- isolate: never participate in solution-wide builds / Directory.Build.props above -->
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

</Project>
