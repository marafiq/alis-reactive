<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <LangVersion>8</LangVersion>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>AlisReactive.Fusion</PackageId>
        <IsPackable>true</IsPackable>
        <PackageDescription>Syncfusion EJ2 component integration for Alis.Reactive — rich UI components through the reactive plan DSL.</PackageDescription>
        <PackageTags>reactive;aspnetcore;syncfusion;ej2;components</PackageTags>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
      <PackageReference Include="Syncfusion.EJ2.AspNet.Core" Version="32.2.8" />
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
      <PackageReference Include="Syncfusion.EJ2.MVC5" Version="32.2.8" />
      <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
      <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
      <Reference Include="System.Web" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Alis.Reactive\Alis.Reactive.csproj" />
      <ProjectReference Include="..\Alis.Reactive.Native\Alis.Reactive.Native.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Alis.Reactive.Fusion.UnitTests" />
    </ItemGroup>

</Project>
