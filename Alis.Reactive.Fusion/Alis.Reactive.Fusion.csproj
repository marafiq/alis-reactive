<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The Razor SDK makes this a Razor class library, so its stylesheet ships as a static web
         asset. There are no Razor files to compile. -->

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>AlisReactive.Fusion</PackageId>
        <IsPackable>true</IsPackable>
        <PackageDescription>Syncfusion EJ2 component integration for Alis.Reactive; rich UI components through the Reactive Plan DSL.</PackageDescription>
        <PackageTags>reactive;aspnetcore;syncfusion;ej2;components</PackageTags>
    </PropertyGroup>

    <!-- Syncfusion must match the npm browser assets exactly on both target frameworks. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
      <PackageReference Include="Syncfusion.EJ2.AspNet.Core" Version="[33.1.47]" />
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- net48 binds to ASP.NET MVC5 (System.Web.Mvc): same Syncfusion EJ2 builder API
         via the MVC5 package, different ASP.NET host types. Mirrors the net48 group in
         Alis.Reactive.csproj; PolySharp + ReferenceAssemblies enable C# 14 on net48. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
      <PackageReference Include="Syncfusion.EJ2.MVC5" Version="[33.1.47]" />
      <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
      <!-- AddReactiveFusion() extends IServiceCollection on both TFMs; net10 gets it from the
           ASP.NET Core framework reference. Accept the same minimum as AlisReactive
           and allow newer DI versions. -->
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[9.0.0,)" />
      <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
      <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
      <Reference Include="System.Web" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Alis.Reactive\Alis.Reactive.csproj" />
      <!-- Run the typed-DSL analyzer (ALIS009) on this slice's own source so untyped
           public component API fails the build here, not ships to consumers. -->
      <ProjectReference Include="..\Alis.Reactive.Analyzers\Alis.Reactive.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
      <!-- The package's slice rows, bottom row first; ALIS010-ALIS013 lock ADR-0004 against them in every build. -->
      <AdditionalFiles Include="SliceTree.txt" />
      <!-- The public surface per target: a public symbol is a line in PublicAPI.Unshipped.txt, or the build fails (RS0016, RS0017). -->
      <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
      <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
      <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <!-- The styling Fusion's markup needs: the Syncfusion Tailwind3 theme at the version the
         Syncfusion packages above are pinned to, and the grid dialog form's own CSS. npm builds it
         into Alis.Reactive.Assets/dist (vite.fusion.config.ts, Alis.Reactive.Assets/fusion); it is
         served at ~/_content/AlisReactive.Fusion/css/fusion.css (net10) and copied to
         Content\AlisReactive.Fusion\css\fusion.css (net48). Where and how:
         build\AlisReactiveStaticWebAssets.targets. The brand comes from whatever design system the
         app links after it. -->
    <ItemGroup>
        <AlisReactiveStaticWebAsset Include="$(AlisAssetsDist)\css\syncfusion.dev.css" RelativePath="css/fusion.css" />
    </ItemGroup>

    <Import Project="..\build\AlisReactiveStaticWebAssets.targets" />

</Project>
