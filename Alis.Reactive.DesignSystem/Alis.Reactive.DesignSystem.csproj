<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The Razor SDK makes this a Razor class library, so its stylesheets ship as static web assets.
       There are no Razor files to compile. -->

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Alis.Reactive.DesignSystem</RootNamespace>
    <AssemblyName>Alis.Reactive.DesignSystem</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AlisReactive.DesignSystem</PackageId>
    <IsPackable>true</IsPackable>
    <PackageDescription>Design system for Alis.Reactive — brand tokens, layout primitives, and the design-system stylesheet. Consumed by the component packages independently of the reactive core.</PackageDescription>
    <PackageTags>reactive;design-system;css;tokens</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alis.Reactive.Analyzers\Alis.Reactive.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The design-system stylesheet npm builds into Alis.Reactive.Assets/dist
       (vite.design-system.config.ts), served at ~/_content/AlisReactive.DesignSystem/css/design-system.css
       (net10) and copied to Content\AlisReactive.DesignSystem\css\design-system.css (net48). Where and
       how: build\AlisReactiveStaticWebAssets.targets. -->
  <ItemGroup>
    <AlisReactiveStaticWebAsset Include="$(AlisAssetsDist)\css\design-system.dev.css" RelativePath="css/design-system.css" />
  </ItemGroup>

  <Import Project="..\build\AlisReactiveStaticWebAssets.targets" />

</Project>
