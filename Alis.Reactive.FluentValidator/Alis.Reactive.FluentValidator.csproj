<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <PackageId>AlisReactive.FluentValidator</PackageId>
        <IsPackable>true</IsPackable>
        <PackageDescription>FluentValidation integration for Alis.Reactive that projects deterministic validation rules into browser validation.</PackageDescription>
        <PackageTags>reactive;aspnetcore;fluentvalidation;validation</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.*" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alis.Reactive\Alis.Reactive.csproj" />
    </ItemGroup>

</Project>
