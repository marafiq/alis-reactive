<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The host owns the Playwright reference and its playwright.ps1, which loads Microsoft.Playwright.dll
             from beside itself; a library's output carries its packages only when told to. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
        <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.63.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
    </ItemGroup>

</Project>
