@using Alis.Reactive.Poc.App.Residents
@model ResidentLookup
@{
    ViewData["Title"] = "Resident lookup";
    var plan = Html.ReactivePlan<ResidentLookup>();
}
<h1>Resident lookup</h1>

@(Html.InputField(plan, m => m.Name).TextBox("Resident name")
    .Reactive(box => box.Blur, (_, pipeline) =>
    {
        var name = pipeline.Input(m => m.Name).Component<NativeTextBox>().Value;
        var found = pipeline.Get<ResidentQuery>("/Residents/Summary/{name}", request => request.Set(r => r.Name, name))
            .OnSuccess<ResidentSummary>((summary, shown) => shown.Element("lookup-status").Text.Set(summary.Body.Read(s => s.Name)));
        found.OnError<NoResident>(404, (missing, notFound) => notFound.Element("lookup-status").Text.Set(missing.Body.Read(m => m.Reason)));
        found.OnError((_, other) => other.Element("lookup-status").Text.Set("The register could not answer"));
    }))
<p>Lookup: <strong id="lookup-status">not looked up</strong></p>

@Html.RenderPlan(plan)
