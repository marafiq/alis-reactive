@using Alis.Reactive.Poc.App.Rosters
@model HandoverPage
@{
    ViewData["Title"] = "Handover";
    var plan = Html.ReactivePlan<HandoverPage>();
}
<h1>Handover</h1>

@plan.DutyRoster("night-roster", nursesRequired: 4, shift: "Night shift", onCallName: "Ruth Mensah", onCallRole: "Charge nurse", onCallPager: "4471")

@(plan.Button("show-night-role", "Show night on-call role")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Element("night-role").Text.Set(pipeline.Component<DutyRoster>("night-roster").OnCall.Read(nurse => nurse.Role))))

<p>Night on-call role: <span id="night-role">unknown</span></p>

@Html.RenderPlan(plan)
