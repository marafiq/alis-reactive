@using Alis.Reactive.Poc.App.Charts
@model ChartsPage
@{
    ViewData["Title"] = "Chart unit";
    var plan = Html.ReactivePlan<ChartsPage>();
}
<h1>Chart unit</h1>

@plan.DoseChart("chart")

@(plan.Button("by-chart-unit", "Label the ticks by the chart's unit")
    .Reactive(button => button.Click, pipeline =>
    {
        var chart = pipeline.Component<DoseChart>("chart");
        chart.TickLabel.Set(tick => chart.Unit());
    }))

@Html.RenderPlan(plan)
