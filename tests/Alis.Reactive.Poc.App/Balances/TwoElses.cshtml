@using Alis.Reactive.Poc.App.Balances
@model BalancesPage
@{
    ViewData["Title"] = "Two Elses";
    var plan = Html.ReactivePlan<BalancesPage>();
}
<h1>Two Elses</h1>

@plan.FluidBalance("balance")

<p>Verdict: <span id="verdict">unassessed</span></p>

@(plan.Button("assess", "Assess the intake")
    .Reactive(button => button.Click, pipeline =>
    {
        var branches = pipeline.When(pipeline.Component<FluidBalance>("balance").Intake.Gt(500))
            .Then(high => high.Element("verdict").Text.Set("high"));
        branches.Else(low => low.Element("verdict").Text.Set("low"));
        branches.Else(none => none.Element("verdict").Text.Set("none"));
    }))

@Html.RenderPlan(plan)
