@using Alis.Reactive.Lists
@using Alis.Reactive.Poc.App.Doses
@model DoseRoundPage
@{
    ViewData["Title"] = "Dose required parameters";
    var plan = Html.ReactivePlan<DoseRoundPage>();
}
<h1>Dose required parameters</h1>

@plan.MedicationCart("cart", DoseRound.Doses())

@plan.StationCensus("census")

<p>Census: <span id="census-status"></span></p>

@(plan.Button("count-no-refills", "Count doses with no refills left")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Element("census-status").Text.Set("Counting refills");
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Count(d => d.Refills == 0));
        pipeline.Element("census-status").Text.Set("Counted refills");
    }))

@(plan.Button("show-digoxin-refills", "Show Digoxin's refills left")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Find(d => d.Medicine == "Digoxin", d => d.Refills))))

@Html.RenderPlan(plan)
