@using Alis.Reactive.Conditions
@using Alis.Reactive.Lists
@using Alis.Reactive.Values
@using Alis.Reactive.Poc.App.Doses
@model DoseRoundPage
@{
    ViewData["Title"] = "Vials summed";
    var plan = Html.ReactivePlan<DoseRoundPage>();
}
<h1>Vials summed</h1>

@plan.MedicationCart("cart", DoseRound.Doses())

@plan.StationCensus("census")

<p>Verdict: <span id="verdict">unchecked</span></p>

@(plan.Button("sum", "Sum")
    .Reactive(button => button.Click, pipeline =>
    {
        var cart = pipeline.Component<MedicationCart>("cart");
        pipeline.Component<StationCensus>("census").Count.Set(cart.Doses.Select(d => d.Supply!.Vials).Sum(vials => vials));
    }))

@Html.RenderPlan(plan)
