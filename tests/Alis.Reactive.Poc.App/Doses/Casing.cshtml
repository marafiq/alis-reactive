@using Alis.Reactive.Lists
@using Alis.Reactive.Poc.App.Doses
@model DoseRoundPage
@{
    ViewData["Title"] = "Prescriber casing";
    var plan = Html.ReactivePlan<DoseRoundPage>();
}
<h1>Prescriber casing</h1>

@plan.MedicationCart("cart", DoseRound.Doses())

@plan.StationCensus("census")

@(plan.Button("count-upper-linguistic", "Count prescribers written DR IŞIK or DR WEIß in capitals")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Count(d => d.Prescriber.ToUpper() == "DR IŞIK" || d.Prescriber.ToUpper() == "DR WEIß"))))

@(plan.Button("count-upper-turkish", "Count prescribers written DR IŞIK or DR WEİß in capitals")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Count(d => d.Prescriber.ToUpper() == "DR IŞIK" || d.Prescriber.ToUpper() == "DR WEİß"))))

@(plan.Button("count-upper-invariant", "Count prescribers written DR IŞıK in capitals")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Count(d => d.Prescriber.ToUpper() == "DR IŞıK"))))

@(plan.Button("count-lower-linguistic", "Count prescribers written dr ince or dr işık in small letters")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Count(d => d.Prescriber.ToLower() == "dr ince" || d.Prescriber.ToLower() == "dr işık"))))

@(plan.Button("count-lower-turkish", "Count prescribers written dr ince or dr ışık in small letters")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Count(d => d.Prescriber.ToLower() == "dr ince" || d.Prescriber.ToLower() == "dr ışık"))))

@(plan.Button("count-lower-invariant", "Count prescribers written dr İnce in small letters")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Count(d => d.Prescriber.ToLower() == "dr İnce"))))

@Html.RenderPlan(plan)
