@using Alis.Reactive.Lists
@using Alis.Reactive.Poc.App.Doses
@model DoseRoundPage
@{
    ViewData["Title"] = "Doses by prescriber";
    var plan = Html.ReactivePlan<DoseRoundPage>();
}
<h1>Doses by prescriber</h1>

<p>Census: <span id="census-status"></span></p>

@plan.MedicationCart("cart", DoseRound.Doses())

@plan.StationCensus("census")

@(plan.Button("list-by-prescriber", "List doses by prescriber")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Element("census-status").Text.Set("Listing by prescriber");
        pipeline.Component<StationCensus>("census").Names.Set(
            pipeline.Component<MedicationCart>("cart").Doses.OrderBy(d => d.Prescriber).Select(d => d.Medicine));
        pipeline.Element("census-status").Text.Set("Listed by prescriber");
    }))

@(plan.Button("list-by-prescriber-descending", "List doses by prescriber, last first")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Names.Set(
            pipeline.Component<MedicationCart>("cart").Doses.OrderByDescending(d => d.Prescriber).Select(d => d.Medicine))))

@(plan.Button("list-by-prescriber-current-culture", "List doses by prescriber with the current culture's comparer")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Names.Set(
            pipeline.Component<MedicationCart>("cart").Doses.OrderBy(d => d.Prescriber, StringComparer.CurrentCulture).Select(d => d.Medicine))))

@Html.RenderPlan(plan)
