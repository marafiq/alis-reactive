@using Alis.Reactive.Lists
@using Alis.Reactive.Poc.App.Doses
@model DoseRoundPage
@{
    ViewData["Title"] = "Doses by copay";
    var plan = Html.ReactivePlan<DoseRoundPage>();
}
<h1>Doses by copay</h1>

@plan.MedicationCart("cart", DoseRound.Doses())

@plan.StationCensus("census")

@(plan.Button("sort-doses", "Sort doses")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Names.Set(
            pipeline.Component<MedicationCart>("cart").Doses.OrderBy(d => d.Copay).Select(d => d.Medicine))))

@Html.RenderPlan(plan)
