@using Alis.Reactive.Lists
@using Alis.Reactive.Poc.App.Doses
@model DoseRoundPage
@{
    ViewData["Title"] = "Who charted the aspirin";
    var plan = Html.ReactivePlan<DoseRoundPage>();
}
<h1>Who charted the aspirin</h1>

@plan.MedicationCart("cart", DoseRound.Doses())

@plan.StationCensus("census")

@(plan.Button("find-charter", "Find the charter")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Lead.Set(
            pipeline.Component<MedicationCart>("cart").Doses.Find(d => d.Medicine == "Aspirin", d => d.Charter.Name))))

@Html.RenderPlan(plan)
