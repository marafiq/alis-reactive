@using Alis.Reactive.Poc.App.Cards
@model CardsWard
@{
    ViewData["Title"] = "Care cards";
    var plan = Html.ReactivePlan<CardsWard>();
    plan.Plugin<ShiftLog>().Reactive(log => log.Noted, (noted, pipeline) =>
        pipeline.Component<CallLog>("calls").Note("The ward heard the note"));
    plan.Plugin<WardPager>().Reactive(pager => pager.Paged, (paged, pipeline) =>
        pipeline.Listen(paged.Call, call => call.Answered, (answered, heard) =>
            heard.Component<CallLog>("calls").Note("The ward heard a call answered")));
}
<h1>Care cards</h1>

<div id="cards">
    <section id="card"></section>
</div>

<p>Ward notes: <span id="ward-notes">No ward notes</span></p>
<p>Write: <span id="write-asked">not asked</span>, <span id="write-done">not done</span></p>

@(plan.Button("write-ward-notes", "Write the ward notes")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Element("write-asked").Text.Set("Asked to write the ward notes");
        pipeline.Element("ward-notes").Text.Set("Written by the ward");
        pipeline.Element("write-done").Text.Set("Wrote the ward notes");
    }))

@(plan.Button("write-over-cards", "Write over the cards")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Element("write-asked").Text.Set("Asked to write over the cards");
        pipeline.Element("cards").Text.Set("Written over");
        pipeline.Element("write-done").Text.Set("Wrote over the cards");
    }))

<p>Asked: <span id="asked">nothing</span></p>

@plan.CallLog("calls")

@(plan.Button("open-ada", "Open Ada's card")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Get("/Cards/Card?resident=Ada%20Byron").Into("card")))

@(plan.Button("open-ben", "Open Ben's card")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Get("/Cards/Card?resident=Ben%20Okafor").Into("card")))

@(plan.Button("open-missing", "Open the missing card")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Get("/Cards/Missing").Into("card");
        pipeline.Element("asked").Text.Set("Asked for the missing card");
    }))

@(plan.Button("open-listed", "Open the listed card")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Get("/Cards/Listed").Into("card");
        pipeline.Element("asked").Text.Set("Asked for the listed card");
    }))

@(plan.Button("open-unreachable", "Open the unreachable card")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Get("http://127.0.0.1:9/Cards/Card").Into("card");
        pipeline.Element("asked").Text.Set("Asked for the unreachable card");
    }))

@(plan.Button("open-broken", "Open the broken card")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Get("/Cards/Broken").Into("card");
        pipeline.Element("asked").Text.Set("Asked for the broken card");
    }))

@(plan.Button("close", "Close the card")
    .Reactive(button => button.Click, pipeline => pipeline.Unload("card")))

@(plan.Button("note", "Note a fall")
    .Reactive(button => button.Click, pipeline => pipeline.Plugin<ShiftLog>().Add("A fall in room 12")))

<p>Struck: <span id="struck">not yet</span></p>
<p>Assigned: <span id="assigned">not yet</span></p>

@(plan.Button("strike", "Strike the hour")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<NightClock>().Strike();
        pipeline.Element("struck").Text.Set("Struck once");
    }))

@(plan.Button("strike-again", "Strike the hour again")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<NightClock>().Strike();
        pipeline.Element("struck").Text.Set("Struck again");
    }))

@(plan.Button("assign", "Assign bed 12B")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<BedStore>().Assign("12B");
        pipeline.Element("assigned").Text.Set("Assigned once");
    }))

@(plan.Button("assign-again", "Assign bed 14C")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<BedStore>().Assign("14C");
        pipeline.Element("assigned").Text.Set("Assigned again");
    }))

<p>Paged: <span id="paged">nobody</span></p>
<p>Answered: <span id="answered">nothing</span></p>

@(plan.Button("page-12", "Page room 12")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<WardPager>().Page("12");
        pipeline.Element("paged").Text.Set("Paged room 12");
    }))

@(plan.Button("page-12-again", "Page room 12 again")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<WardPager>().Page("12");
        pipeline.Element("paged").Text.Set("Paged room 12 again");
    }))

@(plan.Button("page-14", "Page room 14")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<WardPager>().Page("14");
        pipeline.Element("paged").Text.Set("Paged room 14");
    }))

@(plan.Button("answer-12", "Answer room 12")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<WardPager>().Answer("12", "Nurse Kim");
        pipeline.Element("answered").Text.Set("Answered room 12");
    }))

@(plan.Button("answer-12-again", "Answer room 12 again")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<WardPager>().Answer("12", "Nurse Lee");
        pipeline.Element("answered").Text.Set("Answered room 12 again");
    }))

@(plan.Button("answer-14", "Answer room 14")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Plugin<WardPager>().Answer("14", "Nurse Kim");
        pipeline.Element("answered").Text.Set("Answered room 14");
    }))

@Html.RenderPlan(plan)
