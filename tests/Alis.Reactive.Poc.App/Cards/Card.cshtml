@using Alis.Reactive.Poc.App.Cards
@model CareCard
@{
    var plan = Html.ReactivePlan<CareCard>();
    plan.Plugin<ShiftLog>().Reactive(log => log.Noted, (noted, pipeline) =>
        pipeline.Component<CallLog>("calls").Note(Model.Resident + " heard the note"));
    plan.Plugin<NightClock>().Reactive(clock => clock.Struck, (struck, pipeline) =>
        pipeline.Component<CallLog>("calls").Note(Model.Resident + " heard the hour"));
    plan.Plugin<BedStore>().Reactive(store => store.Assigned, (taken, pipeline) =>
        pipeline.Component<CallLog>("calls").Note(Model.Resident + " heard a bed assigned"));
    plan.Plugin<WardPager>().Reactive(pager => pager.Paged, (paged, pipeline) =>
        pipeline.Listen(paged.Call, call => call.Answered, (answered, heard) =>
        {
            heard.Component<CallLog>("calls").Note(Model.Resident + " heard a call answered");
            heard.Element("card-call-room").Text.Set(paged.Room);
            heard.Element("card-call-by").Text.Set(answered.By);
        }));
}
<h2>@Model.Resident</h2>

<p>Call: room <span id="card-call-room">none</span>, answered by <span id="card-call-by">nobody</span></p>

<section id="card-notes">
    @if (Model.NotesOpen)
    {
        @await Html.PartialAsync("Notes", Model)
    }
</section>

@(plan.BedsideMonitor("card-monitor", Model.Resident)
    .Reactive(monitor => monitor.Alarm, (alarm, pipeline) =>
        pipeline.Component<CallLog>("calls").Note(Model.Resident + "'s monitor alarmed")))

@(plan.Button("clear-ward-notes", "Clear the ward notes")
    .Reactive(button => button.Click, pipeline => pipeline.Unload("ward-notes")))

@(plan.Button("write-over-card", "Write over this card")
    .Reactive(button => button.Click, pipeline =>
    {
        pipeline.Element("write-asked").Text.Set("Asked to write over the card");
        pipeline.Element("card").Text.Set("Written over");
        pipeline.Element("write-done").Text.Set("Wrote over the card");
    }))

@(plan.Button("open-notes", "Open the notes")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Get("/Cards/Notes?resident=" + Uri.EscapeDataString(Model.Resident)).Into("card-notes")))

@Html.RenderPlan(plan)
