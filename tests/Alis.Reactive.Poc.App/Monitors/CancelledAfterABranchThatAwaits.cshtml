@using Alis.Reactive.Poc.App.Monitors
@model MonitorsPage
@{
    ViewData["Title"] = "Cancelled after a branch that awaits";
    var plan = Html.ReactivePlan<MonitorsPage>();
}
<h1>Cancelled after a branch that awaits</h1>

@(plan.VitalsMonitor("monitor")
    .Reactive(monitor => monitor.Alarm, (alarm, pipeline) =>
    {
        pipeline.When(alarm.Note.Eq("after surgery"))
            .Then(noted => noted.Component<VitalsMonitor>("monitor").Acknowledge());
        alarm.Cancel.Set(true);
    }))

@Html.RenderPlan(plan)
