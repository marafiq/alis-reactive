@using Alis.Reactive.Poc.App.Pumps
@model InfusionPage
@{
    ViewData["Title"] = "Recalibrated in a lambda";
    var plan = Html.ReactivePlan<InfusionPage>();
}
<h1>Recalibrated in a lambda</h1>

@plan.InfusionPump("pump", "Bed 4 pump")

@plan.StationCensus("census")

@(plan.Button("count", "Recalibrate each channel while counting")
    .Reactive(button => button.Click, pipeline =>
        pipeline.Component<StationCensus>("census").Count.Set(
            pipeline.Component<InfusionPump>("pump").Channels().Count(channel =>
            {
                channel.Recalibrate();
                return channel.IsRunning();
            }))))

@Html.RenderPlan(plan)
