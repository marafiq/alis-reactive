@using Alis.Reactive.Poc.App.Trays
@model TraysPage
@{
    ViewData["Title"] = "Meal trays";
    var plan = Html.ReactivePlan<TraysPage>();
}
<h1>Meal trays</h1>

<h2>The current tray</h2>
<p>Status: <span id="status">waiting</span></p>
<p>Note: <span id="note">unread</span></p>
<p>portion: <span id="portion">unread</span></p>
<p>cover: <span id="cover">unread</span></p>
<p>side: <span id="side">unread</span></p>
<p>served: <span id="served">unread</span></p>
<p>temperature: <span id="temperature">unread</span></p>
<p>lid: <span id="lid">unread</span></p>
<p>extra: <span id="extra">unread</span></p>
<p>badge: <span id="badge">unread</span></p>
<p>relief: <span id="relief">unread</span></p>
<p>spare-lid: <span id="spare-lid">unread</span></p>
<p>side-order: <span id="side-order">unread</span></p>
<p>spare-side: <span id="spare-side">unread</span></p>

@(plan.MealTray("tray")
    .Reactive(tray => tray.Delivered, (delivery, pipeline) =>
    {
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("note").Text.Set(delivery.Note);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("portion-button", "Read the portion")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("portion").Text.Set(tray.Portion);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("write-portion-button", "Write the portion")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        tray.Portion.Set("Large");
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("slip-button", "Write the slip")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        tray.Slip.Set("Diabetic");
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("cover-button", "Read the cover")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("cover").Text.Set(tray.Cover.Label);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("side-button", "Read the first side")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("side").Text.Set(tray.Sides.At(0).Name);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("warm-button", "Warm the tray")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        tray.Warm();
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("served-button", "Read when it was served")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("served").Text.Set(tray.LastServed());
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("reheat-button", "Reheat the tray")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        tray.Reheat();
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("temperature-button", "Read the temperature")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("temperature").Text.Set(tray.Temperature());
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("lid-button", "Read the lid")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("lid").Text.Set(tray.Lid().Label);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("extra-button", "Read the first extra")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("extra").Text.Set(tray.Extras().At(0).Name);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("garnish-button", "Answer the garnish")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        tray.Garnish.Set(dish => dish.Name);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("badge-button", "Read the server's badge")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("badge").Text.Set(tray.Server.Badge);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("relief-button", "Read the relief server's badge")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("relief").Text.Set(tray.Relief.Badge);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("spare-lid-button", "Read the spare lid")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
        pipeline.Element("spare-lid").Text.Set(tray.SpareLid().Label);
        pipeline.Element("status").Text.Set("Done");
    }))

@(plan.Button("side-order-button", "Read the first side order")
    .Reactive(button => button.Click, pipeline =>
    {
        var tray = pipeline.Component<MealTray>("tray");
        pipeline.Element("status").Text.Set("Reading");
