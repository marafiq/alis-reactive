<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
        <!-- The compiler the fixtures run under: the analyzers' own pin (Alis.Reactive.Analyzers.csproj),
             the oldest compiler the shipped package supports. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- The fixtures are views and validators compiled against the framework's real assemblies, so a
             rule keyed on a type's metadata name goes red when the DSL renames the type. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="../../Alis.Reactive.Analyzers/Alis.Reactive.Analyzers.csproj" />
        <ProjectReference Include="../../Alis.Reactive/Alis.Reactive.csproj" />
        <ProjectReference Include="../../Alis.Reactive.Native/Alis.Reactive.Native.csproj" />
        <ProjectReference Include="../../Alis.Reactive.FluentValidator/Alis.Reactive.FluentValidator.csproj" />
    </ItemGroup>

</Project>
