@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Conformance.World
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model LiveRound
@{
    Layout = Model.Layout;
    ViewData["Title"] = "Medication round";
    var plan = Html.ReactivePlan<LiveRound>();
}
<h1>Medication round of the @Model.Ward ward</h1>
<p>Board lines: <span id="board-lines"></span></p>
<button type="button" @Html.Raises(plan, LiveRoundButtons.OpenTheBedCard)>Open the bed card</button>
<button type="button" @Html.Raises(plan, LiveRoundButtons.CloseTheBedCard)>Close the bed card</button>
<div id="bed-slot"></div>
@{
    Html.On(plan, trigger => trigger
        .ServerPush(Switchboard.Live, lines => lines.Lines, (lines, pipeline) => pipeline.Element("board-lines").Text.Set(lines.Read(l => l.Open)))
        .CustomEvent(LiveRoundButtons.OpenTheBedCard, pipeline => pipeline.Get(CareEndpoints.BoardCard).Into("bed-slot"))
        .CustomEvent(LiveRoundButtons.CloseTheBedCard, pipeline => pipeline.Unload("bed-slot")));
}
@Html.RenderPlan(plan)
