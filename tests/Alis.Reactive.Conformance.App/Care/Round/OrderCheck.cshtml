@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Conformance.World
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model RoundOrder
@{
    Layout = "/Care/Round/_TracedLayout.cshtml";
    ViewData["Title"] = "Medication order";
    var plan = Html.ReactivePlan<RoundOrder>();
}
<h1>Medication order</h1>
@using (var order = Html.BeginRequestForm(plan, "round-order"))
{
    <fieldset>
        <legend>Order</legend>
        @(Html.InputField(plan, m => m.Strength, options => options.Label("Strength")).NativeTextBox())
    </fieldset>
    @(Html.NativeButton("save-order", "Save").Reactive(plan, button => button.Click, (clicked, pipeline) => pipeline
        .Post<RoundOrder>(CareEndpoints.OrderCheckOrders, request => request.Form(order.Form))
        .Validate<RoundValidator>()
        .OnSuccess(Content.Text, (saved, pipeline) => pipeline.Element("saved").Text.Set(saved.Body))))
}
<p>Saved: <span id="saved"></span></p>
<p><a href="@CarePages.TheNorthWardsRound">The North ward's round</a></p>
@Html.RenderPlan(plan)
