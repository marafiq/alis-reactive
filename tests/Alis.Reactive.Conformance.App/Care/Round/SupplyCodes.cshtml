@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model SupplyCodes
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Supply codes";
    var plan = Html.ReactivePlan<SupplyCodes>();
}
<h1>Supply codes</h1>
@using (var codes = Html.BeginRequestContainer(plan, "supply-codes"))
{
    <fieldset>
        <legend>Code</legend>
        <label for="supply-code">Code</label>
        @(plan.Render<NativeTextBox>("supply-code", Html.Raw("<input type=\"text\" id=\"supply-code\">")))
    </fieldset>
    @(Html.NativeButton("submit-code", "Submit").Reactive(plan, button => button.Click, (clicked, pipeline) => pipeline
        .Post<SupplyCodes>(SupplyCodesEndpoints.Codes, request => request.Multipart(codes.Container, body => body.Set(r => r.Code, pipeline.Component<NativeTextBox>("supply-code").Value)))
        .OnSuccess(Content.Text, (received, pipeline) => pipeline.Element("received").Text.Set(received.Body))
        .OnError<ValidationProblem>(400, (refused, pipeline) => pipeline.ShowValidationErrors(refused.Body))))
}
<p id="received"></p>
@Html.RenderPlan(plan)
