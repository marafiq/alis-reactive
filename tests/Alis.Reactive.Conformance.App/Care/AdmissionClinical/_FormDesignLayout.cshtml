@using Alis.Reactive.Conformance.App.Components
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="~/_content/Syncfusion.AspNetCore.Themes/styles/bootstrap5.3.css">
    <style>
        body { margin: 1.5rem; font-family: system-ui, sans-serif; }
        nav a + a { margin-inline-start: 1.25rem; }
        [data-admission-form-builder] { height: max(38rem, 72vh); }
        [data-admission-form-renderer] { max-width: 36rem; margin-block: 1.5rem; }
    </style>
</head>
<body>
    <main>@RenderBody()</main>
    @Html.ConformanceBusy()
    @Html.ConformanceNotice()
    @await RenderSectionAsync("FormScript")
    <script src="~/js/alis-reactive-conformance.js" asp-append-version="true"></script>
    <script src="~/js/care/admissionclinical/admission-form-designer.js" asp-append-version="true"></script>
    <script src="~/_content/AlisReactive/js/alis-reactive.js" asp-append-version="true"></script>
</body>
</html>
