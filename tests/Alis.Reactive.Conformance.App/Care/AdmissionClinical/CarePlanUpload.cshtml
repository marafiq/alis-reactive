@using Alis.Reactive.ArrayLambdas
@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model CarePlanDocument
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Care plan";
    var plan = Html.ReactivePlan<CarePlanDocument>();
}
<h1>Care plan</h1>
@using (var document = Html.BeginRequestForm(plan, "care-plan-upload"))
{
    <fieldset>
        <legend>Care plan</legend>
        @(Html.InputField(plan, m => m.CarePlan, options => options.Label("Care plan"))
            .FusionUploader()
            .Reactive(uploader => uploader.FilesChanged, (_, pipeline) => pipeline.Element("chosen").Text.Set(pipeline.Input(m => m.CarePlan).Component<FusionUploader>().Files.Count())))
    </fieldset>
    <p>Files chosen: <output id="chosen">0</output></p>
    <button type="button" @Html.Raises(plan, CarePlanUploads.Save)>Save</button>
    Html.On(plan, trigger => trigger.CustomEvent(CarePlanUploads.Save, pipeline => pipeline
        .Post<CarePlanDocument>(CarePlanUploadEndpoints.CarePlans, request => request.Form(document.Form))
        .OnSuccess(Content.Text, (saved, pipeline) => pipeline.Element("saved").Text.Set(saved.Body))));
}
<p>Saved care plan: <output id="saved">Not saved</output></p>
@Html.RenderPlan(plan)
