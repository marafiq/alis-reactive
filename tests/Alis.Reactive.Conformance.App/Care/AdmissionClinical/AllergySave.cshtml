@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@using Alis.Reactive.RequestsAndResponses
@model AllergySave
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Helen Martinez's intake";
    var plan = Html.ReactivePlan<AllergySave>();
}
<h1>Helen Martinez's intake</h1>
<fieldset>
    <legend>Allergies</legend>
    @(Html.InputField(plan, m => m.AllergyCodes, options => options.Label("Allergies"))
        .FusionMultiSelect(HelensAllergies.Offered(), build => build.Fields((HelenAllergy a) => a.Name, a => a.Code)))
</fieldset>
<button type="button" @Html.Raises(plan, AllergySaves.Save)>Save</button>
<p>Saved: <output id="saved">Not saved</output></p>
@{
    Html.On(plan, trigger => trigger.CustomEvent(AllergySaves.Save, pipeline => pipeline
        .Post<AllergyUpdate>(AllergySaveEndpoints.Allergies, request => request.Json(body => body.Set(update => update.AllergyCodes, pipeline.Input(m => m.AllergyCodes).Component<FusionMultiSelect<int[]?>>().Value)))
        .OnSuccess(Content.Json<SavedAllergies>(), (saved, pipeline) => pipeline.Element("saved").Text.Set(saved.Body.Read(answer => answer.Message)))));
}
@Html.RenderPlan(plan)
