@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model AllergySelection
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Helen Martinez's intake";
    var plan = Html.ReactivePlan<AllergySelection>();
}
<h1>Helen Martinez's intake</h1>
<fieldset>
    <legend>Allergies</legend>
    @(Html.InputField(plan, m => m.AllergyCodes, options => options.Label("Allergies"))
        .FusionMultiSelect(HelensAllergies.Offered(), build => build.Fields((HelenAllergy a) => a.Name, a => a.Code)))
</fieldset>
<button type="button" @Html.Raises(plan, AllergySelections.Every)>Select every allergy</button>
<button type="button" @Html.Raises(plan, AllergySelections.None)>Select none</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(AllergySelections.Every, pipeline => pipeline
        .Input(m => m.AllergyCodes).Component<FusionMultiSelect<int[]?>>().SelectAll(true)));
    Html.On(plan, trigger => trigger.CustomEvent(AllergySelections.None, pipeline => pipeline
        .Input(m => m.AllergyCodes).Component<FusionMultiSelect<int[]?>>().SelectAll(false)));
}
@Html.RenderPlan(plan)
