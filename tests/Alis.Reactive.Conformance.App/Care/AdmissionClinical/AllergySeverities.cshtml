@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.Fusion.FusionTemplates
@using Alis.Reactive.RenderingAndDelivery
@model AllergySeverities
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Helen Martinez's intake";
    var plan = Html.ReactivePlan<AllergySeverities>();
    var graded = FusionTemplate.Create<GradedAllergy>()
        .Span(m => m.Name)
        .Text(" ")
        .When(m => m.Severity == "severe", then: t => t.Badge("Severe"), @else: e => e.Span("Mild"))
        .Render(plan);
}
<h1>Helen Martinez's intake</h1>
<fieldset>
    <legend>Allergies</legend>
    @(Html.InputField(plan, m => m.AllergyCodes, options => options.Label("Allergies"))
        .FusionMultiSelect(Model.Offered, build => build.Fields((GradedAllergy a) => a.Name, a => a.Code).ItemTemplate(graded)))
</fieldset>
@Html.RenderPlan(plan)
