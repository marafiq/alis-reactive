@using Alis.Reactive.Conditions
@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model PumpLog
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pump log";
    var plan = Html.ReactivePlan<PumpLog>();
}
<h1>Pump of @Model.Resident</h1>
@(plan.ConformanceComponent("care-panel", new ConformanceStart { Text = "Infusion pump", Value = Model.Alarm, Options = Model.Alarms }))
<button type="button" @Html.Raises(plan, PumpLogs.LogValue)>Log value</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(PumpLogs.LogValue, pipeline =>
    {
        var panel = pipeline.Component<ConformanceComponent>("care-panel");
        panel.Log(panel.Value.IfNull("No value"));
    }));
}
@Html.RenderPlan(plan)
