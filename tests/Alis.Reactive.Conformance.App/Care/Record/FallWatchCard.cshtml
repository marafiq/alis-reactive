@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model FallWatchCard
@{
    var plan = Html.ReactivePlan<FallWatchCard>();
}
<h2>@Model.Name</h2>
<p>@Model.Room</p>
@{
    Html.On(plan, trigger => trigger.CustomEvent(FallWatches.FallNoted, pipeline => pipeline.Element("call-list").Text.Append($"{Model.Name} heard the note\n")));
}
@Html.RenderPlan(plan)
