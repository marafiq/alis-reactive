@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model NightLog
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Night log";
    var plan = Html.ReactivePlan<NightLog>();
}
<h1>Night log of @Model.Resident</h1>
<button type="button" @Html.Raises(plan, NightLogs.OpenTheDesk)>Open the desk</button>
<button type="button" @Html.Raises(plan, NightLogs.CloseTheDesk)>Close the desk</button>
<button type="button" @Html.Raises(plan, NightLogs.MarkNoEntry)>Mark no entry</button>
<section id="log-desk" aria-label="Desk"></section>
<section id="log-entry" aria-label="Entry"></section>
<p>Status: <output id="log-status">Open</output></p>
@{
    Html.On(plan, trigger => trigger
        .CustomEvent(NightLogs.OpenTheDesk, pipeline => pipeline.Get(NightLogEndpoints.Tools).Into("log-desk"))
        .CustomEvent(NightLogs.CloseTheDesk, pipeline => pipeline.Unload("log-desk"))
        .CustomEvent(NightLogs.MarkNoEntry, pipeline =>
        {
            pipeline.Element("log-status").Text.Set("Marking");
            pipeline.Element("log-entry").Text.Set("No entry tonight");
            pipeline.Element("log-status").Text.Set("Marked");
        }));
}
@Html.RenderPlan(plan)
