@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model BedMonitorCard
@{
    var plan = Html.ReactivePlan<BedMonitorCard>();
}
<h2>@Model.Heading</h2>
@(plan.ConformanceComponent("bed-monitor", new ConformanceStart { Text = Model.Bed, OffCalls = "off-calls" })
    .Reactive(monitor => monitor.Raised, (raised, pipeline) => pipeline.Element("raised-heard").Text.Set(pipeline.Plugin<CareTally>().AddOne())))
@Html.RenderPlan(plan)
