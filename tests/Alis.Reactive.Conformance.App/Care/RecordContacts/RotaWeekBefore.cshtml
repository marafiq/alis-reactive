@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@using Syncfusion.EJ2.Schedule
@model RotaWeekBefore
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Shift rota";
    var plan = Html.ReactivePlan<RotaWeekBefore>();
}
<h1>Shift rota</h1>
@(Html.FusionSchedule(plan, "shift-rota", build => build.CurrentView(View.Week).SelectedDate(Model.SelectedDate))
    .Reactive(rota => rota.Navigating, (moving, pipeline) => pipeline.Element("previous-label").Text.Set(moving.PreviousDate)))
<p>Moved from the week of <output id="previous-label">Not moved</output></p>
@Html.RenderPlan(plan)
