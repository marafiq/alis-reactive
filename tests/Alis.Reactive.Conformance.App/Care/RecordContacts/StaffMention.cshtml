@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model StaffMention
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Care note";
    var plan = Html.ReactivePlan<StaffMention>();
}
<h1>Care note</h1>
<fieldset>
    <legend>Note</legend>
    <label for="care-note">Note</label>
    <textarea id="care-note"></textarea>
</fieldset>
@(Html.FusionMention<StaffMention, string, MentionedStaff>(plan, "staff-mention", Model.Staff, build => build.Target("#care-note").Fields((MentionedStaff s) => s.Name, s => s.StaffCode))
    .Reactive(mention => mention.Opened, (opened, pipeline) => pipeline.Element("mention-state").Text.Set("Suggesting staff"))
    .Reactive(mention => mention.Closed, (closed, pipeline) => pipeline.Element("mention-state").Text.Set("Writing")))
<p>Note: <output id="mention-state">Writing</output></p>
@Html.RenderPlan(plan)
