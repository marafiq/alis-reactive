@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.Native.NativeAppLevelObjects
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="data:,">
</head>
<body>
    <main>
        @RenderBody()
    </main>
    @Html.NativeDrawer("Close")
    @Html.NativeConfirm("Please confirm", ok: "Yes", cancel: "No")
    @Html.ConformanceBusy()
    @Html.ConformanceNotice()
    <script src="~/js/alis-reactive-conformance.js" asp-append-version="true"></script>
    <script src="~/_content/AlisReactive.Native/js/alis-reactive-native.js" asp-append-version="true"></script>
    <script src="~/_content/AlisReactive/js/alis-reactive.js" asp-append-version="true"></script>
</body>
</html>
