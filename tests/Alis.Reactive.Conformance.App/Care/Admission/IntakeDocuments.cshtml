@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model IntakeDocuments
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admission documents";
    var plan = Html.ReactivePlan<IntakeDocuments>();
}
<h1>Admission: documents</h1>
@using (var intake = Html.BeginRequestContainer(plan, "intake-documents"))
{
    <fieldset>
        <legend>Resident</legend>
        @(Html.InputField(plan, m => m.Name, options => options.Label("Name")).NativeTextBox())
    </fieldset>
    <fieldset>
        <legend>First document</legend>
        <label for="first-document-file">File</label>
        @(plan.Render<IntakeDocumentFile>("first-document-file", Html.Raw("<input type=\"file\" id=\"first-document-file\">")))
        @(Html.InputField(plan, m => m.Documents[0].Caption, options => options.Label("Caption")).NativeTextBox())
    </fieldset>
    <fieldset>
        <legend>Second document</legend>
        <label for="second-document-file">File</label>
        @(plan.Render<IntakeDocumentFile>("second-document-file", Html.Raw("<input type=\"file\" id=\"second-document-file\">")))
        @(Html.InputField(plan, m => m.Documents[1].Caption, options => options.Label("Caption")).NativeTextBox())
    </fieldset>
    <button type="button" @Html.Raises(plan, IntakeDocumentSaves.Save)>Save</button>
    Html.On(plan, trigger => trigger.CustomEvent(IntakeDocumentSaves.Save, pipeline => pipeline
        .Post<IntakeDocuments>(IntakeDocumentsEndpoints.Saves, request => request.Multipart(intake.Container, body => body
            .File(m => m.Documents[0].File, pipeline.Component<IntakeDocumentFile>("first-document-file").Files.Items.At(0))
            .File(m => m.Documents[1].File, pipeline.Component<IntakeDocumentFile>("second-document-file").Files.Items.At(0))))
        .OnSuccess(Content.Text, (saved, pipeline) => pipeline.Element("saved").Text.Set(saved.Body))));
}
<p>Saved: <span id="saved">-</span></p>
@Html.RenderPlan(plan)
