@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model IntakeAssessment
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Intake assessment";
    var plan = Html.ReactivePlan<IntakeAssessment>();
}
<h1>Intake assessment</h1>
@using (var intake = Html.BeginRequestForm(plan, "intake-assessment"))
{
    <fieldset>
        <legend>Strength</legend>
        @(Html.InputField(plan, m => m.Strength, options => options.Label("Strength")).NativeTextBox())
    </fieldset>
    @(Html.NativeButton("save-intake", "Save").Reactive(plan, button => button.Click, (clicked, pipeline) => pipeline
        .Post<IntakeAssessment>(IntakeAssessmentEndpoints.IntakesInGerman, request => request.Form(intake.Form))
        .Validate<IntakeAssessmentRules>()
        .OnSuccess(Content.Text, (saved, pipeline) => pipeline.Element("intake-status").Text.Set(saved.Body))))
}
<p id="intake-status">Not saved</p>
@Html.RenderPlan(plan)
