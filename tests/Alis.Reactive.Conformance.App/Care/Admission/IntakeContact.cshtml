@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model ContactIntake
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Intake";
    var plan = Html.ReactivePlan<ContactIntake>();
}
<h1>Intake</h1>
@using (var intake = Html.BeginRequestForm(plan, "intake"))
{
    @(Html.InputField(plan, m => m.Name, options => options.Label("Name")).NativeTextBox())
    using (var contact = Html.BeginRequestContainer(plan, "contact"))
    {
        <h2>Contact</h2>
        @(Html.InputField(plan, m => m.Phone, options => options.Label("Phone")).NativeTextBox())
        Html.On(plan, trigger => trigger.CustomEvent(IntakeContacts.SendContact, pipeline => pipeline
            .Post<ContactIntake>(IntakeContactEndpoints.Contacts, request => request.Inputs(contact.Container))
            .OnSuccess(Content.Text, (received, pipeline) => pipeline.Element("received").Text.Set(received.Body))));
    }
    <button type="button" @Html.Raises(plan, IntakeContacts.SendContact)>Send contact</button>
    <button type="button" @Html.Raises(plan, IntakeContacts.SendAll)>Send all</button>
    Html.On(plan, trigger => trigger.CustomEvent(IntakeContacts.SendAll, pipeline => pipeline
        .Post<ContactIntake>(IntakeContactEndpoints.Contacts, request => request.Inputs(intake.Form))
        .OnSuccess(Content.Text, (received, pipeline) => pipeline.Element("received").Text.Set(received.Body))));
}
<p>Received by the desk: <span id="received">-</span></p>
@Html.RenderPlan(plan)
