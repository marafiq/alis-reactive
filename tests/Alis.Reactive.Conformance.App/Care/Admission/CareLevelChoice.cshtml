@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model CareLevelChoice
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Care";
    var plan = Html.ReactivePlan<CareLevelChoice>();
}
<h1>Care</h1>
@using (var care = Html.BeginRequestContainer(plan, "care"))
{
    <fieldset>
        <legend>Care level</legend>
        @(Html.InputField(plan, m => m.CareLevel).ConformanceComponent(new ConformanceStart { Text = "Care levels", Value = Model.CareLevel, Options = ["none", "residential", "nursing"] }))
    </fieldset>
    @(Html.NativeButton("save-care", "Save").Reactive(plan, button => button.Click, (clicked, pipeline) => pipeline
        .Post<CareLevelChoice>(CareLevelChoiceEndpoints.Choices, request => request.Inputs(care.Container))
        .Validate<CareLevelChoiceRules>()
        .OnSuccess(Content.Text, (saved, pipeline) => pipeline.Element("care-status").Text.Set(saved.Body))))
}
<p>Saved: <span id="care-status"></span></p>
@Html.RenderPlan(plan)
