@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model ShortStay
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Short stay";
    var plan = Html.ReactivePlan<ShortStay>();
}
<h1>Short stay</h1>
@using (var stay = Html.BeginRequestForm(plan, "short-stay"))
{
    @(Html.InputField(plan, m => m.Resident, options => options.Label("Resident")).NativeTextBox())
    if (Model.AsksNights)
    {
        @(Html.InputField(plan, m => m.Nights, options => options.Label("Nights")).NativeTextBox())
    }
    <button type="button" @Html.Raises(plan, ShortStays.Quote)>Quote</button>
    Html.On(plan, trigger => trigger.CustomEvent(ShortStays.Quote, pipeline => pipeline.Element("quote").Text.Set(stay.Form.Read(m => m.Nights))));
}
<p>Nights quoted: <span id="quote">-</span></p>
@Html.RenderPlan(plan)
