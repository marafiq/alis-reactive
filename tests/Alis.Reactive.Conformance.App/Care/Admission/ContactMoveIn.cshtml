@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model ContactMoveIn
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Move in";
    var plan = Html.ReactivePlan<ContactMoveIn>();
}
<h1>Move in</h1>
@using (var moveIn = Html.BeginRequestContainer(plan, "move-in"))
{
    @(Html.InputField(plan, m => m.Phone, options => options.Label("Phone")).NativeTextBox())
    <section aria-label="Next of kin">
        <h2>Next of kin</h2>
        @await Html.PartialFor(m => m.NextOfKin, "/Care/Admission/ContactMoveInKinCard.cshtml")
    </section>
    @(Html.InputField(plan, m => m.Email, options => options.Label("Email")).NativeTextBox())
    <button type="button" @Html.Raises(plan, ContactMoveIns.Save)>Save</button>
    Html.On(plan, trigger => trigger.CustomEvent(ContactMoveIns.Save, pipeline => pipeline
        .Post<ContactMoveIn>(ContactMoveInEndpoints.MoveIns, request => request.Inputs(moveIn.Container))
        .OnSuccess(Content.Text, (bound, pipeline) => pipeline.Element("bound").Text.Set(bound.Body))));
}
<p>Saved: <span id="bound">-</span></p>
@Html.RenderPlan(plan)
