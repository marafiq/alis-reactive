@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model StayExtension
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Stay extension";
    var plan = Html.ReactivePlan<StayExtension>();
}
<h1>Stay extension</h1>
@using (var stay = Html.BeginRequestForm(plan, "stay"))
{
    @(Html.InputField(plan, m => m.Nights, options => options.Label("Nights")).NativeTextBox())
    <div id="stay-extension"></div>
    <button type="button" @Html.Raises(plan, StayExtensions.AddTheExtension)>Add the extension</button>
    <button type="button" @Html.Raises(plan, StayExtensions.Quote)>Quote</button>
    Html.On(plan, trigger => trigger.CustomEvent(StayExtensions.Quote, pipeline => pipeline.Element("quote").Text.Set(stay.Form.Read(m => m.Nights))));
}
<p>Nights quoted: <span id="quote">-</span></p>
@{
    Html.On(plan, trigger => trigger.CustomEvent(StayExtensions.AddTheExtension, pipeline => pipeline.Get(Model.Section).Into("stay-extension")));
}
@Html.RenderPlan(plan)
