@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model MoveInWithKin
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Move in";
    var plan = Html.ReactivePlan<MoveInWithKin>();
}
<h1>Move in</h1>
@using (var moveIn = Html.BeginRequestForm(plan, "move-in"))
{
    <section aria-label="Resident">
        <h2>Resident</h2>
        @(Html.InputField(plan, m => m.Name, options => options.Label("Name")).NativeTextBox())
    </section>
    <section aria-label="Next of kin">
        <h2>Next of kin</h2>
        @await Html.PartialFor(m => m.Kin, "/Care/Admission/MoveInNextOfKin.cshtml")
    </section>
    <button type="button" @Html.Raises(plan, MoveInsWithKin.Save)>Save</button>
    Html.On(plan, trigger => trigger.CustomEvent(MoveInsWithKin.Save, pipeline => pipeline
        .Post<MoveInWithKin>(MoveInWithKinEndpoints.MoveIns, request => request.Form(moveIn.Form))
        .OnSuccess(Content.Text, (saved, pipeline) => pipeline.Element("move-in-status").Text.Set(saved.Body))
        .OnError<ValidationProblem>(400, (refused, pipeline) => pipeline.ShowValidationErrors(refused.Body))));
}
<p id="move-in-status">Not saved</p>
@Html.RenderPlan(plan)
