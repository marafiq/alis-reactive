@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Conformance.World
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model QuickAdmission
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admission";
    var plan = Html.ReactivePlan<QuickAdmission>();
}
<h1>Admit a resident</h1>
@using (var admission = Html.BeginRequestForm(plan, "quick-admission"))
{
    <fieldset>
        <legend>Name</legend>
        @(Html.InputField(plan, m => m.Name, options => options.Label("Name")).NativeTextBox())
    </fieldset>
    <button type="button" @Html.Raises(plan, QuickAdmissions.Admit)>Admit</button>
    Html.On(plan, trigger => trigger.CustomEvent(QuickAdmissions.Admit, pipeline =>
    {
        pipeline.Post<QuickAdmission>(CareEndpoints.QuickAdmissionAdmissions, request => request.Form(admission.Form))
            .Validate<QuickAdmissionRules>();
        pipeline.Element("admission-log").Text.Set("Sent");
    }));
}
<p>Log: <span id="admission-log">-</span></p>
@Html.RenderPlan(plan)
