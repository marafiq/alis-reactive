@using Alis.Reactive.Conditions
@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model NoonStart
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The noon round";
    var plan = Html.ReactivePlan<NoonStart>();
}
<h1>The noon round</h1>
<p>The round starts at <span id="noon"></span></p>
@{
    Html.On(plan, trigger => trigger.DomReady(pipeline => pipeline.When(pipeline.PageUrl<NoonStart>().Read(start => start.Starts).Eq(new TimeOnly(12, 0)))
        .Then(pipeline => pipeline.Element("noon").Text.Set("noon"))
        .Else(pipeline => pipeline.Element("noon").Text.Set("not noon"))));
}
@Html.RenderPlan(plan)
