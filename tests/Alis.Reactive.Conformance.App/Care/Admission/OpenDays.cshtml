@using Alis.Reactive.Conditions
@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model OpenDays
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Open days";
    var plan = Html.ReactivePlan<OpenDays>();
}
<h1>Open days for @Model.Resident</h1>
@(plan.ConformanceComponent("care-picker", new ConformanceStart { Text = "Care level" }))
<button type="button" @Html.Raises(plan, OpenDayChecks.Check)>Check</button>
<p>The day picked is <span id="open"></span></p>
@{
    Html.On(plan, trigger => trigger.CustomEvent(OpenDayChecks.Check, pipeline => pipeline
        .When(pipeline.Component<ConformanceComponent>("care-picker").Day.In(new DateTime(2026, 10, 27), new DateTime(2026, 10, 29)))
        .Then(pipeline => pipeline.Element("open").Text.Set("an open day"))
        .Else(pipeline => pipeline.Element("open").Text.Set("a closed day"))));
}
@Html.RenderPlan(plan)
