@using Alis.Reactive.ArrayLambdas
@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model RoutineDoses
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Routine doses";
    var plan = Html.ReactivePlan<RoutineDoses>();
    var routine = Model.Routine;
}
<h1>Routine doses</h1>
<dl>
    <dt>Doses off the routine priority</dt>
    <dd id="off-routine-count">-</dd>
    <dt>Doses of the routine priority</dt>
    <dd id="routine-count">-</dd>
    <dt>Priorities in all</dt>
    <dd id="priority-total">-</dd>
</dl>
<p id="doses-status">Waiting</p>
@{
    Html.On(plan, trigger => trigger.DomReady(pipeline => pipeline.Get(Model.Doses)
        .OnSuccess<List<RoutineDose>>((doses, pipeline) =>
        {
            pipeline.Element("off-routine-count").Text.Set(doses.Body.Count(d => (int)d.Priority! != 2));
            pipeline.Element("routine-count").Text.Set(doses.Body.Count(d => d.Priority == (int)routine!));
            pipeline.Element("priority-total").Text.Set(doses.Body.Sum(d => (int)d.Priority!));
            pipeline.Element("doses-status").Text.Set("Summed");
        })));
}
@Html.RenderPlan(plan)
