@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model CensusFirstActiveItems
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "First active rooms";
    var plan = Html.ReactivePlan<CensusFirstActiveItems>();
}
<h1>First active rooms</h1>
@(plan.ConformanceComponent("census", new ConformanceStart { Text = "Census", Items = Model.Census }))
<p>First active room of the census: <span id="census-name">unknown</span></p>
<p id="census-status"></p>
<button type="button" @Html.Raises(plan, CensusFirstActiveItemEvents.Census)>Ask the census</button>
@(plan.ConformanceComponent("census-south", new ConformanceStart { Text = "South wing census", Items = Model.South }))
<p>First active room of the south wing: <span id="census-south-name">unknown</span></p>
<p id="census-south-status"></p>
<button type="button" @Html.Raises(plan, CensusFirstActiveItemEvents.South)>Ask the south wing census</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(CensusFirstActiveItemEvents.Census, pipeline =>
    {
        pipeline.Element("census-status").Text.Set("Asking");
        pipeline.Element("census-name").Text.Set(pipeline.Component<ConformanceComponent>("census").Items.Find(item => item.Active, item => item.Name));
        pipeline.Element("census-status").Text.Set("Asked");
    }));
    Html.On(plan, trigger => trigger.CustomEvent(CensusFirstActiveItemEvents.South, pipeline =>
    {
        pipeline.Element("census-south-status").Text.Set("Asking");
        pipeline.Element("census-south-name").Text.Set(pipeline.Component<ConformanceComponent>("census-south").Items.Find(item => item.Active, item => item.Name));
        pipeline.Element("census-south-status").Text.Set("Asked");
    }));
}
@Html.RenderPlan(plan)
