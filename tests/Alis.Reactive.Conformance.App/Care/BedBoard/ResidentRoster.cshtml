@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.Fusion.FusionTemplates
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@using Syncfusion.EJ2.Grids
@model ResidentRoster
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Resident board";
    var plan = Html.ReactivePlan<ResidentRoster>();
}
<h1>Resident board of the @Model.Wing wing</h1>
@(Html.FusionGrid<ResidentRoster, Resident>(plan, "resident-roster", build => build
    .Columns(new List<GridColumn>
    {
        new() { HeaderText = "Name", Template = FusionTemplate.Create<Resident>().Span(m => m.Name).Render(plan) },
    })))
<p>Residents: <output id="roster-status">Loading</output></p>
@{
    Html.On(plan, trigger => trigger.DomReady(pipeline => pipeline
        .Get(ResidentRosterEndpoints.Residents)
        .OnSuccess(Content.Json<IReadOnlyList<Resident>>(), (residents, pipeline) =>
        {
            pipeline.Component<FusionGrid>("resident-roster").DataSource<Resident>().Set(residents.Body);
            pipeline.Element("roster-status").Text.Set("Loaded");
        })));
}
@Html.RenderPlan(plan)
