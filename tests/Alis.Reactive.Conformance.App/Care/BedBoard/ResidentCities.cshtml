@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.Fusion.FusionTemplates
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@using Syncfusion.EJ2.Grids
@model ResidentCities
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Resident board";
    var plan = Html.ReactivePlan<ResidentCities>();
    var columns = FusionGridColumns.Of<PlacedResident>();
}
<h1>Resident board</h1>
@(Html.FusionGrid<ResidentCities, PlacedResident>(plan, "resident-cities", build => build
    .Columns(new List<GridColumn>
    {
        new() { Field = columns.Field(r => r.Name), HeaderText = "Name" },
        new() { HeaderText = "City", Template = FusionTemplate.Create<PlacedResident>().Span(m => m.Address.City).Render(plan) },
    })))
<p>Residents: <output id="board-status">Loading</output></p>
@{
    Html.On(plan, trigger => trigger.DomReady(pipeline => pipeline
        .Get(Model.ResidentsEndpoint)
        .OnSuccess(Content.Json<IReadOnlyList<PlacedResident>>(), (residents, pipeline) =>
        {
            pipeline.Component<FusionGrid>("resident-cities").DataSource<PlacedResident>().Set(residents.Body);
            pipeline.Element("board-status").Text.Set("Loaded");
        })));
}
@Html.RenderPlan(plan)
