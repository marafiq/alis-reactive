@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.RenderingAndDelivery
@using Syncfusion.EJ2.PivotView
@model WardOccupancy
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Ward occupancy";
    var plan = Html.ReactivePlan<WardOccupancy>();
    var entry = FusionPivotViewFields.Of<OccupancyEntry>();
}
<h1>Ward occupancy</h1>
@(Html.FusionPivotView(plan, "ward-occupancy", build => build
    .DisplayOption(new PivotViewDisplayOption { View = View.Table })
    .DataSourceSettings(new PivotViewDataSourceSettings
    {
        DataSource = Model.Residents,
        Rows = new List<PivotViewRow> { new() { Name = entry.Field(e => e.Ward), Caption = "Ward" } },
        Values = new List<PivotViewRow> { new() { Name = entry.Field(e => e.Residents), Caption = "Headcount" } },
    })))
@Html.RenderPlan(plan)
