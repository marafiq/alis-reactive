@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionAppLevelObjects
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@using Alis.Reactive.ValuesAndSources
@model FusionDischarge
@{
    Layout = "/Care/Shell/_FusionShellLayout.cshtml";
    ViewData["Title"] = "Discharge resident";
    var plan = Html.ReactivePlan<FusionDischarge>();
}
<h1>Discharge resident</h1>
<p>Ward status: <output id="discharge-decision">Admitted</output></p>
@using (Html.BeginRequestContainer(plan, "discharge-question"))
{
    @(Html.InputField(plan, m => m.Question, options => options.Label("Question")).NativeTextBox())
    <button type="button" @Html.Raises(plan, FusionDischargeButtons.Discharge)>Discharge</button>
    Html.On(plan, trigger => trigger.CustomEvent(FusionDischargeButtons.Discharge, pipeline =>
        pipeline.When(pipeline.Component<FusionConfirm>().Ask(pipeline.Input(m => m.Question).Component<NativeTextBox>().Value.OrNull()))
            .Then(pipeline => pipeline.Element("discharge-decision").Text.Set("Discharged"))));
}
@Html.RenderPlan(plan)
