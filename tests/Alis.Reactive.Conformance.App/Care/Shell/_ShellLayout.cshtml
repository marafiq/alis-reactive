@using Alis.Reactive.Native.NativeAppLevelObjects
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="data:,">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <main>
        @RenderBody()
    </main>
    @Html.NativeDrawer("Close")
    @Html.NativeConfirm("Please confirm", ok: "Yes", cancel: "No")
    <script src="~/_content/AlisReactive/js/alis-reactive.js" asp-append-version="true"></script>
</body>
</html>
