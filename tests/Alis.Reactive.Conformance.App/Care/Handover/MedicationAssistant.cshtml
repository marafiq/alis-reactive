@using Alis.Reactive.Conformance.App.Care
@using Alis.Reactive.Fusion.FusionComponents
@using Alis.Reactive.RenderingAndDelivery
@model MedicationAssistant
@{
    Layout = "/Shared/_FusionLayout.cshtml";
    ViewData["Title"] = "Medication assistant";
    var plan = Html.ReactivePlan<MedicationAssistant>();
}
<h1>Medication assistant: @Model.Round</h1>
@(Html.FusionAIAssistView(plan, "medication-assistant", build => build.PromptPlaceholder("Ask about a dose"))
    .Reactive(assistant => assistant.PromptRequest, (asked, pipeline) => pipeline
        .Component<FusionAIAssistView>("medication-assistant").AddPromptResponse("Ask the nurse on duty.")))
@Html.RenderPlan(plan)
