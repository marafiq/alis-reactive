<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <AlisSliceTree>true</AlisSliceTree>
        <VendorContractTsConfig>$(MSBuildThisFileDirectory)tsconfig.json</VendorContractTsConfig>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="**/*.Net48.*" />
        <Content Remove="**/*.Net48.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Alis.Reactive.Analyzers\Alis.Reactive.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\Alis.Reactive\Alis.Reactive.csproj" />
        <ProjectReference Include="..\..\Alis.Reactive.Native\Alis.Reactive.Native.csproj" />
        <ProjectReference Include="..\..\Alis.Reactive.Fusion\Alis.Reactive.Fusion.csproj" />
        <ProjectReference Include="..\..\Alis.Reactive.OpenTelemetry\Alis.Reactive.OpenTelemetry.csproj" />
        <ProjectReference Include="..\Alis.Reactive.Conformance.World\Alis.Reactive.Conformance.World.csproj" />
        <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    </ItemGroup>

    <Import Project="../../Alis.Reactive.Analyzers/Vendors/VendorContract.targets" />

</Project>
