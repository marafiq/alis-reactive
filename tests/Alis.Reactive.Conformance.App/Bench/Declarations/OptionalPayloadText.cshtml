@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model OptionalTextBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Room calls";
    var plan = Html.ReactivePlan<OptionalTextBoard>();
    var roomRaises = new[]
    {
        new RaiseStart { Button = "Raise 4", Text = Model.Room },
        new RaiseStart { Button = "Raise 4 with a note", Text = Model.Room, OptionalText = Model.Note },
    };
    var silentRaises = new[]
    {
        new RaiseStart { Button = "Raise the silent", OptionalText = Model.SilentNote },
    };
}
<h1>Room calls</h1>
@(plan.ConformanceComponent("conformance-a", new ConformanceStart { Raises = roomRaises })
    .Reactive(component => component.Raised, (raised, pipeline) =>
    {
        pipeline.Element("a-note").Text.Set(raised.OptionalText);
        pipeline.Element("a-text").Text.Set(raised.Text);
        pipeline.Element("a-done").Text.Set("raised");
    }))
@(plan.ConformanceComponent("conformance-b", new ConformanceStart { Raises = silentRaises })
    .Reactive(component => component.Raised, (raised, pipeline) =>
    {
        pipeline.Element("b-note").Text.Set(raised.OptionalText);
        pipeline.Element("b-text").Text.Set(raised.Text);
        pipeline.Element("b-done").Text.Set("raised");
    }))
<dl>
    <dt>First call's note</dt>
    <dd id="a-note"></dd>
    <dt>First call's room</dt>
    <dd id="a-text"></dd>
    <dt>First call</dt>
    <dd id="a-done"></dd>
    <dt>Second call's note</dt>
    <dd id="b-note"></dd>
    <dt>Second call's room</dt>
    <dd id="b-text"></dd>
    <dt>Second call</dt>
    <dd id="b-done"></dd>
</dl>
@Html.RenderPlan(plan)
