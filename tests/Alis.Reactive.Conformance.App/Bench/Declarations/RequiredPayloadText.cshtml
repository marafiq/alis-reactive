@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model RequiredTextBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Raised records";
    var plan = Html.ReactivePlan<RequiredTextBoard>();
    var raises = new[]
    {
        new RaiseStart { Button = "Raise without text", EmptyRecord = true },
        new RaiseStart { Button = "Raise Ada", Text = Model.RaisedFor, EmptyRecord = true },
    };
}
<h1>Raised records</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Raises = raises })
    .Reactive(component => component.Raised, (raised, pipeline) =>
    {
        pipeline.Element("record-count").Text.Set(raised.Record.Read(record => record.Count));
        pipeline.Element("raised-text").Text.Set(raised.Text);
        pipeline.Element("raised-recorded").Text.Set("recorded");
    }))
<button type="button" @Html.Raises(plan, RequiredTextButtons.ShowTheText)>Show the text</button>
<dl>
    <dt>Record count</dt>
    <dd id="record-count"></dd>
    <dt>Raised text</dt>
    <dd id="raised-text"></dd>
    <dt>Raise recorded</dt>
    <dd id="raised-recorded"></dd>
    <dt>Text</dt>
    <dd id="text-read"></dd>
</dl>
@{
    Html.On(plan, trigger => trigger.CustomEvent(RequiredTextButtons.ShowTheText, pipeline => pipeline.Element("text-read").Text.Set(pipeline.Component<ConformanceComponent>("conformance").Text)));
}
@Html.RenderPlan(plan)
