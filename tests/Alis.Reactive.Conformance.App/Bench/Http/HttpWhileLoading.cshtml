@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.Conformance.World
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model HttpBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<HttpBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Version = Model.Version, Text = Model.Text, Value = Model.Value, ReadOnlyText = Model.ReadOnlyText }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, HttpCells.Load)>Load</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(HttpCells.Load, pipeline => pipeline
        .Get<ItemsQuery>(BenchEndpoints.Items, request => request.Query(query => query.Code, pipeline.Component<ConformanceComponent>("conformance").ReadOnlyText))
        .WhileLoading(pipeline => pipeline.Component<ConformanceComponent>("conformance").Text.Set("Loading items"))
        .OnSuccess(pipeline => pipeline.Component<ConformanceComponent>("conformance").Text.Set("Alpha, 3 items"))));
}
@Html.RenderPlan(plan)
