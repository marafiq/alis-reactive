@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.Conformance.World
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model HttpBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<HttpBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Options = Model.Codes }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, HttpCells.Load)>Load</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(HttpCells.Load, pipeline =>
    {
        pipeline.Parallel(
            pipeline => pipeline.Get(BenchEndpoints.Items)
                .OnSuccess(Content.Json<ItemsSummary>(), (items, pipeline) => pipeline.Component<ConformanceComponent>("conformance").Text.Set(items.Body.Read(summary => summary.Summary))),
            pipeline => pipeline.Get(BenchEndpoints.Code)
                .OnSuccess(Content.Json<MovedCode>(), (coded, pipeline) => pipeline.Component<ConformanceComponent>("conformance").Value.Set(coded.Body.Read(code => code.Code))));
        pipeline.Element("shown").Text.Set("Answered");
    }));
}
@Html.RenderPlan(plan)
