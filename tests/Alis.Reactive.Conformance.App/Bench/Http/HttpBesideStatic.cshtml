@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.Conformance.World
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model HttpBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<HttpBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Options = Model.Codes }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, HttpCells.Load)>Load</button>
<button type="button" @Html.Raises(plan, HttpCells.LoadWithoutTheLiteral)>Load without the literal</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(HttpCells.Load, pipeline => pipeline
        .Post<Note>(BenchEndpoints.Notes, request => request.Json(body => body
            .Set(note => note.Code, pipeline.Component<ConformanceComponent>("conformance").Value)
            .Set(note => note.Source, "conformance")))));
    Html.On(plan, trigger => trigger.CustomEvent(HttpCells.LoadWithoutTheLiteral, pipeline => pipeline
        .Post<Note>(BenchEndpoints.Notes, request => request.Json(body => body.Set(note => note.Code, pipeline.Component<ConformanceComponent>("conformance").Value)))));
}
@Html.RenderPlan(plan)
