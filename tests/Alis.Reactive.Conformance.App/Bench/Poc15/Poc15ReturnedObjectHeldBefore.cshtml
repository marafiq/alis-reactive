@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model Poc15ReturnedObjectBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<Poc15ReturnedObjectBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Held = new HeldStart { Items = [new ItemStart { Name = "First" }, new ItemStart { Name = "Second" }] } })
    .Reactive(component => component.Raised, (raised, pipeline) =>
    {
        pipeline.Element("shown").Text.Set(raised.Held.ItemAt(1).Name);
        pipeline.Element("next").Text.Set(raised.Held.ItemAt(2).Name);
    }))
<p id="shown"></p>
<p id="next"></p>
@Html.RenderPlan(plan)
