@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model Poc15ComponentBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<Poc15ComponentBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value })
    .Reactive(component => component.Handed, (peer, pipeline) =>
    {
        pipeline.Component<ConformanceComponent>("conformance").SettleCount();
        peer.Ratio.Set(50);
    }))
<p id="shown"></p>
@Html.RenderPlan(plan)
