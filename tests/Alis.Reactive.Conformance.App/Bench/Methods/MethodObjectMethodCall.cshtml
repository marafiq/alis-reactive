@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model MethodBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<MethodBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, CurrentItem = Model.CurrentItem }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, MethodCells.Act)>Act</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(MethodCells.Act, pipeline => pipeline.Component<ConformanceComponent>("conformance").Current().Act()));
}
@Html.RenderPlan(plan)
