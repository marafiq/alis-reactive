@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model MethodBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<MethodBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Count = Model.Count }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, MethodCells.Show)>Show</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(MethodCells.Show, pipeline => pipeline.Element("shown").Text.Set(pipeline.Component<ConformanceComponent>("conformance").Total())));
}
@Html.RenderPlan(plan)
