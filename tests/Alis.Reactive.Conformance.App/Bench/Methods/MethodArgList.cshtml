@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model MethodBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<MethodBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, MethodCells.TakeBoth)>Take both</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(MethodCells.TakeBoth, pipeline => pipeline.Component<ConformanceComponent>("conformance").TakeAll(new[] { new Record { Name = "Alpha", Code = "C7" }, new Record { Name = "Beta", Code = "C8" } })));
}
@Html.RenderPlan(plan)
