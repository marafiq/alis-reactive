@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model ScriptedBoard
@{
    Layout = "/Bench/Sources/_ScriptedLayout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<ScriptedBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Board.Text, Value = Model.Board.Value, Options = Model.Board.Codes }))
<p id="shown"></p>
<section role="log" aria-label="Page log">
    <ol id="page-log"></ol>
</section>
<button type="button" @Html.Raises(plan, SourceCells.Log)>Log</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(SourceCells.Log, pipeline => pipeline.Plugin<PageLog>().Log(pipeline.Component<ConformanceComponent>("conformance").Value)));
}
@Html.RenderPlan(plan)
