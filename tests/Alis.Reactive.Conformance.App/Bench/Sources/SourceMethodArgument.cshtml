@using Alis.Reactive.Conditions
@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model SourceBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<SourceBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Options = Model.Codes }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, SourceCells.Log)>Log</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(SourceCells.Log, pipeline => pipeline.Component<ConformanceComponent>("conformance").Log(pipeline.Component<ConformanceComponent>("conformance").Value.IfNull("none"))));
}
@Html.RenderPlan(plan)
