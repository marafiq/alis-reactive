@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model SourceBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<SourceBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Options = Model.Codes }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, SourceCells.Tell)>Tell</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(SourceCells.Tell, pipeline => pipeline.Dispatch(SourceCells.Picked, pipeline.Object<PickedCode>(picked => picked.Set(code => code.Code, pipeline.Component<ConformanceComponent>("conformance").Value)))));
    Html.On(plan, trigger => trigger.CustomEvent(SourceCells.Picked, (picked, pipeline) => pipeline.Element("shown").Text.Set(picked.Read(code => code.Code))));
}
@Html.RenderPlan(plan)
