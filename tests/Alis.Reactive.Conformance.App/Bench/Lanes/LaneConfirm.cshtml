@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.Native.NativeAppLevelObjects
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model LaneBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<LaneBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Options = Model.Codes }))
<button type="button" @Html.Raises(plan, LaneCells.Move)>Move</button>
@Html.NativeConfirm("Confirm", "OK", "Cancel")
@{
    Html.On(plan, trigger => trigger.CustomEvent(LaneCells.Move, pipeline =>
        pipeline.When(pipeline.Component<NativeConfirm>().Ask("Move to a-2?"))
            .Then(pipeline => pipeline.Component<ConformanceComponent>("conformance").Value.Set("a-2"))));
}
@Html.RenderPlan(plan)
