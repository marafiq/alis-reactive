@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model ConformanceBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<ConformanceBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Items = Model.Items }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, PropertyCells.Count)>Count</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(PropertyCells.Count, pipeline => pipeline.Element("shown").Text.Set(pipeline.Component<ConformanceComponent>("conformance").Items.Count(item => item.Active))));
}
@Html.RenderPlan(plan)
