@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@model ConformanceBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<ConformanceBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Outer = new OuterStart { Text = Model.OuterText } }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, PropertyCells.RenameOuter)>Rename outer</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(PropertyCells.RenameOuter, pipeline => pipeline.Component<ConformanceComponent>("conformance").Outer.Text.Set("Gamma, renamed")));
}
@Html.RenderPlan(plan)
