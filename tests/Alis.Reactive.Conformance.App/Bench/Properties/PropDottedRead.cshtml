@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model ConformanceBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<ConformanceBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value, Outer = new OuterStart { Count = Model.OuterCount } }))
<p id="shown"></p>
<button type="button" @Html.Raises(plan, PropertyCells.Show)>Show</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(PropertyCells.Show, pipeline => pipeline.Element("shown").Text.Set(pipeline.Component<ConformanceComponent>("conformance").Outer.Count)));
}
@Html.RenderPlan(plan)
