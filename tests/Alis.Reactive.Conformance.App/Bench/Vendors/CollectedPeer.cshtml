@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model CollectedPeerBoard
@{
    Layout = "/Bench/Vendors/_ScriptedLayout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<CollectedPeerBoard>();
}
<h1>The bench</h1>
<dl>
    <dt>@Model.Caption</dt>
    <dd id="heard"></dd>
    <dt>First peer</dt>
    <dd id="peer-state"></dd>
    <dt>Slot</dt>
    <dd id="slot-state"></dd>
</dl>
@(plan.ConformanceComponent("conformance", new ConformanceStart()))
<button type="button" @Html.Raises(plan, CollectedPeerButtons.OpenTheSlot)>Open the slot</button>
<button type="button" @Html.Raises(plan, CollectedPeerButtons.CloseTheSlot)>Close the slot</button>
<button type="button" @Html.Raises(plan, CollectedPeerButtons.CheckTheFirstPeer)>Check the first peer</button>
<section id="holder" aria-label="Holder"></section>
@{
    Html.On(plan, trigger => trigger
        .CustomEvent(CollectedPeerButtons.OpenTheSlot, pipeline => pipeline.Get(VendorSlotCards.PeerHolder).Into("holder"))
        .CustomEvent(CollectedPeerButtons.CloseTheSlot, pipeline =>
        {
            pipeline.Unload("holder");
            pipeline.Element("slot-state").Text.Set("closed");
        })
        .CustomEvent(CollectedPeerButtons.CheckTheFirstPeer, pipeline => pipeline.Element("peer-state").Text.Set(pipeline.Component<ConformanceComponent>("conformance").FirstPeerState)));
}
@Html.RenderPlan(plan)
