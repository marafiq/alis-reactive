@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model CallbackHolderCard
@{
    var plan = Html.ReactivePlan<CallbackHolderCard>();
}
<p>@Model.Note</p>
<button type="button" @Html.Raises(plan, CallbackHolderButtons.OpenTheInnerSlot)>Open the inner slot</button>
<section id="inner" aria-label="Inner slot"></section>
@{
    Html.On(plan, trigger => trigger
        .DomReady(pipeline => pipeline.Listen(
            pipeline.Component<ConformanceCallbacks>("callbacks"),
            callbacks => callbacks.OnRaised,
            (raised, pipeline) => pipeline.Component<ConformanceCallbacks>("callbacks").Append("outer")))
        .CustomEvent(CallbackHolderButtons.OpenTheInnerSlot, pipeline => pipeline.Get(VendorSlotCards.HolderInner).Into("inner")));
}
@Html.RenderPlan(plan)
