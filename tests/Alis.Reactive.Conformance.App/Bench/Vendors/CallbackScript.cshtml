@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model CallbackScriptBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<CallbackScriptBoard>();
}
<h1>The bench</h1>
<h2>@Model.Caption</h2>
@(plan.ConformanceCallbacks("callbacks", new CallbacksStart()))
<button type="button" @Html.Raises(plan, CallbackScriptButtons.OpenTheCard)>Open the card</button>
<button type="button" @Html.Raises(plan, CallbackScriptButtons.CloseTheCard)>Close the card</button>
<section id="card" aria-label="Card"></section>
@{
    Html.On(plan, trigger => trigger
        .CustomEvent(CallbackScriptButtons.OpenTheCard, pipeline => pipeline.Get(VendorSlotCards.Card).Into("card"))
        .CustomEvent(CallbackScriptButtons.CloseTheCard, pipeline => pipeline.Unload("card")));
}
@Html.RenderPlan(plan)
