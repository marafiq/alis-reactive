@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model CallbackHolderInner
@{
    var plan = Html.ReactivePlan<CallbackHolderInner>();
}
<p>@Model.Note</p>
@{
    Html.On(plan, trigger => trigger.DomReady(pipeline =>
    {
        pipeline.Listen(
            pipeline.Component<ConformanceCallbacks>("callbacks"),
            callbacks => callbacks.OnRaised,
            (raised, pipeline) => pipeline.Component<ConformanceCallbacks>("callbacks").Append("inner"));
        pipeline.Element("inner-opened").Text.Set(pipeline.Plugin<PageTally>().AddOne());
    }));
}
@Html.RenderPlan(plan)
