@using Alis.Reactive.Conformance.App.Bench
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model EventBoard
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The bench";
    var plan = Html.ReactivePlan<EventBoard>();
}
<h1>The bench</h1>
@(plan.ConformanceComponent("conformance", new ConformanceStart { Text = Model.Text, Value = Model.Value })
    .Reactive(component => component.Raised, (raised, pipeline) =>
    {
        pipeline.Element("shown").Text.Set(raised.Held.Item.Settle());
        pipeline.When(raised.Flag).Then(pipeline => pipeline.Element("flagged").Text.Set("Flagged"));
    }))
<p id="shown"></p>
<p id="flagged"></p>
@Html.RenderPlan(plan)
