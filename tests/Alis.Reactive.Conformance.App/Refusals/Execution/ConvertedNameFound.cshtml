@using Alis.Reactive.ArrayLambdas
@using Alis.Reactive.Conformance.App.Components
@using Alis.Reactive.Conformance.App.Refusals
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model SpotRoster
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The wing's bindings";
    var plan = Html.ReactivePlan<SpotRoster>();
}
<h1>@Model.Wing</h1>
@(plan.ConformanceComponent("roster", new ConformanceStart()))
<p>Beta was converted by: <span id="found-converted"></span></p>
<button type="button" @Html.Raises(plan, ConvertedNames.Show)>Show the converted</button>
@{
    Html.On(plan, trigger => trigger.CustomEvent(ConvertedNames.Show, pipeline => pipeline.Element("found-converted").Text.Set(pipeline.Component<ConformanceComponent>("roster").Bindings.Find(b => b.Name == "Beta", b => b.Converted.Name))));
}
@Html.RenderPlan(plan)
