@using Alis.Reactive.ArrayLambdas
@using Alis.Reactive.Conformance.App.Refusals
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model PriorityRound
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "The round's doses";
    var plan = Html.ReactivePlan<PriorityRound>();
    var none = Model.Priority;
}
<h1>The round's doses</h1>
<p>Doses of the round's priority: <span id="count"></span></p>
@{
    Html.On(plan, trigger => trigger.DomReady(pipeline => pipeline.Get(ArrayLambdaEndpoints.DosesByPriority)
        .OnSuccess<List<PriorityDose>>((doses, pipeline) => pipeline.Element("count").Text.Set(doses.Body.Count(d => d.Priority == (int)none!)))));
}
@Html.RenderPlan(plan)
