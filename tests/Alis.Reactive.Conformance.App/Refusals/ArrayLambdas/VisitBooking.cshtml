@using Alis.Reactive.Conformance.App.Refusals
@using Alis.Reactive.Native.NativeComponents
@using Alis.Reactive.RequestsAndResponses
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model VisitBooking
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Book a visit";
    var plan = Html.ReactivePlan<VisitBooking>();
}
<h1>Book a visit</h1>
@using (var visit = Html.BeginRequestForm(plan, "visit-booking"))
{
    <fieldset>
        <legend>Visit</legend>
        @(Html.InputField(plan, m => m.At, options => options.Label("At")).NativeTextBox())
    </fieldset>
    @(Html.NativeButton("save-visit", "Save").Reactive(plan, button => button.Click, (clicked, pipeline) => pipeline
        .Post<VisitBooking>(VisitBookingEndpoints.Visits, request => request.Form(visit.Form))
        .Validate<VisitValidator>()
        .OnSuccess(Content.Text, (booked, pipeline) => pipeline.Element("booked").Text.Set(booked.Body))))
}
<p id="booked"></p>
@Html.RenderPlan(plan)
