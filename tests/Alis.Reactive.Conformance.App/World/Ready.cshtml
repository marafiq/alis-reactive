@using Alis.Reactive.Conformance.App.World
@using Alis.Reactive.RenderingAndDelivery
@using Alis.Reactive.TriggersAndPipelines
@model ReadyPage
@{
    Layout = "/Shared/_Layout.cshtml";
    ViewData["Title"] = "Ready";
    var plan = Html.ReactivePlan<ReadyPage>();
}
<h1>Ready</h1>
<p id="ready"></p>
@{
    Html.On(plan, trigger => trigger.DomReady(pipeline => pipeline.Element("ready").Text.Set("ready")));
}
@Html.RenderPlan(plan)
