<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>

    <ItemGroup>
        <!-- The plans are authored against the core alone: a page's elements are declared here, on the
             core's own native vendor, and no consumer package is referenced. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="../../Alis.Reactive/Alis.Reactive.csproj" />
        <ProjectReference Include="../../Alis.Reactive.FluentValidator/Alis.Reactive.FluentValidator.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The goldens travel with the tests: each is the plan a test wrote the last time it was reviewed. -->
        <None Include="Goldens/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
