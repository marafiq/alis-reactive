@using Alis.Reactive.Framework.App.Forms
@model StayPage
@{
    // A partial of the stay's own model, loaded into the stay's form: its own check shows the server's answer on
    // the stay's form, which it joins while it is loaded.
    var plan = Html.ReactivePlan<StayPage>();
}
<section id="guest-line">
    @{ Html.InputField(plan, m => m.Guest, o => o.Label("Guest")).Entry(); }
    <p>The guest check said: <span id="guest-checked"></span></p>

    @(plan.Button("check-guest", "Check the guest")
        .Reactive(button => button.Click, p => p.Post("/Forms/CheckGuest")
            .Gather(g => g.Form("guest-line"))
            .Response(r => r
                .OnSuccess<FormsEcho>((echo, s) => s.Element("guest-checked").Text.Set(echo.Get(x => x.Summary)))
                .OnError(400, e => e.ValidationErrors("stay-form")))))
</section>

@Html.RenderPlan(plan)
