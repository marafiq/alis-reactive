@using Alis.Reactive.Framework.App.Forms
@model LunchPage
@{
    ViewData["Title"] = "A lunch";
    var plan = Html.ReactivePlan<LunchPage>();
}
<h1>A lunch</h1>

<form id="lunch-form">
    @{ Html.InputField(plan, m => m.Resident, o => o.Label("Resident")).Entry(); }
    <fieldset id="companion-section">
        <legend>The companion</legend>
        @{ Html.InputField(plan, m => m.Companion, o => o.Label("Companion")).Entry(); }
    </fieldset>
</form>

<p>The endpoint bound: <span id="lunch-bound"></span></p>

@(plan.Button("save-companion", "Save the companion")
    .Reactive(button => button.Click, p => p.Post("/Forms/BookLunch")
        .Gather(g => g.Form())
        .Validate<LunchCompanionRules>("companion-section")
        .Response(r => r.OnSuccess<FormsEcho>((echo, s) => s.Element("lunch-bound").Text.Set(echo.Get(x => x.Summary))))))
@(plan.Button("book-lunch", "Book the lunch")
    .Reactive(button => button.Click, p => p.Post("/Forms/BookLunch")
        .Gather(g => g.Form())
        .Validate<LunchRules>("lunch-form")
        .Response(r => r.OnSuccess<FormsEcho>((echo, s) => s.Element("lunch-bound").Text.Set(echo.Get(x => x.Summary))))))

<section id="lunch-messages" aria-label="The lunch's messages">
    @Html.RenderPlan(plan)
</section>
