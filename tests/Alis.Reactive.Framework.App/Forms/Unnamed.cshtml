@using Alis.Reactive.Framework.App.Forms
@model OutingPage
@{
    ViewData["Title"] = "An outing sent from no form";
    var plan = Html.ReactivePlan<OutingPage>();
}
<h1>An outing sent from no form</h1>

<form id="outing-form">
    @{ Html.InputField(plan, m => m.Resident, o => o.Label("Resident")).Entry(); }
</form>

@(plan.Button("book-outing", "Book the outing")
    .Reactive(button => button.Click, p => p.Post("/Forms/Bound").Gather(g => g.Form())))

@Html.RenderPlan(plan)
