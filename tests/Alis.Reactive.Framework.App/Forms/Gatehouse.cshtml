@using Alis.Reactive.Framework.App.Forms
@model GatehousePage
@{
    ViewData["Title"] = "The gatehouse";
    var plan = Html.ReactivePlan<GatehousePage>();
}
<h1>The gatehouse</h1>

<form id="gate-form">
    @{ Html.InputField(plan, m => m.Visitor, o => o.Label("Visitor")).Entry(); }
</form>

@(plan.Button("sign-visitor", "Sign the visitor in")
    .Reactive(button => button.Click, p => p.Post("/Forms/SignVisitor")
        .Gather(g => g.Form("gate-form"))
        .Response(r => r.OnError(e => e.ValidationErrors("gate-form")))))
@(plan.Button("sign-while-down", "Sign in while the gate's server is down")
    .Reactive(button => button.Click, p => p.Post("/Forms/GateDown")
        .Gather(g => g.Form("gate-form"))
        .Response(r => r.OnError(e => e.ValidationErrors("gate-form")))))
@(plan.Button("sign-when-dropped", "Sign in when the gate's line drops")
    .Reactive(button => button.Click, p => p.Post("/Forms/GateDropped")
        .Gather(g => g.Form("gate-form"))
        .Response(r => r.OnError(e => e.ValidationErrors("gate-form")))))

<section id="gate-messages" aria-label="The gatehouse's messages">
    @Html.RenderPlan(plan)
</section>
