@using Alis.Reactive.Framework.App.Events
@model SlateEventsPage
@{
    ViewData["Title"] = "A slate's events";
    var plan = Html.ReactivePlan<SlateEventsPage>();
}
<h1>A slate's events</h1>

@(plan.Slate("slate", title: "Day round", "Ada", "Ben")
    .Reactive(slate => slate.Cleared, p => p.Element("cleared").Text.Set("The slate was cleared"))
    .Reactive(slate => slate.RowAdded, (added, p) =>
    {
        p.Element("added-label").Text.Set(added.Label);
        p.Element("added-count").Text.Set(added.Count);
    })
    .Reactive(slate => slate.Changing, (change, p) =>
        p.When(change.Requested).Eq("Night round")
            .Then(t =>
            {
                change.Cancel.Set(true);
                change.Reason.Set("Rounds keep their name");
            })
            .Else(e => change.Clamp()))
    .Reactive(slate => slate.Header.Renamed, (renamed, p) => p.Element("renamed").Text.Set(renamed.Caption)))

<p>Cleared: <span id="cleared"></span></p>
<p>Added: <span id="added-label"></span>, rows now <span id="added-count"></span></p>
<p>Header renamed to: <span id="renamed"></span></p>

@(plan.Button("clear", "Clear")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").Clear()))
@(plan.Button("rename-header", "Rename the header")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").Header.Rename("Evening round")))

@Html.RenderPlan(plan)
