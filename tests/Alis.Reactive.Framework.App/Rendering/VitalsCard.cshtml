@using Alis.Reactive.Framework.App.Rendering
@model VitalsCard
@{
    var plan = Html.ReactivePlan<VitalsCard>();
}
<section id="vitals" aria-label="Vitals">
    <h2>Vitals</h2>
    @{ Html.InputField(plan, m => m.Pulse, o => o.Label("Pulse")).Entry(); }
    <p>The vitals are <span id="vitals-state">not recorded</span>.</p>
    @(plan.Button("record-vitals", "Record the vitals")
        .Reactive(button => button.Click, p => p.Element("vitals-state").Text.Set("recorded")))
    @Html.RenderPlan(plan)
</section>
