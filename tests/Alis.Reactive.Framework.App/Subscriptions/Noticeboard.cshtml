@using Alis.Reactive.Framework.App.Components
@using Alis.Reactive.Framework.App.Subscriptions
@model NoticeboardPage
@{
    ViewData["Title"] = "The noticeboard";
    var plan = Html.ReactivePlan<NoticeboardPage>();
    plan.Component<Banner>().Reactive(evt => evt.Flashed, (flashed, p) => p.Element("page-heard").Text.Set(flashed.Times));
}
<h1>The noticeboard</h1>

@Html.Banner()

<p>The page heard flash: <span id="page-heard"></span> · the desk heard flash: <span id="desk-heard"></span></p>

<div id="desk-slot"></div>

@(plan.Button("flash-banner", "Flash the banner")
    .Reactive(button => button.Click, p => p.Component<Banner>().Flash()))
@(plan.Button("open-desk", "Open the desk")
    .Reactive(button => button.Click, p => p.Get("/Subscriptions/NoticeboardDesk").Response(r => r.OnSuccess(s => s.Into("desk-slot")))))
@(plan.Button("close-desk", "Close the desk")
    .Reactive(button => button.Click, p => p.Unload("desk-slot")))

@Html.RenderPlan(plan)
