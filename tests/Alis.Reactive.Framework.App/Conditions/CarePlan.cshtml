@using Alis.Reactive.Framework.App.Conditions
@model CarePlanPage
@{
    ViewData["Title"] = "Care plan";
    var plan = Html.ReactivePlan<CarePlanPage>();
}
<h1>Care plan</h1>

@plan.Meter("pain", level: 0, max: 5)

<p>Plan: <span id="plan"></span></p>
<p>Alarm: <span id="alarm"></span></p>
<p>Planned at pain: <span id="planned-at"></span></p>

@(plan.Button("plan-care", "Plan care")
    .Reactive(button => button.Click, p =>
    {
        var pain = p.Component<Meter>("pain").Level;
        p.When(pain).Gte(4)
            .Then(t => t.Element("plan").Text.Set("Call the doctor"))
            .ElseIf(pain).Gte(2)
            .Then(t => t.Element("plan").Text.Set("Give pain relief"))
            .Else(e => e.Element("plan").Text.Set("No action"));
        p.When(pain).Eq(5)
            .Then(t => t.Element("alarm").Text.Set("Raise the alarm"));
        p.Element("planned-at").Text.Set(pain);
    }))

@Html.RenderPlan(plan)
