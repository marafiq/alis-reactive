{
  "name": "alis-reactive-framework-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The framework test app's components and stylesheet, built the way an app builds its own. Not shipped.",
  "scripts": {
    "build": "node esbuild.config.mjs && tailwindcss -i Styles/framework.css -o wwwroot/css/framework.css --minify",
    "watch": "node esbuild.config.mjs --watch",
    "watch:css": "tailwindcss -i Styles/framework.css -o wwwroot/css/framework.css --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  }
}
