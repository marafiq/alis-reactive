@using Alis.Reactive.Framework.App.Plugins
@model TallyPage
@{
    ViewData["Title"] = "A plugin";
    var plan = Html.ReactivePlan<TallyPage>();
    var tally = plan.RegisterPlugin<Tally>();
}
<h1>A plugin</h1>

<p>Total read: <span id="total"></span></p>
<p>Against the mark: <span id="against-mark"></span></p>
<p>Last amount added: <span id="last-amount"></span></p>
<p>Day of the last entry: <span id="last-day"></span></p>

@(plan.Button("add-four", "Add 4")
    .Reactive(button => button.Click, p => tally.Add(4)))
@(plan.Button("add-entry", "Add an entry of 5")
    .Reactive(button => button.Click, p => tally.AddEntry(new TallyEntry { Count = 5, AddedOn = new DateTime(2026, 11, 2) })))
@(plan.Button("add-kept-entry", "Add the entry the office keeps")
    .Reactive(button => button.Click, p => p.Get("/Plugins/Tally/Entry")
        .Response(r => r.OnSuccess<TallyEntry>((entry, s) =>
        {
            tally.AddEntry(entry);
            s.Element("last-day").Text.Set(tally.LastDay);
        }))))
@(plan.Button("read-total", "Read the total")
    .Reactive(button => button.Click, p => p.Element("total").Text.Set(tally.Total)))
@(plan.Button("lower-mark", "Lower the mark to 3")
    .Reactive(button => button.Click, p => tally.Mark.Set(3)))
@(plan.Button("check-mark", "Has the tally passed the mark?")
    .Reactive(button => button.Click, p => p.When(tally.HasPassedTheMark()).Truthy()
        .Then(t => t.Element("against-mark").Text.Set("passed"))
        .Else(e => e.Element("against-mark").Text.Set("not yet"))))
@(plan.Button("read-last", "Read the last amount added")
    .Reactive(button => button.Click, p => p.When(tally.Last.Get(entry => entry.Count)).Gt(0)
        .Then(t => t.Element("last-amount").Text.Set(tally.Last.Get(entry => entry.Count)))
        .Else(e => e.Element("last-amount").Text.Set("nothing added yet"))))

@Html.RenderPlan(plan)
