@using Alis.Reactive.Framework.App.Vendors
@model ElementPage
@{
    ViewData["Title"] = "The element as the object";
    var plan = Html.ReactivePlan<ElementPage>();
}
<h1>The element as the object</h1>

@(plan.Meter("meter", level: 3, max: 10)
    .Reactive(meter => meter.LevelChanged, (change, p) =>
    {
        p.Element("changed-to").Text.Set(change.Level);
        p.Element("changed-from").Text.Set(change.Previous);
    })
    .Reactive(meter => meter.Change, (meter, p) => p.Element("change-read").Text.Set(meter.Level)))

<p>Changed to <span id="changed-to"></span> from <span id="changed-from"></span></p>
<p>The meter read off its change: level <span id="change-read"></span></p>
<p>Level read: <span id="level"></span> of <span id="max"></span></p>

@(plan.Button("set-level", "Set the level to 7")
    .Reactive(button => button.Click, p => p.Component<Meter>("meter").Level.Set(7)))
@(plan.Button("read-level", "Read the level")
    .Reactive(button => button.Click, p =>
    {
        var meter = p.Component<Meter>("meter");
        p.Element("level").Text.Set(meter.Level);
        p.Element("max").Text.Set(meter.Max);
    }))

@Html.RenderPlan(plan)
