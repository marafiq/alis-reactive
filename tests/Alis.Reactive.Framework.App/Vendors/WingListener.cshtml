@using Microsoft.AspNetCore.Html
@using Alis.Reactive.Framework.App.Vendors
@model WingListener
@{
    var plan = Html.ReactivePlan<WingListener>();
}
<section>
    <h2>The @Model.Wing wing is listening</h2>

    @* The page's bell, joined to this plan with no markup of its own: the wing's handler is assigned to the
       bell's callback property after the page's, for as long as the wing's slot holds it. *@
    @(plan.Render<Bell>("bell", HtmlString.Empty)
        .Reactive(bell => bell.OnRung, (ring, p) =>
        {
            p.Element($"{Model.Wing}-heard").Text.Set(ring.Times);
            p.Element("last-handler").Text.Set($"the {Model.Wing} wing");
        }))
</section>

@Html.RenderPlan(plan)
