@using Alis.Reactive.Framework.App.Boundaries
@model DeskPage
@{
    ViewData["Title"] = "The night desk";
    var plan = Html.ReactivePlan<DeskPage>();
}
<h1>The night desk</h1>

@plan.Slate("slate", title: "Night", "Ada", "Ben")

<p>Title: <span id="title"></span></p>
<p>Looking Ben up: <span id="asked"></span> · found: <span id="found"></span> · then: <span id="went-on"></span></p>
<p>Counting the header: <span id="header-asked"></span> · headers: <span id="header-count"></span> · then: <span id="header-went-on"></span></p>

@(plan.Button("read-title", "Read the title")
    .Reactive(button => button.Click, p => p.Element("title").Text.Set(p.Component<Slate>("slate").Title)))
@(plan.Button("look-up-at-once", "Look Ben up at once")
    .Reactive(button => button.Click, p =>
    {
        p.Element("asked").Text.Set("asked");
        p.Element("found").Text.Set(p.Component<HastySlate>("slate").Lookup("Ben"));
        p.Element("went-on").Text.Set("went on");
    }))
@(plan.Button("count-headers", "Count the headers")
    .Reactive(button => button.Click, p =>
    {
        p.Element("header-asked").Text.Set("asked");
        p.Element("header-count").Text.Set(p.From(p.Component<ListedSlate>("slate").Header).Count());
        p.Element("header-went-on").Text.Set("went on");
    }))

@Html.RenderPlan(plan)
