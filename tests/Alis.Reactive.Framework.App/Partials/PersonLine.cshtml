@using Alis.Reactive.Framework.App.Partials
@model PersonName
@{
    // The community's person line: a partial of a model of its own, rendered under the prefix of whichever member
    // holds a person's name, so its input binds as that member's name (NextOfKin.Name), and its plan is its own.
    var label = (string)ViewData["Label"]!;
    var plan = Html.ReactivePlan<PersonName>();
}
<div class="person-line">
    @{ Html.InputField(plan, m => m.Name, o => o.Label(label)).Entry(); }

    <p>The name read back: <span id="name-read-back"></span></p>

    @(plan.Button("read-name-back", "Read the name back")
        .Reactive(button => button.Click, p => p.When(p.Bound(m => m.Name)).IsNull()
            .Then(none => none.Element("name-read-back").Text.Set("no name"))
            .Else(some => some.Element("name-read-back").Text.Set(p.Bound(m => m.Name)))))
</div>

@Html.RenderPlan(plan)
