@using Alis.Reactive.Framework.App.Partials
@model LobbyPage
@{
    ViewData["Title"] = "The lobby";
    var plan = Html.ReactivePlan<LobbyPage>();
}
<h1>The lobby</h1>

@* The visitor's line is a partial of the base class every visit record shares, rendered with the page's model. *@
@await Html.PartialAsync("VisitorLine", Model)
@{ Html.InputField(plan, m => m.Resident, o => o.Label("Resident")).Entry(); }

<p>The visitor read back: <span id="visitor-read"></span></p>

@(plan.Button("read-visitor", "Read the visitor")
    .Reactive(button => button.Click, p => p.Element("visitor-read").Text.Set(p.Component<Entry>(m => m.Visitor).Value)))

@Html.RenderPlan(plan)
