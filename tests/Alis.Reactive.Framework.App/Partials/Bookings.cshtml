@using Alis.Reactive.Framework.App.Partials
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model BookingsPage
@{
    ViewData["Title"] = "Bookings";
    var plan = Html.ReactivePlan<BookingsPage>();

    var sittingKin = new ViewDataDictionary(ViewData) { { "Label", "The sitting's next of kin" } };
    sittingKin.TemplateInfo.HtmlFieldPrefix = nameof(BookingsPage.NextOfKin);
}
<h1>Bookings</h1>

@* Each form holds an input that binds NextOfKin.Name: the visit's through the next of kin's own card, the
   sitting's through the community's person line. The visit's rule reads the next of kin its own form holds, as
   its save sends it. *@
<form id="visit-form" aria-label="The visit">
    @{ Html.InputField(plan, m => m.Visitor, o => o.Label("Visitor")).Entry(); }
    @Html.EditorFor(m => m.NextOfKin)
</form>

<form id="sitting-form" aria-label="The sitting">
    @await Html.PartialAsync("PersonLine", new PersonName(), sittingKin)
</form>

<p>The visit's endpoint booked: <span id="visit-booked"></span></p>

@(plan.Button("book-visit", "Book the visit")
    .Reactive(button => button.Click, p => p.Post("/Partials/BookVisit")
        .Gather(g => g.Form())
        .Validate<BookingRules>("visit-form")
        .Response(r => r
            .OnSuccess<PartialsEcho>((echo, s) => s.Element("visit-booked").Text.Set(echo.Get(x => x.Summary)))
            .OnError(400, e => e.ValidationErrors("visit-form")))))

<section id="bookings-messages" aria-label="The bookings' messages">
    @Html.RenderPlan(plan)
</section>
