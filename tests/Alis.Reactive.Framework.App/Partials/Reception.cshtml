@using Alis.Reactive.Framework.App.Partials
@model DeskPage
@{
    ViewData["Title"] = "The reception";
    var plan = Html.ReactivePlan<DeskPage>();
}
<h1>The reception</h1>

<form id="reception-form">
    @{ Html.InputField(plan, m => m.Visitor, o => o.Label("Visitor")).Entry(); }
    @* The next of kin's editor template is loaded here when the visitor names one, rendered for the member, so its
       input binds as NextOfKin.Name. The page's rules on the member are the only ones. *@
    <div id="kin-slot"></div>
</form>

<p>The reception's endpoint bound: <span id="reception-saved"></span></p>

@(plan.Button("add-kin", "Add the next of kin")
    .Reactive(button => button.Click, p => p.Get("/Partials/NextOfKin").Response(r => r.OnSuccess(s => s.Into("kin-slot")))))
@(plan.Button("remove-kin", "Remove the next of kin")
    .Reactive(button => button.Click, p => p.Unload("kin-slot")))
@(plan.Button("save-visit", "Save the visit")
    .Reactive(button => button.Click, p => p.Post("/Partials/SaveDesk")
        .Gather(g => g.Form())
        .Validate<DeskRules>("reception-form")
        .Response(r => r
            .OnSuccess<PartialsEcho>((echo, s) => s.Element("reception-saved").Text.Set(echo.Get(x => x.Summary)))
            .OnError(400, e => e.ValidationErrors("reception-form")))))

<section id="reception-messages" aria-label="The reception's messages">
    @Html.RenderPlan(plan)
</section>
