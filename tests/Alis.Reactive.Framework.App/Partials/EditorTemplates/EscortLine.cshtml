@using Alis.Reactive.Framework.App.Partials
@model EscortLine
@{
    // An escort's editor template, rendered under the member's prefix (Driver, Aide): its plan is its own, and its
    // check shows the server's answer on the escort's form.
    var member = ViewData.TemplateInfo.HtmlFieldPrefix;
    var slug = member.ToLowerInvariant();
    var plan = Html.ReactivePlan<EscortLine>();
}
<section id="@(slug)-line" aria-label="The @slug">
    @{ Html.InputField(plan, m => m.Name, o => o.Label($"The {slug}'s name")).Entry(); }

    @(plan.Button($"check-{slug}", $"Check the {slug}")
        .Reactive(button => button.Click, p => p.Post("/Partials/CheckEscort")
            .Gather(g => g.Form($"{slug}-line"))
            .Response(r => r.OnError(400, e => e.ValidationErrors("escort-form")))))
</section>

@Html.RenderPlan(plan)
