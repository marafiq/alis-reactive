@using Alis.Reactive.Framework.App.Partials
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model ConciergePage
@{
    ViewData["Title"] = "The concierge";
    var plan = Html.ReactivePlan<ConciergePage>();

    var kin = new ViewDataDictionary(ViewData) { { "Label", "Next of kin" } };
    kin.TemplateInfo.HtmlFieldPrefix = nameof(ConciergePage.NextOfKin);
}
<h1>The concierge</h1>

<form id="concierge-form">
    @{ Html.InputField(plan, m => m.Visitor, o => o.Label("Visitor")).Entry(); }
    @await Html.PartialAsync("PersonLine", new PersonName(), kin)
</form>

<p>The next of kin as the concierge would bind it: <span id="kin-bound"></span></p>
<p>The concierge's notes: <span id="kin-noted"></span></p>
<p>The concierge's endpoint bound: <span id="concierge-saved"></span></p>

@(plan.Button("read-kin", "Read the next of kin")
    .Reactive(button => button.Click, p => p.When(p.Bound(m => m.NextOfKin.Name)).IsNull()
        .Then(none => none.Element("kin-bound").Text.Set("no next of kin"))
        .Else(some => some.Element("kin-bound").Text.Set(p.Bound(m => m.NextOfKin.Name)))))
@(plan.Button("note-kin", "Note the next of kin")
    .Reactive(button => button.Click, p => p.Post("/Partials/NoteKin")
        .Gather<KinNote>(g => g.Form(m => m.NextOfKin.Name))
        .Response(r => r.OnSuccess<PartialsEcho>((echo, s) => s.Element("kin-noted").Text.Set(echo.Get(x => x.Summary))))))
@(plan.Button("save-concierge", "Save the visit")
    .Reactive(button => button.Click, p => p.Post("/Partials/SaveConcierge")
        .Gather(g => g.Form())
        .Validate<ConciergeRules>("concierge-form")
        .Response(r => r
            .OnSuccess<PartialsEcho>((echo, s) => s.Element("concierge-saved").Text.Set(echo.Get(x => x.Summary)))
            .OnError(400, e => e.ValidationErrors("concierge-form")))))

<section id="concierge-messages" aria-label="The concierge's messages">
    @Html.RenderPlan(plan)
</section>
