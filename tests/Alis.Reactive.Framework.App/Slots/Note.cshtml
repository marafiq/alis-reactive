@using Alis.Reactive.Framework.App.Slots
@model HallNote
@{
    var plan = Html.ReactivePlan<HallNote>();
}
<p id="note">The hall closes at nine. Stamp: @Html.Stamp("note-stamp", "stamped by its own script")</p>

@{ Html.On(plan, t => t.CustomEvent(HallEvents.Rang, (rang, p) => p.Element("note-heard").Text.Set(rang.Get(x => x.Times)))); }

@Html.RenderPlan(plan)
