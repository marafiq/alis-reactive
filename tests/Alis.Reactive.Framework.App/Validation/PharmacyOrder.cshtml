@using Alis.Reactive.Framework.App.Validation
@model PharmacyOrder
@{
    ViewData["Title"] = "A pharmacy order";
    var plan = Html.ReactivePlan<PharmacyOrder>();
}
<h1>A pharmacy order</h1>

<div id="order-form">
    @{ Html.InputField(plan, m => m.Amount, o => o.Label("Amount")).Entry(); }
    @{ Html.InputField(plan, m => m.Ledger, o => o.Label("Ledger")).Entry(); }
</div>

<p>Saved: <span id="saved"></span></p>

@(plan.Button("save", "Save")
    .Reactive(button => button.Click, p => p.Post("/Validation/PharmacyOrder")
        .Gather(g => g.Form())
        .Validate<PharmacyOrderRules>("order-form")
        .Response(r => r
            .OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary)))
            .OnError(400, e => e.ValidationErrors("order-form")))))

@Html.RenderPlan(plan)
