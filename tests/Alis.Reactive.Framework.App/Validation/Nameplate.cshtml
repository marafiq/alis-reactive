@using Alis.Reactive.Framework.App.Validation
@model Nameplate
@{
    ViewData["Title"] = "A nameplate";
    var plan = Html.ReactivePlan<Nameplate>();
    var name = (NameplateName)ViewData["Name"]!;
}
<h1>A nameplate</h1>

<div id="nameplate-form">
    @{ Html.InputField(plan, m => m.Resident, o => o.Label("Resident")).Entry(); }
</div>

<p>Saved: <span id="saved"></span></p>

@switch (name)
{
    case NameplateName.Spoken:
        @(plan.Button("save", "Save").Reactive(button => button.Click, p => p.Post("/Validation/Nameplate")
            .Gather(g => g.Form())
            .Validate<SpokenNameplateRules>("nameplate-form")
            .Response(r => r
                .OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary)))
                .OnError(400, e => e.ValidationErrors("nameplate-form")))))
        break;
    case NameplateName.Empty:
        @(plan.Button("save", "Save").Reactive(button => button.Click, p => p.Post("/Validation/Nameplate")
            .Gather(g => g.Form())
            .Validate<EmptyNameplateRules>("nameplate-form")))
        break;
    case NameplateName.Spaces:
        @(plan.Button("save", "Save").Reactive(button => button.Click, p => p.Post("/Validation/Nameplate")
            .Gather(g => g.Form())
            .Validate<SpacedNameplateRules>("nameplate-form")))
        break;
}

@Html.RenderPlan(plan)
