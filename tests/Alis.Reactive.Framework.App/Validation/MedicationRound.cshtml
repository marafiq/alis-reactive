@using Alis.Reactive.Framework.App.Validation
@model MedicationRound
@{
    ViewData["Title"] = "A medication round";
    var plan = Html.ReactivePlan<MedicationRound>();
}
<h1>A medication round</h1>

<div id="round-form">
    @{ Html.InputField(plan, m => m.Cart, o => o.Label("Cart")).Entry(); }
    @{ Html.InputField(plan, m => m.Nurse, o => o.Label("Nurse")).Entry(); }
</div>

<p>Saved: <span id="saved"></span></p>

@(plan.Button("save", "Save")
    .Reactive(button => button.Click, p => p.Post("/Validation/MedicationRound")
        .Gather(g => g.Form())
        .Validate<MedicationRoundRules>("round-form")
        .Response(r => r
            .OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary)))
            .OnError(400, e => e.ValidationErrors("round-form")))))

@Html.RenderPlan(plan)
