@using Alis.Reactive.Framework.App.Validation
@model DischargeSummary
@{
    ViewData["Title"] = "A discharge by stage";
    var plan = Html.ReactivePlan<DischargeSummary>();
    var stage = ViewData["Stage"] as string;
}
<h1>A discharge by stage</h1>
<p>Stage: <span id="stage">@(stage ?? "none")</span></p>

<div id="discharge-form">
    @{ Html.InputField(plan, m => m.Resident, o => o.Label("Resident")).Entry(); }
    @{ Html.InputField(plan, m => m.Ward, o => o.Label("Ward")).Entry(); }
    @{ Html.InputField(plan, m => m.Summary, o => o.Label("Summary")).Entry(); }
    @{ Html.InputField(plan, m => m.SignedBy, o => o.Label("Signed by")).Entry(); }
    @{ Html.InputField(plan, m => m.Transport.Carrier, o => o.Label("Carrier")).Entry(); }
    @{ Html.InputField(plan, m => m.Medication, o => o.Label("Medication")).Entry(); }
</div>

<p>Saved: <span id="saved"></span></p>

@if (stage == null)
{
    @(plan.Button("save", "Save")
        .Reactive(button => button.Click, p => p.Post("/Validation/Discharge")
            .Gather(g => g.Form())
            .Validate<DischargeRules>("discharge-form")
            .Response(r => r
                .OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary)))
                .OnError(400, e => e.ValidationErrors("discharge-form")))))
}
else
{
    var saveUrl = "/Validation/Discharge/" + stage;
    @(plan.Button("save", "Save")
        .Reactive(button => button.Click, p => p.Post(saveUrl)
            .Gather(g => g.Form())
            .Validate<DischargeRules>("discharge-form", stage)
            .Response(r => r
                .OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary)))
                .OnError(400, e => e.ValidationErrors("discharge-form")))))
}
@(plan.Button("save-undeclared", "Save under a stage the rules do not declare")
    .Reactive(button => button.Click, p => p.Post("/Validation/DischargeUndeclared")
        .Gather(g => g.Form("discharge-form"))
        .Response(r => r.OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary))))))

@Html.RenderPlan(plan)
