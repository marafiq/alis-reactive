@using Alis.Reactive.Framework.App.Validation
@model DischargeSummary
@{
    ViewData["Title"] = "A discharge form under two stages";
    var plan = Html.ReactivePlan<DischargeSummary>();
}
<h1>A discharge form under two stages</h1>

<div id="discharge-form">
    @{ Html.InputField(plan, m => m.Resident, o => o.Label("Resident")).Entry(); }
    @{ Html.InputField(plan, m => m.Summary, o => o.Label("Summary")).Entry(); }
</div>

@(plan.Button("save-draft", "Save the draft").Reactive(button => button.Click, p => p.Post("/Validation/Discharge/Draft")
    .Gather(g => g.Form())
    .Validate<DischargeRules>("discharge-form", "Draft")))
@(plan.Button("sign-off", "Sign off").Reactive(button => button.Click, p => p.Post("/Validation/Discharge/SignOff")
    .Gather(g => g.Form())
    .Validate<DischargeRules>("discharge-form", "SignOff")))

@Html.RenderPlan(plan)
