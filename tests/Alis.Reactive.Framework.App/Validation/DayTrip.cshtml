@using Alis.Reactive.Framework.App.Validation
@model DayTrip
@{
    ViewData["Title"] = "A day trip";
    var plan = Html.ReactivePlan<DayTrip>();
    var seats = (bool)ViewData["Seats"]!;
}
<h1>A day trip</h1>

<div id="trip-form">
    @{ Html.InputField(plan, m => m.Guests[0].Name, o => o.Label("First guest")).Entry(); }
    @{ Html.InputField(plan, m => m.Guests[0].Relation, o => o.Label("First guest's relation")).Entry(); }
    @{ Html.InputField(plan, m => m.Guests[1].Name, o => o.Label("Second guest")).Entry(); }
    @{ Html.InputField(plan, m => m.Guests[1].Relation, o => o.Label("Second guest's relation")).Entry(); }
    @{ Html.InputField(plan, m => m.Guests[0].Bags[0], o => o.Label("First guest's bag")).Entry(); }
    @{ Html.InputField(plan, m => m.Guests[0].Porter, o => o.Label("First guest's porter")).Entry(); }
    @{ Html.InputField(plan, m => m.Guests[1].Bags[0], o => o.Label("Second guest's bag")).Entry(); }
    @{ Html.InputField(plan, m => m.Guests[1].Porter, o => o.Label("Second guest's porter")).Entry(); }
    @{ Html.InputField(plan, m => m.Companions[0].Badge, o => o.Label("First badge")).Entry(); }
    @{ Html.InputField(plan, m => m.Companions[0].Phone, o => o.Label("First badge holder's phone")).Entry(); }
    @{ Html.InputField(plan, m => m.Companions[1].Badge, o => o.Label("Second badge")).Entry(); }
    @{ Html.InputField(plan, m => m.Companions[1].Phone, o => o.Label("Second badge holder's phone")).Entry(); }
    @{ Html.InputField(plan, m => m.Transport, o => o.Label("Transport")).Entry(); }
    @{ Html.InputField(plan, m => m.Driver, o => o.Label("Driver")).Entry(); }
    @{ Html.InputField(plan, m => m.Licence, o => o.Label("Licence")).Entry(); }
    @{ Html.InputField(plan, m => m.Pharmacy.Phone, o => o.Label("Pharmacy phone")).Entry(); }
    @{ Html.InputField(plan, m => m.Courier, o => o.Label("Courier")).Entry(); }
    @{ Html.InputField(plan, m => m.Stops[0], o => o.Label("First stop")).Entry(); }
    @{ Html.InputField(plan, m => m.Stops[1], o => o.Label("Second stop")).Entry(); }
    @{ Html.InputField(plan, m => m.ReturnBy, o => o.Label("Return by")).Entry(); }
    @if (seats)
    {
        Html.InputField(plan, m => m.Seats[0], o => o.Label("First seat")).Entry();
        Html.InputField(plan, m => m.Seats[1], o => o.Label("Second seat")).Entry();
    }
    @{ Html.InputField(plan, m => m.Coach, o => o.Label("Coach")).Entry(); }
    @{ Html.InputField(plan, m => m.Tickets[0], o => o.Label("First ticket")).Entry(); }
    @{ Html.InputField(plan, m => m.Tickets[1], o => o.Label("Second ticket")).Entry(); }
</div>

<p>Saved: <span id="saved"></span></p>

@(plan.Button("save", "Save")
    .Reactive(button => button.Click, p => p.Post("/Validation/DayTrip")
        .Gather(g => g.Form())
        .Validate<DayTripRules>("trip-form")
        .Response(r => r
            .OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary)))
            .OnError(400, e => e.ValidationErrors("trip-form")))))

@Html.RenderPlan(plan)
