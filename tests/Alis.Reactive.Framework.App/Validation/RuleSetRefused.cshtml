@using Alis.Reactive.Framework.App.Validation
@model RuleSetRefusalsPage
@{
    ViewData["Title"] = "Browser rules built wrongly";
    var rules = new BrowserRuleSet();
    switch (Model.Mistake)
    {
        case RuleSetMistake.NameARuleForACallOnAMember:
            rules.Add((VisitBooking x) => x.Visitor!.Trim(), BrowserRule.NotEmpty("Name the visitor."));
            break;
        case RuleSetMistake.RuleTheItemsOfAMemberThatHoldsNone:
            rules.AddItemRules((VisitBooking x) => x.Guests, new[] { BrowserRule.NotEmpty("Name each guest.") }, Condition.Always);
            break;
        case RuleSetMistake.BoundARangeByTwoKindsOfValue:
            rules.Add((VisitBooking x) => x.Guests, BrowserRule.Between<IComparable>(1, new DateTime(2026, 1, 1), inclusive: true, "Out of range."));
            break;
    }
}
<h1>Browser rules built wrongly</h1>

<p>Rules built: @rules.Fields.Count</p>
