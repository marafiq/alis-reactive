@using Alis.Reactive.Framework.App.Validation
@using Alis.Reactive.Validation
@model VisitBooking
@{
    ViewData["Title"] = "A visit's rules, read back";
    var plan = Html.ReactivePlan<VisitBooking>();

    // What a component whose own JavaScript validates reads of the rules: each rule by its class, and whether
    // it always applies.
    static string Kind(BrowserRule rule) => rule switch
    {
        NotEmptyRule => "not empty",
        MaxLengthRule longest => $"at most {longest.Length} characters",
        RangeRule { NumericBounds: { } bounds } => $"from {bounds.From} to {bounds.To}",
        FixedComparisonRule { Number: decimal number } => $"compared with {number}",
        FixedComparisonRule => "compared with a value that is no number",
        _ => "another check",
    };
}
<h1>A visit's rules, read back</h1>

<ul id="rules">
    @foreach (var field in plan.BrowserRules<VisitRules>())
    {
        foreach (var rule in field.Rules)
        {
            <li>@field.FieldName: @Kind(rule), @(rule.IsUnconditional ? "always" : "only while its condition holds")</li>
        }
    }
</ul>

<ul id="sameness-rules">
    @foreach (var field in plan.BrowserRules<SamenessRules>())
    {
        foreach (var rule in field.Rules)
        {
            <li>@field.FieldName: @Kind(rule)</li>
        }
    }
</ul>

@Html.RenderPlan(plan)
