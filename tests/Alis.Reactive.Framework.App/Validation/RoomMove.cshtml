@using Alis.Reactive.Framework.App.Validation
@model RoomMove
@{
    ViewData["Title"] = "A room move the room book decides";
    var plan = Html.ReactivePlan<RoomMove>();
}
<h1>A room move the room book decides</h1>

<div id="move-form">
    @{ Html.InputField(plan, m => m.Resident, o => o.Label("Resident")).Entry(); }
    @{ Html.InputField(plan, m => m.Room, o => o.Label("Room")).Entry(); }
    @{ Html.InputField(plan, m => m.Bed, o => o.Label("Bed")).Entry(); }
</div>

<p>Saved: <span id="saved"></span></p>

@(plan.Button("save", "Save")
    .Reactive(button => button.Click, p => p.Post("/Validation/RoomMove")
        .Gather(g => g.Form())
        .Validate<RoomMoveRules>("move-form")
        .Response(r => r
            .OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary)))
            .OnError(400, e => e.ValidationErrors("move-form")))))
@(plan.Button("save-without-waiting", "Save without waiting")
    .Reactive(button => button.Click, p => p.Post("/Validation/RoomMoveWithoutWaiting")
        .Gather(g => g.Form("move-form"))
        .Response(r => r.OnSuccess<Booked>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary))))))

@Html.RenderPlan(plan)
