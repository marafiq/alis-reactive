@using Alis.Reactive.Framework.App.Plans
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model VisitPage
@{
    ViewData["Title"] = "A visit";
    var plan = Html.ReactivePlan<VisitPage>();

    // The companion card is rendered for the visit's Companion member, so its input binds as Companion.Name.
    var companion = new ViewDataDictionary(ViewData);
    companion.TemplateInfo.HtmlFieldPrefix = nameof(VisitPage.Companion);
}
<h1>A visit</h1>

<section id="visit">
    @{ Html.InputField(plan, m => m.Visitor, o => o.Label("Visitor")).Entry(); }
    @await Html.PartialAsync("ResidentField", Model)
    <div id="room-slot"></div>
</section>

@await Html.PartialAsync("CompanionCard", Model.Companion, companion)

<p>The visit's endpoint bound: <span id="booked"></span></p>
<p>The page's plan merges into another: <span id="page-plan-merges">@(plan.IsPartial ? "yes" : "no")</span></p>

@(plan.Button("book", "Book the visit")
    .Reactive(button => button.Click, p => p.Post("/Plans/Visits")
        .Gather(g => g.Form("visit"))
        .Response(r => r.OnSuccess<Booked>((booked, s) => s.Element("booked").Text.Set(booked.Get(x => x.Summary))))))
@(plan.Button("book-unreasoned", "Book without a reason")
    .Reactive(button => button.Click, p => p.Post("/Plans/Visits/Unreasoned")
        .Gather(g => g.Form())
        .Validate<VisitRules>("visit")
        .Response(r => r.OnError(400, e => e.ValidationErrors("visit")))))
@(plan.Button("open-room", "Choose a room")
    .Reactive(button => button.Click, p => p.Get("/Plans/RoomField").Response(r => r.OnSuccess(s => s.Into("room-slot")))))
@(plan.Button("close-room", "Leave the room unchosen")
    .Reactive(button => button.Click, p => p.Unload("room-slot")))

<section id="page-messages" aria-label="The page's messages">
    @Html.RenderPlan(plan)
</section>
