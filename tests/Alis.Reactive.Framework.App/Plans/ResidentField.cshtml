@using Alis.Reactive.Framework.App.Plans
@model VisitPage
@{
    // A partial of the page's own model, rendered with the page: its plan joins the page's.
    var plan = Html.ResolvePlan<VisitPage>();
}
<div id="resident-field">
    @{ Html.InputField(plan, m => m.Resident, o => o.Label("Resident")).Entry(); }
    <p>The resident field's plan merges into another: <span id="resident-plan-merges">@(plan.IsPartial ? "yes" : "no")</span></p>

    @* The field's own save checks and shows the visit's form, which holds it. *@
    @(plan.Button("book-for-resident", "Book for the resident")
        .Reactive(button => button.Click, p => p.Post("/Plans/Visits/Unreasoned")
            .Gather(g => g.Form())
            .Validate<VisitRules>("visit")
            .Response(r => r.OnError(400, e => e.ValidationErrors("visit")))))
    @Html.RenderPlan(plan)
</div>
