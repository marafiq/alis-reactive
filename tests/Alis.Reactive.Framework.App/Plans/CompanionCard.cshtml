@using Alis.Reactive.Framework.App.Plans
@model CompanionCard
@{
    // A card of its own model: its plan is its own, and shares no plan id with the page's.
    var plan = Html.ReactivePlan<CompanionCard>();
}
<section id="companion-card">
    <h2>The companion</h2>
    @{ Html.InputField(plan, m => m.Name, o => o.Label("Companion")).Entry(); }
    <p>The companion's endpoint bound: <span id="companion-booked"></span></p>

    @(plan.Button("book-companion", "Book the companion")
        .Reactive(button => button.Click, p => p.Post("/Plans/Visits")
            .Gather(g => g.Form("companion-card"))
            .Response(r => r.OnSuccess<Booked>((booked, s) => s.Element("companion-booked").Text.Set(booked.Get(x => x.Summary))))))
</section>

@Html.RenderPlan(plan)
