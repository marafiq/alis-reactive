@using Alis.Reactive.Framework.App.Plans
@model ServicedPage
@{
    ViewData["Title"] = "A plan rendered with the services given";
    var plan = Html.ReactivePlan<ServicedPage>();

    // The view renders its plan itself, with the services it hands it: the request's own, or a provider
    // that holds no rules.
    var services = (bool)ViewData["WithoutRules"]! ? new ServiceCollection().BuildServiceProvider() : Context.RequestServices;
}
<h1>A plan rendered with the services given</h1>

<section id="serviced">
    @{ Html.InputField(plan, m => m.Visitor, o => o.Label("Visitor")).Entry(); }
    <p>The endpoint bound: <span id="serviced-bound"></span></p>

    @(plan.Button("send-visitor", "Send the visitor")
        .Reactive(button => button.Click, p => p.Post("/Plans/Serviced")
            .Gather(g => g.Form())
            .Validate<ServicedRules>("serviced")
            .Response(r => r.OnSuccess<Booked>((said, s) => s.Element("serviced-bound").Text.Set(said.Get(x => x.Summary))))))
</section>

<script type="application/json" data-reactive-plan>@Html.Raw(plan.Render(services))</script>
