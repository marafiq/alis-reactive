@using Alis.Reactive.Framework.App.Members
@model DataPage
@{
    ViewData["Title"] = "Data";
    var plan = Html.ReactivePlan<DataPage>();
}
<h1>Data</h1>

@plan.Slate("slate", title: "Day round", "Ada", "Ben")

<p>Last card's name: <span id="last-card"></span></p>
<p>Is a card filled: <span id="card-state"></span></p>
<p>Named cards: <span id="named-count"></span></p>
<p>Cards with a written name: <span id="written-count"></span> · then: <span id="written-went-on"></span></p>
<p>Cards with a name of any length: <span id="long-count"></span> · then: <span id="long-went-on"></span></p>
<p>Cards due on the 31st: <span id="due-count"></span> · then: <span id="due-went-on"></span></p>

@(plan.Button("fill-cy", "Fill Cy's card")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").Fill(new SlateCard { Name = "Cy", Due = new DateTime(2026, 10, 29) })))
@(plan.Button("fill-ada", "Fill Ada's card")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").Fill(new SlateCard { Name = "Ada", Due = new DateTime(2026, 10, 30) })))
@(plan.Button("fill-ben", "Fill Ben's card")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").Fill(new SlateCard { Name = "Ben", Due = new DateTime(2026, 10, 27) })))
@(plan.Button("read-last-card", "Read the last card's name")
    .Reactive(button => button.Click, p => p.Element("last-card").Text.Set(p.Component<Slate>("slate").LastCard.Get(card => card.Name))))
@(plan.Button("ask-card", "Is a card filled?")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        p.When(slate.LastCard.Get(card => card.Name)).IsNull()
            .Then(none => none.Element("card-state").Text.Set("no card yet"))
            .Else(some => some.Element("card-state").Text.Set(slate.LastCard.Get(card => card.Name)));
    }))
@(plan.Button("start-card", "Start a card due on the 31st")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").StartCard(new DateTime(2026, 10, 31))))
@(plan.Button("keep-old-card", "Keep a card the old way")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").KeepCardTheOldWay()))
@(plan.Button("count-written", "Count the cards with a written name")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        p.Element("written-count").Text.Set(p.From(slate.Cards.Each(card => card.Name)).Count(name => name.Trim().Length > 0));
        p.Element("written-went-on").Text.Set("went on");
    }))
@(plan.Button("count-long", "Count the cards with a name of any length")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        p.Element("long-count").Text.Set(p.From(slate.Cards.Each(card => card.Name)).Count(name => name.Length > 0));
        p.Element("long-went-on").Text.Set("went on");
    }))
@(plan.Button("count-due", "Count the cards due on the 31st")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        p.Element("due-count").Text.Set(p.From(slate.Cards.Each(card => card.Due)).Count(due => due.Day == 31));
        p.Element("due-went-on").Text.Set("went on");
    }))
@(plan.Button("count-named", "Count the named cards")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        p.Element("named-count").Text.Set(p.From(slate.Cards.Each(card => card.Name)).Count(name => name != null));
    }))
@(plan.Button("summarize-cards", "Summarize the cards")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        slate.Summarize(slate.Cards.Each(card => card.Name));
    }))
@(plan.Button("limit", "Limit to the rows")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        slate.Limit.Set(slate.Count);
    }))
@(plan.Button("note-title", "Note the title")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        slate.Note.Set(slate.Title);
    }))
@(plan.Button("rename-card", "Rename the first card Bea")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").SetCard(0, Field.Of((SlateCard card) => card.Name), "Bea")))
@(plan.Button("sort-by-name", "Sort the cards by name")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").SortCards(Field.Of((SlateCard card) => card.Name))))
@(plan.Button("sort-by-due", "Sort the cards by due day")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").SortCards(Field.Of((SlateCard card) => card.Due))))
@(plan.Button("add-dot", "Add a row for Dot")
    .Reactive(button => button.Click, p => p.Component<Slate>("slate").AddRowBy("Dot")))
@(plan.Button("summarize-any", "Summarize the rows as any list")
    .Reactive(button => button.Click, p =>
    {
        var slate = p.Component<Slate>("slate");
        slate.SummarizeAny(slate.Rows.Each(row => row.Label));
    }))

@Html.RenderPlan(plan)
