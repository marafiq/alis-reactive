@using Alis.Reactive.Framework.App.Inputs
@model DepartPage
@{
    ViewData["Title"] = "A visitor leaves";
    var plan = Html.ReactivePlan<DepartPage>();
}
<h1>A visitor leaves</h1>

@{ Html.InputField(plan, m => m.Visitor, o => o.Label("Visitor")).Entry(); }
@switch (Model.Rendering)
{
    case DepartRendering.TwiceOnOnePlan:
        Html.InputField(plan, m => m.Visitor, o => o.Label("Visitor, again")).Entry();
        break;
    case DepartRendering.AgainInAPartial:
        @await Html.PartialAsync("DepartPass", Model)
        break;
}

<p>The endpoint bound: <span id="bound"></span></p>

@(plan.Button("depart", "Sign out")
    .Reactive(button => button.Click, p => p.Post("/Inputs/Depart")
        .Gather(g => g.Form(m => m.Visitor))
        .Response(r => r.OnSuccess<DepartEcho>((echo, s) => s.Element("bound").Text.Set(echo.Get(x => x.Summary))))))

@Html.RenderPlan(plan)
