@using Alis.Reactive.Framework.App.Inputs
@model TagsPage
@{
    ViewData["Title"] = "Tag a visit";
    var plan = Html.ReactivePlan<TagsPage>();
}
<h1>Tag a visit</h1>

<div id="tags-form">
    @{ Html.InputField(plan, m => m.Codes, o => o.Label("Tags")).TagPicker(); }
</div>

<p>The endpoint bound: <span id="tags-bound"></span></p>

@(plan.Button("send-tags", "Send the tags")
    .Reactive(button => button.Click, p => p.Post("/Inputs/Tags")
        .Gather(g => g.Form("tags-form"))
        .Response(r => r.OnSuccess<TagsEcho>((echo, s) => s.Element("tags-bound").Text.Set(echo.Get(x => x.Summary))))))

@Html.RenderPlan(plan)
