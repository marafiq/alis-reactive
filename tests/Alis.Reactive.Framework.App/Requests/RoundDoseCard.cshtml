@using Alis.Reactive.Framework.App.Requests
@model RoundDose
@{
    var plan = Html.ReactivePlan<RoundDose>();
}
<section id="dose-card">
    <h2>Resident 1042</h2>

    @{ Html.InputField(plan, m => m.Amount, o => o.Label("Dose")).Entry(); }
    <p>The endpoint bound: <span id="dose-bound"></span></p>

    @* A JSON body names a list position by a number, so an entry keyed by a number is posted as form data. *@
    @(plan.Button("record-dose", "Record the dose")
        .Reactive(button => button.Click, p => p.Post("/Requests/Rounds")
            .Gather(g => g.Form())
            .AsFormData()
            .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("dose-bound").Text.Set(echo.Get(x => x.Summary))))))
</section>

@Html.RenderPlan(plan)
