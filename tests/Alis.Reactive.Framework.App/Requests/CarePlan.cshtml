@using Alis.Reactive.Framework.App.Requests
@model CarePlanPage
@{
    ViewData["Title"] = "A care plan";
    var plan = Html.ReactivePlan<CarePlanPage>();
}
<h1>A care plan</h1>

@{ Html.InputField(plan, m => m.CarePlan, o => o.Label("Care plan")).FilePicker(); }

<dl>
    <dt>Checked</dt><dd id="checked"></dd>
    <dt>Received</dt><dd id="received"></dd>
</dl>

@(plan.Button("check", "Check the care plan")
    .Reactive(button => button.Click, p =>
    {
        var chosen = p.Component<FilePicker>(m => m.CarePlan).Files;
        p.Post("/Requests/CarePlans/Check")
            .Gather<CarePlanCheck>(g => g
                .Set(x => x.CarePlan!.Name, chosen.Get(files => files[0].Name))
                .Set(x => x.CarePlan!.Size, chosen.Get(files => files[0].Size))
                .Set(x => x.CarePlan!.Type, chosen.Get(files => files[0].Type))
                .Set(x => x.CarePlan!.LastModified, chosen.Get(files => files[0].LastModified)))
            .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("checked").Text.Set(echo.Get(x => x.Summary))));
    }))
@(plan.Button("send", "Send the care plan")
    .Reactive(button => button.Click, p => p.Post("/Requests/CarePlans")
        .Gather(g => g.Form())
        .AsFormData()
        .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("received").Text.Set(echo.Get(x => x.Summary))))))
@(plan.Button("send-sequence", "Send the care plan as a sequence")
    .Reactive(button => button.Click, p => p.Post("/Requests/CarePlans/Sequence")
        .Gather<CarePlanUpload>(g => g.Form(m => m.CarePlan))
        .AsFormData()
        .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("received").Text.Set(echo.Get(x => x.Summary))))))
@(plan.Button("send-array", "Send the care plan as an array")
    .Reactive(button => button.Click, p => p.Post("/Requests/CarePlans/Array")
        .Gather<CarePlanFiles>(g => g.Form(m => m.CarePlan))
        .AsFormData()
        .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("received").Text.Set(echo.Get(x => x.Summary))))))

@Html.RenderPlan(plan)
