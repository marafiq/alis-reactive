@using Alis.Reactive.Framework.App.Requests
@model SpellingsPage
@{
    ViewData["Title"] = "Spellings";
    var plan = Html.ReactivePlan<SpellingsPage>();
}
<h1>Spellings</h1>

@{ Html.InputField(plan, m => m.Name, o => o.Label("Name")).Entry(); }
@{ Html.InputField(plan, m => m.Desk, o => o.Label("Desk")).Entry(); }

<dl>
    <dt>The name, in a query</dt><dd id="looked-up"></dd>
    <dt>The name, in the path</dt><dd id="routed"></dd>
    <dt>The name, as form data</dt><dd id="posted"></dd>
    <dt>The street, in a query</dt><dd id="street-looked-up"></dd>
    <dt>The street, as form data</dt><dd id="street-posted"></dd>
    <dt>The page of the name typed</dt><dd><span id="typed-found"></span> <span id="typed-routed"></span> · <span id="typed-done"></span></dd>
    <dt>The desk typed, in a header</dt><dd><span id="called"></span> · <span id="call-done"></span></dd>
</dl>

@(plan.Button("look-up-name", "Look up the name")
    .Reactive(button => button.Click, p => p.Get("/Requests/Spellings/Lookup")
        .Gather<SpelledName>(g => g.Set(x => x.Name, "Zoë & \"Rose\" O'Neil / 1+1=2, 50% #3?"))
        .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("looked-up").Text.Set(echo.Get(x => x.Summary))))))
@(plan.Button("open-name", "Open the name's page")
    .Reactive(button => button.Click, p => p.Get("/Requests/Spellings/Names/{name}")
        .Gather<SpelledName>(g => g.Set(x => x.Name, "Zoë & \"Rose\" O'Neil 1+1=2, 50% #3?"))
        .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("routed").Text.Set(echo.Get(x => x.Summary))))))
@(plan.Button("open-ward", "Open the ward's page")
    .Reactive(button => button.Click, p => p.Get("/Requests/Spellings/Names/{name}")
        .Gather<SpelledName>(g => g.Set(x => x.Name, "Ward 2/B"))
        .Response(r => r
            .OnSuccess<Echo>((echo, s) => s.Element("routed").Text.Set(echo.Get(x => x.Summary)))
            .OnError(404, e => e.Element("routed").Text.Set("no page at that address")))))
@(plan.Button("open-typed-name", "Open the page of the name typed")
    .Reactive(button => button.Click, p => p.Get("/Requests/Spellings/Names/{name}")
        .Gather<SpelledName>(g => g.Set(x => x.Name, p.Component<Entry>(m => m.Name).Value))
        .Response(r => r
            .OnSuccess<Echo>((echo, s) =>
            {
                s.Element("typed-found").Text.Set("found:");
                s.Element("typed-routed").Text.Set(echo.Get(x => x.Summary));
            })
            .OnError(e => e.Element("typed-found").Text.Set("not found")))
        .Finally(f => f.Element("typed-done").Text.Set("looked up"))))
@(plan.Button("call-desk", "Call the desk")
    .Reactive(button => button.Click, p => p.Get("/Requests/Headers")
        .Gather(g => g.Header("X-Shift", "Night").Header("X-Desk", p.Component<Entry>(m => m.Desk).Value))
        .Response(r => r
            .OnSuccess<Echo>((echo, s) => s.Element("called").Text.Set(echo.Get(x => x.Summary)))
            .OnError(e => e.Element("called").Text.Set("the desk could not be reached")))
        .Finally(f => f.Element("call-done").Text.Set("call ended"))))
@(plan.Button("post-name", "Post the name")
    .Reactive(button => button.Click, p => p.Post("/Requests/Spellings")
        .Gather<SpelledName>(g => g.Set(x => x.Name, "Zoë & \"Rose\" O'Neil / 1+1=2, 50% #3?"))
        .AsFormData()
        .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("posted").Text.Set(echo.Get(x => x.Summary))))))
@(plan.Button("look-up-street", "Look up the street")
    .Reactive(button => button.Click, p => p.Get("/Requests/Spellings/Streets")
        .Gather<SpelledAddress>(g => g.Set(x => x.Straße, "Hauptstraße 1"))
        .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("street-looked-up").Text.Set(echo.Get(x => x.Summary))))))
@(plan.Button("post-street", "Post the street")
    .Reactive(button => button.Click, p => p.Post("/Requests/Spellings/Streets")
        .Gather<SpelledAddress>(g => g.Set(x => x.Straße, "Hauptstraße 1"))
        .AsFormData()
        .Response(r => r.OnSuccess<Echo>((echo, s) => s.Element("street-posted").Text.Set(echo.Get(x => x.Summary))))))

@Html.RenderPlan(plan)
