@using Alis.Reactive.ClassNames.App.Notices
@model Notice
@{
    ViewData["Title"] = "A notice";
    var plan = Html.ReactivePlan<Notice>();
}
<h1>A notice</h1>

<div id="notice-form">
    @{ Html.InputField(plan, m => m.Title, o => o.Label("Title").Required()).NativeTextBox(b => b.CssClass("form-control")); }
</div>

<p>Saved: <span id="saved"></span></p>

@(Html.NativeButton("save", "Save")
    .CssClass("btn btn-primary")
    .Reactive(plan, evt => evt.Click, (click, p) => p.Post("/Notices/Save")
        .Gather(g => g.Form())
        .Validate<NoticeRules>("notice-form")
        .Response(r => r
            .OnSuccess<Saved>((saved, s) => s.Element("saved").Text.Set(saved.Get(x => x.Summary)))
            .OnError(400, e => e.ValidationErrors("notice-form")))))

@Html.RenderPlan(plan)
