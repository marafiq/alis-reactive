<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The Razor SDK makes this a Razor class library, so its stylesheet ships as a static web asset.
       There are no Razor files to compile. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Alis.Reactive.NativeTagHelpers</RootNamespace>
    <AssemblyName>Alis.Reactive.NativeTagHelpers</AssemblyName>
    <PackageId>AlisReactive.NativeTagHelpers</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageDescription>ASP.NET Core Tag Helpers for Alis.Reactive native components — declarative HTML authoring with Reactive Plan integration.</PackageDescription>
    <PackageTags>reactive;aspnetcore;taghelpers;native-components</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- native-validation-summary places a form's summary through the core's Html.FormSummary. -->
    <ProjectReference Include="../Alis.Reactive/Alis.Reactive.csproj" />
    <ProjectReference Include="../Alis.Reactive.Analyzers/Alis.Reactive.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The package's slice rows, bottom row first; ALIS010-ALIS013 lock ADR-0004 against them in every build. -->
    <AdditionalFiles Include="SliceTree.txt" />
    <!-- The public surface per target: a public symbol is a line in PublicAPI.Unshipped.txt, or the build fails (RS0016, RS0017). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- The stylesheet the layout tag helpers' markup needs (card, stacks, grid, heading, text,
       key/value, divider, container), shipped as written: served at
       ~/_content/AlisReactive.NativeTagHelpers/css/native-tag-helpers.css. Where and how:
       build\AlisReactiveStaticWebAssets.targets. The look comes from whatever design system the app
       links. -->
  <ItemGroup>
    <AlisReactiveStaticWebAsset Include="css/native-tag-helpers.css" RelativePath="css/native-tag-helpers.css" />
  </ItemGroup>

  <Import Project="../build/AlisReactiveStaticWebAssets.targets" />
</Project>
