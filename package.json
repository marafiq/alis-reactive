{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild Alis.Reactive.Assets/Scripts/root.ts --bundle --outfile=Alis.Reactive.Assets/dist/scripts/alis-reactive.dev.js --format=iife --global-name=__alisReactive --minify",
    "build:css": "npx @tailwindcss/cli -i Alis.Reactive.Assets/Styles/app.css -o Alis.Reactive.Assets/dist/css/design-system.dev.css --minify",
    "build:sandbox-plugins": "esbuild Alis.Reactive.SandboxApp/Scripts/sandbox-plugins.ts --bundle --format=iife --outfile=Alis.Reactive.SandboxApp/wwwroot/js/sandbox-plugins.js",
    "build:sandbox-css": "npx @tailwindcss/cli -i Alis.Reactive.SandboxApp/Styles/sandbox.css -o Alis.Reactive.SandboxApp/wwwroot/css/sandbox.css --minify",
    "build:all": "npm run build && npm run build:css && npm run build:sandbox-plugins && npm run build:sandbox-css",
    "watch": "esbuild Alis.Reactive.Assets/Scripts/root.ts --bundle --outfile=Alis.Reactive.Assets/dist/scripts/alis-reactive.dev.js --format=iife --global-name=__alisReactive --watch=forever",
    "watch:css": "npx @tailwindcss/cli -i Alis.Reactive.Assets/Styles/app.css -o Alis.Reactive.Assets/dist/css/design-system.dev.css --watch=always",
    "watch:sandbox-plugins": "esbuild Alis.Reactive.SandboxApp/Scripts/sandbox-plugins.ts --bundle --format=iife --outfile=Alis.Reactive.SandboxApp/wwwroot/js/sandbox-plugins.js --watch=forever",
    "watch:sandbox-css": "npx @tailwindcss/cli -i Alis.Reactive.SandboxApp/Styles/sandbox.css -o Alis.Reactive.SandboxApp/wwwroot/css/sandbox.css --watch=always",
    "typecheck": "tsc --project Alis.Reactive.Assets/Scripts/tsconfig.json --noEmit && tsc --project Alis.Reactive.SandboxApp/Scripts/tsconfig.json --noEmit",
    "lint": "eslint Alis.Reactive.Assets/Scripts/ Alis.Reactive.SandboxApp/Scripts/",
    "lint:fix": "eslint Alis.Reactive.Assets/Scripts/ Alis.Reactive.SandboxApp/Scripts/ --fix",
    "build:api-docs": "dotnet run --project tools/ApiDocGenerator",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/cli": "^4.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@tailwindcss/forms": "^0.5.11"
  }
}
