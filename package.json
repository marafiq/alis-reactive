{
  "private": true,
  "type": "module",
  "workspaces": [
    "Alis.Reactive.Assets",
    "Alis.Reactive.SandboxApp"
  ],
  "scripts": {
    "build:all": "npm run build -w Alis.Reactive.Assets && npm run build -w Alis.Reactive.SandboxApp",
    "build:runtime": "npm run build:runtime -w Alis.Reactive.Assets",
    "build:design-system": "npm run build:design-system -w Alis.Reactive.Assets",
    "build:fusion": "npm run build:fusion -w Alis.Reactive.Assets",
    "build:sandbox": "npm run build -w Alis.Reactive.SandboxApp",
    "watch:runtime": "npm run watch:runtime -w Alis.Reactive.Assets",
    "watch:design-system": "npm run watch:design-system -w Alis.Reactive.Assets",
    "watch:fusion": "npm run watch:fusion -w Alis.Reactive.Assets",
    "watch:sandbox-plugins": "npm run watch:plugins -w Alis.Reactive.SandboxApp",
    "watch:sandbox-css": "npm run watch:css -w Alis.Reactive.SandboxApp",
    "typecheck": "npm run typecheck -w Alis.Reactive.Assets && npm run typecheck -w Alis.Reactive.SandboxApp",
    "lint": "eslint Alis.Reactive.Assets/runtime/ Alis.Reactive.SandboxApp/Scripts/",
    "lint:fix": "eslint Alis.Reactive.Assets/runtime/ Alis.Reactive.SandboxApp/Scripts/ --fix",
    "test": "npm run test -w Alis.Reactive.Assets && npm run test -w Alis.Reactive.SandboxApp",
    "test:watch": "npm run test:watch -w Alis.Reactive.Assets",
    "build:api-docs": "dotnet run --project tools/ApiDocGenerator"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.57.1"
  }
}
