<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The AlisReactive packages come from the local feed scripts/pack.sh fills (repo-root ./nupkgs);
       everything else from nuget.org. An app outside this repository takes them from nuget.org too. -->
  <packageSources>
    <clear />
    <add key="local-nupkgs" value="../../nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
