<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore the AlisReactive packages from the freshly-packed local feed (repo-root ./nupkgs),
       falling back to nuget.org for MVC5, Syncfusion, System.Text.Json, etc. -->
  <packageSources>
    <clear />
    <add key="local-nupkgs" value="..\..\nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
