<Project Sdk="Microsoft.Build.NoTargets/3.7.0">

  <!--
    This project compiles nothing. It exists so the framework's browser code - the
    TypeScript runtime and the framework's own components - is a first-class,
    navigable node in the solution instead of a loose folder.

    The bundle is built by esbuild via npm (see CLAUDE.md "Build & Run").
    MSBuild never touches these files - they are <None> items so Rider shows the
    full tree and new files appear automatically with no .sln or .csproj edits.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source areas + workspace config. dist/ is gitignored build output. -->
    <None Include="runtime/**/*" />
    <None Include="components/**/*" />
    <None Include="bundle.ts" />
    <None Include="*.json" />
    <None Include="*.mjs" />
    <None Include="*.md" />
  </ItemGroup>

</Project>
