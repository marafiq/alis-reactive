    "PluginLocator": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "plugin"
        },
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "listen": {
          "$ref": "#/$defs/Listening"
