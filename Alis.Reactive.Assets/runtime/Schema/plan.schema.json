    "PlanDocument": {
      "type": "object",
      "properties": {
        "version": {
          "const": 7
        },
        "planId": {
          "type": "string"
        },
        "culture": {
          "$ref": "#/$defs/Culture"
        },
        "timeZone": {
          "$ref": "#/$defs/TimeZone"
        },
        "trace": {
          "$ref": "#/$defs/Trace"
        },
        "vendors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Vendor"
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Locator"
          }
        },
        "handlers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handler"
          }
        }
      },
      "required": [
        "version",
        "planId",
        "culture",
        "timeZone",
        "trace",
        "vendors",
        "objects",
        "handlers"
      ],
      "additionalProperties": false
