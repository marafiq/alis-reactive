    "OpExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "op"
        },
        "op": {
          "$ref": "#/$defs/Operator"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Expression"
          }
        }
      },
      "required": [
        "kind",
        "op",
        "args"
      ],
      "additionalProperties": false
