    "Operator": {
      "enum": [
        "eq",
        "neq",
        "lt",
        "lte",
        "gt",
        "gte",
        "and",
        "or",
        "not",
        "add",
        "sub",
        "mul",
        "mod",
        "neg",
        "coalesce",
        "cond",
        "nullableValue",
        "nonNull",
        "empty",
        "matches",
        "toArray",
        "finite",
        "compareNumbers",
        "compareOrdinal",
        "compareBooleans",
        "compareCulture",
        "merge",
        "trim",
        "trimStart",
        "trimEnd",
        "upperInvariant",
        "lowerInvariant",
        "upper",
        "lower",
        "upperTurkic",
        "lowerTurkic",
        "contains",
        "startsWith",
        "endsWith",
        "nullOrEmpty",
        "includes",
        "sumInt",
        "sumDouble",
        "sumDecimal",
        "eqDecimal",
        "dateKey",
        "wallKey",
        "instantKey",
        "dayKey",
        "timeKey",
        "spanKey"
      ]
    },
    "SignalExpression": {
      "type": "object",
      "properties": {
        "kind": {
