      "required": [
        "kind",
        "fields"
      ],
      "additionalProperties": false
    },
    "RecordField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
