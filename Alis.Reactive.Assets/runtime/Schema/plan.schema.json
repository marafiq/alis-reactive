      "oneOf": [
        {
          "$ref": "#/$defs/ElementLocator"
        },
        {
          "$ref": "#/$defs/PluginLocator"
        }
      ]
    },
    "ElementLocator": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "element"
        },
        "id": {
          "type": "string"
        },
