      "properties": {
        "name": {
          "type": "string"
        },
        "collation": {
          "type": "string"
        },
        "decimal": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "integer": {
          "$ref": "#/$defs/NumberText"
        },
        "fraction": {
          "$ref": "#/$defs/NumberText"
        }
      },
      "required": [
        "name",
        "collation",
        "decimal",
        "group",
        "integer",
        "fraction"
      ],
      "additionalProperties": false
    },
    "NumberText": {
      "type": "object",
      "properties": {
        "group": {
          "type": "boolean"
        },
        "exponent": {
          "type": "boolean"
        }
      },
      "required": [
        "group",
        "exponent"
      ],
      "additionalProperties": false
    },
    "TimeZone": {
      "oneOf": [
        {
          "$ref": "#/$defs/ClockTimeZone"
        },
        {
          "$ref": "#/$defs/ZoneTimeZone"
        }
      ]
    },
    "ClockTimeZone": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "clock"
        }
      },
      "required": [
        "kind"
