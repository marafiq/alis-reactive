      "oneOf": [
        {
          "$ref": "#/$defs/OffTrace"
        },
        {
          "$ref": "#/$defs/OnTrace"
        }
      ]
    },
    "OffTrace": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "off"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "OnTrace": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "on"
        },
        "traceparent": {
          "type": "string"
        },
        "tracestate": {
          "type": "string"
        },
        "console": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        }
      },
      "required": [
        "kind",
        "traceparent",
        "tracestate",
        "console",
        "sources"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      },
      "required": [
        "view",
        "line"
      ],
      "additionalProperties": false
    },
    "Vendor": {
      "type": "object",
      "properties": {
        "locate": {
          "$ref": "#/$defs/Expression"
        },
        "listen": {
          "$ref": "#/$defs/Listening"
        }
      },
      "required": [
        "locate",
        "listen"
      ],
      "additionalProperties": false
    },
    "Expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/LitExpression"
        },
        {
          "$ref": "#/$defs/ObjExpression"
        },
        {
          "$ref": "#/$defs/RefExpression"
        },
        {
          "$ref": "#/$defs/GetExpression"
        },
        {
          "$ref": "#/$defs/DataExpression"
        },
        {
          "$ref": "#/$defs/AsExpression"
        },
        {
          "$ref": "#/$defs/CallExpression"
        },
        {
          "$ref": "#/$defs/FnExpression"
        },
        {
          "$ref": "#/$defs/AnswerExpression"
        },
        {
          "$ref": "#/$defs/RecordExpression"
        },
        {
          "$ref": "#/$defs/ListExpression"
        },
        {
          "$ref": "#/$defs/OpExpression"
        },
        {
          "$ref": "#/$defs/SignalExpression"
        }
      ]
    },
    "LitExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "lit"
        },
        "value": {}
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "ObjExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "obj"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "RefExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ref"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "GetExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "get"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathStep"
          }
        },
        "members": {
          "$ref": "#/$defs/PathMembers"
        },
        "target": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "kind",
        "path",
        "members",
        "target"
      ],
      "additionalProperties": false
    },
    "PathStep": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "PathMembers": {
      "enum": [
        "required",
        "optional",
        "requiredIfHeld",
        "optionalMember"
      ]
    },
    "DataExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "data"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DataStep"
          }
        },
        "target": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "kind",
        "path",
        "target"
      ],
      "additionalProperties": false
    },
    "DataStep": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absent": {
          "$ref": "#/$defs/Absence"
        }
      },
      "required": [
        "name",
        "requires",
        "absent"
      ],
      "additionalProperties": false
    },
    "Absence": {
      "oneOf": [
        {
          "$ref": "#/$defs/StartAbsence"
        },
        {
          "$ref": "#/$defs/NothingAbsence"
        },
        {
          "$ref": "#/$defs/UnboundAbsence"
        }
      ]
    },
    "StartAbsence": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "start"
        },
        "value": {}
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "NothingAbsence": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "nothing"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "UnboundAbsence": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "unbound"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "AsExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "as"
        },
        "expr": {
          "$ref": "#/$defs/Expression"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        }
      },
      "required": [
        "kind",
        "expr",
        "shape"
      ],
      "additionalProperties": false
    },
    "Shape": {
      "oneOf": [
        {
          "$ref": "#/$defs/StringShape"
        },
        {
          "$ref": "#/$defs/NumberShape"
        },
        {
          "$ref": "#/$defs/BooleanShape"
        },
        {
          "$ref": "#/$defs/DateShape"
        },
        {
          "$ref": "#/$defs/InstantShape"
        },
        {
          "$ref": "#/$defs/FileShape"
        },
        {
          "$ref": "#/$defs/AnyShape"
        },
        {
          "$ref": "#/$defs/ArrayShape"
        },
        {
          "$ref": "#/$defs/NullableShape"
        },
        {
          "$ref": "#/$defs/ObjectShape"
        }
      ]
    },
    "StringShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "NumberShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "number"
        },
        "of": {
          "$ref": "#/$defs/NumberOf"
        },
        "text": {
          "$ref": "#/$defs/NumberCulture"
        }
      },
      "required": [
        "kind",
        "of",
        "text"
      ],
      "additionalProperties": false
    },
    "NumberOf": {
      "enum": [
        "integer",
        "fraction"
      ]
    },
    "NumberCulture": {
      "enum": [
        "view",
        "invariant"
      ]
    },
    "BooleanShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "DateShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "date"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "InstantShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "instant"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "FileShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "file"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "AnyShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "any"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ArrayShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "array"
        },
        "item": {
          "$ref": "#/$defs/Shape"
        }
      },
      "required": [
        "kind",
        "item"
      ],
      "additionalProperties": false
    },
    "NullableShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "nullable"
        },
        "inner": {
          "$ref": "#/$defs/Shape"
        }
      },
      "required": [
        "kind",
        "inner"
      ],
      "additionalProperties": false
    },
    "ObjectShape": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "object"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Shape"
          }
        }
      },
      "required": [
        "kind",
        "fields"
      ],
      "additionalProperties": false
    },
    "CallExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "call"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathStep"
          }
        },
        "members": {
          "$ref": "#/$defs/PathMembers"
        },
        "target": {
          "$ref": "#/$defs/Expression"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Expression"
          }
        }
      },
      "required": [
        "kind",
        "path",
        "members",
        "target",
        "args"
      ],
      "additionalProperties": false
    },
    "FnExpression": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "fn"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "kind",
        "params",
        "body"
      ],
      "additionalProperties": false
