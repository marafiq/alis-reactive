@using System.Text.RegularExpressions
@{
    if (ViewData["HideSandboxBreadcrumb"] as bool? == true)
    {
        return;
    }

    var path = Context.Request.Path.Value ?? "";
    var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

    if (segments.Length >= 2 && segments[0].Equals("Sandbox", StringComparison.OrdinalIgnoreCase))
    {
        // Grouping segments that have no hub index page of their own. Their crumb is
        // shown but not linked, so navigation never lands on a 404. Every section now
        // has a real hub route, so this is currently empty — add a segment here only if
        // it appears in a URL path without a navigable index of its own.
        var groupingOnly = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        // Display-name overrides where camel-case word splitting is not enough.
        var displayOverrides = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["HttpPipeline"] = "HTTP Pipeline",
        };

        string Display(string seg) =>
            displayOverrides.TryGetValue(seg, out var d)
                ? d
                : Regex.Replace(seg, "(?<=[a-z0-9])(?=[A-Z])", " ");

        // Each crumb resolves to its own cumulative request path, so every ancestor is a
        // real, navigable route — no hard-coded controller/action map to drift out of sync.
        var cumulative = "";

        <nav class="mb-6 flex items-center flex-wrap gap-x-2 gap-y-1 text-sm" aria-label="Breadcrumb">
            @for (var i = 0; i < segments.Length; i++)
            {
                cumulative += "/" + segments[i];
                var isLast = i == segments.Length - 1;

                if (i > 0)
                {
                    <span class="text-text-muted" aria-hidden="true">/</span>
                }

                if (isLast)
                {
                    <span class="font-medium text-text-primary" aria-current="page">@Display(segments[i])</span>
                }
                else if (groupingOnly.Contains(segments[i]))
                {
                    <span class="text-text-secondary">@Display(segments[i])</span>
                }
                else
                {
                    <a href="@cumulative" class="text-text-secondary hover:text-primary transition-colors">@Display(segments[i])</a>
                }
            }
        </nav>
    }
}
