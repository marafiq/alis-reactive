@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Validation.NestedBugs.NestedAddressModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Validation.NestedBugs
@{
    ViewData["Title"] = "Nested Bug — Claims 1 & 3: Nested Condition Path + Peer Field";
    var plan = Html.ReactivePlan<NestedAddressModel>();
}

<h1>Claims 1 & 3 — Nested Condition Path + Peer Field</h1>

<form id="nested-form" class="space-y-4 p-4">
    @{ Html.InputField(plan, m => m.Name, o => o.Required().Label("Name"))
       .NativeTextBox(b => b.Placeholder("Name").CssClass("border px-2 py-1")); }

    <h2>Address</h2>

    @{ Html.InputField(plan, m => m.Address.City, o => o.Label("City"))
       .NativeTextBox(b => b.Placeholder("City").CssClass("border px-2 py-1")); }

    @{ Html.InputField(plan, m => m.Address.ConfirmCity, o => o.Label("Confirm City"))
       .NativeTextBox(b => b.Placeholder("Confirm city").CssClass("border px-2 py-1")); }

    @(Html.NativeButton("submit-btn", "Submit")
        .Reactive(plan, evt => evt.Click, (args, p) =>
        {
            p.Post("/Sandbox/Validation/NestedBugs/SubmitNestedAddress", g => g.IncludeAll())
             .Validate<NestedAddressParentValidator>("nested-form")
             .Response(r => r
                .OnSuccess(s => s.Element("result").SetText("Saved"))
                .OnError(400, e => e.ValidationErrors("nested-form")));
        }))

    <div id="result" class="mt-2 text-green-600"></div>
</form>

@Html.RenderPlan(plan)
