@model AdmissionAssessmentModel
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Admission Assessment";
    var plan = Html.ReactivePlan<AdmissionAssessmentModel>();
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";
    var careLevels = new[]
    {
        new SelectListItem("Independent living", nameof(AssessedCareLevel.Independent)),
        new SelectListItem("Assisted living", nameof(AssessedCareLevel.Assisted)),
        new SelectListItem("Memory care", nameof(AssessedCareLevel.MemoryCare)),
    };
    var residencies = new[]
    {
        new SelectListItem("Not set", nameof(ResidencyKind.NotSet)),
        new SelectListItem("Permanent", nameof(ResidencyKind.Permanent)),
        new SelectListItem("Respite", nameof(ResidencyKind.Respite)),
    };
    var mobilityAids = new[]
    {
        new SelectListItem("Not assessed", nameof(MobilityAidKind.NotAssessed)),
        new SelectListItem("None", nameof(MobilityAidKind.None)),
        new SelectListItem("Cane", nameof(MobilityAidKind.Cane)),
        new SelectListItem("Walker", nameof(MobilityAidKind.Walker)),
        new SelectListItem("Wheelchair", nameof(MobilityAidKind.Wheelchair)),
    };
}

<native-vstack gap="Lg">
    <native-heading level="H1">Admission Assessment</native-heading>
    <native-text color="Secondary">
        Helen Park, moving in this spring. Save checks every answer on the page first; Print for the
        chart sends the assessment as it is, and the chart says what it refuses.
    </native-text>

    <native-card><native-card-body>
        <form id="assessment-form" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @{ Html.InputField(plan, m => m.ResidentName, o => o.Required().Label("Resident name"))
                .NativeTextBox(b => b.Placeholder("Full name").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.PreferredName, o => o.Label("Preferred name"))
                .NativeTextBox(b => b.Placeholder("What the resident likes to be called").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.WristbandLabel, o => o.Label("Wristband label"))
                .NativeTextBox(b => b.Placeholder("Up to 12 characters").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.RoomCode, o => o.Label("Room"))
                .NativeTextBox(b => b.Placeholder("MA-214").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.FamilyEmail, o => o.Label("Family email"))
                .NativeTextBox(b => b.Placeholder("name@domain").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.PortalLink, o => o.Label("Family portal link"))
                .NativeTextBox(b => b.Placeholder("https://").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.ConsentWord, o => o.Required().Label("Consent (type AGREE)"))
                .NativeTextBox(b => b.Placeholder("AGREE").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.SignaturesCollected, o => o.Required().Label("Signatures collected"))
                .NativeTextBox(b => b.Type("number").Placeholder("2").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.Age, o => o.Label("Age"))
                .NativeTextBox(b => b.Type("number").Placeholder("55 or older").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.WeightKg, o => o.Label("Weight (kg)"))
                .NativeTextBox(b => b.Type("number").Placeholder("Above 20, up to 250").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.PainScore, o => o.Label("Pain score (0 to 10)"))
                .NativeTextBox(b => b.Type("number").Placeholder("0").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.MoveInDate, o => o.Required().Label("Move-in day"))
                .NativeTextBox(b => b.Type("date").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.AssessmentDate, o => o.Label("Assessment day"))
                .NativeTextBox(b => b.Type("date").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.NextReviewDate, o => o.Label("Next review"))
                .NativeTextBox(b => b.Type("date").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.CareLevel, o => o.Required().Label("Care level"))
                .NativeDropDown(b => b.Items(careLevels).Placeholder("-- Choose a care level --").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.Residency, o => o.Required().Label("Residency"))
                .NativeDropDown(b => b.Items(residencies).CssClass(Field)); }
            @{ Html.InputField(plan, m => m.MobilityAid, o => o.Required().Label("Mobility aid"))
                .NativeDropDown(b => b.Items(mobilityAids).CssClass(Field)); }
            @{ Html.InputField(plan, m => m.FellInLastYear, o => o.Required().Label("Did the resident fall in the last year?"))
                .NativeRadioGroup(b => b
                    .Option("true", "Yes")
                    .Option("false", "No")); }
            @{ Html.InputField(plan, m => m.FallsLastYear, o => o.Label("Falls in the last year"))
                .NativeTextBox(b => b.Type("number").Placeholder("0").CssClass(Field)); }
            @{ Html.InputField(plan, m => m.ConsentOnFile, o => o.Required().Label("The signed consent is on file"))
                .NativeCheckBox(b => b.CssClass("h-4 w-4 rounded border-border text-accent")); }
            @{ Html.InputField(plan, m => m.PhotoConsent, o => o.Label("The resident consents to photos"))
                .NativeCheckBox(b => b.CssClass("h-4 w-4 rounded border-border text-accent")); }
        </form>
        <native-hstack gap="Base" class="mt-4">
            @(Html.NativeButton("save-assessment-btn", "Save assessment")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post(Url.SandboxRoute("Save", "AdmissionAssessment")).Gather(g => g.Form())
                     .Validate<AdmissionAssessmentValidator>("assessment-form")
                     .Response(r => r
                        .OnSuccess<AdmissionAssessmentConfirmation>((json, s) =>
                        {
                            s.Element("assessment-status").Text.Set(json.Get(x => x.Confirmation));
                        })
                        .OnError(400, e => e.ValidationErrors("assessment-form")));
                }))
            @* The chart takes the assessment as it is: the server alone decides, with the same rules. *@
            @(Html.NativeButton("print-assessment-btn", "Print for the chart")
                .CssClass("rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post(Url.SandboxRoute("Print", "AdmissionAssessment")).Gather(g => g.Form())
                     .Response(r => r
                        .OnSuccess<AdmissionAssessmentConfirmation>((json, s) =>
                        {
                            s.Element("print-status").Text.Set(json.Get(x => x.Confirmation));
                        })
                        .OnError(400, e =>
                        {
                            e.Element("print-status").Text.Set("The chart refused the assessment.");
                            e.ValidationErrors("assessment-form");
                        }));
                }))
        </native-hstack>
        <p id="assessment-status" class="mt-3 text-sm text-text-muted">Not saved yet.</p>
        <p id="print-status" class="mt-1 text-sm text-text-muted">Not printed yet.</p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
