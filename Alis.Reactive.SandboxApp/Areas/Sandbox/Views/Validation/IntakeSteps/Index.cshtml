@model IntakeStepsModel
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Resident Intake";
    var plan = Html.ReactivePlan<IntakeStepsModel>();

    // The first step loads into the form like every later one, so each step's fields leave with it.
    Html.On(plan, t => t.DomReady(p =>
    {
        p.Get(Url.SandboxRoute("ResidentStep", "IntakeSteps"))
         .Response(r => r.OnSuccess(s => s.Into("intake-step")));
    }));
}

<native-vstack gap="Lg">
    <native-hstack justify="Between" align="Start">
        <native-vstack gap="Sm">
            <native-heading level="H1">Resident Intake</native-heading>
            <native-text color="Secondary">
                Take a new resident's intake in two steps: who the resident is, then the care they need.
                The nurse can review the care needs as soon as the care step is filled in.
            </native-text>
        </native-vstack>
        @* The care needs are on the page only during the care step; before it there is nothing to check or send. *@
        @(Html.NativeButton("ask-nurse-review-btn", "Ask the nurse to review care needs")
            .CssClass("rounded-md border border-border px-4 py-2 text-sm font-medium text-text-primary hover:bg-surface-muted")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post(Url.SandboxRoute("NurseReview", "IntakeSteps"))
                 .Gather(g => g.Form())
                 .Validate<IntakeCareValidator>("care-needs")
                 .Response(r => r
                    .OnSuccess<IntakeConfirmation>((json, s) => s.Element("nurse-review-status").Text.Set(json.Get(x => x.Confirmation)))
                    .OnError(400, e => e.ValidationErrors("care-needs")));
            }))
    </native-hstack>

    <native-card><native-card-body>
        <form id="intake-form" class="flex flex-col gap-4">
            <div id="intake-step">
                <p class="text-sm text-text-muted">Loading the intake...</p>
            </div>
        </form>
        <p id="intake-status" class="mt-3 text-sm text-text-muted">No intake saved yet.</p>
        <p id="nurse-review-status" class="mt-1 text-sm text-text-muted">Not sent to the nurse yet.</p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
