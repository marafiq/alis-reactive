@model IntakeStepsModel
@using Alis.Reactive.Native
@{
    var plan = Html.ReactivePlan<IntakeStepsModel>();
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";
    var careLevels = new[]
    {
        new SelectListItem("Independent living", "Independent living"),
        new SelectListItem("Assisted living", "Assisted living"),
        new SelectListItem(IntakeCareValidator.FullCareLevel, IntakeCareValidator.FullCareLevel),
    };
}

<native-heading level="H2">Step 2 of 2: Care needs for @Model.ResidentName</native-heading>

<div id="care-needs" class="flex flex-col gap-4">
<native-grid cols="C2" gap="Base">
    @{ Html.InputField(plan, m => m.CareLevel, o => o.Required().Label("Care level"))
        .NativeDropDown(b => b.Items(careLevels).Placeholder("-- Choose a care level --").CssClass(Field))
        .Reactive(evt => evt.Change, (args, p) =>
        {
            p.Get(Url.SandboxRoute("MobilityQuestions", "IntakeSteps"))
             .Gather(g => g.Set(x => x.CareLevel, args.Value))
             .Response(r => r.OnSuccess(s => s.Into("mobility-questions")));
        }); }
    @{ Html.InputField(plan, m => m.FamilyPhone, o => o.Label("Family phone"))
        .NativeTextBox(b => b.Placeholder("555-0100").CssClass(Field)); }
</native-grid>

<div id="mobility-questions">
    <p class="text-sm text-text-muted">Choose a care level to see its mobility questions.</p>
</div>
</div>

@(Html.NativeButton("finish-intake-btn", "Finish intake")
    .CssClass("self-start rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90")
    .Reactive(plan, evt => evt.Click, (args, p) =>
    {
        p.Post(Url.SandboxRoute("Finish", "IntakeSteps"))
         .Gather(g => g
            .Form()
            .Set(x => x.ResidentName, Model.ResidentName))
         .Validate<IntakeCareValidator>("intake-form")
         .Response(r => r
            .OnSuccess<IntakeConfirmation>((json, s) => s.Element("intake-status").Text.Set(json.Get(x => x.Confirmation)))
            .OnError(400, e => e.ValidationErrors("intake-form")));
    }))

@Html.RenderPlan(plan)
