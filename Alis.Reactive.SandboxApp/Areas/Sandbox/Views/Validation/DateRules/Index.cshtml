@model DateValidationModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Date Validation";
    var plan = Html.ReactivePlan<DateValidationModel>();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Resident Stay Dates</native-heading>
    <native-text color="Secondary">
        Record the stay and the dates booked inside it. The care plan review falls inside the stay, the
        follow-up visit no later than discharge, and the move-out inspection on the discharge day.
    </native-text>

    <native-card>
    <native-card-body>
        <native-heading level="H2">Stay and Booked Dates</native-heading>
        <form id="date-form" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            @{ Html.InputField(plan, m => m.AdmissionDate, o => o.Required().Label("Admission Date"))
                .FusionDatePicker(b => b
                    .Placeholder("Select admission date")); }
            @{ Html.InputField(plan, m => m.DischargeDate, o => o.Required().Label("Discharge Date"))
                .FusionDatePicker(b => b
                    .Placeholder("Select discharge date")); }
            @{ Html.InputField(plan, m => m.CarePlanReviewDate, o => o.Label("Care Plan Review"))
                .FusionDatePicker(b => b
                    .Placeholder("Select review date")); }
            @{ Html.InputField(plan, m => m.FollowUpVisitDate, o => o.Label("Physician Follow-up Visit"))
                .FusionDatePicker(b => b
                    .Placeholder("Select visit date")); }
            @{ Html.InputField(plan, m => m.MoveOutInspectionDate, o => o.Label("Move-out Inspection"))
                .FusionDatePicker(b => b
                    .Placeholder("Select inspection date")); }
        </form>
        @(Html.NativeButton("validate-dates-btn", "Validate Dates")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post(Url.SandboxRoute("ValidateClient", "DateValidation"))
                 .Validate<DateValidationValidator>("date-form")
                 .Response(r => r.OnSuccess(s =>
                 {
                     s.Element("date-result").Text.Set("All dates valid!");
                     s.Element("date-result").ClassList.Add("text-green-600");
                     s.Element("date-result").ClassList.Remove("text-text-muted");
                 }));
            }))
        <p id="date-result" class="mt-3 text-sm text-text-muted">Click to validate</p>
    </native-card-body>
    </native-card>
</native-vstack>

@Html.RenderPlan(plan)
