@model EmergencyContactsModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Emergency Contacts";
    var plan = Html.ReactivePlan<EmergencyContactsModel>();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Resident Intake: Emergency Contacts</native-heading>
    <native-text color="Secondary">
        Record who to call in an emergency. When the resident has contacts, each contact needs a phone number.
    </native-text>

    <native-card>
    <native-card-body>
        <form id="emergency-contacts-form" class="mb-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                @{ Html.InputField(plan, m => m.ResidentName, o => o.Required().Label("Resident Name"))
                    .NativeTextBox(b => b.Placeholder("Full name")); }
                @{ Html.InputField(plan, m => m.HasContacts, o => o.Label("Resident has emergency contacts"))
                    .NativeCheckBox(b => b.CssClass("h-4 w-4 rounded border-border text-accent")); }
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                @for (var i = 0; i < Model.Contacts.Count; i++)
                {
                    var contactIndex = i;
                    var contactNumber = i + 1;
                    Html.InputField(plan, m => m.Contacts[contactIndex].Name, o => o.Label($"Contact {contactNumber} Name"))
                        .NativeTextBox(b => b.Placeholder("Full name"));
                    Html.InputField(plan, m => m.Contacts[contactIndex].Phone, o => o.Label($"Contact {contactNumber} Phone"))
                        .NativeTextBox(b => b.Type("tel").Placeholder("555-0100"));
                }
            </div>
        </form>
        @(Html.NativeButton("save-emergency-contacts-btn", "Save Intake")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post(Url.SandboxRoute("Save", "EmergencyContacts"), g => g.IncludeAll())
                 .Validate<EmergencyContactsValidator>("emergency-contacts-form")
                 .Response(r => r
                    .OnSuccess<EmergencyContactsConfirmation>((json, s) =>
                    {
                        s.Element("emergency-contacts-status").SetText(json, x => x.Confirmation);
                    })
                    .OnError(400, e => e.ValidationErrors("emergency-contacts-form")));
            }))
        <p id="emergency-contacts-status" class="mt-3 text-sm text-text-muted">No intake saved yet.</p>
    </native-card-body>
    </native-card>
</native-vstack>

@Html.RenderPlan(plan)
