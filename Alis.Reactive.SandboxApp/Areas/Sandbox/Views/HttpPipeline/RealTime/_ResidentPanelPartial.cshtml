@model ResidentPanelModel
@using Alis.Reactive.SandboxApp.Hubs
@{
    var plan = Html.ReactivePlan<ResidentPanelModel>();

    // Partial uses the parent page's drill-scoped hub URL so the runtime reuses the
    // existing SignalR connection (same URL = same pooled connection).
    var drillId = (string?)ViewData["DrillId"] ?? "";

    Html.On(plan, t => t.DomReady(p => p.Element("panel-summary").Text.Set("Resident panel open.")));

    // The page's summary line is written first: once the panel is closed, its handler is gone and
    // the line keeps saying so.
    Html.On(plan, t => t.SignalR(SignalRHub.At<ResidentStatusFeed>($"/hubs/resident-status?drill={drillId}"), h => h.StatusChanged,
        (status, p) =>
    {
        p.Element("panel-summary").Text.Set("Resident panel updated live.");
        p.Element("panel-resident-name").Text.Set(status.ResidentName);
        p.Element("panel-resident-status").Text.Set(status.Status);
        p.Element("panel-connections").Text.Set(status.Connections);
    }));
}

<native-card elevation="Flat">
    <native-card-body padding="Compact">
        <native-heading level="H3">Resident Panel (Partial)</native-heading>
        <native-text color="Secondary" size="Sm">
            This partial has its own plan with a SignalR trigger. The runtime
            reused the existing /hubs/resident-status connection — check the
            console for a single "connected" trace.
        </native-text>
        <native-divider />
        <native-grid cols="C2" gap="Sm">
            <native-vstack gap="None">
                <dt class="text-xs font-medium text-text-muted uppercase tracking-wide">Resident</dt>
                <dd id="panel-resident-name" class="mt-1 text-sm text-text-primary">—</dd>
            </native-vstack>
            <native-vstack gap="None">
                <dt class="text-xs font-medium text-text-muted uppercase tracking-wide">Status</dt>
                <dd id="panel-resident-status" class="mt-1 text-sm text-text-primary">—</dd>
            </native-vstack>
        </native-grid>
        <p class="mt-2 text-xs text-text-muted">Live connections on this screen: <span id="panel-connections">—</span></p>
    </native-card-body>
</native-card>

@Html.RenderPlan(plan)
