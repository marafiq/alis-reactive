@model HttpShowcaseModel
@using Alis.Reactive
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "HTTP Requests";

    var plan = Html.ReactivePlan<HttpShowcaseModel>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get("/Sandbox/HttpPipeline/Http/Residents")
         .WhileLoading(l => l.Element("load-spinner").Show())
         .Response(r => r
            .OnSuccess<ResidentsResponse>((json, s) =>
            {
                s.Element("load-spinner").Hide();
                s.Element("load-first").SetText(json, x => x.First);
                s.Element("load-second").SetText(json, x => x.Second);
                s.Element("load-count").SetText(json, x => x.Count);
                s.Element("load-result").AddClass("text-green-600");
            })
         )
    ));

    Html.On(plan, t => t.CustomEvent("native-action-link-grid-refresh", p =>
        p.Get("/Sandbox/HttpPipeline/Http/NativeActionLinkGrid")
         .Response(r => r.OnSuccess(s => s.Into("native-action-link-grid")))
    ));

    Html.On(plan, t => t.DomReady(p =>
    {
        p.When(p.FromUrl("tab")).Eq("medications")
         .Then(then => then.Element("url-cond-meds").Show())
         .Else(els => els.Element("url-cond-meds").Hide());

        p.When(p.FromUrl<int>("page")).Gt(1)
         .Then(then => then.Element("url-cond-prev").Show())
         .Else(els => els.Element("url-cond-prev").Hide());
    }));

    Html.On(plan, t => t.DomReady(p =>
    {
        p.Element("url-display-tab").SetText(p.FromUrl("tab"));
        p.Element("url-display-facility").SetText(p.FromUrl("facilityId"));
    }));

}

<native-vstack gap="Lg">
    <native-heading level="H1">HTTP Requests</native-heading>
    <native-text color="Secondary">
        Eleven HTTP patterns: DomReady GET, POST with gather, chained, parallel, PUT, DELETE with Confirm,
        FormData, GET with search params, multi-status error handling, NativeActionLink row actions, and Finally cleanup.
    </native-text>

    <native-card>
    <native-card-body>
        <native-heading level="H2">1. DomReady &rarr; GET Residents</native-heading>
        <p class="text-sm text-text-secondary mb-3">On page load, fetches residents from the server.</p>
        <div id="load-result" class="space-y-2 font-mono text-sm text-text-muted">
            <p id="load-spinner" hidden class="text-amber-600">Loading...</p>
            <p>First: <span id="load-first">—</span></p>
            <p>Second: <span id="load-second">—</span></p>
            <p>Count: <span id="load-count">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">2. POST with Gather &rarr; Success/Error</native-heading>
        <p class="text-sm text-text-secondary mb-3">Click to POST gathered data. Static value &quot;John Doe&quot; is sent.</p>
        @(Html.NativeButton("save-btn", "Save")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post("/Sandbox/HttpPipeline/Http/Save", g => g.Static("name", "John Doe"))
                 .WhileLoading(l => l.Element("save-spinner").Show())
                 .Response(r => r
                    .OnSuccess<SaveResponse>((json, s) =>
                    {
                        s.Element("save-spinner").Hide();
                        s.Element("save-message").SetText(json, x => x.Message);
                        s.Element("save-received-name").SetText(json, x => x.ReceivedName);
                        s.Element("save-result").AddClass("text-green-600");
                        s.Element("save-result").RemoveClass("text-red-600");
                    })
                    .OnError(400, e =>
                    {
                        e.Element("save-spinner").Hide();
                        e.Element("save-error").SetText("Validation failed: Name is required");
                        e.Element("save-result").AddClass("text-red-600");
                        e.Element("save-result").RemoveClass("text-green-600");
                    })
                 );
            }))
        <div id="save-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="save-spinner" hidden class="text-amber-600">Saving...</p>
            <p>Message: <span id="save-message">—</span></p>
            <p>Received Name: <span id="save-received-name">—</span></p>
            <p id="save-error"></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">3. Chained: GET Residents &rarr; GET Facilities</native-heading>
        <p class="text-sm text-text-secondary mb-3">First request completes, then the chained request fires.</p>
        @(Html.NativeButton("chain-btn", "Load Chain")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/Residents")
                 .WhileLoading(l => l.Element("chain-spinner").Show())
                 .Response(r => r
                    .OnSuccess<ResidentsResponse>((json, s) =>
                    {
                        s.Element("chain-resident-first").SetText(json, x => x.First);
                        s.Element("chain-resident-second").SetText(json, x => x.Second);
                        s.Element("chain-residents").AddClass("text-green-600");
                    })
                    .Chained(c => c
                        .Get("/Sandbox/HttpPipeline/Http/Facilities")
                        .Response(r2 => r2
                            .OnSuccess<FacilitiesResponse>((json2, s2) =>
                            {
                                s2.Element("chain-spinner").Hide();
                                s2.Element("chain-facility-first").SetText(json2, x => x.First);
                                s2.Element("chain-facility-second").SetText(json2, x => x.Second);
                                s2.Element("chain-facilities").AddClass("text-green-600");
                            })
                        )
                    )
                 );
            }))
        <native-vstack gap="Xs" class="mt-3 font-mono text-sm">
            <p id="chain-spinner" hidden class="text-amber-600">Loading chain...</p>
            <div id="chain-residents" class="text-text-muted">
                <p>Resident 1: <span id="chain-resident-first">—</span></p>
                <p>Resident 2: <span id="chain-resident-second">—</span></p>
            </div>
            <div id="chain-facilities" class="text-text-muted">
                <p>Facility 1: <span id="chain-facility-first">—</span></p>
                <p>Facility 2: <span id="chain-facility-second">—</span></p>
            </div>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">4. Parallel: Residents + Facilities Concurrently</native-heading>
        <p class="text-sm text-text-secondary mb-3">Both requests fire at the same time. All-success fires after both complete.</p>
        @(Html.NativeButton("parallel-btn", "Load Parallel")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Element("parallel-spinner").Show();
                p.Parallel(
                    a => a.Get("/Sandbox/HttpPipeline/Http/Residents")
                          .Response(ra => ra.OnSuccess<ResidentsResponse>((json, sa) =>
                          {
                              sa.Element("parallel-resident-first").SetText(json, x => x.First);
                              sa.Element("parallel-resident-second").SetText(json, x => x.Second);
                              sa.Element("parallel-residents").AddClass("text-green-600");
                          })),
                    b => b.Get("/Sandbox/HttpPipeline/Http/Facilities")
                          .Response(rb => rb.OnSuccess<FacilitiesResponse>((json, sb) =>
                          {
                              sb.Element("parallel-facility-first").SetText(json, x => x.First);
                              sb.Element("parallel-facility-second").SetText(json, x => x.Second);
                              sb.Element("parallel-facilities").AddClass("text-green-600");
                          }))
                ).OnAllSettled(s =>
                {
                    s.Element("parallel-spinner").Hide();
                    s.Element("parallel-all").SetText("All parallel requests completed!");
                    s.Element("parallel-all").AddClass("text-green-600");
                });
            }))
        <native-vstack gap="Xs" class="mt-3 font-mono text-sm">
            <p id="parallel-spinner" hidden class="text-amber-600">Loading both...</p>
            <div id="parallel-residents" class="text-text-muted">
                <p>Resident 1: <span id="parallel-resident-first">—</span></p>
                <p>Resident 2: <span id="parallel-resident-second">—</span></p>
            </div>
            <div id="parallel-facilities" class="text-text-muted">
                <p>Facility 1: <span id="parallel-facility-first">—</span></p>
                <p>Facility 2: <span id="parallel-facility-second">—</span></p>
            </div>
            <p id="parallel-all" class="text-text-muted">All: waiting...</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">5. PUT &rarr; Update Resident</native-heading>
        <p class="text-sm text-text-secondary mb-3">Sends a PUT request with a JSON body to update a resident.</p>
        @(Html.NativeButton("put-btn", "Update Resident")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Put("/Sandbox/HttpPipeline/Http/UpdateResident", g => g
                    .Static("name", "Updated Name")
                    .Static("facilityId", "1"))
                 .WhileLoading(l => l.Element("put-spinner").Show())
                 .Response(r => r
                    .OnSuccess<UpdateResponse>((json, s) =>
                    {
                        s.Element("put-spinner").Hide();
                        s.Element("put-received-name").SetText(json, x => x.ReceivedName);
                        s.Element("put-received-facility").SetText(json, x => x.ReceivedFacilityId);
                        s.Element("put-result").AddClass("text-green-600");
                    })
                    .OnError(400, e =>
                    {
                        e.Element("put-spinner").Hide();
                        e.Element("put-result").SetText("Validation failed");
                        e.Element("put-result").AddClass("text-red-600");
                    })
                 );
            }))
        <div id="put-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="put-spinner" hidden class="text-amber-600">Updating...</p>
            <p>Received Name: <span id="put-received-name">—</span></p>
            <p>Received Facility: <span id="put-received-facility">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">6. DELETE with Confirm &rarr; Guarded Deletion</native-heading>
        <p class="text-sm text-text-secondary mb-3">Shows a confirmation dialog before sending DELETE. Cancel aborts, OK proceeds.</p>
        @(Html.NativeButton("delete-btn", "Delete Resident #42")
            .CssClass("rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Confirm("Are you sure you want to delete resident #42?")
                 .Then(t =>
                 {
                    t.Delete("/Sandbox/HttpPipeline/Http/DeleteResident/42")
                     .WhileLoading(l => l.Element("delete-spinner").Show())
                     .Response(r => r
                        .OnSuccess<DeleteResponse>((json, s) =>
                        {
                            s.Element("delete-spinner").Hide();
                            s.Element("delete-id").SetText(json, x => x.DeletedId);
                            s.Element("delete-result").AddClass("text-green-600");
                        })
                     );
                 });
            }))
        <div id="delete-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="delete-spinner" hidden class="text-amber-600">Deleting...</p>
            <p>Deleted ID: <span id="delete-id">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">7. POST FormData &rarr; IncludeAll Gather</native-heading>
        <p class="text-sm text-text-secondary mb-3">Gathers all form fields and sends as JSON body (IncludeAll pattern).</p>
        <form id="formdata-form" class="flex flex-col gap-3 mb-3">
            @{ Html.InputField(plan, m => m.FirstName, o => o.Label("First Name"))
               .NativeTextBox(b => b
                   .CssClass("rounded-md border border-border px-3 py-1.5 text-sm")
                   .Placeholder("First name")); }
            @{ Html.InputField(plan, m => m.LastName, o => o.Label("Last Name"))
               .NativeTextBox(b => b
                   .CssClass("rounded-md border border-border px-3 py-1.5 text-sm")
                   .Placeholder("Last name")); }
            @{ Html.InputField(plan, m => m.Email, o => o.Label("Email"))
               .NativeTextBox(b => b
                   .Type("email")
                   .CssClass("rounded-md border border-border px-3 py-1.5 text-sm")
                   .Placeholder("Email")); }
        </form>
        @(Html.NativeButton("formdata-btn", "Submit Form")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post("/Sandbox/HttpPipeline/Http/SaveFormData", g => g
                    .Static("FirstName", "John")
                    .Static("LastName", "Doe")
                    .Static("Email", "john@example.com"))
                 .WhileLoading(l => l.Element("formdata-spinner").Show())
                 .Response(r => r
                    .OnSuccess<FormDataResponse>((json, s) =>
                    {
                        s.Element("formdata-spinner").Hide();
                        s.Element("formdata-count").SetText(json, x => x.Count);
                        s.Element("formdata-fields").SetText(json, x => x.ReceivedFields);
                        s.Element("formdata-result").AddClass("text-green-600");
                    })
                 );
            }))
        <div id="formdata-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="formdata-spinner" hidden class="text-amber-600">Submitting...</p>
            <p>Field Count: <span id="formdata-count">—</span></p>
            <p>Received Fields: <span id="formdata-fields">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">8. GET with Search Params &rarr; URL Query</native-heading>
        <p class="text-sm text-text-secondary mb-3">Sends a GET request with gather items appended as ?q=John URL params.</p>
        @(Html.NativeButton("search-btn", "Search for 'John'")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/Search")
                 .Gather(g => g.Static("q", "John"))
                 .WhileLoading(l => l.Element("search-spinner").Show())
                 .Response(r => r
                    .OnSuccess<SearchResponse>((json, s) =>
                    {
                        s.Element("search-spinner").Hide();
                        s.Element("search-query").SetText(json, x => x.Query);
                        s.Element("search-match-count").SetText(json, x => x.MatchCount);
                        s.Element("search-result").AddClass("text-green-600");
                    })
                 );
            }))
        <div id="search-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="search-spinner" hidden class="text-amber-600">Searching...</p>
            <p>Query: <span id="search-query">—</span></p>
            <p>Match Count: <span id="search-match-count">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">9. Multi-Status Error Handling &rarr; 422 Route</native-heading>
        <p class="text-sm text-text-secondary mb-3">Posts empty data to trigger 422 validation errors. Multiple OnError handlers route by status.</p>
        @(Html.NativeButton("multi-err-btn", "Validate (will fail)")
            .CssClass("rounded-md bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-700 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post("/Sandbox/HttpPipeline/Http/ValidateResident", g => g
                    .Static("name", "")
                    .Static("facilityId", ""))
                 .WhileLoading(l => l.Element("multi-err-spinner").Show())
                 .Response(r => r
                    .OnSuccess(s =>
                    {
                        s.Element("multi-err-spinner").Hide();
                        s.Element("multi-err-result").SetText("Validation passed");
                        s.Element("multi-err-result").AddClass("text-green-600");
                    })
                    .OnError(422, e =>
                    {
                        e.Element("multi-err-spinner").Hide();
                        e.Element("multi-err-summary").SetText("422 — 2 validation error(s): Name, FacilityId");
                        e.Element("multi-err-result").AddClass("text-amber-600");
                    })
                    .OnError(500, e =>
                    {
                        e.Element("multi-err-spinner").Hide();
                        e.Element("multi-err-result").SetText("500 — Server error");
                        e.Element("multi-err-result").AddClass("text-red-600");
                    })
                 );
            }))
        <div id="multi-err-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="multi-err-spinner" hidden class="text-amber-600">Validating...</p>
            <p>Error: <span id="multi-err-summary">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">10. NativeActionLink &rarr; Repeated Row Actions</native-heading>
        <p class="text-sm text-text-secondary mb-3">Each row renders a normal anchor with a single serialized request chain. On success the delete action dispatches a refresh event, and the page-level listener reloads the same grid route back into the container.</p>
        <div id="native-action-link-grid">
            @await Html.PartialAsync("~/Areas/Sandbox/Views/HttpPipeline/Http/_NativeActionLinkGrid.cshtml", Model.ActionRows)
        </div>
        <native-vstack gap="Xs" class="mt-3 font-mono text-sm">
            <p id="native-action-link-status" class="text-text-muted">No row action yet</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">11. NativeActionLink &rarr; Standalone Single Action</native-heading>
        <p class="text-sm text-text-secondary mb-3">A single native action link can also execute one request chain on its own and load a success fragment directly into a local target.</p>
        <native-hstack gap="Base">
            @(Html.NativeActionLink("Run Standalone NativeActionLink", "/Sandbox/HttpPipeline/Http/StandaloneNativeActionLink", p => p
                .Post("/Sandbox/HttpPipeline/Http/StandaloneNativeActionLink", g => g.Static("command", "run"))
                .WhileLoading(x => x.Element("standalone-native-action-link-status").SetText("Running standalone NativeActionLink..."))
                .Response(r => r
                    .OnSuccess(x =>
                    {
                        x.Into("standalone-native-action-link-result");
                        x.Element("standalone-native-action-link-status").SetText("Standalone NativeActionLink succeeded");
                    })
                    .OnError(400, x => x.Element("standalone-native-action-link-status").SetText("Standalone NativeActionLink failed"))))
                .CssClass("text-sm font-medium text-blue-600 hover:text-blue-700")
                .Attr("data-testid", "standalone-native-action-link"))
        </native-hstack>
        <native-vstack gap="Xs" class="mt-3 font-mono text-sm">
            <p id="standalone-native-action-link-status" class="text-text-muted">Standalone link has not run yet</p>
            <div id="standalone-native-action-link-result" class="text-text-muted">No standalone response yet</div>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">19. FromUrl in Gather &rarr; Send URL Params</native-heading>
        <p class="text-sm text-text-secondary mb-3">Reads ?tab and ?facilityId from the browser URL and sends them as HTTP request params.</p>
        @(Html.NativeButton("url-gather-btn", "Send URL Params")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/UrlParamEcho")
                 .Gather(g => g
                     .FromUrl("tab")
                     .FromUrl("facilityId"))
                 .Response(r => r
                    .OnSuccess<UrlParamEchoResponse>((json, s) =>
                    {
                        s.Element("url-gather-tab").SetText(json, x => x.Tab);
                        s.Element("url-gather-facility").SetText(json, x => x.FacilityId);
                        s.Element("url-gather-result").AddClass("text-green-600");
                    })
                 );
            }))
        <div id="url-gather-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p>Tab: <span id="url-gather-tab">—</span></p>
            <p>Facility ID: <span id="url-gather-facility">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">20. FromUrl in Conditions &rarr; DomReady Branch</native-heading>
        <p class="text-sm text-text-secondary mb-3">On page load, branches based on ?tab and ?page URL params. Navigate with ?tab=medications&amp;page=3 to see results.</p>
        <native-vstack gap="Xs" class="font-mono text-sm">
            <p id="url-cond-meds" hidden class="text-green-600">Medications panel visible (tab=medications)</p>
            <p id="url-cond-prev" hidden class="text-blue-600">Previous button visible (page &gt; 1)</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">21. FromUrl in SetText &rarr; Display URL Params</native-heading>
        <p class="text-sm text-text-secondary mb-3">Displays ?tab and ?facilityId values directly in the DOM on page load.</p>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Tab: <span id="url-display-tab"></span></p>
            <p>Facility: <span id="url-display-facility"></span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">22. FromUrl Composed &rarr; Route Param + Header + Gather</native-heading>
        <p class="text-sm text-text-secondary mb-3">One request composes three value sources: URL route param, URL header, URL gather field.</p>
        @(Html.NativeButton("url-compose-btn", "Compose All Sources")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/ComposeEcho/{id}")
                 .Gather(g => g
                     .RouteParam("id", p.FromUrl<int>("residentId"))
                     .Header("X-Tab", p.FromUrl("tab"))
                     .FromUrl("facilityId", "facility"))
                 .Response(r => r
                    .OnSuccess<ComposeEchoResponse>((json, s) =>
                    {
                        s.Element("url-compose-name").SetText(json, x => x.Name);
                        s.Element("url-compose-tab").SetText(json, x => x.ReceivedTab);
                        s.Element("url-compose-facility").SetText(json, x => x.ReceivedFacility);
                        s.Element("url-compose-result").AddClass("text-green-600");
                    })
                 );
            }))
        @(Html.NativeButton("url-chain-btn", "Chain URL Sources")
            .CssClass("ml-2 rounded-md bg-surface-alt px-4 py-2 text-sm font-medium text-text-primary border border-border hover:bg-surface-hover transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/Residents/{id}")
                 .Gather(g => g.RouteParam("id", p.FromUrl<int>("residentId")))
                 .Response(r => r
                    .OnSuccess<ResidentByIdResponse>((json, s) =>
                    {
                        s.Get("/Sandbox/HttpPipeline/Http/Facilities/{facilityId}/Residents/{residentId}")
                         .Gather(g => g
                            .RouteParam("facilityId", s.FromUrl<int>("facilityId"))
                            .RouteParam("residentId", json.Read(x => x.ResidentId)))
                         .Response(r2 => r2.OnSuccess<FacilityResidentResponse>((json2, s2) =>
                         {
                             s2.Element("url-chain-name").SetText(json2, x => x.Name);
                             s2.Element("url-chain-result").AddClass("text-green-600");
                         }));
                    })
                 );
            }))
        <div id="url-compose-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p>Name: <span id="url-compose-name">—</span></p>
            <p>Tab Header: <span id="url-compose-tab">—</span></p>
            <p>Facility Gather: <span id="url-compose-facility">—</span></p>
            <p id="url-chain-result">Chained Name: <span id="url-chain-name">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">15. GET with Single Route Param</native-heading>
        <p class="text-sm text-text-secondary mb-3">Route param {id} resolved to 42 before fetch. Server echoes the received ID.</p>
        @(Html.NativeButton("route-single-btn", "Load Resident #42")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/Residents/{id}")
                 .Gather(g => g.RouteParam("id", 42))
                 .WhileLoading(l => l.Element("route-single-spinner").Show())
                 .Response(r => r
                    .OnSuccess<ResidentByIdResponse>((json, s) =>
                    {
                        s.Element("route-single-spinner").Hide();
                        s.Element("route-single-id").SetText(json, x => x.ResidentId);
                        s.Element("route-single-name").SetText(json, x => x.Name);
                        s.Element("route-single-result").AddClass("text-green-600");
                    })
                 );
            }))
        <div id="route-single-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="route-single-spinner" hidden class="text-amber-600">Loading...</p>
            <p>Resident ID: <span id="route-single-id">—</span></p>
            <p>Name: <span id="route-single-name">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">16. GET with Multiple Route Params</native-heading>
        <p class="text-sm text-text-secondary mb-3">Two route params {facilityId} and {residentId} resolved in one URL template.</p>
        @(Html.NativeButton("route-multi-btn", "Load Facility Resident")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/Facilities/{facilityId}/Residents/{residentId}")
                 .Gather(g => g
                     .RouteParam("facilityId", 7)
                     .RouteParam("residentId", 99))
                 .WhileLoading(l => l.Element("route-multi-spinner").Show())
                 .Response(r => r
                    .OnSuccess<FacilityResidentResponse>((json, s) =>
                    {
                        s.Element("route-multi-spinner").Hide();
                        s.Element("route-multi-facility").SetText(json, x => x.FacilityId);
                        s.Element("route-multi-resident").SetText(json, x => x.ResidentId);
                        s.Element("route-multi-name").SetText(json, x => x.Name);
                        s.Element("route-multi-result").AddClass("text-green-600");
                    })
                 );
            }))
        <div id="route-multi-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="route-multi-spinner" hidden class="text-amber-600">Loading...</p>
            <p>Facility ID: <span id="route-multi-facility">—</span></p>
            <p>Resident ID: <span id="route-multi-resident">—</span></p>
            <p>Name: <span id="route-multi-name">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">17. Chained with Route Params + Headers</native-heading>
        <p class="text-sm text-text-secondary mb-3">First request resolves {id}=42, then the success response drives the second route parameter. Both carry custom headers.</p>
        @(Html.NativeButton("route-chain-btn", "Chain with Route Params")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/Residents/{id}")
                 .Gather(g => g
                     .RouteParam("id", 42)
                     .Header("X-Step", "first"))
                 .WhileLoading(l => l.Element("route-chain-spinner").Show())
                 .Response(r => r
                    .OnSuccess<ResidentByIdResponse>((json, s) =>
                    {
                        s.Element("route-chain-first-id").SetText(json, x => x.ResidentId);
                        s.Element("route-chain-first").AddClass("text-green-600");
                        s.Get("/Sandbox/HttpPipeline/Http/Facilities/{facilityId}/Residents/{residentId}")
                         .Gather(g2 => g2
                             .RouteParam("facilityId", 3)
                             .RouteParam("residentId", json.Read(x => x.ResidentId))
                             .Header("X-Step", "second"))
                         .Response(r2 => r2
                             .OnSuccess<FacilityResidentResponse>((json2, s2) =>
                             {
                                 s2.Element("route-chain-spinner").Hide();
                                 s2.Element("route-chain-second-name").SetText(json2, x => x.Name);
                                 s2.Element("route-chain-second").AddClass("text-green-600");
                             })
                         );
                    })
                 );
            }))
        <native-vstack gap="Xs" class="mt-3 font-mono text-sm">
            <p id="route-chain-spinner" hidden class="text-amber-600">Loading chain...</p>
            <div id="route-chain-first" class="text-text-muted">
                <p>1st Resident ID: <span id="route-chain-first-id">—</span></p>
            </div>
            <div id="route-chain-second" class="text-text-muted">
                <p>2nd Name: <span id="route-chain-second-name">—</span></p>
            </div>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">18. URI-Encoded Route Param</native-heading>
        <p class="text-sm text-text-secondary mb-3">Route param &quot;John Doe&quot; is URI-encoded to &quot;John%20Doe&quot; in the URL path. Server URL-decodes it.</p>
        @(Html.NativeButton("route-encoded-btn", "Load Resident by Name")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/ResidentByName/{name}")
                 .Gather(g => g.RouteParam("name", "John Doe"))
                 .Response(r => r
                    .OnSuccess<ResidentByNameResponse>((json, s) =>
                    {
                        s.Element("route-encoded-name").SetText(json, x => x.ReceivedName);
                        s.Element("route-encoded-result").AddClass("text-green-600");
                    })
                 );
            }))
        <div id="route-encoded-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p>Received Name: <span id="route-encoded-name">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">12. GET with Custom Headers</native-heading>
        <p class="text-sm text-text-secondary mb-3">Sends a GET request with literal custom headers. Server echoes them back.</p>
        @(Html.NativeButton("header-btn", "Send with Headers")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")

            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/EchoHeaders")
                 .Gather(g => g
                     .Header("X-Api-Version", "2024-01-15")
                     .Header("X-Request-Id", "test-header-123")
                     .Header("X-Tenant-Id", "facility-42"))
                 .WhileLoading(l => l.Element("header-spinner").Show())
                 .Response(r => r
                    .OnSuccess<EchoHeadersResponse>((json, s) =>
                    {
                        s.Element("header-spinner").Hide();
                        s.Element("header-api-version").SetText(json, x => x.ApiVersion);
                        s.Element("header-request-id").SetText(json, x => x.RequestId);
                        s.Element("header-tenant-id").SetText(json, x => x.TenantId);
                        s.Element("header-result").AddClass("text-green-600");
                    })
                 );
            }))
        <div id="header-result" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="header-spinner" hidden class="text-amber-600">Sending...</p>
            <p>X-Api-Version: <span id="header-api-version">—</span></p>
            <p>X-Request-Id: <span id="header-request-id">—</span></p>
            <p>X-Tenant-Id: <span id="header-tenant-id">—</span></p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">13. Chained with Headers</native-heading>
        <p class="text-sm text-text-secondary mb-3">Both chained requests carry custom headers. First GET echoes headers, then chained POST echoes different headers.</p>
        @(Html.NativeButton("header-chain-btn", "Chain with Headers")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")

            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Get("/Sandbox/HttpPipeline/Http/EchoHeaders")
                 .Gather(g => g
                     .Header("X-Api-Version", "chain-v1")
                     .Header("X-Request-Id", "chain-req-1"))
                 .WhileLoading(l => l.Element("header-chain-spinner").Show())
                 .Response(r => r
                    .OnSuccess<EchoHeadersResponse>((json, s) =>
                    {
                        s.Element("header-chain-first-version").SetText(json, x => x.ApiVersion);
                        s.Element("header-chain-first-id").SetText(json, x => x.RequestId);
                        s.Element("header-chain-first").AddClass("text-green-600");
                    })
                    .Chained(c => c
                        .Post("/Sandbox/HttpPipeline/Http/EchoHeaders")
                        .Gather(g2 => g2
                            .Header("X-Api-Version", "chain-v2")
                            .Header("X-Tenant-Id", "chain-tenant-99")
                            .Static("payload", "chained"))
                        .Response(r2 => r2
                            .OnSuccess<EchoHeadersResponse>((json2, s2) =>
                            {
                                s2.Element("header-chain-spinner").Hide();
                                s2.Element("header-chain-second-version").SetText(json2, x => x.ApiVersion);
                                s2.Element("header-chain-second-tenant").SetText(json2, x => x.TenantId);
                                s2.Element("header-chain-second").AddClass("text-green-600");
                            })
                        )
                    )
                 );
            }))
        <native-vstack gap="Xs" class="mt-3 font-mono text-sm">
            <p id="header-chain-spinner" hidden class="text-amber-600">Loading chain...</p>
            <div id="header-chain-first" class="text-text-muted">
                <p>1st Version: <span id="header-chain-first-version">—</span></p>
                <p>1st Request-Id: <span id="header-chain-first-id">—</span></p>
            </div>
            <div id="header-chain-second" class="text-text-muted">
                <p>2nd Version: <span id="header-chain-second-version">—</span></p>
                <p>2nd Tenant-Id: <span id="header-chain-second-tenant">—</span></p>
            </div>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">14. Parallel with Headers</native-heading>
        <p class="text-sm text-text-secondary mb-3">Two parallel requests each carry their own headers. Both fire simultaneously.</p>
        @(Html.NativeButton("header-parallel-btn", "Parallel with Headers")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")

            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Element("header-parallel-spinner").Show();
                p.Parallel(
                    a => a.Get("/Sandbox/HttpPipeline/Http/EchoHeaders")
                          .Gather(g => g
                              .Header("X-Api-Version", "parallel-a")
                              .Header("X-Request-Id", "parallel-req-a"))
                          .Response(ra => ra.OnSuccess<EchoHeadersResponse>((json, sa) =>
                          {
                              sa.Element("header-parallel-a-version").SetText(json, x => x.ApiVersion);
                              sa.Element("header-parallel-a-id").SetText(json, x => x.RequestId);
                              sa.Element("header-parallel-a").AddClass("text-green-600");
                          })),
                    b => b.Get("/Sandbox/HttpPipeline/Http/EchoHeaders")
                          .Gather(g => g
                              .Header("X-Api-Version", "parallel-b")
                              .Header("X-Tenant-Id", "parallel-tenant-b"))
                          .Response(rb => rb.OnSuccess<EchoHeadersResponse>((json, sb) =>
                          {
                              sb.Element("header-parallel-b-version").SetText(json, x => x.ApiVersion);
                              sb.Element("header-parallel-b-tenant").SetText(json, x => x.TenantId);
                              sb.Element("header-parallel-b").AddClass("text-green-600");
                          }))
                ).OnAllSettled(s =>
                {
                    s.Element("header-parallel-spinner").Hide();
                    s.Element("header-parallel-all").SetText("Both parallel requests with headers completed!");
                    s.Element("header-parallel-all").AddClass("text-green-600");
                });
            }))
        <native-vstack gap="Xs" class="mt-3 font-mono text-sm">
            <p id="header-parallel-spinner" hidden class="text-amber-600">Loading both...</p>
            <div id="header-parallel-a" class="text-text-muted">
                <p>A Version: <span id="header-parallel-a-version">—</span></p>
                <p>A Request-Id: <span id="header-parallel-a-id">—</span></p>
            </div>
            <div id="header-parallel-b" class="text-text-muted">
                <p>B Version: <span id="header-parallel-b-version">—</span></p>
                <p>B Tenant-Id: <span id="header-parallel-b-tenant">—</span></p>
            </div>
            <p id="header-parallel-all" class="text-text-muted">All: waiting...</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">Finally Demo &mdash; Guaranteed Cleanup</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Both buttons use <code>.Finally()</code> to hide the spinner.
            No manual <code>.Hide()</code> in success/error handlers.
        </p>
        <native-hstack gap="Sm">
            @(Html.NativeButton("finally-save-btn", "Finally OK")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post("/Sandbox/HttpPipeline/Http/FlakyEndpoint", g => g.Static("name", "John"))
                     .WhileLoading(l => l.Element("finally-spinner").Show())
                     .Response(r => r
                        .OnSuccess(s =>
                        {
                            s.Element("finally-result").SetText("Saved successfully!");
                            s.Element("finally-result").AddClass("text-green-600");
                            s.Element("finally-result").RemoveClass("text-red-600");
                        })
                     )
                     .Finally(f => f.Element("finally-spinner").Hide());
                }))
            @(Html.NativeButton("finally-fail-btn", "Finally 500")
                .CssClass("rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post("/Sandbox/HttpPipeline/Http/FlakyEndpoint", g => g.Static("name", "fail"))
                     .WhileLoading(l => l.Element("finally-spinner").Show())
                     .Response(r => r
                        .OnError(500, e =>
                        {
                            e.Element("finally-result").SetText("Server error (500) — but spinner is gone!");
                            e.Element("finally-result").AddClass("text-red-600");
                            e.Element("finally-result").RemoveClass("text-green-600");
                        })
                     )
                     .Finally(f => f.Element("finally-spinner").Hide());
                }))
        </native-hstack>
        <div id="finally-result-area" class="mt-3 space-y-2 font-mono text-sm text-text-muted">
            <p id="finally-spinner" hidden class="text-amber-600">Processing...</p>
            <p id="finally-result">—</p>
        </div>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">Plan JSON</native-heading>
        <pre class="rounded-md bg-slate-900 text-emerald-400 p-4 font-mono text-xs overflow-x-auto"><code id="plan-json">@Html.Raw(plan.RenderFormatted())</code></pre>
    </native-card-body>
    </native-card>
</native-vstack>

@Html.RenderPlan(plan)
