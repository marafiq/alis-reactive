@model HandoverSheet

<div class="rounded-md border border-border px-4 py-3">
    <h3 class="text-sm font-semibold text-text">@Model.Wing wing handover</h3>
    <ul class="mt-2 list-disc pl-5 text-sm">
        @foreach (var note in Model.Notes)
        {
            <li>@note</li>
        }
    </ul>
</div>
