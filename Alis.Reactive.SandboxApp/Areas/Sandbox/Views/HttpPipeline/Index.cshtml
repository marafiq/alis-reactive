@{
    ViewData["Title"] = "HTTP Pipeline";
}

<h1 class="text-2xl font-bold text-text-primary mb-2">HTTP Pipeline</h1>
<p class="text-text-secondary mb-8">Server communication patterns</p>

<native-grid cols="C3" gap="Base">
    <a asp-area="Sandbox" asp-controller="Http" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Http
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Click buttons to fire GET/POST requests with gather payloads, watch chained sequential requests cascade, and see parallel requests resolve concurrently
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="ContentType" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Content Type
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Compare JSON responses (parsed into DOM updates) vs HTML responses (injected via Into()), see how the runtime handles each content type
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="MedicationOrder" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Medication Order
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Save a refill order whose lines are indexed fields (Lines[0].Sku) as JSON, and see the server confirm every line it received
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="MedicationPass" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Medication Pass
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Record doses keyed by resident id (Administered[1042]) as JSON, and see the server confirm each resident it received
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="ResidentChart" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Resident Charts
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            A member named in capitals (MRN) is read the way its writer named it: shown on the chart, tested by a condition, and carried by the review flag a dispatch sends
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="ShiftHandover" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Shift Handover
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            A link's request keeps its header and its Finally: marking a note read names the shift, and the loader lifts afterwards
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="DischargeNotice" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Discharge Notice
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            A chained request reads only its own answer: a family notice that fails with no body shows no reason, not the discharge's message, and one that fails with a reason shows it
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="RealTime" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Real Time
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Watch Server-Sent Events stream data in real time, see live DOM updates as events arrive, observe retry behavior on disconnection
        </p>
    </a>
</native-grid>
