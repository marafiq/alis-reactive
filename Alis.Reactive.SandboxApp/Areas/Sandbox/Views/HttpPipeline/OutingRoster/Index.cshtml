@model OutingRosterModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.DropDowns
@{
    ViewData["Title"] = "Garden Outing";
    var plan = Html.ReactivePlan<OutingRosterModel>();
    var aids = new List<MobilityAidOption> { new("WALKER", "Walker"), new("WHEELCHAIR", "Wheelchair"), new("CANE", "Cane"), new("SCOOTER", "Mobility scooter") };
    var attendants = new[] { "Nora Ellis", "Malik Stone", "Elena Ruiz" };

    // No aid is chosen yet, so nobody works the lift.
    Html.On(plan, t => t.DomReady(p => p.Component<FusionAutoComplete>(m => m.LiftAttendant).Enabled.Set(false)));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Garden Outing</native-heading>
    <native-text color="Secondary">Thursday's trip to the botanical garden. Find the residents who use the chosen aids, then book the bus.</native-text>

    <native-card><native-card-body id="outing-roster-form">
        <native-vstack gap="Sm">
            @{ Html.InputField(plan, m => m.MobilityAids, o => o.Label("Mobility aids"))
                .FusionMultiSelect(b => b
                    .DataSource(aids)
                    .Fields<MobilityAidOption>(t => t.Name, v => v.Code)
                    .Placeholder("All residents")
                    .Mode(VisualMode.Box))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    // A wheelchair boards only the bus with a lift.
                    p.When(args.Value).ArrayContains("WHEELCHAIR")
                        .Then(lift =>
                        {
                            lift.Element("lift-bus-note").Show();
                            lift.Component<FusionAutoComplete>(m => m.LiftAttendant).Enabled.Set(true);
                        })
                        .Else(noLift =>
                        {
                            noLift.Element("lift-bus-note").Hide();
                            noLift.Component<FusionAutoComplete>(m => m.LiftAttendant).Enabled.Set(false);
                        });
                }); }
            <p id="lift-bus-note" class="text-sm text-warning" hidden>A wheelchair boards only the lift bus: the garden trip takes the lift bus.</p>
            @{ Html.InputField(plan, m => m.LiftAttendant, o => o.Label("Lift-bus attendant"))
                .FusionAutoComplete(b => b
                    .DataSource(attendants)
                    .Placeholder("Who works the lift?")); }
            <native-hstack gap="Sm">
                @(Html.NativeButton("find-residents-btn", "Find Residents")
                    .CssClass("rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Get(Url.SandboxRoute("Residents", "OutingRoster"))
                         .Gather(g => g.Form(m => m.MobilityAids))
                         .Response(r => r.OnSuccess<OutingRosterAnswer>((json, s) =>
                             s.Element("roster-residents").Text.Set(json.Get(x => x.Residents))));
                    }))
                @(Html.NativeButton("book-bus-btn", "Book the Bus")
                    .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Post(Url.SandboxRoute("Book", "OutingRoster")).Gather(g => g.Form("outing-roster-form"))
                         .AsFormData()
                         .Response(r => r
                            .OnSuccess<OutingBookingAnswer>((json, s) =>
                            {
                                s.Element("bus-booking").Text.Set(json.Get(x => x.Confirmation));
                                s.Element("bus-booking").ClassList.Remove("text-red-600");
                            })
                            .OnError<OutingBookingRefusal>(400, (json, e) =>
                            {
                                e.Element("bus-booking").Text.Set(json.Get(x => x.Reason));
                                e.Element("bus-booking").ClassList.Add("text-red-600");
                            }));
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Sm">
            <p class="text-sm">Matching residents: <span id="roster-residents" class="font-medium">Not searched yet.</span></p>
            <p class="text-sm">Bus: <span id="bus-booking" class="font-medium">Not booked.</span></p>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
