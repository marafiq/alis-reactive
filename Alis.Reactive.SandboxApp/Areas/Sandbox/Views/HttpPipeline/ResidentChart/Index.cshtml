@model ResidentChartPageModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Fusion.Templates
@{
    ViewData["Title"] = "Resident Charts";
    var plan = Html.ReactivePlan<ResidentChartPageModel>();
    var residents = new[] { (Key: "helen", Name: "Helen Park"), (Key: "arthur", Name: "Arthur Bell") };
    var chartLinks = new List<ChartLink> { new("MRN-20417", "Helen Park", "helen"), new("MRN-20533", "Rosa Diaz", "rosa") };
    var chartLinkItem = FusionTemplate.Create<ChartLink>()
        .Class("flex justify-between gap-4")
        .Span(link => link.MRN, "font-mono")
        .Span(link => link.Name, "text-text-muted")
        .Render();
    var chartUrl = Url.SandboxRouteTemplate("Chart", "ResidentChart", "resident");

    Html.On(plan, t => t.CustomEvent<ChartFlagged>(ResidentChartEvents.ChartFlagged, (flag, p) =>
        p.Element("review-flag").Text.Set(flag.Get(x => x.MRN!))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Resident Charts</native-heading>
    <native-text color="Secondary">Maple Grove, second floor. Open a resident's chart summary.</native-text>

    <native-card><native-card-body>
        <native-hstack gap="Sm">
            @foreach (var resident in residents)
            {
                @(Html.NativeButton($"open-{resident.Key}-chart-btn", $"Open {resident.Name}'s Chart")
                    .CssClass("rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Get(Url.SandboxRoute("Chart", "ResidentChart", new { resident = resident.Key }))
                         .Response(r => r.OnSuccess<ResidentChart>((json, s) =>
                         {
                             s.Element("chart-name").Text.Set(json.Get(x => x.Name));
                             s.Element("chart-mrn").Text.Set(json.Get(x => x.MRN!));
                             s.When(json.Get(x => x.MRN)).NotEmpty()
                              .Then(t => t.Element("chart-record").Text.Set("Chart linked to the medical record."))
                              .Else(e => e.Element("chart-record").Text.Set("No medical record yet: request one from admissions."));
                         }));
                    }))
            }
        </native-hstack>
        <div class="mt-4 max-w-sm">
            @{ Html.InputField(plan, m => m.ChartByRecordNumber, o => o.Label("Open a chart by medical record number"))
                .FusionDropDownList(b => b
                    .DataSource(chartLinks)
                    .Fields<ChartLink>(t => t.MRN, v => v.Resident)
                    .ItemTemplate(chartLinkItem)
                    .Placeholder("Choose a record number"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    p.Get(chartUrl)
                     .Gather<ChartQuery>(g => g.Set(x => x.Resident, args.Value))
                     .Response(r => r.OnSuccess<ResidentChart>((json, s) =>
                     {
                         s.Element("chart-name").Text.Set(json.Get(x => x.Name));
                         s.Element("chart-mrn").Text.Set(json.Get(x => x.MRN!));
                         s.Element("chart-record").Text.Set("Chart linked to the medical record.");
                     }));
                }); }
        </div>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Sm">
            <p class="text-sm">Resident: <span id="chart-name" class="font-medium">No chart open.</span></p>
            <p class="text-sm">Medical record number: <span id="chart-mrn" class="font-medium"></span></p>
            <p id="chart-record" class="text-sm text-text-muted"></p>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Sm">
            <native-heading level="H2">Care team review</native-heading>
            @(Html.NativeButton("flag-helen-chart-btn", "Flag Helen Park's Chart for Review")
                .CssClass("self-start rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Dispatch(ResidentChartEvents.ChartFlagged, new ChartFlagged { MRN = Model.ReviewChartMrn });
                }))
            <p class="text-sm">Flagged chart: <span id="review-flag" class="font-medium">None</span></p>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
