@{
    ViewData["Title"] = "Plugins";
}

<h1 class="text-2xl font-bold text-text-primary mb-2">Plugins</h1>
<p class="text-text-secondary mb-8">The escape hatch — native JS exposed to the DSL through plugin registration</p>

<native-grid cols="C3" gap="Base">
    <a asp-area="Sandbox" asp-controller="ArrayManager" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Ward Desk
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            The ward census read through plugins, tonight's staffing request and a visitor pass
        </p>
    </a>
    <a asp-area="Sandbox" asp-controller="Pager" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Wing Pager
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            The community's pager system as a plugin with every kind of member: a property written, a code written only, a promise waited for, a status object and a list of pagers; initials as a plugin that is a function
        </p>
    </a>
    <a asp-area="Sandbox" asp-controller="Pager" asp-action="Duplicate"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Wing Pager, registered twice
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            A view that registers the same plugin twice: the plan refuses it as the view renders, by name
        </p>
    </a>
</native-grid>
