@model ArrayManagerModel
@using Alis.Reactive
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Builders.Conditions
@{
    ViewData["Title"] = "Array Plugin";

    var plan = Html.ReactivePlan<ArrayManagerModel>();

    var array = plan.RegisterPlugin<ArrayPlugin>();
    var analytics = plan.RegisterPlugin<AnalyticsPlugin>();
    var slugify = plan.RegisterPlugin<SlugifyPlugin>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("Residents", "ArrayManager"))
         .Response(r => r.OnSuccess<ResidentsListResponse>((json, s) =>
         {
             TypedPluginSource<int> countSrc = p.Plugin(array.Count).Arg(json, x => x.Items);
             s.Element("arr-total").SetText(countSrc);

             TypedPluginSource<object> pluckSrc = p.Plugin(array.Pluck)
                 .Arg(json, x => x.Items).Arg(0).Arg("name");
             s.Element("arr-first-name").SetText(pluckSrc);

             TypedPluginSource<object> filtered = p.Plugin(array.Filter)
                 .Arg(json, x => x.Items).Arg("status").Arg("active");
             TypedPluginSource<int> activeCount = p.Plugin(array.Count).Arg(filtered);
             s.Element("arr-active-count").SetText(activeCount);

             TypedPluginSource<int> sumSrc = p.Plugin(array.Sum)
                 .Arg(json, x => x.Items).Arg("age");
             s.Element("arr-total-age").SetText(sumSrc);

             TypedPluginSource<bool> someSrc = p.Plugin(array.Some)
                 .Arg(json, x => x.Items).Arg("status").Arg("critical");
             s.When(someSrc).Truthy()
              .Then(then => then.Element("arr-has-critical").Show())
              .Else(els => els.Element("arr-no-critical").Show());

             TypedPluginSource<string> slugSrc = p.Plugin(slugify.Slug).Arg("John Doe");
             s.Element("arr-root-slug").SetText(slugSrc);

             s.Element("arr-results").AddClass("text-green-600");
         }))));

    Html.NativeButton("arr-send-btn", "Send to Server")
        .Reactive(plan, evt => evt.Click, (args, p) =>
        {
            TypedPluginSource<int> countForGather = p.Plugin(array.Count).Arg("items");
            p.Get(Url.SandboxRoute("PluginEcho", "ArrayManager"))
             .Gather(g => g
                 .Header("X-Array-Count", countForGather)
                 .Plugin(countForGather, "count"))
             .Response(r => r
                .OnSuccess<PluginArrayEchoResponse>((json, s) =>
                {
                    s.Element("arr-echo-count").SetText(json, x => x.ReceivedCount);
                    s.Element("arr-echo-header").SetText(json, x => x.ReceivedHeader);
                    s.Element("arr-echo-result").AddClass("text-green-600");
                    s.Plugin(analytics.Track).Arg("array-sent").Fire();
                }));
        });

    Html.NativeButton("arr-filter-btn", "Filter Active & Inspect")
        .Reactive(plan, evt => evt.Click, (args, p) =>
        {
            p.Get(Url.SandboxRoute("Residents", "ArrayManager"))
             .Response(r => r.OnSuccess<ResidentsListResponse>((json, s) =>
             {
                 TypedPluginSource<object> active = p.Plugin(array.Filter)
                     .Arg(json, x => x.Items).Arg("status").Arg("active");

                 TypedPluginSource<int> activeCount = p.Plugin(array.Count).Arg(active);
                 s.Element("arr-f-count").SetText(activeCount);

                 TypedPluginSource<int> activeAgeSum = p.Plugin(array.Sum).Arg(active).Arg("age");
                 s.Element("arr-f-age-sum").SetText(activeAgeSum);

                 TypedPluginSource<object> firstName = p.Plugin(array.Pluck)
                     .Arg(active).Arg(0).Arg("name");
                 s.Element("arr-f-first").SetText(firstName);

                 TypedPluginSource<bool> allActive = p.Plugin(array.Some)
                     .Arg(active).Arg("status").Arg("active");
                 s.Element("arr-f-some").SetText(allActive);

                 s.Element("arr-f-result").AddClass("text-green-600");

                 s.Plugin(analytics.Track).Arg("filter-inspect").Fire();
             }));
        });

}

<native-vstack gap="Lg">
    <native-heading level="H1">Array Plugin</native-heading>
    <native-text color="Secondary">
        Native JS array methods exposed to the DSL via plugin. Proves typed method, command, nested read, and root function patterns.
    </native-text>

    <native-card>
    <native-card-body>
        <native-heading level="H2">DomReady: Array Operations on Server Data</native-heading>
        <native-vstack gap="Sm" id="arr-results" class="font-mono text-sm text-text-muted">
            <p>Total: <span id="arr-total">—</span></p>
            <p>First Name: <span id="arr-first-name">—</span></p>
            <p>Active Count: <span id="arr-active-count">—</span></p>
            <p>Total Age: <span id="arr-total-age">—</span></p>
            <p>Root Function: <span id="arr-root-slug">—</span></p>
            <p id="arr-has-critical" hidden class="text-red-600">Critical residents found!</p>
            <p id="arr-no-critical" hidden class="text-green-600">No critical residents ✓</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">HTTP: Plugin Values in Gather + Header</native-heading>
        @(Html.NativeButton("arr-send-btn", "Send to Server")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors"))
        <native-vstack gap="Sm" id="arr-echo-result" class="mt-3 font-mono text-sm text-text-muted">
            <p>Count: <span id="arr-echo-count">—</span></p>
            <p>Header: <span id="arr-echo-header">—</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>


    <native-card>
    <native-card-body>
        <native-heading level="H2">Button: Filter Active — All 5 Methods + Conditions</native-heading>
        @(Html.NativeButton("arr-filter-btn", "Filter Active & Inspect")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors"))
        <native-vstack gap="Sm" id="arr-f-result" class="mt-3 font-mono text-sm text-text-muted">
            <p>Active Count: <span id="arr-f-count">—</span></p>
            <p>Active Age Sum: <span id="arr-f-age-sum">—</span></p>
            <p>First Active Name: <span id="arr-f-first">—</span></p>
            <p>Some Active: <span id="arr-f-some">—</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">Plan JSON</native-heading>
        <pre class="rounded-md bg-slate-900 text-emerald-400 p-4 font-mono text-xs overflow-x-auto"><code id="plan-json">@Html.Raw(plan.RenderFormatted())</code></pre>
    </native-card-body>
    </native-card>
</native-vstack>

@Html.RenderPlan(plan)

@functions {
    private sealed class ArrayPlugin : Plugin
    {
        public ArrayPlugin()
            : base("array")
        {
            Count = Function<int>("count").Arg<object>();
            Pluck = Function<object>("pluck").Arg<object>().Arg<int>().Arg<string>();
            Filter = Function<object>("filter").Arg<object>().Arg<string>().Arg<string>();
            Sum = Function<int>("sum").Arg<object>().Arg<string>();
            Some = Function<bool>("some").Arg<object>().Arg<string>().Arg<string>();
        }

        public PluginFunction<int> Count { get; }
        public PluginFunction<object> Pluck { get; }
        public PluginFunction<object> Filter { get; }
        public PluginFunction<int> Sum { get; }
        public PluginFunction<bool> Some { get; }
    }

    private sealed class AnalyticsPlugin : Plugin
    {
        public AnalyticsPlugin()
            : base("analytics")
        {
            Track = Command("track").Arg<string>();
        }

        public PluginCommand Track { get; }
    }

    private sealed class SlugifyPlugin : Plugin
    {
        public SlugifyPlugin()
            : base("slugify")
        {
            Slug = Function<string>().Arg<string>();
        }

        public PluginFunction<string> Slug { get; }
    }
}
