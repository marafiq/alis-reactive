@model ArrayManagerModel
@using Alis.Reactive
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Array Plugin";

    var plan = Html.ReactivePlan<ArrayManagerModel>();

    var array = plan.RegisterPlugin<ArrayPlugin>();
    var analytics = plan.RegisterPlugin<AnalyticsPlugin>();
    var slugify = plan.RegisterPlugin<SlugifyPlugin>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("Residents", "ArrayManager"))
         .Response(r => r.OnSuccess<ResidentsListResponse>((json, s) =>
         {
             TypedSource<int> countSrc = array.Count(json.Get(x => x.Items));
             s.Element("arr-total").Text.Set(countSrc);

             TypedSource<object> pluckSrc = array.Pluck(json.Get(x => x.Items), 0, "name");
             s.Element("arr-first-name").Text.Set(pluckSrc);

             TypedSource<object> filtered = array.Filter(json.Get(x => x.Items), "status", "active");
             TypedSource<int> activeCount = array.Count(filtered);
             s.Element("arr-active-count").Text.Set(activeCount);

             TypedSource<int> sumSrc = array.Sum(json.Get(x => x.Items), "age");
             s.Element("arr-total-age").Text.Set(sumSrc);

             TypedSource<bool> someSrc = array.Some(json.Get(x => x.Items), "status", "critical");
             s.When(someSrc).Truthy()
              .Then(then => then.Element("arr-has-critical").Show())
              .Else(els => els.Element("arr-no-critical").Show());

             TypedSource<string> slugSrc = slugify.Slug("John Doe");
             s.Element("arr-root-slug").Text.Set(slugSrc);

             s.Element("arr-results").ClassList.Add("text-green-600");
         }))));

    Html.NativeButton("arr-send-btn", "Send to Server")
        .Reactive(plan, evt => evt.Click, (args, p) =>
        {
            TypedSource<int> countForGather = array.Count("items");
            p.Get(Url.SandboxRoute("PluginEcho", "ArrayManager"))
             .Gather<PluginEchoQuery>(g => g
                 .Header("X-Array-Count", countForGather)
                 .Set(x => x.Count, countForGather))
             .Response(r => r
                .OnSuccess<PluginArrayEchoResponse>((json, s) =>
                {
                    s.Element("arr-echo-count").Text.Set(json.Get(x => x.ReceivedCount));
                    s.Element("arr-echo-header").Text.Set(json.Get(x => x.ReceivedHeader));
                    s.Element("arr-echo-result").ClassList.Add("text-green-600");
                    analytics.Track("array-sent");
                }));
        });

    Html.NativeButton("arr-filter-btn", "Filter Active & Inspect")
        .Reactive(plan, evt => evt.Click, (args, p) =>
        {
            p.Get(Url.SandboxRoute("Residents", "ArrayManager"))
             .Response(r => r.OnSuccess<ResidentsListResponse>((json, s) =>
             {
                 TypedSource<object> active = array.Filter(json.Get(x => x.Items), "status", "active");

                 TypedSource<int> activeCount = array.Count(active);
                 s.Element("arr-f-count").Text.Set(activeCount);

                 TypedSource<int> activeAgeSum = array.Sum(active, "age");
                 s.Element("arr-f-age-sum").Text.Set(activeAgeSum);

                 TypedSource<object> firstName = array.Pluck(active, 0, "name");
                 s.Element("arr-f-first").Text.Set(firstName);

                 TypedSource<bool> allActive = array.Some(active, "status", "active");
                 s.Element("arr-f-some").Text.Set(allActive);

                 s.Element("arr-f-result").ClassList.Add("text-green-600");

                 analytics.Track("filter-inspect");
             }));
        });

}

<native-vstack gap="Lg">
    <native-heading level="H1">Array Plugin</native-heading>
    <native-text color="Secondary">
        Native JS array methods exposed to the DSL via plugin. Proves typed method, command, nested read, and root function patterns.
    </native-text>

    <native-card>
    <native-card-body>
        <native-heading level="H2">DomReady: Array Operations on Server Data</native-heading>
        <native-vstack gap="Sm" id="arr-results" class="font-mono text-sm text-text-muted">
            <p>Total: <span id="arr-total">—</span></p>
            <p>First Name: <span id="arr-first-name">—</span></p>
            <p>Active Count: <span id="arr-active-count">—</span></p>
            <p>Total Age: <span id="arr-total-age">—</span></p>
            <p>Root Function: <span id="arr-root-slug">—</span></p>
            <p id="arr-has-critical" hidden class="text-red-600">Critical residents found!</p>
            <p id="arr-no-critical" hidden class="text-green-600">No critical residents ✓</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">HTTP: Plugin Values in Gather + Header</native-heading>
        @(Html.NativeButton("arr-send-btn", "Send to Server")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors"))
        <native-vstack gap="Sm" id="arr-echo-result" class="mt-3 font-mono text-sm text-text-muted">
            <p>Count: <span id="arr-echo-count">—</span></p>
            <p>Header: <span id="arr-echo-header">—</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>


    <native-card>
    <native-card-body>
        <native-heading level="H2">Button: Filter Active — All 5 Methods + Conditions</native-heading>
        @(Html.NativeButton("arr-filter-btn", "Filter Active & Inspect")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors"))
        <native-vstack gap="Sm" id="arr-f-result" class="mt-3 font-mono text-sm text-text-muted">
            <p>Active Count: <span id="arr-f-count">—</span></p>
            <p>Active Age Sum: <span id="arr-f-age-sum">—</span></p>
            <p>First Active Name: <span id="arr-f-first">—</span></p>
            <p>Some Active: <span id="arr-f-some">—</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">Plan JSON</native-heading>
        <pre class="rounded-md bg-slate-900 text-emerald-400 p-4 font-mono text-xs overflow-x-auto"><code id="plan-json">@Html.Raw(plan.RenderFormatted())</code></pre>
    </native-card-body>
    </native-card>
</native-vstack>

@Html.RenderPlan(plan)

@functions {
    private sealed class ArrayPlugin : Plugin
    {
        public ArrayPlugin()
            : base("array")
        {
        }

        public TypedSource<int> Count(Arg<object> items) => Invoke<int>(items);

        public TypedSource<object> Pluck(Arg<object> items, Arg<int> index, Arg<string> field) => Invoke<object>(items, index, field);

        public TypedSource<object> Filter(Arg<object> items, Arg<string> field, Arg<string> value) => Invoke<object>(items, field, value);

        public TypedSource<int> Sum(Arg<object> items, Arg<string> field) => Invoke<int>(items, field);

        public TypedSource<bool> Some(Arg<object> items, Arg<string> field, Arg<string> value) => Invoke<bool>(items, field, value);
    }

    private sealed class AnalyticsPlugin : Plugin
    {
        public AnalyticsPlugin()
            : base("analytics")
        {
        }

        public void Track(Arg<string> name) => Call(name);
    }

    private sealed class SlugifyPlugin : Plugin
    {
        public SlugifyPlugin()
            : base("slugify")
        {
        }

        public TypedSource<string> Slug(Arg<string> text) => Invoke<string>(text, name: "");
    }
}
