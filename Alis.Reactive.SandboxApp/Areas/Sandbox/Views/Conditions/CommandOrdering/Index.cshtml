@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.CommandOrdering.CommandOrderingModel
@using Alis.Reactive
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.CommandOrdering
@{
    ViewData["Title"] = "Command Ordering Around Conditions";

    var plan = Html.ReactivePlan<CommandOrderingModel>();

    // Declaration order matters across condition boundaries; the final SetText must win.
    Html.On(plan, t => t.CustomEvent<CommandOrderingPayload>("ordering-test", (args, p) =>
    {
        p.Element("proof").SetText("before");
        p.When(args, x => x.Level).Eq("high")
            .Then(then => then.Element("proof").SetText("conditional"));
        p.Element("proof").SetText("after");
    }));
}

<native-vstack gap="Base" class="p-6">
    <h1 class="text-xl font-bold text-text">Command Ordering Around Conditions</h1>

    <native-hstack gap="Sm">
        @(Html.NativeButton("btn-high", "Trigger with level=high")
            .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
                p.Dispatch("ordering-test", new CommandOrderingPayload { Level = "high" })))

        @(Html.NativeButton("btn-low", "Trigger with level=low")
            .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
                p.Dispatch("ordering-test", new CommandOrderingPayload { Level = "low" })))
    </native-hstack>

    <p class="font-mono text-sm text-text-muted">Proof element: <span id="proof">&mdash;</span></p>
</native-vstack>

@Html.RenderPlan(plan)
