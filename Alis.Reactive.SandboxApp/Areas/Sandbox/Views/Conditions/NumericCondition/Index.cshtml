@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.NumericCondition
@model NumericConditionModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Vital Signs";

    var plan = Html.ReactivePlan<NumericConditionModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Vital signs</native-heading>
        <native-text color="Secondary">Margaret Hale &middot; Room 214 &middot; morning check. Enter each reading as you take it.</native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Heart rate</native-heading>
        <native-grid cols="C2" gap="Base" class="mt-3">
            @{ Html.InputField(plan, m => m.HeartRate, o => o.Label("Heart Rate (bpm)"))
                .FusionNumericTextBox(b => b
                    .Min(0).Max(300).Step(1))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    var comp = p.Component<FusionNumericTextBox>(m => m.HeartRate);

                    p.When(comp.Value).Gt(100m)
                        .Then(then =>
                        {
                            then.Element("tachycardia-warning").Show();
                            then.Element("tachycardia-warning").Text.Set("Tachycardia detected");
                        })
                        .Else(else_ =>
                        {
                            else_.Element("tachycardia-warning").Hide();
                        });

                    p.When(comp.Value).Gte(120m)
                        .Then(t => t.Element("hr-zone").Text.Set("Critical"))
                        .ElseIf(comp.Value).Gte(100m)
                        .Then(t => t.Element("hr-zone").Text.Set("High"))
                        .ElseIf(comp.Value).Gte(60m)
                        .Then(t => t.Element("hr-zone").Text.Set("Normal"))
                        .Else(e => e.Element("hr-zone").Text.Set("Low"));
                }); }
        </native-grid>
        <p class="mt-2 text-sm">Zone: <span id="hr-zone" class="font-medium">&mdash;</span></p>
        <p id="tachycardia-warning" hidden class="mt-1 text-sm text-rose-600">&mdash;</p>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Blood pressure</native-heading>
        <native-grid cols="C2" gap="Base" class="mt-3">
            @{ Html.InputField(plan, m => m.BloodPressure, o => o.Label("Systolic BP (mmHg)"))
                .FusionNumericTextBox(b => b
                    .Min(0).Max(300).Step(1))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    var comp = p.Component<FusionNumericTextBox>(m => m.BloodPressure);
                    p.When(comp.Value).Gte(60m)
                        .And(comp.Value).Lte(120m)
                        .Then(then =>
                        {
                            then.Element("bp-range").Text.Set("Normal range");
                        })
                        .Else(else_ =>
                        {
                            else_.Element("bp-range").Text.Set("Out of range");
                        });
                }); }
        </native-grid>
        <p class="mt-2 text-sm">Systolic: <span id="bp-range" class="font-medium">&mdash;</span></p>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Care-plan heart rate limit</native-heading>
        <p class="text-sm text-text-secondary">Her care plan sets a heart rate limit. Check this morning's reading against it.</p>
        <native-grid cols="C2" gap="Base" class="mt-3">
            @{ Html.InputField(plan, m => m.ThresholdValue, o => o.Label("Care-plan limit (bpm)"))
                .FusionNumericTextBox(b => b
                    .Min(0).Max(300).Step(1)); }
        </native-grid>
        <native-hstack gap="None" class="mt-3">
            @(Html.NativeButton("check-threshold-btn", "Check against the limit")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var hr = p.Component<FusionNumericTextBox>(m => m.HeartRate);
                    var threshold = p.Component<FusionNumericTextBox>(m => m.ThresholdValue);
                    // A reading at or over the limit is taken again in 15 minutes.
                    p.When(hr.Value).Gte(threshold.Value)
                        .Then(t => t.Element("threshold-recheck").Text.Set("Recheck the heart rate in 15 minutes."))
                        .Else(e => e.Element("threshold-recheck").Text.Set("No recheck needed."));

                    // Where the reading sits against the resident's care-plan limit.
                    p.When(hr.Value).Gt(threshold.Value)
                        .Then(t => t.Element("threshold-band").Text.Set("Over the care-plan limit"))
                        .ElseIf(hr.Value).Lt(threshold.Value)
                        .Then(t => t.Element("threshold-band").Text.Set("Under the care-plan limit"))
                        .ElseIf(hr.Value).Eq(threshold.Value)
                        .Then(t => t.Element("threshold-band").Text.Set("At the care-plan limit"))
                        .Else(e => e.Element("threshold-band").Text.Set("No care-plan limit set"));

                    // A reading at the limit is still within it; only a reading over it calls the nurse.
                    p.When(hr.Value).Lte(threshold.Value)
                        .Then(t => t.Element("threshold-call").Text.Set("No nurse call needed"))
                        .Else(e => e.Element("threshold-call").Text.Set("Call the nurse"));
                }))
        </native-hstack>
        <p class="text-sm mt-2">Reading: <span id="threshold-band" class="font-medium">&mdash;</span></p>
        <p id="threshold-recheck" class="text-sm mt-1"></p>
        <p class="text-sm mt-1">Nurse call: <span id="threshold-call" class="font-medium">&mdash;</span></p>
    </native-card-body></native-card>

</native-vstack>

@Html.RenderPlan(plan)
