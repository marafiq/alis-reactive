@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.HttpMixing.HttpMixingModel
@using Alis.Reactive
@using Alis.Reactive.Builders.Conditions
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.HttpMixing
@{
    ViewData["Title"] = "Conditions + HTTP Mixing";

    var plan = Html.ReactivePlan<HttpMixingModel>();
    var slugify = plan.RegisterPlugin<HttpMixingSlugifyPlugin>();
    var order = plan.RegisterPlugin<HttpMixingOrderPlugin>();

    var saveUrl = Url.Action("Save", "HttpMixing", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve HttpMixing.Save.");
    var auditUrl = Url.Action("Audit", "HttpMixing", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve HttpMixing.Audit.");
    var classifyUrl = Url.Action("Classify", "HttpMixing", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve HttpMixing.Classify.");
    var failValidationUrl = Url.Action("FailValidation", "HttpMixing", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve HttpMixing.FailValidation.");
    var routeAuditUrl = Url.SandboxRouteTemplate("AuditResident", "HttpMixing", "residentId");
    var routeAuditTrailUrl = Url.SandboxRouteTemplate("AuditResidentTrail", "HttpMixing", "residentId", "categorySlug");

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s1-save-then-check", (args, p) =>
    {
        p.Post(saveUrl, g => g.Static("name", "Alice"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s1-status").SetText(json, x => x.ReceivedName);
         }));
        p.When(args, x => x.Active).Truthy()
            .Then(then => then.Element("s1-badge").Show())
            .Else(else_ => else_.Element("s1-badge").Hide());
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s2-condition-http-condition", (args, p) =>
    {
        p.When(args, x => x.Active).Truthy()
            .Then(then => then.Element("s2-active-status").SetText("active"))
            .Else(else_ => else_.Element("s2-active-status").SetText("inactive"));
        p.Post(auditUrl, g => g.Static("action", "login"))
         .Response(r => r.OnSuccess<HttpMixingAuditResponse>((json, s) =>
         {
             s.Element("s2-audit-result").SetText(json, x => x.Result);
         }));
        p.When(args, x => x.Count).Gt(0)
            .Then(then => then.Element("s2-count-badge").Show())
            .Else(else_ => else_.Element("s2-count-badge").Hide());
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s3-full-interleave", (args, p) =>
    {
        p.Element("s3-header").SetText("start");
        p.When(args, x => x.Active).Truthy()
            .Then(then => then.Element("s3-pre-badge").Show());
        p.Element("s3-loading").SetText("please wait");
        p.Post(saveUrl, g => g.Static("name", "Bob"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s3-http-result").SetText(json, x => x.ReceivedName);
         }));
        p.When(args, x => x.Count).Gt(0)
            .Then(then => then.Element("s3-count").Show())
            .Else(else_ => else_.Element("s3-count").Hide());
        p.Element("s3-footer").SetText("done");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s4-condition-inside-success", (args, p) =>
    {
        p.Element("s4-pre").SetText("loading");
        p.Post(saveUrl, g => g.Static("name", "Carol"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s4-status").SetText("saved");
             s.When(args, x => x.Active).Truthy()
                 .Then(then => then.Element("s4-inner-badge").Show())
                 .Else(else_ => else_.Element("s4-inner-badge").Hide());
             s.Element("s4-timestamp").SetText("now");
         }));
        p.Element("s4-footer").SetText("done");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s5-elseif-inside-success", (args, p) =>
    {
        p.Post(classifyUrl, g => g
            .FromEvent(args, x => x.Count, "count"))
         .Response(r => r.OnSuccess<HttpMixingClassifyResponse>((json, s) =>
         {
             s.Element("s5-server-tier").SetText(json, x => x.Tier);
             s.When(args, x => x.Count).Gt(100)
                 .Then(then => then.Element("s5-client-tier").SetText("gold"))
                 .ElseIf(args, x => x.Count).Gt(50)
                 .Then(then => then.Element("s5-client-tier").SetText("silver"))
                 .ElseIf(args, x => x.Count).Gt(10)
                 .Then(then => then.Element("s5-client-tier").SetText("bronze"))
                 .Else(else_ => else_.Element("s5-client-tier").SetText("none"));
         }));
        p.When(args, x => x.Active).Truthy()
            .Then(then => then.Element("s5-trial-badge").Hide())
            .Else(else_ => else_.Element("s5-trial-badge").Show());
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s6-multi-conditions-after-http", (args, p) =>
    {
        p.Post(saveUrl, g => g.Static("name", "Dave"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s6-saved").SetText(json, x => x.ReceivedName);
         }));
        p.When(args, x => x.Active).Truthy()
            .Then(then => then.Element("s6-active-badge").Show());
        p.When(args, x => x.Category).Eq("premium")
            .Then(then => then.Element("s6-premium-label").Show())
            .Else(else_ => else_.Element("s6-premium-label").Hide());
        p.Element("s6-footer").SetText("complete");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s7-condition-in-error", (args, p) =>
    {
        p.Post(failValidationUrl)
         .Response(r => r
             .OnSuccess(s => s.Element("s7-status").SetText("should not happen"))
             .OnError(400, e =>
             {
                 e.When(args, x => x.Category).Eq("required")
                     .Then(then => then.Element("s7-error-msg").SetText("missing required fields"))
                     .Else(else_ => else_.Element("s7-error-msg").SetText("validation error"));
             }));
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s8-and-guard-inside-success", (args, p) =>
    {
        p.Post(saveUrl, g => g.Static("name", "Eve"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s8-saved").SetText(json, x => x.ReceivedName);
             s.When(args, x => x.Active).Truthy()
                 .And(args, x => x.Count).Gt(5)
                 .Then(then => then.Element("s8-qualified").Show())
                 .Else(else_ => else_.Element("s8-qualified").Hide());
         }));
    }));

    Html.On(plan, t => t.CustomEvent("s12-dispatched", p =>
    {
        TypedPluginSource<string> mark = p.Plugin(order.Mark).Arg("s12").Arg("dispatch");
        p.Element("s12-sequence").SetText(mark);
        p.Element("s12-order").SetText("dispatch");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s12-ordered-mixed-modules", (args, p) =>
    {
        TypedPluginSource<string> markStart = p.Plugin(order.Mark).Arg("s12").Arg("start");
        p.Element("s12-sequence").SetText(markStart);
        p.Element("s12-order").SetText("start");
        p.When(args, x => x.Active).Truthy()
            .Then(then =>
            {
                TypedPluginSource<string> mark = then.Plugin(order.Mark).Arg("s12").Arg("branch-before");
                then.Element("s12-sequence").SetText(mark);
                then.Element("s12-order").SetText("branch-before");
            })
            .Else(else_ =>
            {
                TypedPluginSource<string> mark = else_.Plugin(order.Mark).Arg("s12").Arg("branch-before-else");
                else_.Element("s12-sequence").SetText(mark);
                else_.Element("s12-order").SetText("branch-before-else");
            });
        p.Post(saveUrl, g => g.Static("name", "Ordered"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s12-http-done").SetText("done");
             TypedPluginSource<string> mark = s.Plugin(order.Mark).Arg("s12").Arg("http-success");
             s.Element("s12-sequence").SetText(mark);
             s.Element("s12-order").SetText("http-success");
        }));
        p.Dispatch("s12-dispatched");
        TypedPluginSource<string> slug = p.Plugin(slugify.Slug).Arg("After Http");
        p.Element("s12-plugin").SetText(slug);
        TypedPluginSource<string> markPlugin = p.Plugin(order.Mark).Arg("s12").Arg("plugin");
        p.Element("s12-sequence").SetText(markPlugin);
        p.Element("s12-order").SetText("tail");
        TypedPluginSource<string> markTail = p.Plugin(order.Mark).Arg("s12").Arg("tail");
        p.Element("s12-sequence").SetText(markTail);
        p.When(args, x => x.Category).Eq("premium")
            .Then(then =>
            {
                TypedPluginSource<string> mark = then.Plugin(order.Mark).Arg("s12").Arg("branch-after");
                then.Element("s12-sequence").SetText(mark);
                then.Element("s12-order").SetText("branch-after");
            })
            .Else(else_ =>
            {
                TypedPluginSource<string> mark = else_.Plugin(order.Mark).Arg("s12").Arg("branch-after-else");
                else_.Element("s12-sequence").SetText(mark);
                else_.Element("s12-order").SetText("branch-after-else");
            });
    }));

    Html.On(plan, t => t.CustomEvent("s13-dispatched", p =>
    {
        TypedPluginSource<string> mark = p.Plugin(order.Mark).Arg("s13").Arg("dispatch");
        p.Element("s13-sequence").SetText(mark);
        p.Element("s13-order").SetText("dispatch");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s13-ordered-parallel-mix", (args, p) =>
    {
        TypedPluginSource<string> markStart = p.Plugin(order.Mark).Arg("s13").Arg("start");
        p.Element("s13-sequence").SetText(markStart);
        p.Element("s13-order").SetText("start");
        p.When(args, x => x.Active).Truthy()
            .Then(then =>
            {
                TypedPluginSource<string> mark = then.Plugin(order.Mark).Arg("s13").Arg("branch-before");
                then.Element("s13-sequence").SetText(mark);
                then.Element("s13-order").SetText("branch-before");
            })
            .Else(else_ =>
            {
                TypedPluginSource<string> mark = else_.Plugin(order.Mark).Arg("s13").Arg("branch-before-else");
                else_.Element("s13-sequence").SetText(mark);
                else_.Element("s13-order").SetText("branch-before-else");
            });
        p.Parallel(
            a => a.Post(saveUrl)
                  .Gather(g => g.Static("name", "Parallel A"))
                  .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
                  {
                      s.Element("s13-a").SetText(json, x => x.ReceivedName);
                  })),
            b => b.Post(auditUrl)
                  .Gather(g => g.Static("action", "parallel-b"))
                  .Response(r => r.OnSuccess<HttpMixingAuditResponse>((json, s) =>
                  {
                      s.Element("s13-b").SetText(json, x => x.Result);
                  })))
         .OnAllSettled(s =>
         {
             s.Element("s13-all").SetText("settled");
             TypedPluginSource<string> mark = s.Plugin(order.Mark).Arg("s13").Arg("settled");
             s.Element("s13-sequence").SetText(mark);
             s.Element("s13-order").SetText("settled");
         });
        p.Dispatch("s13-dispatched");
        TypedPluginSource<string> slug = p.Plugin(slugify.Slug).Arg("After Parallel");
        p.Element("s13-plugin").SetText(slug);
        TypedPluginSource<string> markPlugin = p.Plugin(order.Mark).Arg("s13").Arg("plugin");
        p.Element("s13-sequence").SetText(markPlugin);
        p.Element("s13-order").SetText("tail");
        TypedPluginSource<string> markTail = p.Plugin(order.Mark).Arg("s13").Arg("tail");
        p.Element("s13-sequence").SetText(markTail);
        p.When(args, x => x.Count).Gt(0)
            .Then(then =>
            {
                TypedPluginSource<string> mark = then.Plugin(order.Mark).Arg("s13").Arg("branch-after");
                then.Element("s13-sequence").SetText(mark);
                then.Element("s13-order").SetText("branch-after");
            })
            .Else(else_ =>
            {
                TypedPluginSource<string> mark = else_.Plugin(order.Mark).Arg("s13").Arg("branch-after-else");
                else_.Element("s13-sequence").SetText(mark);
                else_.Element("s13-order").SetText("branch-after-else");
            });
    }));

    Html.On(plan, t => t.CustomEvent("s14-dispatched", p =>
    {
        TypedPluginSource<string> mark = p.Plugin(order.Mark).Arg("s14").Arg("dispatch");
        p.Element("s14-sequence").SetText(mark);
        p.Element("s14-order").SetText("dispatch");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>("s14-route-template-from-event", (args, p) =>
    {
        TypedPluginSource<string> categorySlug = p.Plugin(slugify.Slug).Arg(args, x => x.Category);
        TypedPluginSource<string> markStart = p.Plugin(order.Mark).Arg("s14").Arg("start");
        p.Element("s14-sequence").SetText(markStart);
        p.Element("s14-order").SetText("start");
        p.When(args, x => x.Active).Truthy()
            .Then(then =>
            {
                TypedPluginSource<string> mark = then.Plugin(order.Mark).Arg("s14").Arg("branch-before");
                then.Element("s14-sequence").SetText(mark);
                then.Element("s14-order").SetText("branch-before");
            })
            .Else(else_ =>
            {
                TypedPluginSource<string> mark = else_.Plugin(order.Mark).Arg("s14").Arg("branch-before-else");
                else_.Element("s14-sequence").SetText(mark);
                else_.Element("s14-order").SetText("branch-before-else");
            });
        p.Post(routeAuditUrl, g => g
            .RouteParam("residentId", args, x => x.Count)
            .Header("X-Category", args, x => x.Category)
            .FromEvent(args, x => x.Category, "action"))
         .Response(r => r.OnSuccess<HttpMixingResidentAuditResponse>((json, s) =>
         {
             s.Element("s14-route-id").SetText(json, x => x.ResidentId);
             s.Element("s14-body-action").SetText(json, x => x.Action);
             s.Element("s14-header-category").SetText(json, x => x.HeaderCategory);
             TypedPluginSource<string> mark = s.Plugin(order.Mark).Arg("s14").Arg("http-success");
             s.Element("s14-sequence").SetText(mark);
             s.Element("s14-order").SetText("http-success");
         })
         .Chained(c => c
             .Post(routeAuditTrailUrl)
             .Gather(g => g
                 .RouteParam("residentId", args, x => x.Count)
                 .RouteParam("categorySlug", categorySlug))
             .Response(r => r.OnSuccess<HttpMixingAuditTrailResponse>((json, s) =>
             {
                 s.Element("s14-trail-id").SetText(json, x => x.ResidentId);
                 s.Element("s14-trail-slug").SetText(json, x => x.CategorySlug);
                 s.Element("s14-trail-step").SetText(json, x => x.Step);
                 TypedPluginSource<string> mark = s.Plugin(order.Mark).Arg("s14").Arg("trail-success");
                 s.Element("s14-sequence").SetText(mark);
                 s.Element("s14-order").SetText("trail-success");
             }))));
        p.Dispatch("s14-dispatched");
        p.Element("s14-plugin").SetText(categorySlug);
        TypedPluginSource<string> markPlugin = p.Plugin(order.Mark).Arg("s14").Arg("plugin");
        p.Element("s14-sequence").SetText(markPlugin);
        p.Element("s14-order").SetText("tail");
        p.When(args, x => x.Count).Gt(300)
            .Then(then =>
            {
                TypedPluginSource<string> mark = then.Plugin(order.Mark).Arg("s14").Arg("branch-after");
                then.Element("s14-sequence").SetText(mark);
                then.Element("s14-order").SetText("branch-after");
            })
            .Else(else_ =>
            {
                TypedPluginSource<string> mark = else_.Plugin(order.Mark).Arg("s14").Arg("branch-after-else");
                else_.Element("s14-sequence").SetText(mark);
                else_.Element("s14-order").SetText("branch-after-else");
            });
    }));

}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Conditions + HTTP Mixing</native-heading>
        <native-text color="Secondary">
            Exercises pipeline mode fix: conditions compose freely with HTTP blocks in both
            trigger-driven and real component <code>.Reactive()</code> flows.
            Each section mirrors condition, reaction-ordering, and response-handler test scenarios.
        </native-text>
    </div>

    <native-card>
    <native-card-body>
        <native-heading level="H2">1. Condition after HTTP</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST saves, then outer condition checks active flag.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s1-btn-active", "Save (active=true)")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s1-save-then-check", new HttpMixingPayload { Active = true })))
            @(Html.NativeButton("s1-btn-inactive", "Save (active=false)")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s1-save-then-check", new HttpMixingPayload { Active = false })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Saved: <span id="s1-status">&mdash;</span></p>
            <p id="s1-badge" hidden class="text-green-600 font-semibold">Active Badge</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">2. HTTP between two conditions</native-heading>
        <p class="text-sm text-text-secondary mb-3">Condition &rarr; POST audit &rarr; Condition. All three segments execute independently.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s2-btn-active-with-count", "active=true, count=5")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s2-condition-http-condition", new HttpMixingPayload { Active = true, Count = 5 })))
            @(Html.NativeButton("s2-btn-inactive-zero", "active=false, count=0")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s2-condition-http-condition", new HttpMixingPayload { Active = false, Count = 0 })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Active status: <span id="s2-active-status">&mdash;</span></p>
            <p>Audit: <span id="s2-audit-result">&mdash;</span></p>
            <p id="s2-count-badge" hidden class="text-blue-600 font-semibold">Count Badge</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">3. Full interleaving</native-heading>
        <p class="text-sm text-text-secondary mb-3">Reactions &rarr; Condition &rarr; Reactions &rarr; HTTP &rarr; Condition &rarr; Reactions.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s3-btn-all-true", "active=true, count=3")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s3-full-interleave", new HttpMixingPayload { Active = true, Count = 3 })))
            @(Html.NativeButton("s3-btn-all-false", "active=false, count=0")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s3-full-interleave", new HttpMixingPayload { Active = false, Count = 0 })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Header: <span id="s3-header">&mdash;</span></p>
            <p id="s3-pre-badge" hidden class="text-green-600 font-semibold">Pre-HTTP Badge</p>
            <p>Loading: <span id="s3-loading">&mdash;</span></p>
            <p>HTTP result: <span id="s3-http-result">&mdash;</span></p>
            <p id="s3-count" hidden class="text-blue-600 font-semibold">Count Visible</p>
            <p>Footer: <span id="s3-footer">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">4. Condition inside OnSuccess</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST &rarr; OnSuccess { SetText + When(active) + SetText }. Inner condition within response handler.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s4-btn-active", "active=true")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s4-condition-inside-success", new HttpMixingPayload { Active = true })))
            @(Html.NativeButton("s4-btn-inactive", "active=false")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s4-condition-inside-success", new HttpMixingPayload { Active = false })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Pre: <span id="s4-pre">&mdash;</span></p>
            <p>Status: <span id="s4-status">&mdash;</span></p>
            <p id="s4-inner-badge" hidden class="text-green-600 font-semibold">Inner Active Badge</p>
            <p>Timestamp: <span id="s4-timestamp">&mdash;</span></p>
            <p>Footer: <span id="s4-footer">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">5. ElseIf inside OnSuccess + outer condition</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST classify &rarr; OnSuccess { ElseIf tier ladder } &rarr; outer When(active).</p>
        <native-hstack gap="Sm" wrap="true" class="mb-3">
            @(Html.NativeButton("s5-btn-enterprise", "count=200, active=true")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s5-elseif-inside-success", new HttpMixingPayload { Count = 200, Active = true })))
            @(Html.NativeButton("s5-btn-business", "count=75, active=true")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s5-elseif-inside-success", new HttpMixingPayload { Count = 75, Active = true })))
            @(Html.NativeButton("s5-btn-team", "count=25, active=false")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s5-elseif-inside-success", new HttpMixingPayload { Count = 25, Active = false })))
            @(Html.NativeButton("s5-btn-individual", "count=3, active=false")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s5-elseif-inside-success", new HttpMixingPayload { Count = 3, Active = false })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Server tier: <span id="s5-server-tier">&mdash;</span></p>
            <p>Client tier: <span id="s5-client-tier">&mdash;</span></p>
            <p id="s5-trial-badge" class="text-amber-600 font-semibold">Trial Badge</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">6. Multiple conditions after HTTP</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST &rarr; When(active) &rarr; When(category=="premium") &rarr; SetText.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s6-btn-active-premium", "active, premium")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s6-multi-conditions-after-http", new HttpMixingPayload { Active = true, Category = "premium" })))
            @(Html.NativeButton("s6-btn-active-standard", "active, standard")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s6-multi-conditions-after-http", new HttpMixingPayload { Active = true, Category = "standard" })))
            @(Html.NativeButton("s6-btn-inactive-premium", "inactive, premium")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s6-multi-conditions-after-http", new HttpMixingPayload { Active = false, Category = "premium" })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Saved: <span id="s6-saved">&mdash;</span></p>
            <p id="s6-active-badge" hidden class="text-green-600 font-semibold">Active Badge</p>
            <p id="s6-premium-label" hidden class="text-purple-600 font-semibold">Premium</p>
            <p>Footer: <span id="s6-footer">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">7. Condition inside OnError handler</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST fails &rarr; OnError(400) { When(category=="required") &rarr; specific error message }.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s7-btn-required", "category=required")
                .CssClass("rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s7-condition-in-error", new HttpMixingPayload { Category = "required" })))
            @(Html.NativeButton("s7-btn-other", "category=format")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s7-condition-in-error", new HttpMixingPayload { Category = "format" })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Status: <span id="s7-status">&mdash;</span></p>
            <p>Error: <span id="s7-error-msg">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">8. And guard inside OnSuccess</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST &rarr; OnSuccess { When(active).And(count &gt; 5) &rarr; Show/Hide }.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s8-btn-qualified", "active=true, count=10")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s8-and-guard-inside-success", new HttpMixingPayload { Active = true, Count = 10 })))
            @(Html.NativeButton("s8-btn-not-qualified", "active=true, count=2")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s8-and-guard-inside-success", new HttpMixingPayload { Active = true, Count = 2 })))
            @(Html.NativeButton("s8-btn-inactive", "active=false, count=10")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s8-and-guard-inside-success", new HttpMixingPayload { Active = false, Count = 10 })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Saved: <span id="s8-saved">&mdash;</span></p>
            <p id="s8-qualified" hidden class="text-green-600 font-semibold">Qualified!</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">12. Ordered mixed modules around HTTP</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Branch, HTTP, dispatch, plugin source, element reactions, and a second branch run in declaration order.
        </p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s12-btn-run", "run ordered mix")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s12-ordered-mixed-modules", new HttpMixingPayload { Active = true, Category = "premium" })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>HTTP: <span id="s12-http-done">&mdash;</span></p>
            <p>Plugin: <span id="s12-plugin">&mdash;</span></p>
            <p>Order: <span id="s12-order">&mdash;</span></p>
            <p>Sequence: <span id="s12-sequence">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">13. Ordered mixed modules around parallel HTTP</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Branch, parallel HTTP, all-settled handlers, dispatch, plugin source, and tail branch preserve declaration order.
        </p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s13-btn-run", "run parallel mix")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s13-ordered-parallel-mix", new HttpMixingPayload { Active = true, Category = "premium", Count = 7 })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>A: <span id="s13-a">&mdash;</span></p>
            <p>B: <span id="s13-b">&mdash;</span></p>
            <p>All: <span id="s13-all">&mdash;</span></p>
            <p>Plugin: <span id="s13-plugin">&mdash;</span></p>
            <p>Order: <span id="s13-order">&mdash;</span></p>
            <p>Sequence: <span id="s13-sequence">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">14. Route-template gather from reactive event payload</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Branch, route-template POST, header/body gather, dispatch, plugin source, and tail branch all read the same typed event payload.
        </p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s14-btn-active-high", "event resident 314")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s14-route-template-from-event", new HttpMixingPayload { Active = true, Count = 314, Category = "VIP Review" })))
            @(Html.NativeButton("s14-btn-inactive-low", "event resident 271")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch("s14-route-template-from-event", new HttpMixingPayload { Active = false, Count = 271, Category = "Routine Check" })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Route ID: <span id="s14-route-id">&mdash;</span></p>
            <p>Body action: <span id="s14-body-action">&mdash;</span></p>
            <p>Header category: <span id="s14-header-category">&mdash;</span></p>
            <p>Trail ID: <span id="s14-trail-id">&mdash;</span></p>
            <p>Trail slug: <span id="s14-trail-slug">&mdash;</span></p>
            <p>Trail step: <span id="s14-trail-step">&mdash;</span></p>
            <p>Plugin: <span id="s14-plugin">&mdash;</span></p>
            <p>Order: <span id="s14-order">&mdash;</span></p>
            <p>Sequence: <span id="s14-sequence">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">9. Reactive input with HTTP between shared reactions and an outer condition</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Type a resident name, blur the field, and the real component <code>.Reactive()</code> path will run:
            pre-reaction &rarr; POST echo &rarr; outer <code>When/Then/Else</code> &rarr; tail reaction.
        </p>
        <native-grid cols="C2" gap="Base" class="mb-3">
            @{
                Html.InputField(plan, m => m.ReactiveResidentName, o => o.Label("Resident Name"))
                    .NativeTextBox(b => b
                        .Placeholder("Type VIP Alice or Bob")
                        .Reactive(plan, evt => evt.Changed, (args, p) =>
                        {
                            p.Element("s9-pre").SetText("saving");
                            p.Post(saveUrl, g => g
                                .FromEvent(args, x => x.Value!, "name"))
                             .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
                             {
                                 s.Element("s9-http-result").SetText(json, x => x.ReceivedName);
                             }));
                            p.When(args, x => x.Value!).Contains("VIP")
                                .Then(then => then.Element("s9-badge").Show())
                                .Else(else_ => else_.Element("s9-badge").Hide());
                            p.Element("s9-tail").SetText("complete");
                        }));
            }
        </native-grid>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Pre: <span id="s9-pre">&mdash;</span></p>
            <p>HTTP result: <span id="s9-http-result">&mdash;</span></p>
            <p id="s9-badge" hidden class="text-green-600 font-semibold">VIP Badge</p>
            <p>Tail: <span id="s9-tail">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">10. Reactive input with condition inside OnSuccess</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Type a follow-up label and blur. The component change posts to the server, then
            <code>OnSuccess</code> runs shared reactions around an inner <code>When/Then/Else</code>.
        </p>
        <native-grid cols="C2" gap="Base" class="mb-3">
            @{
                Html.InputField(plan, m => m.ReactiveFollowUpName, o => o.Label("Follow-up Label"))
                    .NativeTextBox(b => b
                        .Placeholder("Type a long or short label")
                        .Reactive(plan, evt => evt.Changed, (args, p) =>
                        {
                            p.Element("s10-pre").SetText("loading");
                            p.Post(saveUrl, g => g
                                .FromEvent(args, x => x.Value!, "name"))
                             .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
                             {
                                 s.Element("s10-http-result").SetText(json, x => x.ReceivedName);
                                 s.When(args, x => x.Value!).MinLength(5)
                                     .Then(then => then.Element("s10-classification").SetText("long name"))
                                     .Else(else_ => else_.Element("s10-classification").SetText("short name"));
                                 s.Element("s10-tail").SetText("success complete");
                             }));
                        }));
            }
        </native-grid>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Pre: <span id="s10-pre">&mdash;</span></p>
            <p>HTTP result: <span id="s10-http-result">&mdash;</span></p>
            <p>Classification: <span id="s10-classification">&mdash;</span></p>
            <p>Tail: <span id="s10-tail">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">11. Reactive input with condition inside OnError</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Type an error category and blur. The component change triggers a failing POST, then
            <code>OnError(400)</code> evaluates the supported condition DSL inside the response handler.
        </p>
        <native-grid cols="C2" gap="Base" class="mb-3">
            @{
                Html.InputField(plan, m => m.ReactiveErrorCategory, o => o.Label("Error Category"))
                    .NativeTextBox(b => b
                        .Placeholder("Type required or format")
                        .Reactive(plan, evt => evt.Changed, (args, p) =>
                        {
                            p.Element("s11-pre").SetText("validating");
                            p.Post(failValidationUrl)
                             .Response(r => r
                                 .OnSuccess(s => s.Element("s11-status").SetText("should not happen"))
                                 .OnError(400, e =>
                                 {
                                     e.Element("s11-status").SetText("failed");
                                     e.When(args, x => x.Value!).Eq("required")
                                         .Then(then => then.Element("s11-error-msg").SetText("missing required fields"))
                                         .Else(else_ => else_.Element("s11-error-msg").SetText("validation error"));
                                     e.Element("s11-tail").SetText("error complete");
                                 }));
                        }));
            }
        </native-grid>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Pre: <span id="s11-pre">&mdash;</span></p>
            <p>Status: <span id="s11-status">&mdash;</span></p>
            <p>Error: <span id="s11-error-msg">&mdash;</span></p>
            <p>Tail: <span id="s11-tail">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>
</native-vstack>

@Html.RenderPlan(plan)

@functions {
    private sealed class HttpMixingSlugifyPlugin : Plugin
    {
        public HttpMixingSlugifyPlugin()
            : base("slugify")
        {
            Slug = Function<string>().Arg<string>();
        }

        public PluginFunction<string> Slug { get; }
    }

    private sealed class HttpMixingOrderPlugin : Plugin
    {
        public HttpMixingOrderPlugin()
            : base("order")
        {
            Mark = Function<string>().Arg<string>().Arg<string>();
        }

        public PluginFunction<string> Mark { get; }
    }
}
