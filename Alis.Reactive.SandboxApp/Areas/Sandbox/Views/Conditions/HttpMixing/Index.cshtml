@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.HttpMixing.HttpMixingModel
@using Alis.Reactive
@using Alis.Reactive.Native.Components
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.HttpMixing
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Controllers.Conditions
@{
    ViewData["Title"] = "Conditions + HTTP Mixing";

    var plan = Html.ReactivePlan<HttpMixingModel>();
    var slugify = plan.RegisterPlugin<HttpMixingSlugifyPlugin>();
    var order = plan.RegisterPlugin<HttpMixingOrderPlugin>();

    var saveUrl = Url.Action("Save", "HttpMixing", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve HttpMixing.Save.");
    var auditUrl = Url.Action("Audit", "HttpMixing", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve HttpMixing.Audit.");
    var classifyUrl = Url.Action("Classify", "HttpMixing", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve HttpMixing.Classify.");
    var failValidationUrl = Url.Action("FailValidation", "HttpMixing", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve HttpMixing.FailValidation.");
    var routeAuditUrl = Url.SandboxRouteTemplate("AuditResident", "HttpMixing", "residentId");
    var routeAuditTrailUrl = Url.SandboxRouteTemplate("AuditResidentTrail", "HttpMixing", "residentId", "categorySlug");

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S1SaveThenCheck, (args, p) =>
    {
        p.Post(saveUrl).Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, "Alice"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s1-status").Text.Set(json.Get(x => x.ReceivedName));
         }));
        p.When(args.Get(x => x.Active)).Truthy()
            .Then(then => then.Element("s1-badge").Show())
            .Else(else_ => else_.Element("s1-badge").Hide());
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S2ConditionHttpCondition, (args, p) =>
    {
        p.When(args.Get(x => x.Active)).Truthy()
            .Then(then => then.Element("s2-active-status").Text.Set("active"))
            .Else(else_ => else_.Element("s2-active-status").Text.Set("inactive"));
        p.Post(auditUrl).Gather<HttpMixingController.AuditRequest>(g => g.Set(x => x.Action, "login"))
         .Response(r => r.OnSuccess<HttpMixingAuditResponse>((json, s) =>
         {
             s.Element("s2-audit-result").Text.Set(json.Get(x => x.Result));
         }));
        p.When(args.Get(x => x.Count)).Gt(0)
            .Then(then => then.Element("s2-count-badge").Show())
            .Else(else_ => else_.Element("s2-count-badge").Hide());
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S3FullInterleave, (args, p) =>
    {
        p.Element("s3-header").Text.Set("start");
        p.When(args.Get(x => x.Active)).Truthy()
            .Then(then => then.Element("s3-pre-badge").Show());
        p.Element("s3-loading").Text.Set("please wait");
        p.Post(saveUrl).Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, "Bob"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s3-http-result").Text.Set(json.Get(x => x.ReceivedName));
         }));
        p.When(args.Get(x => x.Count)).Gt(0)
            .Then(then => then.Element("s3-count").Show())
            .Else(else_ => else_.Element("s3-count").Hide());
        p.Element("s3-footer").Text.Set("done");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S4ConditionInsideSuccess, (args, p) =>
    {
        p.Element("s4-pre").Text.Set("loading");
        p.Post(saveUrl).Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, "Carol"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s4-status").Text.Set("saved");
             s.When(args.Get(x => x.Active)).Truthy()
                 .Then(then => then.Element("s4-inner-badge").Show())
                 .Else(else_ => else_.Element("s4-inner-badge").Hide());
             s.Element("s4-timestamp").Text.Set("now");
         }));
        p.Element("s4-footer").Text.Set("done");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S5ElseifInsideSuccess, (args, p) =>
    {
        p.Post(classifyUrl)
         .Gather<HttpMixingController.ClassifyRequest>(g => g.Set(x => x.Count, args.Get(a => a.Count)))
         .Response(r => r.OnSuccess<HttpMixingClassifyResponse>((json, s) =>
         {
             s.Element("s5-server-tier").Text.Set(json.Get(x => x.Tier));
             s.When(args.Get(x => x.Count)).Gt(100)
                 .Then(then => then.Element("s5-client-tier").Text.Set("gold"))
                 .ElseIf(args.Get(x => x.Count)).Gt(50)
                 .Then(then => then.Element("s5-client-tier").Text.Set("silver"))
                 .ElseIf(args.Get(x => x.Count)).Gt(10)
                 .Then(then => then.Element("s5-client-tier").Text.Set("bronze"))
                 .Else(else_ => else_.Element("s5-client-tier").Text.Set("none"));
         }));
        p.When(args.Get(x => x.Active)).Truthy()
            .Then(then => then.Element("s5-trial-badge").Hide())
            .Else(else_ => else_.Element("s5-trial-badge").Show());
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S6MultiConditionsAfterHttp, (args, p) =>
    {
        p.Post(saveUrl).Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, "Dave"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s6-saved").Text.Set(json.Get(x => x.ReceivedName));
         }));
        p.When(args.Get(x => x.Active)).Truthy()
            .Then(then => then.Element("s6-active-badge").Show());
        p.When(args.Get(x => x.Category)).Eq("premium")
            .Then(then => then.Element("s6-premium-label").Show())
            .Else(else_ => else_.Element("s6-premium-label").Hide());
        p.Element("s6-footer").Text.Set("complete");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S7ConditionInError, (args, p) =>
    {
        p.Post(failValidationUrl)
         .Response(r => r
             .OnSuccess(s => s.Element("s7-status").Text.Set("should not happen"))
             .OnError(400, e =>
             {
                 e.When(args.Get(x => x.Category)).Eq("required")
                     .Then(then => then.Element("s7-error-msg").Text.Set("missing required fields"))
                     .Else(else_ => else_.Element("s7-error-msg").Text.Set("validation error"));
             }));
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S8AndGuardInsideSuccess, (args, p) =>
    {
        p.Post(saveUrl).Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, "Eve"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s8-saved").Text.Set(json.Get(x => x.ReceivedName));
             s.When(args.Get(x => x.Active)).Truthy()
                 .And(args.Get(x => x.Count)).Gt(5)
                 .Then(then => then.Element("s8-qualified").Show())
                 .Else(else_ => else_.Element("s8-qualified").Hide());
         }));
    }));

    Html.On(plan, t => t.CustomEvent(HttpMixingEvents.S12Dispatched, p =>
    {
        TypedSource<string> mark = order.Mark("s12", "dispatch");
        p.Element("s12-sequence").Text.Set(mark);
        p.Element("s12-order").Text.Set("dispatch");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S12OrderedMixedModules, (args, p) =>
    {
        TypedSource<string> markStart = order.Mark("s12", "start");
        p.Element("s12-sequence").Text.Set(markStart);
        p.Element("s12-order").Text.Set("start");
        p.When(args.Get(x => x.Active)).Truthy()
            .Then(then =>
            {
                TypedSource<string> mark = order.Mark("s12", "branch-before");
                then.Element("s12-sequence").Text.Set(mark);
                then.Element("s12-order").Text.Set("branch-before");
            })
            .Else(else_ =>
            {
                TypedSource<string> mark = order.Mark("s12", "branch-before-else");
                else_.Element("s12-sequence").Text.Set(mark);
                else_.Element("s12-order").Text.Set("branch-before-else");
            });
        p.Post(saveUrl).Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, "Ordered"))
         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
         {
             s.Element("s12-http-done").Text.Set("done");
             TypedSource<string> mark = order.Mark("s12", "http-success");
             s.Element("s12-sequence").Text.Set(mark);
             s.Element("s12-order").Text.Set("http-success");
        }));
        p.Dispatch(HttpMixingEvents.S12Dispatched);
        TypedSource<string> slug = slugify.Slug("After Http");
        p.Element("s12-plugin").Text.Set(slug);
        TypedSource<string> markPlugin = order.Mark("s12", "plugin");
        p.Element("s12-sequence").Text.Set(markPlugin);
        p.Element("s12-order").Text.Set("tail");
        TypedSource<string> markTail = order.Mark("s12", "tail");
        p.Element("s12-sequence").Text.Set(markTail);
        p.When(args.Get(x => x.Category)).Eq("premium")
            .Then(then =>
            {
                TypedSource<string> mark = order.Mark("s12", "branch-after");
                then.Element("s12-sequence").Text.Set(mark);
                then.Element("s12-order").Text.Set("branch-after");
            })
            .Else(else_ =>
            {
                TypedSource<string> mark = order.Mark("s12", "branch-after-else");
                else_.Element("s12-sequence").Text.Set(mark);
                else_.Element("s12-order").Text.Set("branch-after-else");
            });
    }));

    Html.On(plan, t => t.CustomEvent(HttpMixingEvents.S13Dispatched, p =>
    {
        TypedSource<string> mark = order.Mark("s13", "dispatch");
        p.Element("s13-sequence").Text.Set(mark);
        p.Element("s13-order").Text.Set("dispatch");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S13OrderedParallelMix, (args, p) =>
    {
        TypedSource<string> markStart = order.Mark("s13", "start");
        p.Element("s13-sequence").Text.Set(markStart);
        p.Element("s13-order").Text.Set("start");
        p.When(args.Get(x => x.Active)).Truthy()
            .Then(then =>
            {
                TypedSource<string> mark = order.Mark("s13", "branch-before");
                then.Element("s13-sequence").Text.Set(mark);
                then.Element("s13-order").Text.Set("branch-before");
            })
            .Else(else_ =>
            {
                TypedSource<string> mark = order.Mark("s13", "branch-before-else");
                else_.Element("s13-sequence").Text.Set(mark);
                else_.Element("s13-order").Text.Set("branch-before-else");
            });
        p.Parallel(
            a => a.Post(saveUrl)
                  .Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, "Parallel A"))
                  .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
                  {
                      s.Element("s13-a").Text.Set(json.Get(x => x.ReceivedName));
                  })),
            b => b.Post(auditUrl)
                  .Gather<HttpMixingController.AuditRequest>(g => g.Set(x => x.Action, "parallel-b"))
                  .Response(r => r.OnSuccess<HttpMixingAuditResponse>((json, s) =>
                  {
                      s.Element("s13-b").Text.Set(json.Get(x => x.Result));
                  })))
         .OnAllSettled(s =>
         {
             s.Element("s13-all").Text.Set("settled");
             TypedSource<string> mark = order.Mark("s13", "settled");
             s.Element("s13-sequence").Text.Set(mark);
             s.Element("s13-order").Text.Set("settled");
         });
        p.Dispatch(HttpMixingEvents.S13Dispatched);
        TypedSource<string> slug = slugify.Slug("After Parallel");
        p.Element("s13-plugin").Text.Set(slug);
        TypedSource<string> markPlugin = order.Mark("s13", "plugin");
        p.Element("s13-sequence").Text.Set(markPlugin);
        p.Element("s13-order").Text.Set("tail");
        TypedSource<string> markTail = order.Mark("s13", "tail");
        p.Element("s13-sequence").Text.Set(markTail);
        p.When(args.Get(x => x.Count)).Gt(0)
            .Then(then =>
            {
                TypedSource<string> mark = order.Mark("s13", "branch-after");
                then.Element("s13-sequence").Text.Set(mark);
                then.Element("s13-order").Text.Set("branch-after");
            })
            .Else(else_ =>
            {
                TypedSource<string> mark = order.Mark("s13", "branch-after-else");
                else_.Element("s13-sequence").Text.Set(mark);
                else_.Element("s13-order").Text.Set("branch-after-else");
            });
    }));

    Html.On(plan, t => t.CustomEvent(HttpMixingEvents.S14Dispatched, p =>
    {
        TypedSource<string> mark = order.Mark("s14", "dispatch");
        p.Element("s14-sequence").Text.Set(mark);
        p.Element("s14-order").Text.Set("dispatch");
    }));

    Html.On(plan, t => t.CustomEvent<HttpMixingPayload>(HttpMixingEvents.S14RouteTemplateFromPayload, (args, p) =>
    {
        TypedSource<string> categorySlug = slugify.Slug(args.Get(x => x.Category));
        TypedSource<string> markStart = order.Mark("s14", "start");
        p.Element("s14-sequence").Text.Set(markStart);
        p.Element("s14-order").Text.Set("start");
        p.When(args.Get(x => x.Active)).Truthy()
            .Then(then =>
            {
                TypedSource<string> mark = order.Mark("s14", "branch-before");
                then.Element("s14-sequence").Text.Set(mark);
                then.Element("s14-order").Text.Set("branch-before");
            })
            .Else(else_ =>
            {
                TypedSource<string> mark = order.Mark("s14", "branch-before-else");
                else_.Element("s14-sequence").Text.Set(mark);
                else_.Element("s14-order").Text.Set("branch-before-else");
            });
        p.Post(routeAuditUrl)
         .Gather<HttpMixingController.ResidentAuditRequest>(g => g
            .Set(x => x.ResidentId, args.Get(a => a.Count))
            .Header("X-Category", args.Get(a => a.Category))
            .Set(x => x.Action, args.Get(a => a.Category)))
         .Response(r => r.OnSuccess<HttpMixingResidentAuditResponse>((json, s) =>
         {
             s.Element("s14-route-id").Text.Set(json.Get(x => x.ResidentId));
             s.Element("s14-body-action").Text.Set(json.Get(x => x.Action));
             s.Element("s14-header-category").Text.Set(json.Get(x => x.HeaderCategory));
             TypedSource<string> mark = order.Mark("s14", "http-success");
             s.Element("s14-sequence").Text.Set(mark);
             s.Element("s14-order").Text.Set("http-success");
         })
         .Chained(c => c
             .Post(routeAuditTrailUrl)
             .Gather<ResidentAuditTrail>(g => g
                 .Set(x => x.ResidentId, args.Get(a => a.Count))
                 .Set(x => x.CategorySlug, categorySlug))
             .Response(r => r.OnSuccess<HttpMixingAuditTrailResponse>((json, s) =>
             {
                 s.Element("s14-trail-id").Text.Set(json.Get(x => x.ResidentId));
                 s.Element("s14-trail-slug").Text.Set(json.Get(x => x.CategorySlug));
                 s.Element("s14-trail-step").Text.Set(json.Get(x => x.Step));
                 TypedSource<string> mark = order.Mark("s14", "trail-success");
                 s.Element("s14-sequence").Text.Set(mark);
                 s.Element("s14-order").Text.Set("trail-success");
             }))));
        p.Dispatch(HttpMixingEvents.S14Dispatched);
        p.Element("s14-plugin").Text.Set(categorySlug);
        TypedSource<string> markPlugin = order.Mark("s14", "plugin");
        p.Element("s14-sequence").Text.Set(markPlugin);
        p.Element("s14-order").Text.Set("tail");
        p.When(args.Get(x => x.Count)).Gt(300)
            .Then(then =>
            {
                TypedSource<string> mark = order.Mark("s14", "branch-after");
                then.Element("s14-sequence").Text.Set(mark);
                then.Element("s14-order").Text.Set("branch-after");
            })
            .Else(else_ =>
            {
                TypedSource<string> mark = order.Mark("s14", "branch-after-else");
                else_.Element("s14-sequence").Text.Set(mark);
                else_.Element("s14-order").Text.Set("branch-after-else");
            });
    }));

}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Conditions + HTTP Mixing</native-heading>
        <native-text color="Secondary">
            Exercises pipeline mode fix: conditions compose freely with HTTP blocks in both
            trigger-driven and real component <code>.Reactive()</code> flows.
            Each section mirrors condition, reaction-ordering, and response-handler test scenarios.
        </native-text>
    </div>

    <native-card>
    <native-card-body>
        <native-heading level="H2">1. Condition after HTTP</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST saves, then outer condition checks active flag.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s1-btn-active", "Save (active=true)")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S1SaveThenCheck, new HttpMixingPayload { Active = true })))
            @(Html.NativeButton("s1-btn-inactive", "Save (active=false)")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S1SaveThenCheck, new HttpMixingPayload { Active = false })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Saved: <span id="s1-status">&mdash;</span></p>
            <p id="s1-badge" hidden class="text-green-600 font-semibold">Active Badge</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">2. HTTP between two conditions</native-heading>
        <p class="text-sm text-text-secondary mb-3">Condition &rarr; POST audit &rarr; Condition. All three segments execute independently.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s2-btn-active-with-count", "active=true, count=5")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S2ConditionHttpCondition, new HttpMixingPayload { Active = true, Count = 5 })))
            @(Html.NativeButton("s2-btn-inactive-zero", "active=false, count=0")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S2ConditionHttpCondition, new HttpMixingPayload { Active = false, Count = 0 })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Active status: <span id="s2-active-status">&mdash;</span></p>
            <p>Audit: <span id="s2-audit-result">&mdash;</span></p>
            <p id="s2-count-badge" hidden class="text-blue-600 font-semibold">Count Badge</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">3. Full interleaving</native-heading>
        <p class="text-sm text-text-secondary mb-3">Reactions &rarr; Condition &rarr; Reactions &rarr; HTTP &rarr; Condition &rarr; Reactions.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s3-btn-all-true", "active=true, count=3")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S3FullInterleave, new HttpMixingPayload { Active = true, Count = 3 })))
            @(Html.NativeButton("s3-btn-all-false", "active=false, count=0")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S3FullInterleave, new HttpMixingPayload { Active = false, Count = 0 })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Header: <span id="s3-header">&mdash;</span></p>
            <p id="s3-pre-badge" hidden class="text-green-600 font-semibold">Pre-HTTP Badge</p>
            <p>Loading: <span id="s3-loading">&mdash;</span></p>
            <p>HTTP result: <span id="s3-http-result">&mdash;</span></p>
            <p id="s3-count" hidden class="text-blue-600 font-semibold">Count Visible</p>
            <p>Footer: <span id="s3-footer">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">4. Condition inside OnSuccess</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST &rarr; OnSuccess { SetText + When(active) + SetText }. Inner condition within response handler.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s4-btn-active", "active=true")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S4ConditionInsideSuccess, new HttpMixingPayload { Active = true })))
            @(Html.NativeButton("s4-btn-inactive", "active=false")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S4ConditionInsideSuccess, new HttpMixingPayload { Active = false })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Pre: <span id="s4-pre">&mdash;</span></p>
            <p>Status: <span id="s4-status">&mdash;</span></p>
            <p id="s4-inner-badge" hidden class="text-green-600 font-semibold">Inner Active Badge</p>
            <p>Timestamp: <span id="s4-timestamp">&mdash;</span></p>
            <p>Footer: <span id="s4-footer">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">5. ElseIf inside OnSuccess + outer condition</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST classify &rarr; OnSuccess { ElseIf tier ladder } &rarr; outer When(active).</p>
        <native-hstack gap="Sm" wrap="true" class="mb-3">
            @(Html.NativeButton("s5-btn-enterprise", "count=200, active=true")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S5ElseifInsideSuccess, new HttpMixingPayload { Count = 200, Active = true })))
            @(Html.NativeButton("s5-btn-business", "count=75, active=true")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S5ElseifInsideSuccess, new HttpMixingPayload { Count = 75, Active = true })))
            @(Html.NativeButton("s5-btn-team", "count=25, active=false")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S5ElseifInsideSuccess, new HttpMixingPayload { Count = 25, Active = false })))
            @(Html.NativeButton("s5-btn-individual", "count=3, active=false")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S5ElseifInsideSuccess, new HttpMixingPayload { Count = 3, Active = false })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Server tier: <span id="s5-server-tier">&mdash;</span></p>
            <p>Client tier: <span id="s5-client-tier">&mdash;</span></p>
            <p id="s5-trial-badge" class="text-amber-600 font-semibold">Trial Badge</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">6. Multiple conditions after HTTP</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST &rarr; When(active) &rarr; When(category=="premium") &rarr; SetText.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s6-btn-active-premium", "active, premium")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S6MultiConditionsAfterHttp, new HttpMixingPayload { Active = true, Category = "premium" })))
            @(Html.NativeButton("s6-btn-active-standard", "active, standard")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S6MultiConditionsAfterHttp, new HttpMixingPayload { Active = true, Category = "standard" })))
            @(Html.NativeButton("s6-btn-inactive-premium", "inactive, premium")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S6MultiConditionsAfterHttp, new HttpMixingPayload { Active = false, Category = "premium" })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Saved: <span id="s6-saved">&mdash;</span></p>
            <p id="s6-active-badge" hidden class="text-green-600 font-semibold">Active Badge</p>
            <p id="s6-premium-label" hidden class="text-purple-600 font-semibold">Premium</p>
            <p>Footer: <span id="s6-footer">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">7. Condition inside OnError handler</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST fails &rarr; OnError(400) { When(category=="required") &rarr; specific error message }.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s7-btn-required", "category=required")
                .CssClass("rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S7ConditionInError, new HttpMixingPayload { Category = "required" })))
            @(Html.NativeButton("s7-btn-other", "category=format")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S7ConditionInError, new HttpMixingPayload { Category = "format" })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Status: <span id="s7-status">&mdash;</span></p>
            <p>Error: <span id="s7-error-msg">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">8. And guard inside OnSuccess</native-heading>
        <p class="text-sm text-text-secondary mb-3">POST &rarr; OnSuccess { When(active).And(count &gt; 5) &rarr; Show/Hide }.</p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s8-btn-qualified", "active=true, count=10")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S8AndGuardInsideSuccess, new HttpMixingPayload { Active = true, Count = 10 })))
            @(Html.NativeButton("s8-btn-not-qualified", "active=true, count=2")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S8AndGuardInsideSuccess, new HttpMixingPayload { Active = true, Count = 2 })))
            @(Html.NativeButton("s8-btn-inactive", "active=false, count=10")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S8AndGuardInsideSuccess, new HttpMixingPayload { Active = false, Count = 10 })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Saved: <span id="s8-saved">&mdash;</span></p>
            <p id="s8-qualified" hidden class="text-green-600 font-semibold">Qualified!</p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">12. Ordered mixed modules around HTTP</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Branch, HTTP, dispatch, plugin source, element reactions, and a second branch run in declaration order.
        </p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s12-btn-run", "run ordered mix")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S12OrderedMixedModules, new HttpMixingPayload { Active = true, Category = "premium" })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>HTTP: <span id="s12-http-done">&mdash;</span></p>
            <p>Plugin: <span id="s12-plugin">&mdash;</span></p>
            <p>Order: <span id="s12-order">&mdash;</span></p>
            <p>Sequence: <span id="s12-sequence">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">13. Ordered mixed modules around parallel HTTP</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Branch, parallel HTTP, all-settled handlers, dispatch, plugin source, and tail branch preserve declaration order.
        </p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s13-btn-run", "run parallel mix")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S13OrderedParallelMix, new HttpMixingPayload { Active = true, Category = "premium", Count = 7 })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>A: <span id="s13-a">&mdash;</span></p>
            <p>B: <span id="s13-b">&mdash;</span></p>
            <p>All: <span id="s13-all">&mdash;</span></p>
            <p>Plugin: <span id="s13-plugin">&mdash;</span></p>
            <p>Order: <span id="s13-order">&mdash;</span></p>
            <p>Sequence: <span id="s13-sequence">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">14. Route-template gather from reactive event payload</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Branch, route-template POST, header/body gather, dispatch, plugin source, and tail branch all read the same typed event payload.
        </p>
        <native-hstack gap="Sm" class="mb-3">
            @(Html.NativeButton("s14-btn-active-high", "event resident 314")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S14RouteTemplateFromPayload, new HttpMixingPayload { Active = true, Count = 314, Category = "VIP Review" })))
            @(Html.NativeButton("s14-btn-inactive-low", "event resident 271")
                .CssClass("rounded-md bg-surface-alt px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-alt/80 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Dispatch(HttpMixingEvents.S14RouteTemplateFromPayload, new HttpMixingPayload { Active = false, Count = 271, Category = "Routine Check" })))
        </native-hstack>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Route ID: <span id="s14-route-id">&mdash;</span></p>
            <p>Body action: <span id="s14-body-action">&mdash;</span></p>
            <p>Header category: <span id="s14-header-category">&mdash;</span></p>
            <p>Trail ID: <span id="s14-trail-id">&mdash;</span></p>
            <p>Trail slug: <span id="s14-trail-slug">&mdash;</span></p>
            <p>Trail step: <span id="s14-trail-step">&mdash;</span></p>
            <p>Plugin: <span id="s14-plugin">&mdash;</span></p>
            <p>Order: <span id="s14-order">&mdash;</span></p>
            <p>Sequence: <span id="s14-sequence">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">9. Reactive input with HTTP between shared reactions and an outer condition</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Type a resident name, blur the field, and the real component <code>.Reactive()</code> path will run:
            pre-reaction &rarr; POST echo &rarr; outer <code>When/Then/Else</code> &rarr; tail reaction.
        </p>
        <native-grid cols="C2" gap="Base" class="mb-3">
            @{
                Html.InputField(plan, m => m.ReactiveResidentName, o => o.Label("Resident Name"))
                    .NativeTextBox(b => b
                        .Placeholder("Type VIP Alice or Bob"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.Element("s9-pre").Text.Set("saving");
                        p.Post(saveUrl)
                         .Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, args.Value))
                         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
                         {
                             s.Element("s9-http-result").Text.Set(json.Get(x => x.ReceivedName));
                         }));
                        p.When(args.Value).Contains("VIP")
                            .Then(then => then.Element("s9-badge").Show())
                            .Else(else_ => else_.Element("s9-badge").Hide());
                        p.Element("s9-tail").Text.Set("complete");
                    });
            }
        </native-grid>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Pre: <span id="s9-pre">&mdash;</span></p>
            <p>HTTP result: <span id="s9-http-result">&mdash;</span></p>
            <p id="s9-badge" hidden class="text-green-600 font-semibold">VIP Badge</p>
            <p>Tail: <span id="s9-tail">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">10. Reactive input with condition inside OnSuccess</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Type a follow-up label and blur. The component change posts to the server, then
            <code>OnSuccess</code> runs shared reactions around an inner <code>When/Then/Else</code>.
        </p>
        <native-grid cols="C2" gap="Base" class="mb-3">
            @{
                Html.InputField(plan, m => m.ReactiveFollowUpName, o => o.Label("Follow-up Label"))
                    .NativeTextBox(b => b
                        .Placeholder("Type a long or short label"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.Element("s10-pre").Text.Set("loading");
                        p.Post(saveUrl)
                         .Gather<HttpMixingController.SaveRequest>(g => g.Set(x => x.Name, args.Value))
                         .Response(r => r.OnSuccess<HttpMixingEchoResponse>((json, s) =>
                         {
                             s.Element("s10-http-result").Text.Set(json.Get(x => x.ReceivedName));
                             s.When(args.Value).MinLength(5)
                                 .Then(then => then.Element("s10-classification").Text.Set("long name"))
                                 .Else(else_ => else_.Element("s10-classification").Text.Set("short name"));
                             s.Element("s10-tail").Text.Set("success complete");
                         }));
                    });
            }
        </native-grid>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Pre: <span id="s10-pre">&mdash;</span></p>
            <p>HTTP result: <span id="s10-http-result">&mdash;</span></p>
            <p>Classification: <span id="s10-classification">&mdash;</span></p>
            <p>Tail: <span id="s10-tail">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>

    <native-card>
    <native-card-body>
        <native-heading level="H2">11. Reactive input with condition inside OnError</native-heading>
        <p class="text-sm text-text-secondary mb-3">
            Type an error category and blur. The component change triggers a failing POST, then
            <code>OnError(400)</code> evaluates the supported condition DSL inside the response handler.
        </p>
        <native-grid cols="C2" gap="Base" class="mb-3">
            @{
                Html.InputField(plan, m => m.ReactiveErrorCategory, o => o.Label("Error Category"))
                    .NativeTextBox(b => b
                        .Placeholder("Type required or format"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.Element("s11-pre").Text.Set("validating");
                        p.Post(failValidationUrl)
                         .Response(r => r
                             .OnSuccess(s => s.Element("s11-status").Text.Set("should not happen"))
                             .OnError(400, e =>
                             {
                                 e.Element("s11-status").Text.Set("failed");
                                 e.When(args.Value).Eq("required")
                                     .Then(then => then.Element("s11-error-msg").Text.Set("missing required fields"))
                                     .Else(else_ => else_.Element("s11-error-msg").Text.Set("validation error"));
                                 e.Element("s11-tail").Text.Set("error complete");
                             }));
                    });
            }
        </native-grid>
        <native-vstack gap="Xs" class="font-mono text-sm text-text-muted">
            <p>Pre: <span id="s11-pre">&mdash;</span></p>
            <p>Status: <span id="s11-status">&mdash;</span></p>
            <p>Error: <span id="s11-error-msg">&mdash;</span></p>
            <p>Tail: <span id="s11-tail">&mdash;</span></p>
        </native-vstack>
    </native-card-body>
    </native-card>
</native-vstack>

@Html.RenderPlan(plan)

@functions {
    private sealed class HttpMixingSlugifyPlugin : Plugin
    {
        public HttpMixingSlugifyPlugin()
            : base("slugify")
        {
        }

        public TypedSource<string> Slug(Arg<string> text) => Invoke<string>(text, name: "");
    }

    private sealed class HttpMixingOrderPlugin : Plugin
    {
        public HttpMixingOrderPlugin()
            : base("order")
        {
        }

        public TypedSource<string> Mark(Arg<string> scenario, Arg<string> step) => Invoke<string>(scenario, step, name: "");
    }
}
