@{
    ViewData["Title"] = "Conditions";
}

<native-vstack gap="Lg">
    <native-heading level="H1">Conditions</native-heading>
    <native-text color="Secondary">
        Guard evaluation, condition-driven routing, and browser-visible workflow slices.
    </native-text>

    <section>
        <div class="flex items-center gap-3 mb-4">
            <span class="w-1 h-6 rounded-full bg-primary"></span>
            <native-heading level="H2">Syntax &amp; Routing</native-heading>
        </div>
        <native-grid cols="C2" gap="Base">
            <a asp-area="Sandbox" asp-controller="Guards" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Guards
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Interactive operator showcase for all guard types, compound logic, and Confirm without any custom JavaScript.
                </p>
            </a>

            <a asp-area="Sandbox" asp-controller="SupportedSyntax" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Supported Syntax
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Vertical slice for the supported branch-level DSL: shared reactions around <code>When(...).Then(...).ElseIf(...).Else(...)</code>.
                </p>
            </a>

            <a asp-area="Sandbox" asp-controller="EscalationRouting" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Escalation Routing
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Dedicated slice for dispatching routed events from inside condition branches and proving stale state clears across reevaluation.
                </p>
            </a>

            <a asp-area="Sandbox" asp-controller="HttpMixing" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        HTTP Mixing
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Conditions interleaved with HTTP across one page and two fixtures: trigger flows and real component reactive flows.
                </p>
            </a>

            <a asp-area="Sandbox" asp-controller="ResponseConditions" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Response Conditions
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Branch on HTTP response status codes — approve, deny, pending, fail — with status-driven DOM updates.
                </p>
            </a>
        </native-grid>
    </section>

    <section>
        <div class="flex items-center gap-3 mb-4">
            <span class="w-1 h-6 rounded-full bg-accent"></span>
            <native-heading level="H2">Component Reactions</native-heading>
        </div>
        <native-grid cols="C3" gap="Base">
            <a asp-area="Sandbox" asp-controller="NumericCondition" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Numeric Conditions
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Numeric thresholds, severity ladders, AND compounds, and source-vs-source conditions driven by real components.
                </p>
            </a>

            <a asp-area="Sandbox" asp-controller="VitalsAlert" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Vitals Alert
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Condition-gated HTTP from component reads, including before/after reaction paths and tiered severity branches.
                </p>
            </a>

            <a asp-area="Sandbox" asp-controller="CareLevelCascade" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Care Level Cascade
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Cross-component value reactions driven by care-level selection, component updates, and membership-based branching.
                </p>
            </a>
        </native-grid>
    </section>

    <section>
        <div class="flex items-center gap-3 mb-4">
            <span class="w-1 h-6 rounded-full bg-info"></span>
            <native-heading level="H2">Workflow Slices</native-heading>
        </div>
        <native-grid cols="C2" gap="Base">
            <a asp-area="Sandbox" asp-controller="AdmissionAssessment" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Admission Assessment
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    One-page assessment with four form scopes, nested partial plans, condition-driven sections, HTTP alerts, and server-side draft coupling.
                </p>
            </a>

            <a asp-area="Sandbox" asp-controller="CommandOrdering" asp-action="Index"
               class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
                <native-hstack justify="Between" align="Start">
                    <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                        Reaction Ordering
                    </h3>
                    <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
                </native-hstack>
                <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                    Verify that pipeline reactions fire in declaration order even when interleaved with conditions, HTTP calls, and dispatch events.
                </p>
            </a>
        </native-grid>
    </section>
</native-vstack>
