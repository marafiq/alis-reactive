@model Step1DemographicsModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    var plan = Html.ReactivePlan<Step1DemographicsModel>();
    var diagnoses = (string[])ViewBag.Diagnoses;
    var serviceBranches = (string[])ViewBag.ServiceBranches;
    var searchPhysiciansUrl = Url.Action("SearchPhysicians", "AdmissionAssessment", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve AdmissionAssessment.SearchPhysicians.");
    var saveStep1Url = Url.Action("SaveStep1", "AdmissionAssessment", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve AdmissionAssessment.SaveStep1.");
}

<native-card><native-card-body id="step1-form">
    <native-heading level="H2">Step 1: Demographics</native-heading>
    <p class="text-sm text-text-secondary mb-4">
        Basic resident information. Age auto-calculates risk tier. Diagnosis determines which clinical sections appear in Step 2.
    </p>

    <native-grid cols="C2" gap="Base" class="mb-4">
        @{ Html.InputField(plan, m => m.ResidentName, o => o.Required().Label("Resident Name"))
            .NativeTextBox(b => b.Placeholder("Full name")); }

        @{ Html.InputField(plan, m => m.Age, o => o.Required().Label("Age"))
            .FusionNumericTextBox(b => b
                .Min(0).Max(120).Step(1))
            .Reactive(evt => evt.Change, (args, p) =>
            {
                var ageComp = p.Component<FusionNumericTextBox>(m => m.Age);
                p.Element("age-echo").Text.Set(ageComp.Value);

                p.When(ageComp.Value).Gte(85m)
                    .Then(t =>
                    {
                        t.Component<FusionDropDownList>(m => m.RiskTier).Value.Set("High");
                        t.Element("risk-badge").Text.Set("High Risk");
                        t.Element("risk-badge").Show();
                    })
                    .ElseIf(ageComp.Value).Gte(65m)
                    .Then(t =>
                    {
                        t.Component<FusionDropDownList>(m => m.RiskTier).Value.Set("Standard");
                        t.Element("risk-badge").Text.Set("Standard Risk");
                        t.Element("risk-badge").Show();
                    })
                    .Else(e =>
                    {
                        e.Component<FusionDropDownList>(m => m.RiskTier).Value.Set("Low");
                        e.Element("risk-badge").Text.Set("Low Risk");
                        e.Element("risk-badge").Show();
                    });

                p.Element("age-status").Text.Set("assessed");
            }); }
    </native-grid>

    <native-grid cols="C2" gap="Base" class="mb-4">
        @{ Html.InputField(plan, m => m.PrimaryDiagnosis, o => o.Required().Label("Primary Diagnosis"))
            .FusionDropDownList(b => b
                .DataSource(diagnoses)
                .Placeholder("Select diagnosis"))
            .Reactive(evt => evt.Change, (args, p) =>
            {
                var diag = p.Component<FusionDropDownList>(m => m.PrimaryDiagnosis);

                // Shared Active Plan hidden field feeds Step 2 conditions.
                p.Component<NativeHiddenField, Step2ClinicalModel>(m => m.PrimaryDiagnosis).Value.Set(diag.Value);

                p.When(diag.Value).In("Alzheimer's", "Parkinson's")
                    .Then(t => t.Element("cognitive-section").Show())
                    .Else(e => e.Element("cognitive-section").Hide());

                p.When(diag.Value).Eq("Heart Disease")
                    .Then(t => t.Element("cardiac-section").Show())
                    .Else(e => e.Element("cardiac-section").Hide());

                p.When(diag.Value).Eq("Diabetes")
                    .Then(t => t.Element("diabetes-section").Show())
                    .Else(e => e.Element("diabetes-section").Hide());
            }); }

        @{ Html.InputField(plan, m => m.AttendingPhysician, o => o.Label("Attending Physician"))
            .FusionAutoComplete(b => b
                .Placeholder("Type to search physicians...")
                .DebounceDelay(300))
            .Reactive(evt => evt.Filtering, (args, p) =>
            {
                args.PreventDefaultAction.Set(true);
                p.Get(searchPhysiciansUrl)
                 .Gather<PhysicianSearchQuery>(g => g.Set(x => x.Q, args.Text))
                 .Response(r => r.OnSuccess<PhysicianSearchResponse>((json, s) =>
                 {
                     args.UpdateData(json.Get(j => j.Physicians));
                 }));
            }); }
    </native-grid>

    <native-grid cols="C2" gap="Base" class="mb-4">
        @{ Html.InputField(plan, m => m.RiskTier, o => o.Label("Risk Tier (auto)"))
            .FusionDropDownList(b => b
                .DataSource(new[] { "", "Low", "Standard", "High" })
                .Placeholder("Set by age")); }

        @{ Html.InputField(plan, m => m.IsVeteran, o => o.Label("Is Veteran"))
            .FusionSwitch()
            .Reactive(evt => evt.Change, (args, p) =>
            {
                var sw = p.Component<FusionSwitch>(m => m.IsVeteran);
                p.When(sw.Checked).Truthy()
                    .Then(t => t.Element("veteran-section").Show())
                    .Else(e => e.Element("veteran-section").Hide());
            }); }
    </native-grid>

    <native-vstack gap="Xs" class="font-mono text-sm mb-4">
        <p>Age echo: <span id="age-echo" class="text-text-muted">&mdash;</span></p>
        <p>Risk: <span id="risk-badge" hidden class="font-semibold text-accent">&mdash;</span></p>
        <p>Age status: <span id="age-status" class="text-text-muted">&mdash;</span></p>
    </native-vstack>

    <div id="veteran-section" hidden>
        <native-grid cols="C2" gap="Base" class="mb-4">
            @{ Html.InputField(plan, m => m.VaId, o => o.Label("VA ID"))
                .NativeTextBox(b => b.Placeholder("e.g. VA-12345")); }

            @{ Html.InputField(plan, m => m.ServiceBranch, o => o.Label("Service Branch"))
                .FusionDropDownList(b => b
                    .DataSource(serviceBranches)
                    .Placeholder("Select branch")); }
        </native-grid>
    </div>

    <native-hstack gap="None" justify="End" class="mt-6">
        @(Html.NativeButton("next-1", "Next: Clinical \u2192")
            .CssClass("rounded-md bg-accent px-6 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post(saveStep1Url)
                 .Gather(g => g.Form())
                 .Validate<Step1Validator>("step1-form")
                 .Response(r => r
                    .OnSuccess<SaveStepResponse>((json, s) =>
                    {
                        // Later-step saves use the Step 1 draft key from the Active Plan.
                        s.Component<NativeHiddenField, Step2ClinicalModel>(m => m.ScreeningId).Value.Set(json.Get(x => x.ScreeningId));
                        s.Component<NativeHiddenField, Step3FunctionalModel>(m => m.ScreeningId).Value.Set(json.Get(x => x.ScreeningId));
                        s.Component<NativeHiddenField, Step4ReviewModel>(m => m.ScreeningId).Value.Set(json.Get(x => x.ScreeningId));
                        // Step 3 judges fall risk against the age entered here.
                        s.Component<FusionNumericTextBox, Step3FunctionalModel>(m => m.Age).Value.Set(s.Component<FusionNumericTextBox>(m => m.Age).Value);

                        s.Element("step-1").Hide();
                        s.Element("step-2").Show();
                        s.Element("step-ind-1").ClassList.Remove("font-bold");
                        s.Element("step-ind-1").ClassList.Remove("text-accent");
                        s.Element("step-ind-2").ClassList.Add("font-bold");
                        s.Element("step-ind-2").ClassList.Add("text-accent");
                    })
                    .OnError(400, e =>
                    {
                        e.ValidationErrors("step1-form");
                    }));
            }))
    </native-hstack>
</native-card-body></native-card>

@Html.RenderPlan(plan)
