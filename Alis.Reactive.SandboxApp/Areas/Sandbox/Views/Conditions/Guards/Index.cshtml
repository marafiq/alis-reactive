        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-startswith-yes", "admin@corp.com", ConditionsShowcaseEvents.CheckStartswith, new TextPayload { Name = "", Email = "admin@corp.com" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-startswith-no", "user@corp.com", ConditionsShowcaseEvents.CheckStartswith, new TextPayload { Name = "", Email = "user@corp.com" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="startswith-result">&mdash;</span></native-hstack>
