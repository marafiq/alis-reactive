@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.Guards.ConditionsShowcaseModel
@using Alis.Reactive.Native.Components
@using Microsoft.AspNetCore.Html
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.Guards
@{
    ViewData["Title"] = "Guards";

    var plan = Html.ReactivePlan<ConditionsShowcaseModel>();

    IHtmlContent DispatchButton<TPayload>(string id, string text, AppEvent<TPayload> raises, TPayload payload, string cssClass) where TPayload : class, new()
    {
        return Html.NativeButton(id, text)
            .CssClass(cssClass)
            .Reactive(plan, evt => evt.Click, (_, p) => p.Dispatch(raises, payload));
    }
    Html.On(plan, t => t.CustomEvent<ScorePayload>(ConditionsShowcaseEvents.SetScore, (args, p) =>
    {
        p.Element("score-display").Text.Set(args.Get(x => x.Score));
    }));
    Html.On(plan, t => t.CustomEvent<ScorePayload>(ConditionsShowcaseEvents.SetScore, (args, p) =>
        p.When(args.Get(x => x.Score)).Gte(90)
            .Then(then => then.Element("grade").Text.Set("A"))
            .ElseIf(args.Get(x => x.Score)).Gte(80)
            .Then(then => then.Element("grade").Text.Set("B"))
            .Else(else_ => else_.Element("grade").Text.Set("F"))
    ));
    Html.On(plan, t => t.CustomEvent<LongPayload>(ConditionsShowcaseEvents.CheckLong, (args, p) =>
        p.When(args.Get(x => x.Balance)).Gt(1000000L)
            .Then(then => then.Element("long-result").Text.Set("High Value"))
            .Else(else_ => else_.Element("long-result").Text.Set("Standard"))
    ));
    Html.On(plan, t => t.CustomEvent<DoublePayload>(ConditionsShowcaseEvents.CheckDouble, (args, p) =>
        p.When(args.Get(x => x.Temperature)).Gt(98.6)
            .Then(then => then.Element("double-result").Text.Set("Fever"))
            .Else(else_ => else_.Element("double-result").Text.Set("Normal"))
    ));
    Html.On(plan, t => t.CustomEvent<BoolPayload>(ConditionsShowcaseEvents.CheckBool, (args, p) =>
        p.When(args.Get(x => x.IsActive)).Truthy()
            .Then(then => then.Element("bool-result").Text.Set("Online"))
            .Else(else_ => else_.Element("bool-result").Text.Set("Offline"))
    ));
    Html.On(plan, t => t.CustomEvent<RolePayload>(ConditionsShowcaseEvents.CheckString, (args, p) =>
        p.When(args.Get(x => x.Role)).Eq("Alice")
            .Then(then => then.Element("string-result").Text.Set("Welcome Alice!"))
            .Else(else_ => else_.Element("string-result").Text.Set("Hello Stranger"))
    ));
    Html.On(plan, t => t.CustomEvent<DatePayload>(ConditionsShowcaseEvents.CheckDate, (args, p) =>
        p.When(args.Get(x => x.Deadline)).Gt(new DateTime(2026, 6, 1))
            .Then(then => then.Element("date-result").Text.Set("On Time"))
            .Else(else_ => else_.Element("date-result").Text.Set("Overdue"))
    ));
    Html.On(plan, t => t.CustomEvent<NullablePayload>(ConditionsShowcaseEvents.CheckNullable, (args, p) =>
        p.When(args.Get(x => x.NullableScore)).IsNull()
            .Then(then => then.Element("nullable-result").Text.Set("No Score"))
            .Else(else_ => else_.Element("nullable-result").Text.Set("Has Score"))
    ));
    Html.On(plan, t => t.CustomEvent<ScorePayload>(ConditionsShowcaseEvents.CheckAnd, (args, p) =>
        p.When(args.Get(x => x.Score)).Gte(90)
            .And(g => g.When(args.Get(x => x.Status)).Eq("active"))
            .Then(then => then.Element("and-result").Text.Set("Active High Scorer"))
            .Else(else_ => else_.Element("and-result").Text.Set("Nope"))
    ));
    Html.On(plan, t => t.CustomEvent<RolePayload>(ConditionsShowcaseEvents.CheckOr, (args, p) =>
        p.When(args.Get(x => x.Role)).Eq("admin")
            .Or(g => g.When(args.Get(x => x.Role)).Eq("superuser"))
            .Then(then => then.Element("or-result").Text.Set("Authorized"))
            .Else(else_ => else_.Element("or-result").Text.Set("Denied"))
    ));
    Html.On(plan, t => t.CustomEvent<NestedPayload>(ConditionsShowcaseEvents.CheckNested, (args, p) =>
        p.When(args.Get(x => x.Address!.City)).Eq("Seattle")
            .Then(then => then.Element("nested-result").Text.Set("Found Seattle"))
            .Else(else_ => else_.Element("nested-result").Text.Set("Other City"))
    ));
    Html.On(plan, t => t.CustomEvent<NestedPayload>(ConditionsShowcaseEvents.CheckNestedNull, (args, p) =>
        p.When(args.Get(x => x.Address)).IsNull()
            .Then(then => then.Element("nested-null-result").Text.Set("No Address"))
            .Else(else_ => else_.Element("nested-null-result").Text.Set("Has Address"))
    ));
    Html.On(plan, t => t.CustomEvent<NestedPayload>(ConditionsShowcaseEvents.CheckNestedAnd, (args, p) =>
        p.When(args.Get(x => x.Id)).Gte(1)
            .And(g => g.When(args.Get(x => x.Address!.City)).NotNull())
            .Then(then => { then.Element("nested-and-result").Text.Set("Valid"); })
            .Else(else_ => else_.Element("nested-and-result").Text.Set("Invalid"))
    ));
    Html.On(plan, t => t.CustomEvent<NestedPayload>(ConditionsShowcaseEvents.CheckNullLeaf, (args, p) =>
        p.When(args.Get(x => x.Address!.City)).Eq("Seattle")
            .Then(then => then.Element("null-leaf-result").Text.Set("Seattle"))
            .Else(else_ => else_.Element("null-leaf-result").Text.Set("Not Seattle"))
    ));
    Html.On(plan, t => t.CustomEvent<MembershipPayload>(ConditionsShowcaseEvents.CheckIn, (args, p) =>
        p.When(args.Get(x => x.Category)).In("A", "B", "C")
            .Then(then => then.Element("in-result").Text.Set("In Group"))
            .Else(else_ => else_.Element("in-result").Text.Set("Not In Group"))
    ));
    Html.On(plan, t => t.CustomEvent<MembershipPayload>(ConditionsShowcaseEvents.CheckNotin, (args, p) =>
        p.When(args.Get(x => x.Category)).NotIn("X", "Y")
            .Then(then => then.Element("notin-result").Text.Set("Allowed"))
            .Else(else_ => else_.Element("notin-result").Text.Set("Blocked"))
    ));
    Html.On(plan, t => t.CustomEvent<RangePayload>(ConditionsShowcaseEvents.CheckBetween, (args, p) =>
        p.When(args.Get(x => x.Age)).Between(18, 65)
            .Then(then => then.Element("between-result").Text.Set("Working Age"))
            .Else(else_ => else_.Element("between-result").Text.Set("Outside Range"))
    ));
    Html.On(plan, t => t.CustomEvent<TextPayload>(ConditionsShowcaseEvents.CheckContains, (args, p) =>
        p.When(args.Get(x => x.Name)).Contains("admin")
            .Then(then => then.Element("contains-result").Text.Set("Has admin"))
            .Else(else_ => else_.Element("contains-result").Text.Set("No admin"))
    ));
    Html.On(plan, t => t.CustomEvent<TextPayload>(ConditionsShowcaseEvents.CheckStartswith, (args, p) =>
        p.When(args.Get(x => x.Email)).StartsWith("admin@")
            .Then(then => then.Element("startswith-result").Text.Set("Admin email"))
            .Else(else_ => else_.Element("startswith-result").Text.Set("Other email"))
    ));
    Html.On(plan, t => t.CustomEvent<TextPayload>(ConditionsShowcaseEvents.CheckMatches, (args, p) =>
        p.When(args.Get(x => x.Email)).Matches(@"^[a-z]+@[a-z]+\.[a-z]+$")
            .Then(then => then.Element("matches-result").Text.Set("Valid"))
            .Else(else_ => else_.Element("matches-result").Text.Set("Invalid"))
    ));
    Html.On(plan, t => t.CustomEvent<TextPayload>(ConditionsShowcaseEvents.CheckMinlength, (args, p) =>
        p.When(args.Get(x => x.Name)).MinLength(3)
            .Then(then => then.Element("minlength-result").Text.Set("Long enough"))
            .Else(else_ => else_.Element("minlength-result").Text.Set("Too short"))
    ));
    Html.On(plan, t => t.CustomEvent<TextPayload>(ConditionsShowcaseEvents.CheckIsempty, (args, p) =>
        p.When(args.Get(x => x.Name)).IsEmpty()
            .Then(then => then.Element("isempty-result").Text.Set("Empty"))
            .Else(else_ => else_.Element("isempty-result").Text.Set("Has value"))
    ));
    Html.On(plan, t => t.CustomEvent<RolePayload>(ConditionsShowcaseEvents.CheckNot, (args, p) =>
        p.When(args.Get(x => x.Role)).Eq("admin").Not()
            .Then(then => then.Element("not-result").Text.Set("Not admin"))
            .Else(else_ => else_.Element("not-result").Text.Set("Is admin"))
    ));
    Html.On(plan, t => t.CustomEvent<ScorePayload>(ConditionsShowcaseEvents.CheckConfirm, (args, p) =>
        p.Confirm("Are you sure you want to proceed?")
            .Then(then => then.Element("confirm-result").Text.Set("Confirmed"))
            .Else(else_ => else_.Element("confirm-result").Text.Set("Cancelled"))
    ));
    Html.On(plan, t => t.CustomEvent<ScorePayload>(ConditionsShowcaseEvents.CheckSingleCommandCondition, (args, p) =>
    {
        p.Element("single-command-condition-result").Text.Set("Always runs");
        p.When(args.Get(x => x.Score)).Gte(90)
            .Then(then => then.Element("single-command-condition-bonus").Text.Set("Bonus!"));
    }));
    Html.On(plan, t => t.CustomEvent<ScorePayload>(ConditionsShowcaseEvents.CheckDirectAnd, (args, p) =>
        p.When(args.Get(x => x.Score)).Gte(90)
            .And(args.Get(x => x.Status)).Eq("active")
            .Then(then => then.Element("direct-and-result").Text.Set("Pass"))
            .Else(else_ => else_.Element("direct-and-result").Text.Set("Fail"))
    ));
    Html.On(plan, t => t.CustomEvent<RolePayload>(ConditionsShowcaseEvents.CheckDirectOr, (args, p) =>
        p.When(args.Get(x => x.Role)).Eq("admin")
            .Or(args.Get(x => x.Role)).Eq("superuser")
            .Then(then => then.Element("direct-or-result").Text.Set("Authorized"))
            .Else(else_ => else_.Element("direct-or-result").Text.Set("Denied"))
    ));
    Html.On(plan, t => t.CustomEvent<ScorePayload>(ConditionsShowcaseEvents.CheckNestedBranch, (args, p) =>
        p.When(args.Get(x => x.Score)).Gte(90)
            .Then(then =>
            {
                then.When(args.Get(x => x.Status)).Eq("active")
                    .Then(innerThen => innerThen.Element("nested-branch-result").Text.Set("Senior Active"))
                    .Else(innerElse => innerElse.Element("nested-branch-result").Text.Set("Senior Inactive"));
            })
            .Else(else_ => else_.Element("nested-branch-result").Text.Set("Junior"))
    ));

    var formattedJson = plan.RenderFormatted();
}

<native-vstack gap="Md">
    <div>
        <native-heading level="H1">Guards</native-heading>
        <native-text color="Secondary" size="Sm">
            Every primitive type through the typed guard chain. Operand type matches the C# property type at compile time.
        </native-text>
    </div>
    <native-card><native-card-body>
        <native-heading level="H2">int — ElseIf Grade Ladder</native-heading>
        <p class="text-xs text-text-secondary mb-3">Score &ge; 90 &rarr; A &bull; &ge; 80 &rarr; B &bull; else &rarr; F</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-score-95", "95", ConditionsShowcaseEvents.SetScore, new ScorePayload { Score = 95 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-score-85", "85", ConditionsShowcaseEvents.SetScore, new ScorePayload { Score = 85 }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-score-40", "40", ConditionsShowcaseEvents.SetScore, new ScorePayload { Score = 40 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-grid cols="C2" gap="Base" class="text-xs font-mono">
            <native-hstack gap="None" justify="Between"><span class="text-text-secondary">Score</span><span id="score-display">&mdash;</span></native-hstack>
            <native-hstack gap="None" justify="Between"><span class="text-text-secondary">Grade</span><span id="grade">&mdash;</span></native-hstack>
        </native-grid>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">long — Balance Threshold</native-heading>
        <p class="text-xs text-text-secondary mb-3">Balance &gt; 1,000,000 &rarr; "High Value" &bull; else &rarr; "Standard"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-long-high", "5,000,000", ConditionsShowcaseEvents.CheckLong, new LongPayload { Balance = 5_000_000L }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-long-low", "500", ConditionsShowcaseEvents.CheckLong, new LongPayload { Balance = 500L }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="long-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">double — Temperature Check</native-heading>
        <p class="text-xs text-text-secondary mb-3">Temp &gt; 98.6 &rarr; "Fever" &bull; else &rarr; "Normal"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-double-high", "101.3", ConditionsShowcaseEvents.CheckDouble, new DoublePayload { Temperature = 101.3 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-double-low", "97.2", ConditionsShowcaseEvents.CheckDouble, new DoublePayload { Temperature = 97.2 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="double-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">bool — Truthy / Falsy</native-heading>
        <p class="text-xs text-text-secondary mb-3">IsActive truthy &rarr; "Online" &bull; else &rarr; "Offline"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-bool-true", "true", ConditionsShowcaseEvents.CheckBool, new BoolPayload { IsActive = true }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-bool-false", "false", ConditionsShowcaseEvents.CheckBool, new BoolPayload { IsActive = false }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="bool-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">string — Equality</native-heading>
        <p class="text-xs text-text-secondary mb-3">Name == "Alice" &rarr; "Welcome Alice!" &bull; else &rarr; "Hello Stranger"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-string-match", "Alice", ConditionsShowcaseEvents.CheckString, new RolePayload { Role = "Alice" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-string-miss", "Bob", ConditionsShowcaseEvents.CheckString, new RolePayload { Role = "Bob" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="string-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">DateTime — Deadline Comparison</native-heading>
        <p class="text-xs text-text-secondary mb-3">Deadline &gt; 2026-06-01 &rarr; "On Time" &bull; else &rarr; "Overdue"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-date-future", "2026-07-15", ConditionsShowcaseEvents.CheckDate, new DatePayload { Deadline = new DateTime(2026, 7, 15) }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-date-past", "2026-01-15", ConditionsShowcaseEvents.CheckDate, new DatePayload { Deadline = new DateTime(2026, 1, 15) }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="date-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">int? — Nullable IsNull</native-heading>
        <p class="text-xs text-text-secondary mb-3">NullableScore is null &rarr; "No Score" &bull; else &rarr; "Has Score"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nullable-null", "null", ConditionsShowcaseEvents.CheckNullable, new NullablePayload { NullableScore = null }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-nullable-value", "42", ConditionsShowcaseEvents.CheckNullable, new NullablePayload { NullableScore = 42 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nullable-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">AND — Mixed Types (int + string)</native-heading>
        <p class="text-xs text-text-secondary mb-3">Score &ge; 90 <strong>AND</strong> Status == "active"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-and-pass", "95 + active", ConditionsShowcaseEvents.CheckAnd, new ScorePayload { Score = 95, Status = "active" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-and-fail", "95 + inactive", ConditionsShowcaseEvents.CheckAnd, new ScorePayload { Score = 95, Status = "inactive" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="and-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">OR — String Alternatives</native-heading>
        <p class="text-xs text-text-secondary mb-3">Role == "admin" <strong>OR</strong> "superuser"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-or-admin", "admin", ConditionsShowcaseEvents.CheckOr, new RolePayload { Role = "admin" }, "px-3 py-1.5 rounded bg-indigo-600 text-white text-xs font-medium")
            @DispatchButton("btn-or-super", "superuser", ConditionsShowcaseEvents.CheckOr, new RolePayload { Role = "superuser" }, "px-3 py-1.5 rounded bg-violet-600 text-white text-xs font-medium")
            @DispatchButton("btn-or-viewer", "viewer", ConditionsShowcaseEvents.CheckOr, new RolePayload { Role = "viewer" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="or-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">Nested Payload — Deep Dot-Path Guard</native-heading>
        <p class="text-xs text-text-secondary mb-3">Address.City == "Seattle" &rarr; "Found Seattle" &bull; else &rarr; "Other City"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nested-seattle", "Seattle", ConditionsShowcaseEvents.CheckNested, new NestedPayload { Address = new AddressInfo { City = "Seattle", Zip = "98101" }, Id = 1 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-portland", "Portland", ConditionsShowcaseEvents.CheckNested, new NestedPayload { Address = new AddressInfo { City = "Portland", Zip = "97201" }, Id = 2 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nested-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">Null Nested Object — IsNull Guard</native-heading>
        <p class="text-xs text-text-secondary mb-3">Address is null &rarr; "No Address" &bull; else &rarr; "Has Address"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nested-null", "null address", ConditionsShowcaseEvents.CheckNestedNull, new NestedPayload { Address = null, Id = 1 }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-present", "has address", ConditionsShowcaseEvents.CheckNestedNull, new NestedPayload { Address = new AddressInfo { City = "NYC" }, Id = 2 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-missing", "missing key", ConditionsShowcaseEvents.CheckNestedNull, new NestedPayload { Id = 3 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nested-null-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">Mixed AND — Flat + Nested in Compound</native-heading>
        <p class="text-xs text-text-secondary mb-3">Id &ge; 1 <strong>AND</strong> Address.City not-null &rarr; "Valid" &bull; else &rarr; "Invalid"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nested-and-pass", "id=5 + city", ConditionsShowcaseEvents.CheckNestedAnd, new NestedPayload { Id = 5, Address = new AddressInfo { City = "NYC" } }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-and-null", "id=5 + null addr", ConditionsShowcaseEvents.CheckNestedAnd, new NestedPayload { Id = 5, Address = null }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-and-missing", "id=5 + missing", ConditionsShowcaseEvents.CheckNestedAnd, new NestedPayload { Id = 5 }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nested-and-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">Null Leaf — Comparison Doesn't Crash</native-heading>
        <p class="text-xs text-text-secondary mb-3">Address.City == "Seattle" when city is null &rarr; else branch (no crash)</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-null-leaf-null", "city=null", ConditionsShowcaseEvents.CheckNullLeaf, new NestedPayload { Address = new AddressInfo { City = null }, Id = 1 }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-null-leaf-match", "city=Seattle", ConditionsShowcaseEvents.CheckNullLeaf, new NestedPayload { Address = new AddressInfo { City = "Seattle" }, Id = 2 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-null-leaf-obj-null", "address=null", ConditionsShowcaseEvents.CheckNullLeaf, new NestedPayload { Address = null, Id = 3 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-null-leaf-missing", "address missing", ConditionsShowcaseEvents.CheckNullLeaf, new NestedPayload { Id = 99 }, "px-3 py-1.5 rounded bg-slate-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="null-leaf-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
