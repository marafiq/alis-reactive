            @DispatchButton("btn-contains-no", "viewer", ConditionsShowcaseEvents.CheckContains, new TextPayload { Name = "viewer", Email = "" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="contains-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
