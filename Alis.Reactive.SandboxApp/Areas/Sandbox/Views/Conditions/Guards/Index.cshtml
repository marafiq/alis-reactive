        <p class="text-xs text-text-secondary mb-3">Name min-length 3 &rarr; "Long enough" &bull; else &rarr; "Too short"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-minlength-yes", "Alice", ConditionsShowcaseEvents.CheckMinlength, new TextPayload { Name = "Alice", Email = "" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-minlength-no", "Al", ConditionsShowcaseEvents.CheckMinlength, new TextPayload { Name = "Al", Email = "" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="minlength-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
