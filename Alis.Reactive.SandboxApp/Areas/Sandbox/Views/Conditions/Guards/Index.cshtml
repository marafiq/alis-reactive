        <p class="text-xs text-text-secondary mb-3">Email matches ^[a-z]+&#64;[a-z]+\.[a-z]+$ &rarr; "Valid" &bull; else &rarr; "Invalid"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-matches-yes", "test@corp.com", ConditionsShowcaseEvents.CheckMatches, new TextPayload { Name = "", Email = "test@corp.com" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-matches-no", "BAD@123.com", ConditionsShowcaseEvents.CheckMatches, new TextPayload { Name = "", Email = "BAD@123.com" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="matches-result">&mdash;</span></native-hstack>
