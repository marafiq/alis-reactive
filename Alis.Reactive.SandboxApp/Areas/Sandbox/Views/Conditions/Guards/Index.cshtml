@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.Guards.ConditionsShowcaseModel
@using Alis.Reactive
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Microsoft.AspNetCore.Html
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.Guards
@{
    ViewData["Title"] = "Guards";

    var plan = Html.ReactivePlan<ConditionsShowcaseModel>();

    IHtmlContent DispatchButton<TPayload>(string id, string text, string eventName, TPayload payload, string cssClass)
    {
        return Html.NativeButton(id, text)
            .CssClass(cssClass)
            .Reactive(plan, evt => evt.Click, (_, p) => p.Dispatch(eventName, payload));
    }

    // ── Section 1: int — ElseIf grade ladder ──
    Html.On(plan, t => t.CustomEvent<ScorePayload>("set-score", (args, p) =>
    {
        p.Element("score-display").SetText(args, x => x.Score);
    }));
    Html.On(plan, t => t.CustomEvent<ScorePayload>("set-score", (args, p) =>
        p.When(args, x => x.Score).Gte(90)
            .Then(then => then.Element("grade").SetText("A"))
            .ElseIf(args, x => x.Score).Gte(80)
            .Then(then => then.Element("grade").SetText("B"))
            .Else(else_ => else_.Element("grade").SetText("F"))
    ));

    // ── Section 2: long — balance threshold ──
    Html.On(plan, t => t.CustomEvent<LongPayload>("check-long", (args, p) =>
        p.When(args, x => x.Balance).Gt(1000000L)
            .Then(then => then.Element("long-result").SetText("High Value"))
            .Else(else_ => else_.Element("long-result").SetText("Standard"))
    ));

    // ── Section 3: double — temperature check ──
    Html.On(plan, t => t.CustomEvent<DoublePayload>("check-double", (args, p) =>
        p.When(args, x => x.Temperature).Gt(98.6)
            .Then(then => then.Element("double-result").SetText("Fever"))
            .Else(else_ => else_.Element("double-result").SetText("Normal"))
    ));

    // ── Section 4: bool — truthy/falsy ──
    Html.On(plan, t => t.CustomEvent<BoolPayload>("check-bool", (args, p) =>
        p.When(args, x => x.IsActive).Truthy()
            .Then(then => then.Element("bool-result").SetText("Online"))
            .Else(else_ => else_.Element("bool-result").SetText("Offline"))
    ));

    // ── Section 5: string — equality ──
    Html.On(plan, t => t.CustomEvent<RolePayload>("check-string", (args, p) =>
        p.When(args, x => x.Role).Eq("Alice")
            .Then(then => then.Element("string-result").SetText("Welcome Alice!"))
            .Else(else_ => else_.Element("string-result").SetText("Hello Stranger"))
    ));

    // ── Section 6: DateTime — deadline comparison ──
    Html.On(plan, t => t.CustomEvent<DatePayload>("check-date", (args, p) =>
        p.When(args, x => x.Deadline).Gt(new DateTime(2026, 6, 1))
            .Then(then => then.Element("date-result").SetText("On Time"))
            .Else(else_ => else_.Element("date-result").SetText("Overdue"))
    ));

    // ── Section 7: int? — nullable with is-null guard ──
    Html.On(plan, t => t.CustomEvent<NullablePayload>("check-nullable", (args, p) =>
        p.When(args, x => x.NullableScore).IsNull()
            .Then(then => then.Element("nullable-result").SetText("No Score"))
            .Else(else_ => else_.Element("nullable-result").SetText("Has Score"))
    ));

    // ── Section 8: AND — int + string compound ──
    Html.On(plan, t => t.CustomEvent<ScorePayload>("check-and", (args, p) =>
        p.When(args, x => x.Score).Gte(90)
            .And(g => g.When(args, x => x.Status).Eq("active"))
            .Then(then => then.Element("and-result").SetText("Active High Scorer"))
            .Else(else_ => else_.Element("and-result").SetText("Nope"))
    ));

    // ── Section 9: OR — string alternatives ──
    Html.On(plan, t => t.CustomEvent<RolePayload>("check-or", (args, p) =>
        p.When(args, x => x.Role).Eq("admin")
            .Or(g => g.When(args, x => x.Role).Eq("superuser"))
            .Then(then => then.Element("or-result").SetText("Authorized"))
            .Else(else_ => else_.Element("or-result").SetText("Denied"))
    ));

    // ── Section 10: Nested payload — guard on deep dot-path ──
    Html.On(plan, t => t.CustomEvent<NestedPayload>("check-nested", (args, p) =>
        p.When(args, x => x.Address!.City).Eq("Seattle")
            .Then(then => then.Element("nested-result").SetText("Found Seattle"))
            .Else(else_ => else_.Element("nested-result").SetText("Other City"))
    ));

    // ── Section 11: Null nested object — IsNull guard on complex type ──
    Html.On(plan, t => t.CustomEvent<NestedPayload>("check-nested-null", (args, p) =>
        p.When(args, x => x.Address).IsNull()
            .Then(then => then.Element("nested-null-result").SetText("No Address"))
            .Else(else_ => else_.Element("nested-null-result").SetText("Has Address"))
    ));

    // ── Section 12: Mixed nested + flat in AND compound ──
    Html.On(plan, t => t.CustomEvent<NestedPayload>("check-nested-and", (args, p) =>
        p.When(args, x => x.Id).Gte(1)
            .And(g => g.When(args, x => x.Address!.City).NotNull())
            .Then(then => { then.Element("nested-and-result").SetText("Valid"); })
            .Else(else_ => else_.Element("nested-and-result").SetText("Invalid"))
    ));

    // ── Section 13: Null leaf in comparison — doesn't crash ──
    Html.On(plan, t => t.CustomEvent<NestedPayload>("check-null-leaf", (args, p) =>
        p.When(args, x => x.Address!.City).Eq("Seattle")
            .Then(then => then.Element("null-leaf-result").SetText("Seattle"))
            .Else(else_ => else_.Element("null-leaf-result").SetText("Not Seattle"))
    ));

    // ── Section 14: In membership ──
    Html.On(plan, t => t.CustomEvent<MembershipPayload>("check-in", (args, p) =>
        p.When(args, x => x.Category).In("A", "B", "C")
            .Then(then => then.Element("in-result").SetText("In Group"))
            .Else(else_ => else_.Element("in-result").SetText("Not In Group"))
    ));

    // ── Section 15: NotIn membership ──
    Html.On(plan, t => t.CustomEvent<MembershipPayload>("check-notin", (args, p) =>
        p.When(args, x => x.Category).NotIn("X", "Y")
            .Then(then => then.Element("notin-result").SetText("Allowed"))
            .Else(else_ => else_.Element("notin-result").SetText("Blocked"))
    ));

    // ── Section 16: Between range ──
    Html.On(plan, t => t.CustomEvent<RangePayload>("check-between", (args, p) =>
        p.When(args, x => x.Age).Between(18, 65)
            .Then(then => then.Element("between-result").SetText("Working Age"))
            .Else(else_ => else_.Element("between-result").SetText("Outside Range"))
    ));

    // ── Section 17: Contains text ──
    Html.On(plan, t => t.CustomEvent<TextPayload>("check-contains", (args, p) =>
        p.When(args, x => x.Name).Contains("admin")
            .Then(then => then.Element("contains-result").SetText("Has admin"))
            .Else(else_ => else_.Element("contains-result").SetText("No admin"))
    ));

    // ── Section 18: StartsWith text ──
    Html.On(plan, t => t.CustomEvent<TextPayload>("check-startswith", (args, p) =>
        p.When(args, x => x.Email).StartsWith("admin@")
            .Then(then => then.Element("startswith-result").SetText("Admin email"))
            .Else(else_ => else_.Element("startswith-result").SetText("Other email"))
    ));

    // ── Section 19: Matches regex ──
    Html.On(plan, t => t.CustomEvent<TextPayload>("check-matches", (args, p) =>
        p.When(args, x => x.Email).Matches(@"^[a-z]+@[a-z]+\.[a-z]+$")
            .Then(then => then.Element("matches-result").SetText("Valid"))
            .Else(else_ => else_.Element("matches-result").SetText("Invalid"))
    ));

    // ── Section 20: MinLength text ──
    Html.On(plan, t => t.CustomEvent<TextPayload>("check-minlength", (args, p) =>
        p.When(args, x => x.Name).MinLength(3)
            .Then(then => then.Element("minlength-result").SetText("Long enough"))
            .Else(else_ => else_.Element("minlength-result").SetText("Too short"))
    ));

    // ── Section 21: IsEmpty presence ──
    Html.On(plan, t => t.CustomEvent<TextPayload>("check-isempty", (args, p) =>
        p.When(args, x => x.Name).IsEmpty()
            .Then(then => then.Element("isempty-result").SetText("Empty"))
            .Else(else_ => else_.Element("isempty-result").SetText("Has value"))
    ));

    // ── Section 22: NOT (inverted condition) ──
    Html.On(plan, t => t.CustomEvent<RolePayload>("check-not", (args, p) =>
        p.When(args, x => x.Role).Eq("admin").Not()
            .Then(then => then.Element("not-result").SetText("Not admin"))
            .Else(else_ => else_.Element("not-result").SetText("Is admin"))
    ));

    // ── Section 23: Confirm dialog (async halt) ──
    Html.On(plan, t => t.CustomEvent<ScorePayload>("check-confirm", (args, p) =>
        p.Confirm("Are you sure you want to proceed?")
            .Then(then => then.Element("confirm-result").SetText("Confirmed"))
            .Else(else_ => else_.Element("confirm-result").SetText("Cancelled"))
    ));

    // ── Section 24: Single-command condition via When/Then ──
    Html.On(plan, t => t.CustomEvent<ScorePayload>("check-single-command-condition", (args, p) =>
    {
        p.Element("single-command-condition-result").SetText("Always runs");
        p.When(args, x => x.Score).Gte(90)
            .Then(then => then.Element("single-command-condition-bonus").SetText("Bonus!"));
    }));

    // ── Section 25: Direct And syntax (same JSON as lambda And) ──
    Html.On(plan, t => t.CustomEvent<ScorePayload>("check-direct-and", (args, p) =>
        p.When(args, x => x.Score).Gte(90)
            .And(args, x => x.Status).Eq("active")
            .Then(then => then.Element("direct-and-result").SetText("Pass"))
            .Else(else_ => else_.Element("direct-and-result").SetText("Fail"))
    ));

    // ── Section 26: Direct Or syntax (same JSON as lambda Or) ──
    Html.On(plan, t => t.CustomEvent<RolePayload>("check-direct-or", (args, p) =>
        p.When(args, x => x.Role).Eq("admin")
            .Or(args, x => x.Role).Eq("superuser")
            .Then(then => then.Element("direct-or-result").SetText("Authorized"))
            .Else(else_ => else_.Element("direct-or-result").SetText("Denied"))
    ));

    // ── Section 27: Nested branch block inside a Then branch ──
    Html.On(plan, t => t.CustomEvent<ScorePayload>("check-nested-branch", (args, p) =>
        p.When(args, x => x.Score).Gte(90)
            .Then(then =>
            {
                then.When(args, x => x.Status).Eq("active")
                    .Then(innerThen => innerThen.Element("nested-branch-result").SetText("Senior Active"))
                    .Else(innerElse => innerElse.Element("nested-branch-result").SetText("Senior Inactive"));
            })
            .Else(else_ => else_.Element("nested-branch-result").SetText("Junior"))
    ));

    var formattedJson = plan.RenderFormatted();
}

<native-vstack gap="Md">
    <div>
        <native-heading level="H1">Guards</native-heading>
        <native-text color="Secondary" size="Sm">
            Every primitive type through the typed guard chain. Operand type matches the C# property type at compile time.
        </native-text>
    </div>

    <!-- Section 1: int (ElseIf) -->
    <native-card><native-card-body>
        <native-heading level="H2">int — ElseIf Grade Ladder</native-heading>
        <p class="text-xs text-text-secondary mb-3">Score &ge; 90 &rarr; A &bull; &ge; 80 &rarr; B &bull; else &rarr; F</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-score-95", "95", "set-score", new ScorePayload { Score = 95 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-score-85", "85", "set-score", new ScorePayload { Score = 85 }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-score-40", "40", "set-score", new ScorePayload { Score = 40 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-grid cols="C2" gap="Base" class="text-xs font-mono">
            <native-hstack gap="None" justify="Between"><span class="text-text-secondary">Score</span><span id="score-display">&mdash;</span></native-hstack>
            <native-hstack gap="None" justify="Between"><span class="text-text-secondary">Grade</span><span id="grade">&mdash;</span></native-hstack>
        </native-grid>
    </native-card-body></native-card>

    <!-- Section 2: long -->
    <native-card><native-card-body>
        <native-heading level="H2">long — Balance Threshold</native-heading>
        <p class="text-xs text-text-secondary mb-3">Balance &gt; 1,000,000 &rarr; "High Value" &bull; else &rarr; "Standard"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-long-high", "5,000,000", "check-long", new LongPayload { Balance = 5_000_000L }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-long-low", "500", "check-long", new LongPayload { Balance = 500L }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="long-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 3: double -->
    <native-card><native-card-body>
        <native-heading level="H2">double — Temperature Check</native-heading>
        <p class="text-xs text-text-secondary mb-3">Temp &gt; 98.6 &rarr; "Fever" &bull; else &rarr; "Normal"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-double-high", "101.3", "check-double", new DoublePayload { Temperature = 101.3 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-double-low", "97.2", "check-double", new DoublePayload { Temperature = 97.2 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="double-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 4: bool -->
    <native-card><native-card-body>
        <native-heading level="H2">bool — Truthy / Falsy</native-heading>
        <p class="text-xs text-text-secondary mb-3">IsActive truthy &rarr; "Online" &bull; else &rarr; "Offline"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-bool-true", "true", "check-bool", new BoolPayload { IsActive = true }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-bool-false", "false", "check-bool", new BoolPayload { IsActive = false }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="bool-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 5: string -->
    <native-card><native-card-body>
        <native-heading level="H2">string — Equality</native-heading>
        <p class="text-xs text-text-secondary mb-3">Name == "Alice" &rarr; "Welcome Alice!" &bull; else &rarr; "Hello Stranger"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-string-match", "Alice", "check-string", new RolePayload { Role = "Alice" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-string-miss", "Bob", "check-string", new RolePayload { Role = "Bob" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="string-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 6: DateTime -->
    <native-card><native-card-body>
        <native-heading level="H2">DateTime — Deadline Comparison</native-heading>
        <p class="text-xs text-text-secondary mb-3">Deadline &gt; 2026-06-01 &rarr; "On Time" &bull; else &rarr; "Overdue"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-date-future", "2026-07-15", "check-date", new DatePayload { Deadline = new DateTime(2026, 7, 15) }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-date-past", "2026-01-15", "check-date", new DatePayload { Deadline = new DateTime(2026, 1, 15) }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="date-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 7: int? (nullable) -->
    <native-card><native-card-body>
        <native-heading level="H2">int? — Nullable IsNull</native-heading>
        <p class="text-xs text-text-secondary mb-3">NullableScore is null &rarr; "No Score" &bull; else &rarr; "Has Score"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nullable-null", "null", "check-nullable", new NullablePayload { NullableScore = null }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-nullable-value", "42", "check-nullable", new NullablePayload { NullableScore = 42 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nullable-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 8: AND composition (int + string) -->
    <native-card><native-card-body>
        <native-heading level="H2">AND — Mixed Types (int + string)</native-heading>
        <p class="text-xs text-text-secondary mb-3">Score &ge; 90 <strong>AND</strong> Status == "active"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-and-pass", "95 + active", "check-and", new ScorePayload { Score = 95, Status = "active" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-and-fail", "95 + inactive", "check-and", new ScorePayload { Score = 95, Status = "inactive" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="and-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 9: OR composition (string) -->
    <native-card><native-card-body>
        <native-heading level="H2">OR — String Alternatives</native-heading>
        <p class="text-xs text-text-secondary mb-3">Role == "admin" <strong>OR</strong> "superuser"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-or-admin", "admin", "check-or", new RolePayload { Role = "admin" }, "px-3 py-1.5 rounded bg-indigo-600 text-white text-xs font-medium")
            @DispatchButton("btn-or-super", "superuser", "check-or", new RolePayload { Role = "superuser" }, "px-3 py-1.5 rounded bg-violet-600 text-white text-xs font-medium")
            @DispatchButton("btn-or-viewer", "viewer", "check-or", new RolePayload { Role = "viewer" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="or-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 10: Nested payload condition -->
    <native-card><native-card-body>
        <native-heading level="H2">Nested Payload — Deep Dot-Path Guard</native-heading>
        <p class="text-xs text-text-secondary mb-3">Address.City == "Seattle" &rarr; "Found Seattle" &bull; else &rarr; "Other City"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nested-seattle", "Seattle", "check-nested", new NestedPayload { Address = new AddressInfo { City = "Seattle", Zip = "98101" }, Id = 1 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-portland", "Portland", "check-nested", new NestedPayload { Address = new AddressInfo { City = "Portland", Zip = "97201" }, Id = 2 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nested-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 11: Null nested object -->
    <native-card><native-card-body>
        <native-heading level="H2">Null Nested Object — IsNull Guard</native-heading>
        <p class="text-xs text-text-secondary mb-3">Address is null &rarr; "No Address" &bull; else &rarr; "Has Address"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nested-null", "null address", "check-nested-null", new NestedPayload { Address = null, Id = 1 }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-present", "has address", "check-nested-null", new NestedPayload { Address = new AddressInfo { City = "NYC" }, Id = 2 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-missing", "missing key", "check-nested-null", new NestedPayload { Id = 3 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nested-null-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 12: Mixed nested + flat AND -->
    <native-card><native-card-body>
        <native-heading level="H2">Mixed AND — Flat + Nested in Compound</native-heading>
        <p class="text-xs text-text-secondary mb-3">Id &ge; 1 <strong>AND</strong> Address.City not-null &rarr; "Valid" &bull; else &rarr; "Invalid"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nested-and-pass", "id=5 + city", "check-nested-and", new NestedPayload { Id = 5, Address = new AddressInfo { City = "NYC" } }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-and-null", "id=5 + null addr", "check-nested-and", new NestedPayload { Id = 5, Address = null }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-and-missing", "id=5 + missing", "check-nested-and", new NestedPayload { Id = 5 }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nested-and-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 13: Null leaf in comparison -->
    <native-card><native-card-body>
        <native-heading level="H2">Null Leaf — Comparison Doesn't Crash</native-heading>
        <p class="text-xs text-text-secondary mb-3">Address.City == "Seattle" when city is null &rarr; else branch (no crash)</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-null-leaf-null", "city=null", "check-null-leaf", new NestedPayload { Address = new AddressInfo { City = null }, Id = 1 }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-null-leaf-match", "city=Seattle", "check-null-leaf", new NestedPayload { Address = new AddressInfo { City = "Seattle" }, Id = 2 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-null-leaf-obj-null", "address=null", "check-null-leaf", new NestedPayload { Address = null, Id = 3 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-null-leaf-missing", "address missing", "check-null-leaf", new NestedPayload { Id = 99 }, "px-3 py-1.5 rounded bg-slate-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="null-leaf-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 14: In membership -->
    <native-card><native-card-body>
        <native-heading level="H2">In — Membership</native-heading>
        <p class="text-xs text-text-secondary mb-3">Category in ["A","B","C"] &rarr; "In Group" &bull; else &rarr; "Not In Group"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-in-match", "B", "check-in", new MembershipPayload { Category = "B", Priority = 1 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-in-miss", "Z", "check-in", new MembershipPayload { Category = "Z", Priority = 1 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="in-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 15: NotIn membership -->
    <native-card><native-card-body>
        <native-heading level="H2">NotIn — Exclusion</native-heading>
        <p class="text-xs text-text-secondary mb-3">Category not-in ["X","Y"] &rarr; "Allowed" &bull; else &rarr; "Blocked"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-notin-pass", "A", "check-notin", new MembershipPayload { Category = "A", Priority = 1 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-notin-fail", "X", "check-notin", new MembershipPayload { Category = "X", Priority = 1 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="notin-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 16: Between range -->
    <native-card><native-card-body>
        <native-heading level="H2">Between — Range Check</native-heading>
        <p class="text-xs text-text-secondary mb-3">Age between [18, 65] &rarr; "Working Age" &bull; else &rarr; "Outside Range"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-between-in", "30", "check-between", new RangePayload { Age = 30 }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-between-low", "10", "check-between", new RangePayload { Age = 10 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-between-high", "80", "check-between", new RangePayload { Age = 80 }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="between-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 17: Contains text -->
    <native-card><native-card-body>
        <native-heading level="H2">Contains — Text Search</native-heading>
        <p class="text-xs text-text-secondary mb-3">Name contains "admin" &rarr; "Has admin" &bull; else &rarr; "No admin"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-contains-yes", "superadmin", "check-contains", new TextPayload { Name = "superadmin", Email = "" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-contains-no", "viewer", "check-contains", new TextPayload { Name = "viewer", Email = "" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="contains-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 18: StartsWith text -->
    <native-card><native-card-body>
        <native-heading level="H2">StartsWith — Text Prefix</native-heading>
        <p class="text-xs text-text-secondary mb-3">Email starts-with "admin&#64;" &rarr; "Admin email" &bull; else &rarr; "Other email"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-startswith-yes", "admin@corp.com", "check-startswith", new TextPayload { Name = "", Email = "admin@corp.com" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-startswith-no", "user@corp.com", "check-startswith", new TextPayload { Name = "", Email = "user@corp.com" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="startswith-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 19: Matches regex -->
    <native-card><native-card-body>
        <native-heading level="H2">Matches — Regex Pattern</native-heading>
        <p class="text-xs text-text-secondary mb-3">Email matches ^[a-z]+&#64;[a-z]+\.[a-z]+$ &rarr; "Valid" &bull; else &rarr; "Invalid"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-matches-yes", "test@corp.com", "check-matches", new TextPayload { Name = "", Email = "test@corp.com" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-matches-no", "BAD@123.com", "check-matches", new TextPayload { Name = "", Email = "BAD@123.com" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="matches-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 20: MinLength text -->
    <native-card><native-card-body>
        <native-heading level="H2">MinLength — Text Length Check</native-heading>
        <p class="text-xs text-text-secondary mb-3">Name min-length 3 &rarr; "Long enough" &bull; else &rarr; "Too short"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-minlength-yes", "Alice", "check-minlength", new TextPayload { Name = "Alice", Email = "" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-minlength-no", "Al", "check-minlength", new TextPayload { Name = "Al", Email = "" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="minlength-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 21: IsEmpty presence -->
    <native-card><native-card-body>
        <native-heading level="H2">IsEmpty — Presence Check</native-heading>
        <p class="text-xs text-text-secondary mb-3">Name is-empty &rarr; "Empty" &bull; else &rarr; "Has value"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-isempty-empty", "\"\"", "check-isempty", new TextPayload { Name = "", Email = "" }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-isempty-null", "null", "check-isempty", new TextPayload { Name = null!, Email = "" }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-isempty-value", "Alice", "check-isempty", new TextPayload { Name = "Alice", Email = "" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="isempty-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 22: NOT (inverted condition) -->
    <native-card><native-card-body>
        <native-heading level="H2">NOT — Invert Guard</native-heading>
        <p class="text-xs text-text-secondary mb-3">NOT(Role == "admin") &rarr; "Not admin" &bull; else &rarr; "Is admin"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-not-user", "user", "check-not", new RolePayload { Role = "user" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-not-admin", "admin", "check-not", new RolePayload { Role = "admin" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="not-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 23: Confirm dialog (async halt) -->
    <native-card><native-card-body>
        <native-heading level="H2">Confirm — Async Halt Dialog</native-heading>
        <p class="text-xs text-text-secondary mb-3">Shows confirm dialog &rarr; OK = "Confirmed" &bull; Cancel = "Cancelled"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-confirm", "Trigger Confirm", "check-confirm", new ScorePayload { Score = 1, Status = "" }, "px-3 py-1.5 rounded bg-indigo-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="confirm-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 24: Single-command condition via When/Then -->
    <native-card><native-card-body>
        <native-heading level="H2">Single-Command Condition — When/Then</native-heading>
        <p class="text-xs text-text-secondary mb-3">Unconditional command runs first &bull; guarded command executes when Score &ge; 90</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-single-command-condition-high", "95", "check-single-command-condition", new ScorePayload { Score = 95, Status = "" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-single-command-condition-low", "50", "check-single-command-condition", new ScorePayload { Score = 50, Status = "" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-grid cols="C2" gap="Base" class="text-xs font-mono">
            <native-hstack gap="None" justify="Between"><span class="text-text-secondary">Always</span><span id="single-command-condition-result">&mdash;</span></native-hstack>
            <native-hstack gap="None" justify="Between"><span class="text-text-secondary">Bonus</span><span id="single-command-condition-bonus">&mdash;</span></native-hstack>
        </native-grid>
    </native-card-body></native-card>

    <!-- Section 25: Direct And syntax -->
    <native-card><native-card-body>
        <native-heading level="H2">Direct And — Simplified Syntax</native-heading>
        <p class="text-xs text-text-secondary mb-3">Score &ge; 90 <strong>.And(args, x =&gt; x.Status).Eq("active")</strong></p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-direct-and-pass", "95 + active", "check-direct-and", new ScorePayload { Score = 95, Status = "active" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-direct-and-fail", "95 + inactive", "check-direct-and", new ScorePayload { Score = 95, Status = "inactive" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-direct-and-score-low", "70 + active", "check-direct-and", new ScorePayload { Score = 70, Status = "active" }, "px-3 py-1.5 rounded bg-slate-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="direct-and-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 26: Direct Or syntax -->
    <native-card><native-card-body>
        <native-heading level="H2">Direct Or — Simplified Syntax</native-heading>
        <p class="text-xs text-text-secondary mb-3">Role == "admin" <strong>.Or(args, x =&gt; x.Role).Eq("superuser")</strong></p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-direct-or-admin", "admin", "check-direct-or", new RolePayload { Role = "admin" }, "px-3 py-1.5 rounded bg-indigo-600 text-white text-xs font-medium")
            @DispatchButton("btn-direct-or-super", "superuser", "check-direct-or", new RolePayload { Role = "superuser" }, "px-3 py-1.5 rounded bg-violet-600 text-white text-xs font-medium")
            @DispatchButton("btn-direct-or-viewer", "viewer", "check-direct-or", new RolePayload { Role = "viewer" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="direct-or-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Section 27: Nested branch block -->
    <native-card><native-card-body>
        <native-heading level="H2">Nested Branch — Then Contains When</native-heading>
        <p class="text-xs text-text-secondary mb-3">Score &ge; 90 enters an outer branch; Status decides the inner branch.</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nested-branch-active", "95 + active", "check-nested-branch", new ScorePayload { Score = 95, Status = "active" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-branch-inactive", "95 + inactive", "check-nested-branch", new ScorePayload { Score = 95, Status = "inactive" }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-branch-low", "70 + active", "check-nested-branch", new ScorePayload { Score = 70, Status = "active" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nested-branch-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>

    <!-- Plan JSON -->
    <native-card><native-card-body>
        <native-heading level="H2" spacing="Base">Plan JSON</native-heading>
        <pre class="rounded-md bg-slate-900 text-emerald-400 p-4 font-mono text-xs overflow-x-auto max-h-96"><code id="plan-json">@Html.Raw(formattedJson)</code></pre>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
