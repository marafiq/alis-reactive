        <p class="text-xs text-text-secondary mb-3">Shows confirm dialog &rarr; OK = "Confirmed" &bull; Cancel = "Cancelled"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-confirm", "Trigger Confirm", ConditionsShowcaseEvents.CheckConfirm, new ScorePayload { Score = 1, Status = "" }, "px-3 py-1.5 rounded bg-indigo-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="confirm-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">Single-Reaction Condition — When/Then</native-heading>
        <p class="text-xs text-text-secondary mb-3">Unguarded reaction runs first &bull; guarded reaction executes when Score &ge; 90</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-single-command-condition-high", "95", ConditionsShowcaseEvents.CheckSingleCommandCondition, new ScorePayload { Score = 95, Status = "" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-single-command-condition-low", "50", ConditionsShowcaseEvents.CheckSingleCommandCondition, new ScorePayload { Score = 50, Status = "" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-grid cols="C2" gap="Base" class="text-xs font-mono">
            <native-hstack gap="None" justify="Between"><span class="text-text-secondary">Always</span><span id="single-command-condition-result">&mdash;</span></native-hstack>
            <native-hstack gap="None" justify="Between"><span class="text-text-secondary">Bonus</span><span id="single-command-condition-bonus">&mdash;</span></native-hstack>
        </native-grid>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">Direct And — Simplified Syntax</native-heading>
        <p class="text-xs text-text-secondary mb-3">Score &ge; 90 <strong>.And(args, x =&gt; x.Status).Eq("active")</strong></p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-direct-and-pass", "95 + active", ConditionsShowcaseEvents.CheckDirectAnd, new ScorePayload { Score = 95, Status = "active" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-direct-and-fail", "95 + inactive", ConditionsShowcaseEvents.CheckDirectAnd, new ScorePayload { Score = 95, Status = "inactive" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
            @DispatchButton("btn-direct-and-score-low", "70 + active", ConditionsShowcaseEvents.CheckDirectAnd, new ScorePayload { Score = 70, Status = "active" }, "px-3 py-1.5 rounded bg-slate-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="direct-and-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">Direct Or — Simplified Syntax</native-heading>
        <p class="text-xs text-text-secondary mb-3">Role == "admin" <strong>.Or(args, x =&gt; x.Role).Eq("superuser")</strong></p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-direct-or-admin", "admin", ConditionsShowcaseEvents.CheckDirectOr, new RolePayload { Role = "admin" }, "px-3 py-1.5 rounded bg-indigo-600 text-white text-xs font-medium")
            @DispatchButton("btn-direct-or-super", "superuser", ConditionsShowcaseEvents.CheckDirectOr, new RolePayload { Role = "superuser" }, "px-3 py-1.5 rounded bg-violet-600 text-white text-xs font-medium")
            @DispatchButton("btn-direct-or-viewer", "viewer", ConditionsShowcaseEvents.CheckDirectOr, new RolePayload { Role = "viewer" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="direct-or-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">Nested Branch — Then Contains When</native-heading>
        <p class="text-xs text-text-secondary mb-3">Score &ge; 90 enters an outer branch; Status decides the inner branch.</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-nested-branch-active", "95 + active", ConditionsShowcaseEvents.CheckNestedBranch, new ScorePayload { Score = 95, Status = "active" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-branch-inactive", "95 + inactive", ConditionsShowcaseEvents.CheckNestedBranch, new ScorePayload { Score = 95, Status = "inactive" }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-nested-branch-low", "70 + active", ConditionsShowcaseEvents.CheckNestedBranch, new ScorePayload { Score = 70, Status = "active" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="nested-branch-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2" spacing="Base">Plan JSON</native-heading>
        <pre class="rounded-md bg-slate-900 text-emerald-400 p-4 font-mono text-xs overflow-x-auto max-h-96"><code id="plan-json">@Html.Raw(formattedJson)</code></pre>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
