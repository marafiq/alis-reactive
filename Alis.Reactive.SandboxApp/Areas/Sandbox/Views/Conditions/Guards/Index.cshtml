        <p class="text-xs text-text-secondary mb-3">Name is-empty &rarr; "Empty" &bull; else &rarr; "Has value"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-isempty-empty", "\"\"", ConditionsShowcaseEvents.CheckIsempty, new TextPayload { Name = "", Email = "" }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-isempty-null", "null", ConditionsShowcaseEvents.CheckIsempty, new TextPayload { Name = null!, Email = "" }, "px-3 py-1.5 rounded bg-amber-600 text-white text-xs font-medium")
            @DispatchButton("btn-isempty-value", "Alice", ConditionsShowcaseEvents.CheckIsempty, new TextPayload { Name = "Alice", Email = "" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="isempty-result">&mdash;</span></native-hstack>
    </native-card-body></native-card>
    <native-card><native-card-body>
        <native-heading level="H2">NOT — Invert Guard</native-heading>
        <p class="text-xs text-text-secondary mb-3">NOT(Role == "admin") &rarr; "Not admin" &bull; else &rarr; "Is admin"</p>
        <native-hstack gap="Sm" class="mb-4">
            @DispatchButton("btn-not-user", "user", ConditionsShowcaseEvents.CheckNot, new RolePayload { Role = "user" }, "px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
            @DispatchButton("btn-not-admin", "admin", ConditionsShowcaseEvents.CheckNot, new RolePayload { Role = "admin" }, "px-3 py-1.5 rounded bg-rose-600 text-white text-xs font-medium")
        </native-hstack>
        <native-hstack gap="None" justify="Between" class="text-xs font-mono"><span class="text-text-secondary">Result</span><span id="not-result">&mdash;</span></native-hstack>
