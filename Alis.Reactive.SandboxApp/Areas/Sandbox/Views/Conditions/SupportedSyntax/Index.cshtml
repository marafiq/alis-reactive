@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.SupportedSyntax.SupportedSyntaxModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.SupportedSyntax
@{
    ViewData["Title"] = "Supported Condition Syntax";

    var plan = Html.ReactivePlan<SupportedSyntaxModel>();

    Html.On(plan, t => t.CustomEvent<SupportedSyntaxTriggerPayload>(SupportedSyntaxEvents.SupportedTriggerReview, (args, p) =>
    {
        p.Element("trigger-precheck").Text.Set("Review started");
        p.Dispatch(SupportedSyntaxEvents.SupportedTriggerAudited);
        p.When(args.Get(x => x.Score)).Gte(90)
            .Then(then =>
            {
                then.Element("trigger-result").Text.Set("Priority review");
                then.Element("trigger-badge").Text.Set("Priority");
                then.Element("trigger-badge").Show();
            })
            .ElseIf(args.Get(x => x.Score)).Gte(70)
            .Then(then =>
            {
                then.Element("trigger-result").Text.Set("Standard review");
                then.Element("trigger-badge").Text.Set("Standard");
                then.Element("trigger-badge").Show();
            })
            .Else(else_ =>
            {
                else_.Element("trigger-result").Text.Set("Deferred review");
                else_.Element("trigger-badge").Hide();
            });
        p.Element("trigger-summary").Text.Set("Workflow complete");
    }));

    Html.On(plan, t => t.CustomEvent(SupportedSyntaxEvents.SupportedTriggerAudited, p =>
    {
        p.Element("trigger-audit").Text.Set("Audit logged");
    }));

    Html.On(plan, t => t.CustomEvent(SupportedSyntaxEvents.SupportedReactiveAudited, p =>
    {
        p.Element("reactive-audit").Text.Set("Audit logged");
    }));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Supported Condition Syntax</native-heading>
        <native-text color="Secondary">
            One dedicated vertical slice for the supported condition DSL:
            <code class="bg-slate-100 px-1 rounded">When(...).Then(...).ElseIf(...).Else(...)</code>
            with shared reactions before and after the branch in both trigger and component-reactive pipelines.
        </native-text>
    </div>

    <native-card>
        <native-card-body>
            <native-heading level="H2">1. Trigger Pipeline</native-heading>
            <p class="text-sm text-text-secondary mb-4">
                Click a review button to dispatch a typed custom event. The trigger pipeline always
                updates shared status, dispatches an audit event, evaluates a three-branch ladder,
                and marks the workflow complete.
            </p>

            <native-hstack gap="Sm" class="mb-4">
                @(Html.NativeButton("btn-trigger-priority", "Priority Review")
                    .CssClass("px-3 py-1.5 rounded bg-emerald-600 text-white text-xs font-medium")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Dispatch(SupportedSyntaxEvents.SupportedTriggerReview, new SupportedSyntaxTriggerPayload { Score = 95 });
                    }))

                @(Html.NativeButton("btn-trigger-standard", "Standard Review")
                    .CssClass("px-3 py-1.5 rounded bg-slate-600 text-white text-xs font-medium")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Dispatch(SupportedSyntaxEvents.SupportedTriggerReview, new SupportedSyntaxTriggerPayload { Score = 75 });
                    }))

                @(Html.NativeButton("btn-trigger-deferred", "Deferred Review")
                    .CssClass("px-3 py-1.5 rounded bg-stone-500 text-white text-xs font-medium")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Dispatch(SupportedSyntaxEvents.SupportedTriggerReview, new SupportedSyntaxTriggerPayload { Score = 40 });
                    }))
            </native-hstack>

            <native-vstack gap="Sm" class="text-xs font-mono">
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Shared precheck</span>
                    <span id="trigger-precheck">&mdash;</span>
                </native-hstack>
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Audit</span>
                    <span id="trigger-audit">&mdash;</span>
                </native-hstack>
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Result</span>
                    <span id="trigger-result">&mdash;</span>
                </native-hstack>
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Badge</span>
                    <span id="trigger-badge" hidden>&mdash;</span>
                </native-hstack>
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Summary</span>
                    <span id="trigger-summary">&mdash;</span>
                </native-hstack>
            </native-vstack>
        </native-card-body>
    </native-card>

    <native-card>
        <native-card-body>
            <native-heading level="H2">2. Reactive Pipeline</native-heading>
            <p class="text-sm text-text-secondary mb-4">
                Change the risk score to run the full <code>.Reactive()</code> path. The pipeline always
                updates shared status, dispatches an audit event, runs the same three-branch ladder,
                and records completion.
            </p>

            <native-grid cols="C2" gap="Base" class="mb-4">
                @{ Html.InputField(plan, m => m.RiskScore, o => o.Label("Risk Score"))
                    .FusionNumericTextBox(b => b
                        .Min(0).Max(100).Step(1))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.Element("reactive-precheck").Text.Set("Risk evaluated");
                        p.Dispatch(SupportedSyntaxEvents.SupportedReactiveAudited);
                        p.When(args.Value).Gte(90m)
                            .Then(then =>
                            {
                                then.Element("reactive-result").Text.Set("Urgent follow-up");
                                then.Element("reactive-badge").Text.Set("Urgent");
                                then.Element("reactive-badge").Show();
                            })
                            .ElseIf(args.Value).Gte(60m)
                            .Then(then =>
                            {
                                then.Element("reactive-result").Text.Set("Standard follow-up");
                                then.Element("reactive-badge").Text.Set("Standard");
                                then.Element("reactive-badge").Show();
                            })
                            .Else(else_ =>
                            {
                                else_.Element("reactive-result").Text.Set("Routine follow-up");
                                else_.Element("reactive-badge").Hide();
                            });
                        p.Element("reactive-summary").Text.Set("Assessment complete");
                    }); }
            </native-grid>

            <native-vstack gap="Sm" class="text-xs font-mono">
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Shared precheck</span>
                    <span id="reactive-precheck">&mdash;</span>
                </native-hstack>
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Audit</span>
                    <span id="reactive-audit">&mdash;</span>
                </native-hstack>
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Result</span>
                    <span id="reactive-result">&mdash;</span>
                </native-hstack>
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Badge</span>
                    <span id="reactive-badge" hidden>&mdash;</span>
                </native-hstack>
                <native-hstack gap="None" justify="Between">
                    <span class="text-text-secondary">Summary</span>
                    <span id="reactive-summary">&mdash;</span>
                </native-hstack>
            </native-vstack>
        </native-card-body>
    </native-card>

</native-vstack>

@Html.RenderPlan(plan)
