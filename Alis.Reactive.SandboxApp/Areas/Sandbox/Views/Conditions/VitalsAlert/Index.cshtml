@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.VitalsAlert
@model VitalsAlertModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Vitals Alert";

    var plan = Html.ReactivePlan<VitalsAlertModel>();
    var rapidResponseUrl = Url.SandboxRoute("RapidResponse", "VitalsAlert");
    var chargeNurseUrl = Url.SandboxRoute("ChargeNurse", "VitalsAlert");
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Heart rate check</native-heading>
        <native-text color="Secondary">
            Walter Cho &middot; Room 118 &middot; evening round. A heart rate of 180 bpm or more pages the rapid
            response team; one of 140 or more alerts the charge nurse.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-grid cols="C2" gap="Base">
                @{ Html.InputField(plan, m => m.HeartRate, o => o.Label("Heart rate (bpm)"))
                    .FusionNumericTextBox(b => b.Min(0).Max(300).Step(1).Format("n0")); }
            </native-grid>

            @(Html.NativeButton("check-heart-rate-btn", "Check the heart rate")
                .CssClass("self-start rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var heartRate = p.Component<FusionNumericTextBox>(m => m.HeartRate);

                    // Each tier alerts its own responder; the first tier the reading reaches wins.
                    p.When(heartRate.Value).IsNull()
                        .Then(missing =>
                        {
                            missing.Element("alert-status").Text.Set("Enter the heart rate first");
                            missing.Element("alert-message").Text.Set("");
                        })
                        .ElseIf(heartRate.Value).Gte(180m)
                        .Then(critical => critical.Post(rapidResponseUrl)
                            .Gather<HeartRateReading>(g => g.Form(m => m.HeartRate))
                            .Response(r => r.OnSuccess<HeartRateAlert>((alert, s) =>
                            {
                                s.Element("alert-status").Text.Set(alert.Get(x => x.Status));
                                s.Element("alert-message").Text.Set(alert.Get(x => x.Message));
                            })))
                        .ElseIf(heartRate.Value).Gte(140m)
                        .Then(high => high.Post(chargeNurseUrl)
                            .Gather<HeartRateReading>(g => g.Form(m => m.HeartRate))
                            .Response(r => r.OnSuccess<HeartRateAlert>((alert, s) =>
                            {
                                s.Element("alert-status").Text.Set(alert.Get(x => x.Status));
                                s.Element("alert-message").Text.Set(alert.Get(x => x.Message));
                            })))
                        .Else(normal =>
                        {
                            normal.Element("alert-status").Text.Set("No alert needed");
                            normal.Element("alert-message").Text.Set("Under 140 bpm: no one needs to be alerted.");
                        });
                }))

            <div class="rounded-md border border-border px-3 py-2">
                <p id="alert-status" class="text-sm font-medium">No reading checked this round.</p>
                <p id="alert-message" class="text-sm text-text-secondary"></p>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
