@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Conditions.CareLevelCascade
@model CareLevelModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Care Level Review";

    var plan = Html.ReactivePlan<CareLevelModel>();
    var careLevels = new[] { "Independent", "Assisted Living", "Memory Care", "Skilled Nursing" };
    var protocols = new[] { "Basic Support", "Enhanced Monitoring", "Full Clinical" };
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Care level review</native-heading>
        <native-text color="Secondary">
            Walter Cho &middot; Room 118 &middot; reassessed this week. The care protocol follows the care level,
            and residents in memory care or skilled nursing go out with an escort.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Care</native-heading>
        <native-grid cols="C2" gap="Base" class="mt-3">
            @{ Html.InputField(plan, m => m.CareLevel, o => o.Label("Care level"))
                .FusionDropDownList(b => b.DataSource(careLevels).Placeholder("Choose the care level"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    var careLevel = p.Component<FusionDropDownList>(m => m.CareLevel);
                    var protocol = p.Component<FusionDropDownList>(m => m.Protocol);

                    p.When(careLevel.Value).Eq("Memory Care")
                        .Then(_ => protocol.Value.Set("Enhanced Monitoring"))
                        .ElseIf(careLevel.Value).Eq("Skilled Nursing")
                        .Then(_ => protocol.Value.Set("Full Clinical"))
                        .Else(_ => protocol.Value.Set("Basic Support"));
                }); }

            @{ Html.InputField(plan, m => m.Protocol, o => o.Label("Care protocol"))
                .FusionDropDownList(b => b.DataSource(protocols).Placeholder("Choose the protocol")); }
        </native-grid>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Outings</native-heading>
            @{ Html.InputField(plan, m => m.RequiresEscort, o => o.Label("Goes out with an escort"))
                .FusionSwitch(); }

            @(Html.NativeButton("apply-escort-policy-btn", "Apply the escort policy")
                .CssClass("self-start rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var careLevel = p.Component<FusionDropDownList>(m => m.CareLevel);
                    var escort = p.Component<FusionSwitch>(m => m.RequiresEscort);

                    p.When(careLevel.Value).In("Memory Care", "Skilled Nursing")
                        .Then(_ => escort.Checked.Set(true))
                        .Else(_ => escort.Checked.Set(false));
                }))
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
