@model IReadOnlyList<CompletedTraining>

<ul id="training-history" class="flex flex-col gap-3">
    @foreach (var training in Model)
    {
        <li class="rounded-md border border-border p-3">
            <p class="text-sm font-medium text-text">@training.Course</p>
            <p class="text-sm text-text-muted">@training.CompletedOn with @training.Trainer</p>
        </li>
    }
</ul>
