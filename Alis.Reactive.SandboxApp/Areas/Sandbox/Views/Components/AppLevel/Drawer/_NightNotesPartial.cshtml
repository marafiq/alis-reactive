@model DrawerModel
@{
    // The night notes hear the desk call the round, for as long as they are in the drawer: closing the
    // drawer, or unloading its content, releases them with their HTML.
    var plan = Html.ResolvePlan<DrawerModel>();
    Html.On(plan, t => t.CustomEvent(DrawerEvents.RoundCalled, p =>
        p.Element("drawer-round-status").Text.Set("The round was called; the notes heard it.")));
}

<native-vstack gap="Base">
    <native-text>Night notes for the Garden wing.</native-text>
    <native-text><span id="drawer-round-status">Waiting for the round.</span></native-text>
</native-vstack>

@Html.RenderPlan(plan)
