@model MorningRosterRows

<ul class="divide-y divide-border rounded-md border border-border">
    @foreach (var resident in Model.Residents)
    {
        <li id="roster-resident-@resident.Id" class="flex items-center justify-between px-4 py-4">
            <span class="font-medium text-text-primary">@resident.Name</span>
            <span class="text-sm text-text-muted">@(resident.CheckedIn ? "Checked in" : "Not checked in")</span>
        </li>
    }
</ul>
