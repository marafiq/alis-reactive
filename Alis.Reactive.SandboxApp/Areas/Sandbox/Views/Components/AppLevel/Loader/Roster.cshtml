@model ResidentRosterPageModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.AppLevel
@{
    ViewData["Title"] = "Morning Roster";
    var plan = Html.ReactivePlan<ResidentRosterPageModel>();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Morning Roster</native-heading>
    <native-text color="Secondary">
        Check residents in as they arrive for breakfast. The loader covers whatever the server is working on.
    </native-text>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-hstack gap="Sm" align="Center">
                @(Html.NativeButton("check-in-margaret-btn", "Check in Margaret Hill")
                    .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Post(Url.SandboxRoute("RosterCheckIn", "Loader", new { residentId = 1 }))
                         .WhileLoading(l => l.Component<NativeLoader>().SetTarget("roster-resident-1").Show())
                         .Response(r => r.OnSuccess(s =>
                         {
                             s.Into("morning-roster");
                             s.Component<NativeLoader>().Hide();
                             s.Element("roster-status").SetText("Margaret Hill checked in.");
                         }));
                    }))
                @(Html.NativeButton("refresh-roster-btn", "Refresh Roster")
                    .CssClass("rounded-md border border-border px-4 py-2 text-sm font-medium")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Get(Url.SandboxRoute("RosterRows", "Loader"))
                         .WhileLoading(l => l.Component<NativeLoader>().SetTarget("roster-resident-1").Show())
                         .Response(r => r.OnSuccess(s =>
                         {
                             s.Into("morning-roster");
                             s.Get(Url.SandboxRoute("RosterCareSummary", "Loader"))
                              .WhileLoading(l => l.Component<NativeLoader>().SetTarget("roster-care-summary").Show())
                              .Response(summary => summary.OnSuccess<RosterCareSummary>((json, c) =>
                              {
                                  c.Component<NativeLoader>().Hide();
                                  c.Element("roster-care-summary-text").SetText(json, x => x.Summary);
                              }));
                         }));
                    }))
            </native-hstack>
            <p id="roster-status" class="text-sm text-text-muted">No one checked in yet.</p>

            <div id="morning-roster">
                @await Html.PartialAsync("~/Areas/Sandbox/Views/Components/AppLevel/Loader/_RosterRows.cshtml", Model.Roster)
            </div>

            <section id="roster-care-summary" class="rounded-md border border-border p-4">
                <native-heading level="H2">Care summary</native-heading>
                <p id="roster-care-summary-text" class="mt-2 text-sm text-text-muted">Refresh the roster to load Margaret Hill's care summary.</p>
            </section>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
