@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Native.HiddenField
@model NightRoomCheck
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Night Room Checks";

    const string FormId = "room-check-form";
    const string Button = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<NightRoomCheck>();
    var rooms = NightRound.Rooms.Select(room => new SelectListItem(room, room)).ToList();
    var findings = NightRound.Findings.Select(finding => new SelectListItem(finding, finding)).ToList();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Night Room Checks</native-heading>
    <native-text color="Secondary">
        @Model.Wing wing, night shift. Start the round when you leave the nurses' station, then record how you
        found each resident.
    </native-text>

    <native-card><native-card-body>
        <form id="@FormId" class="flex flex-col gap-4">
            @Html.HiddenFieldFor(plan, m => m.Wing)
            @Html.HiddenFieldFor(plan, m => m.RoundStartedAt)
            @{ Html.HiddenFieldFor(plan, m => m.ResidentId)
                .Reactive(evt => evt.Change, (args, p) =>
                    p.Get(Url.SandboxRoute("NightCare", "NativeHiddenField"))
                     .Gather<NightCareQuery>(g => g.Set(x => x.ResidentId, args.Value))
                     .Response(r => r.OnSuccess<NightCareNote>((care, s) =>
                     {
                         s.Element("resident-night-care-note").Text.Set(care.Get(x => x.Note));
                         s.Element("resident-night-care").Show();
                     }))); }

            <native-hstack gap="Base" align="Center">
                @(Html.NativeButton("start-round-btn", "Start Round")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var roundStartedAt = p.Component<NativeHiddenField>(m => m.RoundStartedAt);
                        p.When(roundStartedAt.Value).NotEmpty()
                            .Then(underway =>
                            {
                                underway.Element("round-underway-time").Text.Set(roundStartedAt.Value);
                                underway.Element("round-underway").Show();
                            })
                            .Else(start => start.Post(Url.SandboxRoute("StartNightRound", "NativeHiddenField"))
                                .Gather<NightRoundStart>(g => g.Form(m => m.Wing))
                                .Response(r => r.OnSuccess<NightRoundStarted>((round, s) =>
                                {
                                    roundStartedAt.Value.Set(round.Get(x => x.StartedAt));
                                    s.Element("round-status").Text.Set(round.Get(x => x.Announcement));
                                    s.Element("room-check-panel").Show();
                                })));
                    }))
                <p id="round-status" class="text-sm text-text-muted">The round has not started.</p>
            </native-hstack>
            <p id="round-underway" hidden class="text-sm text-amber-800">
                This round started at <span id="round-underway-time"></span>. Record each room before starting another.
            </p>

            <div id="room-check-panel" hidden class="flex flex-col gap-4">
                @{ Html.InputField(plan, m => m.Room, o => o.Required().Label("Room"))
                    .NativeDropDown(b => b.Items(rooms).Placeholder("-- Choose the room --"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.Get(Url.SandboxRoute("Occupant", "NativeHiddenField"))
                         .Gather<RoomOccupantQuery>(g => g.Set(x => x.Room, args.Value))
                         .Response(r => r.OnSuccess<RoomOccupant>((occupant, s) =>
                         {
                             s.Component<NativeHiddenField>(m => m.ResidentId).Value.Set(occupant.Get(x => x.ResidentId));
                             s.Element("room-resident").Text.Set(occupant.Get(x => x.ResidentName));
                         }));
                    }); }
                <p class="text-sm">Resident: <span id="room-resident" class="font-medium">Choose the room you checked.</span></p>
                <p id="resident-night-care" hidden class="text-sm text-text-secondary">Night care: <span id="resident-night-care-note"></span></p>

                @{ Html.InputField(plan, m => m.Finding, o => o.Required().Label("How you found the resident"))
                    .NativeDropDown(b => b.Items(findings).Placeholder("-- Choose --")); }

                <native-hstack gap="Base" align="Center">
                    @(Html.NativeButton("record-room-check-btn", "Record Check")
                        .CssClass(Button)
                        .Reactive(plan, evt => evt.Click, (args, p) =>
                        {
                            p.Post(Url.SandboxRoute("RecordRoomCheck", "NativeHiddenField")).Gather(g => g.Form())
                             .Validate<NightRoomCheckValidator>(FormId)
                             .Response(r => r
                                .OnSuccess<RoomCheckRecorded>((json, s) => s.Element("room-check-status").Text.Set(json.Get(x => x.Summary))));
                        }))
                    <p id="room-check-status" class="text-sm text-text-muted">No rooms checked yet.</p>
                </native-hstack>
            </div>
        </form>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
