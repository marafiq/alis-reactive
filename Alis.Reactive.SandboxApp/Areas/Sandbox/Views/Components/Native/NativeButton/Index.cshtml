@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Native.Button
@model FireDrill
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Fire Drill";

    const string Button = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string UrgentButton = "rounded-md bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700 transition-colors focus:ring-2 focus:ring-rose-400 focus:ring-offset-2";

    var plan = Html.ReactivePlan<FireDrill>();

    // A missing resident stops the routine: the alert shows and the cursor waits on the call button.
    Html.On(plan, t => t.CustomEvent(FireDrillEvents.ResidentMissing, p =>
    {
        p.Element("missing-resident-alert").Show();
        p.Component<NativeButton>("call-charge-nurse-btn").Focus();
    }));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Fire Drill</native-heading>
    <native-text color="Secondary">
        @Model.Wing wing, monthly drill. Start the drill when the alarm sounds, account for every resident, and
        end it at the all-clear.
    </native-text>

    <native-card><native-card-body>
        <native-hstack gap="Base" align="Center">
            @(Html.NativeButton("drill-btn", "Start Drill")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var drill = p.Component<NativeButton>("drill-btn");
                    p.When(drill.TextContent).Eq("Start Drill")
                        .Then(start =>
                        {
                            drill.TextContent.Set("End Drill");
                            start.Element("drill-status").Text.Set("Drill under way. Close every door on the wing.");
                        })
                        .Else(end =>
                        {
                            drill.TextContent.Set("Start Drill");
                            end.Element("drill-status").Text.Set("Drill ended at the all-clear.");
                        });
                }))
            <p id="drill-status" class="text-sm text-text-muted">No drill under way.</p>
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Residents</native-heading>
        <native-text color="Secondary">
            Walk every room and the lounge. If a resident is not where they should be, report it at once.
        </native-text>
        <div class="mt-4">
            @(Html.NativeButton("report-missing-resident-btn", "Report a Missing Resident")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Dispatch(FireDrillEvents.ResidentMissing)))
        </div>
        <div id="missing-resident-alert" hidden role="alert" class="mt-4 flex flex-col gap-3 rounded-md bg-rose-50 p-4">
            <p class="text-sm font-medium text-rose-800">A resident is not accounted for. Call the charge nurse now.</p>
            <div>
                @(Html.NativeButton("call-charge-nurse-btn", "Call Charge Nurse")
                    .CssClass(UrgentButton)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<NativeButton>("call-charge-nurse-btn").TextContent.Set("Charge Nurse Called")))
            </div>
        </div>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
