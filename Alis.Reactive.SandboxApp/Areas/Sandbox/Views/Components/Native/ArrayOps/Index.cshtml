@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Native.ArrayOps
@model WingCensusModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Wing Census";

    const string WingButton = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string Figure = "flex justify-between gap-4 border-b border-border/60 py-1.5";

    var plan = Html.ReactivePlan<WingCensusModel>();
    var mapleUrl = Url.SandboxRoute("MapleWing", "ArrayOps");
    var birchUrl = Url.SandboxRoute("BirchWing", "ArrayOps");

    // The stand-up's figures, read off the wing's census in the browser.
    void ShowCensus(PipelineBuilder<WingCensusModel> s, Data<WingCensusResponse> census)
    {
        var residents = s.From(census.Get(x => x.Residents));
        var inResidence = residents.Where(r => r.Status == CensusStatus.InResidence);

        s.Element("census-wing").Text.Set(census.Get(x => x.Wing));
        s.Element("census-total").Text.Set(residents.Count());
        s.Element("census-in-residence").Text.Set(residents.Count(r => r.Status == CensusStatus.InResidence));
        s.Element("census-away").Text.Set(residents.Count(r => r.Status != CensusStatus.InResidence));
        s.Element("census-high-fall-risk").Text.Set(residents.Count(r => r.Status == CensusStatus.InResidence && r.MorseScore >= 45));
        s.Element("census-low-fall-risk").Text.Set(residents.Count(r => r.MorseScore <= 24));
        s.Element("census-over-ninety").Text.Set(residents.Count(r => r.Age > 90));
        s.Element("census-reviews-due").Text.Set(residents.Count(r => r.DaysToReview < 7));
        s.Element("census-morning-doses").Text.Set(inResidence.Sum(r => r.MorningDoses));
        s.Element("census-charges").Text.Set(inResidence.Sum(r => r.MonthlyCharges));
        s.Element("census-care-hours").Text.Set(inResidence.Sum(r => r.CareHours));
        s.Element("census-highest-fall-risk").Text.Set(
            residents.OrderByDescending(r => r.MorseScore).Find(r => r.Status == CensusStatus.InResidence, r => r.Name));
        s.Element("census-next-review").Text.Set(
            residents.OrderBy(r => r.DaysToReview).Find(r => r.Status == CensusStatus.InResidence, r => r.Name));

        s.When(residents.Any(r => r.Status == CensusStatus.InHospital)).Truthy()
            .Then(hospital =>
            {
                hospital.Element("census-in-hospital").Show();
                hospital.Element("census-none-in-hospital").Hide();
            })
            .Else(none =>
            {
                none.Element("census-none-in-hospital").Show();
                none.Element("census-in-hospital").Hide();
            });
    }

    void LoadCensus(PipelineBuilder<WingCensusModel> p, string url) =>
        p.Get(url).Response(r => r.OnSuccess<WingCensusResponse>((census, s) => ShowCensus(s, census)));

    Html.On(plan, t => t.DomReady(p => LoadCensus(p, mapleUrl)));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Wing Census</native-heading>
    <native-text color="Secondary">
        Morning stand-up. Each wing's census from this morning's records, and the programs running today.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("maple-wing-btn", "Maple wing")
            .CssClass(WingButton)
            .Reactive(plan, evt => evt.Click, (_, p) => LoadCensus(p, mapleUrl)))
        @(Html.NativeButton("birch-wing-btn", "Birch wing")
            .CssClass(WingButton)
            .Reactive(plan, evt => evt.Click, (_, p) => LoadCensus(p, birchUrl)))
    </native-hstack>

    <native-card><native-card-body>
        <native-heading level="H2"><span id="census-wing">Loading the census</span></native-heading>

        <p id="census-in-hospital" hidden class="mt-3 rounded-md bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800">
            A resident is in hospital: the family liaison calls the family today.
        </p>
        <p id="census-none-in-hospital" hidden class="mt-3 text-sm text-text-secondary">No resident is in hospital.</p>

        <dl class="mt-4 grid grid-cols-1 gap-x-10 text-sm md:grid-cols-2">
            <div class="@Figure"><dt>Residents on the census</dt><dd id="census-total" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>In residence</dt><dd id="census-in-residence" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Away (hospital or leave)</dt><dd id="census-away" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>High fall risk in residence (Morse 45 or more)</dt><dd id="census-high-fall-risk" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Low fall risk (Morse 24 or less)</dt><dd id="census-low-fall-risk" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Older than 90</dt><dd id="census-over-ninety" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Care reviews due this week</dt><dd id="census-reviews-due" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Doses on the morning medication pass</dt><dd id="census-morning-doses" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Monthly charges, residents in residence ($)</dt><dd id="census-charges" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Personal care hours a week</dt><dd id="census-care-hours" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Highest fall risk in residence</dt><dd id="census-highest-fall-risk" class="font-medium">&mdash;</dd></div>
            <div class="@Figure"><dt>Next care review</dt><dd id="census-next-review" class="font-medium">&mdash;</dd></div>
        </dl>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Today's programs</native-heading>
        @{ Html.InputField(plan, m => m.ProgramsToday, o => o.Label("Programs running today"))
            .NativeCheckList(b => b
                .Option(StandUpPrograms.PhysicalTherapy)
                .Option(StandUpPrograms.ChairYoga)
                .Option(StandUpPrograms.MusicHour)
                .Option(StandUpPrograms.GardenClub)
                .Option(StandUpPrograms.MovieNight))
            .Reactive(evt => evt.Change, (args, p) =>
                p.Element("programs-today-count").Text.Set(p.From(args.Value).Count())); }
        <p class="mt-3 text-sm">Programs running today: <span id="programs-today-count" class="font-medium">0</span></p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
