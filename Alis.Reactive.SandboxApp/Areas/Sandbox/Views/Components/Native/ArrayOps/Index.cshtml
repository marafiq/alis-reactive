@model ArrayOpsModel
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "ArrayOps";

    var plan = Html.ReactivePlan<ArrayOpsModel>();
    var activityItems = (RadioButtonItem[])ViewBag.ActivityItems;

    // Roster proves array operators compile to plan nodes instead of plugin calls.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("Residents", "ArrayOps"))
         .Response(r => r.OnSuccess<ResidentRosterResponse>((json, s) =>
         {
             var residents = p.From(json.Get(x => x.Residents));

             s.Element("res-total").Text.Set(residents.Count());
             s.Element("res-active").Text.Set(residents.Count(x => x.Status == "active"));
             s.Element("res-active-seniors").Text.Set(residents.Count(x => x.Status == "active" && x.Age >= 65));
             s.Element("res-active-age-sum").Text.Set(residents.Where(x => x.Status == "active").Sum(x => x.Age));
             s.Element("res-oldest-active").Text.Set(
                 residents.Where(x => x.Status == "active").OrderByDescending(x => x.Age).Find(x => true, x => x.Name));

             // The roster's boundaries: Cy is 80 (not over 80), Ed is 65 (not under 65), Ed's charges are $800.
             s.Element("res-over-80").Text.Set(residents.Count(x => x.Age > 80));
             s.Element("res-under-65").Text.Set(residents.Count(x => x.Age < 65));
             s.Element("res-low-charges").Text.Set(residents.Count(x => x.MonthlyCharges <= 800m));
             s.Element("res-not-active").Text.Set(residents.Count(x => x.Status != "active"));
             s.Element("res-active-charges").Text.Set(residents.Where(x => x.Status == "active").Sum(x => x.MonthlyCharges));
             s.Element("res-active-care-hours").Text.Set(residents.Where(x => x.Status == "active").Sum(x => x.CareHours));
             s.Element("res-first-critical").Text.Set(residents.Find(x => x.Status == "critical", x => x.Name));

             s.When(residents.Any(x => x.Status == "critical")).Truthy()
              .Then(then => then.Element("res-critical-yes").Show())
              .Else(els => els.Element("res-critical-no").Show());
         }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">ArrayOps</native-heading>
    <native-text color="Secondary">
        Deterministic array DSL. Each operation is captured from a C# lambda and compiled to a
        plan <code>array-op</code> node; the runtime evaluates predicates and selectors against the
        element scope. No plugin, no hand-written JS.
    </native-text>

    <native-card><native-card-body>
        <native-heading level="H2">Resident roster — operate on the object array</native-heading>
        <native-text color="Secondary">
            Loaded via HTTP, then filtered/aggregated by element members in the plan
            (e.g. <code>residents.Where(x =&gt; x.Status == "active").Sum(x =&gt; x.Age)</code>).
        </native-text>
        <native-vstack gap="Sm" class="font-mono text-sm">
            <p>Total residents: <span id="res-total">&mdash;</span></p>
            <p>Active: <span id="res-active">&mdash;</span></p>
            <p>Active seniors (65+): <span id="res-active-seniors">&mdash;</span></p>
            <p>Total age of active: <span id="res-active-age-sum">&mdash;</span></p>
            <p>Oldest active: <span id="res-oldest-active">&mdash;</span></p>
            <p>Over 80: <span id="res-over-80">&mdash;</span> &middot; Under 65: <span id="res-under-65">&mdash;</span></p>
            <p>Charges of $800 or less: <span id="res-low-charges">&mdash;</span> &middot; Not active: <span id="res-not-active">&mdash;</span></p>
            <p>Active residents' monthly charges: $<span id="res-active-charges">&mdash;</span> &middot; weekly care hours: <span id="res-active-care-hours">&mdash;</span></p>
            <p>Needs attention first: <span id="res-first-critical">&mdash;</span></p>
            <p id="res-critical-yes" hidden class="text-red-600">&#9888; Critical resident present</p>
            <p id="res-critical-no" hidden class="text-green-600">No critical residents</p>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Activity selection (live count)</native-heading>
        <native-text color="Secondary">
            The NativeCheckList <code>Change</code> event delivers <code>args.Value</code> (a
            <code>string[]</code>); <code>p.From(args.Value).Count()</code> updates on every change.
        </native-text>

        @{ Html.InputField(plan, m => m.SelectedActivities, o => o.Label("Activities"))
            .NativeCheckList(b => b
                .Items(activityItems))
            .Reactive(evt => evt.Change, (args, p) =>
            {
                var count = p.From(args.Value).Count();
                p.Element("selected-count").Text.Set(count);
            }); }

        <p class="font-mono text-sm mt-2">Selected count: <span id="selected-count">&mdash;</span></p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
