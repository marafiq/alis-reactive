@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Native.ShiftReport
@model ShiftAlertReviewModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Shift Alert Review";

    const string ShiftButton = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";

    var plan = Html.ReactivePlan<ShiftAlertReviewModel>();

    // The review reads whichever shift's alerts the page announces, by each alert's members.
    Html.On(plan, t => t.CustomEvent<ShiftAlertsLoaded>(ShiftAlertEvents.Loaded, (shift, p) =>
    {
        var alerts = p.From(shift.Get(x => x.Alerts));
        var critical = alerts.Where(a => a.Severity == AlertSeverity.Critical);

        p.Element("shift-choose").Hide();
        p.Element("shift-review").Show();
        p.Element("shift-name").Text.Set(shift.Get(x => x.Shift));
        p.Element("alert-total").Text.Set(alerts.Count());
        p.Element("critical-count").Text.Set(alerts.Count(a => a.Severity == AlertSeverity.Critical));
        p.Element("critical-priority-sum").Text.Set(critical.Sum(a => a.Priority));
        p.Element("top-critical").Text.Set(critical.OrderByDescending(a => a.Priority).Find(a => true, a => a.Resident));

        p.When(alerts.Any(a => a.Severity == AlertSeverity.Critical && !a.Acknowledged)).Truthy()
            .Then(open =>
            {
                open.Element("unack-warning").Show();
                open.Element("unack-clear").Hide();
            })
            .Else(acknowledged =>
            {
                acknowledged.Element("unack-clear").Show();
                acknowledged.Element("unack-warning").Hide();
            });

        // Two or more unacknowledged critical alerts go to the charge nurse.
        p.When(alerts.Count(a => a.Severity == AlertSeverity.Critical && !a.Acknowledged)).Gte(2)
            .Then(then => then.Element("charge-nurse-escalation").Show())
            .Else(els => els.Element("charge-nurse-escalation").Hide());

        // The open alerts' priorities add up to the shift's load; over 10 calls in a float nurse.
        p.When(alerts.Where(a => !a.Acknowledged).Sum(a => a.Priority)).Gt(10)
            .Then(then => then.Element("float-nurse").Show())
            .Else(els => els.Element("float-nurse").Hide());

        // The most urgent open alert decides whether the on-call physician is paged.
        p.When(alerts.OrderByDescending(a => a.Priority).Find(a => !a.Acknowledged, a => a.Severity)).Eq(AlertSeverity.Critical)
            .Then(then => then.Element("page-physician").Show())
            .Else(els => els.Element("page-physician").Hide());

        // Any open urgent alert, whatever its priority, needs a follow-up this shift.
        p.When(alerts.Where(a => a.Severity == AlertSeverity.Urgent && !a.Acknowledged).Any()).Truthy()
            .Then(then => then.Element("urgent-followup").Show())
            .Else(els => els.Element("urgent-followup").Hide());

        // Every alert acknowledged: the shift report is ready to sign.
        p.When(alerts.All(a => a.Acknowledged)).Truthy()
            .Then(then => then.Element("all-acknowledged").Show())
            .Else(els => els.Element("all-acknowledged").Hide());
    }));

    // A shift's alerts come from the alert log and are announced to the review.
    void OpenShift(PipelineBuilder<ShiftAlertReviewModel> p, string url) =>
        p.Get(url).Response(r => r.OnSuccess<ShiftAlertsResponse>((json, s) =>
            s.Dispatch<ShiftAlertsLoaded>(ShiftAlertEvents.Loaded, d => d
                .Set(x => x.Shift, json.Get(x => x.Shift))
                .Set(x => x.Alerts, json.Get(x => x.Alerts)))));

    var dayUrl = Url.SandboxRoute("DayShift", "ShiftReport");
    var eveningUrl = Url.SandboxRoute("EveningShift", "ShiftReport");
}

<native-vstack gap="Lg">
    <native-heading level="H1">Shift Alert Review</native-heading>
    <native-text color="Secondary">
        Maple wing. Review each shift's alerts before you sign the shift report.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("day-shift-btn", "Day shift")
            .CssClass(ShiftButton)
            .Reactive(plan, evt => evt.Click, (_, p) => OpenShift(p, dayUrl)))
        @(Html.NativeButton("evening-shift-btn", "Evening shift")
            .CssClass(ShiftButton)
            .Reactive(plan, evt => evt.Click, (_, p) => OpenShift(p, eveningUrl)))
    </native-hstack>

    <p id="shift-choose" class="text-sm text-text-muted">Choose a shift to review its alerts.</p>

    <section id="shift-review" hidden>
        <native-card><native-card-body>
            <native-heading level="H2"><span id="shift-name"></span></native-heading>
            <native-vstack gap="Xs" class="mt-3 text-sm">
                <p id="alert-summary"><span id="alert-total"></span> alerts this shift, <span id="critical-count"></span> of them critical.</p>
                <p id="critical-priority">Critical alert priority: <span id="critical-priority-sum"></span> points.</p>
                <p id="most-urgent-critical">Most urgent critical alert: <span id="top-critical"></span>.</p>
            </native-vstack>
            <native-vstack gap="Xs" class="mt-4 text-sm font-medium">
                <p id="unack-warning" hidden class="text-red-700">A critical alert is still unacknowledged.</p>
                <p id="unack-clear" hidden class="text-green-700">Every critical alert is acknowledged.</p>
                <p id="charge-nurse-escalation" hidden class="text-red-700">Escalate to the charge nurse: two or more critical alerts are unacknowledged.</p>
                <p id="float-nurse" hidden class="text-amber-700">The open alert load is high: call in a float nurse.</p>
                <p id="page-physician" hidden class="text-red-700">Page the on-call physician: the most urgent open alert is critical.</p>
                <p id="urgent-followup" hidden class="text-amber-700">Follow up on the urgent alerts this shift.</p>
                <p id="all-acknowledged" hidden class="text-green-700">Every alert this shift is acknowledged. The shift report is ready to sign.</p>
            </native-vstack>
        </native-card-body></native-card>
    </section>
</native-vstack>

@Html.RenderPlan(plan)
