@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Native.CheckList
@model FallPreventionRound
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Fall Prevention Round";

    const string FormId = "fall-round-form";

    var plan = Html.ReactivePlan<FallPreventionRound>();

    // The hourly-checks banner follows the risk factors, starting from the ones on file.
    Html.On(plan, t => t.DomReady(p =>
    {
        var riskFactors = p.Component<NativeCheckList>(m => m.RiskFactors);
        p.When(riskFactors.Value).ArrayContains(FallPrevention.RecentFall)
            .Then(recentFall => recentFall.Element("hourly-checks").Show());
    }));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Fall Prevention Round</native-heading>
    <native-text color="Secondary">
        Night shift, Birch wing. Edith Morales, Birch 112. Confirm her fall risk factors, tick the precautions
        in place tonight, and record the round.
    </native-text>

    <p id="hourly-checks" hidden class="rounded-md bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800">
        High fall risk: check on Edith every hour tonight.
    </p>

    <native-card><native-card-body>
        <form id="@FormId" class="space-y-6">
            @{ Html.InputField(plan, m => m.RiskFactors, o => o.Label("Fall risk factors"))
                .NativeCheckList(b => b
                    .Option(FallPrevention.RecentFall, FallPrevention.RecentFall, "Any fall, seen or found, since the last care conference.")
                    .Option(FallPrevention.NightSedative, FallPrevention.NightSedative, "Zolpidem, trazodone or another bedtime medication.")
                    .Option(FallPrevention.NightBathroomTrips, FallPrevention.NightBathroomTrips, "More than once on most nights.")
                    .Option(FallPrevention.UsesWalker, FallPrevention.UsesWalker, "Walker kept within reach of the bed."))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    p.When(args.Value).ArrayContains(FallPrevention.RecentFall)
                        .Then(recentFall => recentFall.Element("hourly-checks").Show())
                        .Else(noRecentFall => noRecentFall.Element("hourly-checks").Hide());
                }); }

            @{ Html.InputField(plan, m => m.Precautions, o => o.Required().Label("Precautions in place tonight"))
                .NativeCheckList(b => b
                    .Option(FallPrevention.LowBed)
                    .Option(FallPrevention.CallLight)
                    .Option(FallPrevention.NonSlipSocks)
                    .Option(FallPrevention.BedAlarm)
                    .Option(FallPrevention.NightLight)); }

            @(Html.NativeButton("same-as-last-night-btn", "Same precautions as last night")
                .CssClass("rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Get(Url.SandboxRoute("LastNightRound", "NativeCheckList"))
                     .Response(r => r.OnSuccess<LastNightPrecautions>((lastNight, s) =>
                        s.Component<NativeCheckList>(m => m.Precautions).Value.Set(lastNight.Get(x => x.Precautions))))))

            @{ Html.InputField(plan, m => m.CheckedBy, o => o.Required().Label("Checked by"))
                .NativeTextBox(b => b.Placeholder("Your initials")); }
        </form>

        <native-hstack gap="Base" class="mt-6">
            @(Html.NativeButton("record-fall-round-btn", "Record Round")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post(Url.SandboxRoute("RecordFallRound", "NativeCheckList")).Gather(g => g.Form())
                     .Validate<FallPreventionRoundValidator>(FormId)
                     .Response(r => r
                        .OnSuccess<FallRoundRecorded>((json, s) => s.Element("fall-round-status").Text.Set(json.Get(x => x.Summary)))
                        .OnError(400, e => e.ValidationErrors(FormId)));
                }))
            <p id="fall-round-status" class="text-sm text-text-muted">The round is not recorded yet.</p>
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
