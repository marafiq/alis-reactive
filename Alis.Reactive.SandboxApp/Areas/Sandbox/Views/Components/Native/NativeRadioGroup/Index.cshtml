@model NativeRadioGroupModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Move-in Preferences";

    const string FormId = "move-in-preferences";
    const string MemoryCare = "Memory Care";
    const string Suite = "Private suite";

    var plan = Html.ReactivePlan<NativeRadioGroupModel>();
    var roomTypes = (IReadOnlyList<RadioButtonItem>)ViewBag.RoomTypes;

    // What a care level brings, chosen by the coordinator or taken from the referral: the summary, the
    // assessment before move-in, and the warning that the memory care floor has no suites.
    void CareLevelChosen(PipelineBuilder<NativeRadioGroupModel> p, ReadOnly<string> careLevel)
    {
        p.Element("summary-care").Text.Set(careLevel);
        p.When(careLevel).Eq(MemoryCare)
            .Then(memory => memory.Element("assessment-notice").Text.Set("A memory care assessment is booked before move-in day."))
            .Else(other => other.Element("assessment-notice").Text.Set("No assessment is needed before move-in."));
        p.When(careLevel).Eq(MemoryCare).And(p.Component<NativeRadioGroup>(m => m.RoomType).Value).Eq(Suite)
            .Then(warn => warn.Element("suite-warning").Show())
            .Else(clear => clear.Element("suite-warning").Hide());
    }
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Move-in Preferences: Dorothy Price</native-heading>
        <native-text color="Secondary">Dorothy moves in on 1 November. Record her care level, room and meals so the care team, housekeeping and the kitchen are ready.</native-text>
    </div>

    <native-grid cols="C2" gap="Lg">
        <native-card><native-card-body id="@FormId">
            <native-vstack gap="Lg">
                @Html.HiddenFieldFor(plan, m => m.ResidentId)

                @{ Html.InputField(plan, m => m.CareLevel, o => o.Required().Label("Care level"))
                    .NativeRadioGroup(b => b
                        .Option("Independent Living", "Independent Living", "Her own apartment, with community services when she wants them")
                        .Option("Assisted Living", "Assisted Living", "Daily help with meals, bathing and medication")
                        .Option(MemoryCare, MemoryCare, "A secure floor for residents living with dementia")
                        .Option("Skilled Nursing", "Skilled Nursing", "Licensed nursing around the clock"))
                    .Reactive(evt => evt.Change, (args, p) => CareLevelChosen(p, args.Value)); }
                @(Html.NativeButton("use-referral-care-level-btn", "Use the referral's care level")
                    .CssClass("self-start rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Get(Url.SandboxRoute("Referral", "NativeRadioGroup"))
                         .Response(r => r.OnSuccess<MoveInReferral>((referral, s) =>
                         {
                             var careLevel = s.Component<NativeRadioGroup>(m => m.CareLevel);
                             careLevel.Value.Set(referral.Get(x => x.CareLevel));
                             CareLevelChosen(s, careLevel.Value);
                         }))))
                <p id="assessment-notice" class="text-sm text-text-secondary">Choose a care level to see what happens before move-in.</p>

                @{ Html.InputField(plan, m => m.RoomType, o => o.Required().Label("Room type"))
                    .NativeRadioGroup(b => b.Items(roomTypes))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.Element("summary-room").Text.Set(args.Value);
                        p.When(args.Value).Eq(Suite).And(p.Component<NativeRadioGroup>(m => m.CareLevel).Value).Eq(MemoryCare)
                            .Then(warn => warn.Element("suite-warning").Show())
                            .Else(clear => clear.Element("suite-warning").Hide());
                    }); }
                <p id="suite-warning" hidden class="text-sm text-amber-700">The memory care floor has no suites.</p>

                @{ Html.InputField(plan, m => m.MealPlan, o => o.Required().Label("Meal plan"))
                    .NativeRadioGroup(b => b
                        .Option("Standard")
                        .Option("Vegetarian")
                        .Option("Diabetic")
                        .Option("Kosher"))
                    .Reactive(evt => evt.Change, (args, p) => p.Element("summary-meals").Text.Set(args.Value)); }

                <native-hstack gap="Sm" align="Center" class="flex-wrap">
                    @(Html.NativeButton("save-preferences-btn", "Save Preferences")
                        .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                        .Reactive(plan, evt => evt.Click, (args, p) =>
                            p.Post(Url.SandboxRoute("Save", "NativeRadioGroup")).Gather(g => g.Form())
                                .Validate<MoveInPreferencesValidator>(FormId)
                                .Response(r => r
                                    .OnSuccess<MoveInPreferencesSaved>((saved, s) =>
                                        s.Element("preferences-status").Text.Set(saved.Get(x => x.Message)))
                                    .OnError(400, e => e.ValidationErrors(FormId)))))
                    <p id="preferences-status" class="text-sm text-text-muted"></p>
                </native-hstack>
            </native-vstack>
        </native-card-body></native-card>

        <native-card><native-card-body>
            <native-vstack gap="Sm">
                <native-heading level="H2">Move-in summary</native-heading>
                <p class="text-sm">Care level: <span id="summary-care" class="font-medium">Not chosen</span></p>
                <p class="text-sm">Room: <span id="summary-room" class="font-medium">Not chosen</span></p>
                <p class="text-sm">Meals: <span id="summary-meals" class="font-medium">Not chosen</span></p>
            </native-vstack>
        </native-card-body></native-card>
    </native-grid>
</native-vstack>

@Html.RenderPlan(plan)
