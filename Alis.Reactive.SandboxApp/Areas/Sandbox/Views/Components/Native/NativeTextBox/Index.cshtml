@model NativeTextBoxModel
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Visitor Sign-in";

    const string FormId = "visitor-sign-in";
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";
    const string NoName = "No name yet";
    const string LookupHint = "A returning visitor is found by their phone number.";

    var plan = Html.ReactivePlan<NativeTextBoxModel>();
    var residents = (SelectListItem[])ViewBag.Residents;
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Visitor Sign-in</native-heading>
        <native-text color="Secondary">Maple Grove front desk. Sign every visitor in before they go up to see a resident.</native-text>
    </div>

    <native-grid cols="C2" gap="Lg">
        <native-card><native-card-body id="@FormId">
            <native-vstack gap="Base">
                @{ Html.InputField(plan, m => m.Phone, o => o.Label("Phone"))
                    .NativeTextBox(b => b.Type("tel").Placeholder("555-0142").CssClass(Field))
                    .Reactive(evt => evt.Change, (args, p) =>
                        p.When(args.Value).NotEmpty()
                            .Then(lookup => lookup.Get(Url.SandboxRoute("FindReturningVisitor", "NativeTextBox"))
                                .Gather<ReturningVisitorQuery>(g => g.Set(x => x.Phone, args.Value))
                                .Response(r => r
                                    .OnSuccess<ReturningVisitor>((visitor, s) =>
                                    {
                                        // Writing the name raises no change, so the badge reads the name just written.
                                        var name = s.Component<NativeTextBox>(m => m.VisitorName);
                                        name.Value.Set(visitor.Get(x => x.Name));
                                        s.Element("badge-name").Text.Set(name.Value);
                                        s.Element("phone-lookup").Text.Set(visitor.Get(x => x.Welcome));
                                    })
                                    .OnError(404, unknown =>
                                    {
                                        unknown.Element("phone-lookup").Text.Set("No visit on file for this number. Write the visitor's name.");
                                        unknown.Component<NativeTextBox>(m => m.VisitorName).Focus();
                                    })))
                            .Else(none => none.Element("phone-lookup").Text.Set(LookupHint))); }
                <p id="phone-lookup" class="text-sm text-text-muted">@LookupHint</p>

                @{ Html.InputField(plan, m => m.VisitorName, o => o.Required().Label("Visitor's name"))
                    .NativeTextBox(b => b.Placeholder("First and last name").CssClass(Field))
                    .Reactive(evt => evt.Change, (args, p) =>
                        p.When(args.Value).IsEmpty()
                            .Then(unnamed => unnamed.Element("badge-name").Text.Set(NoName))
                            .Else(named => named.Element("badge-name").Text.Set(args.Value))); }

                @{ Html.InputField(plan, m => m.ResidentVisited, o => o.Required().Label("Visiting"))
                    .NativeDropDown(b => b.Items(residents).Placeholder("-- Choose the resident --").CssClass(Field)); }

                <native-hstack gap="Sm" align="Center" class="flex-wrap">
                    @(Html.NativeButton("sign-in-btn", "Sign In")
                        .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                        .Reactive(plan, evt => evt.Click, (args, p) =>
                            p.Post(Url.SandboxRoute("SignIn", "NativeTextBox")).Gather(g => g.Form())
                                .Validate<VisitorSignInValidator>(FormId)
                                .Response(r => r
                                    .OnSuccess<VisitorSignedIn>((signedIn, s) =>
                                    {
                                        s.Element("sign-in-status").Text.Set(signedIn.Get(x => x.Message));

                                        // Ready for the next visitor: an empty form, a blank badge, the cursor in the phone.
                                        var phone = s.Component<NativeTextBox>(m => m.Phone);
                                        phone.Value.Set("");
                                        s.Component<NativeTextBox>(m => m.VisitorName).Value.Set("");
                                        s.Component<NativeDropDown>(m => m.ResidentVisited).Value.Set("");
                                        s.Element("badge-name").Text.Set(NoName);
                                        s.Element("phone-lookup").Text.Set(LookupHint);
                                        phone.Focus();
                                    })
                                    .OnError(400, e => e.ValidationErrors(FormId)))))
                    <p id="sign-in-status" class="text-sm text-text-muted"></p>
                </native-hstack>
            </native-vstack>
        </native-card-body></native-card>

        <native-card><native-card-body>
            <native-vstack gap="Xs">
                <p class="text-xs font-medium uppercase tracking-wide text-text-muted">Visitor badge</p>
                <p id="badge-name" class="text-2xl font-semibold">@NoName</p>
                <native-text color="Secondary">Maple Grove. Wear this badge while in the building.</native-text>
            </native-vstack>
        </native-card-body></native-card>
    </native-grid>
</native-vstack>

@Html.RenderPlan(plan)
