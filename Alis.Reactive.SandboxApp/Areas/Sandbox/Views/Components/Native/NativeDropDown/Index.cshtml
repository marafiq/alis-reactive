@model NativeDropDownModel
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Van Booking";

    const string FormId = "van-booking";
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";

    var plan = Html.ReactivePlan<NativeDropDownModel>();
    var residents = (SelectListItem[])ViewBag.Residents;
    var trips = (SelectListItem[])ViewBag.Trips;
    var departures = (SelectListItem[])ViewBag.Departures;
    var escorts = (SelectListItem[])ViewBag.Escorts;
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Van Booking</native-heading>
        <native-text color="Secondary">Book the community van for a resident's trip. The van seats one wheelchair and four riders.</native-text>
    </div>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            <native-grid cols="C2" gap="Base">
                @{ Html.InputField(plan, m => m.ResidentId, o => o.Required().Label("Resident"))
                    .NativeDropDown(b => b.Items(residents).Placeholder("-- Choose the resident --").CssClass(Field)); }

                @{ Html.InputField(plan, m => m.Trip, o => o.Required().Label("Trip"))
                    .NativeDropDown(b => b.Items(trips).Placeholder("-- Choose the trip --").CssClass(Field))
                    .Reactive(evt => evt.Change, (args, p) =>
                        p.When(args.Value).Eq("Medical appointment")
                            .Then(medical =>
                            {
                                // A nurse aide goes with every medical appointment.
                                medical.Component<NativeDropDown>(m => m.Escort).Value.Set("Nurse aide");
                                medical.Element("medical-note").Show();
                            })
                            .Else(other => other.Element("medical-note").Hide())); }

                @{ Html.InputField(plan, m => m.Departure, o => o.Required().Label("Leaves at"))
                    .NativeDropDown(b => b.Items(departures).Placeholder("-- Choose the time --").CssClass(Field)); }

                @{ Html.InputField(plan, m => m.Escort, o => o.Label("Escort"))
                    .NativeDropDown(b => b.Items(escorts).CssClass(Field)); }
            </native-grid>

            <p id="medical-note" hidden class="text-sm text-text-secondary">
                A nurse aide goes with every medical appointment. Bring the resident's medication list and insurance card.
            </p>
            <p id="van-busy" hidden class="text-sm text-amber-700">
                The van is out at <span id="van-busy-time"></span>. <span id="van-next-free"></span> is free and now chosen; book again to confirm.
            </p>

            <native-hstack gap="Sm" align="Center" class="flex-wrap">
                @(Html.NativeButton("book-van-btn", "Book the Van")
                    .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Post(Url.SandboxRoute("Book", "NativeDropDown")).Gather(g => g.Form())
                            .Validate<VanBookingValidator>(FormId)
                            .Response(r => r
                                .OnSuccess<VanBooked>((booked, s) =>
                                {
                                    s.Element("van-busy").Hide();
                                    s.Element("booking-status").Text.Set(booked.Get(x => x.Message));
                                })
                                .OnError<VanBusy>(409, (busy, e) =>
                                {
                                    // Say which time was asked for, choose the next free one, and leave the cursor there.
                                    var departure = e.Component<NativeDropDown>(m => m.Departure);
                                    e.Element("van-busy-time").Text.Set(departure.Value);
                                    departure.Value.Set(busy.Get(x => x.NextFree));
                                    e.Element("van-next-free").Text.Set(departure.Value);
                                    e.Element("van-busy").Show();
                                    departure.Focus();
                                })
                                .OnError(400, e => e.ValidationErrors(FormId)))))
                <p id="booking-status" class="text-sm text-text-muted"></p>
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
