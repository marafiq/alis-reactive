@model NativeTextAreaModel
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Shift Handover";

    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string Template = "Vitals:\nMeals:\nMedications:\nFalls or incidents:\nFamily calls:";

    var plan = Html.ReactivePlan<NativeTextAreaModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Shift Handover</native-heading>
        <native-text color="Secondary">Maple wing, evening to night. Write what the night nurse needs to know before you leave.</native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <div id="handover-form" class="flex flex-col gap-4">
            @{ Html.InputField(plan, m => m.HandoverNote, o => o.Label("Handover for the night nurse"))
                .NativeTextArea(b => b.Rows(8).Placeholder("How the shift went, resident by resident").CssClass(Field)); }

            @{ Html.InputField(plan, m => m.Incident, o => o.Label("Incident this shift"))
                .NativeTextArea(b => b.Rows(3).Placeholder("A fall, a refusal, a family complaint").CssClass(Field))
                .Reactive(evt => evt.Change, (args, p) =>
                    p.When(args.Value).IsEmpty()
                        .Then(none =>
                        {
                            none.Element("incident-flag").Hide();
                            none.Element("incident-none").Show();
                        })
                        .Else(incident =>
                        {
                            incident.Element("incident-flag-text").Text.Set(args.Value);
                            incident.Element("incident-flag").Show();
                            incident.Element("incident-none").Hide();
                        })); }
            </div>
            <p id="incident-none" class="text-sm text-text-muted">No incidents this shift.</p>
            <p id="incident-flag" hidden class="rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-800">
                The night nurse reads this first: <span id="incident-flag-text"></span>
            </p>

            <native-hstack gap="Sm" align="Center" class="flex-wrap">
                @(Html.NativeButton("handover-template-btn", "Start from the Template")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var handover = p.Component<NativeTextArea>(m => m.HandoverNote);
                        handover.Value.Set(Template);
                        handover.Focus();
                    }))
                @(Html.NativeButton("send-handover-btn", "Send Handover")
                    .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var handover = p.Component<NativeTextArea>(m => m.HandoverNote);
                        p.When(handover.Value).IsEmpty()
                            .Then(empty =>
                            {
                                empty.Element("handover-status").Text.Set("Write the handover before sending it.");
                                empty.Component<NativeTextArea>(m => m.HandoverNote).Focus();
                            })
                            .Else(written => written.Post(Url.SandboxRoute("Send", "NativeTextArea")).Gather(g => g.Form("handover-form"))
                                .Response(r => r.OnSuccess<ShiftHandoverSent>((sent, s) =>
                                    s.Element("handover-status").Text.Set(sent.Get(x => x.Message)))));
                    }))
                <p id="handover-status" class="text-sm text-text-muted"></p>
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
