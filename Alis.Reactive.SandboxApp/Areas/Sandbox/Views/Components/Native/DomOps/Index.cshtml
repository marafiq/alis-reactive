@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Native.DomOps
@model LunchSeatingModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Lunch Seating";

    const string FlagButton = "mt-4 rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string Badge = "rounded-full bg-surface-muted px-2 py-0.5";
    const string Figure = "flex justify-between gap-4 border-b border-border/60 py-1";

    var plan = Html.ReactivePlan<LunchSeatingModel>();

    // A table's flags are its card's classes; the ones that start "risk-" are its safety risks.
    void CountFlags(PipelineBuilder<LunchSeatingModel> p, string table)
    {
        var flags = p.Element(table).ClassList.Items;
        p.Element($"{table}-flag-count").Text.Set(flags.Count());
        p.Element($"{table}-risk-count").Text.Set(flags.Where(flag => flag.StartsWith("risk-")).Count());
    }

    // What the supervisor reads off a table before service: who sits there, who needs a staff member
    // close by, which plates the kitchen restricts in sodium, and the table's own flags.
    void ReadTable(PipelineBuilder<LunchSeatingModel> p, string table)
    {
        var seats = p.Element($"{table}-seats").Children;
        p.Element($"{table}-seated").Text.Set(seats.Count());
        p.Element($"{table}-close-supervision").Text.Set(seats.Count(seat => seat.GetAttribute("data-supervision") == "close"));
        p.Element($"{table}-sodium-plates").Text.Set(seats.Count(seat => seat.GetAttribute("data-diet")!.Contains("sodium")));
        p.Element($"{table}-low-sodium-line").Text.Set(seats.Count(seat => seat.GetAttribute("data-diet")!.EndsWith("sodium")));
        CountFlags(p, table);

        p.When(p.Element(table).ClassList.Items.Any(flag => flag == "memory-care")).Truthy()
            .Then(memoryCare => memoryCare.Element($"{table}-memory-care").Show())
            .Else(other => other.Element($"{table}-memory-care").Hide());
    }

    // A fall risk flagged at the table joins its flags at once, and its safety risks are counted again.
    void FlagFallRisk(PipelineBuilder<LunchSeatingModel> p, string table)
    {
        p.Element(table).ClassList.Add("risk-fall");
        p.Element($"{table}-fall-risk").Show();
        CountFlags(p, table);
    }

    Html.On(plan, t => t.DomReady(p =>
    {
        ReadTable(p, "table-4");
        ReadTable(p, "table-5");
    }));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Lunch Seating</native-heading>
    <native-text color="Secondary">
        Maple dining room, 12:00 lunch. Check each table's needs before service starts.
    </native-text>

    <native-grid cols="C2" gap="Base">
        <section id="table-4" class="risk-choking risk-allergy memory-care choking-risk-reviewed">
            <native-card><native-card-body>
                <native-heading level="H2">Table 4, by the window</native-heading>
                <ul class="mt-2 flex flex-wrap gap-2 text-xs">
                    <li class="@Badge">Choking risk</li>
                    <li class="@Badge">Food allergy</li>
                    <li class="@Badge">Memory care</li>
                    <li class="@Badge">Choking risk reviewed</li>
                    <li id="table-4-fall-risk" hidden class="@Badge">Fall risk</li>
                </ul>
                <ul id="table-4-seats" class="mt-3 space-y-1 text-sm">
                    <li data-supervision="close" data-diet="low-sodium">Margaret Hale: low sodium, close supervision</li>
                    <li data-supervision="standby" data-diet="sodium-restricted">Walter Brooks: sodium restricted (2 g)</li>
                    <li data-supervision="close" data-diet="reduced-sodium">Evelyn Hart: reduced sodium, close supervision</li>
                    <li data-supervision="standby" data-diet="diabetic">Harold Kim: diabetic</li>
                </ul>
                <dl class="mt-3 text-sm">
                    <div class="@Figure"><dt>Seated</dt><dd id="table-4-seated" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Close supervision</dt><dd id="table-4-close-supervision" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Sodium-restricted plates</dt><dd id="table-4-sodium-plates" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Plates from the low-sodium line</dt><dd id="table-4-low-sodium-line" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Table flags</dt><dd id="table-4-flag-count" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Safety risks</dt><dd id="table-4-risk-count" class="font-medium">&mdash;</dd></div>
                </dl>
                <p id="table-4-memory-care" hidden class="mt-3 text-sm font-medium text-amber-800">
                    Memory care table: a staff member sits with this table through the meal.
                </p>
                @(Html.NativeButton("table-4-flag-fall-risk-btn", "Flag a Fall Risk")
                    .CssClass(FlagButton)
                    .Reactive(plan, evt => evt.Click, (_, p) => FlagFallRisk(p, "table-4")))
            </native-card-body></native-card>
        </section>

        <section id="table-5" class="risk-allergy wheelchair-access allergy-risk-reviewed">
            <native-card><native-card-body>
                <native-heading level="H2">Table 5, by the door</native-heading>
                <ul class="mt-2 flex flex-wrap gap-2 text-xs">
                    <li class="@Badge">Food allergy</li>
                    <li class="@Badge">Wheelchair access</li>
                    <li class="@Badge">Allergy risk reviewed</li>
                    <li id="table-5-fall-risk" hidden class="@Badge">Fall risk</li>
                </ul>
                <ul id="table-5-seats" class="mt-3 space-y-1 text-sm">
                    <li data-supervision="standby" data-diet="regular">Rose Delgado: regular</li>
                    <li data-supervision="close" data-diet="sodium-restricted">Agnes Moore: sodium restricted (2 g), close supervision</li>
                    <li data-supervision="standby" data-diet="no-added-salt">Ida Bell: no added salt</li>
                </ul>
                <dl class="mt-3 text-sm">
                    <div class="@Figure"><dt>Seated</dt><dd id="table-5-seated" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Close supervision</dt><dd id="table-5-close-supervision" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Sodium-restricted plates</dt><dd id="table-5-sodium-plates" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Plates from the low-sodium line</dt><dd id="table-5-low-sodium-line" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Table flags</dt><dd id="table-5-flag-count" class="font-medium">&mdash;</dd></div>
                    <div class="@Figure"><dt>Safety risks</dt><dd id="table-5-risk-count" class="font-medium">&mdash;</dd></div>
                </dl>
                <p id="table-5-memory-care" hidden class="mt-3 text-sm font-medium text-amber-800">
                    Memory care table: a staff member sits with this table through the meal.
                </p>
                @(Html.NativeButton("table-5-flag-fall-risk-btn", "Flag a Fall Risk")
                    .CssClass(FlagButton)
                    .Reactive(plan, evt => evt.Click, (_, p) => FlagFallRisk(p, "table-5")))
            </native-card-body></native-card>
        </section>
    </native-grid>
</native-vstack>

@Html.RenderPlan(plan)
