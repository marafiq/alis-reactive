@model DomOpsModel
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "DomOps";

    var plan = Html.ReactivePlan<DomOpsModel>();

    // A class list and a child list are arrays: the array operators run over them in the browser.
    Html.On(plan, t => t.DomReady(p =>
    {
        p.Element("dom-total-classes").Text.Set(p.Element("dom-card").ClassList.Items.Count());
        p.Element("dom-risk-count").Text.Set(
            p.Element("dom-card").ClassList.Items.Where(x => x.StartsWith("risk-")).Count());
        p.Element("dom-child-count").Text.Set(p.Element("dom-list").Children.Count());

        p.When(p.Element("dom-card").ClassList.Items.Any(x => x == "care-memory")).Truthy()
         .Then(then => then.Element("dom-memory-yes").Show())
         .Else(els => els.Element("dom-memory-no").Show());

        // RuntimePath.call invokes getAttribute at each DOM child element scope.
        p.Element("dom-high-risk-count").Text.Set(
            p.Element("risk-list").Children.Count(x => x.GetAttribute("data-risk") == "high"));

        // Diets named for sodium: "low-sodium", "sodium-free" and "reduced-sodium" all mention it; only the
        // first and last are limited-sodium diets, named so at their end.
        p.Element("dom-sodium-diets").Text.Set(
            p.Element("risk-list").Children.Count(x => x.GetAttribute("data-diet")!.Contains("sodium")));
        p.Element("dom-limited-sodium").Text.Set(
            p.Element("risk-list").Children.Count(x => x.GetAttribute("data-diet")!.EndsWith("sodium")));
    }));

    // Follow-up read observes the class added earlier in the same reaction.
    Html.NativeButton("dom-add-risk-btn", "Add Risk Flag")
        .Reactive(plan, evt => evt.Click, (args, p) =>
        {
            p.Element("dom-card").ClassList.Add("risk-extra");
            p.Element("dom-risk-count").Text.Set(
                p.Element("dom-card").ClassList.Items.Where(x => x.StartsWith("risk-")).Count());
        });
}

<native-vstack gap="Lg">
    <native-heading level="H1">DomOps</native-heading>
    <native-text color="Secondary">
        The array DSL over native DOM. <code>p.Element("dom-card").ClassList.Items.Where(x =&gt; x.StartsWith("risk-")).Count()</code>
        reads a DOM element by id, normalizes its DOMTokenList, and counts — deterministically, in the plan.
    </native-text>

    <native-card><native-card-body>
        <div id="dom-card" class="risk-fall risk-oxygen care-memory fall-risk-reviewed"></div>
        <ul id="dom-list" hidden><li>Physio</li><li>Dining</li><li>Social</li></ul>
        <ul id="risk-list" hidden>
            <li data-risk="high" data-diet="low-sodium">Mrs. A</li>
            <li data-risk="low" data-diet="sodium-free">Mr. B</li>
            <li data-risk="high" data-diet="reduced-sodium">Ms. C</li>
        </ul>

        <native-vstack gap="Sm" class="font-mono text-sm">
            <p>Total classes: <span id="dom-total-classes">&mdash;</span></p>
            <p>Risk flags (class starts with "risk-"): <span id="dom-risk-count">&mdash;</span></p>
            <p>List children: <span id="dom-child-count">&mdash;</span></p>
            <p>High-risk children (per-element <code>getAttribute</code>): <span id="dom-high-risk-count">&mdash;</span></p>
            <p>Sodium-restricted diets: <span id="dom-sodium-diets">&mdash;</span> &middot; low or reduced sodium: <span id="dom-limited-sodium">&mdash;</span></p>
            <p id="dom-memory-yes" hidden class="text-amber-600">Memory-care class present</p>
            <p id="dom-memory-no" hidden class="text-green-600">No memory-care class</p>
        </native-vstack>

        @(Html.NativeButton("dom-add-risk-btn", "Add Risk Flag")
            .CssClass("mt-3 rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors"))
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
