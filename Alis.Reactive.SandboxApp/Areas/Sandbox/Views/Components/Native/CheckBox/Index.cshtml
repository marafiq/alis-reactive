@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Native.CheckBox
@model ShowerLog
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Shower Log";

    const string FormId = "shower-log-form";
    const string Box = "h-4 w-4 rounded border-border text-accent";

    var plan = Html.ReactivePlan<ShowerLog>();

    // The shower chair note follows the care plan's answer when the log opens.
    Html.On(plan, t => t.DomReady(p =>
    {
        var showerChair = p.Component<NativeCheckBox>(m => m.UsesShowerChair);
        p.When(showerChair.Checked).Truthy()
            .Then(chair => chair.Element("shower-chair-note").Show());
    }));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Shower Log</native-heading>
    <native-text color="Secondary">
        Evening showers, Willow wing. Dorothy Reyes, Willow 108. Tick what happened and save the log before
        the end of the shift.
    </native-text>

    <native-card><native-card-body>
        <form id="@FormId" class="flex flex-col gap-4">
            @{ Html.InputField(plan, m => m.ShowerDeclined, o => o.Label("Dorothy declined the shower"))
                .NativeCheckBox(b => b.CssClass(Box))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    p.When(args.Checked).Truthy()
                        .Then(declined =>
                        {
                            declined.Component<NativeCheckBox>(m => m.WaterTemperatureChecked).Checked.Set(false);
                            declined.Element("shower-details").Hide();
                            declined.Element("offer-again").Show();
                        })
                        .Else(taken =>
                        {
                            taken.Element("shower-details").Show();
                            taken.Element("offer-again").Hide();
                        });
                }); }
            <p id="offer-again" hidden class="text-sm text-text-secondary">Offer the shower again before 9 pm.</p>

            <div id="shower-details" class="flex flex-col gap-4">
                @{ Html.InputField(plan, m => m.UsesShowerChair, o => o.Label("Uses a shower chair"))
                    .NativeCheckBox(b => b.CssClass(Box))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.When(args.Checked).Truthy()
                            .Then(chair => chair.Element("shower-chair-note").Show())
                            .Else(noChair => noChair.Element("shower-chair-note").Hide());
                    }); }
                <p id="shower-chair-note" hidden class="text-sm text-text-secondary">
                    Bring the shower chair from the Willow supply room.
                </p>

                @{ Html.InputField(plan, m => m.WaterTemperatureChecked, o => o.Label("Water temperature checked"))
                    .NativeCheckBox(b => b.CssClass(Box)); }
            </div>

            @{ Html.InputField(plan, m => m.SkinConcern, o => o.Label("Skin concern noticed"))
                .NativeCheckBox(b => b.CssClass(Box))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    p.When(args.Checked).Truthy()
                        .Then(concern =>
                        {
                            concern.Element("skin-concern-step").Show();
                            concern.Component<NativeCheckBox>(m => m.NurseTold).Focus();
                        })
                        .Else(noConcern => noConcern.Element("skin-concern-step").Hide());
                }); }
            <div id="skin-concern-step" hidden class="flex flex-col gap-2 rounded-md bg-slate-100 p-4">
                <p class="text-sm">Tell the nurse on duty what you saw before the end of the shift.</p>
                @{ Html.InputField(plan, m => m.NurseTold, o => o.Label("Nurse on duty told"))
                    .NativeCheckBox(b => b.CssClass(Box)); }
            </div>
        </form>

        <native-hstack gap="Base" align="Center" class="mt-6">
            @(Html.NativeButton("save-shower-log-btn", "Save Shower Log")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post(Url.SandboxRoute("SaveShowerLog", "CheckBox")).Gather(g => g.Form())
                     .Validate<ShowerLogValidator>(FormId)
                     .Response(r => r
                        .OnSuccess<ShowerLogSaved>((json, s) => s.Element("shower-log-status").Text.Set(json.Get(x => x.Summary))));
                }))
            <p id="shower-log-status" class="text-sm text-text-muted">The shower log is not saved yet.</p>
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
