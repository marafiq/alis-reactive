@model AccordionModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "My Care Plan";

    const string ButtonPrimary = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";

    var plan = Html.ReactivePlan<AccordionModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">My Care Plan</native-heading>
        <native-text color="Secondary">
            @Model.ResidentName — @Model.CommunityName. Open a section to read its details. Your care
            agreement section unlocks once you confirm you have reviewed it.
        </native-text>
    </div>

    <native-hstack gap="Sm" class="flex-wrap items-center">
        @(Html.NativeButton("open-summary", "Open my care plan summary")
            .CssClass(ButtonPrimary)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionAccordion>("care-plan").ExpandItem(true, 0);
            }))
        <native-text color="Secondary">
            Currently open: <span id="open-section" class="font-semibold text-text">No section open</span>
        </native-text>
    </native-hstack>

    <native-card><native-card-body>
        @(Html.FusionAccordion(plan, "care-plan", b => b
            .Items(new List<AccordionItem>
            {
                new AccordionItem
                {
                    Header = "My Care Team",
                    Content = "<div class='p-1 text-sm'><p class='mb-2'>Your care is coordinated by a dedicated team.</p>" +
                              "<ul class='list-disc pl-5 space-y-1'>" +
                              "<li>Primary nurse: Maria Alvarez, RN</li>" +
                              "<li>Care manager: David Chen</li>" +
                              "<li>Wellness coordinator: Priya Nair</li></ul></div>"
                },
                new AccordionItem
                {
                    Header = "My Services & Monthly Charges",
                    Content = "<div id='charges-detail' class='p-1 text-sm text-text-muted'>" +
                              "Open this section to load this month's charges.</div>"
                },
                new AccordionItem
                {
                    Header = "My Care Agreement",
                    Disabled = true,
                    Content = "<div class='p-1 text-sm'><p>Your signed care agreement dated 1 March 2026 is on file. " +
                              "A printed copy is available from the front desk on request.</p></div>"
                }
            }))
            .Reactive(evt => evt.Expanded, (args, p) =>
            {
                // Which section the resident is reading, named from the panel index.
                p.When(args, x => x.IsExpanded).Truthy()
                    .Then(open =>
                        open.When(args, x => x.Index).Eq(0)
                            .Then(t => t.Element("open-section").SetText("My Care Team"))
                            .ElseIf(args, x => x.Index).Eq(1)
                            .Then(t => t.Element("open-section").SetText("My Services & Monthly Charges"))
                            .Else(t => t.Element("open-section").SetText("My Care Agreement")))
                    .Else(closed => closed.Element("open-section").SetText("No section open"));

                // Charges detail is fetched on demand the first time the charges section opens.
                p.When(args, x => x.IsExpanded).Truthy()
                    .And(args, x => x.Index).Eq(1)
                    .Then(t => t
                        .Get(Url.SandboxRoute("MonthlyChargesDetail", "Accordion"))
                        .Response(r => r.OnSuccess(s => s.Into("charges-detail"))));
            }))
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Sm">
            <native-text>
                <span id="agreement-status" class="text-text-secondary">
                    Your care agreement section is locked until you confirm you have reviewed it.
                </span>
            </native-text>
            @(Html.NativeButton("confirm-agreement", "I have reviewed my care agreement")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionAccordion>("care-plan").EnableItem(2, true);
                    p.Element("agreement-status")
                        .SetText("Care agreement confirmed. Your care agreement section is now available.");
                }))
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
