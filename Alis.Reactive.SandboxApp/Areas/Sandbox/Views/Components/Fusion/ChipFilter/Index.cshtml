@model ChipFilterModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Buttons
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Residents by Care Level";

    var plan = Html.ReactivePlan<ChipFilterModel>();

    var columns = FusionGridColumns.Of<CareResident>();

    var careChips = new List<ChipCollection>
    {
        new() { Text = "Independent", Value = "independent" },
        new() { Text = "Assisted", Value = "assisted" },
        new() { Text = "Memory Care", Value = "memory" },
        new() { Text = "Skilled Nursing", Value = "skilled" },
    };

    // Applying the filters announces the selected chips: their data say whether Memory Care is listed, their
    // texts filter the roster on the server.
    Html.On(plan, t => t.CustomEvent<ChipFilterPayload>(ChipFilterEvents.FiltersApplied, (payload, p) =>
    {
        var selected = p.From(payload.Get(x => x.Selection.Data));

        p.Element("filter-count").Text.Set(selected.Count());

        p.When(selected.Any(c => c.Value == "memory")).Truthy()
         .Then(then => then.Element("memory-care-visits").Show())
         .Else(els => els.Element("memory-care-visits").Hide());

        p.Post(Url.SandboxRoute("Filter", "ChipFilter"))
         .Gather<CareFilterRequest>(g => g.Set(x => x.CareLevels, payload.Get(a => a.Selection.Texts)))
         .Response(r => r.OnSuccess<CareResidentResponse>((json, s) =>
             s.Component<FusionGrid>("care-grid").Rows<CareResident>().Set(json.Get(x => x.Residents))));
    }));

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("Residents", "ChipFilter"))
         .Response(r => r.OnSuccess<CareResidentResponse>((json, s) =>
             s.Component<FusionGrid>("care-grid").Rows<CareResident>().Set(json.Get(x => x.Residents))))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Residents by Care Level</native-heading>
    <native-text color="Secondary">
        Front desk. Pick the care levels to list, then apply the filters.
    </native-text>

    <native-card><native-card-body>
        @(Html.FusionChipList(plan, "care-filters", b => b
            .Chips(careChips)
            .Selection(Selection.Multiple)))

        <div class="mt-4 flex items-center gap-3">
            @(Html.NativeButton("apply-filters-btn", "Apply Filters")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Dispatch<ChipFilterPayload>(ChipFilterEvents.FiltersApplied, b =>
                        b.Set(x => x.Selection, p.Component<FusionChipList>("care-filters").GetSelectedChips()))))
        </div>

        <native-vstack gap="Xs" class="text-sm my-3">
            <p>Care levels selected: <span id="filter-count">&mdash;</span></p>
            <p id="memory-care-visits" hidden class="text-amber-700">
                Memory Care residents are listed: visits to them go through the secured wing's desk.
            </p>
        </native-vstack>

        @(Html.FusionGrid<ChipFilterModel, CareResident>(plan, "care-grid", b => b
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.Name), HeaderText = "Resident", Width = "160" },
                new GridColumn { Field = columns.Field(r => r.CareLevel), HeaderText = "Care Level", Width = "180" },
            })))
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
