@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentRosterViewModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Resident Roster";

    const string RosterId = "record-roster";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-subtle";

    // Grace Bennett's suite move is the one the record has approved today.
    const int GraceBennett = 6703;

    var plan = Html.ReactivePlan<ResidentRosterViewModel>();
    var columns = FusionGridColumns.Of<RecordRosterResident>();

    // A wing's tab: the record answers with the wing and its page of residents.
    void ShowWing(PipelineBuilder<ResidentRosterViewModel> p, string wing) =>
        p.Post(Url.SandboxRoute("RecordRosterWingResidents", "Grid"))
            .Gather<RecordRosterWingQuery>(g => g.Set(x => x.Wing, wing))
            .Response(r => r.OnSuccess<RecordRosterWing>((answer, s) =>
            {
                s.Component<FusionGrid>(RosterId).DataSource.Set(answer.Get(x => x.Page.Result));
                s.Element("roster-wing").Text.Set(answer.Get(x => x.Wing));
                s.Element("roster-record-status").Text.Set(answer.Get(x => x.Page.Summary));
            }));

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("RecordRosterCedar", "Grid"))
            .Response(r => r.OnSuccess<RecordRosterPage>((page, s) =>
            {
                s.Component<FusionGrid>(RosterId).DataSource.Set(page.Get(x => x.Result));
                s.Element("roster-record-status").Text.Set(page.Get(x => x.Summary));
            }))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Resident Roster</native-heading>
        <native-text color="Secondary">
            Resident services. The roster comes from the resident record; bring today's changes in the record onto it
            as they are approved.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Today in the record</native-heading>
        <ul class="mt-3 space-y-3">
            <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                <span><span class="font-medium">Rosa Diaz</span> moves into Cedar wing today</span>
                @(Html.NativeButton("roster-add-arrival", "Add to the roster")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Post(Url.SandboxRoute("RecordRosterTodaysArrival", "Grid"))
                            .Response(r => r.OnSuccess<RecordRosterArrival>((arrival, s) =>
                            {
                                s.Component<FusionGrid>(RosterId).AddRecordAt(arrival.Get(x => x.Resident), arrival.Get(x => x.Position));
                                s.Element("roster-record-status").Text.Set(arrival.Get(x => x.Summary));
                            }))))
            </li>
            <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                <span><span class="font-medium">Henry Liu</span>'s care level changed after his hospital stay</span>
                @(Html.NativeButton("roster-apply-care-level", "Apply the new care level")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Post(Url.SandboxRoute("RecordRosterCareLevel", "Grid"))
                            .Response(r => r.OnSuccess<RecordRosterUpdate>((update, s) =>
                            {
                                var roster = s.Component<FusionGrid>(RosterId);
                                roster.UpdateRow(roster.GetRowIndexByPrimaryKey(update.Get(x => x.Resident.ResidentId)), update.Get(x => x.Resident));
                                s.Element("roster-record-status").Text.Set(update.Get(x => x.Summary));
                            }))))
            </li>
            <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                <span><span class="font-medium">Grace Bennett</span>'s move to a larger suite is approved</span>
                @(Html.NativeButton("roster-show-suite-move", "Show the new suite")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Post(Url.SandboxRoute("RecordRosterSuiteMove", "Grid"))
                            .Response(r => r.OnSuccess<RecordRosterUpdate>((move, s) =>
                            {
                                s.Component<FusionGrid>(RosterId).SetRowData(GraceBennett, move.Get(x => x.Resident));
                                s.Element("roster-record-status").Text.Set(move.Get(x => x.Summary));
                            }))))
            </li>
        </ul>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <h2 class="text-lg font-semibold"><span id="roster-wing">Cedar</span> wing</h2>
        <native-hstack gap="Sm" class="mt-2 mb-4 flex-wrap">
            @(Html.NativeButton("roster-cedar-wing", "Cedar wing")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => ShowWing(p, "Cedar")))
            @(Html.NativeButton("roster-birch-wing", "Birch wing")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => ShowWing(p, "Birch")))
        </native-hstack>

        @(Html.FusionGrid<ResidentRosterViewModel, RecordRosterResident>(plan, RosterId, b => b
            .EditSettings(new GridEditSettings
            {
                AllowAdding = true,
                AllowEditing = true,
                AllowEditOnDblClick = false,
                Mode = EditMode.Normal
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "180" },
                new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "90" },
                new GridColumn { Field = columns.Field(r => r.CareLevel), HeaderText = "Care level", Width = "170" }
            })))

        <p id="roster-record-status" role="status" class="mt-4 text-sm">Loading the roster from the record.</p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
