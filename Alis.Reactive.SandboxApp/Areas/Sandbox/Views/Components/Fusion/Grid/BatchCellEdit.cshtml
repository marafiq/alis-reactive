@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.TaskCountViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Evening Task Count";

    const string GridId = "task-count-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";

    // No shift leaves more open tasks than this with one resident: a larger number is a slip of the keyboard.
    const int MostOpenTasks = 20;

    // At this many open tasks the night supervisor hears about the resident before the count is saved.
    const int SupervisorOpenTasks = 8;

    var plan = Html.ReactivePlan<TaskCountViewModel>();
    var columns = FusionGridColumns.Of<TaskCountRow>();
    var openTasks = Field.Of((TaskCountRow r) => r.OpenTasks);
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Evening Task Count</native-heading>
        <native-text color="Secondary">
            Maple wing, evening shift. Record each resident's open tasks and missed doses, then save the count
            for the night shift.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="mb-4 flex-wrap">
            @(Html.NativeButton("start-count", "Start the count")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(GridId).EditCell(0, openTasks)))
            @(Html.NativeButton("check-task-board", "Check the task board")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Post(Url.SandboxRoute("TaskCountTaskBoard", "Grid"))
                        .Response(r => r.OnSuccess<TaskBoardCount>((board, s) =>
                        {
                            s.Component<FusionGrid>(GridId).UpdateCell(board.Get(x => x.RowIndex), openTasks, board.Get(x => x.OpenTasks));
                            s.Element("count-status").Text.Set(board.Get(x => x.Summary));
                        }))))
            @(Html.NativeButton("review-count", "Review changes")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var grid = p.Component<FusionGrid>(GridId);
                    grid.SaveCell();
                    p.Post(Url.SandboxRoute("TaskCountReview", "Grid"))
                        .Gather<TaskCountChanges>(g => g.Set(x => x.Changes, grid.GetBatchChanges<TaskCountRow>()))
                        .Response(r => r.OnSuccess<TaskCountSummary>((review, s) =>
                            s.Element("count-status").Text.Set(review.Get(x => x.Summary))));
                }))
            @(Html.NativeButton("save-count", "Save the count")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(GridId).EndEdit()))
        </native-hstack>

        @(Html.FusionGrid<TaskCountViewModel, TaskCountRow>(plan, GridId, b => b
            .DataSource(Model.Residents)
            .EditSettings(new GridEditSettings { AllowEditing = true, Mode = EditMode.Batch, ShowConfirmDialog = false })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.Room), HeaderText = "Room", Width = "90", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "180", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.OpenTasks), HeaderText = "Open tasks", Width = "130", TextAlign = TextAlign.Right, EditType = "numericedit" },
                new GridColumn { Field = columns.Field(r => r.MissedDoses), HeaderText = "Missed doses", Width = "140", TextAlign = TextAlign.Right, EditType = "numericedit" }
            }))
            .Reactive(evt => evt.CellSave<TaskCountRow, int>(), (args, p) =>
            {
                p.When(args.ColumnName).Eq(columns.Field(r => r.OpenTasks)).And(args.Value).Gt(MostOpenTasks)
                    .Then(refused =>
                    {
                        args.Cancel.Set(true);
                        refused.Element("count-refused-resident").Text.Set(args.RowData.Get(r => r.ResidentName));
                        refused.Element("count-refused-value").Text.Set(args.Value);
                        refused.Element("count-refused-kept").Text.Set(args.PreviousValue);
                        refused.Element("count-refused").Show();
                    })
                    .Else(accepted => accepted.Element("count-refused").Hide());
            })
            .Reactive(evt => evt.CellSaved<TaskCountRow, int>(), (args, p) =>
            {
                p.When(args.Value).NotEq(args.PreviousValue).Then(noted =>
                {
                    noted.Element("count-unsaved-resident").Text.Set(args.RowData.Get(r => r.ResidentName));
                    noted.When(args.ColumnName).Eq(columns.Field(r => r.OpenTasks))
                        .Then(tasks => tasks.Element("count-unsaved-column").Text.Set("open tasks"))
                        .Else(doses => doses.Element("count-unsaved-column").Text.Set("missed doses"));
                    noted.Element("count-unsaved-from").Text.Set(args.PreviousValue);
                    noted.Element("count-unsaved-to").Text.Set(args.Value);
                    noted.Element("count-unsaved").Show();
                });
            })
            .Reactive(evt => evt.BeforeBatchSave<TaskCountRow>(), (args, p) =>
            {
                var changed = p.From(args.BatchChanges.Get(x => x.ChangedRecords));
                p.When(changed.Any(r => r.OpenTasks >= SupervisorOpenTasks)).Truthy()
                    .Then(held =>
                    {
                        args.Cancel.Set(true);
                        held.Element("count-held-resident").Text.Set(changed.Find(r => r.OpenTasks >= SupervisorOpenTasks, r => r.ResidentName));
                        held.Element("count-held-tasks").Text.Set(changed.Find(r => r.OpenTasks >= SupervisorOpenTasks, r => r.OpenTasks));
                        held.Element("count-held").Show();
                    })
                    .Else(saving =>
                    {
                        saving.Element("count-held").Hide();
                        saving.Post(Url.SandboxRoute("TaskCountSave", "Grid"))
                            .Gather<TaskCountChanges>(g => g.Set(x => x.Changes, args.BatchChanges))
                            .Response(r => r.OnSuccess<TaskCountSummary>((saved, s) =>
                                s.Element("count-status").Text.Set(saved.Get(x => x.Summary))));
                    });
            })
            .Reactive(evt => evt.ActionComplete<TaskCountRow>(), (args, p) =>
            {
                p.When(args.RequestType).Eq("batchsave").Then(saved => saved.Element("count-unsaved").Hide());
            }))

        <div class="mt-4 space-y-1 text-sm">
            <p id="count-status" role="status">Tonight's count has not been saved.</p>
            <p id="count-unsaved" hidden>
                Not saved yet: <span id="count-unsaved-resident"></span>, <span id="count-unsaved-column"></span>
                <span id="count-unsaved-from"></span> → <span id="count-unsaved-to"></span>.
            </p>
            <p id="count-refused" hidden class="text-red-700">
                <span id="count-refused-resident"></span>: <span id="count-refused-value"></span> open tasks is more
                than a shift can hold. The count stays at <span id="count-refused-kept"></span>.
            </p>
            <p id="count-held" hidden class="text-red-700">
                <span id="count-held-resident"></span> would have <span id="count-held-tasks"></span> open tasks.
                Page the night supervisor before saving the count.
            </p>
        </div>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
