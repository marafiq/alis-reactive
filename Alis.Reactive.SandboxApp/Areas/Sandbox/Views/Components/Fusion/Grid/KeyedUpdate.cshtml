@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.GridOperationsModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Ops Keyed Resident Update";

    const string GridId = "keyed-update-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<GridOperationsModel>();

    // Focused scenario: update a resident's cell and whole row by primary key (no row index).
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("OperationRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).SetDataSource(json);
                s.Element("keyed-status").SetText("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Ops Keyed Resident Update</native-heading>
    <native-text color="Secondary">
        Flag a resident's task count, quarantine their risk, and replace a resident row by primary key.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("keyed-set-tasks", "Flag Tasks (6000)")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).SetCellValue(6000, (ResidentDirectoryGridItem x) => x.OpenTasks, 99);
                p.Element("keyed-status").SetText("setCellValue int called");
            }))
        @(Html.NativeButton("keyed-set-risk", "Quarantine Risk (6001)")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).SetCellValue(6001, (ResidentDirectoryGridItem x) => x.RiskLevel, "Quarantine");
                p.Element("keyed-status").SetText("setCellValue string called");
            }))
        @(Html.NativeButton("keyed-set-row", "Replace Row (6002)")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).SetRowData(6002, new ResidentDirectoryGridItem
                {
                    ResidentId = 6002,
                    ResidentName = "Keyed Row",
                    Age = 88,
                    CareLevel = "Skilled Nursing",
                    Wing = "East",
                    Suite = "E-202",
                    RiskLevel = "High",
                    PrimaryNurse = "Dana Cole",
                    OpenTasks = 4,
                    NextReviewDate = "2026-06-25"
                });
                p.Element("keyed-status").SetText("setRowData called");
            }))
    </native-hstack>

    <p class="font-mono text-sm">Status: <span id="keyed-status" class="text-text-muted">waiting</span></p>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<GridOperationsModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = "residentId", HeaderText = "ID", Width = "80", IsPrimaryKey = true, TextAlign = TextAlign.Right, Visible = false },
                new GridColumn { Field = "residentName", HeaderText = "Resident", Width = "240" },
                new GridColumn { Field = "riskLevel", HeaderText = "Risk", Width = "150" },
                new GridColumn { Field = "openTasks", HeaderText = "Open Tasks", Width = "130", TextAlign = TextAlign.Right }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
