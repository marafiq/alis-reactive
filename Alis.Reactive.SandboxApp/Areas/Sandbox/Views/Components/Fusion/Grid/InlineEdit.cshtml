@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.CarePlanReviewsViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Plan Reviews";

    const string GridId = "care-plan-reviews";
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";
    const string ButtonLink = "rounded-md px-2 py-1 text-sm font-medium text-primary underline-offset-2 hover:underline";

    var plan = Html.ReactivePlan<CarePlanReviewsViewModel>();

    var columns = FusionGridColumns.Of<CarePlanReview>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("InlineEditReviews", "Grid"))
            .Response(r => r.OnSuccess<List<CarePlanReview>>((reviews, s) =>
                s.Component<FusionGrid>(GridId).Rows<CarePlanReview>().Set(reviews)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Care-Plan Reviews</native-heading>
        <native-text color="Secondary">
            Birch wing. Move a resident's next care-plan review to a day that suits the family; the care team's
            calendar books the new day when you save it.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Due this week</native-heading>
        <native-hstack gap="Sm" class="mt-2 flex-wrap">
            @foreach (var due in Model.DueThisWeek)
            {
                @(Html.NativeButton(due.ButtonId, due.Label)
                    .CssClass(ButtonLink)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        var reviews = p.Component<FusionGrid>(GridId);
                        reviews.SelectRow(reviews.GetRowIndexByPrimaryKey(due.ResidentId));
                        reviews.StartEdit();
                    }))
            }
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="mb-4 flex-wrap">
            @(Html.NativeButton("review-save", "Save")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(GridId).EndEdit()))
            @(Html.NativeButton("review-cancel", "Cancel")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(GridId).CloseEdit()))
        </native-hstack>

        @(Html.FusionGrid<CarePlanReviewsViewModel, CarePlanReview>(plan, GridId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings { AllowEditing = true, Mode = EditMode.Normal })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", IsPrimaryKey = true, Visible = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "170", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "90", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.CareLevel), HeaderText = "Care level", Width = "160", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.NextReview), HeaderText = "Next review", Width = "170", EditTemplate = FusionGridEditTemplates.DateInput((CarePlanReview r) => r.NextReview) }
            }))
            .Reactive(evt => evt.ActionComplete<CarePlanReview>(), (args, p) =>
                p.When(args.RequestType).Eq("save").Then(saved =>
                    saved.Post(Url.SandboxRoute("InlineEditBooking", "Grid"))
                        .Gather<CarePlanReviewBooking>(g => g.Set(x => x.Review, args.Data))
                        .Response(r => r
                            .OnSuccess<CarePlanReviewAnswer>((booked, s) =>
                                s.Element("review-status").Text.Set(booked.Get(x => x.Summary)))
                            .OnError<CarePlanReviewAnswer>(400, (refused, e) =>
                            {
                                // The calendar keeps the day on file, so the row goes back to it.
                                e.Component<FusionGrid>(GridId).SetRowData(refused.Get(x => x.Review.ResidentId), refused.Get(x => x.Review));
                                e.Element("review-status").Text.Set(refused.Get(x => x.Summary));
                            })))))

        <p id="review-status" role="status" class="mt-4 text-sm font-medium">No reviews moved yet.</p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
