@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.GridOperationsModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@using Alis.Reactive
@{
    ViewData["Title"] = "Care-Staff Column Fit";

    const string GridId = "column-fit-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<GridOperationsModel>();

    var columns = FusionGridColumns.Of<ResidentDirectoryGridItem>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("OperationRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).DataSource.Set(json);
                s.Element("fit-status").Text.Set("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Staff Column Fit</native-heading>
    <native-text color="Secondary">
        Auto-fit one wide column, then auto-fit all columns to their content.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("fit-risk", "Fit Risk Column")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).AutoFitColumn(Field.Of((ResidentDirectoryGridItem x) => x.RiskLevel));
                p.Element("fit-status").Text.Set("autoFitColumn called");
            }))
        @(Html.NativeButton("fit-all", "Fit All Columns")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).AutoFitColumns();
                p.Element("fit-status").Text.Set("autoFitColumns called");
            }))
    </native-hstack>

    <p class="font-mono text-sm">Status: <span id="fit-status" class="text-text-muted">waiting</span></p>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<GridOperationsModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", IsPrimaryKey = true, TextAlign = TextAlign.Right, Visible = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "400" },
                new GridColumn { Field = columns.Field(r => r.RiskLevel), HeaderText = "Risk", Width = "400" },
                new GridColumn { Field = columns.Field(r => r.OpenTasks), HeaderText = "Open Tasks", Width = "130", TextAlign = TextAlign.Right }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
