@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.GridOperationsModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Staff Column View";

    const string GridId = "care-staff-columns-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<GridOperationsModel>();

    // Focused scenario: care staff personalize which resident columns are visible and their order.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("OperationRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).SetDataSource(json);
                s.Element("column-status").SetText("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Staff Column View</native-heading>
    <native-text color="Secondary">
        Care staff hide non-essential columns, restore them, and move the risk column to the front for a shift.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("hide-care-columns", "Hide Care Columns")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                grid.HideColumn((ResidentDirectoryGridItem x) => x.PrimaryNurse);
                grid.HideColumn((ResidentDirectoryGridItem x) => x.NextReviewDate);
                p.Element("column-status").SetText("care columns hidden");
            }))
        @(Html.NativeButton("show-care-columns", "Show Care Columns")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                grid.ShowColumn((ResidentDirectoryGridItem x) => x.PrimaryNurse);
                grid.ShowColumn((ResidentDirectoryGridItem x) => x.NextReviewDate);
                p.Element("column-status").SetText("care columns shown");
            }))
        @(Html.NativeButton("reorder-risk-first", "Move Risk Before Resident")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId)
                    .ReorderColumnBefore(
                        (ResidentDirectoryGridItem x) => x.RiskLevel,
                        (ResidentDirectoryGridItem x) => x.ResidentName);
                p.Element("column-status").SetText("risk moved before resident");
            }))
    </native-hstack>

    <p class="font-mono text-sm">Status: <span id="column-status" class="text-text-muted">waiting</span></p>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<GridOperationsModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .AllowReordering(true)
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = "residentId", HeaderText = "ID", Width = "80", IsPrimaryKey = true, TextAlign = TextAlign.Right, Visible = false },
                new GridColumn { Field = "residentName", HeaderText = "Resident", Width = "200" },
                new GridColumn { Field = "riskLevel", HeaderText = "Risk", Width = "130" },
                new GridColumn { Field = "primaryNurse", HeaderText = "Primary Nurse", Width = "160" },
                new GridColumn { Field = "nextReviewDate", HeaderText = "Next Review", Width = "140" },
                new GridColumn { Field = "wing", HeaderText = "Wing", Width = "110" },
                new GridColumn { Field = "careLevel", HeaderText = "Care Level", Width = "150" }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
