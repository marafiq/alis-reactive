@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentGridEditingModel
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Ops Remote Adaptor Roster";

    const string GridId = "remote-adaptor-grid";

    var plan = Html.ReactivePlan<ResidentGridEditingModel>();

    var columns = FusionGridColumns.Of<ResidentGridItem>();

    // DataManager adaptor dataSource: the grid binds to a remote URL through a Syncfusion
    // DataManager + UrlAdaptor and fetches the {result, count} page itself on load.
    var remote = new DataManager
    {
        Url = Url.SandboxRoute("Data", "Grid"),
        Adaptor = "UrlAdaptor"
    };
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Ops Remote Adaptor Roster</native-heading>
    <native-text color="Secondary">
        The census grid binds to a remote endpoint through a Syncfusion DataManager and URL adaptor,
        fetching the paged <code>{ result, count }</code> roster itself - no manual fetch wiring.
    </native-text>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<ResidentGridEditingModel, ResidentGridItem>(plan, GridId, b => b
            .DataSource(remote)
            .AllowPaging(true)
            .AllowSelection(true)
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.Name), HeaderText = "Resident", Width = "200" },
                new GridColumn { Field = columns.Field(r => r.Age), HeaderText = "Age", Width = "90", TextAlign = TextAlign.Right },
                new GridColumn { Field = columns.Field(r => r.CareLevel), HeaderText = "Care Level", Width = "160" },
                new GridColumn { Field = columns.Field(r => r.Wing), HeaderText = "Wing", Width = "120" }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
