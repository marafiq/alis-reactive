@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentGridEditingModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Ops Locked Resident Edit";

    const string GridId = "locked-edit-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<ResidentGridEditingModel>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("EditingRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).SetDataSource(json);
                s.Element("lock-edit-status").SetText("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Ops Locked Resident Edit</native-heading>
    <native-text color="Secondary">
        Resident 6001 is locked: starting an edit fires <code>beginEdit</code>, and the handler cancels it.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("edit-6001", "Edit Locked Resident 6001")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                grid.SelectRow(1);
                grid.StartEdit();
                p.Element("lock-edit-status").SetText("editing 6001");
            }))
        @(Html.NativeButton("edit-6000", "Edit Resident 6000")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                grid.SelectRow(0);
                grid.StartEdit();
                p.Element("lock-edit-status").SetText("editing 6000");
            }))
    </native-hstack>

    <native-grid cols="C1" gap="Base" class="mt-4 font-mono text-sm">
        <p>Status: <span id="lock-edit-status" class="text-text-muted">waiting</span></p>
        <p>Lock result: <span id="lock-result" class="text-text-muted">waiting</span></p>
    </native-grid>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<ResidentGridEditingModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings
            {
                AllowEditing = true,
                AllowEditOnDblClick = false,
                Mode = EditMode.Normal,
                ShowConfirmDialog = false
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = "residentId", HeaderText = "ID", Width = "80", IsPrimaryKey = true, AllowEditing = false, Visible = false },
                new GridColumn { Field = "residentName", HeaderText = "Resident", Width = "240" },
                new GridColumn { Field = "riskLevel", HeaderText = "Risk", Width = "180" }
            }))
            .Reactive(evt => evt.BeginEdit<ResidentDirectoryGridItem>(), (args, p) =>
            {
                p.When(args, x => x.RowData.ResidentId).Eq(6001)
                    .Then(t =>
                    {
                        args.Cancel(t);
                        t.Element("lock-result").SetText("edit blocked for 6001");
                    });
            }))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
