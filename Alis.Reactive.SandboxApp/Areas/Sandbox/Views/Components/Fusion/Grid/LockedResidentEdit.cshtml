@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentRecordsViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Resident Records";

    const string GridId = "resident-records";
    const string Discharged = "Discharged";
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";
    const string ButtonLink = "rounded-md px-2 py-1 text-sm font-medium text-primary underline-offset-2 hover:underline";

    var plan = Html.ReactivePlan<ResidentRecordsViewModel>();

    var columns = FusionGridColumns.Of<ResidentContactRecord>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("LockedResidentEditRecords", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentContactRecord>>((records, s) =>
                s.Component<FusionGrid>(GridId).DataSource.Set(records)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Resident Records</native-heading>
        <native-text color="Secondary">
            Front office. Update a resident's record as the family asks. A discharged resident's record is closed:
            it stays as it was on the day they left.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Family requests</native-heading>
        <ul class="mt-2 space-y-1 text-sm">
            @foreach (var request in Model.Requests)
            {
                <li class="flex flex-wrap items-center gap-2">
                    <span>@request.Request</span>
                    @(Html.NativeButton(request.ButtonId, request.ButtonText)
                        .CssClass(ButtonLink)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                        {
                            var records = p.Component<FusionGrid>(GridId);
                            records.SelectRow(records.GetRowIndexByPrimaryKey(request.ResidentId));
                            records.StartEdit();
                        }))
                </li>
            }
        </ul>
    </native-card-body></native-card>

    <native-card><native-card-body>
        @(Html.FusionGrid<ResidentRecordsViewModel, ResidentContactRecord>(plan, GridId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings { AllowEditing = true, Mode = EditMode.Normal })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", IsPrimaryKey = true, Visible = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "170", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "90", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.Status), HeaderText = "Status", Width = "120", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.DischargedOn), HeaderText = "Discharged", Width = "140", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.FamilyPhone), HeaderText = "Family phone", Width = "150" }
            }))
            .Reactive(evt => evt.BeginEdit<ResidentContactRecord>(), (args, p) =>
            {
                p.When(args.RowData.Get(r => r.Status)).Eq(Discharged)
                    .Then(closed =>
                    {
                        args.Cancel.Set(true);
                        closed.Element("record-closed-resident").Text.Set(args.RowData.Get(r => r.ResidentName));
                        closed.Element("record-closed-on").Text.Set(args.RowData.Get(r => r.DischargedOn));
                        closed.Element("record-closed").Show();
                    })
                    .Else(open => open.Element("record-closed").Hide());
            }))

        <p id="record-closed" hidden role="alert" class="mt-4 text-sm text-red-700">
            <span id="record-closed-resident"></span> was discharged on <span id="record-closed-on"></span>. The record is
            closed; send the family's request to medical records.
        </p>

        <native-hstack gap="Sm" class="mt-4">
            @(Html.NativeButton("record-save", "Save record")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(GridId).EndEdit()))
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
