@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.GridOperationsModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Staff Roster Review";

    const string GridId = "care-review-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<GridOperationsModel>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("OperationRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).SetDataSource(json);
                s.Element("review-status").SetText("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Staff Roster Review</native-heading>
    <native-text color="Secondary">
        Summarize the current view, locate a resident, and review the selected residents.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("review-current-view", "Summarize Current View")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                p.Post(Url.SandboxRoute("CurrentViewSummary", "Grid"))
                    .Gather(g => g.Include(grid.CurrentViewRecords<GridOperationsModel, ResidentDirectoryGridItem>(), "records"))
                    .Response(r => r.OnSuccess<ResidentDirectorySelectionResponse>((json, s) =>
                        s.Element("view-summary").SetText(json, x => x.Summary)));
            }))
        @(Html.NativeButton("review-row-index", "Find Resident 6005")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                p.Post(Url.SandboxRoute("RowIndexSummary", "Grid"))
                    .Gather(g => g.Include(grid.RowIndexByPrimaryKey(6005), "rowIndex"))
                    .Response(r => r.OnSuccess<ResidentDirectorySelectionResponse>((json, s) =>
                        s.Element("index-summary").SetText(json, x => x.Summary)));
            }))
        @(Html.NativeButton("review-selected", "Review Selected")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                grid.SelectRowsByRange(0, 1);
                p.Post(Url.SandboxRoute("SelectionRecords", "Grid"))
                    .Gather(g => g.Include(grid.SelectedRecords<GridOperationsModel, ResidentDirectoryGridItem>(), "selectedRecords"))
                    .Response(r => r.OnSuccess<ResidentDirectorySelectionResponse>((json, s) =>
                        s.Element("selected-summary").SetText(json, x => x.Summary)));
            }))
        @(Html.NativeButton("review-indexes", "Selected Indexes")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                grid.SelectRowsByRange(0, 1);
                p.Post(Url.SandboxRoute("SelectionIndexes", "Grid"))
                    .Gather(g => g.Include(grid.SelectedRowIndexes<GridOperationsModel>(), "selectedRowIndexes"))
                    .Response(r => r.OnSuccess<ResidentDirectorySelectionResponse>((json, s) =>
                        s.Element("indexes-summary").SetText(json, x => x.Summary)));
            }))
    </native-hstack>

    <native-grid cols="C1" gap="Base" class="mt-4 font-mono text-sm">
        <p>Load: <span id="review-status" class="text-text-muted">waiting</span></p>
        <p>View: <span id="view-summary" class="text-text-muted">waiting</span></p>
        <p>Index: <span id="index-summary" class="text-text-muted">waiting</span></p>
        <p>Selected: <span id="selected-summary" class="text-text-muted">waiting</span></p>
        <p>Indexes: <span id="indexes-summary" class="text-text-muted">waiting</span></p>
    </native-grid>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<GridOperationsModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .AllowSelection(true)
            .SelectionSettings(new GridSelectionSettings { Type = SelectionType.Multiple })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = "residentId", HeaderText = "ID", Width = "80", IsPrimaryKey = true, TextAlign = TextAlign.Right, Visible = false },
                new GridColumn { Field = "residentName", HeaderText = "Resident", Width = "240" },
                new GridColumn { Field = "riskLevel", HeaderText = "Risk", Width = "150" }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
