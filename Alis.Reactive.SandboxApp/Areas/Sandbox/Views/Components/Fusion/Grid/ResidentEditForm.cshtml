@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.AdmissionsDeskViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Admissions Desk";

    const string ResidentsId = "desk-residents";
    const string ReferralsId = "desk-referrals";
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<AdmissionsDeskViewModel>();

    var residentColumns = FusionGridColumns.Of<AdmissionsResident>();
    var referralColumns = FusionGridColumns.Of<AdmissionsReferral>();

    // The admission form: the coordinator writes the resident's full name and sets their risk, open care tasks
    // and first care review.
    var admissionForm = FusionGridEditTemplates.DialogForm<AdmissionsReferral>(d => d
        .Text(r => r.ResidentName, "Resident")
        .Select(r => r.RiskLevel, "Risk", Model.RiskLevels)
        .Number(r => r.OpenTasks, "Open care tasks")
        .Date(r => r.FirstReview, "First care review"));

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("ResidentEditFormDesk", "Grid"))
            .Response(r => r.OnSuccess<AdmissionsDesk>((desk, s) =>
            {
                s.Component<FusionGrid>(ResidentsId).Rows<AdmissionsResident>().Set(desk.Get(x => x.Residents));
                s.Component<FusionGrid>(ReferralsId).Rows<AdmissionsReferral>().Set(desk.Get(x => x.Referrals));
            }))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Admissions Desk</native-heading>
        <native-text color="Secondary">
            Maple Grove admissions coordinator. Correct a resident's care level, primary nurse or next care review, and
            admit the next referral waiting to move in by completing their admission form.
        </native-text>
    </div>

    <p id="desk-status" role="status" class="text-sm font-medium">Nothing saved yet today.</p>

    <native-card><native-card-body>
        <native-heading level="H2">Residents</native-heading>
        <native-text color="Secondary">Pick a resident, correct their record in the row, then save the correction.</native-text>
        <native-hstack gap="Sm" class="my-4 flex-wrap">
            @(Html.NativeButton("correct-record", "Correct Record")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Component<FusionGrid>(ResidentsId).StartEdit()))
            @(Html.NativeButton("save-correction", "Save Correction")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Component<FusionGrid>(ResidentsId).EndEdit()))
            @(Html.NativeButton("cancel-correction", "Cancel")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Component<FusionGrid>(ResidentsId).CloseEdit()))
        </native-hstack>
        @(Html.FusionGrid<AdmissionsDeskViewModel, AdmissionsResident>(plan, ResidentsId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings { AllowEditing = true, AllowEditOnDblClick = false, Mode = EditMode.Normal })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = residentColumns.Field(r => r.ResidentId), HeaderText = "ID", IsPrimaryKey = true, Visible = false },
                new GridColumn { Field = residentColumns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "170", AllowEditing = false },
                new GridColumn { Field = residentColumns.Field(r => r.Suite), HeaderText = "Suite", Width = "80", AllowEditing = false },
                new GridColumn { Field = residentColumns.Field(r => r.CareLevel), HeaderText = "Care level", Width = "170",
                    EditTemplate = FusionGridEditTemplates.Select((AdmissionsResident r) => r.CareLevel, Model.CareLevels) },
                new GridColumn { Field = residentColumns.Field(r => r.PrimaryNurse), HeaderText = "Primary nurse", Width = "190",
                    EditTemplate = FusionGridEditTemplates.Select((AdmissionsResident r) => r.PrimaryNurse, Model.Nurses, n => $"{n.Name}, {n.Shift}", n => n.Name) },
                new GridColumn { Field = residentColumns.Field(r => r.NextReview), HeaderText = "Next care review", Width = "170",
                    EditTemplate = FusionGridEditTemplates.DateInput((AdmissionsResident r) => r.NextReview) }
            }))
            .Reactive(evt => evt.ActionComplete<AdmissionsResident>(), (args, p) =>
                p.When(args.RequestType).Eq("save").Then(saved =>
                    saved.Post(Url.SandboxRoute("ResidentEditFormCorrect", "Grid"))
                        .Gather<ResidentRecordCorrection>(g => g.Set(x => x.Resident, args.Data))
                        .Response(r => r.OnSuccess<AdmissionsAnswer>((answer, s) =>
                            s.Element("desk-status").Text.Set(answer.Get(x => x.Summary)))))))
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Waiting to Move In</native-heading>
        <native-text color="Secondary">Approved referrals, the next to move in first.</native-text>
        <native-hstack gap="Sm" class="my-4 flex-wrap">
            @(Html.NativeButton("admit-next-referral", "Admit Next Referral")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var referrals = p.Component<FusionGrid>(ReferralsId);
                    referrals.SelectRow(0);
                    referrals.StartEdit();
                }))
        </native-hstack>
        @(Html.FusionGrid<AdmissionsDeskViewModel, AdmissionsReferral>(plan, ReferralsId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings
            {
                AllowEditing = true,
                AllowEditOnDblClick = false,
                Mode = EditMode.Dialog,
                Template = admissionForm
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = referralColumns.Field(r => r.ReferralId), HeaderText = "Referral", IsPrimaryKey = true, Visible = false },
                new GridColumn { Field = referralColumns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "170" },
                new GridColumn { Field = referralColumns.Field(r => r.MoveInDay), HeaderText = "Moves in", Width = "120" },
                new GridColumn { Field = referralColumns.Field(r => r.Suite), HeaderText = "Suite", Width = "80" },
                new GridColumn { Field = referralColumns.Field(r => r.CareLevel), HeaderText = "Care level", Width = "150" },
                new GridColumn { Field = referralColumns.Field(r => r.RiskLevel), HeaderText = "Risk", Width = "100" },
                new GridColumn { Field = referralColumns.Field(r => r.OpenTasks), HeaderText = "Open tasks", Width = "110", TextAlign = TextAlign.Right },
                new GridColumn { Field = referralColumns.Field(r => r.FirstReview), HeaderText = "First care review", Width = "160" }
            }))
            .Reactive(evt => evt.ActionComplete<AdmissionsReferral>(), (args, p) =>
                p.When(args.RequestType).Eq("save").Then(saved =>
                    saved.Post(Url.SandboxRoute("ResidentEditFormAdmit", "Grid"))
                        .Gather<ReferralAdmission>(g => g.Set(x => x.Referral, args.Data))
                        .Response(r => r
                            .OnSuccess<AdmissionsDesk>((desk, s) =>
                            {
                                s.Component<FusionGrid>(ResidentsId).Rows<AdmissionsResident>().Set(desk.Get(x => x.Residents));
                                s.Component<FusionGrid>(ReferralsId).Rows<AdmissionsReferral>().Set(desk.Get(x => x.Referrals));
                                s.Element("desk-status").Text.Set(desk.Get(x => x.Summary));
                            })
                            // The referral stays waiting, as it is on file.
                            .OnError<AdmissionsDesk>(400, (refused, e) =>
                            {
                                e.Component<FusionGrid>(ReferralsId).Rows<AdmissionsReferral>().Set(refused.Get(x => x.Referrals));
                                e.Element("desk-status").Text.Set(refused.Get(x => x.Summary));
                            })))))
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
