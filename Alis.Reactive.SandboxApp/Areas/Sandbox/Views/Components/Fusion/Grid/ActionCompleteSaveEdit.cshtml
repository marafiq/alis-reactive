@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentGridEditingModel
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Pharmacy Name Corrections";

    const string RosterId = "pharmacy-roster";

    var plan = Html.ReactivePlan<ResidentGridEditingModel>();

    var columns = FusionGridColumns.Of<PharmacyRosterResident>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("ActionCompleteSaveEditRoster", "Grid"))
            .Response(r => r.OnSuccess<List<PharmacyRosterResident>>((residents, s) =>
                s.Component<FusionGrid>(RosterId).DataSource.Set(residents)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Pharmacy Name Corrections</native-heading>
        <native-text color="Secondary">
            Maple wing roster. Double-click a resident to correct their details and press Enter to save. A corrected
            name goes to Riverside Pharmacy as soon as it is saved, so the labels on the resident's medications match.
        </native-text>
    </div>

    <native-card><native-card-body>
        @(Html.FusionGrid<ResidentGridEditingModel, PharmacyRosterResident>(plan, RosterId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings
            {
                AllowEditing = true,
                AllowEditOnDblClick = true,
                Mode = EditMode.Normal
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "180" },
                new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "90" },
                new GridColumn { Field = columns.Field(r => r.PrimaryNurse), HeaderText = "Primary nurse", Width = "160" }
            }))
            .Reactive(evt => evt.ActionComplete<PharmacyRosterResident>(), (args, p) =>
            {
                // Only a saved change of name concerns the pharmacy; a new suite or nurse does not.
                p.When(args.RequestType).Eq("save")
                    .And(args.Data.Get(x => x.ResidentName)).NotEq(args.PreviousData.Get(x => x.ResidentName))
                    .Then(t => t.Post(Url.SandboxRoute("ActionCompleteSaveEditNotice", "Grid"))
                        .Gather<PharmacyNameCorrection>(g => g
                            .Set(x => x.ResidentId, args.Data.Get(x => x.ResidentId))
                            .Set(x => x.PreviousName, args.PreviousData.Get(x => x.ResidentName))
                            .Set(x => x.CorrectedName, args.Data.Get(x => x.ResidentName))
                            .Set(x => x.RosterLine, args.RowIndex))
                        .Response(r => r.OnSuccess<PharmacyNotice>((notice, s) =>
                            s.Element("pharmacy-notice").Text.Set(notice.Get(x => x.Summary)))));
            }))

        <p id="pharmacy-notice" class="mt-4 text-sm">No name corrections sent to the pharmacy yet.</p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
