@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.MoveInDayViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Move-in Day";

    const string GridId = "move-in-roster";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<MoveInDayViewModel>();
    var columns = FusionGridColumns.Of<MoveInDayResident>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Move-in Day</native-heading>
        <native-text color="Secondary">
            North wing roster. Move today's arrivals in and today's departures out; nobody moves in before their
            residency agreement is signed.
        </native-text>
    </div>

    <native-grid cols="C2" gap="Base">
        <native-card><native-card-body>
            <native-heading level="H2">Arriving today</native-heading>
            <ul class="mt-3 space-y-3">
                @foreach (var arrival in Model.Arrivals)
                {
                    <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                        <span>
                            <span class="font-medium">@arrival.ResidentName</span>,
                            @arrival.CareLevel, suite @arrival.Suite
                            (@(arrival.AgreementSigned ? "agreement signed" : "agreement not signed"))
                        </span>
                        @(Html.NativeButton($"move-in-{arrival.ResidentId}", "Move in")
                            .CssClass(Button)
                            .Reactive(plan, evt => evt.Click, (_, p) =>
                                p.Component<FusionGrid>(GridId).AddRecord<MoveInDayResident>(arrival)))
                    </li>
                }
            </ul>
            <p id="move-in-refused" hidden class="mt-3 text-sm text-red-700">
                <span id="move-in-refused-resident"></span> cannot move in until the residency agreement is signed.
            </p>
        </native-card-body></native-card>

        <native-card><native-card-body>
            <native-heading level="H2">Leaving today</native-heading>
            <ul class="mt-3 space-y-3">
                @foreach (var departure in Model.Departures)
                {
                    <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                        <span>
                            <span class="font-medium">@departure.ResidentName</span>, suite @departure.Suite,
                            @departure.Destination
                        </span>
                        @(Html.NativeButton($"move-out-{departure.ResidentId}", "Move out")
                            .CssClass(Button)
                            .Reactive(plan, evt => evt.Click, (_, p) =>
                            {
                                var roster = p.Component<FusionGrid>(GridId);
                                p.Component<NativeHiddenField>(m => m.MovingOut).Value.Set(departure.ResidentName);
                                roster.SelectRow(roster.GetRowIndexByPrimaryKey(departure.ResidentId));
                                roster.DeleteRecord();
                            }))
                    </li>
                }
            </ul>
            @Html.HiddenFieldFor(plan, m => m.MovingOut)
        </native-card-body></native-card>
    </native-grid>

    <native-card><native-card-body>
        <native-heading level="H2">North wing roster</native-heading>
        <p id="roster-change" hidden role="status" class="mt-1 text-sm text-text-secondary">
            Last change: <span id="roster-change-resident"></span> <span id="roster-change-what"></span>.
        </p>

        <div class="mt-4">
            @(Html.FusionGrid<MoveInDayViewModel, MoveInDayResident>(plan, GridId, b => b
                .DataSource(Model.Roster)
                .AllowSelection(true)
                .EditSettings(new GridEditSettings
                {
                    AllowAdding = true,
                    AllowDeleting = true,
                    Mode = EditMode.Normal,
                    ShowDeleteConfirmDialog = false
                })
                .Columns(new List<GridColumn>
                {
                    new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true },
                    new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "200" },
                    new GridColumn { Field = columns.Field(r => r.CareLevel), HeaderText = "Care level", Width = "170" },
                    new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "110" }
                }))
                .Reactive(evt => evt.ActionBegin<MoveInDayResident>(), (args, p) =>
                {
                    p.When(args.RequestType).Eq("save").And(args.Action).Eq("add").And(args.Data.Get(r => r.AgreementSigned)).Falsy()
                        .Then(refused =>
                        {
                            args.Cancel.Set(true);
                            refused.Element("move-in-refused-resident").Text.Set(args.Data.Get(r => r.ResidentName));
                            refused.Element("move-in-refused").Show();
                        })
                        .ElseIf(args.RequestType).Eq("save").And(args.Action).Eq("add")
                        .Then(admitted => admitted.Element("move-in-refused").Hide());
                })
                .Reactive(evt => evt.ActionComplete<MoveInDayResident>(), (args, p) =>
                {
                    p.When(args.RequestType).Eq("save").And(args.Action).Eq("add")
                        .Then(movedIn =>
                        {
                            movedIn.Element("roster-change-resident").Text.Set(args.Data.Get(r => r.ResidentName));
                            movedIn.Element("roster-change-what").Text.Set("moved in");
                            movedIn.Element("roster-change").Show();
                        })
                        .ElseIf(args.RequestType).Eq("delete")
                        .Then(movedOut =>
                        {
                            movedOut.Element("roster-change-resident").Text.Set(movedOut.Component<NativeHiddenField>(m => m.MovingOut).Value);
                            movedOut.Element("roster-change-what").Text.Set("moved out");
                            movedOut.Element("roster-change").Show();
                        });
                }))
        </div>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
