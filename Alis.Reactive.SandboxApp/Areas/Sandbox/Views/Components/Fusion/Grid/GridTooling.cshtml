@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ShiftScheduleViewModel
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Shift Schedule";

    const string GridId = "shift-schedule";
    const string WeekendItem = "shift-schedule-weekend";
    const string ColumnsItem = "shift-schedule-columns";

    // A page holds one day's three shifts, Monday first, so Saturday is the sixth page.
    const int ShiftsPerDay = 3;
    const int SaturdayPage = 6;

    var plan = Html.ReactivePlan<ShiftScheduleViewModel>();

    var columns = FusionGridColumns.Of<ScheduledShift>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("GridToolingShifts", "Grid"))
            .Response(r => r.OnSuccess<List<ScheduledShift>>((shifts, s) =>
                s.Component<FusionGrid>(GridId).Rows<ScheduledShift>().Set(shifts)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Shift Schedule</native-heading>
        <native-text color="Secondary">
            Week of October 19, one day to a page. Weekend shifts fill last, so check them first; an open shift
            has nobody on it yet.
        </native-text>
    </div>

    <native-card><native-card-body>
        @(Html.FusionGrid<ShiftScheduleViewModel, ScheduledShift>(plan, GridId, b => b
            .AllowPaging(true)
            .ShowColumnChooser(true)
            .PageSettings(new GridPageSettings { PageSize = ShiftsPerDay })
            .Toolbar(new List<object>
            {
                new { text = "Weekend", id = WeekendItem },
                new { text = "Choose columns", id = ColumnsItem }
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ShiftId), HeaderText = "ID", IsPrimaryKey = true, Visible = false, ShowInColumnChooser = false },
                new GridColumn { Field = columns.Field(r => r.Day), HeaderText = "Day", Width = "140", ShowInColumnChooser = false },
                new GridColumn { Field = columns.Field(r => r.Shift), HeaderText = "Shift", Width = "110" },
                new GridColumn { Field = columns.Field(r => r.Nurse), HeaderText = "Nurse", Width = "170" },
                new GridColumn { Field = columns.Field(r => r.Aide), HeaderText = "Aide", Width = "170" }
            }))
            .Reactive(evt => evt.ToolbarClick, (args, p) =>
            {
                var item = args.Item.Get(x => x.Id);
                p.When(item).Eq(WeekendItem).Then(t => t.Component<FusionGrid>(GridId).GoToPage(SaturdayPage))
                    .ElseIf(item).Eq(ColumnsItem).Then(t => t.Component<FusionGrid>(GridId).OpenColumnChooser());
            }))
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
