@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.GridOperationsModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Staff Grid Tooling";

    const string GridId = "grid-tooling-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<GridOperationsModel>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("OperationRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).SetDataSource(json);
                s.Element("tooling-status").SetText("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Staff Grid Tooling</native-heading>
    <native-text color="Secondary">
        Jump to a roster page and open the column chooser.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("tooling-go-page", "Go To Page 2")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).GoToPage(2);
                p.Element("tooling-status").SetText("goToPage called");
            }))
        @(Html.NativeButton("tooling-column-chooser", "Open Column Chooser")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).ShowColumnChooser();
                p.Element("tooling-status").SetText("showColumnChooser called");
            }))
    </native-hstack>

    <p class="font-mono text-sm">Status: <span id="tooling-status" class="text-text-muted">waiting</span></p>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<GridOperationsModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .AllowPaging(true)
            .ShowColumnChooser(true)
            .PageSettings(new GridPageSettings { PageSize = 4 })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = "residentId", HeaderText = "ID", Width = "80", IsPrimaryKey = true, TextAlign = TextAlign.Right, Visible = false },
                new GridColumn { Field = "residentName", HeaderText = "Resident", Width = "240" },
                new GridColumn { Field = "riskLevel", HeaderText = "Risk", Width = "150" },
                new GridColumn { Field = "openTasks", HeaderText = "Open Tasks", Width = "130", TextAlign = TextAlign.Right }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
