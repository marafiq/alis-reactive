@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.NightChecksViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Night Safety Checks";

    const string ChecksId = "night-checks-grid";
    const string ReviewId = "night-checks-review";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";

    var plan = Html.ReactivePlan<NightChecksViewModel>();
    var columns = FusionGridColumns.Of<NightCheckResident>();
    var checksDone = Field.Of((NightCheckResident r) => r.ChecksDone);

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("NightChecksTonight", "Grid"))
            .Response(r => r.OnSuccess<List<NightCheckResident>>((residents, s) =>
                s.Component<FusionGrid>(ChecksId).DataSource.Set(residents)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Night Safety Checks</native-heading>
        <native-text color="Secondary">
            Cedar wing, night shift. Correct the two-hourly checks the aides recorded, review the changes, then save them
            to the night log.
        </native-text>
    </div>

    <native-card><native-card-body>
        @(Html.FusionGrid<NightChecksViewModel, NightCheckResident>(plan, ChecksId, b => b
            .EditSettings(new GridEditSettings { AllowEditing = true, Mode = EditMode.Batch, ShowConfirmDialog = false })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "180", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.Room), HeaderText = "Room", Width = "90", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ChecksDone), HeaderText = "Checks tonight", Width = "150", TextAlign = TextAlign.Right, EditType = "numericedit" }
            }))
            .Reactive(evt => evt.BeforeBatchSave<NightCheckResident>(), (args, p) =>
            {
                // The changes wait for the charge nurse to confirm them; the night log, not the grid, saves them.
                args.Cancel.Set(true);
                p.Component<FusionGrid>(ReviewId).DataSource.Set(args.BatchChanges.Get(x => x.ChangedRecords));
                var changed = p.From(args.BatchChanges.Get(x => x.ChangedRecords));
                p.When(changed.Any()).Truthy()
                    .Then(t => t.Element("night-checks-status").Text.Set("Check the changes below, then save them to the night log."))
                    .Else(e => e.Element("night-checks-status").Text.Set("No checks changed tonight; there is nothing to save."));
            }))

        <native-hstack gap="Sm" align="Center" class="mt-4 flex-wrap">
            @(Html.NativeButton("night-checks-review-changes", "Review changes")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(ChecksId).EndEdit()))
            <p id="night-checks-status" role="status" class="text-sm">Tonight's corrections are not saved to the night log yet.</p>
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Changes to save</native-heading>
        <native-text color="Secondary">Choose a change to correct it.</native-text>
        <div class="mt-3">
            @(Html.FusionGrid<NightChecksViewModel, NightCheckResident>(plan, ReviewId, b => b
                .Columns(new List<GridColumn>
                {
                    new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true },
                    new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "180" },
                    new GridColumn { Field = columns.Field(r => r.Room), HeaderText = "Room", Width = "90" },
                    new GridColumn { Field = columns.Field(r => r.ChecksDone), HeaderText = "Checks tonight", Width = "150", TextAlign = TextAlign.Right }
                }))
                .Reactive(evt => evt.RecordClick<NightCheckResident>(), (args, p) =>
                {
                    var checks = p.Component<FusionGrid>(ChecksId);
                    checks.EditCell(checks.GetRowIndexByPrimaryKey(args.RowData.Get(r => r.ResidentId)), checksDone);
                }))
        </div>

        <native-hstack gap="Sm" align="Center" class="mt-4 flex-wrap">
            @(Html.NativeButton("night-checks-save", "Save to the night log")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var checks = p.Component<FusionGrid>(ChecksId);
                    checks.SaveCell();
                    p.Post(Url.SandboxRoute("NightChecksLog", "Grid"))
                        .Gather<NightCheckChanges>(g => g.Set(x => x.Changes, checks.GetBatchChanges<NightCheckResident>()))
                        .Response(r => r.OnSuccess<NightChecksLogged>((logged, s) =>
                        {
                            s.Component<FusionGrid>(ChecksId).DataSource.Set(logged.Get(x => x.Residents));
                            s.Component<FusionGrid>(ReviewId).Rows<NightCheckResident>().Set(Array.Empty<NightCheckResident>());
                            s.Element("night-checks-status").Text.Set(logged.Get(x => x.Summary));
                        }));
                }))
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
