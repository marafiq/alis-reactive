@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentGridEditingModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Ops Batch Risk Review";

    const string GridId = "batch-risk-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<ResidentGridEditingModel>();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("EditingRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).SetDataSource(json);
                s.Element("batch-risk-status").SetText("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Ops Batch Risk Review</native-heading>
    <native-text color="Secondary">
        Flag a resident's risk in batch mode, then gather the pending batch changes for review.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("batch-risk-flag", "Flag Risk Critical")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).UpdateCell(0, (ResidentDirectoryGridItem x) => x.RiskLevel, "Critical");
                p.Element("batch-risk-status").SetText("updateCell string called");
            }))
        @(Html.NativeButton("batch-risk-gather", "Gather Changes")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                p.Post(Url.SandboxRoute("BatchSummary", "Grid"))
                    .Gather(g => g.Include(grid.BatchChanges<ResidentGridEditingModel, ResidentDirectoryGridItem>(), "batchChanges"))
                    .Response(r => r.OnSuccess<ResidentGridBatchSummaryResponse>((json, s) =>
                        s.Element("batch-summary").SetText(json, x => x.Summary)));
            }))
    </native-hstack>

    <native-grid cols="C1" gap="Base" class="mt-4 font-mono text-sm">
        <p>Status: <span id="batch-risk-status" class="text-text-muted">waiting</span></p>
        <p>Summary: <span id="batch-summary" class="text-text-muted">waiting</span></p>
    </native-grid>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<ResidentGridEditingModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .EditSettings(new GridEditSettings
            {
                AllowEditing = true,
                AllowEditOnDblClick = false,
                Mode = EditMode.Batch,
                ShowConfirmDialog = false
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = "residentId", HeaderText = "ID", Width = "80", IsPrimaryKey = true, AllowEditing = false, Visible = false },
                new GridColumn { Field = "residentName", HeaderText = "Resident", Width = "240", AllowEditing = false },
                new GridColumn { Field = "riskLevel", HeaderText = "Risk", Width = "180" }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
