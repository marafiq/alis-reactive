@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.FallsHuddleViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Falls Huddle";

    const string BoardId = "falls-risk-board";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium text-text hover:bg-surface-subtle";
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";

    var plan = Html.ReactivePlan<FallsHuddleViewModel>();
    var columns = FusionGridColumns.Of<FallsHuddleResident>();
    var fallRisk = Field.Of((FallsHuddleResident r) => r.FallRisk);
    var fallRiskLevels = new List<string> { "Low", "Moderate", "High" };

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("FallsHuddleResidents", "Grid"))
            .Response(r => r.OnSuccess<List<FallsHuddleResident>>((residents, s) =>
                s.Component<FusionGrid>(BoardId).DataSource.Set(residents)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Falls Huddle</native-heading>
        <native-text color="Secondary">
            Aspen wing, morning huddle. Raise the fall risk of anyone who fell overnight, adjust any other risk the team
            agrees on, and send the changes to care planning.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Fell overnight</native-heading>
        <ul class="mt-3 space-y-3">
            @foreach (var fall in Model.Falls)
            {
                <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                    <span><span class="font-medium">@fall.ResidentName</span>, @fall.WhatHappened</span>
                    @(Html.NativeButton($"raise-risk-{fall.ResidentId}", "Raise to High")
                        .CssClass(Button)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                        {
                            var board = p.Component<FusionGrid>(BoardId);
                            board.UpdateCell(board.GetRowIndexByPrimaryKey(fall.ResidentId), fallRisk, "High");
                        }))
                </li>
            }
        </ul>
    </native-card-body></native-card>

    <native-card><native-card-body>
        @(Html.FusionGrid<FallsHuddleViewModel, FallsHuddleResident>(plan, BoardId, b => b
            .EditSettings(new GridEditSettings { AllowEditing = true, Mode = EditMode.Batch, ShowConfirmDialog = false })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "180", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.Room), HeaderText = "Room", Width = "90", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.FallRisk), HeaderText = "Fall risk", Width = "150", EditTemplate = FusionGridEditTemplates.Select((FallsHuddleResident r) => r.FallRisk, fallRiskLevels) }
            })))

        <native-hstack gap="Sm" align="Center" class="mt-4 flex-wrap">
            @(Html.NativeButton("send-to-care-planning", "Send to care planning")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var board = p.Component<FusionGrid>(BoardId);
                    board.SaveCell();
                    p.Post(Url.SandboxRoute("FallsHuddleSend", "Grid"))
                        .Gather<FallsHuddleChanges>(g => g.Set(x => x.Changes, board.GetBatchChanges<FallsHuddleResident>()))
                        .Response(r => r.OnSuccess<FallsHuddleSent>((sent, s) =>
                            s.Element("care-planning-status").Text.Set(sent.Get(x => x.Summary))));
                }))
            <p id="care-planning-status" role="status" class="text-sm">Nothing sent to care planning yet.</p>
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
