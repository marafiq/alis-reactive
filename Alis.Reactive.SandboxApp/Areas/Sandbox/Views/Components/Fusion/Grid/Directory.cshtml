@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.DirectoryViewModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Resident Directory";

    const string GridId = "resident-directory-grid";
    const int PageSize = 8;
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    // The grid numbers a row's cells from 0: ID, Resident, Age, Care level, Wing.
    const int WingCell = 4;

    var plan = Html.ReactivePlan<DirectoryViewModel>();
    var columns = FusionGridColumns.Of<DirectoryResident>();

    // The residents the directory answers with, how many match, and what the last change did.
    void ShowDirectory(Data<DirectoryResults> answer, PipelineBuilder<DirectoryViewModel> s)
    {
        s.Component<FusionGrid>(GridId).Page<DirectoryResident>().Set(answer);
        s.Element("directory-summary").Text.Set(answer.Get(x => x.Summary));
        s.Element("directory-change").Text.Set(answer.Get(x => x.Change));
    }

    Html.On(plan, t => t.DomReady(p =>
        p.Post(Url.SandboxRoute("DirectoryResidents", "Grid"))
            .Gather<DirectoryQuery>(g => g
                .Set(x => x.Skip, 0)
                .Set(x => x.Take, PageSize)
                .Set(x => x.RequiresCounts, true))
            .Response(r => r.OnSuccess<DirectoryResults>(ShowDirectory))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Resident Directory</native-heading>
        <native-text color="Secondary">
            Maple Grove, 48 residents. Find a resident, see who needs attention tonight, and plan your rounds.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.Find, o => o.Label("Find a resident"))
                .FusionTextBox(b => b
                    .Placeholder("Name, care level, wing or nurse")
                    .ShowClearButton(true))
                .Reactive(evt => evt.Change, (args, p) => p.Component<FusionGrid>(GridId).Search(args.Value)); }

            <div>
                <p class="mb-1 text-xs font-medium uppercase tracking-wide text-text-muted">Surnames</p>
                <native-hstack gap="Sm" class="flex-wrap">
                    @foreach (var tab in Model.SurnameTabs)
                    {
                        @(Html.NativeButton(tab.Id, tab.Letters)
                            .CssClass(Button)
                            .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(GridId).GoToPage(tab.Page)))
                    }
                </native-hstack>
            </div>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("highest-risk-first", "Highest risk first")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Component<FusionGrid>(GridId).SortColumn(Field.Of((DirectoryResident r) => r.RiskLevel), FusionGridSortDirection.Descending, false)))
                @(Html.NativeButton("surname-order", "Surname order")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(GridId).ClearSorting()))
                @(Html.NativeButton("north-wing", "North wing")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Component<FusionGrid>(GridId).FilterByColumn(Field.Of((DirectoryResident r) => r.Wing), FusionGridTextFilterOperator.Equal, "North")))
                @(Html.NativeButton("every-wing", "Every wing")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(GridId).ClearFiltering()))
            </native-hstack>

            <native-hstack gap="Base" class="flex-wrap">
                @{ Html.InputField(plan, m => m.GroupByCareLevel, o => o.Label("Group by care level"))
                    .NativeCheckBox(b => b.CssClass("rounded border-border"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        var careLevel = Field.Of((DirectoryResident r) => r.CareLevel);
                        p.When(args.Checked).Truthy()
                            .Then(grouped => grouped.Component<FusionGrid>(GridId).GroupColumn(careLevel))
                            .Else(ungrouped => ungrouped.Component<FusionGrid>(GridId).UngroupColumn(careLevel));
                    }); }
                @{ Html.InputField(plan, m => m.GroupByWing, o => o.Label("Group by wing"))
                    .NativeCheckBox(b => b.CssClass("rounded border-border"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        var wing = Field.Of((DirectoryResident r) => r.Wing);
                        p.When(args.Checked).Truthy()
                            .Then(grouped => grouped.Component<FusionGrid>(GridId).GroupColumn(wing))
                            .Else(ungrouped => ungrouped.Component<FusionGrid>(GridId).UngroupColumn(wing));
                    }); }
                @(Html.NativeButton("no-grouping", "No grouping")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.Component<FusionGrid>(GridId).ClearGrouping();
                        p.Component<NativeCheckBox>(m => m.GroupByCareLevel).Checked.Set(false);
                        p.Component<NativeCheckBox>(m => m.GroupByWing).Checked.Set(false);
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <div class="mb-3 space-y-1 text-sm">
            <p id="directory-summary" class="font-medium">Loading the directory.</p>
            <p id="directory-change" role="status" class="text-text-muted"></p>
        </div>

        @(Html.FusionGrid<DirectoryViewModel, DirectoryResident>(plan, GridId, b => b
            .AllowPaging(true)
            .AllowSorting(true)
            .AllowMultiSorting(true)
            .AllowFiltering(true)
            .AllowGrouping(true)
            .AllowSelection(true)
            .PageSettings(new GridPageSettings { PageSize = PageSize })
            .FilterSettings(new GridFilterSettings { Type = FilterType.FilterBar, IgnoreAccent = true })
            .GroupSettings(new GridGroupSettings { ShowDropArea = false })
            .SearchSettings(new GridSearchSettings
            {
                Fields = new[] { columns.Field(r => r.ResidentName), columns.Field(r => r.CareLevel), columns.Field(r => r.Wing), columns.Field(r => r.PrimaryNurse) },
                IgnoreAccent = true
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowFiltering = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "190" },
                new GridColumn { Field = columns.Field(r => r.Age), HeaderText = "Age", Width = "80", TextAlign = TextAlign.Right, AllowFiltering = false },
                new GridColumn { Field = columns.Field(r => r.CareLevel), HeaderText = "Care level", Width = "160" },
                new GridColumn { Field = columns.Field(r => r.Wing), HeaderText = "Wing", Width = "110" },
                new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "100" },
                new GridColumn { Field = columns.Field(r => r.RiskLevel), HeaderText = "Risk", Width = "110" },
                new GridColumn { Field = columns.Field(r => r.OpenTasks), HeaderText = "Open tasks", Width = "110", TextAlign = TextAlign.Right, AllowFiltering = false },
                new GridColumn { Field = columns.Field(r => r.PrimaryNurse), HeaderText = "Primary nurse", Width = "160" }
            }))
            .Reactive(evt => evt.DataStateChange, (args, p) =>
            {
                p.Post(Url.SandboxRoute("DirectoryResidents", "Grid"))
                    .Gather<DirectoryQuery>(g => g
                        .Set(x => x.Skip, args.Skip)
                        .Set(x => x.Take, args.Take)
                        .Set(x => x.RequiresCounts, args.RequiresCounts)
                        .Set(x => x.Sorted, args.Sorted)
                        .Set(x => x.Group, args.Group)
                        .Set(x => x.Where, args.Where)
                        .Set(x => x.Search, args.Search)
                        .Set(x => x.Change, args.Action.Get(a => a.RequestType))
                        .Set(x => x.ChangedColumn, args.Action.Get(a => a.ColumnName))
                        .Set(x => x.ChangedDirection, args.Action.Get(a => a.Direction))
                        .Set(x => x.ChangedToPage, args.Action.Get(a => a.CurrentPage)))
                    .Response(r => r
                        .OnSuccess<DirectoryResults>(ShowDirectory)
                        .OnError(400, refused => refused.Element("directory-change").Text.Set("The directory could not read that request.")));
            })
            .Reactive(evt => evt.RecordClick<DirectoryResident>(), (args, p) =>
            {
                p.When(args.CellIndex).Eq(WingCell)
                    .Then(t => t.Component<FusionGrid>(GridId).FilterByColumn(Field.Of((DirectoryResident r) => r.Wing), FusionGridTextFilterOperator.Equal, args.RowData.Get(r => r.Wing)));
            })
            .Reactive(evt => evt.RowSelected<DirectoryResident>(), (args, p) =>
            {
                p.When(args.PreviousRowIndex).IsNull()
                    .Then(t => t.Element("card-tip").Show())
                    .Else(e => e.Element("card-tip").Hide());
                p.Post(Url.SandboxRoute("DirectoryResidentCard", "Grid"))
                    .Gather<DirectoryCardRequest>(g => g
                        .Set(x => x.ResidentId, args.Data.Get(r => r.ResidentId))
                        .Set(x => x.RowIndex, args.RowIndex)
                        .Set(x => x.PickedFromDirectory, args.IsInteracted))
                    .Response(r => r.OnSuccess<DirectoryCard>((card, s) =>
                    {
                        s.Element("card-name").Text.Set(card.Get(x => x.Name));
                        s.Element("card-details").Text.Set(card.Get(x => x.Details));
                        s.Element("card-context").Text.Set(card.Get(x => x.Context));
                        s.Element("rounds-status").Text.Set("");
                        s.Element("resident-card").Show();
                    }));
            }))
    </native-card-body></native-card>

    <section id="resident-card" hidden class="rounded-lg border border-border bg-white p-5 shadow-sm">
        <h2 id="card-name" class="text-lg font-semibold"></h2>
        <p id="card-details" class="mt-1 text-sm text-text-secondary"></p>
        <p id="card-context" class="mt-1 text-sm text-text-muted"></p>
        <p id="card-tip" hidden class="mt-2 text-xs text-text-muted">Step through this page with Next resident.</p>
        <native-hstack gap="Sm" class="mt-4 flex-wrap">
            @(Html.NativeButton("next-resident", "Next resident")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var grid = p.Component<FusionGrid>(GridId);
                    p.Post(Url.SandboxRoute("DirectoryNextOnRounds", "Grid"))
                        .Gather<DirectoryNextRequest>(g => g.Set(x => x.SelectedRowIndexes, grid.GetSelectedRowIndexes()))
                        .Response(r => r.OnSuccess<DirectoryNextResident>((next, s) =>
                            s.Component<FusionGrid>(GridId).SelectRow(next.Get(x => x.RowIndex))));
                }))
            @(Html.NativeButton("add-to-rounds", "Add to tonight's rounds")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var grid = p.Component<FusionGrid>(GridId);
                    p.Post(Url.SandboxRoute("DirectoryAddToRounds", "Grid"))
                        .Gather<DirectoryRoundsRequest>(g => g.Set(x => x.Residents, grid.GetSelectedRecords<DirectoryResident>()))
                        .Response(r => r.OnSuccess<DirectoryRounds>((rounds, s) =>
                            s.Element("rounds-status").Text.Set(rounds.Get(x => x.Summary))));
                }))
            @(Html.NativeButton("close-card", "Close")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Element("resident-card").Hide();
                    p.Component<FusionGrid>(GridId).ClearSelection();
                }))
        </native-hstack>
        <p id="rounds-status" class="mt-3 text-sm"></p>
    </section>
</native-vstack>

@Html.RenderPlan(plan)
