@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentBillingViewModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.AppLevel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Fusion.Templates
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Month-End Billing";

    const string GridId = "billing-grid";
    const string AddFormId = "billing-add-form";
    const string EmailStatementsItem = "billing-email-statements";
    const int PageSize = 12;
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";
    const string ButtonAccent = "rounded-md bg-accent px-3 py-2 text-sm font-medium text-white hover:bg-accent/90";

    var plan = Html.ReactivePlan<ResidentBillingViewModel>();

    var columns = FusionGridColumns.Of<ResidentBillingItem>();

    var statusTemplate = FusionTemplate.Create<ResidentBillingItem>()
        .When(m => m.BillingStatus == "Paid",
            then: t => t.Badge(m => m.BillingStatus, "rounded bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-700"),
            @else: e => e.Badge(m => m.BillingStatus, "rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700"))
        .Render();

    // A page of the board as the server answers it, and the sentence that says what the board holds.
    void ShowBoard(Data<ResidentBillingResponse> board, PipelineBuilder<ResidentBillingViewModel> s)
    {
        s.Component<FusionGrid>(GridId).Page<ResidentBillingItem>().Set(board);
        s.Element("billing-summary").Text.Set(board.Get(x => x.Summary));
    }

    // The board's first page, narrowed by what the filters hold.
    void LoadBoard(PipelineBuilder<ResidentBillingViewModel> p) =>
        p.Post(Url.SandboxRoute("BillingData", "Grid"))
            .Gather<BillingDataRequest>(g => g
                .Set(x => x.Skip, 0)
                .Set(x => x.Take, PageSize)
                .Form(m => m.FilterCareLevel, m => m.FilterWing, m => m.FilterStatus))
            .Response(r => r.OnSuccess<ResidentBillingResponse>(ShowBoard));

    // What the office did, as the server says it.
    void Tell(Data<BillingAnswer> answer, PipelineBuilder<ResidentBillingViewModel> s)
    {
        var toast = s.Component<FusionToast>();
        toast.Title.Set("Month-end billing");
        toast.Content.Set(answer.Get(x => x.Summary));
        toast.Tone.Set(FusionToastTone.Success);
        toast.Show();
    }

    // A change to the charges is told, then the grid asks the server again for the page, sort and filters it shows.
    void TellAndReload(Data<BillingAnswer> answer, PipelineBuilder<ResidentBillingViewModel> s)
    {
        Tell(answer, s);
        s.Component<FusionGrid>(GridId).Refresh();
    }

    Html.On(plan, t => t.DomReady(LoadBoard));
}

<div id="add-charge-dialog" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4">
    <div class="w-full max-w-lg rounded-lg border border-border bg-white p-6 shadow-xl">
        <native-heading level="H2">Add Resident Charges</native-heading>
        <native-text color="Secondary">Open this month's charges for a resident who is not on the board yet.</native-text>
        <form id="@AddFormId" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            @{ Html.InputField(plan, m => m.NewResidentName, o => o.Required().Label("Resident"))
                .FusionTextBox(b => b.Placeholder("Resident name").ShowClearButton(true)); }
            @{ Html.InputField(plan, m => m.NewCareLevel, o => o.Required().Label("Care level"))
                .FusionDropDownList(b => b.DataSource(MonthEndBillingOptions.CareLevels).Placeholder("Select care level")); }
            @{ Html.InputField(plan, m => m.NewMonthlyRate, o => o.Required().Label("Monthly rate"))
                .FusionNumericTextBox(b => b.Format("c0").Min(0).Max(20000).Step(50).Placeholder("0")); }
            @{ Html.InputField(plan, m => m.NewAddOnCharges, o => o.Required().Label("Add-on charges"))
                .FusionNumericTextBox(b => b.Format("c0").Min(0).Max(5000).Step(25).Placeholder("0")); }
        </form>
        <native-hstack gap="Sm" justify="End" class="mt-5">
            @(Html.NativeButton("add-charge-cancel", "Cancel")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Element("add-charge-dialog").ClassList.Add("hidden")))
            @(Html.NativeButton("add-charge-save", "Open Charges")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post(Url.SandboxRoute("BillingAddCharge", "Grid"))
                        .Gather(g => g.Form(m => m.NewResidentName, m => m.NewCareLevel, m => m.NewMonthlyRate, m => m.NewAddOnCharges))
                        .Validate<ResidentBillingAddValidator>(AddFormId)
                        .Response(r => r
                            .OnSuccess<BillingAnswer>((answer, s) =>
                            {
                                s.Element("add-charge-dialog").ClassList.Add("hidden");
                                TellAndReload(answer, s);
                            })
                            .OnError(400, e => e.ValidationErrors(AddFormId)));
                }))
        </native-hstack>
    </div>
</div>

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Month-End Billing</native-heading>
        <native-text color="Secondary">
            Maple Grove business office, October charges. Narrow the board, correct a resident's rate or add-ons in
            the grid, raise or bill the residents you select, and email each family with a balance due their statement.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Filter the board</native-heading>
        <native-grid cols="C3" gap="Base" class="mt-4">
            @{ Html.InputField(plan, m => m.FilterCareLevel, o => o.Label("Care level"))
                .FusionDropDownList(b => b.DataSource(MonthEndBillingOptions.CareLevels).Placeholder("All care levels")); }
            @{ Html.InputField(plan, m => m.FilterWing, o => o.Label("Wing"))
                .FusionDropDownList(b => b.DataSource(MonthEndBillingOptions.Wings).Placeholder("All wings")); }
            @{ Html.InputField(plan, m => m.FilterStatus, o => o.Label("Status"))
                .FusionDropDownList(b => b.DataSource(MonthEndBillingOptions.Statuses).Placeholder("All statuses")); }
        </native-grid>
        <native-hstack gap="Sm" class="mt-4 flex-wrap">
            @(Html.NativeButton("billing-apply-filters", "Apply Filters")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) => LoadBoard(p)))
            @(Html.NativeButton("billing-quick-unbilled", "Unbilled Only")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionDropDownList>(m => m.FilterStatus).Value.Set("Pending");
                    LoadBoard(p);
                }))
            @(Html.NativeButton("billing-quick-memory", "Memory Care")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionDropDownList>(m => m.FilterCareLevel).Value.Set("Memory Care");
                    LoadBoard(p);
                }))
            @(Html.NativeButton("billing-clear-filters", "Clear Filters")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionDropDownList>(m => m.FilterCareLevel).Clear();
                    p.Component<FusionDropDownList>(m => m.FilterWing).Clear();
                    p.Component<FusionDropDownList>(m => m.FilterStatus).Clear();
                    LoadBoard(p);
                }))
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="mb-4 flex-wrap">
            @(Html.NativeButton("billing-add-open", "Add Charges")
                .CssClass(ButtonAccent)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Element("add-charge-dialog").ClassList.Remove("hidden")))
            @(Html.NativeButton("billing-save-all", "Save Rate Changes")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var grid = p.Component<FusionGrid>(GridId);
                    grid.SaveCell();
                    p.Post(Url.SandboxRoute("BillingSave", "Grid"))
                        .Gather<BillingSaveRequest>(g => g.Set(x => x.BatchChanges, grid.GetBatchChanges<ResidentBillingItem>()))
                        .Response(r => r.OnSuccess<BillingAnswer>(TellAndReload));
                }))
            @(Html.NativeButton("billing-bulk-increase", "Raise Selected Rates 5%")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var grid = p.Component<FusionGrid>(GridId);
                    p.Post(Url.SandboxRoute("BillingBulkIncrease", "Grid"))
                        .Gather<BillingBulkRequest>(g => g
                            .Set(x => x.Percent, 5m)
                            .Set(x => x.SelectedRecords, grid.GetSelectedRecords<ResidentBillingItem>()))
                        .Response(r => r.OnSuccess<BillingAnswer>(TellAndReload));
                }))
            @(Html.NativeButton("billing-mark-billed", "Mark Selected Billed")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var grid = p.Component<FusionGrid>(GridId);
                    p.Post(Url.SandboxRoute("BillingMarkBilled", "Grid"))
                        .Gather<BillingBulkRequest>(g => g.Set(x => x.SelectedRecords, grid.GetSelectedRecords<ResidentBillingItem>()))
                        .Response(r => r.OnSuccess<BillingAnswer>(TellAndReload));
                }))
        </native-hstack>

        <p id="billing-summary" role="status" class="mb-3 text-sm font-medium">Loading this month's charges…</p>

        @(Html.FusionGrid<ResidentBillingViewModel, ResidentBillingItem>(plan, GridId, b => b
            .AllowPaging(true)
            .AllowSorting(true)
            .AllowSelection(true)
            .ShowColumnChooser(true)
            .Toolbar(new List<object>
            {
                new { text = "Email statements", id = EmailStatementsItem, tooltipText = "Email each family with a balance due their statement", prefixIcon = "e-icons e-send-1" },
                "ColumnChooser"
            })
            .PageSettings(new GridPageSettings { PageSize = PageSize })
            .SelectionSettings(new GridSelectionSettings { Type = SelectionType.Multiple, PersistSelection = true })
            .EditSettings(new GridEditSettings { AllowEditing = true, Mode = EditMode.Batch, ShowConfirmDialog = false })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "70", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "170", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.CareLevel), HeaderText = "Care Level", Width = "150", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.Wing), HeaderText = "Wing", Width = "90", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.MonthlyRate), HeaderText = "Monthly Rate", Width = "140", Format = "C0", TextAlign = TextAlign.Right, EditType = "numericedit" },
                new GridColumn { Field = columns.Field(r => r.AddOnCharges), HeaderText = "Add-ons", Width = "120", Format = "C0", TextAlign = TextAlign.Right, EditType = "numericedit" },
                new GridColumn { Field = columns.Field(r => r.BalanceDue), HeaderText = "Balance Due", Width = "140", Format = "C0", TextAlign = TextAlign.Right, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.BillingStatus), HeaderText = "Status", Width = "120", AllowEditing = false, Template = statusTemplate }
            }))
            .Reactive(evt => evt.DataStateChange, (args, p) =>
                p.Post(Url.SandboxRoute("BillingData", "Grid"))
                    .Gather<BillingDataRequest>(g => g
                        .Set(x => x.Skip, args.Skip)
                        .Set(x => x.Take, args.Take)
                        .Set(x => x.Sorted, args.Sorted)
                        .Form(m => m.FilterCareLevel, m => m.FilterWing, m => m.FilterStatus))
                    .Response(r => r.OnSuccess<ResidentBillingResponse>(ShowBoard)))
            .Reactive(evt => evt.ToolbarClick, (args, p) =>
                p.When(args.Item.Get(x => x.Id)).Eq(EmailStatementsItem)
                    .Then(t => t.Post(Url.SandboxRoute("BillingEmailStatements", "Grid"))
                        .Gather<BillingStatementsRequest>(g => g.Form(m => m.FilterCareLevel, m => m.FilterWing, m => m.FilterStatus))
                        .Response(r => r.OnSuccess<BillingAnswer>(Tell)))))
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
