@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentGridEditingModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Ops Batch Task Update";

    const string GridId = "batch-task-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<ResidentGridEditingModel>();

    // Focused scenario: a care lead edits a resident's open-task count in batch mode and commits the cell.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("EditingRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).SetDataSource(json);
                s.Element("batch-status").SetText("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Ops Batch Task Update</native-heading>
    <native-text color="Secondary">
        Edit a resident's open-task cell in batch mode, set the value, and save the cell.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("batch-edit-cell", "Edit Tasks Cell")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).EditCell(0, (ResidentDirectoryGridItem x) => x.OpenTasks);
                p.Element("batch-status").SetText("editCell called");
            }))
        @(Html.NativeButton("batch-update-cell", "Set Tasks To 6")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).UpdateCell(0, (ResidentDirectoryGridItem x) => x.OpenTasks, 6);
                p.Element("batch-status").SetText("updateCell called");
            }))
        @(Html.NativeButton("batch-save-cell", "Save Cell")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).SaveCell();
                p.Element("batch-status").SetText("saveCell called");
            }))
    </native-hstack>

    <p class="font-mono text-sm">Status: <span id="batch-status" class="text-text-muted">waiting</span></p>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<ResidentGridEditingModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .EditSettings(new GridEditSettings
            {
                AllowEditing = true,
                AllowEditOnDblClick = false,
                Mode = EditMode.Batch,
                ShowConfirmDialog = false
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = "residentId", HeaderText = "ID", Width = "80", IsPrimaryKey = true, AllowEditing = false, Visible = false },
                new GridColumn { Field = "residentName", HeaderText = "Resident", Width = "220", AllowEditing = false },
                new GridColumn { Field = "openTasks", HeaderText = "Open Tasks", Width = "140", TextAlign = TextAlign.Right, EditType = "numericedit" }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
