@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.DayTaskBoardViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Day Task Board";

    const string BoardId = "day-task-board";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";

    var plan = Html.ReactivePlan<DayTaskBoardViewModel>();
    var columns = FusionGridColumns.Of<DayTaskBoardResident>();
    var openTasks = Field.Of((DayTaskBoardResident r) => r.OpenTasks);

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("DayTaskBoardResidents", "Grid"))
            .Response(r => r.OnSuccess<List<DayTaskBoardResident>>((residents, s) =>
                s.Component<FusionGrid>(BoardId).DataSource.Set(residents)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Day Task Board</native-heading>
        <native-text color="Secondary">
            Birch wing, day shift. Keep each resident's open tasks current as you work through the wing, then hand the
            board over to the evening shift.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="mb-4 flex-wrap">
            @(Html.NativeButton("board-start", "Start with the first resident")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionGrid>(BoardId).EditCell(0, openTasks)))
            @(Html.NativeButton("board-all-done", "All tasks done")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var board = p.Component<FusionGrid>(BoardId);
                    var chosen = p.From(board.GetSelectedRowIndexes());
                    p.When(chosen.Any()).Truthy()
                        .Then(done =>
                        {
                            done.Element("board-choose").Hide();
                            board.UpdateCell(chosen.Find(row => true), openTasks, 0);
                        })
                        .Else(none => none.Element("board-choose").Show());
                }))
            @(Html.NativeButton("board-hand-over", "Hand over to the evening shift")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var board = p.Component<FusionGrid>(BoardId);
                    board.SaveCell();
                    p.Post(Url.SandboxRoute("DayTaskBoardHandover", "Grid"))
                        .Gather<DayTaskBoardChanges>(g => g.Set(x => x.Changes, board.GetBatchChanges<DayTaskBoardResident>()))
                        .Response(r => r.OnSuccess<DayTaskBoardHandedOver>((handedOver, s) =>
                        {
                            s.Component<FusionGrid>(BoardId).DataSource.Set(handedOver.Get(x => x.Residents));
                            s.Element("board-status").Text.Set(handedOver.Get(x => x.Summary));
                        }));
                }))
        </native-hstack>

        @(Html.FusionGrid<DayTaskBoardViewModel, DayTaskBoardResident>(plan, BoardId, b => b
            .EditSettings(new GridEditSettings { AllowEditing = true, Mode = EditMode.Batch, ShowConfirmDialog = false })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "180", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.Room), HeaderText = "Room", Width = "90", AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.OpenTasks), HeaderText = "Open tasks", Width = "130", TextAlign = TextAlign.Right, EditType = "numericedit" }
            })))

        <div class="mt-4 space-y-1 text-sm">
            <p id="board-choose" hidden class="text-red-700">Choose a resident on the board, then mark their tasks done.</p>
            <p id="board-status" role="status">The board has not been handed over yet.</p>
        </div>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
