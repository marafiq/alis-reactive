@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentGridEditingModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care Reviews";

    const string ReviewListId = "care-review-grid";

    var plan = Html.ReactivePlan<ResidentGridEditingModel>();

    var columns = FusionGridColumns.Of<CareReviewResident>();
    var riskLevels = new List<string> { "Low", "Moderate", "High" };

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("BeginEditNormalRoster", "Grid"))
            .Response(r => r.OnSuccess<List<CareReviewResident>>((residents, s) =>
                s.Component<FusionGrid>(ReviewListId).DataSource.Set(residents)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Care Reviews</native-heading>
        <native-text color="Secondary">
            Maple wing wellness nurse. Select a resident and open their review to set their risk and open tasks. A
            record on hold stays closed until the hold is lifted.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-hstack gap="Sm" align="Center" class="mb-4 flex-wrap">
            @(Html.NativeButton("open-review", "Open review")
                .CssClass("rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90")
                .Reactive(plan, evt => evt.Click, (args, p) => p.Component<FusionGrid>(ReviewListId).StartEdit()))
            <p id="review-checkout" class="text-sm text-text-muted">No review open.</p>
        </native-hstack>
        <p id="hold-notice" hidden class="mb-3 text-sm text-red-700">
            <span id="hold-notice-resident"></span>'s record is on hold (<span id="hold-notice-reason"></span>). Lift the hold to open the review.
        </p>

        @(Html.FusionGrid<ResidentGridEditingModel, CareReviewResident>(plan, ReviewListId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings
            {
                AllowEditing = true,
                AllowEditOnDblClick = false,
                Mode = EditMode.Dialog,
                Template = FusionGridEditTemplates.DialogForm<CareReviewResident>(d => d
                    .Text(r => r.ResidentName, "Resident")
                    .Select(r => r.RiskLevel, "Risk level", riskLevels)
                    .Number(r => r.OpenTasks, "Open tasks"))
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "170" },
                new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "90" },
                new GridColumn { Field = columns.Field(r => r.RiskLevel), HeaderText = "Risk", Width = "110" },
                new GridColumn { Field = columns.Field(r => r.OpenTasks), HeaderText = "Open tasks", Width = "110", TextAlign = TextAlign.Right },
                new GridColumn { Field = columns.Field(r => r.HoldReason), HeaderText = "Hold", Width = "240", AllowEditing = false }
            }))
            .Reactive(evt => evt.BeginEdit<CareReviewResident>(), (args, p) =>
            {
                // A record on hold belongs to the team that holds it; opening the review would check it out.
                p.When(args.RowData.Get(x => x.HoldReason)).NotEmpty()
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("hold-notice-resident").Text.Set(args.RowData.Get(x => x.ResidentName));
                        t.Element("hold-notice-reason").Text.Set(args.RowData.Get(x => x.HoldReason));
                        t.Element("hold-notice").Show();
                    })
                    .Else(e =>
                    {
                        e.Element("hold-notice").Hide();
                        e.Post(Url.SandboxRoute("BeginEditNormalCheckout", "Grid"))
                            .Gather<CareReviewCheckout>(g => g
                                .Set(x => x.ResidentId, args.RowData.Get(x => x.ResidentId))
                                .Set(x => x.CensusLine, args.RowIndex))
                            .Response(r => r.OnSuccess<CareReviewCheckedOut>((checkedOut, s) =>
                                s.Element("review-checkout").Text.Set(checkedOut.Get(x => x.Summary))));
                    });
            })
            .Reactive(evt => evt.ActionComplete<CareReviewResident>(), (args, p) =>
                p.When(args.RequestType).Eq("save").Then(t =>
                {
                    t.Element("review-saved-resident").Text.Set(args.Data.Get(x => x.ResidentName));
                    t.Element("review-saved-risk").Text.Set(args.Data.Get(x => x.RiskLevel));
                    t.Element("review-saved-tasks").Text.Set(args.Data.Get(x => x.OpenTasks));
                    t.Element("review-saved").Show();
                })))

        <p id="review-saved" hidden class="mt-4 text-sm text-green-700">
            Review saved for <span id="review-saved-resident"></span>: <span id="review-saved-risk"></span> risk, <span id="review-saved-tasks"></span> open tasks.
        </p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
