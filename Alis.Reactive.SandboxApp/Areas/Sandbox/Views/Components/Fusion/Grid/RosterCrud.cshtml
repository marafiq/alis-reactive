@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.RosterCrudModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Cedar Wing Front Desk";

    const string RosterId = "cedar-roster";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";
    const string PrimaryButton = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";
    const string InputCss = "rounded-md border border-border px-3 py-1.5 text-sm";

    var plan = Html.ReactivePlan<RosterCrudModel>();

    var columns = FusionGridColumns.Of<CedarResident>();

    // Every answer the desk gets, kept or refused, is the line under the roster.
    void ShowRefusal(ResponseBuilder<RosterCrudModel> r, int status) =>
        r.OnError<CedarDeskRefusal>(status, (refused, e) => e.Element("desk-status").Text.Set(refused.Get(x => x.Summary)));

    // A move-out the business office cleared takes the resident's row off the roster.
    void RecordMoveOut(PipelineBuilder<RosterCrudModel> p, CedarMovingOut leaving) =>
        p.Post(Url.SandboxRoute("RosterCrudMoveOut", "Grid"))
            .Gather<CedarMoveOut>(g => g.Set(x => x.ResidentId, leaving.ResidentId))
            .Response(r =>
            {
                r.OnSuccess<CedarMovedOut>((movedOut, s) =>
                {
                    var roster = s.Component<FusionGrid>(RosterId);
                    roster.SelectRow(roster.GetRowIndexByPrimaryKey(movedOut.Get(x => x.ResidentId)));
                    roster.DeleteRecord();
                    s.Element($"moving-out-{leaving.ResidentId}").Hide();
                    s.Element("desk-status").Text.Set(movedOut.Get(x => x.Summary));
                });
                ShowRefusal(r, 409);
            });

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("RosterCrudRoster", "Grid"))
            .Response(r => r.OnSuccess<List<CedarResident>>((residents, s) =>
                s.Component<FusionGrid>(RosterId).DataSource.Set(residents)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Cedar Wing Front Desk</native-heading>
        <native-text color="Secondary">
            Keep the wing's roster in suite order: admit residents into free suites, move a resident to another suite,
            and record today's move-outs.
        </native-text>
    </div>

    <native-card><native-card-body>
        @(Html.FusionGrid<RosterCrudModel, CedarResident>(plan, RosterId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings
            {
                AllowAdding = true,
                AllowEditing = true,
                AllowDeleting = true,
                AllowEditOnDblClick = false,
                Mode = EditMode.Normal,
                ShowDeleteConfirmDialog = false
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", IsPrimaryKey = true, Visible = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "200" },
                new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "100" },
                new GridColumn { Field = columns.Field(r => r.MovedIn), HeaderText = "Moved in", Width = "140" }
            })))

        <native-hstack gap="Sm" align="End" class="mt-4 flex-wrap">
            @{ Html.InputField(plan, m => m.NewSuite, o => o.Label("New suite for the resident picked above"))
                .NativeTextBox(b => b.Placeholder("118").CssClass(InputCss)); }
            @(Html.NativeButton("move-to-suite", "Move to suite")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Post(Url.SandboxRoute("RosterCrudMove", "Grid"))
                        .Gather<CedarSuiteChange>(g => g
                            .Set(x => x.Residents, p.Component<FusionGrid>(RosterId).GetSelectedRecords<CedarResident>())
                            .Form(m => m.NewSuite))
                        .Response(r =>
                        {
                            r.OnSuccess<CedarResidentMoved>((moved, s) =>
                            {
                                var roster = s.Component<FusionGrid>(RosterId);
                                roster.UpdateRow(roster.GetRowIndexByPrimaryKey(moved.Get(x => x.Resident.ResidentId)), moved.Get(x => x.Resident));
                                s.Element("desk-status").Text.Set(moved.Get(x => x.Summary));
                            });
                            ShowRefusal(r, 400);
                        })))
        </native-hstack>
        <p id="desk-status" class="mt-4 text-sm font-medium">No changes at the desk yet today.</p>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Admit a resident</native-heading>
        <native-hstack gap="Sm" align="End" class="mt-2 flex-wrap">
            @{ Html.InputField(plan, m => m.AdmitName, o => o.Label("Resident's name"))
                .NativeTextBox(b => b.Placeholder("Full name").CssClass(InputCss)); }
            @{ Html.InputField(plan, m => m.AdmitSuite, o => o.Label("Suite"))
                .NativeTextBox(b => b.Placeholder("110").CssClass(InputCss)); }
            @(Html.NativeButton("admit-resident", "Admit")
                .CssClass(PrimaryButton)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Post(Url.SandboxRoute("RosterCrudAdmit", "Grid"))
                        .Gather(g => g.Form(m => m.AdmitName, m => m.AdmitSuite))
                        .Response(r =>
                        {
                            r.OnSuccess<CedarAdmitted>((admitted, s) =>
                            {
                                s.Component<FusionGrid>(RosterId).AddRecordAt(admitted.Get(x => x.Resident), admitted.Get(x => x.Position));
                                s.Element("desk-status").Text.Set(admitted.Get(x => x.Summary));
                            });
                            ShowRefusal(r, 400);
                        })))
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Moving out today</native-heading>
        <ul class="mt-2 space-y-2 text-sm">
            @foreach (var leaving in Model.MovingOutToday)
            {
                <li id="moving-out-@leaving.ResidentId" class="flex flex-wrap items-center gap-3">
                    <span>@leaving.ResidentName, suite @leaving.Suite</span>
                    @(Html.NativeButton($"record-move-out-{leaving.ResidentId}", $"Record {leaving.ResidentName}'s move-out")
                        .CssClass(Button)
                        .Reactive(plan, evt => evt.Click, (args, p) => RecordMoveOut(p, leaving)))
                </li>
            }
        </ul>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
