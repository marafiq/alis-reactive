@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentGridEditingModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Care-Ops Roster CRUD";

    const string GridId = "roster-crud-grid";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";

    var plan = Html.ReactivePlan<ResidentGridEditingModel>();

    var columns = FusionGridColumns.Of<ResidentDirectoryGridItem>();

    // Focused scenario: a care lead adds a resident, updates the top row, then deletes it.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("EditingRows", "Grid"))
            .Response(r => r.OnSuccess<List<ResidentDirectoryGridItem>>((json, s) =>
            {
                s.Component<FusionGrid>(GridId).DataSource.Set(json);
                s.Element("crud-status").Text.Set("loaded");
            }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-Ops Roster CRUD</native-heading>
    <native-text color="Secondary">
        Add a new resident at the top, replace the top row, then delete the selected resident.
    </native-text>

    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("crud-add", "Add Resident")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).AddRecordAt<ResidentDirectoryGridItem>(new ResidentDirectoryGridItem
                {
                    ResidentId = 7100,
                    ResidentName = "Zara Inline",
                    Age = 81,
                    CareLevel = "Memory Care",
                    Wing = "North",
                    Suite = "N-710",
                    RiskLevel = "High",
                    PrimaryNurse = "Nora Ellis",
                    OpenTasks = 5,
                    NextReviewDate = "2026-06-22"
                }, 0);
                p.Element("crud-status").Text.Set("addRecord called");
            }))
        @(Html.NativeButton("crud-update", "Replace Top Row")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<FusionGrid>(GridId).UpdateRow<ResidentDirectoryGridItem>(0, new ResidentDirectoryGridItem
                {
                    ResidentId = 7100,
                    ResidentName = "Amina Updated",
                    Age = 91,
                    CareLevel = "Skilled Nursing",
                    Wing = "West",
                    Suite = "W-118",
                    RiskLevel = "Moderate",
                    PrimaryNurse = "Malik Stone",
                    OpenTasks = 3,
                    NextReviewDate = "2026-06-19"
                });
                p.Element("crud-status").Text.Set("updateRow called");
            }))
        @(Html.NativeButton("crud-delete", "Delete Top Resident")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                var grid = p.Component<FusionGrid>(GridId);
                grid.SelectRow(0);
                grid.DeleteRecord();
                p.Element("crud-status").Text.Set("deleteRecord called");
            }))
    </native-hstack>

    <p class="font-mono text-sm">Status: <span id="crud-status" class="text-text-muted">waiting</span></p>

    <section class="rounded-lg border border-border bg-white p-5 shadow-sm">
        @(Html.FusionGrid<ResidentGridEditingModel, ResidentDirectoryGridItem>(plan, GridId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings
            {
                AllowAdding = true,
                AllowEditing = true,
                AllowDeleting = true,
                Mode = EditMode.Normal,
                ShowConfirmDialog = false
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", IsPrimaryKey = true, AllowEditing = false, Visible = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "240" },
                new GridColumn { Field = columns.Field(r => r.OpenTasks), HeaderText = "Open Tasks", Width = "140", TextAlign = TextAlign.Right }
            })))
    </section>
</native-vstack>

@Html.RenderPlan(plan)
