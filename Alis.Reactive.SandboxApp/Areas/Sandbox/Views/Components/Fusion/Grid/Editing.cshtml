@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentGridEditingModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Maple Wing Roster";

    const string RosterId = "maple-roster";
    const string CorrectionFormId = "maple-correction-form";
    const string MemoryCare = "Memory Care";
    const string ButtonPrimary = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";
    const string ButtonLink = "rounded-md px-2 py-1 text-sm font-medium text-primary underline-offset-2 hover:underline";

    var plan = Html.ReactivePlan<ResidentGridEditingModel>();

    var columns = FusionGridColumns.Of<MapleRosterResident>();
    var riskLevels = new List<string> { "Low", "Moderate", "High" };

    // This week's respite booking: Walter Kim stays in suite 120 while his daughter travels.
    var respiteGuest = new MapleRosterResident
    {
        ResidentId = 7301,
        ResidentName = "Walter Kim",
        CareLevel = "Respite",
        Suite = "120",
        RiskLevel = "Low",
        OpenTasks = 1,
        PrimaryNurse = "Nora Ellis"
    };

    // The roster's status line: what the coordinator just did, and to whom.
    void ShowStatus(PipelineBuilder<ResidentGridEditingModel> p, string action, TypedSource<string> resident, string ending)
    {
        p.Element("roster-status-action").Text.Set(action);
        p.Element("roster-status-resident").Text.Set(resident);
        p.Element("roster-status-ending").Text.Set(ending);
    }

    // A resident due for review: their row is selected wherever it sits on the roster, then opened.
    void Review(PipelineBuilder<ResidentGridEditingModel> p, int residentId)
    {
        var roster = p.Component<FusionGrid>(RosterId);
        roster.SelectRow(roster.GetRowIndexByPrimaryKey(residentId));
        roster.StartEdit();
    }

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("EditingRoster", "Grid"))
            .Response(r => r.OnSuccess<List<MapleRosterResident>>((residents, s) =>
                s.Component<FusionGrid>(RosterId).DataSource.Set(residents)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Maple Wing Roster</native-heading>
        <native-text color="Secondary">
            Resident services. Keep the roster the nurses work from in step with who lives on the wing: correct a
            resident's details, admit from the waiting list, and move residents out.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Due for review today</native-heading>
        <native-hstack gap="Sm" class="mt-2 flex-wrap">
            @(Html.NativeButton("review-henry-liu", "Henry Liu, suite 108")
                .CssClass(ButtonLink)
                .Reactive(plan, evt => evt.Click, (args, p) => Review(p, 6103)))
            @(Html.NativeButton("review-irene-morgan", "Irene Morgan, suite 112")
                .CssClass(ButtonLink)
                .Reactive(plan, evt => evt.Click, (args, p) => Review(p, 6104)))
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="mb-4 flex-wrap">
            @(Html.NativeButton("roster-edit", "Edit")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Component<FusionGrid>(RosterId).StartEdit()))
            @(Html.NativeButton("roster-save", "Save")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Component<FusionGrid>(RosterId).EndEdit()))
            @(Html.NativeButton("roster-cancel", "Cancel")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) => p.Component<FusionGrid>(RosterId).CloseEdit()))
            @(Html.NativeButton("roster-move-out", "Move out")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var roster = p.Component<FusionGrid>(RosterId);
                    var leaving = p.From(roster.GetSelectedRecords<MapleRosterResident>());
                    p.When(leaving.Any()).Truthy().Then(t =>
                    {
                        ShowStatus(t, "Moved out ", leaving.Find(r => true, r => r.ResidentName), ".");
                        roster.DeleteRecord();
                    });
                }))
            @(Html.NativeButton("roster-add-respite", "Add Walter Kim's respite stay")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Component<FusionGrid>(RosterId).AddRecordAt<MapleRosterResident>(respiteGuest, 0)))
            @(Html.NativeButton("roster-admit", "Admit next from the waiting list")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Post(Url.SandboxRoute("EditingAdmission", "Grid"))
                        .Response(r => r.OnSuccess<MapleRosterResident>((admitted, s) =>
                            s.Component<FusionGrid>(RosterId).AddRecordAt(admitted, 0)))))
        </native-hstack>

        @(Html.FusionGrid<ResidentGridEditingModel, MapleRosterResident>(plan, RosterId, b => b
            .AllowSelection(true)
            .EditSettings(new GridEditSettings
            {
                AllowAdding = true,
                AllowEditing = true,
                AllowDeleting = true,
                AllowEditOnDblClick = false,
                Mode = EditMode.Normal,
                ShowDeleteConfirmDialog = false
            })
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", TextAlign = TextAlign.Right, IsPrimaryKey = true, AllowEditing = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "170" },
                new GridColumn { Field = columns.Field(r => r.CareLevel), HeaderText = "Care level", Width = "150" },
                new GridColumn { Field = columns.Field(r => r.Suite), HeaderText = "Suite", Width = "90" },
                new GridColumn { Field = columns.Field(r => r.RiskLevel), HeaderText = "Risk", Width = "110" },
                new GridColumn { Field = columns.Field(r => r.OpenTasks), HeaderText = "Open tasks", Width = "110", TextAlign = TextAlign.Right },
                new GridColumn { Field = columns.Field(r => r.PrimaryNurse), HeaderText = "Primary nurse", Width = "150" }
            }))
            .Reactive(evt => evt.BeginEdit<MapleRosterResident>(), (args, p) =>
                ShowStatus(p, "Editing ", args.RowData.Get(x => x.ResidentName), "."))
            .Reactive(evt => evt.ActionBegin<MapleRosterResident>(), (args, p) =>
            {
                // A move into memory care is a transfer to Willow wing, booked by the transfer team, not a roster edit.
                p.When(args.RequestType).Eq("save")
                    .And(args.Action).Eq("edit")
                    .And(args.Data.Get(x => x.CareLevel)).Eq(MemoryCare)
                    .And(args.PreviousData.Get(x => x.CareLevel)).NotEq(MemoryCare)
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("transfer-warning-resident").Text.Set(args.PreviousData.Get(x => x.ResidentName));
                        t.Element("transfer-warning").Show();
                    })
                    .Else(e => e.Element("transfer-warning").Hide());
            })
            .Reactive(evt => evt.ActionComplete<MapleRosterResident>(), (args, p) =>
            {
                p.When(args.RequestType).Eq("save").And(args.Action).Eq("add")
                    .Then(t => ShowStatus(t, "Added ", args.Data.Get(x => x.ResidentName), " to the roster."))
                    .ElseIf(args.RequestType).Eq("save")
                    .Then(t => ShowStatus(t, "Saved ", args.Data.Get(x => x.ResidentName), "."))
                    .ElseIf(args.RequestType).Eq("cancel")
                    .Then(t => ShowStatus(t, "Discarded the changes to ", args.Data.Get(x => x.ResidentName), "."));
            }))

        <p id="roster-status" class="mt-4 text-sm font-medium"><span id="roster-status-action">The roster matches the wing</span><span id="roster-status-resident"></span><span id="roster-status-ending">.</span></p>
        <p id="transfer-warning" hidden class="mt-1 text-sm text-red-700">
            <span id="transfer-warning-resident"></span> moves to memory care through a transfer to Willow wing, not a roster edit.
        </p>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Correct from the handoff note</native-heading>
        <native-text color="Secondary">Enter a resident's risk and open tasks as the night nurse's handoff note gives them.</native-text>
        <form id="@CorrectionFormId" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
            @{ Html.InputField(plan, m => m.ResidentName, o => o.Required().Label("Resident"))
                .FusionTextBox(b => b
                    .Placeholder("Resident's full name")
                    .ShowClearButton(true)); }
            @{ Html.InputField(plan, m => m.RiskLevel, o => o.Required().Label("Risk level"))
                .FusionDropDownList(b => b
                    .DataSource(riskLevels)
                    .Placeholder("Select risk")); }
            @{ Html.InputField(plan, m => m.OpenTasks, o => o.Required().Label("Open tasks"))
                .FusionNumericTextBox(b => b
                    .Format("n0")
                    .Min(0)
                    .Max(12)
                    .Step(1)
                    .Placeholder("0 to 7")); }
        </form>

        <native-hstack gap="Sm" align="Center" class="mt-4 flex-wrap">
            @(Html.NativeButton("apply-correction", "Apply correction")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post(Url.SandboxRoute("EditingCorrection", "Grid"))
                        .Gather(g => g.Form(m => m.ResidentName, m => m.RiskLevel, m => m.OpenTasks))
                        .Validate<MapleRosterCorrectionValidator>(CorrectionFormId)
                        .Response(r => r
                            .OnSuccess<MapleRosterCorrected>((corrected, s) =>
                            {
                                var roster = s.Component<FusionGrid>(RosterId);
                                roster.UpdateRow(roster.GetRowIndexByPrimaryKey(corrected.Get(x => x.Resident.ResidentId)), corrected.Get(x => x.Resident));
                                s.Element("correction-status").Text.Set(corrected.Get(x => x.Summary));
                            })
                            .OnError(400, e => e.ValidationErrors(CorrectionFormId)));
                }))
            <p id="correction-status" class="text-sm text-text-muted">No corrections applied yet.</p>
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
