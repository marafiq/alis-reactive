@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ClinicalUpdatesViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Fusion.Templates
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Clinical Updates";

    const string BoardId = "clinical-updates-board";
    const string Button = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle";
    const string PrimaryButton = "rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90";

    var plan = Html.ReactivePlan<ClinicalUpdatesViewModel>();

    var columns = FusionGridColumns.Of<ClinicalUpdatesResident>();

    var residentCell = FusionTemplate.Create<ClinicalUpdatesResident>()
        .Div(d => d.Class("font-semibold").Span(m => m.ResidentName))
        .Div(d => d.Class("text-xs text-text-muted")
            .Span("Suite ")
            .Span(m => m.Suite)
            .Span(" · ")
            .Span(m => m.CareLevel))
        .Render();

    var riskBadge = FusionTemplate.Create<ClinicalUpdatesResident>()
        .When(m => m.RiskLevel == "High",
            then: t => t.Badge(m => m.RiskLevel, "rounded bg-red-100 px-2 py-0.5 text-xs font-bold text-red-700"),
            @else: e => e.Badge(m => m.RiskLevel, "rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700"))
        .Render();

    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("ClinicalUpdatesBoard", "Grid"))
            .Response(r => r.OnSuccess<List<ClinicalUpdatesResident>>((residents, s) =>
                s.Component<FusionGrid>(BoardId).DataSource.Set(residents)))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Clinical Updates</native-heading>
        <native-text color="Secondary">
            @Model.Wing wing, day shift. Apply the updates other departments sent this morning, and record what the
            clinical review team decided for the resident you pick on the board.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Updates from other departments</native-heading>
        <native-vstack gap="Sm" class="mt-3">
            <native-hstack gap="Base" align="Center" justify="Between" class="flex-wrap">
                <p class="text-sm"><span class="font-medium">Pharmacy, 9:12 AM.</span> Irene Morgan: two evening med-pass tasks added.</p>
                @(Html.NativeButton("apply-pharmacy-update", "Apply to the board")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Post(Url.SandboxRoute("ClinicalUpdatesPharmacy", "Grid"))
                            .Response(r => r.OnSuccess<ClinicalUpdatesTaskCount>((count, s) =>
                            {
                                var board = s.Component<FusionGrid>(BoardId);
                                board.SetCellValue(count.Get(x => x.ResidentId), Field.Of((ClinicalUpdatesResident x) => x.OpenTasks), count.Get(x => x.OpenTasks));
                                board.SelectRow(board.GetRowIndexByPrimaryKey(count.Get(x => x.ResidentId)));
                                s.Element("board-status").Text.Set(count.Get(x => x.Summary));
                            }))))
            </native-hstack>
            <native-hstack gap="Base" align="Center" justify="Between" class="flex-wrap">
                <p class="text-sm"><span class="font-medium">Therapy, 10:40 AM.</span> Grace Bennett: fall risk raised to High after this morning's assessment.</p>
                @(Html.NativeButton("apply-therapy-update", "Apply to the board")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Post(Url.SandboxRoute("ClinicalUpdatesTherapy", "Grid"))
                            .Response(r => r.OnSuccess<ClinicalUpdatesFallRisk>((risk, s) =>
                            {
                                var board = s.Component<FusionGrid>(BoardId);
                                board.SetCellValue(risk.Get(x => x.ResidentId), Field.Of((ClinicalUpdatesResident x) => x.RiskLevel), risk.Get(x => x.RiskLevel));
                                board.SelectRow(board.GetRowIndexByPrimaryKey(risk.Get(x => x.ResidentId)));
                                s.Element("board-status").Text.Set(risk.Get(x => x.Summary));
                            }))))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        @(Html.FusionGrid<ClinicalUpdatesViewModel, ClinicalUpdatesResident>(plan, BoardId, b => b
            .AllowSelection(true)
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.ResidentId), HeaderText = "ID", Width = "80", IsPrimaryKey = true, Visible = false },
                new GridColumn { Field = columns.Field(r => r.ResidentName), HeaderText = "Resident", Width = "220", Template = residentCell },
                new GridColumn { Field = columns.Field(r => r.RiskLevel), HeaderText = "Fall risk", Width = "120", Template = riskBadge },
                new GridColumn { Field = columns.Field(r => r.OpenTasks), HeaderText = "Open tasks", Width = "110", TextAlign = TextAlign.Right },
                new GridColumn { Field = columns.Field(r => r.PrimaryNurse), HeaderText = "Primary nurse", Width = "150" },
                new GridColumn { Field = columns.Field(r => r.NextReview), HeaderText = "Next review", Width = "130" }
            })))

        <p id="board-status" class="mt-4 text-sm font-medium">The board is as the night shift left it.</p>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Clinical review</native-heading>
        <native-text color="Secondary">Pick the resident the review team saw on the board, then record what they decided.</native-text>
        <native-hstack gap="Base" align="End" class="mt-3 flex-wrap">
            @{ Html.InputField(plan, m => m.ReviewRisk, o => o.Label("Fall risk"))
                .FusionDropDownList(b => b
                    .DataSource(Model.RiskLevels)
                    .Placeholder("Choose a fall risk")); }
            @{ Html.InputField(plan, m => m.ReviewOpenTasks, o => o.Label("Open tasks"))
                .FusionNumericTextBox(b => b
                    .Format("n0")
                    .Min(0)
                    .Max(12)
                    .Step(1)
                    .Placeholder("Tasks left")); }
            @(Html.NativeButton("record-review", "Record the review")
                .CssClass(PrimaryButton)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Post(Url.SandboxRoute("ClinicalUpdatesReview", "Grid"))
                        .Gather<ClinicalUpdatesReview>(g => g
                            .Form(m => m.ReviewRisk, m => m.ReviewOpenTasks)
                            .Set(x => x.Residents, p.Component<FusionGrid>(BoardId).GetSelectedRecords<ClinicalUpdatesResident>()))
                        .Response(r => r
                            .OnSuccess<ClinicalUpdatesReviewed>((reviewed, s) =>
                            {
                                s.Component<FusionGrid>(BoardId).SetRowData(reviewed.Get(x => x.Resident.ResidentId), reviewed.Get(x => x.Resident));
                                s.Element("board-status").Text.Set(reviewed.Get(x => x.Summary));
                            })
                            .OnError<ClinicalUpdatesRefusal>(400, (refused, e) =>
                                e.Element("board-status").Text.Set(refused.Get(x => x.Summary))))))
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
