@model IReadOnlyList<Alis.Reactive.SandboxApp.Areas.Sandbox.Models.ResidentCareItem>
@using Alis.Reactive.Native.Components

@* The high-risk watch list. Each resident's quick actions are action links with plans of their own, so the
   list works each time the page loads it again. *@
@if (Model.Count == 0)
{
    <p class="text-sm text-text-muted">No resident is at high risk.</p>
    return;
}
<ul class="flex flex-col gap-2">
    @foreach (var row in Model)
    {
        <li class="flex items-center justify-between rounded-md border border-border px-3 py-2 text-sm">
            <div>
                <span class="font-medium text-text">@row.ResidentName</span>
                <span class="text-text-secondary"> · @row.Wing wing · @row.CareLevel · @row.OpenTasks open tasks</span>
            </div>
            <native-hstack gap="Base">
                @(Html.NativeActionLink($"careops-flag-{row.ResidentId}", "Flag Critical", Url.SandboxRoute("CareOpsFlagOne", "Grid", new { id = row.ResidentId }), link => link
                    .Post()
                    .Response(r => r.OnSuccess(s => s.Dispatch(CareOpsEvents.CareopsRowsRefresh))))
                    .CssClass("font-medium text-amber-700 hover:text-amber-800"))
                @(Html.NativeActionLink($"careops-discharge-{row.ResidentId}", "Discharge", Url.SandboxRoute("CareOpsDischargeOne", "Grid", new { id = row.ResidentId }), link => link
                    .Confirm($"Discharge {row.ResidentName} from the active census?")
                    .Then(confirmed => confirmed
                        .Post()
                        .Response(r => r.OnSuccess(s => s.Dispatch(CareOpsEvents.CareopsRowsRefresh)))))
                    .CssClass("font-medium text-red-600 hover:text-red-700"))
            </native-hstack>
        </li>
    }
</ul>
