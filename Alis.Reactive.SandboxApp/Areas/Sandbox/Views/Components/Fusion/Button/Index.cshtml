@model ButtonModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionButton";

    const string actionButtonId = "begin-checkin";

    const string CareControl = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string RecordButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<ButtonModel>();

    // The check-in opens for the resident assigned to this care-team member: the action
    // is personalised to them, and the visit cannot begin until their identity is confirmed.
    Html.On(plan, t => t.DomReady(p =>
    {
        var action = p.Component<FusionButton>(actionButtonId);
        action.Content.Set("Begin check-in for " + Model.ResidentName);
        action.DataBind();
        action.Disabled.Set(true);
        action.DataBind();
        p.Element("action-ready").Text.Set(action.Content);
    }));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Daily Wellness Check-In</native-heading>
        <native-text color="Secondary">
            Open the wellness check-in for the resident assigned to you. Confirm their identity to
            unlock the visit, set its priority, then record what you completed.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Today's resident: @Model.ResidentName</native-heading>

            <div>
                @(Html.FusionButton(plan, actionButtonId, b => b
                    .Type("button")
                    .Content("Begin daily check-in")
                    .IconCss("e-icons e-circle-check")
                    .IconPosition(Syncfusion.EJ2.Buttons.IconPosition.Left)
                    .IsToggle(false)))
            </div>

            <native-vstack gap="Xs">
                <native-text>Action ready: <span id="action-ready" class="font-semibold text-text">Begin daily check-in</span></native-text>
                <native-text color="Secondary">Readiness: <span id="readiness">Confirm the resident's identity to begin.</span></native-text>
            </native-vstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("confirm-identity", "Confirm resident identity")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var actionButton = p.Component<FusionButton>(actionButtonId);
                        actionButton.Disabled.Set(false);
                        actionButton.DataBind();
                        p.Element("readiness").Text.Set("Identity confirmed — you can begin the check-in.");
                    }))
                @(Html.NativeButton("lock-visit", "Lock visit")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var actionButton = p.Component<FusionButton>(actionButtonId);
                        actionButton.Disabled.Set(true);
                        actionButton.DataBind();
                        p.Element("readiness").Text.Set("Visit locked — confirm the resident's identity to begin.");
                    }))
                @(Html.NativeButton("check-readiness", "Check readiness")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var action = p.Component<FusionButton>(actionButtonId);
                        p.When(action.Disabled).Eq(true)
                            .Then(locked => locked.Element("readiness")
                                .Text.Set("This visit is locked. Confirm the resident's identity to begin."))
                            .Else(ready => ready.Element("readiness")
                                .Text.Set("This visit is ready. You can begin the check-in now."));
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Set the visit's priority</native-heading>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("mark-complete", "Mark visit complete")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var actionButton = p.Component<FusionButton>(actionButtonId);
                        actionButton.IconCss.Set("e-icons e-check");
                        actionButton.IconPosition.Set(FusionButtonIconPosition.Right);
                        actionButton.DataBind();
                        p.Element("priority-state").Text.Set("Marked complete.");
                    }))
                @(Html.NativeButton("flag-urgent", "Flag as urgent")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var actionButton = p.Component<FusionButton>(actionButtonId);
                        actionButton.CssClass.Set("e-warning urgent-visit");
                        actionButton.DataBind();
                        p.Element("priority-state").Text.Set("Flagged urgent.");
                    }))
                @(Html.NativeButton("recommend-action", "Make this the recommended action")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var actionButton = p.Component<FusionButton>(actionButtonId);
                        actionButton.IsPrimary.Set(true);
                        actionButton.DataBind();
                        p.Element("priority-state").Text.Set("Set as recommended.");
                    }))
                @(Html.NativeButton("enable-followup", "Enable follow-up tracking")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var actionButton = p.Component<FusionButton>(actionButtonId);
                        actionButton.IsToggle.Set(true);
                        actionButton.DataBind();
                        p.Element("priority-state").Text.Set("Follow-up tracking enabled.");
                    }))
                @(Html.NativeButton("remind-me", "Remind me to begin")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionButton>(actionButtonId).Click();
                        p.Element("priority-state").Text.Set("Reminder placed on the action.");
                    }))
                @(Html.NativeButton("jump-to-action", "Jump to the action")
                    .CssClass(CareControl)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionButton>(actionButtonId).FocusIn();
                    }))
            </native-hstack>

            <native-text color="Secondary">Priority: <span id="priority-state">Not set.</span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.NativeButton("record-checkin", "Record this check-in")
                .CssClass(RecordButton)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var action = p.Component<FusionButton>(actionButtonId);
                    p.Post(Url.SandboxRoute("RecordCheckIn", "Button"))
                        .Gather<ButtonCheckInRequest>(g => g
                            .Set(x => x.Action, action.Content)
                            .Set(x => x.Locked, action.Disabled)
                            .Set(x => x.Priority, action.CssClass)
                            .Set(x => x.Recommended, action.IsPrimary)
                            .Set(x => x.FollowUp, action.IsToggle))
                        .Response(r => r.OnSuccess<ButtonCheckInResponse>((json, s) =>
                        {
                            s.Element("checkin-confirmation").Text.Set(json.Get(x => x.Confirmation));
                            s.Element("checkin-confirmation-panel").ClassList.Remove("hidden");
                        }));
                }))
            <div id="checkin-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="checkin-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
