@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.ContextMenu
@model FusionContextMenuModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "Maple Wing Room Board";

    const string HandoverMenuId = "handover-menu";
    const string Status = "board-status";
    const string Highlight = "ring-2";
    const string ActionsButton = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";

    // The Actions button opens a resident's menu at the top of the board, for a nurse on a keyboard or a tablet.
    const double ActionsMenuTop = 220;
    const double ActionsMenuLeft = 48;

    var plan = Html.ReactivePlan<FusionContextMenuModel>();
    var roomCheckUrl = Url.SandboxRoute("RoomCheck", "ContextMenu");
    var moveUrl = Url.SandboxRoute("MoveResident", "ContextMenu");

    // A menu that animates is closed again by EJ2 on the same click that opened it, so the menus open at once.
    ContextMenuAnimationSettings OpenAtOnce() => new() { Effect = MenuEffect.None, Duration = 0, Easing = "linear" };

    List<MenuItem> ActionsFor(BoardResident r) => new()
    {
        new()
        {
            Id = $"{r.Key}-move", Text = "Move to room", IconCss = "e-icons e-export",
            Items = new List<MenuItem>
            {
                new() { Id = $"{r.Key}-room-maple-216", Text = "Maple 216" },
                new() { Id = $"{r.Key}-room-maple-218", Text = "Maple 218" }
            }
        },
        new()
        {
            Id = $"{r.Key}-flags", Text = "Flag for night nurse", IconCss = "e-icons e-flags",
            Items = new List<MenuItem>
            {
                // The night nurse sees first the flags the list marks with the warning icon.
                new() { Id = $"{r.Key}-flag-fall-risk", Text = "Fall risk", IconCss = "e-icons e-warning" },
                new() { Id = $"{r.Key}-flag-wandering", Text = "Wandering", IconCss = "e-icons e-location" },
                new() { Id = $"{r.Key}-flag-skipped-dinner", Text = "Skipped dinner", IconCss = "e-icons e-clock" }
            }
        },
        new() { Separator = true },
        new() { Id = $"{r.Key}-care-plan-item", Text = "View care plan", IconCss = "e-icons e-description", Url = $"#{r.Key}-care-plan" }
    };

    var handoverItems = new List<MenuItem>
    {
        new() { Id = "handover-report-item", Text = "Open the handover report", IconCss = "e-icons e-description" }
    };

    // As the room list renders, the board asks whether each room it offers is still open tonight.
    void CheckOfferedRoom(PipelineBuilder<FusionContextMenuModel> p, FusionContextMenuBeforeItemRenderArgs args, BoardResident r) =>
        p.When(args.Item.Get(x => x.Id)).StartsWith($"{r.Key}-room-")
            .Then(room => room.Get(roomCheckUrl)
                .Gather<RoomCheckQuery>(g => g.Set(x => x.Room, args.Item.Get(x => x.Id)))
                .Response(answer => answer.OnSuccess<RoomCheck>((check, s) =>
                    s.When(check.Get(x => x.Held)).Truthy().Then(held =>
                    {
                        held.Element("rooms-note").Text.Set(check.Get(x => x.Note));
                        held.Element("rooms-note").Show();
                    }))));

    void GuardOpening(PipelineBuilder<FusionContextMenuModel> p, FusionContextMenuBeforeOpenArgs args, BoardResident r)
    {
        // During the handover the board is read-only: the handover menu opens where the resident's would have.
        p.When(p.Component<NativeCheckBox>(m => m.ShiftHandover).Checked).Truthy()
            .Then(handover =>
            {
                args.Cancel.Set(true);
                handover.Component<FusionContextMenu>(HandoverMenuId).Open(args.Top, args.Left);
                handover.Element("handover-held").Text.Set(handover.From(args.Items).Count(item => !item.Separator));
                handover.Element("handover-resident").Text.Set(r.Name);
                handover.Element("handover-note").Show();
            })
            .Else(open => open.Element("handover-note").Hide());

        // A resident flagged for a fall-risk check is not moved until the check is done.
        var fallRisk = $"{r.Key}-flag-fall-risk";
        p.When(args.ParentItem.Get(x => x.Id)).Eq($"{r.Key}-move")
            .And(p.Element($"{r.Key}-flag").ClassList.Items.Any(flag => flag == fallRisk)).Truthy()
            .Then(flagged =>
            {
                args.Cancel.Set(true);
                flagged.Element(Status).Text.Set($"Finish {r.Name}'s fall-risk check before moving them.");
            });
    }

    // The room list stays open while a move saves, so a refused room is swapped without starting over.
    void HoldWhileSaving(PipelineBuilder<FusionContextMenuModel> p, FusionContextMenuBeforeCloseArgs args, BoardResident r) =>
        p.When(args.ParentItem.Get(x => x.Id)).Eq($"{r.Key}-move")
            .And(p.Component<NativeHiddenField>(m => m.PendingMove).Value).NotEmpty()
            .Then(_ => args.Cancel.Set(true));

    void MoveTo(PipelineBuilder<FusionContextMenuModel> p, FusionContextMenuSelectArgs args, BoardResident r)
    {
        p.Component<NativeHiddenField>(m => m.PendingMove).Value.Set(args.Item.Get(x => x.Id));
        p.Post(moveUrl)
            .Gather<ResidentMoveRequest>(g => g
                .Set(x => x.Resident, r.Key)
                .Set(x => x.Room, args.Item.Get(x => x.Id)))
            .Response(answer => answer
                .OnSuccess<ResidentMoveResult>((moved, s) =>
                {
                    s.Component<NativeHiddenField>(m => m.PendingMove).Value.Set("");
                    s.Element($"{r.Key}-room").Text.Set(moved.Get(x => x.Room));
                    s.Element("open-rooms").Text.Set(moved.Get(x => x.OpenRooms));
                    s.Element(Status).Text.Set(moved.Get(x => x.Message));
                    s.Component<FusionContextMenu>($"{r.Key}-actions").Close();
                })
                .OnError<ResidentMoveResult>(409, (refused, e) =>
                {
                    e.Component<NativeHiddenField>(m => m.PendingMove).Value.Set("");
                    e.Element(Status).Text.Set(refused.Get(x => x.Message));
                }));
    }

    void Flag(PipelineBuilder<FusionContextMenuModel> p, FusionContextMenuSelectArgs args, BoardResident r)
    {
        var badge = p.Element($"{r.Key}-flag");
        badge.Text.Set(args.Item.Get(x => x.Text));
        badge.ClassList.Add(args.Item.Get(x => x.Id));
        badge.Show();
        p.When(args.Item.Get(x => x.IconCss)).Contains("e-warning")
            .Then(urgent => urgent.Element(Status).Text.Set($"{r.Name} is first on the night nurse's rounds."))
            .Else(routine => routine.Element(Status).Text.Set($"{r.Name}'s flag is on the night nurse's list."));
    }

    void Act(PipelineBuilder<FusionContextMenuModel> p, FusionContextMenuSelectArgs args, BoardResident r)
    {
        var chosen = args.Item.Get(x => x.Id);
        p.When(chosen).StartsWith($"{r.Key}-room-").Then(move => MoveTo(move, args, r))
            .ElseIf(chosen).StartsWith($"{r.Key}-flag-").Then(flag => Flag(flag, args, r));
        p.When(args.Item.Get(x => x.Url)).Eq($"#{r.Key}-care-plan")
            .Then(carePlan => carePlan.Element($"{r.Key}-care-plan").Show());
    }
}

<native-vstack gap="Lg">
    <native-heading level="H1">Maple Wing Room Board</native-heading>
    <native-text color="Secondary">
        Evening shift, charge nurse Dana Ortiz. Right-click a resident, or use their Actions button, to move them to an
        open room, flag them for the night nurse or read their care plan.
    </native-text>

    <native-card><native-card-body>
        <native-vstack gap="Sm">
            @{ Html.InputField(plan, m => m.ShiftHandover, o => o.Label("Shift handover in progress"))
                .NativeCheckBox(b => b.CssClass("rounded border-border")); }
            @Html.HiddenFieldFor(plan, m => m.PendingMove)
            <p id="board-status" role="status" class="text-sm font-medium">No changes on the board yet.</p>
            <p id="handover-note" hidden class="text-sm text-amber-700">
                <span id="handover-held"></span> actions for <span id="handover-resident"></span> wait until the handover ends.
            </p>
        </native-vstack>
    </native-card-body></native-card>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        @foreach (var resident in Model.Residents)
        {
            <div id="@($"{resident.Key}-card")" class="rounded-lg border border-border bg-white p-4 ring-accent">
                <p class="font-medium">@resident.Name</p>
                <p class="text-sm text-text-secondary">
                    <span id="@($"{resident.Key}-room")">@resident.Room</span> · @resident.CareLevel
                </p>
                <span id="@($"{resident.Key}-flag")" hidden
                      class="mt-2 inline-block rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800"></span>
                <div class="mt-3">
                    @(Html.NativeButton($"{resident.Key}-actions-btn", "Actions")
                        .CssClass(ActionsButton)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                            p.Component<FusionContextMenu>($"{resident.Key}-actions").Open(ActionsMenuTop, ActionsMenuLeft)))
                </div>
            </div>
        }
    </div>

    <native-card><native-card-body>
        <h2 class="text-base font-semibold">Open rooms tonight</h2>
        <p id="open-rooms" class="text-sm">@Model.OpenRooms</p>
        <p id="rooms-note" hidden class="text-sm text-amber-700"></p>
    </native-card-body></native-card>

    @foreach (var resident in Model.Residents)
    {
        <section id="@($"{resident.Key}-care-plan")" hidden class="rounded-lg border border-border bg-white p-4">
            <h2 class="text-base font-semibold">@resident.Name's care plan</h2>
            <p class="text-sm">@resident.CarePlan</p>
        </section>
    }

    <section id="handover-report" hidden class="rounded-lg border border-border bg-white p-4">
        <h2 class="text-base font-semibold">Handover report</h2>
        <ul class="list-disc pl-5 text-sm">
            <li>Margaret Hale: shower moved to the morning; two-person assist.</li>
            <li>Arthur Bell: evening insulin given at 8:10 PM.</li>
            <li>Rosa Diaz: restless after dinner; settled with music.</li>
        </ul>
    </section>
</native-vstack>

@foreach (var resident in Model.Residents)
{
    var card = $"{resident.Key}-card";
    @(Html.FusionContextMenu(plan, $"{resident.Key}-actions", b =>
    {
        b.Target("#" + card);
        b.Items(ActionsFor(resident));
        b.EnableScrolling(false);
        b.AnimationSettings(OpenAtOnce());
    })
    .Reactive(evt => evt.BeforeItemRender, (args, p) => CheckOfferedRoom(p, args, resident))
    .Reactive(evt => evt.BeforeOpen, (args, p) => GuardOpening(p, args, resident))
    .Reactive(evt => evt.OnOpen, (args, p) =>
        p.When(args.ParentItem).IsNull().Then(opened => opened.Element(card).ClassList.Add(Highlight)))
    .Reactive(evt => evt.BeforeClose, (args, p) => HoldWhileSaving(p, args, resident))
    .Reactive(evt => evt.OnClose, (args, p) =>
        p.When(args.ParentItem).IsNull().Then(closed => closed.Element(card).ClassList.Remove(Highlight)))
    .Reactive(evt => evt.Select, (args, p) => Act(p, args, resident)))
}

@(Html.FusionContextMenu(plan, HandoverMenuId, b =>
{
    b.Items(handoverItems);
    b.EnableScrolling(false);
    b.AnimationSettings(OpenAtOnce());
})
.Reactive(evt => evt.Select, (_, p) => p.Element("handover-report").Show()))

@Html.RenderPlan(plan)
