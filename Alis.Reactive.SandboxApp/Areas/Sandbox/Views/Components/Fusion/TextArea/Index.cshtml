@model TextAreaModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionTextArea";

    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string SubmitReady = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var lastShiftNote = Model.CareNote;

    var plan = Html.ReactivePlan<TextAreaModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Resident Daily Care Log</native-heading>
        <native-text color="Secondary">
            We carried over last shift's note. Update it for this shift, then save it to the resident's daily log.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.CareNote, o => o.Label("Care note for this shift"))
                .FusionTextArea(b => b
                    .Placeholder("Describe how the resident's shift went")
                    .Rows(4)
                    .ShowClearButton(true)
                    .Reactive(plan, evt => evt.Input, (args, p) =>
                    {
                        p.Element("note-draft").SetText(args, x => x.Value);
                        p.Element("note-draft-previous").SetText(args, x => x.PreviousValue);
                    })
                    .Reactive(plan, evt => evt.Changed, (args, p) =>
                    {
                        p.Element("note-committed").SetText(args, x => x.Value);
                        p.Element("note-replaced").SetText(args, x => x.PreviousValue);

                        p.When(args, x => x.IsInteracted).Truthy()
                            .Then(edited => edited.Element("note-commit-status")
                                .SetText("Edited by you this shift — ready to save."))
                            .Else(carried => carried.Element("note-commit-status")
                                .SetText("Filled from last shift's note, not edited by hand."));
                    })
                    .Reactive(plan, evt => evt.Focus, (args, p) =>
                    {
                        p.Element("note-presence").SetText("You are editing this note now.");
                        p.Element("note-focus-snapshot").SetText(args, x => x.Value);
                    })
                    .Reactive(plan, evt => evt.Blur, (args, p) =>
                    {
                        p.Element("note-presence").SetText("Autosave pending — your changes are held.");
                        p.Element("note-blur-snapshot").SetText(args, x => x.Value);
                    })); }

            <native-vstack gap="Xs">
                <native-text color="Secondary">Status: <span id="note-presence" class="font-medium text-text">Open the note to start editing.</span></native-text>
                <native-text color="Secondary">Committed note: <span id="note-committed" class="font-medium text-text">@Model.CareNote</span></native-text>
                <native-text color="Secondary"><span id="note-commit-status">Carried over from last shift.</span></native-text>
                <native-text color="Secondary">Note in the field now: <span id="note-restored" class="text-text-muted">@Model.CareNote</span></native-text>
            </native-vstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("resume-editing", "Resume editing the note")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionTextArea>(m => m.CareNote).FocusIn();
                    }))
                @(Html.NativeButton("close-note", "Done documenting — close the note")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionTextArea>(m => m.CareNote).FocusOut();
                    }))
                @(Html.NativeButton("restore-note", "Use last shift's note")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var note = p.Component<FusionTextArea>(m => m.CareNote);
                        note.SetValue(lastShiftNote);
                        p.Element("note-restored").SetText(note.Value());
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Undo context</native-heading>
            <native-text color="Secondary">Live preview as you type: <span id="note-draft" class="font-medium text-text">@Model.CareNote</span></native-text>
            <native-text color="Secondary">Before this keystroke: <span id="note-draft-previous" class="text-text-muted">@Model.CareNote</span></native-text>
            <native-text color="Secondary">This save will replace: <span id="note-replaced" class="text-text-muted">@Model.CareNote</span></native-text>
            <native-text color="Secondary">Snapshot when you opened the note: <span id="note-focus-snapshot" class="text-text-muted">—</span></native-text>
            <native-text color="Secondary">Snapshot when you left the note: <span id="note-blur-snapshot" class="text-text-muted">—</span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-text color="Secondary">When the note is complete, save it to the resident's daily log.</native-text>
            @(Html.NativeButton("save-note", "Save note to daily log")
                .CssClass(SubmitReady)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var note = p.Component<FusionTextArea>(m => m.CareNote);
                    p.When(note.Value()).IsEmpty()
                        .Then(empty => empty.Element("note-save-guard")
                            .SetText("Please write a care note before saving."))
                        .Else(ready =>
                            ready.Post(Url.SandboxRoute("Echo", "TextArea"))
                                .Gather(g => g.Include(note.Value(), "careNote"))
                                .Response(r => r.OnSuccess<CareNoteEchoResponse>((json, s) =>
                                {
                                    s.Element("note-save-guard").SetText("");
                                    s.Element("note-confirmation").SetText(json, x => x.Summary);
                                    s.Element("note-confirmation-panel").RemoveClass("hidden");
                                })));
                }))
            <native-text color="Secondary"><span id="note-save-guard" class="text-amber-700"></span></native-text>
            <div id="note-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="note-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
