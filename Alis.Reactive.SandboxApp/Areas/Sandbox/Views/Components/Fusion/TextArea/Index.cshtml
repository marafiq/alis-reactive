@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.TextArea
@model DailyCareLogModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Daily Care Log";

    const string Button = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string PrimaryButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var nightShiftNote = Model.NightShiftNote;
    var plan = Html.ReactivePlan<DailyCareLogModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Daily Care Log</native-heading>
        <native-text color="Secondary">Margaret Hale · Maple 214 · Day shift</native-text>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">The night shift wrote</native-heading>
        <p id="night-shift-note" class="mt-2 text-sm">@nightShiftNote</p>
    </native-card-body></native-card>

    <native-card><native-card-body id="care-log">
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.CareNote, o => o.Label("Day shift note"))
                .FusionTextArea(b => b
                    .Placeholder("How did Margaret's day go?")
                    .Rows(5))
                .Reactive(evt => evt.Input, (args, p) =>
                {
                    p.When(args.Value).Contains("fell")
                        .Then(fell => fell.Element("incident-reminder").Show())
                        .Else(none => none.Element("incident-reminder").Hide());
                    p.When(args.Value).IsEmpty().And(args.PreviousValue).NotEmpty()
                        .Then(cleared => cleared.Element("care-log-status").Text.Set("You cleared the note."));
                })
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    // A note that changes is no longer the note that was signed.
                    p.Component<NativeCheckBox>(m => m.Signed).Checked.Set(false);
                    p.Element("signed-note-locked").Hide();
                    p.When(args.IsInteracted).Falsy()
                        .Then(started => started.Element("care-log-status").Text.Set("This is the night shift's note. Update it for the day shift."))
                        .ElseIf(args.Value).IsEmpty()
                        .Then(erased => erased.Element("care-log-status").Text.Set("Nothing written for the day shift yet."))
                        .ElseIf(args.PreviousValue).Eq(nightShiftNote)
                        .Then(updated => updated.Element("care-log-status").Text.Set("Updated the night shift's note for the day shift. Sign it when it is complete."))
                        .Else(edited => edited.Element("care-log-status").Text.Set("Edited for the day shift. Sign it when it is complete."));
                })
                .Reactive(evt => evt.Focus, (args, p) =>
                {
                    // A signed note is locked: the cursor does not stay in it.
                    p.When(p.Component<NativeCheckBox>(m => m.Signed).Checked).Truthy()
                        .Then(signed =>
                        {
                            signed.Component<FusionTextArea>(m => m.CareNote).FocusOut();
                            signed.Element("signed-note-locked").Show();
                        })
                        .ElseIf(args.Value).IsEmpty()
                        .Then(empty => empty.Element("writing-tips").Show());
                })
                .Reactive(evt => evt.Blur, (args, p) =>
                {
                    p.Element("writing-tips").Hide();
                    p.Post(Url.SandboxRoute("KeepDraft", "TextArea"))
                        .Gather<CareLogDraft>(g => g.Set(x => x.Note, args.Value))
                        .Response(r => r.OnSuccess<CareLogAnswer>((kept, s) =>
                            s.Element("draft-status").Text.Set(kept.Get(x => x.Message))));
                }); }

            <p id="writing-tips" hidden class="text-sm text-text-secondary">Note her meals, mood and mobility, and anything the evening shift should watch for.</p>
            <p id="incident-reminder" hidden class="text-sm text-amber-700">Margaret fell? File an incident report before the end of the shift.</p>
            <p id="signed-note-locked" hidden class="text-sm text-amber-700">This note is signed. Clear "I sign this note" to change it.</p>
            <p id="draft-status" class="text-xs text-text-muted">No draft kept yet.</p>

            @{ Html.InputField(plan, m => m.Signed, o => o.Label("I sign this note as complete"))
                .NativeCheckBox(b => b.CssClass("rounded border-border"))
                .Reactive(evt => evt.Change, (_, p) => p.Element("signed-note-locked").Hide()); }

            <p id="care-log-status" class="text-sm font-medium">Nothing written for the day shift yet.</p>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("start-from-night-note-btn", "Start from the night shift's note")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        // The night shift's note goes in at once, so the note is unsigned before the cursor enters it.
                        var note = p.Component<FusionTextArea>(m => m.CareNote);
                        note.Value.Set(nightShiftNote);
                        note.DataBind();
                        note.FocusIn();
                    }))
                @(Html.NativeButton("save-care-log-btn", "Save to the daily log")
                    .CssClass(PrimaryButton)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        var note = p.Component<FusionTextArea>(m => m.CareNote);
                        var signed = p.Component<NativeCheckBox>(m => m.Signed);
                        p.Post(Url.SandboxRoute("Save", "TextArea"))
                            .Gather<CareLogEntry>(g => g
                                .Set(x => x.CareNote, note.Value)
                                .Set(x => x.Signed, signed.Checked))
                            .Validate<DailyCareLogValidator>("care-log")
                            .Response(r => r
                                .OnSuccess<CareLogAnswer>((saved, s) =>
                                    s.Element("care-log-status").Text.Set(saved.Get(x => x.Message)))
                                .OnError(400, e => e.ValidationErrors("care-log")));
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
