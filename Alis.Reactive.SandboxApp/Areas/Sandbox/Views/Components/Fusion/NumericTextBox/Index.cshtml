@model NumericTextBoxModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "NumericTextBox";

    const string ButtonStepper = "rounded-md border border-border bg-white px-3 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string ButtonSubmit = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<NumericTextBoxModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Monthly Service Plan</native-heading>
        <native-text color="Secondary">
            Set how many catered meals and wellness check-ins this resident receives each week. We carried over last month's plan — adjust it, then save.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Catered meals per week</native-heading>

            @{ Html.InputField(plan, m => m.MealsPerWeek, o => o.Label("Catered meals per week"))
                .FusionNumericTextBox(b => b
                    .Min(4).Max(21).Step(1).Value(Model.MealsPerWeek).ShowSpinButton(false)
                    .Reactive(plan, evt => evt.Changed, (args, p) =>
                    {
                        p.Element("meals-summary").SetText(args, x => x.Value);
                        p.Element("meals-previous").SetText(args, x => x.PreviousValue);

                        p.When(args, x => x.IsInteracted).Truthy()
                            .Then(chosen => chosen.Element("meals-source")
                                .SetText("You entered this number of meals."))
                            .Else(applied => applied.Element("meals-source")
                                .SetText("This number of meals was applied from a plan template."));
                    })); }

            <native-vstack gap="Xs">
                <native-text>
                    This resident receives <span id="meals-summary" class="font-semibold text-text">@Model.MealsPerWeek</span> catered meals each week.
                </native-text>
                <native-text color="Secondary">Previous meals before this change: <span id="meals-previous">@Model.MealsPerWeek</span> per week</native-text>
                <native-text color="Secondary"><span id="meals-source">This is the meal plan carried over from last month.</span></native-text>
            </native-vstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("meals-add", "Add a meal")
                    .CssClass(ButtonStepper)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionNumericTextBox>(m => m.MealsPerWeek).Increment();
                    }))
                @(Html.NativeButton("meals-remove", "Remove a meal")
                    .CssClass(ButtonStepper)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionNumericTextBox>(m => m.MealsPerWeek).Decrement();
                    }))
                @(Html.NativeButton("meals-standard-plan", "Apply the standard plan (14 meals)")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionNumericTextBox>(m => m.MealsPerWeek).SetValue(14);
                    }))
                @(Html.NativeButton("meals-reduced-diet", "Allow a reduced-diet plan (fewer meals)")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionNumericTextBox>(m => m.MealsPerWeek).SetMin(2);
                        p.Element("meals-floor-note").SetText("A reduced-diet plan is now allowed — you can enter as few as 2 meals.");
                    }))
            </native-hstack>
            <native-text color="Secondary"><span id="meals-floor-note">Plans include at least 4 meals per week.</span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Wellness check-ins per week</native-heading>

            @{ Html.InputField(plan, m => m.WellnessChecksPerWeek, o => o.Label("Wellness check-ins per week"))
                .FusionNumericTextBox(b => b
                    .Min(0).Max(14).Step(1).Value(Model.WellnessChecksPerWeek).ShowSpinButton(false)
                    .Reactive(plan, evt => evt.Focus, (args, p) =>
                    {
                        p.Element("wellness-hint").SetText("A nurse visits for each wellness check-in. Most residents have 2 to 5 per week.");
                    })
                    .Reactive(plan, evt => evt.Blur, (args, p) =>
                    {
                        p.Element("wellness-hint").SetText("Wellness check-ins saved with the plan below.");
                    })); }

            <native-text color="Secondary"><span id="wellness-hint">Select the field to see guidance on wellness check-ins.</span></native-text>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("wellness-start", "Start entering wellness check-ins")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionNumericTextBox>(m => m.WellnessChecksPerWeek).FocusIn();
                    }))
                @(Html.NativeButton("wellness-done", "Done with wellness check-ins")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionNumericTextBox>(m => m.WellnessChecksPerWeek).FocusOut();
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.NativeButton("plan-save", "Save this service plan")
                .CssClass(ButtonSubmit)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var meals = p.Component<FusionNumericTextBox>(m => m.MealsPerWeek);
                    p.Post(Url.SandboxRoute("Save", "NumericTextBox"))
                        .Gather(g => g.Include(meals.Value(), "mealsPerWeek"))
                        .Response(r => r.OnSuccess<ServicePlanResponse>((json, s) =>
                        {
                            s.Element("plan-confirmation").SetText(json, x => x.Summary);
                            s.Element("plan-confirmation-panel").RemoveClass("hidden");
                        }));
                }))
            <div id="plan-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="plan-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
