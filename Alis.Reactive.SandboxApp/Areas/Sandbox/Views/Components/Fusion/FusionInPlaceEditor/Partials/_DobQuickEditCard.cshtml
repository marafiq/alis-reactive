@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.InPlaceEditor
@model DateOfBirthCorrection
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using SfInPlace = Syncfusion.EJ2.InPlaceEditor
@{
    var plan = Html.ReactivePlan<DateOfBirthCorrection>();
}

<div id="card-dob" class="border-t border-border pt-3">
    @Html.HiddenFieldFor(plan, m => m.ResidentId)

    @{ Html.InputField(plan, m => m.Value, o => o.Label("Date of birth"))
        .FusionInPlaceEditor(b => b
            .Type(SfInPlace.InputType.Date)
            .Mode(SfInPlace.RenderMode.Inline)
            .EditableOn(SfInPlace.EditableType.Click))
        .Reactive(evt => evt.BeginEdit, (_, p) =>
            p.Component<FusionInPlaceEditor>(m => m.Value).Element.ClassList.Remove("alis-editor-saved"))
        .Reactive(evt => evt.EndEdit, (args, p) =>
            p.When(args.Action).Eq("cancel")
                .Then(kept => kept.Element("card-dob-status").Text.Set("Kept the date of birth on file.")))
        .Reactive(evt => evt.ActionSuccess, (_, p) =>
        {
            p.Post(Url.SandboxRoute("UpdateDateOfBirth", "FusionInPlaceEditor"))
             .Gather(g => g.Form(m => m.Value, m => m.ResidentId))
             .Validate<DateOfBirthCorrectionValidator>("card-dob")
             .Response(r => r
                .OnSuccess<CorrectionSaved>((saved, s) =>
                {
                    s.Element("card-dob-status").Text.Set(saved.Get(x => x.Message));
                    s.Component<FusionInPlaceEditor>(m => m.Value).Element.ClassList.Add("alis-editor-saved");
                })
                .OnError(400, e => e.ValidationErrors("card-dob")));
        }); }

    <p id="card-dob-status" class="text-sm text-text-secondary"></p>
</div>

@Html.RenderPlan(plan)
