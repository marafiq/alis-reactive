@using System.Globalization
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.InPlaceEditor
@model CareLevelCorrection
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using SfInPlace = Syncfusion.EJ2.InPlaceEditor
@{
    var plan = Html.ReactivePlan<CareLevelCorrection>();
    var english = CultureInfo.GetCultureInfo("en-US");
}

<div id="card-care-level" class="border-t border-border pt-3">
    @Html.HiddenFieldFor(plan, m => m.ResidentId)

    @{ Html.InputField(plan, m => m.Value, o => o.Label("Care level"))
        .FusionInPlaceEditor(b => b
            .Type(SfInPlace.InputType.DropDownList)
            .Mode(SfInPlace.RenderMode.Inline)
            .EditableOn(SfInPlace.EditableType.Click)
            .Model(new
            {
                dataSource = CareLevelChoice.All.Select(choice => choice.Name),
                placeholder = "Choose a care level"
            }))
        .Reactive(evt => evt.Change, (args, p) =>
        {
            // Before it is saved, the coordinator sees what the new level costs.
            p.Element("care-level-from").Text.Set(args.PreviousValue);
            p.Element("care-level-to").Text.Set(args.Value);
            foreach (var choice in CareLevelChoice.All)
            {
                p.When(args.Value).Eq(choice.Name)
                    .Then(chosen => chosen.Element("care-level-rate").Text.Set(choice.MonthlyRate.ToString("C0", english)));
            }
            p.Element("care-level-preview").Show();
        })
        .Reactive(evt => evt.CancelClick, (_, p) =>
        {
            p.Element("care-level-preview").Hide();
            p.Element("card-care-level-status").Text.Set("Care level unchanged.");
        })
        .Reactive(evt => evt.ActionSuccess, (_, p) =>
        {
            p.Post(Url.SandboxRoute("UpdateCareLevel", "FusionInPlaceEditor"))
             .Gather(g => g.Form(m => m.Value, m => m.ResidentId))
             .Validate<CareLevelCorrectionValidator>("card-care-level")
             .Response(r => r
                .OnSuccess<CorrectionSaved>((saved, s) =>
                {
                    s.Element("care-level-preview").Hide();
                    s.Element("card-care-level-status").Text.Set(saved.Get(x => x.Message));
                })
                .OnError(400, e => e.ValidationErrors("card-care-level")));
        }); }

    <p id="care-level-preview" class="text-sm" hidden>
        From <span id="care-level-from"></span> to <span id="care-level-to"></span>: <span id="care-level-rate"></span> a month.
    </p>
    <p id="card-care-level-status" class="text-sm text-text-secondary"></p>
</div>

@Html.RenderPlan(plan)
