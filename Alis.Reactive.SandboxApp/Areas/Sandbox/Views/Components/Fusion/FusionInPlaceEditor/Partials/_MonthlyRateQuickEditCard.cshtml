@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.InPlaceEditor
@model MonthlyRateCorrection
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using SfInPlace = Syncfusion.EJ2.InPlaceEditor
@{
    var plan = Html.ReactivePlan<MonthlyRateCorrection>();
}

<div id="card-monthly-rate" class="border-t border-border pt-3">
    @Html.HiddenFieldFor(plan, m => m.ResidentId)

    @{ Html.InputField(plan, m => m.Value, o => o.Label("Monthly rate"))
        .FusionInPlaceEditor(b => b
            .Type(SfInPlace.InputType.Numeric)
            .Mode(SfInPlace.RenderMode.Inline)
            .EditableOn(SfInPlace.EditableType.Click)
            .Model(new { format = "C0", min = 0, max = 25000, step = 50 }))
        .Reactive(evt => evt.ActionBegin, (args, p) =>
        {
            // Billing confirms a rate before the editor closes: the page sends the editor's own commit data
            // and closes the editor with the rate billing keeps.
            args.Cancel.Set(true);
            p.Post(Url.SandboxRoute("UpdateMonthlyRate", "FusionInPlaceEditor"))
             .Gather<MonthlyRateChange>(g => g.Form(m => m.ResidentId).Set(x => x.Change, args.Data))
             .Validate<MonthlyRateCorrectionValidator>("card-monthly-rate")
             .Response(r => r
                .OnSuccess<MonthlyRateSaved>((saved, s) =>
                {
                    s.Component<FusionInPlaceEditor>(m => m.Value).Value.Set(saved.Get(x => x.Rate));
                    s.Element("card-monthly-rate-status").Text.Set(saved.Get(x => x.Message));
                })
                .OnError(400, e =>
                {
                    // The editor is still open: the cursor goes back into it, then billing's reason shows under it.
                    e.Component<FusionInPlaceEditor>(m => m.Value).SetFocus();
                    e.ValidationErrors("card-monthly-rate");
                })
                .OnError<CorrectionRefused>((refused, e) =>
                    e.Element("card-monthly-rate-status").Text.Set(refused.Get(x => x.Message))));
        }); }

    @{ Html.InputField(plan, m => m.CustomRate, o => o.Label("Custom rate"))
        .NativeCheckBox(b => b.CssClass("rounded border-border"))
        .Reactive(evt => evt.Change, (args, p) =>
            p.When(args.Checked).Truthy()
                .Then(custom => custom.Component<FusionInPlaceEditor>(m => m.Value).Disable(false))
                .Else(byLevel => byLevel.Component<FusionInPlaceEditor>(m => m.Value).Disable(true))); }

    <p class="text-xs text-text-secondary">The monthly rate follows the care level unless a custom rate is set.</p>
    <p id="card-monthly-rate-status" class="text-sm text-text-secondary"></p>
</div>

@{
    // The rate follows the care level until the coordinator sets a custom rate.
    Html.On(plan, t => t.DomReady(p => p.Component<FusionInPlaceEditor>(m => m.Value).Disable(true)));
}

@Html.RenderPlan(plan)
