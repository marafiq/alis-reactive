@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.InPlaceEditor
@model MedicalRecordNumberCorrection
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using SfInPlace = Syncfusion.EJ2.InPlaceEditor
@{
    var plan = Html.ReactivePlan<MedicalRecordNumberCorrection>();
}

<div id="card-mrn" class="border-t border-border pt-3">
    @Html.HiddenFieldFor(plan, m => m.ResidentId)

    @{ Html.InputField(plan, m => m.Value, o => o.Label("Medical record number"))
        .FusionInPlaceEditor(b => b
            .Type(SfInPlace.InputType.Mask)
            .Mode(SfInPlace.RenderMode.Inline)
            .EditableOn(SfInPlace.EditableType.Click)
            .Model(new { mask = "LLL-0000", placeholder = "ABC-0000" }))
        .Reactive(evt => evt.ActionSuccess, (args, p) =>
        {
            // The editor reports the number it committed without the mask's dash.
            p.Post(Url.SandboxRoute("UpdateMedicalRecordNumber", "FusionInPlaceEditor"))
             .Gather<MedicalRecordNumberCorrection>(g => g.Form(m => m.ResidentId).Set(x => x.Value, args.Value))
             .Validate<MedicalRecordNumberCorrectionValidator>("card-mrn")
             .Response(r => r
                .OnSuccess<CorrectionSaved>((saved, s) =>
                    s.Element("card-mrn-status").Text.Set(saved.Get(x => x.Message)))
                .OnError(400, e => e.ValidationErrors("card-mrn"))
                .OnError<CorrectionRefused>((refused, e) =>
                    e.Element("card-mrn-status").Text.Set(refused.Get(x => x.Message))));
        }); }

    <p id="card-mrn-status" class="text-sm text-text-secondary"></p>
</div>

@Html.RenderPlan(plan)
