@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.InPlaceEditor
@model LastHospitalStayCorrection
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using SfInPlace = Syncfusion.EJ2.InPlaceEditor
@{
    var plan = Html.ReactivePlan<LastHospitalStayCorrection>();
}

<div id="card-last-hospital-stay" class="border-t border-border pt-3">
    @Html.HiddenFieldFor(plan, m => m.ResidentId)

    @{ Html.InputField(plan, m => m.Value, o => o.Label("Last hospital stay began"))
        .FusionInPlaceEditor(b => b
            .Type(SfInPlace.InputType.DateTime)
            .Mode(SfInPlace.RenderMode.Inline)
            .EditableOn(SfInPlace.EditableType.Click))
        .Reactive(evt => evt.ActionSuccess, (_, p) =>
        {
            p.Post(Url.SandboxRoute("UpdateLastHospitalStay", "FusionInPlaceEditor"))
             .Gather(g => g.Form(m => m.Value, m => m.ResidentId))
             .Validate<LastHospitalStayCorrectionValidator>("card-last-hospital-stay")
             .Response(r => r
                .OnSuccess<CorrectionSaved>((saved, s) =>
                    s.Element("card-last-hospital-stay-status").Text.Set(saved.Get(x => x.Message)))
                .OnError(400, e => e.ValidationErrors("card-last-hospital-stay")));
        }); }

    <p id="card-last-hospital-stay-status" class="text-sm text-text-secondary"></p>
</div>

@Html.RenderPlan(plan)
