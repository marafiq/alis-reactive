@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.InPlaceEditor
@model ResidentProfileModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using SfInPlace = Syncfusion.EJ2.InPlaceEditor
@{
    ViewData["Title"] = "Resident Profile";

    const string Button = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string PrimaryButton = "rounded-md bg-accent px-6 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string Partials = "~/Areas/Sandbox/Views/Components/Fusion/FusionInPlaceEditor/Partials/";

    var plan = Html.ReactivePlan<ResidentProfileModel>();
    var residentId = (string)ViewBag.ResidentId;
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Eleanor Vance</native-heading>
        <native-text color="Secondary">Resident profile · Maple 214</native-text>
    </div>

    <section id="resident-profile" class="rounded-lg border border-border bg-white p-6 shadow-sm">
        <native-heading level="H2">Profile</native-heading>

        <native-grid cols="C3" gap="Base" class="mt-4">
            @{ Html.InputField(plan, m => m.Name, o => o.Label("Resident name"))
                .NativeTextBox(b => b.Placeholder("e.g. Eleanor Vance")); }

            @{ Html.InputField(plan, m => m.AdmissionDate, o => o.Label("Admission date"))
                .FusionDatePicker(b => b.Format("yyyy-MM-dd")); }

            @{ Html.InputField(plan, m => m.PreferredName, o => o.Label("Preferred name"))
                .FusionInPlaceEditor(b => b
                    .Type(SfInPlace.InputType.Text)
                    .Mode(SfInPlace.RenderMode.Inline)
                    .EditableOn(SfInPlace.EditableType.Click)
                    // An open edit stays open while the coordinator fills the rest of the profile.
                    .ActionOnBlur(SfInPlace.ActionBlur.Ignore))
                .Reactive(evt => evt.BeginEdit, (args, p) =>
                {
                    // A profile under care review keeps its preferred name: the edit does not open.
                    p.When(p.Component<NativeCheckBox>(m => m.ProfileLocked).Checked).Truthy()
                        .Then(locked =>
                        {
                            args.Cancel.Set(true);
                            locked.Element("profile-locked-note").Show();
                        })
                        .Else(open => open.Element("profile-locked-note").Hide());
                })
                .Reactive(evt => evt.SubmitClick, (_, p) => p.Element("save-profile-reminder").Show()); }
        </native-grid>

        <native-vstack gap="Sm" class="mt-4">
            @{ Html.InputField(plan, m => m.ProfileLocked, o => o.Label("Lock this profile for care review"))
                .NativeCheckBox(b => b.CssClass("rounded border-border")); }
            <p id="profile-locked-note" class="text-sm text-warning" hidden>This profile is locked for care review; unlock it to change her preferred name.</p>
            <p id="save-profile-reminder" class="text-sm text-text-secondary" hidden>Save the profile to keep her new preferred name.</p>
        </native-vstack>

        <native-hstack gap="Sm" justify="Start" class="mt-4">
            @(Html.NativeButton("clear-preferred-name", "Clear preferred name")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Component<FusionInPlaceEditor>(m => m.PreferredName).Value.Set(null)))
            @(Html.NativeButton("save-profile", "Save profile")
                .CssClass(PrimaryButton)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    // An open preferred-name edit is part of the profile being saved.
                    p.Component<FusionInPlaceEditor>(m => m.PreferredName).Save();
                    p.Post(Url.SandboxRoute("UpdateProfile", "FusionInPlaceEditor"))
                        .Gather(g => g.Form())
                        .Validate<ResidentProfileModelValidator>("resident-profile")
                        .Response(r => r
                            .OnSuccess<ProfileSaved>((saved, s) =>
                            {
                                s.Element("profile-status").Text.Set(saved.Get(x => x.Message));
                                s.Element("save-profile-reminder").Hide();
                            })
                            .OnError(400, e => e.ValidationErrors("resident-profile")));
                }))
        </native-hstack>

        <p id="profile-status" class="mt-3 text-sm">No changes saved yet.</p>
    </section>

    <section class="rounded-lg border border-border bg-white p-6 shadow-sm">
        <native-heading level="H2">Face sheet</native-heading>
        <native-text color="Secondary">Click a detail to correct it. Each correction is saved on its own.</native-text>

        <native-vstack gap="Base" class="mt-4">
            @Html.Partial(Partials + "_DobQuickEditCard.cshtml", new DateOfBirthCorrection { ResidentId = residentId, Value = new DateTime(1942, 6, 14) })
            @Html.Partial(Partials + "_CareLevelQuickEditCard.cshtml", new CareLevelCorrection { ResidentId = residentId, Value = "Assisted Living" })
            @Html.Partial(Partials + "_MonthlyRateQuickEditCard.cshtml", new MonthlyRateCorrection { ResidentId = residentId, Value = 4500m })
            @Html.Partial(Partials + "_LastHospitalStayQuickEditCard.cshtml", new LastHospitalStayCorrection { ResidentId = residentId, Value = new DateTime(2025, 11, 3, 14, 15, 0) })
            @Html.Partial(Partials + "_MedicalRecordNumberQuickEditCard.cshtml", new MedicalRecordNumberCorrection { ResidentId = residentId, Value = "EVA1942" })
        </native-vstack>
    </section>
</native-vstack>

@Html.RenderPlan(plan)
