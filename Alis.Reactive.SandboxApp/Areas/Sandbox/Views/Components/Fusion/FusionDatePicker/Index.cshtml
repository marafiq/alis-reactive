@model FusionDatePickerModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Admission Booking";

    const string ButtonPrimary = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<FusionDatePickerModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Admission Booking</native-heading>
        <native-text color="Secondary">
            Dorothy Klein moves into Maple 118, Assisted Living. The room is ready from Monday, November 2, and
            held for her through Monday, November 30. The admissions office admits on weekdays.
        </native-text>
    </div>

    <native-card><native-card-body>
        <div id="admission-form">
            <native-grid cols="C2" gap="Base">
                @{ Html.InputField(plan, m => m.AdmissionDay, o => o.Required().Label("Admission day"))
                    .FusionDatePicker(b => b.Placeholder("Choose the admission day"))
                    .Reactive(evt => evt.Change, (args, p) =>
                        // The care team reviews a new resident's plan two weeks after admission.
                        p.When(args.Value).NotNull()
                            .Then(chosen => chosen.Get(Url.SandboxRoute("ProposeCarePlanReview", "FusionDatePicker"))
                                .Gather<CarePlanReviewQuery>(g => g.Set(x => x.AdmissionDay, args.Value))
                                .Response(r => r.OnSuccess<CarePlanReviewProposal>((proposal, s) =>
                                {
                                    s.Component<FusionDatePicker>(m => m.FirstCarePlanReview).Value.Set(proposal.Get(x => x.ReviewDay));

                                    // A day inside the hold is settled, so the keyboard goes away. A day outside
                                    // it keeps the cursor in the field, beside the message that says why.
                                    var admission = s.Component<FusionDatePicker>(m => m.AdmissionDay);
                                    s.When(admission.Value).Between(FusionDatePickerModel.RoomReady, FusionDatePickerModel.HoldEnds)
                                        .Then(settled => settled.Component<FusionDatePicker>(m => m.AdmissionDay).FocusOut());
                                })))); }
                <div>
                    @{ Html.InputField(plan, m => m.FirstCarePlanReview, o => o.Label("First care-plan review"))
                        .FusionDatePicker(b => b.Placeholder("Proposed from the admission day"))
                        .Reactive(evt => evt.Change, (args, p) =>
                            p.When(args.IsInteracted).Truthy()
                                .Then(moved => moved.Element("review-note").Text.Set("You moved the review from the day proposed."))
                                .Else(proposed => proposed.Element("review-note").Text.Set("Proposed two weeks after the admission day."))); }
                    <p id="review-note" class="mt-1 text-xs text-text-muted">The care team reviews the plan two weeks after admission.</p>
                </div>
            </native-grid>
        </div>

        <native-hstack gap="Sm" align="Center" class="mt-4 flex-wrap">
            @(Html.NativeButton("book-admission-btn", "Book Admission")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Post(Url.SandboxRoute("BookAdmission", "FusionDatePicker"))
                        .Gather(g => g.Form())
                        .Validate<AdmissionDayValidator>("admission-form")
                        .Response(r => r
                            .OnSuccess<AdmissionBooked>((booked, s) =>
                                s.Element("admission-status").Text.Set(booked.Get(x => x.Confirmation)))
                            .OnError(400, e =>
                            {
                                // The admissions office refused the day: the cursor goes back to it.
                                e.ValidationErrors("admission-form");
                                e.Component<FusionDatePicker>(m => m.AdmissionDay).FocusIn();
                            }))))
            <p id="admission-status" class="text-sm text-text-muted">Not booked yet.</p>
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
