@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.InputMask
@model InputMaskModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Family Phone Numbers";

    const string FormId = "family-phones-form";
    const string PhoneMask = "(000) 000-0000";
    const string PrimaryButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<InputMaskModel>();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Family Phone Numbers</native-heading>
    <native-text color="Secondary">
        Maple Grove front desk. Margaret Hale, Maple 214. Her son Daniel O'Brien is her family contact; the desk keeps a number only when all ten digits are in.
    </native-text>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.FamilyPhone, o => o.Required().Label("Daniel O'Brien's phone"))
                .FusionInputMask(b => b.Mask(PhoneMask)); }

            @{ Html.InputField(plan, m => m.EmergencyIsFamily, o => o.Label("Daniel is also her emergency contact"))
                .NativeCheckBox(b => b.CssClass("rounded border-border"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    var family = p.Component<FusionInputMask>(m => m.FamilyPhone);
                    var emergency = p.Component<FusionInputMask>(m => m.EmergencyPhone);
                    p.When(args.Checked).Truthy()
                        .Then(same => emergency.Value.Set(family.Value))
                        .Else(someoneElse =>
                        {
                            // Someone else: the copied number goes, and the desk types the other person's.
                            emergency.Value.Set("");
                            emergency.FocusIn();
                        });
                }); }

            @{ Html.InputField(plan, m => m.EmergencyPhone, o => o.Required().Label("Emergency contact's phone"))
                .FusionInputMask(b => b.Mask(PhoneMask))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    // A whole number the page copied, not one the desk typed.
                    p.When(args.IsInteracted).Falsy().And(args.Value).Matches(@"^\d{10}$")
                        .Then(copied => copied.Element("emergency-copied").Show())
                        .Else(typed => typed.Element("emergency-copied").Hide());
                }); }
            <p id="emergency-copied" hidden class="text-xs text-text-muted">Copied from Daniel's phone.</p>

            <native-hstack gap="Sm" align="Center" class="mt-2">
                @(Html.NativeButton("save-phones-btn", "Save numbers")
                    .CssClass(PrimaryButton)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        var family = p.Component<FusionInputMask>(m => m.FamilyPhone);
                        var emergency = p.Component<FusionInputMask>(m => m.EmergencyPhone);
                        p.Post(Url.SandboxRoute("Save", "InputMask"))
                            .Gather<InputMaskModel>(g => g
                                .Set(x => x.FamilyPhone, family.Value)
                                .Set(x => x.EmergencyPhone, emergency.Value))
                            .Validate<FamilyPhoneNumbersValidator>(FormId)
                            .Response(r => r
                                .OnSuccess<FamilyPhoneNumbersSaved>((saved, s) =>
                                    s.Element("phones-status").Text.Set(saved.Get(x => x.Message)))
                                .OnError(400, e => e.ValidationErrors(FormId)));
                    }))
                <p id="phones-status" class="text-sm">Not saved yet.</p>
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
