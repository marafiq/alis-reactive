@model FusionCarouselModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "FusionCarousel";

    const string CarouselId = "care-plan-review";
    const string ButtonPrimary = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";

    var recordUrl = Url.SandboxRoute("Record", "Carousel");

    var plan = Html.ReactivePlan<FusionCarouselModel>();
    var sections = new List<CarouselItem>
    {
        new() { Template = "<div class='care-section'><h3 class='care-section-title'>Medications</h3><p class='care-section-body'>Review current prescriptions, doses, and timing with the resident.</p></div>" },
        new() { Template = "<div class='care-section'><h3 class='care-section-title'>Therapy Goals</h3><p class='care-section-body'>Confirm this week's mobility and strength targets.</p></div>" },
        new() { Template = "<div class='care-section'><h3 class='care-section-title'>Discharge Steps</h3><p class='care-section-body'>Walk through family teaching and follow-up appointments.</p></div>" }
    };

    // On open, the review starts on the first section. Show which section the
    // resident is on, read from the carousel's own selected index.
    Html.On(plan, t => t.DomReady(p =>
    {
        var review = p.Component<FusionCarousel>(CarouselId);
        p.When(review.SelectedIndex()).Eq(0)
            .Then(s => s.Element("review-position").SetText("Section 1 of 3: Medications"))
            .ElseIf(review.SelectedIndex()).Eq(1)
            .Then(s => s.Element("review-position").SetText("Section 2 of 3: Therapy Goals"))
            .Else(s => s.Element("review-position").SetText("Section 3 of 3: Discharge Steps"));
    }));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Guided Care-Plan Review</native-heading>
        <native-text color="Secondary">
            Walk the resident through each section of their care plan. Move forward and back through
            the sections; the medications sign-off stays locked once you have moved past it, and each
            section you reach is recorded to the chart.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.FusionCarousel(plan, CarouselId, b =>
            {
                b.Items(sections);
                b.SelectedIndex(0);
                b.AnimationEffect(CarouselAnimationEffect.None);
                b.AutoPlay(false);
                b.ButtonsVisibility(CarouselButtonVisibility.Hidden);
                b.ShowIndicators(false);
                b.ShowPlayButton(false);
                b.AllowKeyboardInteraction(false);
                b.EnableTouchSwipe(false);
                b.Loop(false);
            })
            .Reactive(evt => evt.SlideChanging, (args, p) =>
            {
                // Medications (section 1, index 0) is the locked sign-off gate.
                // A move that would land back on it is blocked, and the nurse is
                // told why. The direction and how-you-tried come straight from the
                // changing payload so the message is specific.
                p.When(args, x => x.NextIndex).Eq(0)
                    .Then(blocked =>
                    {
                        args.PreventTransition(blocked);
                        blocked.Element("gate-notice").SetText("The medications sign-off is locked. Continue forward through the care plan.");
                        blocked.Element("gate-notice-panel").RemoveClass("hidden");

                        blocked.When(args, x => x.SlideDirection).Eq("Previous")
                            .Then(d => d.Element("gate-direction").SetText("You tried to go back to the medications section."))
                            .Else(d => d.Element("gate-direction").SetText("You tried to move to the medications section."));

                        // The section the resident is leaving from, read from the changing payload.
                        blocked.When(args, x => x.CurrentIndex).Eq(1)
                            .Then(f => f.Element("gate-from").SetText("You are still on the therapy goals section."))
                            .ElseIf(args, x => x.CurrentIndex).Eq(2)
                            .Then(f => f.Element("gate-from").SetText("You are still on the discharge steps section."))
                            .Else(f => f.Element("gate-from").SetText("You are still on the current section."));

                        blocked.When(args, x => x.IsSwiped).Truthy()
                            .Then(s => s.Element("gate-method").SetText("That swipe was not applied."))
                            .Else(s => s.Element("gate-method").SetText("That button press was not applied."));
                    })
                    .Else(allowed => allowed.Element("gate-notice-panel").AddClass("hidden"));
            })
            .Reactive(evt => evt.SlideChanged, (args, p) =>
            {
                var review = p.Component<FusionCarousel>(CarouselId);

                // Where the resident is now, read from the carousel after the move.
                p.When(review.SelectedIndex()).Eq(0)
                    .Then(s => s.Element("review-position").SetText("Section 1 of 3: Medications"))
                    .ElseIf(review.SelectedIndex()).Eq(1)
                    .Then(s => s.Element("review-position").SetText("Section 2 of 3: Therapy Goals"))
                    .Else(s => s.Element("review-position").SetText("Section 3 of 3: Discharge Steps"));

                // The section just reached, from the changed payload's current index.
                p.When(args, x => x.CurrentIndex).Eq(1)
                    .Then(s => s.Element("review-section").SetText("Therapy Goals"))
                    .ElseIf(args, x => x.CurrentIndex).Eq(2)
                    .Then(s => s.Element("review-section").SetText("Discharge Steps"))
                    .Else(s => s.Element("review-section").SetText("Medications"));

                // The section the resident came from, from the changed payload's previous index.
                p.When(args, x => x.PreviousIndex).Eq(0)
                    .Then(s => s.Element("review-came-from").SetText("after the medications section"))
                    .ElseIf(args, x => x.PreviousIndex).Eq(2)
                    .Then(s => s.Element("review-came-from").SetText("after the discharge steps"))
                    .Else(s => s.Element("review-came-from").SetText("after the therapy goals"));

                // Which way the resident moved, from the changed payload's direction.
                p.When(args, x => x.SlideDirection).Eq("Previous")
                    .Then(s => s.Element("review-movement").SetText("You went back a section."))
                    .Else(s => s.Element("review-movement").SetText("You moved forward a section."));

                // How the resident navigated, from the changed payload's swipe flag.
                p.When(args, x => x.IsSwiped).Truthy()
                    .Then(s => s.Element("review-method").SetText("Reached by swiping."))
                    .Else(s => s.Element("review-method").SetText("Reached using the navigation buttons."));

                // Record the reviewed section to the chart, gathering the move from the payload.
                p.Post(recordUrl)
                    .Gather(g => g
                        .FromEvent(args, x => x.CurrentIndex, "sectionIndex")
                        .FromEvent(args, x => x.PreviousIndex, "cameFromIndex")
                        .FromEvent(args, x => x.SlideDirection, "direction")
                        .FromEvent(args, x => x.IsSwiped, "bySwipe"))
                    .Response(r => r.OnSuccess<CarePlanReviewResponse>((json, s) =>
                    {
                        s.Element("chart-line").SetText(json, x => x.ChartLine);
                        s.Element("chart-panel").RemoveClass("hidden");
                    }));
            }))

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("review-previous", "Previous section")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.Component<FusionCarousel>(CarouselId).Previous();
                    }))
                @(Html.NativeButton("review-next", "Next section")
                    .CssClass(ButtonPrimary)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.Component<FusionCarousel>(CarouselId).Next();
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Xs">
            <native-text><span id="review-position" class="font-semibold text-text">Section 1 of 3: Medications</span></native-text>
            <native-text color="Secondary">
                Now reviewing <span id="review-section" class="font-medium text-text">Medications</span>,
                <span id="review-came-from">at the start of the review</span>.
            </native-text>
            <native-text color="Secondary"><span id="review-movement">Start at the medications section.</span></native-text>
            <native-text color="Secondary"><span id="review-method">Use the buttons to move through the plan.</span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    <div id="gate-notice-panel" class="hidden rounded-md border border-amber-300 bg-amber-50 p-4">
        <native-vstack gap="Xs">
            <native-text><span id="gate-notice" class="font-medium text-amber-800"></span></native-text>
            <native-text color="Secondary"><span id="gate-direction" class="text-amber-700"></span></native-text>
            <native-text color="Secondary"><span id="gate-from" class="text-amber-700"></span></native-text>
            <native-text color="Secondary"><span id="gate-method" class="text-amber-700"></span></native-text>
        </native-vstack>
    </div>

    <native-card><native-card-body>
        <native-heading level="H2">Chart</native-heading>
        <div id="chart-panel" class="hidden mt-2 rounded-md border border-green-300 bg-green-50 p-4">
            <native-text><span id="chart-line" class="font-medium text-green-800"></span></native-text>
        </div>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
