@model TabModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "Resident Care Workspace";

    const string Workspace = "care-workspace";
    const string ButtonPrimary = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";

    var plan = Html.ReactivePlan<TabModel>();

    var sections = new List<TabItem>
    {
        new TabItem
        {
            Header = new TabHeader { Text = "Care Schedule" },
            Content = "<div class='p-4 space-y-2'>" +
                      "<h3 class='text-sm font-semibold text-text-primary'>Today's care schedule</h3>" +
                      "<ul class='text-sm space-y-1'>" +
                      "<li>08:00 — Morning vitals and medication pass</li>" +
                      "<li>10:30 — Physical therapy, West activity room</li>" +
                      "<li>12:30 — Lunch, low-sodium tray</li>" +
                      "<li>15:00 — Family visit (daughter)</li>" +
                      "</ul></div>"
        },
        new TabItem
        {
            Header = new TabHeader { Text = "Medications" },
            Content = "<div class='p-4 space-y-2'>" +
                      "<h3 class='text-sm font-semibold text-text-primary'>Current medications</h3>" +
                      "<ul class='text-sm space-y-1'>" +
                      "<li>Lisinopril 10 mg — once daily, morning</li>" +
                      "<li>Metformin 500 mg — twice daily, with meals</li>" +
                      "<li>Atorvastatin 20 mg — once daily, evening</li>" +
                      "</ul></div>"
        },
        new TabItem
        {
            Header = new TabHeader { Text = "Incident Reports" },
            Content = "<div class='p-4 space-y-2'>" +
                      "<h3 class='text-sm font-semibold text-text-primary'>Recent incident reports</h3>" +
                      "<p class='text-sm'>No incidents reported in the last 30 days.</p>" +
                      "</div>"
        },
        new TabItem
        {
            Header = new TabHeader { Text = "Billing" },
            Content = "<div class='p-4 space-y-2'>" +
                      "<h3 class='text-sm font-semibold text-text-primary'>Monthly statement</h3>" +
                      "<p class='text-sm'>Memory Care — $6,400 / month. Balance due: $0.00.</p>" +
                      "</div>"
        }
    };
}

<div class="space-y-6">
    <div>
        <native-heading level="H1">Resident Care Workspace</native-heading>
        <native-text color="Secondary">
            @Model.ResidentName — Room @Model.RoomNumber. Move between sections to coordinate this resident's care.
        </native-text>
    </div>

    <div class="rounded-lg border border-border bg-white p-6 shadow-sm space-y-4">
        <div class="space-y-1">
            <p class="text-sm">Now viewing: <span id="active-section" class="font-semibold text-text">Care Schedule</span></p>
            <p class="text-sm text-text-secondary"><span id="section-context">Today's care schedule for this resident.</span></p>
            <p class="text-sm text-text-secondary"><span id="navigation-mode"></span></p>
        </div>

        @* The Tab content panels switch with no slide animation. EJ2's slide effect finalizes
           the panel swap on the CSS animationend event; with the animation effect set to None
           the swap is applied synchronously, so the active panel shows immediately and the
           previous one hides cleanly. *@
        <div class="w-full">
            @(Html.FusionTab(plan, Workspace, b => b
                .Items(sections)
                .Animation(new TabAnimationSettings
                {
                    Previous = new TabActionSettings { Effect = "None" },
                    Next = new TabActionSettings { Effect = "None" }
                }))
                .Reactive(evt => evt.Selected, (args, p) =>
                {
                    p.When(args, x => x.SelectedIndex).Eq(0)
                        .Then(t => t.Element("active-section").SetText("Care Schedule"))
                        .ElseIf(args, x => x.SelectedIndex).Eq(1)
                        .Then(t => t.Element("active-section").SetText("Medications"))
                        .ElseIf(args, x => x.SelectedIndex).Eq(2)
                        .Then(t => t.Element("active-section").SetText("Incident Reports"))
                        .Else(e => e.Element("active-section").SetText("Billing"));

                    p.When(args, x => x.PreviousIndex).Eq(0)
                        .Then(t => t.Element("section-context").SetText("You moved here from Care Schedule."))
                        .ElseIf(args, x => x.PreviousIndex).Eq(1)
                        .Then(t => t.Element("section-context").SetText("You moved here from Medications."))
                        .ElseIf(args, x => x.PreviousIndex).Eq(2)
                        .Then(t => t.Element("section-context").SetText("You moved here from Incident Reports."))
                        .Else(e => e.Element("section-context").SetText("You moved here from Billing."));

                    p.When(args, x => x.IsSwiped).Truthy()
                        .Then(t => t.Element("navigation-mode").SetText("Last navigation: opened by swipe."))
                        .Else(e => e.Element("navigation-mode").SetText("Last navigation: opened by selection."));
                }))
        </div>
    </div>

    <div class="rounded-lg border border-border bg-white p-6 shadow-sm space-y-4">
        <native-heading level="H3">Quick actions</native-heading>
        <div class="flex flex-wrap gap-3">
            @(Html.NativeButton("resume-medications", "Resume in Medications")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionTab>(Workspace).SetSelectedItem(1);
                }))
            @(Html.NativeButton("log-incident", "Log an incident now")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionTab>(Workspace).Select(2);
                }))
            @(Html.NativeButton("hide-billing", "Hide billing from this view")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionTab>(Workspace).HideTab(3, true);
                    p.Element("billing-access").SetText("Billing is hidden from this workspace.");
                }))
            @(Html.NativeButton("show-billing", "Restore billing tab")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionTab>(Workspace).HideTab(3, false);
                    p.Element("billing-access").SetText("Billing is visible to coordinators.");
                }))
        </div>
        <p class="text-sm text-text-secondary"><span id="billing-access">Billing is visible to coordinators.</span></p>
    </div>
</div>

@Html.RenderPlan(plan)
