@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.BulletChart
@model FusionBulletChartModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.Charts
@{
    ViewData["Title"] = "Weekly Staffing";

    const string NursingChartId = "nursing-hours-chart";
    const string AgencyChartId = "agency-hours-chart";

    var plan = Html.ReactivePlan<FusionBulletChartModel>();
    var shiftsUrl = Url.SandboxRoute("WingShifts", "BulletChart");
    var wingField = Alis.Reactive.Field.Of((WingHours w) => w.Wing).Name;
    var hoursField = Alis.Reactive.Field.Of((WingHours w) => w.Hours).Name;
    var targetField = Alis.Reactive.Field.Of((WingHours w) => w.Target).Name;

    // The wing at a place in the chart's order.
    void ShowWing(PipelineBuilder<FusionBulletChartModel> p, TypedSource<int> place, string elementId) =>
        p.When(place).Eq(0).Then(t => t.Element(elementId).Text.Set(StaffingWeek.Nursing[0].Wing))
            .ElseIf(place).Eq(1).Then(t => t.Element(elementId).Text.Set(StaffingWeek.Nursing[1].Wing))
            .ElseIf(place).Eq(2).Then(t => t.Element(elementId).Text.Set(StaffingWeek.Nursing[2].Wing))
            .ElseIf(place).Eq(3).Then(t => t.Element(elementId).Text.Set(StaffingWeek.Nursing[3].Wing));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Weekly Staffing</native-heading>
    <native-text color="Secondary">
        Week of October 5. The hours each wing worked against its budget, and the agency hours it used against its cap.
        Point at a wing for its numbers; click a wing's nursing bar for the week's shifts.
    </native-text>

    <native-card><native-card-body>
        <native-heading level="H2">Nursing hours</native-heading>

        @(Html.FusionBulletChart(plan, NursingChartId, b =>
        {
            b.Width("100%");
            b.Height("260px");
            b.Minimum(0);
            b.Maximum(1000);
            b.Interval(200);
            b.CategoryField(wingField);
            b.ValueField(hoursField);
            b.TargetField(targetField);
            b.DataSource(StaffingWeek.Nursing);
            b.Tooltip(new BulletChartBulletTooltipSettings { Enable = true });
        })
        .Reactive(evt => evt.TooltipRender, (args, p) =>
        {
            args.Text.Set("Click the bar for this wing's shifts");
            p.Element("nursing-hours-worked").Text.Set(args.Value);
            p.Element("nursing-hours-budgeted").Text.Set(args.Target.Get(x => x[0]));
            p.Element("nursing-hours-readout").Show();
        })
        .Reactive(evt => evt.BulletChartMouseClick, (args, p) =>
        {
            // Only a wing's bar or budget line opens its shifts.
            p.When(args.Target).Contains("Measure_")
                .Then(t =>
                {
                    t.Element("wing-shifts-hint").Hide();
                    t.Post(shiftsUrl)
                        .Gather<WingShiftsRequest>(g => g.Set(x => x.Bar, args.Target))
                        .Response(r => r.OnSuccess<WingShifts>((json, s) =>
                        {
                            s.Element("wing-shifts-wing").Text.Set(json.Get(x => x.Wing));
                            s.Element("wing-shifts-summary").Text.Set(json.Get(x => x.Summary));
                            s.Element("wing-shifts").Show();
                        }));
                })
                .Else(e => e.Element("wing-shifts-hint").Show());
        }))

        <p id="nursing-hours-readout" hidden aria-live="polite" class="mt-2 text-sm">Worked <span id="nursing-hours-worked" class="font-medium"></span> of <span id="nursing-hours-budgeted" class="font-medium"></span> budgeted hours.</p>
        <p id="wing-shifts-hint" hidden class="mt-2 text-sm text-text-muted">Click a wing's bar or budget line to open its shifts.</p>

        <section id="wing-shifts" hidden class="mt-4 rounded-md border border-border p-3">
            <h3 class="text-sm font-semibold"><span id="wing-shifts-wing"></span> shifts this week</h3>
            <p id="wing-shifts-summary" class="text-sm"></p>
        </section>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Agency hours</native-heading>

        @(Html.FusionBulletChart(plan, AgencyChartId, b =>
        {
            b.Width("100%");
            b.Height("260px");
            b.Minimum(0);
            b.Maximum(150);
            b.Interval(30);
            b.CategoryField(wingField);
            b.ValueField(hoursField);
            b.TargetField(targetField);
            b.DataSource(StaffingWeek.Agency);
            b.Tooltip(new BulletChartBulletTooltipSettings
            {
                Enable = true,
                Template = "<span>${value} h used of the ${target} h cap</span>"
            });
        })
        .Reactive(evt => evt.TooltipRender, (args, p) =>
            // The tooltip card is repeated under the chart, where it stays and a screen reader reads it.
            p.Element("agency-hours-readout").Html.Set(args.Template)))

        <p id="agency-hours-readout" aria-live="polite" class="mt-2 text-sm">Point at a wing to read its agency hours.</p>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Huddle round</native-heading>
        <p class="text-sm text-text-secondary mb-2">
            The huddle goes through the wings in the chart's order with each charge nurse. Tick each wing once it is reviewed.
        </p>

        @{ Html.InputField(plan, m => m.ReviewedWings, o => o.Label("Reviewed"))
            .NativeCheckList(b =>
            {
                foreach (var wing in StaffingWeek.Nursing)
                    b.Option(wing.Wing);
            })
            .Reactive(evt => evt.Change, (args, p) =>
            {
                // After the last wing the round starts over at the first.
                var reviewed = p.From(args.Value).Count();
                var next = p.Component<FusionBulletChart>(NursingChartId).GetActualIndex(reviewed, StaffingWeek.Nursing.Count);
                ShowWing(p, next, "huddle-next");
            }); }

        <p class="mt-2 text-sm">Up next: <span id="huddle-next" class="font-medium">@StaffingWeek.Nursing[0].Wing</span></p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
