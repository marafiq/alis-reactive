@model SliderModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Inputs
@{
    ViewData["Title"] = "FusionSlider";

    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string SubmitReady = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<SliderModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Comfort &amp; Care Preferences</native-heading>
        <native-text color="Secondary">
            We carried over the comfort settings you saved last month. Adjust your room temperature and your afternoon rest window, then save.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Room temperature</native-heading>
            @{ Html.InputField(plan, m => m.RoomTemperature, o => o.Label("Set the temperature that keeps your room comfortable"))
                .FusionSlider(b => b
                    .Min(60)
                    .Max(80)
                    .Step(2)
                    .Value(Model.RoomTemperature))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    // The live reading follows the handle as the resident drags it.
                    p.Element("comfort-reading").Text.Set(args.Text);

                    p.When(args.Value).Gte(74d)
                        .Then(warm => warm.Element("comfort-zone")
                            .Text.Set("That's on the warm side — comfortable if you tend to feel cold."))
                        .ElseIf(args.Value).Gte(66d)
                        .Then(mid => mid.Element("comfort-zone")
                            .Text.Set("That's a comfortable mid-range temperature for most residents."))
                        .Else(cool => cool.Element("comfort-zone")
                            .Text.Set("That's on the cool side — we'll have a blanket ready."));
                })
                .Reactive(evt => evt.Changed, (args, p) =>
                {
                    // When the handle settles, record what it changed from and how.
                    p.Element("settle-from").Text.Set(args.PreviousValue);
                    p.Element("settle-action").Text.Set(args.Action);

                    p.When(args.IsInteracted).Truthy()
                        .Then(chosen => chosen.Element("comfort-source")
                            .Text.Set("You set this temperature yourself."))
                        .Else(applied => applied.Element("comfort-source")
                            .Text.Set("We applied the temperature recommended by your care team."));
                }); }

            <native-vstack gap="Xs">
                <native-text>
                    Current setting: <span id="comfort-reading" class="font-semibold text-text">@Model.RoomTemperature</span>&deg;F
                </native-text>
                <native-text color="Secondary"><span id="comfort-zone">This is the temperature you saved last month.</span></native-text>
                <native-text color="Secondary">
                    Adjusted from <span id="settle-from">@Model.RoomTemperature</span>&deg;F (<span id="settle-action">saved</span>)
                </native-text>
                <native-text color="Secondary"><span id="comfort-source">Adjust the slider above, or apply our recommendation.</span></native-text>
            </native-vstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("apply-recommended-temp", "Apply the recommended 72°F")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var roomTemperature = p.Component<FusionSlider>(m => m.RoomTemperature);
                        roomTemperature.Value.Set(72);
                        roomTemperature.DataBind();
                    }))
                @(Html.NativeButton("check-temp-guidance", "Check this temperature")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var temp = p.Component<FusionSlider>(m => m.RoomTemperature);
                        p.When(temp.Value).Gte(74d)
                            .Then(warm => warm.Element("temp-guidance")
                                .Text.Set("A care manager will check in to make sure that's not too warm overnight."))
                            .Else(ok => ok.Element("temp-guidance")
                                .Text.Set("That temperature is within the comfortable range — no follow-up needed."));
                    }))
            </native-hstack>
            <native-text color="Secondary"><span id="temp-guidance"></span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Afternoon rest window</native-heading>
            <native-text color="Secondary">
                The hours when staff hold non-urgent visits so you can rest.
            </native-text>
            @{ Html.InputField(plan, m => m.QuietHours, o => o.Label("Choose your afternoon rest window"))
                .FusionSlider(b => b
                    .Min(12)
                    .Max(18)
                    .Step(1)
                    .Type(SliderType.Range)
                    .Value(Model.QuietHours)); }

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("apply-recommended-rest", "Apply the recommended 2–4 PM window")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var rest = p.Component<FusionSlider>(m => m.QuietHours);
                        rest.RangeValue.Set(new double[] { 14, 16 });
                        rest.DataBind();
                        p.Element("rest-summary").Text.Set(rest.RangeValue);
                    }))
            </native-hstack>
            <native-text color="Secondary">Saved rest window (start, end hours): <span id="rest-summary">@string.Join(", ", Model.QuietHours)</span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.NativeButton("save-preferences", "Save my comfort preferences")
                .CssClass(SubmitReady)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var temp = p.Component<FusionSlider>(m => m.RoomTemperature);
                    var rest = p.Component<FusionSlider>(m => m.QuietHours);
                    p.Post(Url.SandboxRoute("Save", "Slider"))
                        .Gather<ComfortPreferencesRequest>(g => g
                            .Set(x => x.RoomTemperature, temp.Value)
                            .Set(x => x.QuietHours, rest.RangeValue))
                        .Response(r => r.OnSuccess<ComfortPreferencesResponse>((json, s) =>
                        {
                            s.Element("save-confirmation").Text.Set(json.Get(x => x.Summary));
                            s.Element("save-confirmation-panel").ClassList.Remove("hidden");
                        }));
                }))
            <div id="save-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="save-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
