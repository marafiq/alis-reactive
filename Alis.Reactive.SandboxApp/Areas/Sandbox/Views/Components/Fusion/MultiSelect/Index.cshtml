@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.MultiSelect
@model FusionMultiSelectModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Microsoft.AspNetCore.Mvc.Rendering
@using Syncfusion.EJ2.DropDowns
@{
    ViewData["Title"] = "Diet Order";

    const string FormId = "diet-order-form";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string PrimaryButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string SelectInput = "rounded-md border border-border px-3 py-1.5 text-sm";

    var plan = Html.ReactivePlan<FusionMultiSelectModel>();
    var textures = Model.Textures.Select(texture => new SelectListItem(texture.Name, texture.Id, texture.Id == Model.Texture)).ToList();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Diet Order</native-heading>
    <native-text color="Secondary">Margaret Hale, Maple 214. Update her diet order; the kitchen prints her tray ticket from it.</native-text>

    <native-grid cols="C2" gap="Lg">
        <native-card><native-card-body id="@FormId">
            <native-vstack gap="Base">
                @{ Html.InputField(plan, m => m.Allergies, o => o.Required().Label("Allergies"))
                    .FusionMultiSelect(b => b
                        .DataSource(Model.AllergyList)
                        .Fields<AllergyChoice>(t => t.Name, v => v.Id, g => g.Kind)
                        .Value(Model.Allergies)
                        .Mode(VisualMode.Box)
                        .Placeholder("Record her allergies"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        // The tray ticket prints the allergies the order now holds, and the page says where
                        // they came from.
                        p.Get(Url.SandboxRoute("TrayTicket", "MultiSelect"))
                            .Gather<TrayTicketQuery>(g => g.Set(x => x.Allergies, args.Value))
                            .Response(r => r.OnSuccess<TrayTicketLine>((ticket, s) =>
                                s.Element("tray-ticket").Text.Set(ticket.Get(x => x.Line))));
                        p.When(args.IsInteracted).Truthy()
                            .Then(byHand => byHand.Element("allergy-source").Text.Set("Changed by you."))
                            .Else(copied => copied.Element("allergy-source").Text.Set("From her hospital discharge summary."));
                    }); }
                <p id="allergy-source" class="text-sm text-text-muted">From her chart.</p>

                @{ Html.InputField(plan, m => m.Texture, o => o.Label("Texture"))
                    .NativeDropDown(b => b.Items(textures).CssClass(SelectInput))
                    .Reactive(evt => evt.Change, (args, p) =>
                        // The snacks list fills with what the new texture allows and opens for the dietitian.
                        p.Get(Url.SandboxRoute("Snacks", "MultiSelect"))
                            .Gather<SnackQuery>(g => g.Set(x => x.Texture, args.Value))
                            .Response(r => r.OnSuccess<TextureSnacks>((allowed, s) =>
                            {
                                var snacks = s.Component<FusionMultiSelect>(m => m.Snacks);
                                snacks.Items<MenuChoice>().Set(allowed.Get(x => x.Snacks));
                                snacks.DataBind();
                                snacks.ShowPopup();
                            }))); }

                @{ Html.InputField(plan, m => m.Snacks, o => o.Label("Snacks between meals"))
                    .FusionMultiSelect(b => b
                        .DataSource(Model.SnackList)
                        .Fields<MenuChoice>(t => t.Name, v => v.Id)
                        .Mode(VisualMode.CheckBox)
                        .ShowSelectAll(true)
                        .Placeholder("Choose her snacks")); }

                @{ Html.InputField(plan, m => m.Dislikes, o => o.Label("Dishes she will not eat"))
                    .FusionMultiSelect(b => b
                        .DataSource(Model.Menu)
                        .Fields<MenuChoice>(t => t.Name, v => v.Id)
                        .Mode(VisualMode.CheckBox)
                        .MaximumSelectionLength(3)
                        .ChangeOnBlur(false)
                        .Placeholder("Up to three dishes"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        // The kitchen substitutes up to three dishes: the third closes the list and says so.
                        p.When(p.From(args.Value).Count()).Gte(3)
                            .Then(full =>
                            {
                                full.Component<FusionMultiSelect>(m => m.Dislikes).HidePopup();
                                full.Element("dislike-limit").Show();
                            })
                            .Else(room => room.Element("dislike-limit").Hide());
                    }); }
                <p id="dislike-limit" hidden class="text-sm text-amber-700">The kitchen substitutes up to three dishes. Remove one to choose another.</p>

                @{ Html.InputField(plan, m => m.Supplements, o => o.Label("Supplements"))
                    .FusionMultiSelect(b => b
                        .DataSource(Model.UsualSupplements)
                        .Fields<MenuChoice>(t => t.Name, v => v.Id)
                        .Mode(VisualMode.Box)
                        .AllowFiltering(true)
                        .DebounceDelay(300)
                        .Placeholder("Type to search the catalog"))
                    .Reactive(evt => evt.Filtering, (args, p) =>
                    {
                        // The catalog answers for what was typed; until it does, the list keeps the usual supplements.
                        args.PreventDefaultAction.Set(true);
                        p.Get(Url.SandboxRoute("Supplements", "MultiSelect"))
                            .Gather<SupplementSearch>(g => g.Set(x => x.Name, args.Text))
                            .WhileLoading(l => l.Element("supplement-status").Text.Set("Searching the kitchen's catalog..."))
                            .Response(r => r.OnSuccess<SupplementMatches>((found, s) =>
                            {
                                args.UpdateData(found.Get(x => x.Supplements));
                                s.Element("supplement-status").Text.Set(found.Get(x => x.Summary));
                            }));
                    }); }
                <p id="supplement-status" class="text-sm text-text-muted">Type part of a name to search the kitchen's catalog.</p>
            </native-vstack>
        </native-card-body></native-card>

        @* The tray ticket and the commands sit beside the order, where its lists cannot cover them. *@
        <native-card><native-card-body>
            <native-vstack gap="Base">
                <native-heading level="H2">Tray ticket</native-heading>
                <p id="tray-ticket" class="text-sm font-medium">@Model.TrayTicket</p>
                <native-hstack gap="Sm" class="flex-wrap">
                    @(Html.NativeButton("copy-discharge-btn", "Copy From Discharge Summary")
                        .CssClass(Button)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                            p.Get(Url.SandboxRoute("Discharge", "MultiSelect"))
                                .Response(r => r.OnSuccess<DischargeAllergies>((discharge, s) =>
                                    s.Component<FusionMultiSelect>(m => m.Allergies).Value.Set(discharge.Get(x => x.Allergies))))))
                    @(Html.NativeButton("save-diet-order-btn", "Save Diet Order")
                        .CssClass(PrimaryButton)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                            p.Post(Url.SandboxRoute("Save", "MultiSelect"))
                                .Gather(g => g.Form())
                                .Validate<DietOrderValidator>(FormId)
                                .Response(r => r
                                    .OnSuccess<DietOrderSaved>((saved, s) => s.Element("save-status").Text.Set(saved.Get(x => x.Message)))
                                    .OnError(400, e => e.ValidationErrors(FormId)))))
                </native-hstack>
                <p id="save-status" class="text-sm">Not saved yet.</p>
            </native-vstack>
        </native-card-body></native-card>
    </native-grid>
</native-vstack>

@Html.RenderPlan(plan)
