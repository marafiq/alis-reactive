@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.RichTextEditor
@model RichTextEditorModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Family Newsletter";

    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string PrimaryButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<RichTextEditorModel>();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Family Newsletter</native-heading>
    <native-text color="Secondary">
        March issue, Activities corner. Write the Garden Club paragraph families will read; the preview shows it as they will see it.
    </native-text>

    <native-grid cols="C2" gap="Lg">
        <native-card><native-card-body>
            <native-vstack gap="Sm">
                @{ Html.InputField(plan, m => m.Paragraph, o => o.Label("Garden Club paragraph"))
                    .FusionRichTextEditor(b => b
                        .Placeholder("Write the Garden Club paragraph")
                        // While the director types, the editor commits the draft every three seconds.
                        .SaveInterval(3000))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.Element("newsletter-preview").Html.Set(args.Value);
                        p.When(args.IsInteracted).Truthy()
                            .Then(left => left.Element("draft-status").Text.Set("Preview updated when you left the editor."))
                            .Else(paused => paused.Element("draft-status").Text.Set("Preview updated while you typed."));
                    }); }
                <p id="draft-status" class="text-xs text-text-muted">The preview updates as you write.</p>

                <native-hstack gap="Sm" class="flex-wrap mt-2">
                    @(Html.NativeButton("start-from-last-month-btn", "Start from last month's paragraph")
                        .CssClass(Button)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                            p.Component<FusionRichTextEditor>(m => m.Paragraph).Value.Set(Model.LastMonthParagraph)))
                    @(Html.NativeButton("save-paragraph-btn", "Save paragraph")
                        .CssClass(PrimaryButton)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                        {
                            var paragraph = p.Component<FusionRichTextEditor>(m => m.Paragraph);
                            p.When(paragraph.Value).IsEmpty()
                                .Then(empty =>
                                {
                                    empty.Element("save-status").Text.Set("Write the Garden Club paragraph before saving.");
                                    paragraph.FocusIn();
                                })
                                .Else(written => written.Post(Url.SandboxRoute("Save", "RichTextEditor"))
                                    .Gather<NewsletterParagraphSave>(g => g.Set(x => x.Paragraph, paragraph.Value))
                                    .Response(r => r.OnSuccess<NewsletterParagraphSaved>((saved, s) =>
                                        s.Element("save-status").Text.Set(saved.Get(x => x.Message)))));
                        }))
                </native-hstack>
                <p id="save-status" class="text-sm font-medium">Not saved yet.</p>
            </native-vstack>
        </native-card-body></native-card>

        <native-card><native-card-body>
            <native-heading level="H2">As families will see it</native-heading>
            <div id="newsletter-preview" class="mt-3 text-sm leading-relaxed"></div>
        </native-card-body></native-card>
    </native-grid>
</native-vstack>

@Html.RenderPlan(plan)
