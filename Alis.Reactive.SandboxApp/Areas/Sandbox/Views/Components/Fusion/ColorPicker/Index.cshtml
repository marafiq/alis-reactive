@model ColorPickerModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionColorPicker";

    var plan = Html.ReactivePlan<ColorPickerModel>();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Community Branding</native-heading>
    <native-text color="Secondary">
        Choose the colors the resident portal and printed notices use, then review them before they go out.
    </native-text>

    <native-card><native-card-body>
        <native-heading level="H2">Brand color</native-heading>
        <p class="text-sm text-text-secondary mb-4">Headers and buttons use the brand color, with white text on it.</p>
        @{ Html.InputField(plan, m => m.ThemeColor, o => o.Label("Brand color"))
            .FusionColorPicker()
            .Reactive(evt => evt.Change, (args, p) =>
            {
                // White text disappears on a white brand color.
                p.When(args.Value).Eq("#ffffffff")
                    .Then(white => white.Element("brand-contrast-warning").Show())
                    .Else(readable => readable.Element("brand-contrast-warning").Hide());
            }); }
        <p id="brand-contrast-warning" class="text-sm text-warning mt-2" hidden>White text on a white brand color cannot be read. Choose a darker brand color.</p>
        <native-hstack gap="None" class="mt-3">
            @(Html.NativeButton("choose-brand-color", "Choose brand color")
                .CssClass("rounded-md border border-border bg-white px-4 py-2 text-sm font-medium hover:bg-surface-muted transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Component<FusionColorPicker>(m => m.ThemeColor).Toggle()))
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Accent color</native-heading>
        <p class="text-sm text-text-secondary mb-4">Highlights use the accent color. Choose the empty swatch for no accent.</p>
        @{ Html.InputField(plan, m => m.AccentColor, o => o.Label("Accent color"))
            .FusionColorPicker(b => b
                .Mode(Syncfusion.EJ2.Inputs.ColorPickerMode.Palette)
                .ModeSwitcher(false)
                .NoColor(true)
                .ShowButtons(false)); }
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Review</native-heading>
        <native-hstack gap="None">
            @(Html.NativeButton("review-branding", "Review branding")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var brand = p.Component<FusionColorPicker>(m => m.ThemeColor);
                    var accent = p.Component<FusionColorPicker>(m => m.AccentColor);
                    p.Element("reviewed-brand").Text.Set(brand.Value);
                    p.When(accent.Value).IsEmpty()
                        .Then(none => none.Element("reviewed-accent").Text.Set("None"))
                        .Else(chosen => chosen.Element("reviewed-accent").Text.Set(accent.Value));
                    p.Element("branding-review").Show();
                }))
        </native-hstack>
        <dl id="branding-review" class="mt-4 grid grid-cols-2 gap-2 text-sm" hidden>
            <dt class="text-text-secondary">Brand color</dt>
            <dd id="reviewed-brand" class="font-mono"></dd>
            <dt class="text-text-secondary">Accent color</dt>
            <dd id="reviewed-accent" class="font-mono"></dd>
        </dl>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
