@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.AIAssistView
@model AIAssistViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.InteractiveChat
@{
    ViewData["Title"] = "Care-plan Assistant";

    const string AssistantId = "care-ai";
    const string NotesToggleId = "notes-toggle-btn";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";

    var plan = Html.ReactivePlan<AIAssistViewModel>();
    var commonQuestions = new[]
    {
        "What follow-ups are due this week?",
        "Draft a family update",
        "List fall-risk interventions"
    };
    var savedNotes = "<div class=\"p-4\"><p class=\"text-sm font-medium\">Saved by the care team</p>"
        + "<ul id=\"saved-notes\" class=\"mt-2 list-disc pl-5 text-sm\">"
        + string.Concat(Model.SavedNotes.Select(note => $"<li>{Html.Encode(note)}</li>"))
        + "</ul></div>";
    var nightHandoff = new FusionAIAssistViewPromptModel
    {
        Prompt = Model.NightHandoff.Question,
        Response = Model.NightHandoff.Answer
    };

    // The resident's chart links here with a question, which is asked on arrival:
    // ?ask=What follow-ups are due this week?
    Html.On(plan, t => t.DomReady(p =>
    {
        var ask = p.Url<AssistantLink>().Get(q => q.Ask);
        p.When(ask).NotEmpty()
            .Then(asked => asked.Component<FusionAIAssistView>(AssistantId).ExecutePrompt(ask));
    }));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care-plan Assistant</native-heading>
    <native-text color="Secondary">
        @Model.ResidentName · @Model.Room · @Model.CareLevel. Ask the community's assistant about her care-plan
        follow-ups; it answers from the care team's records.
    </native-text>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="mb-4 flex-wrap">
            @(Html.NativeButton(NotesToggleId, "Open saved notes")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    // The notes take the conversation's place, and the button brings it back.
                    var assistant = p.Component<FusionAIAssistView>(AssistantId);
                    var toggle = p.Component<NativeButton>(NotesToggleId);
                    p.When(assistant.ActiveView).Eq(0)
                        .Then(notes =>
                        {
                            assistant.ActiveView.Set(1);
                            toggle.TextContent.Set("Back to the conversation");
                            notes.Element("conversation-actions").Hide();
                        })
                        .Else(conversation =>
                        {
                            assistant.ActiveView.Set(0);
                            toggle.TextContent.Set("Open saved notes");
                            conversation.Element("conversation-actions").Show();
                        });
                }))
        </native-hstack>

        @(Html.FusionAIAssistView(plan, AssistantId, b =>
        {
            b.Height("460px");
            b.Width("100%");
            b.ShowHeader(false);
            b.Views(view =>
            {
                view.Type(AssistViewType.Assist).Name("Conversation").Add();
                view.Type(AssistViewType.Custom).Name("Notes").ViewTemplate(savedNotes).Add();
            });
            b.PromptPlaceholder("Ask about Margaret's care plan");
            b.PromptSuggestionsHeader("Common questions");
            b.PromptSuggestions(commonQuestions);
        })
        .Reactive(evt => evt.PromptChanged, (args, p) =>
        {
            // A question cleared from the box is named, in case it was cleared by mistake.
            p.When(args.Value).IsEmpty()
                .Then(cleared =>
                {
                    cleared.Element("question-cleared-text").Text.Set(args.PreviousValue);
                    cleared.Element("question-cleared").Show();
                })
                .Else(typed => typed.Element("question-cleared").Hide());
        })
        .Reactive(evt => evt.PromptRequest, (args, p) =>
        {
            // The care team's records answer on the server, which names the common questions not asked.
            var assistant = p.Component<FusionAIAssistView>(AssistantId);
            p.Post(Url.SandboxRoute("Answer", "AIAssistView"))
             .Gather<AssistantQuestion>(g => g
                 .Set(x => x.Prompt, args.Prompt)
                 .Set(x => x.Suggestions, args.PromptSuggestions))
             .Response(r => r.OnSuccess<AssistantAnswer>((answer, s) =>
                 assistant.AddPromptResponse(answer.Get(x => x.Answer), true)));
        })
        .Reactive(evt => evt.StopRespondingClick, (args, p) =>
        {
            // The stopped question goes back in the box to edit; the server stops preparing its answer.
            p.Component<FusionAIAssistView>(AssistantId).Prompt.Set(args.Prompt);
            p.Post(Url.SandboxRoute("StopAnswer", "AIAssistView"))
             .Gather<StoppedAnswer>(g => g.Set(x => x.QuestionIndex, args.DataIndex))
             .Response(r => r.OnSuccess<AssistantStatus>((stopped, s) =>
                 s.Element("assistant-status").Text.Set(stopped.Get(x => x.Summary))));
        }))

        <p id="question-cleared" hidden class="mt-2 text-sm text-text-muted">Cleared “<span id="question-cleared-text"></span>”.</p>

        <native-hstack id="conversation-actions" gap="Sm" class="mt-4 flex-wrap">
            @(Html.NativeButton("add-handoff-btn", "Add the night handoff")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    // The handoff joins the conversation once, and the conversation shows it.
                    var assistant = p.Component<FusionAIAssistView>(AssistantId);
                    assistant.AddPromptResponseModel(nightHandoff, true);
                    assistant.ScrollToBottom();
                    p.Element("add-handoff-btn").Hide();
                }))
            @(Html.NativeButton("ask-nurse-btn", "Ask the charge nurse instead")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    // The question typed for the assistant goes to the charge nurse, and leaves the box.
                    var assistant = p.Component<FusionAIAssistView>(AssistantId);
                    p.Post(Url.SandboxRoute("AskNurse", "AIAssistView"))
                     .Gather<NurseQuestion>(g => g.Set(x => x.Question, assistant.Prompt))
                     .Response(r => r
                         .OnSuccess<AssistantStatus>((sent, s) =>
                         {
                             s.Element("assistant-status").Text.Set(sent.Get(x => x.Summary));
                             assistant.Prompt.Set("");
                         })
                         .OnError<AssistantStatus>(400, (refused, e) =>
                             e.Element("assistant-status").Text.Set(refused.Get(x => x.Summary))));
                }))
        </native-hstack>

        <p id="assistant-status" role="status" class="mt-2 text-sm text-text-secondary"></p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
