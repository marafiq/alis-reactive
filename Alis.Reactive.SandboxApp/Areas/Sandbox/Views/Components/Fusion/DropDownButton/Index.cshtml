@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.DropDownButton
@model FusionDropDownButtonModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Shift Reports";

    const string MenuId = "shift-reports-menu";
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm";

    var plan = Html.ReactivePlan<FusionDropDownButtonModel>();
    var printUrl = Url.SandboxRoute("Print", "DropDownButton");
    var wings = new List<SelectListItem>
    {
        new SelectListItem("Maple", "Maple"),
        new SelectListItem("Cedar", "Cedar")
    };
    var reports = ShiftReports.All
        .Select(report => new { id = report.Id, text = report.Name, disabled = report.AfterMidnightCount })
        .ToArray();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Shift Reports</native-heading>
    <native-text color="Secondary">End of the evening shift. Choose your wing, then print what the night shift needs.</native-text>

    <native-card><native-card-body>
        <native-hstack gap="Base" align="End" class="flex-wrap">
            @{ Html.InputField(plan, m => m.Wing, o => o.Label("Wing"))
                .NativeDropDown(b => b.Items(wings).Placeholder("-- Choose a wing --").CssClass(Field))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    // A disabled button takes no focus: the menu is enabled at once, then given the keyboard.
                    var menu = p.Component<FusionDropDownButton>(MenuId);
                    p.When(args.Value).NotEmpty()
                        .Then(t =>
                        {
                            menu.Disabled.Set(false);
                            menu.DataBind();
                            menu.FocusIn();
                        })
                        .Else(e => menu.Disabled.Set(true));
                }); }

            @(Html.FusionDropDownButton(plan, MenuId, b => b
                .Content("Print report")
                .Disabled(true)
                .Items(reports))
                .Reactive(evt => evt.Select, (args, p) =>
                {
                    var menu = p.Component<FusionDropDownButton>(MenuId);
                    p.Post(printUrl)
                        .Gather<ShiftReportRequest>(g => g
                            .Set(x => x.Wing, p.Component<NativeDropDown>(m => m.Wing).Value)
                            .Set(x => x.Report, args.Item.Get(x => x.Id)))
                        .Response(r => r.OnSuccess<ShiftReportAnswer>((json, s) =>
                        {
                            s.Element("print-status").Text.Set(json.Get(x => x.Message));
                            s.When(json.Get(x => x.Printed)).Truthy()
                                .Then(printed =>
                                {
                                    printed.Element("last-printed-report").Text.Set(args.Item.Get(x => x.Text));
                                    printed.Element("last-printed").Show();
                                    menu.RemoveItems(json.Get(x => x.PrintedReportIds), true);
                                    menu.Content.Set("Print another report");
                                    menu.CssClass.Set("e-success");
                                })
                                .Else(empty =>
                                {
                                    // A report with nothing in it leaves the menu, which opens again for another choice.
                                    menu.RemoveItems(json.Get(x => x.EmptyReportNames), false);
                                    menu.Toggle();
                                });
                        }));
                }))
        </native-hstack>

        <native-vstack gap="Xs" class="mt-4">
            <p id="print-status" class="text-sm font-medium">Nothing printed yet this shift.</p>
            <p id="last-printed" hidden class="text-xs text-text-muted">Last printed: <span id="last-printed-report"></span></p>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
