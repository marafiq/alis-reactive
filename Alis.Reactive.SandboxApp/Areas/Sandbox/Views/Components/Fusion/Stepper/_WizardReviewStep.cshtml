@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Stepper
@model AdmissionReview
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@{
    const string StepsId = "admission-steps";
    const string StatusId = "admission-status";
    const string FormId = "admission-review";

    var plan = Html.ReactivePlan<AdmissionReview>();
}

<native-card><native-card-body id="@FormId">
    <native-heading level="H2">Review</native-heading>
    <native-text color="Secondary">The admission as saved. The coordinator who signs it off submits it.</native-text>

    @Html.HiddenFieldFor(plan, m => m.AdmissionId)

    <dl class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-md border border-border/60 p-4">
            <dt class="text-xs uppercase tracking-wide text-text-muted">Resident</dt>
            <dd id="review-resident" class="text-sm font-semibold">@Model.ResidentName, @Model.AdmissionType</dd>
        </div>
        <div class="rounded-md border border-border/60 p-4">
            <dt class="text-xs uppercase tracking-wide text-text-muted">Care</dt>
            <dd id="review-care" class="text-sm font-semibold">@Model.CareLevel, @Model.PrimaryDiagnosis</dd>
        </div>
        <div class="rounded-md border border-border/60 p-4">
            <dt class="text-xs uppercase tracking-wide text-text-muted">Responsible party</dt>
            <dd id="review-contact" class="text-sm font-semibold">@Model.ResponsibleParty, @Model.Phone</dd>
        </div>
    </dl>

    <div class="mt-4 max-w-sm">
        @{ Html.InputField(plan, m => m.AdmissionCoordinator, o => o.Required().Label("Admission coordinator"))
            .FusionTextBox(b => b.Placeholder("Who signs off the admission")); }
    </div>

    <native-hstack gap="Sm" justify="Between" class="mt-6">
        @(Html.NativeButton("review-back", "Back to Contacts")
            .CssClass("rounded-md border border-border bg-white px-5 py-2 text-sm font-medium hover:bg-surface-muted transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Component<FusionStepper>(StepsId).PreviousStep()))

        @(Html.NativeButton("review-submit", "Submit Admission")
            .CssClass("rounded-md bg-accent px-5 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Post(Url.SandboxRoute("SubmitWizard", "Stepper"))
                    .Gather(g => g.Form())
                    .Validate<AdmissionReviewValidator>(FormId)
                    .Response(r => r
                        .OnSuccess<AdmissionStepSaved>((submitted, s) =>
                            s.Element(StatusId).Text.Set(submitted.Get(x => x.Message)))
                        .OnError(400, e => e.ValidationErrors(FormId)))))
    </native-hstack>
</native-card-body></native-card>

@Html.EJS().ScriptManager()
@Html.RenderPlan(plan)
