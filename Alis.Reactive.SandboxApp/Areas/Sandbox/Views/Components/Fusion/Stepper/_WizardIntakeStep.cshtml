@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Stepper
@model AdmissionIntake
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@{
    const string StepsId = "admission-steps";
    const string StatusId = "admission-status";
    const string FormId = "admission-intake";

    var plan = Html.ReactivePlan<AdmissionIntake>();
    var admissionTypes = new[] { "Respite", "Assisted Living", "Memory Care Evaluation" };
}

<native-card><native-card-body id="@FormId">
    <native-heading level="H2">Intake</native-heading>
    <native-text color="Secondary">Who is moving in, and how.</native-text>

    @Html.HiddenFieldFor(plan, m => m.AdmissionId)

    <native-grid cols="C3" gap="Base" class="mt-4">
        @{ Html.InputField(plan, m => m.ResidentName, o => o.Required().Label("Resident name"))
            .FusionTextBox(b => b.Placeholder("Full name")); }

        @{ Html.InputField(plan, m => m.Age, o => o.Required().Label("Age"))
            .FusionNumericTextBox(b => b.Min(55).Max(120).Step(1).Format("n0")); }

        @{ Html.InputField(plan, m => m.AdmissionType, o => o.Required().Label("Admission type"))
            .FusionDropDownList(b => b.DataSource(admissionTypes).Placeholder("Choose the admission type")); }
    </native-grid>

    <native-hstack gap="Sm" justify="End" class="mt-6">
        @(Html.NativeButton("intake-continue", "Continue to Care")
            .CssClass("rounded-md bg-accent px-5 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Post(Url.SandboxRoute("SaveIntake", "Stepper"))
                    .Gather(g => g.Form())
                    .Validate<AdmissionIntakeValidator>(FormId)
                    .Response(r => r
                        .OnSuccess<AdmissionStepSaved>((saved, s) =>
                        {
                            s.Element(StatusId).Text.Set(saved.Get(x => x.Message));
                            s.Component<FusionStepper>(StepsId).NextStep();
                        })
                        .OnError(400, e => e.ValidationErrors(FormId)))))
    </native-hstack>
</native-card-body></native-card>

@Html.EJS().ScriptManager()
@Html.RenderPlan(plan)
