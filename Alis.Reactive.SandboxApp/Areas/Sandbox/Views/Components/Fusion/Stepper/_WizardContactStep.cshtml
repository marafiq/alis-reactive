@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Stepper
@model AdmissionContacts
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@{
    const string StepsId = "admission-steps";
    const string StatusId = "admission-status";
    const string FormId = "admission-contacts";

    var plan = Html.ReactivePlan<AdmissionContacts>();
}

<native-card><native-card-body id="@FormId">
    <native-heading level="H2">Responsible party</native-heading>
    <native-text color="Secondary">The family member Maple Grove calls first.</native-text>

    @Html.HiddenFieldFor(plan, m => m.AdmissionId)

    <native-grid cols="C3" gap="Base" class="mt-4">
        @{ Html.InputField(plan, m => m.ResponsibleParty, o => o.Required().Label("Responsible party"))
            .FusionTextBox(b => b.Placeholder("Full name")); }

        @{ Html.InputField(plan, m => m.Phone, o => o.Required().Label("Phone"))
            .FusionTextBox(b => b.Placeholder("555-142-0188")); }

        @{ Html.InputField(plan, m => m.Email, o => o.Required().Label("Email"))
            .FusionTextBox(b => b.Placeholder("name@example.com")); }
    </native-grid>

    <native-hstack gap="Sm" justify="Between" class="mt-6">
        @(Html.NativeButton("contacts-back", "Back to Care")
            .CssClass("rounded-md border border-border bg-white px-5 py-2 text-sm font-medium hover:bg-surface-muted transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Component<FusionStepper>(StepsId).PreviousStep()))

        @(Html.NativeButton("contacts-continue", "Continue to Review")
            .CssClass("rounded-md bg-accent px-5 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Post(Url.SandboxRoute("SaveContact", "Stepper"))
                    .Gather(g => g.Form())
                    .Validate<AdmissionContactsValidator>(FormId)
                    .Response(r => r
                        .OnSuccess<AdmissionStepSaved>((saved, s) =>
                        {
                            s.Element(StatusId).Text.Set(saved.Get(x => x.Message));
                            s.Component<FusionStepper>(StepsId).NextStep();
                        })
                        .OnError(400, e => e.ValidationErrors(FormId)))))
    </native-hstack>
</native-card-body></native-card>

@Html.EJS().ScriptManager()
@Html.RenderPlan(plan)
