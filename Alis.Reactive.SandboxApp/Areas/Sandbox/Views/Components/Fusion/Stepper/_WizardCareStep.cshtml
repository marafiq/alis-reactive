@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Stepper
@model AdmissionCare
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@{
    const string StepsId = "admission-steps";
    const string StatusId = "admission-status";
    const string FormId = "admission-care";
    const string MemoryCare = "Memory Care";

    var plan = Html.ReactivePlan<AdmissionCare>();
    var careLevels = new[] { "Assisted Living", MemoryCare, MapleGroveAdmissions.FullCareLevel };
    var diagnoses = new[] { "Alzheimer's", "Parkinson's", "Stroke", "Heart Disease", "Diabetes", "Other" };
}

<native-card><native-card-body id="@FormId">
    <native-heading level="H2">Care plan for @Model.ResidentName</native-heading>
    <native-text color="Secondary">The care the resident moves in with.</native-text>

    @Html.HiddenFieldFor(plan, m => m.AdmissionId)

    <native-grid cols="C3" gap="Base" class="mt-4">
        @{ Html.InputField(plan, m => m.CareLevel, o => o.Required().Label("Care level"))
            .FusionDropDownList(b => b.DataSource(careLevels).Placeholder("Choose the care level"))
            .Reactive(evt => evt.Change, (args, p) =>
                p.When(args.Value).Eq(MemoryCare)
                    .Then(t => t.Element("memory-assessment").Show())
                    .Else(e => e.Element("memory-assessment").Hide())); }

        @{ Html.InputField(plan, m => m.PrimaryDiagnosis, o => o.Required().Label("Primary diagnosis"))
            .FusionDropDownList(b => b.DataSource(diagnoses).Placeholder("Choose the diagnosis")); }

        @{ Html.InputField(plan, m => m.FallRiskScore, o => o.Required().Label("Fall risk score"))
            .FusionNumericTextBox(b => b.Min(0).Max(10).Step(1).Format("n0")); }
    </native-grid>

    <div id="memory-assessment" class="mt-4" hidden="@(Model.CareLevel != MemoryCare)">
        @{ Html.InputField(plan, m => m.MemoryAssessment, o => o.Label("Memory assessment"))
            .FusionTextBox(b => b.Placeholder("Cognitive score and the support the resident needs")); }
    </div>

    <native-hstack gap="Sm" justify="Between" class="mt-6">
        @(Html.NativeButton("care-back", "Back to Intake")
            .CssClass("rounded-md border border-border bg-white px-5 py-2 text-sm font-medium hover:bg-surface-muted transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Component<FusionStepper>(StepsId).PreviousStep()))

        @(Html.NativeButton("care-continue", "Continue to Contacts")
            .CssClass("rounded-md bg-accent px-5 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Post(Url.SandboxRoute("SaveCare", "Stepper"))
                    .Gather(g => g.Form())
                    .Validate<AdmissionCareValidator>(FormId)
                    .Response(r => r
                        .OnSuccess<AdmissionStepSaved>((saved, s) =>
                        {
                            s.Element(StatusId).Text.Set(saved.Get(x => x.Message));
                            s.Component<FusionStepper>(StepsId).NextStep();
                        })
                        .OnError(400, e => e.ValidationErrors(FormId)))))
    </native-hstack>
</native-card-body></native-card>

@Html.EJS().ScriptManager()
@Html.RenderPlan(plan)
