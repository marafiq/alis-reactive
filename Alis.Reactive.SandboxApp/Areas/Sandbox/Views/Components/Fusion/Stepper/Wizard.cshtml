@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Stepper
@model AdmissionWizardModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "New Resident Admission";

    const string StepsId = "admission-steps";
    const string StepId = "admission-step";
    const string StatusId = "admission-status";

    var plan = Html.ReactivePlan<AdmissionWizardModel>();
    var loadStepUrl = Url.SandboxRoute("LoadWizardStep", "Stepper");
    var steps = new List<Step>
    {
        new() { Text = "1", Label = "Intake", Status = StepStatus.InProgress },
        new() { Text = "2", Label = "Care", Status = StepStatus.NotStarted },
        new() { Text = "3", Label = "Contacts", Status = StepStatus.NotStarted },
        new() { Text = "4", Label = "Review", Status = StepStatus.NotStarted }
    };

    // The intake is the first step the server sends.
    Html.On(plan, t => t.DomReady(p =>
        p.Post(loadStepUrl)
            .Gather<AdmissionStepRequest>(g => g.Form(m => m.AdmissionId).Set(x => x.Step, 0))
            .Response(r => r.OnSuccess(s => s.Into(StepId)))));
}

<native-vstack gap="Lg">
    @Html.HiddenFieldFor(plan, m => m.AdmissionId)

    <native-vstack gap="Xs">
        <native-heading level="H1">New Resident Admission</native-heading>
        <native-text color="Secondary">
            Maple Grove admissions. Continue saves each step and opens the next; Back keeps what was saved.
        </native-text>
    </native-vstack>

    <native-card><native-card-body>
        @(Html.FusionStepper(plan, StepsId, b =>
        {
            b.Steps(steps);
            b.ActiveStep(0);
            b.Orientation(StepperOrientation.Horizontal);
            b.LabelPosition(StepLabelPosition.Bottom);
        })
        .Reactive(evt => evt.StepChanging, (args, p) =>
        {
            // A click opens a step the coordinator already passed; a step ahead opens only through
            // Continue, once the server has saved the step before it.
            p.When(args.IsInteracted).Truthy()
                .And(args.ActiveStep).Gte(args.PreviousStep)
                .Then(t =>
                {
                    args.Cancel.Set(true);
                    t.Element(StatusId).Text.Set("Continue saves this step and opens the next one.");
                });
        })
        .Reactive(evt => evt.StepChanged, (args, p) =>
            p.Post(loadStepUrl)
                .Gather<AdmissionStepRequest>(g => g.Form(m => m.AdmissionId).Set(x => x.Step, args.ActiveStep))
                .Response(r => r.OnSuccess(s => s.Into(StepId)))))

        <p id="@StatusId" class="mt-6 text-sm font-medium" role="status">Start with the resident's intake.</p>
    </native-card-body></native-card>

    <div id="@StepId">
        <p class="text-sm text-text-muted">Loading the intake...</p>
    </div>
</native-vstack>

@Html.RenderPlan(plan)
