@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Stepper
@model FusionStepperModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "Move-in Checklist";

    const string ChecklistId = "move-in-steps";
    const string AdmissionStepsId = "admission-steps";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";

    var plan = Html.ReactivePlan<FusionStepperModel>();
    var checklist = new List<Step>
    {
        new() { Text = "1", Label = "Paperwork", Status = StepStatus.InProgress },
        new() { Text = "2", Label = "Room ready", Status = StepStatus.NotStarted },
        new() { Text = "3", Label = "Moved in", Status = StepStatus.NotStarted }
    };
    var admissionSteps = new List<Step>
    {
        new() { Text = "1", Label = "Intake", Status = StepStatus.InProgress, IsValid = true, Optional = true },
        new() { Text = "2", Label = "Review", Status = StepStatus.NotStarted, IsValid = false },
        new() { Text = "3", Label = "Complete", Status = StepStatus.NotStarted }
    };

    // A checklist step's name, by its index.
    void ShowStepName(PipelineBuilder<FusionStepperModel> p, TypedSource<int> step, string elementId) =>
        p.When(step).Eq(0).Then(t => t.Element(elementId).Text.Set("Paperwork"))
            .ElseIf(step).Eq(1).Then(t => t.Element(elementId).Text.Set("Room ready"))
            .Else(e => e.Element(elementId).Text.Set("Moved in"));

    // What the coordinator does on each step.
    void ShowInstruction(PipelineBuilder<FusionStepperModel> p, TypedSource<int> step) =>
        p.When(step).Eq(0).Then(t => t.Element("checklist-instruction").Text.Set("Collect the signed residency agreement and the physician's report."))
            .ElseIf(step).Eq(1).Then(t => t.Element("checklist-instruction").Text.Set("Walk the room with maintenance and sign the inspection."))
            .Else(e => e.Element("checklist-instruction").Text.Set("Welcome the resident and hand over the room key."));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Move-in Checklist</native-heading>
    <native-text color="Secondary">Margaret Hale moves into Maple 214. Work through the checklist in order.</native-text>
    <native-hstack gap="Sm" class="flex-wrap">
        <a asp-area="Sandbox" asp-controller="Stepper" asp-action="Wizard"
           class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors">
            Open lazy admission wizard
        </a>
    </native-hstack>

    <native-card><native-card-body>
        @(Html.FusionStepper(plan, ChecklistId, b =>
        {
            b.Steps(checklist);
            b.ActiveStep(0);
            b.Orientation(StepperOrientation.Horizontal);
            b.LabelPosition(StepLabelPosition.Bottom);
        })
        .Reactive(evt => evt.StepChanging, (args, p) =>
        {
            // The resident moves in only into a room whose inspection is signed.
            var inspection = p.Component<NativeCheckBox>(m => m.RoomInspectionSigned);
            p.When(args.ActiveStep).Eq(2).And(inspection.Checked).Falsy()
                .Then(t =>
                {
                    args.Cancel.Set(true);
                    t.Element("checklist-warning").Show();
                })
                .Else(e => e.Element("checklist-warning").Hide());
        })
        .Reactive(evt => evt.StepClick, (args, p) =>
        {
            ShowStepName(p, args.ActiveStep, "checklist-clicked-step");
            ShowStepName(p, args.PreviousStep, "checklist-clicked-from");
            p.Element("checklist-clicked").Show();
        })
        .Reactive(evt => evt.StepChanged, (args, p) =>
        {
            p.When(args.IsInteracted).Truthy().Then(t => t.Element("checklist-move").Text.Set("Opened"))
                .ElseIf(args.ActiveStep).Lt(args.PreviousStep).Then(t => t.Element("checklist-move").Text.Set("Back to"))
                .Else(e => e.Element("checklist-move").Text.Set("Moved on to"));
            ShowStepName(p, args.ActiveStep, "checklist-step");
            ShowInstruction(p, args.ActiveStep);
        }))

        <native-vstack gap="Sm" class="mt-6">
            <p id="checklist-status" class="text-sm font-medium"><span id="checklist-move">Started on</span> <span id="checklist-step">Paperwork</span>.</p>
            <p id="checklist-instruction" class="text-sm">Collect the signed residency agreement and the physician's report.</p>
            @{ Html.InputField(plan, m => m.RoomInspectionSigned, o => o.Label("Room inspection signed"))
                .NativeCheckBox(b => b.CssClass("rounded border-border")); }
            <p id="checklist-warning" hidden class="text-sm text-red-700">Sign the room inspection before the resident moves in.</p>
            <p id="checklist-done" hidden class="text-sm text-green-700">The move-in checklist is complete.</p>
            <p id="checklist-clicked" hidden class="text-xs text-text-muted">
                Clicked <span id="checklist-clicked-step"></span> while on <span id="checklist-clicked-from"></span>.
            </p>
        </native-vstack>

        <native-hstack gap="Sm" class="mt-4 flex-wrap">
            @(Html.NativeButton("checklist-back-btn", "Back")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Component<FusionStepper>(ChecklistId).PreviousStep();
                    p.Element("checklist-done").Hide();
                }))
            @(Html.NativeButton("checklist-next-btn", "Next")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var steps = p.Component<FusionStepper>(ChecklistId);
                    p.When(steps.ActiveStep).Eq(2)
                        .Then(done => done.Element("checklist-done").Show())
                        .Else(next => next.Component<FusionStepper>(ChecklistId).NextStep());
                }))
            @(Html.NativeButton("checklist-review-paperwork-btn", "Review Paperwork")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Component<FusionStepper>(ChecklistId).ActiveStep.Set(0);
                    p.Element("checklist-done").Hide();
                }))
            @(Html.NativeButton("checklist-start-over-btn", "Start Over")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Component<FusionStepper>(ChecklistId).Reset();
                    p.Component<NativeCheckBox>(m => m.RoomInspectionSigned).Checked.Set(false);
                    p.Element("checklist-done").Hide();
                    p.Element("checklist-warning").Hide();
                }))
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Admission steps</native-heading>
        <p class="text-sm text-text-secondary mb-4">
            Intake is done and optional to revisit; Review needs attention. Steps open in order.
        </p>

        @(Html.FusionStepper(plan, AdmissionStepsId, b =>
        {
            b.Steps(admissionSteps);
            b.ActiveStep(0);
            b.Linear(true);
            b.ShowTooltip(true);
            b.Orientation(StepperOrientation.Horizontal);
            b.LabelPosition(StepLabelPosition.Bottom);
        })
        .Reactive(evt => evt.StepChanged, (args, p) =>
        {
            p.When(args.ActiveStep).Eq(0).Then(t => t.Element("admission-step-open").Text.Set("Intake"))
                .ElseIf(args.ActiveStep).Eq(1).Then(t => t.Element("admission-step-open").Text.Set("Review"))
                .Else(e => e.Element("admission-step-open").Text.Set("Complete"));
        }))

        <p class="mt-4 text-sm">Open: <span id="admission-step-open" class="font-medium">Intake</span></p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
