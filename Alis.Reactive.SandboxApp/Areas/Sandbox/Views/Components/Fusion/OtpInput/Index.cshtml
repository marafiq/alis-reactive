@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.OtpInput
@model OtpInputModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.Inputs
@{
    ViewData["Title"] = "Visitor Check-in";

    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string AskForTheCode = "Ask the visitor to read the code from their text message.";
    const string NoVisitorYet = "No visitor checked in yet.";

    var plan = Html.ReactivePlan<OtpInputModel>();
    var checkUrl = Url.SandboxRoute("Check", "OtpInput");

    // Says something about one digit of the code, named by its field's place.
    void SayDigit(PipelineBuilder<OtpInputModel> p, TypedSource<int> index, Func<string, string> sentence) =>
        p.When(index).Eq(0).Then(t => t.Element("code-hint").Text.Set(sentence("first")))
            .ElseIf(index).Eq(1).Then(t => t.Element("code-hint").Text.Set(sentence("second")))
            .ElseIf(index).Eq(2).Then(t => t.Element("code-hint").Text.Set(sentence("third")))
            .Else(e => e.Element("code-hint").Text.Set(sentence("fourth")));

    // The desk can type the code as soon as the page opens.
    Html.On(plan, t => t.DomReady(p => p.Component<FusionOtpInput>(m => m.VisitCode).FocusIn()));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Visitor Check-in</native-heading>
    <native-text color="Secondary">Maple Grove front desk. Each visitor who booked has a 4-digit code in the text we sent them.</native-text>

    <native-card><native-card-body>
        <native-vstack gap="Sm">
            @{ Html.InputField(plan, m => m.VisitCode, o => o.Label("Visit code"))
                .FusionOtpInput(b => b
                    .Length(4)
                    .Type(OtpInputType.Text))
                .Reactive(evt => evt.Input, (args, p) =>
                {
                    p.When(args.Value).IsEmpty().Then(t => t.Element("code-hint").Text.Set(AskForTheCode))
                        .ElseIf(args.PreviousValue).MinLength(4).Then(t => t.Element("code-hint").Text.Set("Code corrected."))
                        .Else(e => SayDigit(e, args.Index, digit => $"The {digit} digit is in."));
                })
                .Reactive(evt => evt.ValueChanged, (args, p) =>
                {
                    // Only a code the desk typed is checked; a code the page writes is not a visitor's.
                    var code = p.Component<FusionOtpInput>(m => m.VisitCode);
                    p.When(args.IsInteracted).Truthy().And(args.Value).Matches("^[0-9]{4}$")
                        .Then(t =>
                        {
                            code.FocusOut();
                            t.Element("visit-status").Text.Set("Checking the code.");
                            t.Post(checkUrl)
                                .Gather<VisitCodeCheck>(g => g
                                    .Set(x => x.Code, code.Value)
                                    .Set(x => x.PreviousCode, args.PreviousValue))
                                .Response(r => r.OnSuccess<VisitCodeChecked>((json, s) =>
                                    s.Element("visit-status").Text.Set(json.Get(x => x.Message))));
                        })
                        .ElseIf(args.IsInteracted).Truthy()
                        .Then(t => t.Element("visit-status").Text.Set("Visit codes are digits only."));
                })
                .Reactive(evt => evt.Focus, (args, p) =>
                {
                    // The desk clicked into a full code to fix one digit.
                    p.When(args.IsInteracted).Truthy().And(args.Value).MinLength(4)
                        .Then(t => SayDigit(t, args.Index, digit => $"Correcting the {digit} digit."));
                })
                .Reactive(evt => evt.Blur, (args, p) =>
                {
                    // The desk left the fields: a full code needs no correcting; a half-typed one says where it stopped.
                    p.When(args.IsInteracted).Truthy().And(args.Value).MinLength(4)
                        .Then(t => t.Element("code-hint").Text.Set(AskForTheCode))
                        .ElseIf(args.IsInteracted).Truthy().And(args.Value).NotEmpty()
                        .Then(t => SayDigit(t, args.Index, digit => $"The code is unfinished; you stopped at the {digit} digit."));
                }); }
            <p id="code-hint" class="text-sm text-text-secondary">@AskForTheCode</p>
            <p id="visit-status" class="text-sm font-medium">@NoVisitorYet</p>
        </native-vstack>

        <native-hstack gap="Sm" class="mt-4 flex-wrap">
            @(Html.NativeButton("issue-walk-in-code-btn", "Issue walk-in code")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var code = p.Component<FusionOtpInput>(m => m.VisitCode);
                    p.Post(Url.SandboxRoute("WalkIn", "OtpInput"))
                        .Response(r => r.OnSuccess<WalkInCodeIssued>((json, s) =>
                        {
                            // Said before the code is shown: its own change, focus and blur events leave these lines alone.
                            s.Element("visit-status").Text.Set("Walk-in code issued. It opens the front door today only.");
                            s.Element("code-hint").Text.Set("Read the code to the visitor.");
                            // Showing a code moves focus into the fields; apply it now so FocusOut lets go of them.
                            code.Value.Set(json.Get(x => x.Code));
                            code.DataBind();
                            code.FocusOut();
                        }));
                }))
            @(Html.NativeButton("next-visitor-btn", "Next visitor")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Component<FusionOtpInput>(m => m.VisitCode).Value.Set("");
                    p.Element("visit-status").Text.Set(NoVisitorYet);
                    p.Element("code-hint").Text.Set(AskForTheCode);
                }))
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
