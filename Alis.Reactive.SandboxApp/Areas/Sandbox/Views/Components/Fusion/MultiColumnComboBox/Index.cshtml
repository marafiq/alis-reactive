@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.MultiColumnComboBox
@model FusionMultiColumnComboBoxModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Shift Coverage";

    const string FormId = "coverage-form";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string PrimaryButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string SelectCss = "rounded-md border border-border px-3 py-1.5 text-sm";

    var plan = Html.ReactivePlan<FusionMultiColumnComboBoxModel>();
    var openShifts = Model.OpenShifts.Select(shift => new SelectListItem(shift.Label, shift.Code)).ToList();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Shift Coverage</native-heading>
    <native-text color="Secondary">Maple Grove nursing, week of October 19. Choose an open shift, then the nurse who covers it.</native-text>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="flex-wrap items-center">
            <p class="text-sm">Text from Priya Raman, 17:42: "I'm sick and can't make tonight's Willow shift. Grace Kim said she could swap with me."</p>
            @(Html.NativeButton("choose-grace-kim-btn", "Choose Grace Kim")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Component<FusionMultiColumnComboBox>(m => m.CoveringNurse).Text.Set("Grace Kim")))
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.OpenShift, o => o.Required().Label("Open shift"))
                .NativeDropDown(b => b.Items(openShifts).Placeholder("-- Choose an open shift --").CssClass(SelectCss))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    var nurse = p.Component<FusionMultiColumnComboBox>(m => m.CoveringNurse);
                    p.Element("shift-covered").Hide();
                    p.Element("volunteer-note").Hide();
                    p.Element("nobody-yet").Hide();
                    p.When(args.Value).NotEmpty().Then(chosen =>
                    {
                        // The nurse list opens at once, while the staffing line says how the shift stands.
                        nurse.ShowPopup();
                        chosen.Get(Url.SandboxRoute("ShiftStatus", "MultiColumnComboBox"))
                            .Gather<ShiftStatusQuery>(g => g.Set(x => x.Shift, args.Value))
                            .Response(r => r.OnSuccess<ShiftStanding>((standing, s) =>
                                s.When(standing.Get(x => x.CoveredBy)).NotEmpty()
                                    .Then(covered =>
                                    {
                                        // Nobody is needed: the nurse list closes and lets go of the cursor.
                                        covered.Element("covered-by").Text.Set(standing.Get(x => x.CoveredBy));
                                        covered.Element("shift-covered").Show();
                                        nurse.FocusOut();
                                    })
                                    .ElseIf(standing.Get(x => x.Volunteer)).NotEmpty()
                                    .Then(volunteered =>
                                    {
                                        // The nurse who volunteered is filled in and named as the nurse list names her.
                                        nurse.Value.Set(standing.Get(x => x.Volunteer));
                                        nurse.DataBind();
                                        volunteered.Element("volunteer-name").Text.Set(nurse.Text);
                                        volunteered.Element("volunteer-note").Show();
                                    })
                                    .Else(open => open.Element("nobody-yet").Show())));
                    });
                }); }
            <p id="shift-covered" hidden class="text-sm"><span id="covered-by" class="font-medium"></span> already covers this shift.</p>

            @{ Html.InputField(plan, m => m.IncludeAgency, o => o.Label("Include agency nurses"))
                .NativeCheckBox(b => b.CssClass("rounded border-border"))
                .Reactive(evt => evt.Change, (_, p) =>
                    p.Get(Url.SandboxRoute("Roster", "MultiColumnComboBox"))
                        .Gather<RosterQuery>(g => g.Set(x => x.IncludeAgency, p.Component<NativeCheckBox>(m => m.IncludeAgency).Checked))
                        .Response(r => r.OnSuccess<CoverageRoster>((roster, s) =>
                        {
                            // The nurse list takes the new roster, and the cursor moves to it, ready for a name.
                            var nurse = s.Component<FusionMultiColumnComboBox>(m => m.CoveringNurse);
                            nurse.Rows<RosterNurse>().Set(roster.Get(x => x.Nurses));
                            nurse.FocusIn();
                        }))); }

            @{ Html.InputField(plan, m => m.CoveringNurse, o => o.Required().Label("Covering nurse"))
                .FusionMultiColumnComboBox(b => b
                    .DataSource(Model.Roster)
                    .Fields<RosterNurse>(n => n.Name, n => n.Id, n => n.Employer)
                    .Columns(col =>
                    {
                        col.Field(Field.Of((RosterNurse n) => n.Name).Name).Header("Name").Width("140").Add();
                        col.Field(Field.Of((RosterNurse n) => n.HomeWing).Name).Header("Home wing").Width("110").Add();
                        col.Field(Field.Of((RosterNurse n) => n.Shift).Name).Header("Shift").Width("100").Add();
                        col.Field(Field.Of((RosterNurse n) => n.Certifications).Name).Header("Certifications").Width("180").Add();
                        // The list groups its nurses by employer, and a grid groups only by one of its columns.
                        col.Field(Field.Of((RosterNurse n) => n.Employer).Name).Header("Employer").Width("140").Add();
                    })
                    .Placeholder("Choose the covering nurse")
                    .PopupWidth("560"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    var nurse = p.Component<FusionMultiColumnComboBox>(m => m.CoveringNurse);
                    // A nurse the page fills in closes the list; one the coordinator picks has closed it already.
                    nurse.HidePopup();
                    p.When(args.Value).IsEmpty()
                        .Then(none =>
                        {
                            none.Element("call-to-confirm").Hide();
                            none.Element("nurse-week").Hide();
                        })
                        .Else(chosen =>
                        {
                            // A nurse the coordinator picks has not said yes yet; one the page fills in has.
                            chosen.When(args.IsInteracted).Truthy()
                                .Then(picked =>
                                {
                                    picked.Element("confirm-nurse").Text.Set(nurse.Text);
                                    picked.Element("call-to-confirm").Show();
                                    picked.Element("volunteer-note").Hide();
                                })
                                .Else(filled => filled.Element("call-to-confirm").Hide());
                            chosen.Get(Url.SandboxRoute("Hours", "MultiColumnComboBox"))
                                .Gather<NurseHoursQuery>(g => g.Set(x => x.Nurse, args.Value))
                                .Response(r => r.OnSuccess<NurseWeek>((week, s) =>
                                {
                                    s.Element("nurse-week").Text.Set(week.Get(x => x.Summary));
                                    s.Element("nurse-week").Show();
                                }));
                        });
                }); }
            <p id="volunteer-note" hidden class="text-sm"><span id="volunteer-name" class="font-medium"></span> volunteered by text for this shift.</p>
            <p id="nobody-yet" hidden class="text-sm text-amber-700">Nobody has volunteered for this shift yet. Choose a nurse from the list.</p>
            <p id="call-to-confirm" hidden class="text-sm text-amber-700">Call <span id="confirm-nurse" class="font-medium"></span> to confirm before assigning the shift.</p>
            <p id="nurse-week" hidden class="text-sm text-text-muted"></p>
        </native-vstack>
    </native-card-body></native-card>

    <native-hstack gap="Sm" align="Center" class="flex-wrap">
        @(Html.NativeButton("assign-coverage-btn", "Assign Coverage")
            .CssClass(PrimaryButton)
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Post(Url.SandboxRoute("Assign", "MultiColumnComboBox"))
                    .Gather(g => g.Form())
                    .Validate<ShiftCoverageValidator>(FormId)
                    .Response(r => r
                        .OnSuccess<CoverageConfirmation>((assigned, s) => s.Element("coverage-status").Text.Set(assigned.Get(x => x.Message)))
                        .OnError<CoverageConfirmation>(400, (refused, e) => e.Element("coverage-status").Text.Set(refused.Get(x => x.Message))))))
        <p id="coverage-status" class="text-sm">No shift assigned yet.</p>
    </native-hstack>
</native-vstack>

@Html.RenderPlan(plan)
