@model DateTimePickerModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Cardiology Follow-up";

    const string ButtonPrimary = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";

    var plan = Html.ReactivePlan<DateTimePickerModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Cardiology Follow-up</native-heading>
        <native-text color="Secondary">
            Arthur Bell, Maple 202, came home from Mercy General on Friday, November 6. Dr. Osei wants to see him
            between Monday, November 9 and Friday, November 20. Her clinic sees residents on weekdays from
            9:00 AM to 4:00 PM.
        </native-text>
    </div>

    <native-card><native-card-body>
        <div id="follow-up-form">
            @{ Html.InputField(plan, m => m.FollowUpAppointment, o => o.Required().Label("Appointment"))
                .FusionDateTimePicker(b => b.Placeholder("Choose the day and time"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    p.When(args.IsInteracted).Truthy()
                        .Then(chosen => chosen.Element("appointment-source").Text.Set("You chose this time; the clinic confirms it when you schedule."))
                        .Else(offered => offered.Element("appointment-source").Text.Set("Dr. Osei's office is holding this time for Arthur."));

                    p.When(args.Value).NotNull()
                        .Then(picked => picked.Get(Url.SandboxRoute("ClinicHours", "DateTimePicker"))
                            .Gather<ClinicHoursQuery>(g => g.Set(x => x.Visit, args.Value))
                            .Response(r => r.OnSuccess<ClinicHoursAnswer>((clinic, s) =>
                            {
                                // Picking the day, then the time, asks twice; only the answer about the time now
                                // in the field is shown.
                                var appointment = s.Component<FusionDateTimePicker>(m => m.FollowUpAppointment);
                                s.When(clinic.Get(x => x.Visit)).Eq(appointment.Value)
                                    .Then(current =>
                                    {
                                        current.Element("clinic-answer").Text.Set(clinic.Get(x => x.Answer));

                                        // A time Dr. Osei is in clinic, inside the follow-up window, is settled, so
                                        // the keyboard goes away. Any other time keeps the cursor in the field.
                                        current.When(clinic.Get(x => x.InClinic)).Truthy()
                                            .And(appointment.Value).Gte(DateTimePickerModel.FirstOpening)
                                            .And(appointment.Value).Lt(DateTimePickerModel.WindowCloses)
                                            .Then(settled => settled.Component<FusionDateTimePicker>(m => m.FollowUpAppointment).FocusOut());
                                    });
                            })));
                }); }
            <p id="appointment-source" class="mt-1 text-xs text-text-muted">Dr. Osei's office is holding Thursday, November 12 at 2:00 PM.</p>
            <p id="clinic-answer" class="text-sm"></p>
        </div>

        <native-hstack gap="Sm" align="Center" class="mt-4 flex-wrap">
            @(Html.NativeButton("take-offered-time-btn", "Take the Held Time")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Component<FusionDateTimePicker>(m => m.FollowUpAppointment).Value.Set(DateTimePickerModel.OfferedTime)))
            @(Html.NativeButton("schedule-follow-up-btn", "Schedule Follow-up")
                .CssClass(ButtonPrimary)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Post(Url.SandboxRoute("ScheduleFollowUp", "DateTimePicker"))
                        .Gather(g => g.Form())
                        .Validate<FollowUpAppointmentValidator>("follow-up-form")
                        .Response(r => r
                            .OnSuccess<FollowUpBooked>((booked, s) =>
                                s.Element("follow-up-status").Text.Set(booked.Get(x => x.Confirmation)))
                            .OnError(400, e =>
                            {
                                // The clinic refused the time: the cursor goes back to it.
                                e.ValidationErrors("follow-up-form");
                                e.Component<FusionDateTimePicker>(m => m.FollowUpAppointment).FocusIn();
                            }))))
            <p id="follow-up-status" class="text-sm text-text-muted">Not scheduled yet.</p>
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
