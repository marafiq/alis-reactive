@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.ListBox
@model FusionListBoxModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.DropDowns
@{
    ViewData["Title"] = "Outing Groups";

    const string BusId = "morning-bus";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";

    var plan = Html.ReactivePlan<FusionListBoxModel>();
    var saveUrl = Url.SandboxRoute("SaveGroups", "ListBox");
    var idField = Alis.Reactive.Field.Of((OutingResident r) => r.Id).Name;
    var nameField = Alis.Reactive.Field.Of((OutingResident r) => r.Name).Name;
    var appointments = OutingDay.MorningAppointments.ToArray();
    var appointmentNames = string.Join(" and ", OutingDay.SignedUp.Where(r => appointments.Contains(r.Id)).Select(r => r.Name));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Outing Groups</native-heading>
    <native-text color="Secondary">
        Thursday, October 16: Tower Hill Botanic Garden. Choose who rides the morning bus; everyone else rides in the
        afternoon. The morning bus seats @OutingDay.MorningSeats and carries the wheelchair lift. Hold Ctrl or Command to
        choose more than one resident.
    </native-text>

    <native-card><native-card-body>
        <native-heading level="H2">Morning bus</native-heading>

        @(Html.FusionListBox(plan, BusId, b => b
            .DataSource(OutingDay.SignedUp)
            .Fields(new ListBoxFieldSettings { Text = nameField, Value = idField })
            .Height("360px"))
            .Reactive(evt => evt.Change, (args, p) =>
            {
                var riders = p.From(args.Value).Count();
                p.Element("morning-seats-taken").Text.Set(riders);
                p.When(riders).Gt(OutingDay.MorningSeats)
                    .Then(t => t.Element("morning-bus-full").Show())
                    .Else(e => e.Element("morning-bus-full").Hide());
            }))

        <p id="morning-seats" class="mt-3 text-sm"><span id="morning-seats-taken" class="font-medium">0</span> of @OutingDay.MorningSeats seats taken.</p>
        <p id="morning-bus-full" hidden class="text-sm text-red-700">The morning bus seats @(OutingDay.MorningSeats). Move someone to the afternoon bus.</p>

        <native-hstack gap="Sm" class="mt-3 flex-wrap">
            @(Html.NativeButton("last-week-btn", "Use last week's groups")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    // Last week's riders are applied at once, so the lift riders join them rather than replace them.
                    var bus = p.Component<FusionListBox>(BusId);
                    bus.Value.Set(OutingDay.LastWeekMorning.ToArray());
                    bus.DataBind();
                    // The wheelchair lift is on the morning bus only.
                    bus.SelectItems(OutingDay.LiftRiders.ToArray(), true, true);
                }))
            @(Html.NativeButton("select-everyone-btn", "Select everyone")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionListBox>(BusId).SelectAll(true)))
            @(Html.NativeButton("clear-morning-bus-btn", "Clear the morning bus")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionListBox>(BusId).SelectAll(false)))
        </native-hstack>

        <native-vstack gap="Xs" class="mt-4">
            @{ Html.InputField(plan, m => m.MorningAppointmentsRideLater, o => o.Label("Residents with a morning appointment ride in the afternoon"))
                .NativeCheckBox(b => b.CssClass("rounded border-border"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    p.When(args.Checked).Truthy()
                        .Then(t =>
                        {
                            var bus = t.Component<FusionListBox>(BusId);
                            bus.SelectItems(appointments, false, true);
                            bus.EnableItems(appointments, false, true);
                            t.Element("appointments-note").Show();
                        })
                        .Else(e =>
                        {
                            e.Component<FusionListBox>(BusId).EnableItems(appointments, true, true);
                            e.Element("appointments-note").Hide();
                        });
                }); }
            <p id="appointments-note" hidden class="text-sm text-text-muted">@appointmentNames ride in the afternoon.</p>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-hstack gap="Sm" align="Center">
            @(Html.NativeButton("save-groups-btn", "Save groups")
                .CssClass("rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90")
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var bus = p.Component<FusionListBox>(BusId);
                    p.When(bus.Value).NotEmpty()
                        .Then(t => t.Post(saveUrl)
                            .Gather<OutingGroupsRequest>(g => g.Set(x => x.Morning, bus.Value))
                            .Response(r => r.OnSuccess<OutingGroupsSaved>((json, s) =>
                                s.Element("groups-status").Text.Set(json.Get(x => x.Message)))))
                        .Else(e => e.Element("groups-status").Text.Set("Choose who rides the morning bus before saving."));
                }))
            <p id="groups-status" class="text-sm text-text-muted">Not saved yet.</p>
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
