@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.DropDownList
@model FusionDropDownListModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Admission Placement";

    const string FormId = "placement-form";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string PrimaryButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<FusionDropDownListModel>();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Admission Placement</native-heading>
    <native-text color="Secondary">Eleanor Whitfield moves in on Monday, October 20. Choose the care level she needs, then the wing she moves into.</native-text>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="flex-wrap items-center">
            <p class="text-sm">St. Mary's Hospital referral, October 9: the discharge team recommends Memory Care.</p>
            @(Html.NativeButton("use-referral-btn", "Use the Referral's Care Level")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                    p.Component<FusionDropDownList>(m => m.CareLevel).Text.Set("Memory Care")))
        </native-hstack>
    </native-card-body></native-card>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.CareLevel, o => o.Required().Label("Care level"))
                .FusionDropDownList(b => b
                    .DataSource(Model.CareLevels)
                    .Fields<CareLevelOption>(c => c.Name, c => c.Code)
                    .Placeholder("Choose a care level")
                    .ShowClearButton(true))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    var careLevel = p.Component<FusionDropDownList>(m => m.CareLevel);
                    var wing = p.Component<FusionDropDownList>(m => m.Wing);
                    // A care level the referral filled in says where it came from; one the coordinator chose does not.
                    p.When(args.IsInteracted).Truthy()
                        .Then(byHand => byHand.Element("referral-note").Hide())
                        .Else(fromReferral => fromReferral.Element("referral-note").Show());
                    p.Element("open-room").Hide();
                    p.Element("no-open-room").Hide();
                    p.When(args.Value).IsEmpty()
                        .Then(cleared =>
                        {
                            // The clear button empties the care level and leaves its list open; the page closes
                            // the list, and the wings of the old care level go with it.
                            careLevel.HidePopup();
                            wing.DataSource.Set(Array.Empty<PlacementWing>());
                        })
                        .Else(chosen =>
                        {
                            chosen.Element("care-level-hint").Hide();
                            chosen.Get(Url.SandboxRoute("Wings", "DropDownList"))
                                .Gather<WingListQuery>(g => g.Set(x => x.CareLevel, args.Value))
                                .Response(r => r.OnSuccess<WingList>((offered, s) =>
                                {
                                    wing.DataSource.Set(offered.Get(x => x.Wings));
                                    s.When(offered.Get(x => x.OpenRoomWing)).NotEmpty()
                                        .Then(open =>
                                        {
                                            // The wing with the open room is filled in, named as the wing list names it.
                                            wing.Value.Set(offered.Get(x => x.OpenRoomWing));
                                            wing.DataBind();
                                            open.Element("open-room-wing").Text.Set(wing.Text);
                                            open.Element("open-room").Show();
                                        })
                                        .Else(waitlist =>
                                        {
                                            // No wing has a room: the coordinator chooses the wing to wait for.
                                            waitlist.Element("no-open-room").Show();
                                            wing.FocusIn();
                                        });
                                }));
                        });
                })
                .Reactive(evt => evt.Blur, (_, p) =>
                    p.When(p.Component<FusionDropDownList>(m => m.CareLevel).Value).IsEmpty()
                        .Then(none => none.Element("care-level-hint").Show())
                        .Else(chosen => chosen.Element("care-level-hint").Hide())); }
            <p id="care-level-hint" hidden class="text-sm text-text-muted">Choose a care level to see the wings that offer it.</p>
            <p id="referral-note" hidden class="text-sm text-text-muted">Care level taken from the St. Mary's referral.</p>

            @{ Html.InputField(plan, m => m.Wing, o => o.Required().Label("Wing"))
                .FusionDropDownList(b => b
                    .Fields<PlacementWing>(w => w.Name, w => w.Code, w => w.Building)
                    .Placeholder("Choose a wing")
                    .ShowClearButton(true))
                .Reactive(evt => evt.Focus, (_, p) =>
                {
                    // Entering the wing opens its list once a care level has filled it.
                    p.When(p.Component<FusionDropDownList>(m => m.CareLevel).Value).NotEmpty()
                        .Then(listed => listed.Component<FusionDropDownList>(m => m.Wing).ShowPopup());
                })
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    var wing = p.Component<FusionDropDownList>(m => m.Wing);
                    p.When(args.Value).IsEmpty()
                        .Then(none => none.Element("placement").Hide())
                        .Else(chosen =>
                        {
                            chosen.Element("placement-care-level").Text.Set(p.Component<FusionDropDownList>(m => m.CareLevel).Text);
                            chosen.Element("placement-wing").Text.Set(wing.Text);
                            chosen.Element("placement").Show();
                        });
                    // The clear button empties the wing and leaves its list open; the page closes the list and
                    // ends the edit.
                    p.When(args.Value).IsEmpty().And(args.IsInteracted).Truthy()
                        .Then(cleared => wing.FocusOut());
                }); }
            <p id="open-room" hidden class="text-sm">A room is open this week in <span id="open-room-wing" class="font-medium"></span>.</p>
            <p id="no-open-room" hidden class="text-sm text-amber-700">No wing has a room open this week for this care level. Choose the wing to wait for.</p>
            <p id="placement" hidden class="text-sm">Eleanor Whitfield: <span id="placement-care-level" class="font-medium"></span>, <span id="placement-wing" class="font-medium"></span> wing.</p>
        </native-vstack>
    </native-card-body></native-card>

    <native-hstack gap="Sm" align="Center" class="flex-wrap">
        @(Html.NativeButton("admit-btn", "Admit Eleanor Whitfield")
            .CssClass(PrimaryButton)
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Post(Url.SandboxRoute("Admit", "DropDownList"))
                    .Gather(g => g.Form())
                    .Validate<AdmissionPlacementValidator>(FormId)
                    .Response(r => r
                        .OnSuccess<PlacementConfirmation>((placed, s) => s.Element("admission-status").Text.Set(placed.Get(x => x.Message)))
                        .OnError<PlacementConfirmation>(400, (refused, e) => e.Element("admission-status").Text.Set(refused.Get(x => x.Message))))))
        <p id="admission-status" class="text-sm">Eleanor Whitfield is not placed yet.</p>
    </native-hstack>
</native-vstack>

@Html.RenderPlan(plan)
