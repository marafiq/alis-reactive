@model FusionCheckBoxModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionCheckBox";

    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string SubmitReady = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<FusionCheckBoxModel>();

    // The optional services start locked until the resident accepts the agreement.
    Html.On(plan, t => t.DomReady(p =>
    {
        var housekeeping = p.Component<FusionCheckBox>(m => m.WeeklyHousekeeping);
        housekeeping.SetDisabled(true);
        p.When(housekeeping.Disabled()).Truthy()
            .Then(locked => locked.Element("housekeeping-status")
                .SetText("Locked until you accept the residency agreement."))
            .Else(open => open.Element("housekeeping-status")
                .SetText("You can add weekly housekeeping to your move-in services."));
    }));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Move-In Services Agreement</native-heading>
        <native-text color="Secondary">
            Welcome. Accept your residency agreement to unlock the optional services, then choose the ones you would like for move-in.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Residency agreement</native-heading>
            @{ Html.InputField(plan, m => m.AgreementAccepted, o => o.Label("Residency agreement"))
                .FusionCheckBox(b => b
                    .Label("I accept the Residency Agreement")
                    .Reactive(plan, evt => evt.Changed, (args, p) =>
                    {
                        var housekeeping = p.Component<FusionCheckBox>(m => m.WeeklyHousekeeping);

                        p.When(args, x => x.Checked).Truthy()
                            .Then(accepted =>
                            {
                                accepted.Element("agreement-status")
                                    .SetText("Thank you. Your residency agreement is accepted.");
                                var housekeepingNow = accepted.Component<FusionCheckBox>(m => m.WeeklyHousekeeping);
                                housekeepingNow.SetDisabled(false);
                                accepted.When(housekeepingNow.Disabled()).Falsy()
                                    .Then(open => open.Element("housekeeping-status")
                                        .SetText("You can now add weekly housekeeping to your move-in services."))
                                    .Else(stillLocked => stillLocked.Element("housekeeping-status")
                                        .SetText("Weekly housekeeping is still locked."));
                            })
                            .Else(declined =>
                            {
                                declined.Element("agreement-status")
                                    .SetText("Please accept the residency agreement to continue.");
                                declined.Component<FusionCheckBox>(m => m.WeeklyHousekeeping).SetDisabled(true);
                                declined.Element("housekeeping-status")
                                    .SetText("Locked until you accept the residency agreement.");
                            });
                    })); }
            <native-text color="Secondary"><span id="agreement-status">Your residency agreement is not yet accepted.</span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Optional services</native-heading>
            @{ Html.InputField(plan, m => m.WeeklyHousekeeping, o => o.Label("Weekly housekeeping"))
                .FusionCheckBox(b => b
                    .Label("Add weekly housekeeping")
                    .Reactive(plan, evt => evt.Changed, (args, p) =>
                    {
                        p.When(args, x => x.Checked).Truthy()
                            .Then(added => added.Element("housekeeping-status")
                                .SetText("Weekly housekeeping will be included in your move-in services."))
                            .Else(removed => removed.Element("housekeeping-status")
                                .SetText("Weekly housekeeping is not part of your move-in services."));
                    })); }
            <native-text color="Secondary"><span id="housekeeping-status">You can add weekly housekeeping to your move-in services.</span></native-text>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("recommend-housekeeping", "Add our recommended housekeeping")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionCheckBox>(m => m.WeeklyHousekeeping).SetChecked(true);
                        p.Element("housekeeping-status")
                            .SetText("Weekly housekeeping will be included in your move-in services.");
                    }))
                @(Html.NativeButton("flag-housekeeping-followup", "I'm not sure — flag for follow-up")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var housekeeping = p.Component<FusionCheckBox>(m => m.WeeklyHousekeeping);
                        housekeeping.SetIndeterminate(true);
                        p.When(housekeeping.Indeterminate()).Truthy()
                            .Then(flagged => flagged.Element("housekeeping-status")
                                .SetText("A coordinator will follow up with you about weekly housekeeping."))
                            .Else(decided => decided.Element("housekeeping-status")
                                .SetText("Your weekly housekeeping choice is recorded."));
                    }))
                @(Html.NativeButton("toggle-housekeeping", "Toggle weekly housekeeping for me")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionCheckBox>(m => m.WeeklyHousekeeping).Click();
                    }))
                @(Html.NativeButton("jump-to-agreement", "Take me back to the agreement")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionCheckBox>(m => m.AgreementAccepted).FocusIn();
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.NativeButton("save-agreement", "Save my move-in services")
                .CssClass(SubmitReady)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var agreement = p.Component<FusionCheckBox>(m => m.AgreementAccepted);
                    var housekeeping = p.Component<FusionCheckBox>(m => m.WeeklyHousekeeping);
                    p.Post(Url.SandboxRoute("SaveAgreement", "FusionCheckBox"))
                        .Gather(g =>
                        {
                            g.Include(agreement.Checked(), "agreementAccepted");
                            g.Include(housekeeping.Checked(), "weeklyHousekeeping");
                            g.Include(housekeeping.Indeterminate(), "housekeepingNeedsFollowUp");
                        })
                        .Response(r => r.OnSuccess<MoveInAgreementResponse>((json, s) =>
                        {
                            s.Element("save-confirmation").SetText(json, x => x.Summary);
                            s.Element("save-confirmation-panel").RemoveClass("hidden");
                        }));
                }))
            <div id="save-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="save-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
