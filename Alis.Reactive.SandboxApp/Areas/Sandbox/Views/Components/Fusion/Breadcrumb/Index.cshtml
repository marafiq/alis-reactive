@model FusionBreadcrumbModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "Resident Care Record";

    const string TrailId = "care-record-trail";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";

    var openUrl = Url.SandboxRoute("Open", "Breadcrumb");

    var communityUrl = "/communities/sunrise-court";
    var residentUrl = "/residents/eleanor-hughes";
    var carePlanUrl = "/residents/eleanor-hughes/care-plan";

    var plan = Html.ReactivePlan<FusionBreadcrumbModel>();

    var trail = new List<BreadcrumbItem>
    {
        new() { Text = Model.CommunityName, Id = "community", Url = communityUrl, IconCss = "e-icons e-home" },
        new() { Text = Model.ResidentName, Id = "resident", Url = residentUrl, IconCss = "e-icons e-user" },
        new() { Text = "Care Plan", Id = "care-plan", Url = carePlanUrl, IconCss = "e-icons e-file-document" }
    };

    Html.On(plan, t => t.DomReady(p =>
    {
        var trailComponent = p.Component<FusionBreadcrumb>(TrailId);

        p.When(trailComponent.ActiveItem).Eq(carePlanUrl)
            .Then(open => open.Element("viewing-now")
                .Text.Set("You are in this resident's Care Plan. Use the trail to step back up the record."))
            .Else(other => other.Element("viewing-now")
                .Text.Set("You have stepped back up the record."));
    }));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">@Model.ResidentName — Care Record</native-heading>
        <native-text color="Secondary">
            You are deep in this resident's record. Step back up the trail to open a higher section and read its summary.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.FusionBreadcrumb(plan, TrailId, b =>
            {
                b.Items(trail);
                b.ActiveItem(carePlanUrl);
                b.EnableNavigation(false);
                b.OverflowMode(BreadcrumbOverflowMode.None);
            })
            .Reactive(evt => evt.ItemClick, (args, p) =>
            {
                p.Element("open-section-heading").Text.Set(args.Item.Get(x => x.Text));
                p.Element("open-section-icon").Text.Set(args.Item.Get(x => x.IconCss));

                p.Post(openUrl)
                    .Gather<OpenCareSectionRequest>(g => g
                        .Set(x => x.Text, args.Item.Get(x => x.Text))
                        .Set(x => x.Id, args.Item.Get(x => x.Id))
                        .Set(x => x.Url, args.Item.Get(x => x.Url))
                        .Set(x => x.Disabled, args.Item.Get(x => x.Disabled)))
                    .Response(r => r.OnSuccess<OpenCareSectionResponse>((json, s) =>
                    {
                        s.Element("open-section-summary").Text.Set(json.Get(x => x.Summary));
                        s.Element("open-section-code").Text.Set(json.Get(x => x.SectionCode));
                        s.Element("open-section-panel").ClassList.Remove("hidden");
                    }));
            }))

            <native-text color="Secondary"><span id="viewing-now">Loading this resident's record…</span></native-text>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("back-to-resident", "Back to the resident's overview")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        var breadcrumb = p.Component<FusionBreadcrumb>(TrailId);
                        breadcrumb.ActiveItem.Set(residentUrl);
                        breadcrumb.DataBind();
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <div id="open-section-panel" class="hidden">
        <native-card><native-card-body>
            <native-vstack gap="Sm">
                <native-hstack gap="Sm" class="items-center">
                    <native-heading level="H2"><span id="open-section-heading"></span></native-heading>
                    <span id="open-section-code" class="rounded bg-surface-subtle px-2 py-1 text-xs font-mono text-text-secondary"></span>
                </native-hstack>
                <native-text>Section icon: <span id="open-section-icon" class="font-mono text-text-secondary"></span></native-text>
                <native-text><span id="open-section-summary"></span></native-text>
            </native-vstack>
        </native-card-body></native-card>
    </div>
</native-vstack>

@Html.RenderPlan(plan)
