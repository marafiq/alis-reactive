@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Sidebar.FusionSidebarModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Sidebar
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "Resident Care Dashboard";

    const string SidebarId = "care-services-panel";
    const string MenuButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string LinkButton = "block w-full rounded-md px-3 py-2 text-left text-sm font-medium text-white/90 hover:bg-white/10 transition-colors";

    var openPanelUrl = Url.Action("OpenPanel", "Sidebar", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve Sidebar.OpenPanel.");
    var closeActivityUrl = Url.Action("CloseActivity", "Sidebar", new { area = "Sandbox" })
        ?? throw new InvalidOperationException("Could not resolve Sidebar.CloseActivity.");

    var plan = Html.ReactivePlan<FusionSidebarModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Resident Care Dashboard</native-heading>
        <native-text color="Secondary">
            Reviewing care for <span class="font-semibold text-text">@Model.ResidentName</span>.
            Open the care-services menu to jump to a workflow.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("open-menu", "Open care-services menu")
                    .CssClass(MenuButton)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.Component<FusionSidebar>(SidebarId).Show();
                    }))
                @(Html.NativeButton("toggle-menu", "Care-services menu")
                    .CssClass(MenuButton)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.Component<FusionSidebar>(SidebarId).Toggle();
                    }))
            </native-hstack>

            <div id="dashboard-content" class="rounded-md border border-border bg-surface-subtle p-6">
                <native-vstack gap="Xs">
                    <native-text>
                        Care status: <span id="menu-state" class="font-semibold text-text">Care-services menu is tucked away.</span>
                    </native-text>
                    <native-text color="Secondary">
                        Live services: <span id="services-summary">Open the menu to load the current service list.</span>
                    </native-text>
                    <native-text color="Secondary">
                        Last menu activity: <span id="activity-note">No menu activity yet.</span>
                    </native-text>
                </native-vstack>
            </div>
        </native-vstack>
    </native-card-body></native-card>

    @(Html.FusionSidebar(plan, SidebarId, b =>
    {
        b.IsOpen(false);
        b.Animate(false);
        b.EnableGestures(false);
        b.CloseOnDocumentClick(true);
        b.ShowBackdrop(false);
        b.Type(SidebarType.Over);
        b.Width("260px");
        b.ContentTemplate(@<text>
            <div class="flex h-full flex-col gap-1 bg-slate-800 p-4">
                <native-heading level="H2"><span class="text-white">Care services</span></native-heading>
                <a href="#care-plan" class="block rounded-md px-3 py-2 text-sm font-medium text-white/90 hover:bg-white/10">Care plan</a>
                <a href="#medications" class="block rounded-md px-3 py-2 text-sm font-medium text-white/90 hover:bg-white/10">Medications</a>
                <a href="#visits" class="block rounded-md px-3 py-2 text-sm font-medium text-white/90 hover:bg-white/10">Visits</a>
                @(Html.NativeButton("collapse-menu", "Collapse menu")
                    .CssClass(LinkButton)
                    .Reactive(plan, evt => evt.Click, (_, pp) =>
                    {
                        pp.Component<FusionSidebar>(SidebarId).Toggle();
                    }))
                @(Html.NativeButton("close-menu", "Close menu")
                    .CssClass(LinkButton)
                    .Reactive(plan, evt => evt.Click, (_, pp) =>
                    {
                        var panel = pp.Component<FusionSidebar>(SidebarId);
                        panel.Hide();
                        pp.Post(closeActivityUrl)
                            .Gather(g => g.Include(panel.IsOpen(), "isOpen"))
                            .Response(r => r.OnSuccess<FusionSidebarCloseResponse>((json, s) =>
                            {
                                s.Element("activity-note").SetText(json, x => x.ActivityNote);
                            }));
                    }))
            </div>
        </text>);
    })
    .Reactive(evt => evt.Opened, (args, p) =>
    {
        p.Element("menu-state").SetText("Care-services menu is open.");
        p.Post(openPanelUrl)
            .Gather(g => g.FromEvent(args, x => x.IsInteracted, "openedByCoordinator"))
            .Response(r => r.OnSuccess<FusionSidebarOpenResponse>((json, s) =>
            {
                s.Element("services-summary").SetText(json, x => x.ServicesSummary);
                s.Element("activity-note").SetText(json, x => x.OpenedNote);
            }));
    })
    .Reactive(evt => evt.Closed, (args, p) =>
    {
        p.When(args, x => x.IsInteracted).Truthy()
            .Then(byUser => byUser.Element("menu-state")
                .SetText("You closed the care-services menu."))
            .Else(byApp => byApp.Element("menu-state")
                .SetText("Care-services menu closed automatically."));
    }))
</native-vstack>

@Html.RenderPlan(plan)
