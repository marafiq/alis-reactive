@model ArrayGridModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "Resident Roster";

    var plan = Html.ReactivePlan<ArrayGridModel>();

    var columns = FusionGridColumns.Of<RosterResident>();

    // The roster arrives in no order; the browser sorts it by name before the grid shows it.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("Residents", "ArrayGrid"))
         .Response(r => r.OnSuccess<RosterResponse>((json, s) =>
         {
             var roster = s.From(json.Get(x => x.Residents));
             s.Component<FusionGrid>("roster-grid").Rows<RosterResident>().Set(roster.OrderBy(x => x.Name));
         }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Resident Roster</native-heading>
    <native-text color="Secondary">
        Front desk. Every resident by name; narrow the roster to the active residents for the day's sign-in sheet.
    </native-text>

    <native-card><native-card-body>
        @(Html.FusionGrid<ArrayGridModel, RosterResident>(plan, "roster-grid", b => b
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.Name), HeaderText = "Name", Width = "160" },
                new GridColumn { Field = columns.Field(r => r.Status), HeaderText = "Status", Width = "130" },
                new GridColumn { Field = columns.Field(r => r.Age), HeaderText = "Age", Width = "80" },
                new GridColumn { Field = columns.Field(r => r.Balance), HeaderText = "Balance", Width = "110" },
            })))

        <div class="mt-4 flex items-center gap-3">
            @(Html.NativeButton("show-active-btn", "Show Active Only")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    // The active residents come from the rows on screen, not from the server again.
                    var rosterGrid = p.Component<FusionGrid>("roster-grid");
                    var onScreen = p.From(rosterGrid.Rows<RosterResident>());
                    rosterGrid.Rows<RosterResident>().Set(onScreen.Where(x => x.Status == "active").OrderBy(x => x.Name));
                    rosterGrid.Refresh();
                    p.Element("roster-showing").Text.Set("Active residents, by name.");
                }))
            <p id="roster-showing" class="text-sm text-text-secondary">Every resident, by name.</p>
        </div>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
