@model ArrayGridModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Grids
@{
    ViewData["Title"] = "ArrayGrid";

    var plan = Html.ReactivePlan<ArrayGridModel>();

    var columns = FusionGridColumns.Of<ResidentRow>();

    // HTTP array flows through ReactiveArray ordering before binding the grid dataSource.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("Residents", "ArrayGrid"))
         .Response(r => r.OnSuccess<ResidentRosterResponse>((json, s) =>
         {
             var roster = p.From(json.Get(x => x.Residents));
             s.Component<FusionGrid>("roster-grid").DataSource.Set(roster.OrderBy(x => x.Name));
             s.Element("grid-status").Text.Set("roster loaded");
         }))));

    // Client-side path reads and rebinds the grid's current dataSource.
    Html.NativeButton("show-active-btn", "Show Active Only")
        .Reactive(plan, evt => evt.Click, (args, p) =>
        {
            var current = p.From(p.Component<FusionGrid>("roster-grid").Rows<ResidentRow>());
            var rosterGrid = p.Component<FusionGrid>("roster-grid");
            rosterGrid.DataSource.Set(current.Where(x => x.Status == "active").OrderBy(x => x.Name));
            rosterGrid.Refresh();
            p.Element("grid-status").Text.Set("active only");
        });
}

<native-vstack gap="Lg">
    <native-heading level="H1">ArrayGrid &mdash; client-side transform into a grid data source</native-heading>
    <native-text color="Secondary">
        The array DSL is just value routing: <code>p.From(roster).Where(x =&gt; x.Status == "active").OrderBy(x =&gt; x.Name)</code>
        flows into the grid's <code>dataSource</code> member via <code>rosterGrid.DataSource.Set(source)</code>.
        The filter runs in the plan over element members &mdash; no HTTP round-trip, no per-row code.
    </native-text>

    <native-card><native-card-body>
        @(Html.FusionGrid<ArrayGridModel, ResidentRow>(plan, "roster-grid", b => b
            .Columns(new List<GridColumn>
            {
                new GridColumn { Field = columns.Field(r => r.Name), HeaderText = "Name", Width = "160" },
                new GridColumn { Field = columns.Field(r => r.Status), HeaderText = "Status", Width = "130" },
                new GridColumn { Field = columns.Field(r => r.Age), HeaderText = "Age", Width = "80" },
                new GridColumn { Field = columns.Field(r => r.Balance), HeaderText = "Balance", Width = "110" },
            })))

        <div class="mt-4 flex items-center gap-3">
            @(Html.NativeButton("show-active-btn", "Show Active Only")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors"))
            <span class="font-mono text-sm">Status: <span id="grid-status" class="text-text-muted">&mdash;</span></span>
        </div>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
