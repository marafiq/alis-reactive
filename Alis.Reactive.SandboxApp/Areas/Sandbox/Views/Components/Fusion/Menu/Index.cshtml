@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Menu
@model FusionMenuModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "Staff Navigation";

    const string MenuId = "staff-nav";
    const string Content = "page-content";
    const string Dimmed = "opacity-40";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";

    var plan = Html.ReactivePlan<FusionMenuModel>();
    var staff = Model.SignedIn;
    var switchUrl = Url.SandboxRoute("Index", "Menu", new { staff = Model.SwitchTo.Key });
    var pageUrl = Url.SandboxRoute("OpenPage", "Menu");

    // The business office opens Billing; everyone else sees it with the lock icon.
    var pages = new List<MenuItem>
    {
        new()
        {
            Id = "nav-residents", Text = "Residents", IconCss = "e-icons e-people", Url = "#/residents",
            Items = new List<MenuItem>
            {
                new() { Id = "nav-census", Text = "Census", Url = "#/residents/census" },
                new() { Id = "nav-room-board", Text = "Room board", Url = "#/residents/room-board" },
                new() { Id = "nav-care-notes", Text = "Care notes", Url = "#/residents/care-notes" }
            }
        },
        new()
        {
            Id = "nav-medications", Text = "Medications", IconCss = "e-icons e-notes", Url = "#/medications",
            Items = new List<MenuItem>
            {
                new() { Id = "nav-med-pass", Text = "Med pass", Url = "#/medications/med-pass" },
                new() { Id = "nav-prn-log", Text = "PRN log", Url = "#/medications/prn-log" },
                new() { Separator = true },
                new() { Id = "nav-pharmacy-orders", Text = "Pharmacy orders", Url = "https://pharmacy.example.com/maple-grove/orders" }
            }
        },
        new()
        {
            Id = "nav-billing", Text = "Billing", IconCss = staff.OpensBilling ? "e-icons e-description" : "e-icons e-lock", Url = "#/billing",
            Items = new List<MenuItem>
            {
                new() { Id = "nav-invoices", Text = "Invoices", Url = "#/billing/invoices" },
                new() { Id = "nav-payments", Text = "Payments", Url = "#/billing/payments" }
            }
        },
        new() { Id = "nav-help", Text = "Help", IconCss = "e-icons e-circle-info", Url = "#/help" }
    };
}

<native-vstack gap="Lg">
    <native-heading level="H1">Staff Navigation</native-heading>
    <native-text color="Secondary">
        The nurses' station tablet at Maple Grove. Tap the menu icon, or Open navigation, to choose a page.
    </native-text>

    <native-hstack gap="Sm" align="Center" class="flex-wrap">
        <p class="text-sm">Signed in as <span class="font-medium">@staff.Name</span>, @staff.Role.</p>
        <a href="@switchUrl" class="text-sm text-accent underline">Switch to @Model.SwitchTo.Name</a>
    </native-hstack>

    @(Html.FusionMenu(plan, MenuId, b =>
    {
        b.Items(pages);
        b.HamburgerMode(true);
        b.ShowItemOnClick(true);
        b.Title("Maple Grove");
        b.EnableScrolling(false);
    })
    // A page that leaves the staff app is pointed out as its section lists it.
    .Reactive(evt => evt.BeforeItemRender, (args, p) =>
        p.When(args.Item.Get(x => x.Url)).StartsWith("https://").Then(external =>
        {
            external.Element("external-page").Text.Set(args.Item.Get(x => x.Text));
            external.Element("external-note").Show();
        }))
    // A section shown with the lock icon stays closed to the signed-in staff member.
    .Reactive(evt => evt.BeforeOpen, (args, p) =>
        p.When(args.ParentItem.Get(x => x.IconCss)).Contains("e-lock")
            .Then(locked =>
            {
                args.Cancel.Set(true);
                locked.Element("locked-section").Text.Set(args.ParentItem.Get(x => x.Text));
                locked.Element("locked-pages").Text.Set(locked.From(args.Items).Count(item => !item.Separator));
                locked.Element("section-overview").Hide();
                locked.Element("locked-note").Show();
            })
            .Else(open => open.Element("locked-note").Hide()))
    .Reactive(evt => evt.OnOpen, (args, p) =>
        p.When(args.ParentItem).IsNull().Then(opened => opened.Element(Content).ClassList.Add(Dimmed)))
    // On a shared tablet the navigation stays open until a page is chosen, so a shift never starts on a blank page.
    .Reactive(evt => evt.BeforeClose, (args, p) =>
        p.When(args.ParentItem).IsNull()
            .And(p.Component<NativeHiddenField>(m => m.CurrentPage).Value).IsEmpty()
            .Then(unchosen =>
            {
                args.Cancel.Set(true);
                unchosen.Element("choose-first-note").Show();
            }))
    .Reactive(evt => evt.OnClose, (args, p) =>
        p.When(args.ParentItem).IsNull().Then(closed => closed.Element(Content).ClassList.Remove(Dimmed)))
    // A page opens and the navigation closes; a section says how many pages it holds and stays open.
    .Reactive(evt => evt.Select, (args, p) =>
    {
        p.Element("page-title").Text.Set(args.Item.Get(x => x.Text));
        p.Element("page-link").Text.Set(args.Item.Get(x => x.Url));
        p.Element("page-summary").Text.Set("");
        p.When(args.Item.Get(x => x.Items)).IsEmpty()
            .Then(page =>
            {
                page.Component<NativeHiddenField>(m => m.CurrentPage).Value.Set(args.Item.Get(x => x.Id));
                page.Element("section-overview").Hide();
                page.Element("choose-first-note").Hide();
                page.Component<FusionMenu>(MenuId).Close();
                page.Get(pageUrl)
                    .Gather<StaffPageQuery>(g => g.Set(x => x.Page, args.Item.Get(x => x.Id)))
                    .Response(answer => answer.OnSuccess<StaffPage>((opened, s) =>
                        s.Element("page-summary").Text.Set(opened.Get(x => x.Summary))));
            })
            .Else(section =>
            {
                section.Element("section-pages").Text.Set(section.From(args.Item.Get(x => x.Items)).Count(item => !item.Separator));
                section.Element("section-overview").Show();
            });
    }))
    @Html.HiddenFieldFor(plan, m => m.CurrentPage)

    <native-card><native-card-body>
        <div id="@Content" class="transition-opacity">
            <h2 id="page-title" class="text-lg font-semibold">Choose a page</h2>
            <p class="text-sm text-text-secondary">Link to this page: <span id="page-link">none yet</span></p>
            <p id="page-summary" class="text-sm"></p>
            <p id="section-overview" hidden class="text-sm"><span id="section-pages"></span> pages in this section.</p>
            <p id="locked-note" hidden class="text-sm text-amber-700">
                <span id="locked-section"></span> opens for the business office; its <span id="locked-pages"></span>
                pages stay closed to @staff.Name.
            </p>
            <p id="external-note" hidden class="text-sm text-text-secondary">
                <span id="external-page"></span> opens outside the staff app.
            </p>
            <p id="choose-first-note" hidden class="text-sm text-amber-700">Choose a page to start your shift.</p>
            <div class="mt-4">
                @(Html.NativeButton("open-navigation-btn", "Open navigation")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionMenu>(MenuId).Open()))
            </div>
        </div>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
