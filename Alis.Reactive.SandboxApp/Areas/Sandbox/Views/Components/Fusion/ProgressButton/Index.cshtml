@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.ProgressButton
@model FusionProgressButtonModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@{
    ViewData["Title"] = "Medication Pass Report";

    const string SendId = "send-report";
    const int UploadMilliseconds = 6000;
    const double DraftPercentSent = 60;
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";

    var plan = Html.ReactivePlan<FusionProgressButtonModel>();
    var pharmacies = new[]
    {
        new SelectListItem("Lakeside Pharmacy", "Lakeside"),
        new SelectListItem("Riverside Pharmacy", "Riverside"),
        new SelectListItem("County Pharmacy (fax)", "County")
    };

    FusionProgressButton Report(PipelineBuilder<FusionProgressButtonModel> p) => p.Component<FusionProgressButton>(SendId);

    // How much of the report this send carries: a send that starts less than one step in carries all of it,
    // one that starts further in carries the rest of a send that stopped part-way.
    void DescribeStart(PipelineBuilder<FusionProgressButtonModel> p, FusionProgressButtonProgressArgs args)
    {
        p.Element("report-sent").Hide();
        p.When(args.Percent).Lt(args.Step)
            .Then(whole =>
            {
                whole.Element("send-rest").Hide();
                whole.Element("send-whole").Show();
            })
            .Else(rest =>
            {
                rest.Element("send-rest-from").Text.Set(args.Percent);
                rest.Element("send-whole").Hide();
                rest.Element("send-rest").Show();
            });
    }

    // An upload shows how much of the report has gone; a fax only says it is going.
    void ShowProgress(PipelineBuilder<FusionProgressButtonModel> p, FusionProgressButtonProgressArgs args) =>
        p.When(Report(p).EnableProgress).Truthy()
            .Then(upload =>
            {
                upload.Element("send-percent").Text.Set(args.Percent);
                upload.Element("send-faxing").Hide();
                upload.Element("send-progress").Show();
            })
            .Else(fax =>
            {
                fax.Element("send-progress").Hide();
                fax.Element("send-faxing").Show();
            });

    // A pharmacy that confirms it has the report ends the upload there and then.
    void SendToPharmacy(PipelineBuilder<FusionProgressButtonModel> p) =>
        p.Post(Url.SandboxRoute("Send", "ProgressButton"))
            .Gather<MedicationPassSendRequest>(g => g.Set(x => x.Pharmacy, p.Component<NativeDropDown>(m => m.Pharmacy).Value))
            .Response(r => r.OnSuccess<MedicationPassSendReply>((json, s) =>
            {
                s.Element("pharmacy-reply").Text.Set(json.Get(x => x.Reply));
                s.Element("pharmacy-reply").Show();
                s.When(json.Get(x => x.ConfirmedOnReceipt)).Truthy()
                    .Then(confirmed => Report(confirmed).ProgressComplete());
            }));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Medication Pass Report</native-heading>
    <native-text color="Secondary">Evening shift, Maple wing. Rosa Alvarez, LPN, sends the pass to the pharmacy before handoff.</native-text>

    <native-card><native-card-body>
        <native-heading level="H2">Evening pass</native-heading>
        <p class="text-sm mt-2">18 residents. 64 doses given, 2 refused, 1 held.</p>
        <ul class="text-sm list-disc pl-5 mt-2">
            <li>Room 112, Harold Finch: metoprolol 25 mg refused</li>
            <li>Room 118, Edith Moore: donepezil 10 mg refused</li>
            <li>Room 124, Walter Ruiz: warfarin 5 mg held, INR pending</li>
        </ul>

        <native-vstack gap="Sm" class="mt-6">
            @{ Html.InputField(plan, m => m.PassChecked, o => o.Label("I checked every resident's medications on this pass"))
                .NativeCheckBox(b => b.CssClass("rounded border-border"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    p.When(args.Checked).Truthy()
                        .Then(ready =>
                        {
                            var report = Report(ready);
                            report.Disabled.Set(false);
                            report.DataBind();
                            report.FocusIn();
                        })
                        .Else(notReady =>
                        {
                            var report = Report(notReady);
                            report.Disabled.Set(true);
                            report.DataBind();
                        });
                }); }

            @{ Html.InputField(plan, m => m.Pharmacy, o => o.Label("Pharmacy"))
                .NativeDropDown(b => b
                    .Items(pharmacies)
                    .CssClass("rounded-md border border-border px-3 py-1.5 text-sm"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    // A fax reports no upload progress, so the button only spins.
                    p.When(args.Value).Eq("County")
                        .Then(fax => Report(fax).EnableProgress.Set(false))
                        .Else(upload => Report(upload).EnableProgress.Set(true));
                    Report(p).DataBind();
                }); }
        </native-vstack>

        <native-hstack gap="Base" align="Center" class="mt-6">
            @(Html.FusionProgressButton(plan, SendId, b => b
                .Content("Send to pharmacy")
                .CssClass("e-primary")
                .Disabled(true)
                .EnableProgress(true)
                .Duration(UploadMilliseconds))
                .Reactive(evt => evt.Begin, (args, p) =>
                {
                    DescribeStart(p, args);
                    ShowProgress(p, args);
                    SendToPharmacy(p);
                })
                .Reactive(evt => evt.Progress, (args, p) =>
                {
                    // Only a resumed send's first moment has no time behind it; a fresh send starts with Begin.
                    p.When(args.CurrentDuration).Eq(0d).Then(resumed => DescribeStart(resumed, args));
                    ShowProgress(p, args);
                })
                .Reactive(evt => evt.End, (_, p) =>
                {
                    var report = Report(p);
                    report.Content.Set("Sent");
                    report.CssClass.Set("e-success");
                    report.DataBind();
                    p.Element("send-progress").Hide();
                    p.Element("send-faxing").Hide();
                    p.Element("report-sent").Show();
                    p.Element("saved-draft").Hide();
                }))
        </native-hstack>

        <native-vstack gap="Xs" class="mt-4">
            <p id="send-whole" hidden class="text-sm font-medium">Sending the whole report.</p>
            <p id="send-rest" hidden class="text-sm font-medium">Sending the rest of the report: <span id="send-rest-from"></span>% had already reached the pharmacy.</p>
            <p id="send-progress" hidden class="text-sm"><span id="send-percent">0</span>% sent</p>
            <p id="send-faxing" hidden class="text-sm">Faxing the report.</p>
            <p id="report-sent" hidden class="text-sm font-medium text-green-700">Report sent.</p>
            <p id="pharmacy-reply" hidden class="text-sm text-text-muted"></p>
        </native-vstack>
    </native-card-body></native-card>

    <div id="saved-draft">
        <native-card><native-card-body>
            <native-heading level="H2">Saved draft</native-heading>
            <p class="text-sm mt-2">Your 6:58 PM send stopped at @DraftPercentSent% when the connection dropped.</p>

            <native-hstack gap="Sm" class="mt-4 flex-wrap">
                @(Html.NativeButton("resume-draft-btn", "Resume sending")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.When(Report(p).Disabled).Truthy()
                            .Then(notReady => notReady.Element("draft-warning").Show())
                            .Else(ready =>
                            {
                                ready.Element("draft-warning").Hide();
                                Report(ready).StartAt(DraftPercentSent);
                                SendToPharmacy(ready);
                            });
                    }))
                @(Html.NativeButton("send-again-btn", "Send it all again")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.When(Report(p).Disabled).Truthy()
                            .Then(notReady => notReady.Element("draft-warning").Show())
                            .Else(ready =>
                            {
                                ready.Element("draft-warning").Hide();
                                Report(ready).Start();
                            });
                    }))
            </native-hstack>
            <p id="draft-warning" hidden class="mt-2 text-sm text-red-700">Check off the medication pass before sending it.</p>
        </native-card-body></native-card>
    </div>
</native-vstack>

@Html.RenderPlan(plan)
