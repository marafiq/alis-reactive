@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Toolbar.FusionToolbarModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.Extensions
@using Syncfusion.EJ2.Navigations
@{
    ViewData["Title"] = "FusionToolbar";

    const string ToolbarId = "resident-toolbar";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";

    var plan = Html.ReactivePlan<Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Toolbar.FusionToolbarModel>();

    var commands = new List<ToolbarItem>
    {
        new() { Id = "pay-balance", Text = "Pay balance", PrefixIcon = "e-icons e-medium e-billing", Type = ItemType.Button },
        new() { Id = "request-maintenance", Text = "Request maintenance", PrefixIcon = "e-icons e-medium e-edit", Type = ItemType.Button },
        new() { Id = "message-care-team", Text = "Message care team", PrefixIcon = "e-icons e-medium e-comment-show", Type = ItemType.Button }
    };
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">@Model.ResidentName — Account</native-heading>
        <native-text color="Secondary">
            Balance due: <span class="font-semibold text-text">$@Model.BalanceDue.ToString("0.00")</span>.
            Use the command bar to pay, request maintenance, or message your care team.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.FusionToolbar(plan, ToolbarId, b =>
            {
                b.Items(commands);
                b.CssClass("rounded-md");
                b.Width("520px");
            })
            .Reactive(evt => evt.Clicked, (args, p) =>
            {
                p.When(args, x => x.Item.Id).Eq("pay-balance")
                    .Then(pay =>
                    {
                        pay.Component<FusionToolbar>(ToolbarId).Disable(true);
                        pay.Element("account-status").SetText("Processing your payment. The command bar is locked until it completes.");
                        pay.Element("payment-panel").AddClass("hidden");

                        pay.Post(Url.SandboxRoute("Confirm", "Toolbar"))
                            .Gather(g => g
                                .FromEvent(args, x => x.Item.Id, "commandId")
                                .FromEvent(args, x => x.Item.Text, "commandText")
                                .FromEvent(args, x => x.Item.Disabled, "commandDisabled"))
                            .Response(r => r.OnSuccess<Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Toolbar.ResidentCommandResponse>((json, s) =>
                            {
                                s.Element("payment-confirmation").SetText(json, x => x.Confirmation);
                                s.Element("payment-panel").RemoveClass("hidden");
                            }));
                    })
                    .Else(other =>
                    {
                        other.Element("account-status").SetText(args, x => x.Item.Text);
                        other.Element("account-status-panel").RemoveClass("hidden");
                    });
            }))

            <div id="account-status-panel" class="hidden rounded-md border border-border bg-surface-subtle p-3">
                <native-text>You started: <span id="account-status" class="font-medium text-text"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <div id="payment-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="payment-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
            @(Html.NativeButton("payment-done", "Done — unlock the command bar")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Component<FusionToolbar>(ToolbarId).Disable(false);
                    p.Element("account-status").SetText("Your payment is complete. The command bar is ready again.");
                    p.Element("account-status-panel").RemoveClass("hidden");
                }))
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
