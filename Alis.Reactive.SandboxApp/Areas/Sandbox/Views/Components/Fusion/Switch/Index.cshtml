@model SwitchModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionSwitch";

    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string SubmitReady = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<SwitchModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Care Alert Preferences</native-heading>
        <native-text color="Secondary">
            Choose whether we send you care alerts, and how we deliver them. Turn the master switch off to pause every alert,
            or pick the channels that suit you, then save.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Receive care alerts</native-heading>
            @{ Html.InputField(plan, m => m.ReceiveCareAlerts, o => o.Label("Receive care alerts"))
                .FusionSwitch(b => b
                    .OnLabel("On")
                    .OffLabel("Off")
                    .Reactive(plan, evt => evt.Changed, (args, p) =>
                    {
                        p.When(args, x => x.Checked).Truthy()
                            .Then(on => on.Element("alerts-status")
                                .SetText("Care alerts are on. Choose how we should reach you below."))
                            .Else(off => off.Element("alerts-status")
                                .SetText("Care alerts are paused. We will not send reminders until you turn them back on."));
                    })); }

            <native-text color="Secondary"><span id="alerts-status">Care alerts are on. Choose how we should reach you below.</span></native-text>

            @(Html.NativeButton("pause-alerts", "Pause all alerts")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionSwitch>(m => m.ReceiveCareAlerts).SetChecked(false);
                    p.Element("alerts-status")
                        .SetText("Care alerts are paused. We will not send reminders until you turn them back on.");
                }))
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Delivery channels</native-heading>

            @{ Html.InputField(plan, m => m.EmailReminders, o => o.Label("Email reminders"))
                .FusionSwitch(b => b.OnLabel("On").OffLabel("Off")); }

            @{ Html.InputField(plan, m => m.TextMessageAlerts, o => o.Label("Text-message alerts"))
                .FusionSwitch(b => b.OnLabel("On").OffLabel("Off")); }

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("review-email", "Review email reminders")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var email = p.Component<FusionSwitch>(m => m.EmailReminders);
                        p.When(email.Value()).Truthy()
                            .Then(on => on.Element("email-review").SetText("Email reminders are on."))
                            .Else(off => off.Element("email-review").SetText("Email reminders are off."));
                    }))
                @(Html.NativeButton("review-text", "Review text-message alerts")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var text = p.Component<FusionSwitch>(m => m.TextMessageAlerts);
                        p.When(text.Value()).Truthy()
                            .Then(on => on.Element("text-review").SetText("Text-message alerts are on."))
                            .Else(off => off.Element("text-review").SetText("Text-message alerts are off."));
                    }))
            </native-hstack>

            <native-vstack gap="Xs">
                <native-text color="Secondary"><span id="email-review">Use the button to check your email reminders.</span></native-text>
                <native-text color="Secondary"><span id="text-review">Use the button to check your text-message alerts.</span></native-text>
            </native-vstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.NativeButton("save-preferences", "Save my alert preferences")
                .CssClass(SubmitReady)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var receive = p.Component<FusionSwitch>(m => m.ReceiveCareAlerts);
                    var email = p.Component<FusionSwitch>(m => m.EmailReminders);
                    var text = p.Component<FusionSwitch>(m => m.TextMessageAlerts);
                    p.Post(Url.SandboxRoute("Save", "Switch"))
                        .Gather(g => g
                            .Include(receive.Value(), "receiveCareAlerts")
                            .Include(email.Value(), "emailReminders")
                            .Include(text.Value(), "textMessageAlerts"))
                        .Response(r => r.OnSuccess<CareAlertPreferencesResponse>((json, s) =>
                        {
                            s.Element("save-confirmation").SetText(json, x => x.Summary);
                            s.Element("save-confirmation-panel").RemoveClass("hidden");
                        }));
                }))
            <div id="save-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="save-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
