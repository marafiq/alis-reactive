@model TrainingCalendarSession
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.AppLevel
@{
    var plan = Html.ResolvePlan<TrainingCalendarSession>();

    Html.On(plan, t => t.CustomEvent<TrainingCalendarReminded>("training:reminded", (reminder, p) =>
        p.When(reminder, x => x.SessionId).Eq(Model.Id)
         .Then(sent => sent.Element("training-session-reminder").SetText(reminder, x => x.Message))));
}

<div class="flex flex-col gap-2 p-4">
    <p class="text-base font-semibold">@Model.Subject</p>
    <p class="text-sm text-text-secondary">Trainer: @Model.Trainer</p>
    <p class="text-sm text-text-secondary">@Model.StartTime.ToString("dddd, MMMM d, h:mm tt") to @Model.EndTime.ToString("h:mm tt")</p>
    <p id="training-session-reminder" class="text-sm text-text-muted">No reminder sent yet.</p>

    <div class="flex gap-2">
        @(Html.NativeButton("training-session-remind", "Send reminder")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90")
            .Reactive(plan, evt => evt.Click, (args, p) =>
                p.Dispatch("training:remind", new TrainingCalendarSessionPicked { Id = Model.Id })))
        @(Html.NativeButton("training-session-done", "Done")
            .CssClass("rounded-md border border-border px-4 py-2 text-sm font-medium")
            .Reactive(plan, evt => evt.Click, (args, p) => p.Component<NativeDrawer>().Close()))
    </div>
</div>

@Html.RenderPlan(plan)
