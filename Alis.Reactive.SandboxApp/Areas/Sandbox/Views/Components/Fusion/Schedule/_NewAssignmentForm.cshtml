@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.NewAssignmentModel
@using Alis.Reactive
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models
@{
    var plan = Html.ReactivePlan<NewAssignmentModel>();
    var staffList = FakeScheduleData.Staff.Select(s => new StaffOption
    {
        Text = $"{s.Name} ({s.Role})",
        Value = s.Id
    }).ToList();

    var shiftName = FakeScheduleData.Shifts
        .FirstOrDefault(s => s.Id == Model.ShiftId)?.Text ?? "Unknown Shift";
}

<native-vstack gap="Base" class="p-4">
    @{
        DateTimeOffset.TryParse(Model.StartTime, out var startDto);
        DateTimeOffset.TryParse(Model.EndTime, out var endDto);
    }
    <native-vstack gap="Xs" class="text-sm text-text-secondary">
        <p><span class="font-medium">Shift:</span> @shiftName</p>
        <p><span class="font-medium">Start:</span> @startDto.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</p>
        <p><span class="font-medium">End:</span> @endDto.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</p>
    </native-vstack>

    <form id="new-assignment-form" class="space-y-3">
        @Html.HiddenFieldFor(plan, m => m.StartTime)
        @Html.HiddenFieldFor(plan, m => m.EndTime)
        @Html.HiddenFieldFor(plan, m => m.ShiftId)
        @Html.HiddenFieldFor(plan, m => m.FacilityId)

        <native-vstack gap="Sm">
            @{ Html.InputField(plan, m => m.StaffId, o => o.Required().Label("Staff Member"))
                .FusionDropDownList(b => b
                    .Placeholder("Select staff member")
                    .DataSource(staffList)
                    .Fields<StaffOption>(t => t.Text, v => v.Value)); }

            @{ Html.InputField(plan, m => m.Notes, o => o.Label("Care Notes"))
                .NativeTextArea(b => b.Rows(3).Placeholder("Care instructions, special requirements...")); }
        </native-vstack>

        <native-hstack gap="Sm" class="pt-2">
            @(Html.NativeButton("btn-create-assignment", "Create Assignment")
                .CssClass("px-4 py-2 rounded-md bg-accent text-white text-sm font-medium hover:bg-accent/90")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post("/api/schedule/create-assignment", g => g
                         .Include<NativeHiddenField, NewAssignmentModel>(m => m.StartTime)
                         .Include<NativeHiddenField, NewAssignmentModel>(m => m.EndTime)
                         .Include<NativeHiddenField, NewAssignmentModel>(m => m.ShiftId)
                         .Include<NativeHiddenField, NewAssignmentModel>(m => m.FacilityId)
                         .Include<FusionDropDownList, NewAssignmentModel>(m => m.StaffId)
                         .Include<NativeTextArea, NewAssignmentModel>(m => m.Notes))
                     .Validate<NewAssignmentValidator>("new-assignment-form")
                     .Response(r => r
                         .OnSuccess(s =>
                         {
                             s.Component<FusionDialog>("new-assignment-dialog").Hide();
                             s.Dispatch("schedule:assignment-saved");
                         })
                         .OnError(400, e => e.ValidationErrors("new-assignment-form")));
                }))

            @(Html.NativeButton("btn-cancel-new-assignment", "Cancel")
                .CssClass("px-4 py-2 rounded-md border border-border text-sm font-medium hover:bg-slate-50")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionDialog>("new-assignment-dialog").Hide();
                }))
        </native-hstack>

        <p id="new-assignment-status" class="text-sm text-text-muted"></p>
    </form>
</native-vstack>

@Html.EJS().ScriptManager()
@Html.RenderPlan(plan)
