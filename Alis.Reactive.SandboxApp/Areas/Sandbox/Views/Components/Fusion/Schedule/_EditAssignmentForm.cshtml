@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.EditAssignmentModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.AppLevel
@using Alis.Reactive.Fusion.Components
@{
    var plan = Html.ReactivePlan<EditAssignmentModel>();
    var staffOptions = FakeScheduleData.Staff
        .Select(s => new RadioButtonItem(s.Id.ToString(), $"{s.Name} ({s.Role})"))
        .ToArray();
}

<native-vstack gap="Base" class="p-4">
    <h3 class="text-lg font-semibold">Edit Shift Assignment</h3>
    <p class="text-sm text-text-secondary">Assignment #@Model.AssignmentId</p>

    <form id="assignment-form" class="space-y-3">
    @Html.HiddenFieldFor(plan, m => m.AssignmentId)

    <native-vstack gap="Sm">
        @{ Html.InputField(plan, m => m.StaffId, o => o.Required().Label("Staff Member"))
            .NativeRadioGroup(b => b.Items(staffOptions)); }

        @{ Html.InputField(plan, m => m.Notes, o => o.Label("Care Notes"))
            .NativeTextArea(b => b.Rows(3).Placeholder("Care instructions, special requirements...")); }
    </native-vstack>

    <native-hstack gap="Sm" class="pt-2">
        @(Html.NativeButton("btn-save-assignment", "Save Assignment")
            .CssClass("px-4 py-2 rounded-md bg-accent text-white text-sm font-medium hover:bg-accent/90")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post("/api/schedule/assign")
                 .Gather<AssignStaffRequest>(g => g.Form(m => m.AssignmentId, m => m.StaffId))
                 .Validate<EditAssignmentValidator>("assignment-form")
                 .Response(r => r
                     .OnSuccess<ShiftAssignment>((shift, s) =>
                     {
                         s.Component<NativeDrawer>().Close();
                         // The shift shows its new staff where it is; the schedule then reloads the week
                         // for the open-shift count, as after any change to an event.
                         s.Component<FusionSchedule>("shift-schedule").SaveEvent(shift, ScheduleAction.Save);
                     })
                     .OnError(400, e => e.ValidationErrors("assignment-form")));
            }))

        @(Html.NativeButton("btn-cancel-shift", "Cancel Shift")
            .CssClass("px-4 py-2 rounded-md border border-red-300 text-sm font-medium text-red-700 hover:bg-red-50")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post("/api/schedule/cancel-shift")
                 .Gather<CancelShiftRequest>(g => g.Form(m => m.AssignmentId))
                 .Response(r => r.OnSuccess<ShiftAssignment>((shift, s) =>
                 {
                     s.Component<NativeDrawer>().Close();
                     s.Component<FusionSchedule>("shift-schedule").DeleteEvent(shift.Get(x => x.Id), ScheduleAction.Delete);
                 }));
            }))

        @(Html.NativeButton("btn-cancel-assignment", "Cancel")
            .CssClass("px-4 py-2 rounded-md border border-border text-sm font-medium hover:bg-slate-50")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Component<NativeDrawer>().Close();
            }))
    </native-hstack>

    </form>
</native-vstack>

@Html.EJS().ScriptManager()
@Html.RenderPlan(plan)
