@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.PointInTimeScheduleModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Native.AppLevel
@using Alis.Reactive.Fusion.Components
@using Syncfusion.EJ2.Schedule
@using Alis.Reactive.Fusion.Templates
@{
    ViewData["Title"] = "Point-in-Time Schedule";

    var plan = Html.ReactivePlan<PointInTimeScheduleModel>();

    var quickInfoContent = FusionTemplate.Create<ShiftAssignment>()
        .Class("p-3 space-y-2")
        .Div(d => d.Class("font-semibold text-base").Text(m => m.Subject))
        .Div(d => d.Class("text-sm text-gray-600").Text(m => m.Description))
        .When(m => m.IsUnassigned,
            then: t => t.Badge("NEEDS COVERAGE", "px-2 py-1 rounded text-xs font-bold bg-red-100 text-red-700"),
            @else: e => e.Div(d => d.Class("text-xs text-gray-500")
                .Span(m => m.StaffRole, "font-medium")
                .Span(" | ")
                .Span(m => m.StaffPhone)))
        .Render();

    var quickInfoFooter = FusionTemplate.Create<ShiftAssignment>()
        .Class("flex gap-2 p-2 border-t")
        .When(m => m.IsUnassigned,
            then: t => t
                .EventButton("Assign Staff", PointInTimeScheduleEvents.ScheduleEdit, e => e.Id, m => m.Id, "e-primary e-small"),
            @else: e => e
                .EventButton("Edit", PointInTimeScheduleEvents.ScheduleEdit, e => e.Id, m => m.Id, "e-small")
                .EventButton("Reassign", PointInTimeScheduleEvents.ScheduleReassign, e => e.Id, m => m.Id, "e-small"))
        .Render();

    // FusionTemplate.EventButton dispatches detail.id for the parent Active Plan to load the drawer form.
    Html.On(plan, t => t.CustomEvent<ScheduleActionPayload>(PointInTimeScheduleEvents.ScheduleEdit, (payload, p) =>
    {
        p.Element("alis-drawer-title").Text.Set("Edit Shift Assignment");
        p.Component<NativeDrawer>().Size.Set(DrawerSize.Md);
        p.Get(Url.SandboxRoute("EditForm", "Schedule"))
         .Gather<EditAssignmentQuery>(g => g.Set(x => x.AssignmentId, payload.Get(a => a.Id)))
         .Response(r => r.OnSuccess(s => s.Into("alis-drawer-content")));
        p.Component<NativeDrawer>().Open();
    }));

    Html.On(plan, t => t.CustomEvent<ScheduleActionPayload>(PointInTimeScheduleEvents.ScheduleReassign, (payload, p) =>
    {
        p.Element("alis-drawer-title").Text.Set("Reassign Shift");
        p.Component<NativeDrawer>().Size.Set(DrawerSize.Md);
        p.Get(Url.SandboxRoute("EditForm", "Schedule"))
         .Gather<EditAssignmentQuery>(g => g.Set(x => x.AssignmentId, payload.Get(a => a.Id)))
         .Response(r => r.OnSuccess(s => s.Into("alis-drawer-content")));
        p.Component<NativeDrawer>().Open();
    }));

    Html.On(plan, t => t.DomReady(p =>
    {
        p.Element("schedule-week").Text.Set(p.Component<FusionSchedule>("shift-schedule").SelectedDate);
        p.Get("/api/schedule/assignments?selectedFacilityId=mystery-manor")
         .Response(r => r.OnSuccess<ScheduleDataResponse>((json, s) =>
         {
             var shiftSchedule = s.Component<FusionSchedule>("shift-schedule");
             shiftSchedule.EventSettings.DataSource.Set(json.Get(j => j.Assignments));
             shiftSchedule.DataBind();
             s.Element("status").Text.Set("Schedule loaded");
             s.Element("unassigned-count").Text.Set(json.Get(j => j.UnassignedCount));
         }));
    }));
}

<native-vstack gap="Base">
    <native-heading level="H1">Point-in-Time Schedule</native-heading>
    <native-text color="Secondary">
        Senior living shift schedule. Double-click an assignment to edit via SF's built-in editor.
        Change facility to load different data. Navigate weeks to see different assignments.
    </native-text>

    <section class="rounded-lg border border-border bg-white p-4 shadow-sm">
        <native-hstack gap="Lg" wrap="true">
            @{ Html.InputField(plan, m => m.SelectedFacilityId, o => o.Label("Facility"))
                    .FusionDropDownList(b => b
                        .Placeholder("Select facility")
                        .DataSource(FakeScheduleData.Facilities)
                        .Fields<Facility>(t => t.Name, v => v.Id)
                        .Value("mystery-manor"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.Element("status").Text.Set("Loading...");
                        p.Get("/api/schedule/assignments")
                         .Gather<ScheduleAssignmentsQuery>(g => g
                             .Form(m => m.SelectedFacilityId)
                             .Set(x => x.CurrentView, p.Component<FusionSchedule>("shift-schedule").CurrentView)
                             .Set(x => x.CurrentDate, p.Component<FusionSchedule>("shift-schedule").SelectedDate))
                         .Response(r => r.OnSuccess<ScheduleDataResponse>((json, s) =>
                         {
                             var shiftSchedule = s.Component<FusionSchedule>("shift-schedule");
                             shiftSchedule.EventSettings.DataSource.Set(json.Get(j => j.Assignments));
                             shiftSchedule.DataBind();
                             s.Element("status").Text.Set("Facility changed");
                             s.Element("unassigned-count").Text.Set(json.Get(j => j.UnassignedCount));
                         }));
                    }); }
            @{ Html.InputField(plan, m => m.ScheduleLocked, o => o.Label("Lock the schedule for payroll"))
                    .NativeCheckBox(b => b.CssClass("rounded border-border")); }
            @{ Html.InputField(plan, m => m.NeedsCoverageOnly, o => o.Label("Show only shifts that need coverage"))
                    .NativeCheckBox(b => b.CssClass("rounded border-border"))
                    .Reactive(evt => evt.Change, (args, p) =>
                        p.Component<FusionSchedule>("shift-schedule").RefreshEvents()); }
            <native-hstack gap="Sm" class="ml-auto text-sm">
                <span class="text-text-secondary">Unassigned:</span>
                <span id="unassigned-count" class="font-bold text-red-600">--</span>
                <span class="mx-1 text-border">|</span>
                <span class="text-text-secondary">Status:</span>
                <span id="status" class="font-medium text-text-muted">Loading...</span>
            </native-hstack>
            @(Html.NativeButton("print-btn", "Print Schedule")
                .CssClass("px-4 py-2 rounded-md border border-border text-sm font-medium hover:bg-slate-50")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Component<FusionSchedule>("shift-schedule").Print();
                }))
            @(Html.NativeButton("route-template-schedule-btn", "Audit View Route")
                .CssClass("px-4 py-2 rounded-md border border-border text-sm font-medium hover:bg-slate-50")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Get("/api/schedule/view/{currentView}/echo")
                     .Gather<ScheduleViewRequest>(g => g.Set(
                         x => x.CurrentView,
                         p.Component<FusionSchedule>("shift-schedule").CurrentView))
                     .Response(r => r.OnSuccess<ScheduleViewRouteResponse>((json, s) =>
                     {
                         s.Element("route-view").Text.Set(json.Get(x => x.CurrentView));
                     })
                     .Chained(c => c
                         .Get("/api/schedule/view/{currentView}/summary")
                         .Gather<ScheduleViewRequest>(g => g.Set(
                             x => x.CurrentView,
                             p.Component<FusionSchedule>("shift-schedule").CurrentView))
                         .Response(r2 => r2.OnSuccess<ScheduleViewRouteResponse>((json, s) =>
                         {
                             s.Element("route-view-summary").Text.Set(json.Get(x => x.Summary));
                         }))));
                }))
            @(Html.NativeButton("audit-events-btn", "Audit Events")
                .CssClass("px-4 py-2 rounded-md border border-border text-sm font-medium hover:bg-slate-50")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Post("/api/schedule/events/audit")
                     .Gather<ScheduleEventsAuditRequest>(g => g.Set(
                         x => x.Events,
                         p.Component<FusionSchedule>("shift-schedule").GetEvents<ShiftAssignment>()))
                     .Response(r => r.OnSuccess<ScheduleEventsAuditResponse>((json, s) =>
                     {
                         s.Element("schedule-events-count").Text.Set(json.Get(x => x.Count));
                     }));
                }))
        </native-hstack>
        <native-hstack gap="Lg" wrap="true" class="mt-3 text-sm">
            @(Html.NativeButton("schedule-show-morning", "Jump to the AM shift")
                .CssClass("px-3 py-1.5 rounded-md border border-border text-sm font-medium hover:bg-slate-50")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Component<FusionSchedule>("shift-schedule").ScrollTo("06:00")))
            @(Html.NativeButton("schedule-show-night", "Jump to the night shift")
                .CssClass("px-3 py-1.5 rounded-md border border-border text-sm font-medium hover:bg-slate-50")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Component<FusionSchedule>("shift-schedule").ScrollTo("22:00")))
            @* Opens the editor on the week's first shift no one covers; the page's editor is its drawer. *@
            @(Html.NativeButton("cover-next-open-shift", "Cover the next open shift")
                .CssClass("px-3 py-1.5 rounded-md border border-border text-sm font-medium hover:bg-slate-50")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var schedule = p.Component<FusionSchedule>("shift-schedule");
                    schedule.OpenEditor(p.From(schedule.GetEvents<ShiftAssignment>()).Find(x => x.IsUnassigned), ScheduleAction.Save);
                }))
            <span>Showing the week of <span id="schedule-week" class="font-medium"></span></span>
            <span>Selected shift: <span id="selected-shift" class="font-medium">No shift selected.</span></span>
        </native-hstack>
        <p id="schedule-locked-note" class="mt-2 text-sm text-warning" hidden></p>
    </section>

    <section class="rounded-lg border border-border bg-white shadow-sm" style="height: 600px;">
        @(Html.FusionSchedule(plan, "shift-schedule", b =>
            {
                b.Width("100%"); b.Height("100%"); b.CurrentView(View.Week); b.SelectedDate(DateTime.Today);
                b.Views(new List<ScheduleView>
                {
                    new ScheduleView { Option = View.Day },
                    new ScheduleView { Option = View.Week },
                    new ScheduleView { Option = View.WorkWeek },
                    new ScheduleView { Option = View.Month },
                    new ScheduleView { Option = View.Agenda },
                });
                b.Group(new ScheduleGroup { Resources = new string[] { "Shifts" } });
                b.Resources(new List<ScheduleResource>
                {
                    new ScheduleResource
                    {
                        Field = "shiftId", Title = "Shift", Name = "Shifts",
                        DataSource = FakeScheduleData.Shifts,
                        TextField = "text", IdField = "id", ColorField = "color"
                    }
                });
                b.EventSettings(new ScheduleEventSettings
                {
                    EnableTooltip = true,
                    Fields = new ScheduleField
                    {
                        Id = "id",
                        Subject = new ScheduleFieldOptions { Name = "subject" },
                        StartTime = new ScheduleFieldOptions { Name = "startTime" },
                        EndTime = new ScheduleFieldOptions { Name = "endTime" },
                        Description = new ScheduleFieldOptions { Name = "description" },
                        IsAllDay = new ScheduleFieldOptions { Name = "isAllDay" },
                    },
                });
                b.QuickInfoTemplates(new ScheduleQuickInfoTemplates
                {
                    Content = quickInfoContent,
                    Footer = quickInfoFooter,
                });
                b.WorkHours(new ScheduleWorkHours { Highlight = true, Start = "06:00", End = "22:00" });
                b.StartHour("05:00"); b.EndHour("23:00");
                b.TimeScale(new ScheduleTimeScale { Enable = true, Interval = 60, SlotCount = 1 });
                b.ShowHeaderBar(true); b.ShowTimeIndicator(true); b.AllowDragAndDrop(true);
            })
            .Reactive(evt => evt.CellClick, (args, p) =>
            {
                p.Get(Url.SandboxRoute("NewAssignmentForm", "Schedule"))
                 .Gather<NewAssignmentQuery>(g => g
                     .Set(x => x.StartTime, args.StartTime)
                     .Set(x => x.EndTime, args.EndTime)
                     .Set(x => x.GroupIndex, args.GroupIndex)
                     .Form(m => m.SelectedFacilityId))
                 .Response(r => r.OnSuccess(s => s.Into("new-assignment-content")));
                p.Component<FusionDialog>("new-assignment-dialog").Show();
            })
            .Reactive(evt => evt.PopupOpen, (args, p) =>
            {
                // Syncfusion opens QuickInfo for empty cells too, with data that carries no id; cancel only
                // those, since an empty cell opens the new-assignment dialog instead.
                p.When(args.Type).Eq("QuickInfo")
                 .And(args.Data.Get(x => x.Id)).Falsy()
                 .Then(t => { args.Cancel.Set(true); });

                p.When(args.Type).Eq("QuickInfo")
                 .And(args.Data.Get(x => x.Id)).Truthy()
                 .Then(t => t.Element("selected-shift").Text.Set(args.Data.Get(x => x.Subject)));

                // Replace Syncfusion's built-in editor with the app-level drawer.
                p.When(args.Type).Eq("Editor")
                 .Then(t =>
                 {
                     args.Cancel.Set(true);
                     t.Element("alis-drawer-title").Text.Set("Edit Shift Assignment");
                     t.Component<NativeDrawer>().Size.Set(DrawerSize.Md);
                     t.Get(Url.SandboxRoute("EditForm", "Schedule"))
                      .Gather<EditAssignmentQuery>(g => g.Set(x => x.AssignmentId, args.Data.Get(x => x.Id)))
                      .Response(r => r.OnSuccess(s => s.Into("alis-drawer-content")));
                     t.Component<NativeDrawer>().Open();
                 });
            })
            .Reactive(evt => evt.PopupClose, (args, p) =>
            {
                p.When(args.Type).Eq("QuickInfo")
                 .Then(t => t.Element("selected-shift").Text.Set("No shift selected."));
            })
            .Reactive(evt => evt.EventClick, (args, p) =>
            {
                p.When(p.Component<NativeCheckBox>(m => m.ScheduleLocked).Checked).Truthy()
                 .Then(locked =>
                 {
                     args.Cancel.Set(true);
                     locked.Element("schedule-locked-note").Text.Set("The schedule is locked for payroll; unlock it to open a shift.");
                     locked.Element("schedule-locked-note").Show();
                 });
            })
            .Reactive(evt => evt.EventRendered<ShiftAssignment>(), (args, p) =>
            {
                p.When(p.Component<NativeCheckBox>(m => m.NeedsCoverageOnly).Checked).Truthy()
                 .And(args.Data.Get(x => x.IsUnassigned)).Falsy()
                 .Then(t => { args.Cancel.Set(true); });
            })
            .Reactive(evt => evt.ActionBegin, (args, p) =>
            {
                p.When(args.RequestType).Eq("eventChange")
                 .Then(t =>
                 {
                     t.Element("status").Text.Set("Saving...");
                 });

                p.When(args.RequestType).Eq("dateNavigate")
                 .And(p.Component<NativeCheckBox>(m => m.ScheduleLocked).Checked).Truthy()
                 .Then(locked =>
                 {
                     args.Cancel.Set(true);
                     locked.Element("schedule-locked-note").Text.Set("The schedule is locked for payroll; it stays on this week.");
                     locked.Element("schedule-locked-note").Show();
                 });
            })
            .Reactive(evt => evt.ActionComplete, (args, p) =>
            {
                p.When(args.RequestType).Eq("dateNavigate")
                 .Then(t => t.Element("schedule-week").Text.Set(t.Component<FusionSchedule>("shift-schedule").SelectedDate));

                // Syncfusion emits eventChanged after CRUD; reload authoritative assignments then.
                p.When(args.RequestType).Eq("eventChanged")
                 .Then(t =>
                 {
                     t.Element("status").Text.Set("Saved — reloading...");
                     t.Get("/api/schedule/assignments")
                      .Gather<ScheduleAssignmentsQuery>(g => g
                          .Form(m => m.SelectedFacilityId)
                          .Set(x => x.CurrentView, p.Component<FusionSchedule>("shift-schedule").CurrentView)
                          .Set(x => x.CurrentDate, p.Component<FusionSchedule>("shift-schedule").SelectedDate))
                      .Response(r => r.OnSuccess<ScheduleDataResponse>((json, s) =>
                      {
                          var shiftSchedule = s.Component<FusionSchedule>("shift-schedule");
                          shiftSchedule.EventSettings.DataSource.Set(json.Get(j => j.Assignments));
                          shiftSchedule.DataBind();
                          s.Element("status").Text.Set("Refreshed after save");
                          s.Element("unassigned-count").Text.Set(json.Get(j => j.UnassignedCount));
                      }));
                 });
            })
            .Reactive(evt => evt.Navigating, (args, p) =>
            {
                p.Element("status").Text.Set("Navigating...");

                // For view switches, Syncfusion args carry the new currentView.
                p.When(args.Action).Eq("view")
                 .Then(t =>
                 {
                     t.Get("/api/schedule/assignments")
                      .Gather<ScheduleNavigationQuery>(g => g
                          .Form(m => m.SelectedFacilityId)
                          .Set(x => x.CurrentDate, args.CurrentDate)
                          .Set(x => x.CurrentView, args.CurrentView))
                      .Response(r => r.OnSuccess<ScheduleDataResponse>((json, s) =>
                      {
                          var shiftSchedule = s.Component<FusionSchedule>("shift-schedule");
                          shiftSchedule.EventSettings.DataSource.Set(json.Get(j => j.Assignments));
                          shiftSchedule.DataBind();
                          s.Element("status").Text.Set("View loaded");
                          s.Element("unassigned-count").Text.Set(json.Get(j => j.UnassignedCount));
                      }));
                 })
                 // For date navigation, read the unchanged view from the component.
                 .Else(e =>
                 {
                     e.Get("/api/schedule/assignments")
                      .Gather<ScheduleNavigationQuery>(g => g
                          .Form(m => m.SelectedFacilityId)
                          .Set(x => x.CurrentDate, args.CurrentDate)
                          .Set(x => x.CurrentView, e.Component<FusionSchedule>("shift-schedule").CurrentView))
                      .Response(r => r.OnSuccess<ScheduleDataResponse>((json, s) =>
                      {
                          var shiftSchedule = s.Component<FusionSchedule>("shift-schedule");
                          shiftSchedule.EventSettings.DataSource.Set(json.Get(j => j.Assignments));
                          shiftSchedule.DataBind();
                          s.Element("status").Text.Set("Date loaded");
                          s.Element("unassigned-count").Text.Set(json.Get(j => j.UnassignedCount));
                      }));
                 });
            })
            .Reactive(evt => evt.DataBound, (args, p) =>
            {
                p.Element("status").Text.Set("Ready");
            }))
    </section>

    @(Html.FusionDialog(plan, "new-assignment-dialog", b =>
    {
        b.Header("New Assignment");
        b.Width("480px");
        b.IsModal(true);
        b.ShowCloseIcon(true);
        b.CloseOnEscape(true);
        b.Visible(false);
        b.Content("<div id='new-assignment-content'></div>");
    })
    .Reactive(evt => evt.OverlayClick, (args, p) =>
    {
        p.Component<FusionDialog>("new-assignment-dialog").Hide();
    }))

    <section class="rounded-lg border border-border bg-white p-4 shadow-sm">
        <h3 class="text-sm font-semibold mb-2">Event Trace</h3>
        <native-vstack gap="Xs" class="font-mono text-xs">
            <p>Route view: <span id="route-view" class="text-text-muted">--</span></p>
            <p>Route view summary: <span id="route-view-summary" class="text-text-muted">--</span></p>
            <p>Schedule events: <span id="schedule-events-count" class="text-text-muted">--</span></p>
        </native-vstack>
    </section>

</native-vstack>

@Html.RenderPlan(plan)
