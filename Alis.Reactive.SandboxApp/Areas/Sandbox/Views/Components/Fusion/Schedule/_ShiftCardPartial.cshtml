@model ShiftCardModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Fusion.Components
@{
    var plan = Html.ResolvePlan<ShiftCardModel>();
}

<div class="flex flex-col gap-2 p-3">
    <p class="text-sm text-text-secondary">Handover for @Model.Subject</p>
    @(Html.FusionProgressButton(plan, "acknowledge-handover-btn", b => b
        .Content("Acknowledge handover")
        .Duration(300)
        .EnableProgress(true))
        .Reactive(evt => evt.Began, (args, p) =>
        {
            p.Element("shift-card-status").SetText($"Handover acknowledged for {Model.Subject}.");
        }))
    <p id="shift-card-status" class="text-sm text-text-muted">Handover not acknowledged yet.</p>
</div>

@Html.EJS().ScriptManager()
@Html.RenderPlan(plan)
