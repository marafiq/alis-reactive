@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Kanban
@model MaintenanceBoardModel
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Fusion.Templates
@using Alis.Reactive.Native.Components
@using Syncfusion.EJ2.Kanban
@{
    ViewData["Title"] = "Maintenance Board";

    const string BoardId = "maintenance-board";
    // The Blocked column goes between In Progress and Done.
    const int BlockedColumnIndex = 2;
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string FinishedWorkIsClosed = "Finished work is closed. Open a new work order if the problem comes back.";

    var plan = Html.ReactivePlan<MaintenanceBoardModel>();

    // The work order members the board reads, named by the work order's own members.
    var number = Field.Of((WorkOrder w) => w.Number).Name;
    var status = Field.Of((WorkOrder w) => w.Status).Name;
    var wing = Field.Of((WorkOrder w) => w.Wing).Name;
    var wingName = Field.Of((WorkOrder w) => w.WingName).Name;
    var room = Field.Of((WorkOrder w) => w.Room).Name;
    var summary = Field.Of((WorkOrder w) => w.Summary).Name;
    var queue = Field.Of((WorkOrder w) => w.Queue).Name;

    var workOrderCard = FusionTemplate.Create<WorkOrder>()
        .Class("space-y-1 text-sm")
        .Div(top => top.Class("flex items-start justify-between gap-2")
            .Span(w => w.Summary, "font-semibold")
            .When(w => w.Priority == WorkOrderPriority.Urgent,
                urgent => urgent.Badge("Urgent", "rounded bg-red-100 px-2 py-0.5 text-xs font-bold text-red-700")))
        .Div(where => where.Class("flex items-center justify-between gap-2 text-xs text-text-muted")
            .Span(w => w.Room)
            .When(w => w.Technician == "",
                unassigned => unassigned.Span("Unassigned", "italic"),
                assigned => assigned.Span(w => w.Technician)))
        .Render();

    // The work-order system holds the board's work orders; the board shows them once they arrive.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("Board", "Kanban"))
         .Response(r => r.OnSuccess<MaintenanceBoard>((json, s) =>
         {
             var board = s.Component<FusionKanban>(BoardId);
             board.Cards<WorkOrder>().Set(json.Get(x => x.WorkOrders));
             board.DataBind();
         }))));
}

<native-vstack gap="Lg">
    <native-heading level="H1">Maintenance Board</native-heading>
    <native-text color="Secondary">
        Maple Grove, Maple and Birch wings. Drag a work order to its new column or double-click it to edit it;
        the board shows each change once the work-order system has it.
    </native-text>
    <p class="text-sm font-medium"><span id="urgent-count">0</span> urgent work orders on the board</p>

    <native-hstack gap="Sm" class="flex-wrap items-center">
        @(Html.NativeButton("new-work-order-btn", "New work order")
            .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
            {
                // The work-order system reserves the number; the lead describes the work in the card dialog.
                p.Post(Url.SandboxRoute("Draft", "Kanban"))
                 .Response(r => r.OnSuccess<WorkOrderDraft>((json, s) =>
                     s.Component<FusionKanban>(BoardId).OpenDialog<WorkOrder>(BoardRequestType.AddDialog, json.Get(x => x.WorkOrder))));
            }))
        @(Html.NativeButton("front-desk-calls-btn", "Front desk calls")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (_, p) =>
            {
                // An urgent call goes to the top of Open.
                p.Get(Url.SandboxRoute("FrontDeskCall", "Kanban"))
                 .Response(r => r
                    .OnSuccess<FrontDeskCalls>((json, s) =>
                        s.Component<FusionKanban>(BoardId).AddCard(json.Get(x => x.WorkOrder), 0))
                    .OnError<FrontDeskCalls>(404, (json, e) =>
                        e.Element("board-status").Text.Set(json.Get(x => x.Message))));
            }))
        @(Html.NativeButton("send-work-lists-btn", "Send work lists")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (_, p) =>
            {
                // The board waits while the lists for the night technician go out.
                var board = p.Component<FusionKanban>(BoardId);
                board.ShowSpinner();
                p.Post(Url.SandboxRoute("WorkLists", "Kanban"))
                 .Gather<WorkLists>(g => g
                     .Set(x => x.InProgress, board.GetColumnData<WorkOrder>(WorkOrderStatus.InProgress))
                     .Set(x => x.MapleWing, board.GetSwimlaneData<WorkOrder>(MaintenanceWing.Maple)))
                 .Response(r => r.OnSuccess<WorkListsSent>((json, s) =>
                     s.Element("board-status").Text.Set(json.Get(x => x.Message))))
                 .Finally(f => f.Component<FusionKanban>(BoardId).HideSpinner());
            }))
        @(Html.NativeButton("file-away-finished-work-btn", "File away finished work")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (_, p) =>
            {
                var finished = p.Component<FusionKanban>(BoardId).GetColumnData<WorkOrder>(WorkOrderStatus.Done);
                p.When(p.From(finished).Any()).Truthy()
                    .Then(t => t.Component<FusionKanban>(BoardId).DeleteCard(finished))
                    .Else(e => e.Element("board-status").Text.Set("There is no finished work to file away."));
            }))
        @{ Html.InputField(plan, m => m.ShowFinishedWork, o => o.Label("Show finished work"))
            .NativeCheckBox(b => b.CssClass("rounded border-border"))
            .Reactive(evt => evt.Change, (args, p) =>
                p.When(args.Checked).Truthy()
                    .Then(t => t.Component<FusionKanban>(BoardId).ShowColumn(WorkOrderStatus.Done))
                    .Else(e => e.Component<FusionKanban>(BoardId).HideColumn(WorkOrderStatus.Done))); }
    </native-hstack>

    <div class="space-y-1">
        <p id="board-status" class="text-sm" role="status">The board is up to date.</p>
        <p id="board-saving" hidden class="text-sm text-text-muted">Saving <span id="board-saving-work"></span> with the work-order system…</p>
        <p id="drag-hint" hidden class="text-sm text-text-muted">Moving <span id="drag-hint-work"></span>: drop it in its new column.</p>
    </div>

    <div id="parts-notice" hidden class="flex flex-wrap items-center gap-3 rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm">
        <span><span id="parts-column" class="font-medium"></span>: <span id="parts-count"></span>. The brake cable for Maple 118's wheelchair is on order.</span>
        @(Html.NativeButton("part-arrived-btn", "Part arrived")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (_, p) =>
            {
                // The work order goes back in progress and the Blocked column goes away.
                p.Post(Url.SandboxRoute("PartArrived", "Kanban"))
                 .Response(r => r.OnSuccess<PartArrival>((json, s) =>
                 {
                     var board = s.Component<FusionKanban>(BoardId);
                     board.UpdateCard(json.Get(x => x.WorkOrder));
                     board.DeleteColumn(BlockedColumnIndex);
                     s.Element("parts-notice").Hide();
                 }));
            }))
    </div>

    <div class="flex flex-col gap-4 lg:flex-row lg:items-start">
        <native-card class="min-w-0 flex-1"><native-card-body>
            @(Html.FusionKanban(plan, BoardId, b =>
            {
                b.Width("100%");
                b.Height("auto");
                b.KeyField(status);
                b.DataSource(new List<WorkOrder>());
                b.AllowDragAndDrop(true);
                b.CardSettings(new KanbanCardSettings { HeaderField = number, ContentField = summary, Template = workOrderCard });
                // Each column is a line: the work-order system keeps the place of every work order in it.
                b.SortSettings(new KanbanSortSettings { SortBy = SortOrderBy.Custom, Field = queue });
                b.SwimlaneSettings(new KanbanSwimlaneSettings { KeyField = wing, TextField = wingName, ShowItemCount = false });
                b.DialogSettings(new KanbanDialogSettings
                {
                    Fields = new List<object>
                    {
                        new { key = number, text = "Work order", type = "TextBox" },
                        new { key = status, text = "Status", type = "DropDown" },
                        new { key = wing, text = "Wing", type = "DropDown" },
                        new { key = room, text = "Room", type = "TextBox" },
                        new { key = summary, text = "Problem", type = "TextArea" }
                    }
                });
                b.Columns(new List<KanbanColumn>
                {
                    new KanbanColumn { HeaderText = "Open", KeyField = WorkOrderStatus.Open },
                    new KanbanColumn { HeaderText = "In Progress", KeyField = WorkOrderStatus.InProgress },
                    // The board shows finished work only on the day it is finished, so the column counts nothing.
                    new KanbanColumn { HeaderText = "Done", KeyField = WorkOrderStatus.Done, ShowItemCount = false }
                });
            })
            .Reactive(evt => evt.DataBinding<WorkOrder>(), (args, p) =>
                p.Element("urgent-count").Text.Set(p.From(args.Result).Count(w => w.Priority == WorkOrderPriority.Urgent)))
            .Reactive(evt => evt.DataBound, (_, p) => p.Element("board-saving").Hide())
            .Reactive(evt => evt.CardRendered<WorkOrder>(), (args, p) =>
                // Finished work stays on the board for its day.
                p.When(args.Data.Get(w => w.Status)).Eq(WorkOrderStatus.Done).And(args.Data.Get(w => w.FinishedToday)).Falsy()
                    .Then(_ => args.Cancel.Set(true)))
            .Reactive(evt => evt.QueryCellInfo, (args, p) =>
                // The header of the Blocked column says how much work waits on parts.
                p.When(args.RequestType).Eq(BoardRequestType.HeaderRow)
                    .And(args.Data.Get(x => x[0].KeyField)).Eq(WorkOrderStatus.Blocked)
                    .Then(t =>
                    {
                        t.Element("parts-column").Text.Set(args.Data.Get(x => x[0].TextField));
                        t.Element("parts-count").Text.Set(args.Data.Get(x => x[0].Count));
                        t.Element("parts-notice").Show();
                    }))
            .Reactive(evt => evt.CardClick<WorkOrder>(), (args, p) =>
            {
                p.Element("work-order-hint").Hide();
                p.Element("work-order-title").Text.Set(args.Data.Get(w => w.Summary));
                p.Element("work-order-room").Text.Set(args.Data.Get(w => w.Room));
                p.Element("work-order-technician").Text.Set(args.Data.Get(w => w.Technician));
                p.Element("work-order-details").Show();
                p.Get(Url.SandboxRouteTemplate("History", "Kanban", "workOrderNumber"))
                 .Gather<WorkOrderLookup>(g => g.Set(x => x.WorkOrderNumber, args.Data.Get(w => w.Number)))
                 .Response(r => r.OnSuccess<WorkOrderHistory>((json, s) =>
                     s.Element("work-order-history").Text.Set(json.Get(x => x.History))));
            })
            .Reactive(evt => evt.CardDoubleClick<WorkOrder>(), (args, p) =>
                p.When(args.Data.Get(w => w.Status)).Eq(WorkOrderStatus.Done)
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("board-status").Text.Set(FinishedWorkIsClosed);
                    }))
            .Reactive(evt => evt.DragStart<WorkOrder>(), (args, p) =>
                p.When(args.Data.Get(x => x[0].Status)).Eq(WorkOrderStatus.Done)
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("board-status").Text.Set(FinishedWorkIsClosed);
                    })
                    .Else(e => e.Element("drag-hint-work").Text.Set(args.Data.Get(x => x[0].Summary))))
            .Reactive(evt => evt.Drag<WorkOrder>(), (_, p) => p.Element("drag-hint").Show())
            .Reactive(evt => evt.DragStop<WorkOrder>(), (args, p) =>
            {
                p.Element("drag-hint").Hide();
                // Urgent work is the next job: it goes to the top of In Progress.
                p.When(args.Data.Get(x => x[0].Priority)).Eq(WorkOrderPriority.Urgent)
                    .And(args.Data.Get(x => x[0].Status)).Eq(WorkOrderStatus.InProgress)
                    .And(args.DropIndex).Gt(0)
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("board-status").Text.Set("Urgent work goes to the top of In Progress.");
                    });
            })
            .Reactive(evt => evt.ActionBegin<WorkOrder>(), (args, p) =>
            {
                p.When(args.RequestType).Eq(BoardRequestType.Changing)
                    .And(args.ChangedRecords.Get(x => x[0].Status)).Eq(WorkOrderStatus.Done)
                    .And(args.ChangedRecords.Get(x => x[0].Technician)).IsEmpty()
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("board-status").Text.Set("Assign a technician before marking the work done.");
                    });
                p.When(args.RequestType).Eq(BoardRequestType.Removing)
                    .And(p.From(args.DeletedRecords).Any(w => !w.SignedOff)).Truthy()
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("board-status").Text.Set("Finished work is filed away only after the resident signs off.");
                    });
            })
            .Reactive(evt => evt.ActionComplete<WorkOrder>(), (args, p) =>
            {
                // The board shows a change once the work-order system has it, so it does not draw it now.
                p.When(args.RequestType).In(BoardRequestType.Added, BoardRequestType.Changed, BoardRequestType.Removed)
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("board-saving").Show();
                    });
                p.When(args.RequestType).Eq(BoardRequestType.Added)
                    .Then(t => t.Element("board-saving-work").Text.Set(args.AddedRecords.Get(x => x[0].Summary)))
                    .ElseIf(args.RequestType).Eq(BoardRequestType.Changed)
                    .Then(t => t.Element("board-saving-work").Text.Set(args.ChangedRecords.Get(x => x[0].Summary)))
                    .ElseIf(args.RequestType).Eq(BoardRequestType.Removed)
                    .Then(t => t.Element("board-saving-work").Text.Set("the finished work"));
            })
            .Reactive(evt => evt.DataSourceChanged<WorkOrder>(), (args, p) =>
                p.Post(Url.SandboxRoute("Commit", "Kanban"))
                 .Gather<WorkOrderChange>(g => g
                     .Set(x => x.RequestType, args.RequestType)
                     .Set(x => x.AddedRecords, args.AddedRecords)
                     .Set(x => x.ChangedRecords, args.ChangedRecords)
                     .Set(x => x.DeletedRecords, args.DeletedRecords)
                     .Set(x => x.Index, args.Index))
                 .Response(r => r
                    .OnSuccess<MaintenanceBoard>((json, s) =>
                    {
                        args.EndEdit();
                        s.When(json.Get(x => x.BackOrdered)).Truthy()
                            .Then(t => t.Component<FusionKanban>(BoardId).AddColumn(
                                new FusionKanbanColumn { HeaderText = "Waiting on parts", KeyField = WorkOrderStatus.Blocked, AllowToggle = true, IsExpanded = false },
                                BlockedColumnIndex));
                        var board = s.Component<FusionKanban>(BoardId);
                        board.Cards<WorkOrder>().Set(json.Get(x => x.WorkOrders));
                        board.DataBind();
                        s.Element("board-status").Text.Set(json.Get(x => x.Message));
                    })
                    .OnError<WorkOrderRefusal>(409, (refusal, e) =>
                    {
                        // The change never reached the board: it stops waiting and leaves the work order as it was.
                        args.CancelEdit();
                        e.Element("board-saving").Hide();
                        e.Element("board-status").Text.Set(refusal.Get(x => x.Message));
                    })))
            .Reactive(evt => evt.DialogOpen<WorkOrder>(), (args, p) =>
                p.When(args.RequestType).Eq(BoardRequestType.DeleteDialog)
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("board-status").Text.Set("Work orders leave the board when finished work is filed away.");
                    })
                    // A work order another technician is updating closes again and says who has it.
                    .ElseIf(args.RequestType).Eq(BoardRequestType.EditDialog)
                    .Then(t =>
                        t.Get(Url.SandboxRouteTemplate("Hold", "Kanban", "workOrderNumber"))
                         .Gather<WorkOrderLookup>(g => g.Set(x => x.WorkOrderNumber, args.Data.Get(w => w.Number)))
                         .Response(r => r.OnSuccess<WorkOrderHold>((hold, s) =>
                             s.When(hold.Get(x => x.HeldBy)).NotEmpty()
                                 .Then(held =>
                                 {
                                     held.Component<FusionKanban>(BoardId).CloseDialog();
                                     held.Element("board-status").Text.Set(hold.Get(x => x.Message));
                                 })))))
            .Reactive(evt => evt.DialogClose<WorkOrder>(), (args, p) =>
                p.When(args.RequestType).Eq(BoardRequestType.EditDialog).And(args.Data.Get(w => w.Room)).IsEmpty()
                    .Then(t =>
                    {
                        args.Cancel.Set(true);
                        t.Element("board-status").Text.Set("A work order keeps its room. Name the room before saving.");
                    })))
        </native-card-body></native-card>

        <aside class="rounded-lg border border-border bg-white p-4 text-sm lg:w-72" aria-label="Work order">
            <p id="work-order-hint" class="text-text-muted">Click a work order to see its details.</p>
            <div id="work-order-details" hidden class="space-y-2">
                <h2 id="work-order-title" class="text-base font-semibold"></h2>
                <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
                    <dt class="text-text-muted">Room</dt>
                    <dd id="work-order-room"></dd>
                    <dt class="text-text-muted">Technician</dt>
                    <dd id="work-order-technician"></dd>
                </dl>
                <p id="work-order-history" class="text-text-muted"></p>
            </div>
        </aside>
    </div>
</native-vstack>

@Html.RenderPlan(plan)
