@model DialogModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Discharge Review";

    var plan = Html.ReactivePlan<DialogModel>();
    var summaryUrl = Url.SandboxRoute("DischargeSummary", "Dialog");
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Discharge Review</native-heading>
        <native-text color="Secondary">Margaret Hale · Room 214 · Assisted Living</native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.CareTasksOpen, o => o.Label("Care tasks are still open"))
                .NativeCheckBox(b => b.CssClass("rounded border-border")); }

            @(Html.NativeButton("review-discharge", "Review discharge")
                .CssClass("self-start rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (args, p) =>
                    p.Component<FusionDialog>("discharge-dialog").Show()))

            <p id="discharge-blocked" class="text-sm text-warning" hidden>Close Margaret's open care tasks before reviewing her discharge.</p>
            <native-text>Discharge review: <span id="discharge-status">not started</span></native-text>
            <native-text><span id="discharge-decision"></span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    @* The review asks for an explicit choice: Escape, the close icon and a click outside do not
       dismiss it; "Not yet" does. *@
    @(Html.FusionDialog(plan, "discharge-dialog", b =>
    {
        b.Header("Confirm discharge");
        b.Content("<div id='discharge-summary'></div><p id='discharge-choose' class='mt-3 text-sm text-warning' hidden>Choose Confirm discharge or Not yet.</p>");
        b.IsModal(true);
        b.Width("460px");
        b.ShowCloseIcon(true);
        b.CloseOnEscape(true);
        b.Visible(false);
    })
    .Reactive(evt => evt.BeforeOpen, (args, p) =>
    {
        p.When(p.Component<NativeCheckBox>(m => m.CareTasksOpen).Checked).Truthy()
            .Then(blocked =>
            {
                args.Cancel.Set(true);
                blocked.Element("discharge-blocked").Show();
            })
            .Else(clear => clear.Element("discharge-blocked").Hide());
    })
    .Reactive(evt => evt.Open, (args, p) =>
    {
        p.Element("discharge-status").Text.Set("in progress");
        p.Get(summaryUrl).Response(r => r.OnSuccess(s => s.Into("discharge-summary")));
    })
    .Reactive(evt => evt.BeforeClose, (args, p) =>
    {
        p.When(args.IsInteracted).Truthy()
            .Then(asked =>
            {
                args.Cancel.Set(true);
                asked.Element("discharge-choose").Show();
            });
    })
    .Reactive(evt => evt.Close, (args, p) =>
        p.Element("discharge-status").Text.Set("closed"))
    .Reactive(evt => evt.OverlayClick, (args, p) =>
        p.Element("discharge-choose").Show()))
</native-vstack>

@Html.RenderPlan(plan)
