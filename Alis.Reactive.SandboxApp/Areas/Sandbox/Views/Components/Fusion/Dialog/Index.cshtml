@model DialogModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionDialog";

    var plan = Html.ReactivePlan<DialogModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">FusionDialog — Full API</native-heading>
        <native-text color="Secondary">
            Non-input modal component. Exercises Show / Hide methods and BeforeOpen, Opened,
            BeforeClose, Closed, OverlayClick events. Senior living domain: confirming a resident discharge.
        </native-text>
    </div>

    <!-- Section 1: Open the Dialog -->
    <native-card><native-card-body>
        <native-heading level="H2">1. Open the Dialog (Show method)</native-heading>
        <p class="text-sm text-text-secondary mb-4">
            Click the button to call <code>Component&lt;FusionDialog&gt;("discharge-dialog").Show()</code>.
        </p>

        @(Html.NativeButton("open-dialog-btn", "Confirm Discharge")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
            {
                p.Component<FusionDialog>("discharge-dialog").Show();
            }))
    </native-card-body></native-card>

    <!-- Section 2: The Dialog Component -->
    <native-card><native-card-body>
        <native-heading level="H2">2. Dialog Component</native-heading>
        <p class="text-sm text-text-secondary mb-4">
            Modal dialog with a header, content, and a close icon. The reactive wiring updates the
            event log when each lifecycle event fires.
        </p>

        @(Html.FusionDialog(plan, "discharge-dialog", b =>
        {
            b.Header("Confirm Discharge");
            b.Content("<p>Are you sure you want to discharge this resident? This action cannot be undone.</p>");
            b.IsModal(true);
            b.Width("420px");
            b.ShowCloseIcon(true);
            b.CloseOnEscape(true);
            b.Visible(false);
        })
        .Reactive(evt => evt.BeforeOpen, (_, p) =>
        {
            p.Element("dialog-before-open").SetText("beforeOpen fired");
        })
        .Reactive(evt => evt.Opened, (_, p) =>
        {
            p.Element("dialog-opened").SetText("opened");
        })
        .Reactive(evt => evt.BeforeClose, (_, p) =>
        {
            p.Element("dialog-before-close").SetText("beforeClose fired");
        })
        .Reactive(evt => evt.Closed, (_, p) =>
        {
            p.Element("dialog-closed").SetText("closed");
        })
        .Reactive(evt => evt.OverlayClick, (_, p) =>
        {
            p.Element("dialog-overlay-click").SetText("overlay clicked");
            p.Component<FusionDialog>("discharge-dialog").Hide();
        }))
    </native-card-body></native-card>

    <!-- Section 3: Hide via External Button -->
    <native-card><native-card-body>
        <native-heading level="H2">3. Hide the Dialog (Hide method)</native-heading>
        <p class="text-sm text-text-secondary mb-4">
            Calls <code>Component&lt;FusionDialog&gt;("discharge-dialog").Hide()</code>.
        </p>

        @(Html.NativeButton("close-dialog-btn", "Cancel Discharge")
            .CssClass("rounded-md border border-border bg-white px-4 py-2 text-sm font-medium hover:bg-surface-muted transition-colors")
            .Reactive(plan, evt => evt.Click, (_, p) =>
            {
                p.Component<FusionDialog>("discharge-dialog").Hide();
            }))
    </native-card-body></native-card>

    <!-- Section 4: Event Log -->
    <native-card><native-card-body>
        <native-heading level="H2">4. Event Log</native-heading>
        <p class="text-sm text-text-secondary mb-4">
            Each lifecycle event updates its own status line as the dialog opens and closes.
        </p>
        <div class="font-mono text-sm space-y-1">
            <p>BeforeOpen:   <span id="dialog-before-open" class="text-text-muted">&mdash;</span></p>
            <p>Opened:       <span id="dialog-opened" class="text-text-muted">&mdash;</span></p>
            <p>BeforeClose:  <span id="dialog-before-close" class="text-text-muted">&mdash;</span></p>
            <p>Closed:       <span id="dialog-closed" class="text-text-muted">&mdash;</span></p>
            <p>OverlayClick: <span id="dialog-overlay-click" class="text-text-muted">&mdash;</span></p>
        </div>
    </native-card-body></native-card>

    <!-- Plan JSON — always last -->
    <native-card><native-card-body>
        <native-heading level="H2">Plan JSON</native-heading>
        <pre id="plan-json" class="text-xs overflow-auto max-h-96">@Html.Raw(plan.RenderFormatted())</pre>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
