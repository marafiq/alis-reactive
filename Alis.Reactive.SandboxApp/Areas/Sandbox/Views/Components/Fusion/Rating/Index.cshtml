@model RatingModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionRating";

    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string SubmitReady = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<RatingModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Monthly Care Satisfaction Survey</native-heading>
        <native-text color="Secondary">
            We carried over the rating you submitted last month. Review it, update it if your experience has changed, then submit.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.SatisfactionScore, o => o.Label("Overall satisfaction with your care this month"))
                .FusionRating(b => b
                    .Value(Model.SatisfactionScore)
                    .Min(0)
                    .ItemsCount(5)
                    .AllowReset(true)
                    .ShowLabel(true)
                    .Reactive(plan, evt => evt.ValueChanged, (args, p) =>
                    {
                        p.Element("survey-rating").SetText(args, x => x.Value);

                        p.When(args, x => x.Value).Gte(4d)
                            .Then(high => high.Element("survey-sentiment")
                                .SetText("We're so glad your care is meeting your expectations."))
                            .ElseIf(args, x => x.Value).Gte(1d)
                            .Then(mid => mid.Element("survey-sentiment")
                                .SetText("Thank you. A care manager will follow up to see how we can improve."))
                            .Else(none => none.Element("survey-sentiment")
                                .SetText("Please choose a rating to tell us how your care has been."));

                        p.Element("survey-change-note").SetText(args, x => x.PreviousValue);

                        p.When(args, x => x.IsInteracted).Truthy()
                            .Then(ready => ready.Element("survey-readiness")
                                .SetText("Thank you for rating your care yourself — your rating is ready to submit."))
                            .Else(cleared => cleared.Element("survey-readiness")
                                .SetText("Your rating was cleared. Please rate your care to continue."));
                    })); }

            <native-vstack gap="Xs">
                <native-text>
                    Your rating: <span id="survey-rating" class="font-semibold text-text">@Model.SatisfactionScore</span> of 5 stars
                </native-text>
                <native-text color="Secondary"><span id="survey-sentiment">This is the rating you submitted last month.</span></native-text>
                <native-text color="Secondary">Previous rating before this change: <span id="survey-change-note">@Model.SatisfactionScore</span> stars</native-text>
            </native-vstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("restore-rating", "Restore my last submitted rating")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionRating>(m => m.SatisfactionScore).SetValue(Model.SatisfactionScore);
                        p.Element("survey-rating").SetText(p.Component<FusionRating>(m => m.SatisfactionScore).Value());
                        p.Element("survey-sentiment").SetText("Restored the rating you submitted last month.");
                    }))
                @(Html.NativeButton("clear-rating", "Clear my rating")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionRating>(m => m.SatisfactionScore).Reset();
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-text color="Secondary"><span id="survey-readiness">Adjust your rating above, then submit.</span></native-text>
            @(Html.NativeButton("survey-submit", "Submit my satisfaction rating")
                .CssClass(SubmitReady)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var rating = p.Component<FusionRating>(m => m.SatisfactionScore);
                    p.Post(Url.SandboxRoute("Echo", "Rating"))
                        .Gather(g => g.Include(rating.Value(), "satisfactionScore"))
                        .Response(r => r.OnSuccess<RatingEchoResponse>((json, s) =>
                        {
                            s.Element("survey-confirmation").SetText(json, x => x.Summary);
                            s.Element("survey-confirmation-panel").RemoveClass("hidden");
                        }));
                }))
            <div id="survey-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="survey-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
