@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.Rating
@model SatisfactionSurveyModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Care Satisfaction Survey";

    const string Button = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string PrimaryButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var lastMonthScore = Model.LastMonthScore;
    var plan = Html.ReactivePlan<SatisfactionSurveyModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Monthly Care Satisfaction Survey</native-heading>
        <native-text color="Secondary">October · Margaret Hale, Maple 214</native-text>
    </div>

    <native-card><native-card-body id="satisfaction-survey">
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.SatisfactionScore, o => o.Label("How would you rate the care you received in October?"))
                .FusionRating(b => b
                    .Value(Model.SatisfactionScore)
                    .ItemsCount(5)
                    .ShowLabel(true))
                .Reactive(evt => evt.ValueChanged, (args, p) =>
                {
                    p.When(args.IsInteracted).Falsy()
                        .Then(cleared =>
                        {
                            cleared.Element("survey-reply").Text.Set("Your rating is cleared. Choose the stars that match October's care.");
                            cleared.Element("what-changed").Hide();
                        })
                        .ElseIf(args.Value).Lt(args.PreviousValue)
                        .Then(lowered =>
                        {
                            lowered.Element("survey-reply").Text.Set("You lowered your rating. Tell us what made October harder.");
                            lowered.Element("what-changed").Show();
                        })
                        .ElseIf(args.Value).Gte(4d)
                        .Then(glad => glad.Element("survey-reply").Text.Set("We're glad October's care went well."))
                        .Else(call => call.Element("survey-reply").Text.Set("Thank you for telling us. Maple wing's care manager will call you this week."));
                }); }

            <p id="survey-reply" class="text-sm">Choose the stars that match October's care.</p>

            <div id="what-changed" hidden>
                @{ Html.InputField(plan, m => m.WhatChanged, o => o.Label("What made October harder?"))
                    .NativeTextArea(b => b.Rows(3).CssClass("w-full rounded-md border border-border px-3 py-2 text-sm")); }
            </div>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("same-as-last-month-btn", "Same as September")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.Component<FusionRating>(m => m.SatisfactionScore).Value.Set(lastMonthScore);
                        p.Element("survey-reply").Text.Set("The same as September.");
                    }))
                @(Html.NativeButton("clear-rating-btn", "Clear my rating")
                    .CssClass(Button)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Component<FusionRating>(m => m.SatisfactionScore).Reset()))
                @(Html.NativeButton("send-survey-btn", "Send my rating")
                    .CssClass(PrimaryButton)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                    {
                        p.Post(Url.SandboxRoute("Send", "Rating"))
                            .Gather<SurveyResponse>(g => g
                                .Set(x => x.SatisfactionScore, p.Component<FusionRating>(m => m.SatisfactionScore).Value)
                                .Set(x => x.WhatChanged, p.Component<NativeTextArea>(m => m.WhatChanged).Value))
                            .Validate<SatisfactionSurveyValidator>("satisfaction-survey")
                            .Response(r => r
                                .OnSuccess<SurveyAnswer>((recorded, s) =>
                                {
                                    s.Element("survey-recorded").Text.Set(recorded.Get(x => x.Message));
                                    s.Element("survey-recorded").Show();
                                })
                                .OnError(400, e => e.ValidationErrors("satisfaction-survey")));
                    }))
            </native-hstack>

            <p id="survey-recorded" hidden class="rounded-md border border-green-300 bg-green-50 p-4 text-sm font-medium text-green-800"></p>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
