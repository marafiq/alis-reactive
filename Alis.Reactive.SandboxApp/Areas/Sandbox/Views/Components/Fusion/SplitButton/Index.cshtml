@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.SplitButton
@model FusionSplitButtonModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Native.Components
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Care Note";

    const string SaveId = "care-note-save";
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";

    var plan = Html.ReactivePlan<FusionSplitButtonModel>();
    var saveUrl = Url.SandboxRoute("Save", "SplitButton");
    var kinds = new List<SelectListItem>
    {
        new SelectListItem("Daily care", "Daily care"),
        new SelectListItem("Fall", "Fall"),
        new SelectListItem("Medication change", "Medication change")
    };

    // What the coordinator sees once the chart answers: a saved note is saved again as changes, and a
    // follow-up that is done leaves the save menu.
    void ShowSaved(Data<CareNoteSaved> saved, PipelineBuilder<FusionSplitButtonModel> s)
    {
        var save = s.Component<FusionSplitButton>(SaveId);
        s.Element("care-note-status").Text.Set(saved.Get(x => x.Message));
        s.When(saved.Get(x => x.Saved)).Truthy().Then(t =>
        {
            save.Content.Set("Save changes");
            save.RemoveItems(saved.Get(x => x.FinishedActions), true);
        });
    }
}

<native-vstack gap="Lg">
    <native-heading level="H1">Care Note</native-heading>
    <native-text color="Secondary">Margaret Hale, Maple 214. Write what happened, sign it, and save it to her chart.</native-text>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.Kind, o => o.Label("About"))
                .NativeDropDown(b => b.Items(kinds).CssClass(Field))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    // A note about a fall marks the save button: the family hears about every fall.
                    var save = p.Component<FusionSplitButton>(SaveId);
                    p.When(args.Value).Eq("Fall")
                        .Then(t => save.CssClass.Set("e-warning"))
                        .Else(e => save.CssClass.Set("e-primary"));
                }); }
            @{ Html.InputField(plan, m => m.Note, o => o.Label("What happened"))
                .NativeTextArea(b => b.Rows(4).CssClass(Field)); }
            @{ Html.InputField(plan, m => m.Signed, o => o.Label("I gave or saw this care myself"))
                .NativeCheckBox(b => b.CssClass("rounded border-border"))
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    // A disabled button takes no focus: Save is enabled at once, then given the keyboard.
                    var save = p.Component<FusionSplitButton>(SaveId);
                    p.When(args.Checked).Truthy()
                        .Then(t =>
                        {
                            save.Disabled.Set(false);
                            save.DataBind();
                            save.FocusIn();
                        })
                        .Else(e => save.Disabled.Set(true));
                }); }

            <native-hstack gap="Base" align="Center" class="flex-wrap">
                @(Html.FusionSplitButton(plan, SaveId, b => b
                    .Content("Save note")
                    .CssClass("e-primary")
                    .Disabled(true)
                    .Items(new[]
                    {
                        new { id = "notify-family", text = "Save and notify family" },
                        new { id = "flag-nurse", text = "Save and flag for the nurse" }
                    }))
                    .Reactive(evt => evt.Click, (_, p) =>
                    {
                        // A new note about a fall is not saved quietly: the save menu opens on the family's option.
                        var kind = p.Component<NativeDropDown>(m => m.Kind);
                        var save = p.Component<FusionSplitButton>(SaveId);
                        p.When(kind.Value).Eq("Fall").And(save.Content).Eq("Save note")
                            .Then(fall =>
                            {
                                fall.Element("care-note-status").Text.Set("A fall is shared with the family. Choose Save and notify family.");
                                save.Toggle();
                            })
                            .Else(plain => plain.Post(saveUrl)
                                .Gather<CareNoteSave>(g => g.Form(m => m.Kind, m => m.Note).Set(x => x.Action, "save"))
                                .Response(r => r.OnSuccess<CareNoteSaved>(ShowSaved)));
                    })
                    .Reactive(evt => evt.Select, (args, p) =>
                    {
                        p.Post(saveUrl)
                            .Gather<CareNoteSave>(g => g.Form(m => m.Kind, m => m.Note).Set(x => x.Action, args.Item.Get(x => x.Id)))
                            .Response(r => r.OnSuccess<CareNoteSaved>((saved, s) =>
                            {
                                ShowSaved(saved, s);
                                s.When(saved.Get(x => x.Saved)).Truthy().Then(t =>
                                {
                                    t.Element("care-note-last-action").Text.Set(args.Item.Get(x => x.Text));
                                    t.Element("care-note-last-action-line").Show();
                                });
                            }));
                    }))
                <p id="care-note-status" class="text-sm font-medium">Not saved yet.</p>
            </native-hstack>
            <p id="care-note-last-action-line" hidden class="text-xs text-text-muted">Last action: <span id="care-note-last-action"></span></p>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
