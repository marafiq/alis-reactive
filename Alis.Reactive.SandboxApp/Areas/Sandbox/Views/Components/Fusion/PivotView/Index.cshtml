@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.PivotView
@model PivotViewModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.Fusion.AppLevel
@using Syncfusion.EJ2.PivotView
@{
    ViewData["Title"] = "Occupancy and Care Hours";

    const string ReportId = "occupancy-report";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";

    var plan = Html.ReactivePlan<PivotViewModel>();
    var saveSnapshotUrl = Url.SandboxRouteTemplate("SaveSnapshot", "PivotView", "community");
    var openSnapshotUrl = Url.SandboxRouteTemplate("Snapshot", "PivotView", "community");
    var boardPacketUrl = Url.SandboxRouteTemplate("AddToBoardPacket", "PivotView", "community", "currentView");
}

<native-vstack gap="Lg">
    <native-heading level="H1">Occupancy and Care Hours</native-heading>
    <p class="text-text-secondary">
        @Model.CommunityName: residents at month end and care hours given, by wing and care level, for <span id="report-period">@Model.Period</span>.
    </p>

    <native-card><native-card-body>
        <native-hstack gap="Sm" class="mb-4 flex-wrap">
            @(Html.NativeButton("load-october-btn", "Load October Census")
                .CssClass("rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Get(Url.SandboxRoute("Census", "PivotView"))
                     .Gather<OccupancyCensusQuery>(g => g.Set(x => x.Community, p.Url<OccupancyReportQuery>().Get(q => q.Community)))
                     .Response(r => r.OnSuccess<OccupancyCensus>((json, s) =>
                     {
                         s.Component<FusionPivotView>(ReportId).DataSourceSettings.DataSource.Set(json.Get(x => x.Rows));
                         s.Element("report-period").Text.Set(json.Get(x => x.Period));
                     }));
                }))
            @(Html.NativeButton("refresh-report-btn", "Refresh")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionPivotView>(ReportId).Refresh()))
            @(Html.NativeButton("highlight-figures-btn", "Highlight Figures")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionPivotView>(ReportId).ShowConditionalFormattingDialog()))
            @(Html.NativeButton("add-measure-btn", "Add a Measure")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) => p.Component<FusionPivotView>(ReportId).CreateCalculatedFieldDialog()))
        </native-hstack>

        @(Html.FusionPivotView(plan, ReportId, b =>
        {
            b.Height("480px");
            b.Width("100%");
            b.ShowToolbar(true);
            b.Toolbar(new List<string> { "Grid", "Chart" });
            b.DisplayOption(new PivotViewDisplayOption { View = global::Syncfusion.EJ2.PivotView.View.Both });
            b.AllowConditionalFormatting(true);
            b.AllowCalculatedField(true);
            b.DataSourceSettings(new PivotViewDataSourceSettings
            {
                DataSource = Model.Census,
                ExpandAll = true,
                EnableSorting = false,
                ShowColumnGrandTotals = false,
                ValueSortSettings = new PivotViewValueSortSettings { HeaderDelimiter = " · " },
                Rows = new List<PivotViewRow>
                {
                    new PivotViewRow { Name = "wing", Caption = "Wing" },
                    new PivotViewRow { Name = "careLevel", Caption = "Care level" }
                },
                Columns = new List<PivotViewRow>
                {
                    new PivotViewRow { Name = "month", Caption = "Month" }
                },
                Values = new List<PivotViewRow>
                {
                    new PivotViewRow { Name = "residents", Caption = "Residents", Type = SummaryTypes.Sum },
                    new PivotViewRow { Name = "careHours", Caption = "Care hours", Type = SummaryTypes.Sum }
                }
            });
        })
        .Reactive(evt => evt.DataBound, (_, p) =>
        {
            // A report drawn again may no longer hold the figure that was picked.
            p.Element("selected-figure").Hide();
            p.Element("figure-hint").Show();
        })
        .Reactive(evt => evt.CellSelecting, (args, p) =>
        {
            var cell = args.Data;
            p.When(cell.Get(x => x.Axis)).Eq("value")
                .Then(figure =>
                {
                    figure.When(cell.Get(x => x.IsGrandSum)).Truthy()
                        .Then(all =>
                        {
                            all.Element("figure-where").Text.Set("All wings");
                            all.Element("figure-scope").Text.Set("");
                        })
                        .ElseIf(cell.Get(x => x.IsSum)).Truthy()
                        .Then(wing =>
                        {
                            wing.Element("figure-where").Text.Set(cell.Get(x => x.RowHeaders));
                            wing.Element("figure-scope").Text.Set(" wing");
                        })
                        .Else(unit =>
                        {
                            unit.Element("figure-where").Text.Set(cell.Get(x => x.RowHeaders));
                            unit.Element("figure-scope").Text.Set("");
                        });
                    figure.Element("figure-month").Text.Set(cell.Get(x => x.ColumnHeaders));
                    figure.Element("figure-amount").Text.Set(cell.Get(x => x.FormattedText));
                    figure.When(cell.Get(x => x.ActualText)).Eq("careHours")
                        .Then(hours => hours.Element("figure-unit").Text.Set("care hours"))
                        .ElseIf(cell.Get(x => x.Value)).Eq(1m)
                        .Then(one => one.Element("figure-unit").Text.Set("resident"))
                        .Else(many => many.Element("figure-unit").Text.Set("residents"));
                    figure.Element("figure-hint").Hide();
                    figure.Element("selected-figure").Show();
                })
                .Else(heading =>
                {
                    heading.Element("selected-figure").Hide();
                    heading.Element("figure-hint").Show();
                });
        }))

        <p id="figure-hint" class="mt-4 text-sm text-text-muted">Pick a figure to see what it counts.</p>
        <p id="selected-figure" hidden class="mt-4 text-sm font-medium"><span id="figure-where"></span><span id="figure-scope"></span> in <span id="figure-month"></span>: <span id="figure-amount"></span> <span id="figure-unit"></span></p>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Board Meeting</native-heading>
        <p class="mt-1 text-sm text-text-secondary">
            A snapshot keeps the report with today's figures. The board packet takes the report's layout, as a table or a chart, and pulls the figures on the day of the meeting.
        </p>

        <native-hstack gap="Sm" class="mt-4 flex-wrap">
            @(Html.NativeButton("save-snapshot-btn", "Save Snapshot")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Post(saveSnapshotUrl)
                     .Gather<OccupancySnapshotRequest>(g => g
                         .Set(x => x.Community, p.Url<OccupancyReportQuery>().Get(q => q.Community))
                         .Set(x => x.Layout, p.Component<FusionPivotView>(ReportId).GetPersistData(false)))
                     .Response(r => r
                         .OnSuccess<BoardReply>((json, s) =>
                         {
                             // A brief confirmation: it counts down and goes away by itself, so it needs no close button.
                             var toast = s.Component<FusionToast>();
                             toast.Title.Set("Board snapshot");
                             toast.Content.Set(json.Get(x => x.Message));
                             toast.TimeOut.Set(2500);
                             toast.ShowProgressBar.Set(true);
                             toast.ShowCloseButton.Set(false);
                             toast.Tone.Set(FusionToastTone.Success);
                             toast.Show();
                         })
                         .OnError<BoardReply>(400, (json, e) => e.Element("board-status").Text.Set(json.Get(x => x.Message))));
                }))
            @(Html.NativeButton("open-snapshot-btn", "Open Snapshot")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Get(openSnapshotUrl)
                     .Gather<OccupancySnapshotLookup>(g => g.Set(x => x.Community, p.Url<OccupancyReportQuery>().Get(q => q.Community)))
                     .Response(r => r
                         .OnSuccess<OccupancySnapshot>((json, s) =>
                         {
                             s.Component<FusionPivotView>(ReportId).LoadPersistData(json.Get(x => x.Layout));
                             s.Element("report-period").Text.Set(json.Get(x => x.Period));
                             s.Element("board-status").Text.Set(json.Get(x => x.Message));
                         })
                         .OnError<BoardReply>(404, (json, e) => e.Element("board-status").Text.Set(json.Get(x => x.Message))));
                }))
            @(Html.NativeButton("add-to-board-packet-btn", "Add to Board Packet")
                .CssClass(Button)
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    var report = p.Component<FusionPivotView>(ReportId);
                    p.Post(boardPacketUrl)
                     .Gather<BoardPacketRequest>(g => g
                         .Set(x => x.Community, p.Url<OccupancyReportQuery>().Get(q => q.Community))
                         .Set(x => x.CurrentView, report.CurrentView)
                         .Set(x => x.Layout, report.GetPersistData(true)))
                     .Response(r => r
                         .OnSuccess<BoardReply>((json, s) => s.Element("board-status").Text.Set(json.Get(x => x.Message)))
                         .OnError<BoardReply>(400, (json, e) => e.Element("board-status").Text.Set(json.Get(x => x.Message))));
                }))
        </native-hstack>
        <p id="board-status" class="mt-4 text-sm"></p>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
