@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.FileUpload
@model WoundAttachmentsModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Wound Care Attachments";

    var plan = Html.ReactivePlan<WoundAttachmentsModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Wound Care Attachments</native-heading>
        <native-text color="Secondary">Margaret Hale · Maple 214 · Pressure wound review</native-text>
    </div>

    <native-card><native-card-body>
        <form id="wound-attachments">
            <native-vstack gap="Base">
                @{ Html.InputField(plan, m => m.WoundSite, o => o.Required().Label("Wound site"))
                    .NativeTextBox(b => b.CssClass("rounded-md border border-border px-3 py-1.5 text-sm w-full")); }

                <div>
                    <p class="text-sm font-medium">To attach</p>
                    <ul class="mt-1 text-sm">
                        <li>The signed consent form (PDF) <span id="consent-chosen" hidden class="font-medium text-green-700">✓ chosen</span></li>
                        <li>A photo of the wound (JPG or PNG) <span id="photo-chosen" hidden class="font-medium text-green-700">✓ chosen</span></li>
                    </ul>
                </div>

                @{ Html.InputField(plan, m => m.Attachments, o => o.Required().Label("Files"))
                    .FusionFileUpload(b => b.AllowedExtensions(".pdf,.jpg,.jpeg,.png").Multiple(true))
                    .Reactive(evt => evt.Selected, (args, p) =>
                    {
                        var chosen = p.From(args.FilesData);
                        // An empty file is a scan that did not take: it is not added.
                        p.When(chosen.Any(file => file.Size == 0)).Truthy()
                            .Then(empty =>
                            {
                                args.Cancel.Set(true);
                                empty.Element("empty-scan-name").Text.Set(chosen.Find(file => file.Size == 0, file => file.Name));
                                empty.Element("empty-scan").Show();
                            })
                            .Else(added => added.Element("empty-scan").Hide());
                    })
                    // The checklist ticks off what the uploader holds, after each choice and each removal.
                    .Reactive(evt => evt.FilesChanged, (args, p) =>
                    {
                        var held = p.From(args.FilesData);
                        p.When(held.Any(file => file.Type == "pdf" || file.Type == "PDF")).Truthy()
                            .Then(consent => consent.Element("consent-chosen").Show())
                            .Else(consent => consent.Element("consent-chosen").Hide());
                        p.When(held.Any(file => file.Type == "jpg" || file.Type == "jpeg" || file.Type == "png"
                                || file.Type == "JPG" || file.Type == "JPEG" || file.Type == "PNG")).Truthy()
                            .Then(photo => photo.Element("photo-chosen").Show())
                            .Else(photo => photo.Element("photo-chosen").Hide());
                    }); }

                <p id="empty-scan" hidden class="text-sm text-amber-700"><span id="empty-scan-name"></span> is empty. Scan it again before attaching it.</p>
            </native-vstack>
        </form>

        <native-hstack gap="Sm" align="Center" class="mt-4">
            @(Html.NativeButton("attach-files-btn", "Attach to Margaret's record")
                .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                .Reactive(plan, evt => evt.Click, (_, p) =>
                {
                    p.Post(Url.SandboxRoute("Attach", "FileUpload"))
                        .Gather(g => g.Form())
                        .AsFormData()
                        .Validate<WoundAttachmentsValidator>("wound-attachments")
                        .Response(r => r
                            .OnSuccess<WoundAttachmentsAnswer>((attached, s) =>
                                s.Element("attach-status").Text.Set(attached.Get(x => x.Message)))
                            .OnError(400, e => e.ValidationErrors("wound-attachments")));
                }))
            <p id="attach-status" class="text-sm">Nothing attached yet.</p>
        </native-hstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
