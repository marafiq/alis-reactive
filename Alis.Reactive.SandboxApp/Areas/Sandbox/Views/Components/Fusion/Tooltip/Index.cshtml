@model TooltipModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Care Levels";

    var plan = Html.ReactivePlan<TooltipModel>();
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium hover:bg-surface-muted transition-colors";
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Care Levels</native-heading>
        <native-text color="Secondary">Walk a family through the care levels the community offers.</native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-text>Independent Living · Assisted Living · <span id="memory-care-term" class="rounded px-1 font-medium">Memory Care</span></native-text>

            @* The explanation opens only from the page: Explain shows it beside the term, Got it closes it. *@
            @(Html.FusionTooltip(plan, "care-level-tooltip", b =>
            {
                b.Content("24/7 staff, a secure environment, and help with every activity of daily living.");
                b.Position(Syncfusion.EJ2.Popups.Position.TopCenter);
                b.OpensOn("Custom");
                b.Width("280px");
                b.ShowTipPointer(true);
            })
            .Reactive(evt => evt.BeforeRender, (args, p) =>
            {
                p.When(p.Component<NativeCheckBox>(m => m.HideExplanations).Checked).Truthy()
                    .Then(off =>
                    {
                        args.Cancel.Set(true);
                        off.Element("explanations-off").Show();
                    })
                    .Else(on => on.Element("explanations-off").Hide());
            })
            .Reactive(evt => evt.BeforeOpen, (args, p) =>
                p.Element("memory-care-term").ClassList.Add("bg-accent/10"))
            .Reactive(evt => evt.BeforeClose, (args, p) =>
                p.Element("memory-care-term").ClassList.Remove("bg-accent/10")))

            <native-hstack gap="Sm">
                @(Html.NativeButton("explain-memory-care", "Explain Memory Care")
                    .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<FusionTooltip>("care-level-tooltip").Open()))
                @(Html.NativeButton("explanation-done", "Got it")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<FusionTooltip>("care-level-tooltip").Close()))
            </native-hstack>

            @{ Html.InputField(plan, m => m.HideExplanations, o => o.Label("Hide explanations on this screen"))
                .NativeCheckBox(b => b.CssClass("rounded border-border")); }
            <p id="explanations-off" class="text-sm text-text-secondary" hidden>Explanations are turned off on this screen.</p>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
