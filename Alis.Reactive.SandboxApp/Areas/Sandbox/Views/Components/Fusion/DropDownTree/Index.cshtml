@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.DropDownTree
@model FusionDropDownTreeModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Microsoft.AspNetCore.Mvc.Rendering
@using Syncfusion.EJ2.DropDowns
@{
    ViewData["Title"] = "Room Assignment";

    const string FormId = "move-in-form";
    const string ButtonCss = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string PrimaryButtonCss = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string InputCss = "rounded-md border border-border px-3 py-1.5 text-sm";

    var plan = Html.ReactivePlan<FusionDropDownTreeModel>();
    var residents = Model.MovingIn.Select(resident => new SelectListItem(resident.Name, resident.Id)).ToList();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Room Assignment</native-heading>
    <native-text color="Secondary">Maple Grove move-ins for the week of October 19. Choose who is moving in, then their room on the building plan or by its number.</native-text>

    <native-card><native-card-body id="@FormId">
        <native-grid cols="C2" gap="Lg">
            @* The plan's list opens below it, or over the fields above it when the window has no room below. *@
            <native-vstack gap="Base">
                @{ Html.InputField(plan, m => m.Resident, o => o.Required().Label("Moving in"))
                    .NativeDropDown(b => b.Items(residents).Placeholder("-- Choose a resident --").CssClass(InputCss))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        // The building plan opens for the coordinator to choose a room; a room the resident's
                        // deposit holds is filled in instead.
                        var rooms = p.Component<FusionDropDownTree>(m => m.Room);
                        p.When(args.Value).NotEmpty().Then(chosen =>
                        {
                            rooms.ShowPopup();
                            chosen.Get(Url.SandboxRoute("Deposit", "DropDownTree"))
                                .Gather<DepositQuery>(g => g.Set(x => x.Resident, args.Value))
                                .Response(r => r.OnSuccess<DepositHold>((deposit, s) =>
                                    s.When(deposit.Get(x => x.Room)).NotEmpty()
                                        .Then(held =>
                                        {
                                            rooms.Value.Set(deposit.Get(x => x.Room));
                                            rooms.DataBind();
                                            held.Element("deposit-room").Text.Set(rooms.Text);
                                            held.Element("no-deposit").Hide();
                                            held.Element("deposit-held").Show();
                                        })
                                        .Else(none =>
                                        {
                                            none.Element("deposit-held").Hide();
                                            none.Element("no-deposit").Show();
                                        })));
                        });
                    }); }

                @{ Html.InputField(plan, m => m.Room, o => o.Required().Label("Room"))
                    .FusionDropDownTree(b => b
                        .Fields(new DropDownTreeFields
                        {
                            DataSource = Model.BuildingPlan,
                            Value = Field.Of((BuildingPlanNode n) => n.Value).Name,
                            Text = Field.Of((BuildingPlanNode n) => n.Text).Name,
                            ParentValue = Field.Of((BuildingPlanNode n) => n.ParentValue).Name,
                            HasChildren = Field.Of((BuildingPlanNode n) => n.HasChildren).Name,
                            Expanded = Field.Of((BuildingPlanNode n) => n.Expanded).Name
                        })
                        .Placeholder("Choose a building, wing and room")
                        .ChangeOnBlur(false)
                        .PopupHeight("300px"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        // A room on the plan closes it: a room the coordinator picks closes it already, one the
                        // page fills in does not.
                        var rooms = p.Component<FusionDropDownTree>(m => m.Room);
                        rooms.HidePopup();
                        // A room picked on the plan writes its number; a typed number is in the box already.
                        p.When(args.IsInteracted).Truthy()
                            .Then(picked => picked.Component<NativeTextBox>(m => m.RoomNumber).Value.Set(rooms.Text));
                        p.Post(Url.SandboxRoute("Hold", "DropDownTree"))
                            .Gather<RoomHoldRequest>(g => g
                                .Set(x => x.Resident, p.Component<NativeDropDown>(m => m.Resident).Value)
                                .Set(x => x.From, args.OldValue)
                                .Set(x => x.To, args.Value))
                            .Response(r => r
                                .OnSuccess<RoomHoldNote>((note, s) => s.Element("hold-status").Text.Set(note.Get(x => x.Message)))
                                .OnError<RoomHoldNote>(400, (note, e) => e.Element("hold-status").Text.Set(note.Get(x => x.Message))));
                    }); }

                @* Every line the plan changes sits below it, so the plan never moves while its list is open. *@
                <p id="deposit-held" hidden class="text-sm">The deposit holds <span id="deposit-room" class="font-medium"></span>.</p>
                <p id="no-deposit" hidden class="text-sm text-text-muted">No room is held for this resident yet. Choose one on the building plan.</p>
                <p id="unknown-room" hidden class="text-sm text-red-700">No room is numbered <span id="unknown-room-number"></span>.</p>
                <p id="hold-status" class="text-sm font-medium">No room is held yet.</p>
            </native-vstack>

            @* The room number and the commands sit beside the building plan, where its list cannot cover them. *@
            <native-vstack gap="Base">
                @{ Html.InputField(plan, m => m.RoomNumber, o => o.Label("Room number"))
                    .NativeTextBox(b => b.CssClass(InputCss).Placeholder("Oak 110"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        // A typed room number picks that room on the plan; a number the plan does not have is refused.
                        var rooms = p.Component<FusionDropDownTree>(m => m.Room);
                        p.When(args.Value).IsEmpty()
                            .Then(blank => blank.Element("unknown-room").Hide())
                            .Else(typed =>
                            {
                                rooms.Text.Set(args.Value);
                                rooms.DataBind();
                                typed.When(rooms.Text).Eq(args.Value)
                                    .Then(found => found.Element("unknown-room").Hide())
                                    .Else(unknown =>
                                    {
                                        unknown.Element("unknown-room-number").Text.Set(args.Value);
                                        unknown.Element("unknown-room").Show();
                                    });
                            });
                    }); }

                <native-hstack gap="Sm" class="flex-wrap">
                    @(Html.NativeButton("release-room-btn", "Release Room")
                        .CssClass(ButtonCss)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                        {
                            var rooms = p.Component<FusionDropDownTree>(m => m.Room);
                            p.When(rooms.Value).IsEmpty()
                                .Then(none => none.Element("hold-status").Text.Set("No room is held to release."))
                                .Else(held =>
                                {
                                    rooms.Clear();
                                    held.Component<NativeTextBox>(m => m.RoomNumber).Value.Set("");
                                });
                        }))
                    @(Html.NativeButton("assign-room-btn", "Assign Room")
                        .CssClass(PrimaryButtonCss)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                            p.Post(Url.SandboxRoute("Assign", "DropDownTree"))
                                .Gather(g => g.Form())
                                .Validate<RoomAssignmentValidator>(FormId)
                                .Response(r => r
                                    .OnSuccess<RoomAssignmentBooked>((booked, s) => s.Element("assign-status").Text.Set(booked.Get(x => x.Message)))
                                    .OnError<RoomAssignmentBooked>(400, (refused, e) => e.Element("assign-status").Text.Set(refused.Get(x => x.Message))))))
                </native-hstack>
                <p id="assign-status" class="text-sm">No move-in booked yet.</p>
            </native-vstack>
        </native-grid>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
