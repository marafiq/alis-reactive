@model TimePickerModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionTimePicker";

    // The community's standard morning medication round.
    var standardMorningRound = new DateTime(1, 1, 1, 8, 0, 0);

    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string ButtonPrimary = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<TimePickerModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Set the resident's morning medication time</native-heading>
        <native-text color="Secondary">
            We carried over the time currently on the medication record. Pick a new time, or apply the
            community's standard morning round, then confirm and schedule it.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.MedicationTime, o => o.Label("Morning medication time"))
                .FusionTimePicker(b => b
                    .Placeholder("Select the medication time")
                    @* 24-hour display so the picker round-trips the HH:mm value that
                       FusionTimePicker.SetValue emits; a 12h format leaves a programmatic
                       SetValue unparsed (ej2.value stays null). *@
                    .Format("HH:mm")
                    .Reactive(plan, evt => evt.Changed, (args, p) =>
                    {
                        p.When(args, x => x.Value).NotNull()
                            .Then(scheduled => scheduled.Element("medication-status")
                                .SetText("This medication time is ready to confirm."))
                            .Else(cleared => cleared.Element("medication-status")
                                .SetText("No medication time is set. Please choose one to continue."));

                        p.When(args, x => x.IsInteracted).Truthy()
                            .Then(chosen => chosen.Element("medication-origin")
                                .SetText("You set this medication time."))
                            .Else(applied => applied.Element("medication-origin")
                                .SetText("We applied the community's standard morning round for you."));

                        // Once a time is chosen, release the field so the time list
                        // closes and the coordinator can move on to confirming.
                        p.Component<FusionTimePicker>(m => m.MedicationTime).FocusOut();
                    })); }

            <native-text color="Secondary"><span id="medication-origin">This is the medication time currently on the record.</span></native-text>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("apply-standard-round", "Apply standard morning round")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionTimePicker>(m => m.MedicationTime).SetValue(standardMorningRound);
                    }))
                @(Html.NativeButton("adjust-medication-time", "Adjust the time")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<FusionTimePicker>(m => m.MedicationTime).FocusIn();
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-text color="Secondary"><span id="medication-status">Review the medication time above, then confirm.</span></native-text>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("confirm-medication-time", "Confirm the time")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var medication = p.Component<FusionTimePicker>(m => m.MedicationTime);
                        p.When(medication.Value()).IsEmpty()
                            .Then(empty => empty.Element("confirm-result")
                                .SetText("A medication time is required before scheduling."))
                            .Else(set => set.Element("confirm-result")
                                .SetText("Medication time confirmed. You can schedule it now."));
                    }))
                @(Html.NativeButton("schedule-medication", "Schedule the medication")
                    .CssClass(ButtonPrimary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var medication = p.Component<FusionTimePicker>(m => m.MedicationTime);
                        p.Post(Url.SandboxRoute("Schedule", "TimePicker"))
                            .Gather(g => g.Include(medication.Value(), "medicationTime"))
                            .Response(r => r.OnSuccess<MedicationScheduleResponse>((json, s) =>
                            {
                                s.Element("schedule-confirmation").SetText(json, x => x.Confirmation);
                                s.Element("schedule-confirmation-panel").RemoveClass("hidden");
                            }));
                    }))
            </native-hstack>

            <native-text color="Secondary"><span id="confirm-result"></span></native-text>

            <div id="schedule-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="schedule-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
