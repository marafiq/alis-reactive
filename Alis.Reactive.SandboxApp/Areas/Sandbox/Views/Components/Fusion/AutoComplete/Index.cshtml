@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Fusion.AutoComplete
@model FusionAutoCompleteModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Notify Physician";

    const string FormId = "physician-page-form";
    const string Button = "rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium hover:bg-surface-muted transition-colors";
    const string PrimaryButton = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";
    const string TextInput = "rounded-md border border-border px-3 py-1.5 text-sm";

    var plan = Html.ReactivePlan<FusionAutoCompleteModel>();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Notify Physician</native-heading>
    <native-text color="Secondary">Margaret Hale, Maple 214, evening shift. Report her change of condition to the physician who should hear about it.</native-text>

    @* The page's commands sit above the physician field, where its list cannot cover them. *@
    <native-hstack gap="Sm" class="flex-wrap">
        @(Html.NativeButton("page-attending-btn", "Page Her Attending")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (_, p) =>
            {
                // The field is emptied and her care team comes back to the list, whatever the last search or
                // the on-call list left there; her attending is chosen from it, and the page says whom.
                var physician = p.Component<FusionAutoComplete>(m => m.Physician);
                physician.Clear();
                physician.DataBind();
                physician.Items<PhysicianListing>().Set(Model.CareTeam);
                physician.Value.Set(Model.Attending);
                physician.DataBind();
                p.Element("attending-name").Text.Set(physician.Text);
                p.Element("attending-filled").Show();
            }))
        @(Html.NativeButton("on-call-btn", "On Call Tonight")
            .CssClass(Button)
            .Reactive(plan, evt => evt.Click, (_, p) =>
                p.Get(Url.SandboxRoute("OnCall", "AutoComplete"))
                    .Response(r => r.OnSuccess<OnCallPhysicians>((onCall, s) =>
                    {
                        // Tonight's on-call physicians replace her care team in the list, opened for the nurse.
                        var physician = s.Component<FusionAutoComplete>(m => m.Physician);
                        physician.Items<PhysicianListing>().Set(onCall.Get(x => x.Physicians));
                        physician.DataBind();
                        physician.ShowPopup();
                    }))))
        <p id="attending-filled" hidden class="text-sm">Her attending, <span id="attending-name" class="font-medium"></span>, is filled in.</p>
    </native-hstack>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.Physician, o => o.Required().Label("Physician"))
                .FusionAutoComplete(b => b
                    .DataSource(Model.CareTeam)
                    .Fields<PhysicianListing>(t => t.Name, v => v.Id)
                    .AllowCustom(false)
                    .DebounceDelay(300)
                    .Highlight(true)
                    .Placeholder("Type part of a name"))
                .Reactive(evt => evt.Filtering, (args, p) =>
                {
                    // The directory answers for what was typed; until it does, her care team is not offered.
                    args.PreventDefaultAction.Set(true);
                    p.Get(Url.SandboxRoute("Search", "AutoComplete"))
                        .Gather<DirectorySearch>(g => g.Set(x => x.Name, args.Text))
                        .WhileLoading(l => l.Element("directory-status").Text.Set("Searching the physician directory..."))
                        .Response(r => r.OnSuccess<DirectoryMatches>((found, s) =>
                        {
                            s.Element("directory-status").Text.Set(found.Get(x => x.Summary));
                            // A name nobody in the directory has closes the list the last search left open.
                            s.When(found.Get(x => x.Count)).Eq(0)
                                .Then(none => none.Component<FusionAutoComplete>(m => m.Physician).HidePopup())
                                .Else(some => args.UpdateData(found.Get(x => x.Physicians)));
                        }));
                })
                .Reactive(evt => evt.Change, (args, p) =>
                {
                    p.When(args.Value).IsEmpty()
                        .Then(cleared =>
                        {
                            cleared.Element("physician-contact").Hide();
                            cleared.Element("check-physician").Hide();
                        })
                        .Else(chosen =>
                        {
                            chosen.Get(Url.SandboxRoute("Contact", "AutoComplete"))
                                .Gather<PhysicianContactQuery>(g => g.Set(x => x.Physician, args.Value))
                                .Response(r => r.OnSuccess<PhysicianContact>((contact, s) =>
                                {
                                    s.Element("physician-specialty").Text.Set(contact.Get(x => x.Specialty));
                                    s.Element("physician-callback").Text.Set(contact.Get(x => x.Callback));
                                    s.Element("physician-contact").Show();
                                }));
                            // Two physicians can share part of a name: one the nurse chose by name is confirmed
                            // with the answering service, and the keyboard goes away so the callback shows. The page
                            // empties the field before it fills one in, so the note is already down for those.
                            chosen.When(args.IsInteracted).Truthy()
                                .Then(byName =>
                                {
                                    byName.Element("check-physician").Show();
                                    byName.Component<FusionAutoComplete>(m => m.Physician).FocusOut();
                                });
                        });
                }); }
            <p id="directory-status" class="text-sm text-text-muted">Type part of a name to search the physician directory.</p>
            <p id="check-physician" hidden class="text-sm text-amber-700">Chosen by name: confirm the physician's name with the answering service.</p>
            <dl id="physician-contact" hidden class="grid grid-cols-2 gap-2 text-sm">
                <dt class="text-text-muted">Specialty</dt>
                <dd id="physician-specialty" class="font-medium"></dd>
                <dt class="text-text-muted">Callback</dt>
                <dd id="physician-callback" class="font-medium"></dd>
            </dl>

            @{ Html.InputField(plan, m => m.Concern, o => o.Required().Label("What changed"))
                .NativeTextBox(b => b.CssClass(TextInput).Placeholder("Short of breath after lunch")); }

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("send-page-btn", "Send Page")
                    .CssClass(PrimaryButton)
                    .Reactive(plan, evt => evt.Click, (_, p) =>
                        p.Post(Url.SandboxRoute("Send", "AutoComplete"))
                            .Gather(g => g.Form())
                            .Validate<PhysicianPageValidator>(FormId)
                            .Response(r => r
                                .OnSuccess<PhysicianPageSent>((sent, s) =>
                                {
                                    // The page is out: the physician it went to stays as it was sent.
                                    s.Element("page-status").Text.Set(sent.Get(x => x.Message));
                                    s.Component<FusionAutoComplete>(m => m.Physician).Enabled.Set(false);
                                    s.Element("page-again").Show();
                                })
                                .OnError(400, e => e.ValidationErrors(FormId)))))
                <div id="page-again" hidden>
                    @(Html.NativeButton("page-again-btn", "Page Someone Else")
                        .CssClass(Button)
                        .Reactive(plan, evt => evt.Click, (_, p) =>
                        {
                            // The field opens again, empty, with the cursor in it for the next name.
                            var physician = p.Component<FusionAutoComplete>(m => m.Physician);
                            physician.Enabled.Set(true);
                            physician.Clear();
                            physician.DataBind();
                            physician.FocusIn();
                            p.Element("page-again").Hide();
                        }))
                </div>
            </native-hstack>
            <p id="page-status" class="text-sm">Not paged yet.</p>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
