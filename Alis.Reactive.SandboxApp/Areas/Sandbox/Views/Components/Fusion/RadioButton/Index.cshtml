@model FusionRadioButtonModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "FusionRadioButton";

    const string studioId = "room-studio";
    const string oneBedroomId = "room-one-bedroom";
    const string companionId = "room-companion-suite";

    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string SubmitReady = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<FusionRadioButtonModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Move-in Room &amp; Care Plan</native-heading>
        <native-text color="Secondary">
            Confirm the room for this resident's move-in. Choose a room to see what it includes, then confirm with the move-in desk.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Which room is she moving into?</native-heading>

            <native-vstack gap="Sm">
                @(Html.FusionRadioButton(plan, studioId, b => b
                    .Name("roomChoice")
                    .Value("Studio Apartment")
                    .Label("Studio apartment"))
                    .Reactive(evt => evt.Changed, (args, p) =>
                    {
                        p.Element("chosen-room").SetText(args, x => x.Value);
                        p.Element("room-detail").SetText("A studio suits a resident who wants a compact, easy-to-navigate space.");
                        p.Element("companion-availability").SetText("");
                    }))

                @(Html.FusionRadioButton(plan, oneBedroomId, b => b
                    .Name("roomChoice")
                    .Value("One-Bedroom Apartment")
                    .Label("One-bedroom apartment"))
                    .Reactive(evt => evt.Changed, (args, p) =>
                    {
                        p.Element("chosen-room").SetText(args, x => x.Value);
                        p.Element("room-detail").SetText("A one-bedroom gives a separate living area for visiting family.");
                        p.Element("companion-availability").SetText("");
                    }))

                @(Html.FusionRadioButton(plan, companionId, b => b
                    .Name("roomChoice")
                    .Value("Shared Companion Suite")
                    .Label("Shared companion suite"))
                    .Reactive(evt => evt.Changed, (args, p) =>
                    {
                        p.Element("chosen-room").SetText(args, x => x.Value);

                        p.When(args, x => x.Value).Eq("Shared Companion Suite")
                            .Then(t => t.Element("room-detail")
                                .SetText("A companion suite pairs two residents who prefer not to live alone."))
                            .Else(e => e.Element("room-detail")
                                .SetText("Choose a room to see what it includes."));
                    }))
            </native-vstack>

            <native-vstack gap="Xs">
                <native-text>
                    Selected room: <span id="chosen-room" class="font-semibold text-text">No room chosen yet</span>
                </native-text>
                <native-text color="Secondary"><span id="room-detail">Choose a room to see what it includes.</span></native-text>
                <native-text color="Secondary"><span id="companion-availability"></span></native-text>
            </native-vstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Help her decide</native-heading>
            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("apply-last-assessment", "Apply the room from her last assessment")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var companion = p.Component<FusionRadioButton>(companionId);
                        companion.SetChecked(true);
                        p.Element("chosen-room").SetText(companion.SelectedValue());

                        p.When(companion.SelectedValue()).Eq("Shared Companion Suite")
                            .Then(t => t.Element("room-detail")
                                .SetText("Her last assessment recommended the shared companion suite."))
                            .Else(e => e.Element("room-detail")
                                .SetText("Choose a room to see what it includes."));
                    }))

                @(Html.NativeButton("recommend-studio", "Pick her recommended studio and take me to it")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var studio = p.Component<FusionRadioButton>(studioId);
                        studio.Click();
                        studio.FocusIn();
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Companion suite availability</native-heading>
            <native-text color="Secondary">
                If the companion suite is full this month, take it off the list so it cannot be confirmed.
            </native-text>
            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("mark-companion-full", "Companion suite is full this month")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var companion = p.Component<FusionRadioButton>(companionId);
                        companion.SetDisabled(true);

                        p.When(companion.Disabled()).Truthy()
                            .Then(t => t.Element("companion-availability")
                                .SetText("The companion suite is full this month and can't be chosen."))
                            .Else(e => e.Element("companion-availability")
                                .SetText("The companion suite is open for move-in."));
                    }))

                @(Html.NativeButton("reopen-companion", "Companion suite opened up")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var companion = p.Component<FusionRadioButton>(companionId);
                        companion.SetDisabled(false);

                        p.When(companion.Disabled()).Truthy()
                            .Then(t => t.Element("companion-availability")
                                .SetText("The companion suite is full this month and can't be chosen."))
                            .Else(e => e.Element("companion-availability")
                                .SetText("The companion suite is open for move-in."));
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            @(Html.NativeButton("confirm-move-in", "Confirm move-in with the desk")
                .CssClass(SubmitReady)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    var companion = p.Component<FusionRadioButton>(companionId);
                    p.Post(Url.SandboxRoute("ConfirmPlan", "RadioButton"))
                        .Gather(g =>
                        {
                            g.Include(companion.SelectedValue(), "room");
                            g.Include(companion.Checked(), "companionSuiteChosen");
                            g.Include(companion.Disabled(), "companionSuiteUnavailable");
                        })
                        .Response(r => r.OnSuccess<RoomPlanResponse>((json, s) =>
                        {
                            s.Element("desk-confirmation").SetText(json, x => x.Confirmation);
                            s.Element("desk-confirmation-panel").RemoveClass("hidden");
                        }));
                }))
            <div id="desk-confirmation-panel" class="hidden rounded-md border border-green-300 bg-green-50 p-4">
                <native-text><span id="desk-confirmation" class="font-medium text-green-800"></span></native-text>
            </div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
