@model RoomComfortModel
@using Alis.Reactive.Builders
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.SandboxApp.BroughtComponents
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Brought
@functions {
    // Where the room stands against the target, said again whenever the target or the mode changes.
    private static void DescribeComfort(PipelineBuilder<RoomComfortModel> s)
    {
        var thermostat = s.Component<Thermostat>(m => m.Target);
        s.Element("distance").Text.Set(thermostat.DistanceTo(thermostat.Value));
        s.Element("minutes").Text.Set(thermostat.Estimate(thermostat.Value, thermostat.Mode));
        s.When(thermostat.IsComfortable()).Truthy()
            .Then(near => { near.Element("comfortable").Show(); near.Element("away").Hide(); })
            .Else(far => { far.Element("comfortable").Hide(); far.Element("away").Show(); });
    }

    private static void SetMode(PipelineBuilder<RoomComfortModel> p, ThermostatMode mode)
    {
        var thermostat = p.Component<Thermostat>(m => m.Target);
        thermostat.Mode.Set(mode);
        p.Element("mode").Text.Set(thermostat.Mode);
        p.Element("reading").Text.Set(thermostat.Reading().Label());
        DescribeComfort(p);
    }

    // The fan as a condition compares the enum the page wrote: its JavaScript text, both ways.
    private static void SetFan(PipelineBuilder<RoomComfortModel> p, ThermostatFan fan)
    {
        var thermostat = p.Component<Thermostat>(m => m.Target);
        thermostat.Fan.Set(fan);
        p.When(thermostat.Fan).Eq(ThermostatFan.On)
            .Then(running => running.Element("fan-running").Show())
            .Else(resting => resting.Element("fan-running").Hide());
    }
}
@{
    ViewData["Title"] = "Room Comfort";

    const string FormId = "comfort-form";
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string ButtonSubmit = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<RoomComfortModel>();

    // The wing's policy sets the range and the night setting as the page opens; the room's zones are listed.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(Url.SandboxRoute("Policy", "Thermostat"))
            .Response(r => r.OnSuccess<ComfortPolicy>((policy, s) =>
            {
                var thermostat = s.Component<Thermostat>(m => m.Target);
                thermostat.SetRange(policy.Get(x => x.Min), policy.Get(x => x.Max));
                thermostat.Schedule.Night.Set(policy.Get(x => x.Night));
                s.Element("range-min").Text.Set(policy.Get(x => x.Min));
                s.Element("range-max").Text.Set(policy.Get(x => x.Max));
                s.Element("next-change").Text.Set(thermostat.Schedule.NextChange());
                s.Element("zone-count").Text.Set(thermostat.Zones.Count);
                s.When(thermostat.Zones.Each(zone => zone.Name)).ArrayContains("Bath")
                    .Then(bath => bath.Element("bath-zone").Show())
                    .Else(none => none.Element("bath-zone").Hide());
                DescribeComfort(s);
            }))));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Room Comfort</native-heading>
        <native-text color="Secondary">
            Set Margaret Hale's room in the Garden wing for the night. The wing's range and night setting apply.
        </native-text>
    </div>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            @{ Html.InputField(plan, m => m.Target, o => o.Required().Label("Target temperature"))
                .Thermostat(currentTemperature: 68, pin: "1234", locked: true, zones: new[] { "Bedroom", "Bath" })
                .Reactive(evt => evt.TargetChanging, (args, p) =>
                    // The wing's range is the limit: a target outside it is capped at the nearest allowed degree.
                    p.When(args.Requested).NotEq(args.Clamp())
                        .Then(outside =>
                        {
                            args.Cancel.Set(true);
                            args.Reason.Set("Capped at the wing's limit");
                            outside.Component<Thermostat>(m => m.Target).Value.Set(args.Clamp());
                            outside.Element("target").Text.Set(args.Clamp());
                            outside.Element("capped").Show();
                        })
                        .Else(inside =>
                        {
                            args.Accept();
                            inside.Element("capped").Hide();
                        }))
                .Reactive(evt => evt.TargetChanged, (args, p) =>
                {
                    var thermostat = p.Component<Thermostat>(m => m.Target);
                    p.Element("target").Text.Set(args.Value);
                    p.Element("previous").Text.Set(args.Previous);
                    DescribeComfort(p);
                    p.When(thermostat.Schedule.Active).Truthy()
                        .Then(night => night.Element("night-active").Show())
                        .Else(day => day.Element("night-active").Hide());
                })
                .Reactive(evt => evt.Schedule.Applied, (args, p) =>
                {
                    // The schedule's own event: the thermostat's nested object raises it.
                    p.Element("night-applied").Text.Set(args.Target);
                    p.Element("night-active").Show();
                })
                .Reactive(evt => evt.Unlocked, p =>
                    p.Element("lock-status").Text.Set("Thermostat unlocked for Margaret's room.")); }

            <native-vstack gap="Xs">
                <native-text>Target <span id="target">@Model.Target</span>°F <span class="text-text-secondary">(was <span id="previous">@Model.Target</span>°F)</span></native-text>
                <p id="comfortable" class="text-sm text-success" hidden>The room is comfortable.</p>
                <p id="away" class="text-sm text-text-secondary" hidden>The room is <span id="distance"></span>° from the target; about <span id="minutes"></span> minutes to get there.</p>
                <p id="capped" class="text-sm text-warning" hidden>Capped at the wing's limit.</p>
                <native-text color="Secondary">Wing range <span id="range-min"></span>–<span id="range-max"></span>°F · Night setting <span id="next-change"></span></native-text>
                <p id="night-active" class="text-sm text-success" hidden>Night setting active: <span id="night-applied"></span>°F applied.</p>
                <native-text color="Secondary">Mode <span id="mode">heat</span> · Reading <span id="reading"></span></native-text>
                <p id="fan-running" class="text-sm text-text-secondary" hidden>The fan runs all night.</p>
                <native-text color="Secondary"><span id="zone-count">0</span> zones in the room.</native-text>
                <p id="bath-zone" class="text-sm text-text-secondary" hidden>The bath has its own zone at <span id="bath-target">@Model.Target</span>°F. <span id="bath-boosted" hidden>Boosted for the bath hour.</span></p>
            </native-vstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("warmer", "Warmer")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => p.Component<Thermostat>(m => m.Target).Increase()))
                @(Html.NativeButton("cooler", "Cooler")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => p.Component<Thermostat>(m => m.Target).Decrease()))
                @(Html.NativeButton("night-mode", "Night mode")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var thermostat = p.Component<Thermostat>(m => m.Target);
                        thermostat.Schedule.Apply();
                        p.Element("next-change").Text.Set(thermostat.Schedule.NextChange());
                    }))
                @(Html.NativeButton("heat", "Heat")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => SetMode(p, ThermostatMode.Heat)))
                @(Html.NativeButton("cool", "Cool")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => SetMode(p, ThermostatMode.Cool)))
                @(Html.NativeButton("off", "Off")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => SetMode(p, ThermostatMode.Off)))
                @(Html.NativeButton("fan-on", "Fan on")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => SetFan(p, ThermostatFan.On)))
                @(Html.NativeButton("fan-auto", "Fan auto")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => SetFan(p, ThermostatFan.Auto)))
                @(Html.NativeButton("boost-bath", "Boost the bath")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        // One zone of the list, used as the object: its own method, property and function.
                        var bath = p.Component<Thermostat>(m => m.Target).Zones.At(1);
                        bath.Boost();
                        p.Element("bath-target").Text.Set(bath.Target);
                        p.When(bath.IsBoosted()).Truthy()
                            .Then(boosted => boosted.Element("bath-boosted").Show())
                            .Else(plain => plain.Element("bath-boosted").Hide());
                    }))
                @(Html.NativeButton("quiet-hours", "Quiet hours overnight")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<Thermostat>(m => m.Target).SetQuietHours(new[] { "9:00 PM", "7:00 AM" })))
            </native-hstack>

            <native-grid cols="C2" gap="Base">
                @{ Html.InputField(plan, m => m.HoldMinutes, o => o.Label("Hold the target for (minutes)"))
                    .FusionNumericTextBox(b => b.Min(5).Max(120).Format("n0")); }
                @{ Html.InputField(plan, m => m.Pin, o => o.Label("Thermostat PIN"))
                    .NativeTextBox(b => b.Placeholder("Four digits").CssClass(Field)); }
            </native-grid>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("hold", "Hold the target")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<Thermostat>(m => m.Target).Hold(p.Component<FusionNumericTextBox>(m => m.HoldMinutes).Value)))
                @(Html.NativeButton("unlock", "Unlock the thermostat")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var thermostat = p.Component<Thermostat>(m => m.Target);
                        thermostat.Pin.Set(p.Component<NativeTextBox>(m => m.Pin).Value);
                        p.When(thermostat.Locked).Truthy()
                            .Then(still => still.Element("lock-status").Text.Set("Still locked: check the PIN."));
                    }))
                <native-text color="Secondary"><span id="lock-status"></span></native-text>
            </native-hstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("wing-plan", "Apply the wing's night plan")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Get(Url.SandboxRoute("NightPlan", "Thermostat"))
                            .Response(r => r.OnSuccess<ComfortPlan>((nightPlan, s) =>
                            {
                                var thermostat = s.Component<Thermostat>(m => m.Target);
                                thermostat.ApplyPlan(nightPlan);
                                s.Element("mode").Text.Set(thermostat.Mode);
                                s.Element("plan-summary").Text.Set(thermostat.Describe(nightPlan));
                                s.Element("next-change").Text.Set(thermostat.Schedule.NextChange());
                            }))))
                @(Html.NativeButton("summer-plan", "Apply the summer plan")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        // A plan written in the page: an object the method takes as it is.
                        var summer = new ComfortPlan
                        {
                            Target = 72,
                            Mode = ThermostatMode.Cool,
                            Nights = new List<NightSetting> { new NightSetting { Day = "Every night", Target = 72 } },
                        };
                        var thermostat = p.Component<Thermostat>(m => m.Target);
                        thermostat.ApplyPlan(summer);
                        p.Element("mode").Text.Set(thermostat.Mode);
                        p.Element("plan-summary").Text.Set(thermostat.Describe(summer));
                        p.Element("next-change").Text.Set(thermostat.Schedule.NextChange());
                    }))
                <native-text><span id="plan-summary"></span></native-text>
            </native-hstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("save-comfort", "Save")
                    .CssClass(ButtonSubmit)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Post(Url.SandboxRoute("Save", "Thermostat")).Gather(g => g.Form(FormId))
                            .Response(r => r.OnSuccess<RoomComfortSaved>((saved, s) =>
                                s.Element("confirmation").Text.Set(saved.Get(x => x.Confirmation))))))
                <native-text><span id="confirmation"></span></native-text>
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
