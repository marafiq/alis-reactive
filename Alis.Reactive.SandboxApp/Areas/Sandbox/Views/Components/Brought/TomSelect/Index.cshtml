@model SuiteAssignmentModel
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.SandboxApp.BroughtComponents
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Brought
@{
    ViewData["Title"] = "TomSelect";

    const string FormId = "suite-form";
    const string CompanionSlotId = "companion-slot";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string ButtonSubmit = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<SuiteAssignmentModel>();
    var rateUrl = Url.SandboxRouteTemplate("Rate", "TomSelect", "suiteType");
    var availabilityUrl = Url.SandboxRouteTemplate("Availability", "TomSelect", "suiteType");
    var suites = new[]
    {
        new TomSelectOption("studio", "Studio"),
        new TomSelectOption("one-bedroom", "One Bedroom"),
        new TomSelectOption("companion", "Companion Suite"),
        new TomSelectOption("memory-care", "Memory Care Suite"),
    };
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Suite Assignment</native-heading>
        <native-text color="Secondary">
            Assign the incoming resident to a suite type. Choosing a suite quotes its monthly rate and what is open; reserve it to prepare the move-in documents.
        </native-text>
    </div>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            <native-grid cols="C2" gap="Base">
                @{ Html.InputField(plan, m => m.SuiteType, o => o.Required().Label("Suite type"))
                    .TomSelect(suites, "Choose a suite type")
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        var suite = p.Component<TomSelect>(m => m.SuiteType);
                        p.When(suite.Get(x => x.Value)).NotEmpty()
                            .Then(quote => quote.Get(rateUrl)
                                .Gather(g => g.RouteParam("suiteType", suite.Get(x => x.Value)))
                                .Response(r => r
                                    .OnSuccess<SuiteRateResponse>((rate, s) =>
                                        s.Component<FusionNumericTextBox>(m => m.MonthlyRate)
                                            .Set(x => x.Value, rate.Read(x => x.MonthlyRate)))
                                    .Chained(next => next.Get(availabilityUrl)
                                        .Gather(g => g.RouteParam("suiteType", suite.Get(x => x.Value)))
                                        .Response(open => open
                                            .OnSuccess<SuiteAvailabilityResponse>((availability, s) =>
                                                s.Element("suite-availability").SetText(availability, x => x.Summary))))))
                            .Else(cleared =>
                            {
                                cleared.Component<FusionNumericTextBox>(m => m.MonthlyRate).Set(x => x.Value, 0m);
                                cleared.Element("suite-availability").SetText("Choose a suite type to see what is open.");
                            });
                    }); }

                @{ Html.InputField(plan, m => m.MonthlyRate, o => o.Label("Monthly rate ($)"))
                    .FusionNumericTextBox(b => b.Min(0).Format("n0").ShowSpinButton(false)); }
            </native-grid>

            <native-text color="Secondary"><span id="suite-availability">Choose a suite type to see what is open.</span></native-text>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("suite-recommend", "Use the recommended suite")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Get(Url.SandboxRoute("Recommendation", "TomSelect"))
                            .Response(r => r.OnSuccess<SuiteRecommendationResponse>((recommendation, s) =>
                                s.Component<TomSelect>(m => m.SuiteType)
                                    .Call(x => x.SetValue, recommendation.Read(x => x.SuiteType))));
                    }))
                @(Html.NativeButton("suite-clear", "Clear the choice")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Component<TomSelect>(m => m.SuiteType).Call(x => x.Clear);
                    }))
                @(Html.NativeButton("suite-reserve", "Reserve suite")
                    .CssClass(ButtonSubmit)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Post(Url.SandboxRoute("Reserve", "TomSelect"), g => g.IncludeAll())
                            .Validate<SuiteAssignmentValidator>(FormId)
                            .Response(r => r.OnSuccess<SuiteReservationResponse>((reservation, s) =>
                            {
                                s.Element("suite-confirmation").SetText(reservation, x => x.Confirmation);
                                s.Parallel(
                                        welcome => welcome.Get(Url.SandboxRoute("WelcomePacket", "TomSelect"))
                                            .Response(w => w.OnSuccess<MoveInDocumentResponse>((packet, ws) =>
                                                ws.Element("welcome-packet").SetText(packet, x => x.Title))),
                                        checklist => checklist.Get(Url.SandboxRoute("MoveInChecklist", "TomSelect"))
                                            .Response(c => c.OnSuccess<MoveInDocumentResponse>((list, cs) =>
                                                cs.Element("move-in-checklist").SetText(list, x => x.Title))))
                                    .OnAllSettled(done => done.Element("move-in-ready").SetText("Move-in documents are ready."));
                            }));
                    }))
            </native-hstack>

            <native-vstack gap="Xs">
                <native-text><span id="suite-confirmation"></span></native-text>
                <native-text color="Secondary"><span id="welcome-packet"></span></native-text>
                <native-text color="Secondary"><span id="move-in-checklist"></span></native-text>
                <native-text><span id="move-in-ready"></span></native-text>
            </native-vstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Companion</native-heading>
            <native-text color="Secondary">Moving in with a spouse or companion? Add their suite to the assignment.</native-text>
            <native-hstack gap="Sm">
                @(Html.NativeButton("companion-add", "Add a companion's suite")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Get(Url.SandboxRoute("Companion", "TomSelect"))
                            .Response(r => r.OnSuccess(s => s.Into(CompanionSlotId)));
                    }))
                @(Html.NativeButton("companion-remove", "Remove the companion")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Get(Url.SandboxRoute("NoCompanion", "TomSelect"))
                            .Response(r => r.OnSuccess(s => s.Into(CompanionSlotId)));
                    }))
            </native-hstack>
            <div id="@CompanionSlotId"></div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
