@model DeskOnDutyModel
@using Alis.Reactive.SandboxApp.BroughtComponents
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Brought
@using Microsoft.AspNetCore.Html
@{
    var plan = Html.ReactivePlan<DeskOnDutyModel>();

    // The bell is on the page already, so the desk writes no markup for it: its plan joins the bell by id
    // and listens only while this card is loaded. Unloading the card takes the desk's listeners with it
    // and leaves the bell as it was.
    plan.Render<CallBell>(NightCallModel.BellId, HtmlString.Empty)
        .Reactive(evt => evt.OnPressed, (call, p) =>
        {
            p.Element("desk-call").Text.Set(call.Presses);
            p.Element("desk-room").Text.Set(call.Room);
            p.Element("desk-notified").Show();
        })
        .Reactive(evt => evt.OnPressed, (call, p) =>
            // A second handler of the same callback: the third call tonight is escalated.
            p.When(call.Presses).Gte(3).Then(third => third.Element("escalated").Show()))
        .Reactive(evt => evt.OnCleared, (call, p) =>
        {
            p.Element("desk-answered").Text.Set(call.Presses);
            p.Element("desk-log").Show();
        });
}

<native-text>@Model.Nurse is on duty at the desk.</native-text>

@Html.RenderPlan(plan)
