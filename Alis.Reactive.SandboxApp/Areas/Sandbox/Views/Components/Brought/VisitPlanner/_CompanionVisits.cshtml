@model CompanionVisitPlanModel
@using Alis.Reactive.SandboxApp.BroughtComponents
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Brought
@{
    var plan = Html.ReactivePlan<CompanionVisitPlanModel>();
    var weekUrl = Url.SandboxRouteTemplate("Week", "VisitPlanner", "residentId");

    // The companion's week loads when the panel does.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(weekUrl)
            .Gather<ResidentWeekRequest>(g => g.Set(x => x.ResidentId, "ruth"))
            .Response(r => r.OnSuccess<ResidentWeekResponse>((week, s) =>
            {
                    var visitSlots = s.Component<VisitPlanner>(m => m.VisitSlots);
                    visitSlots.Wing.Set(week.Get(x => x.Wing));
                    visitSlots.Capacity.Set(week.Get(x => x.WeeklyVisits));
                    visitSlots.Slots.Set(week.Get(x => x.Slots));
            }))));
}

<div id="companion-visits">
<native-vstack gap="Sm">
    @{ Html.InputField(plan, m => m.VisitSlots, o => o.Label("Companion's visit times"))
        .VisitPlanner(capacity: 1)
        .Reactive(evt => evt.WeekChanged, (args, p) =>
        {
            p.Element("companion-planned").Text.Set(args.Count);
            p.Post(Url.SandboxRoute("CompanionHold", "VisitPlanner")).Gather(g => g.Form("companion-visits"))
                .Response(r => r.OnSuccess<CompanionHoldResponse>((hold, s) =>
                    s.Element("companion-held").Text.Set(hold.Get(x => x.Held))));
        }); }
    <native-text color="Secondary">Companion's visits planned: <span id="companion-planned">0</span> · Front desk holds: <span id="companion-held">nothing yet</span></native-text>
</native-vstack>
</div>

@Html.RenderPlan(plan)
