@model Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Brought.ArrivalCard
@* The arrival card the front desk opens in the drawer: plain markup, no plan of its own. *@
<div class="flex flex-col gap-2">
    <h3 id="arrival-time" class="text-base font-semibold text-text">@Model.Time</h3>
    <p id="arrival-room" class="text-sm text-text">Meet in @Model.Room.</p>
    <p id="arrival-greeter" class="text-sm text-text-secondary">@Model.Greeter greets the family at the front door.</p>
</div>
