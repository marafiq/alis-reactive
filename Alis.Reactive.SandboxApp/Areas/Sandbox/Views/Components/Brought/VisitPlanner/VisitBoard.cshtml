@model VisitBoardModel
@using Alis.Reactive.Builders.Conditions
@using Alis.Reactive.Native.Extensions
@using Alis.Reactive.Native.Components
@using Alis.Reactive.SandboxApp.BroughtComponents
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Brought
@{
    ViewData["Title"] = "Visit Board";

    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";

    var plan = Html.ReactivePlan<VisitBoardModel>();
    var slugify = plan.RegisterPlugin<VisitBoardSlugPlugin>();
    var weekUrl = Url.SandboxRouteTemplate("FrontDeskWeek", "VisitPlanner", "residentId");
    var takeUrl = Url.SandboxRouteTemplate("TakeVisit", "VisitPlanner", "slotId");
    var streamUrl = Url.Action("BoardStream", "VisitPlanner", new { area = "Sandbox", family = Context.Request.Query["family"].ToString() })
        ?? throw new InvalidOperationException("Could not resolve the visit board stream.");

    // The board opens on the resident's week, and reads facts back off the planner: the wing's board
    // code through a plugin, and the quiet times through an array over the planner's slots.
    Html.On(plan, t => t.DomReady(p =>
        p.Get(weekUrl)
            .Gather(g => g.RouteParam("residentId", p.FromUrl("resident")))
            .Response(r => r.OnSuccess<ResidentWeekResponse>((week, s) =>
            {
                var planner = s.Component<VisitPlanner>(m => m.VisitSlots);
                planner
                    .Set(c => c.Wing, week.Read(x => x.Wing))
                    .Set(c => c.Capacity, week.Read(x => x.WeeklyVisits))
                    .Set(c => c.Slots, week.Read(x => x.Slots));
                TypedPluginSource<string> boardCode = s.Plugin(slugify.Slug).Arg(planner.Get(c => c.Wing));
                s.Element("board-code").SetText(boardCode);
                s.Element("board-quiet").SetText(s.From(planner.Get(c => c.Slots)).Count(slot => slot.Quiet));
                s.Element("board-first-weekend").SetText(
                    s.From(planner.Get(c => c.Slots)).Where(slot => slot.Day == "Saturday" || slot.Day == "Sunday").Select(slot => slot.Label).Find(label => label != ""));
            }))));

    // Another desk's family took a time: if this family had it booked, release it and say so; either
    // way the planner shows the time as taken, and the change goes to the board's log.
    Html.On(plan, t => t.ServerPush<SlotTaken>(streamUrl, "slot-taken", (taken, p) =>
    {
        var planner = p.Component<VisitPlanner>(m => m.VisitSlots);
        var slot = p.Payload(taken).Get(x => x.Slot);
        p.When(planner.Get(c => c.IsBooked, slot)).Truthy()
            .Then(mine =>
            {
                mine.Component<VisitPlanner>(m => m.VisitSlots).Call(c => c.Release, mine.Payload(taken).Get(x => x.Slot));
                mine.Element("board-alert").SetText(taken, x => x.Message);
                mine.Element("board-alert").AddClass("text-danger");
            })
            .Else(other =>
            {
                other.Element("board-alert").SetText(taken, x => x.Message);
                other.Element("board-alert").RemoveClass("text-danger");
            });
        planner.Call(c => c.MarkTaken, slot, p.Payload(taken).Get(x => x.Family));
        p.DispatchWith<BoardChange>("board-changed", change => change
            .Set(x => x.Summary, p.Payload(taken).Get(x => x.Message))
            .Set(x => x.Booked, planner.Get(c => c.Count)));
    }));

    Html.On(plan, t => t.CustomEvent<BoardChange>("board-changed", (change, p) =>
    {
        p.Element("board-log").SetText(change, x => x.Summary);
        p.Element("board-log-booked").SetText(change, x => x.Booked);
    }));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Visit Board</native-heading>
        <native-text color="Secondary">
            Every desk sees the week as it is: when a family at another desk takes a time, it shows here at once.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-text>
                Board <span id="board-code" class="font-mono">—</span> ·
                quiet times this week: <span id="board-quiet">0</span> ·
                first weekend time: <span id="board-first-weekend">—</span>
            </native-text>

            @{ Html.InputField(plan, m => m.VisitSlots, o => o.Label("This family's visit times"))
                .VisitPlanner(capacity: 1)
                .Reactive(evt => evt.WeekChanged, (args, p) =>
                {
                    var planner = p.Component<VisitPlanner>(m => m.VisitSlots);
                    p.Element("board-weekend").SetText(
                        p.From(args, x => x.Value).Count(id => id.StartsWith("sat") || id.StartsWith("sun")));

                    p.When(planner.Get(c => c.Remaining)).Eq(0)
                        .Then(full =>
                        {
                            full.Element("board-capacity").SetText("This week is full.");
                            full.Element("board-capacity").AddClass("text-warning");
                        })
                        .ElseIf(planner.Get(c => c.Remaining)).Eq(1)
                        .Then(one =>
                        {
                            one.Element("board-capacity").SetText("One visit left this week.");
                            one.Element("board-capacity").RemoveClass("text-warning");
                        })
                        .Else(more =>
                        {
                            more.Element("board-capacity").SetText("More than one visit left this week.");
                            more.Element("board-capacity").RemoveClass("text-warning");
                        });

                    p.When(args, x => x.Added).NotEmpty()
                        .Then(added => added.Post(takeUrl, g => g
                                .RouteParam("slotId", args, x => x.Added)
                                .FromUrl("family"))
                            .Response(r => r.OnSuccess<DeskMessage>((held, s) =>
                                s.Element("board-status").SetText(held, x => x.Message))));
                }); }

            <native-vstack gap="Xs">
                <native-text>Weekend visits booked: <span id="board-weekend">0</span> · <span id="board-capacity">No visits booked yet.</span></native-text>
                <native-text><span id="board-status">Nothing taken at this desk yet.</span></native-text>
                <native-text><span id="board-alert">No other desk has taken a time.</span></native-text>
                <native-text color="Secondary">Last change on the board: <span id="board-log">none</span> (this family now has <span id="board-log-booked">0</span> booked)</native-text>
            </native-vstack>

            @(Html.NativeButton("board-legend-toggle", "Show the legend")
                .CssClass(ButtonSecondary)
                .Reactive(plan, evt => evt.Click, (args, p) =>
                {
                    p.Element("board-legend").ToggleClass("hidden");
                    p.Element("board-legend").SetHtml("<strong>Taken</strong> times belong to another desk's family; <em>dashed</em> times are quiet hours.");
                }))
            <p id="board-legend" class="hidden text-sm text-text-secondary"></p>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
