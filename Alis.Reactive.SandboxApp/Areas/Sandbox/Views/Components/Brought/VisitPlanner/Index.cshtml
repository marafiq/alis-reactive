@model FamilyVisitPlanModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@using Alis.Reactive.SandboxApp.BroughtComponents
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Components.Brought
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Family Visits";

    const string FormId = "visit-form";
    const string CompanionSlotId = "companion-slot";
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string ButtonSubmit = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<FamilyVisitPlanModel>();
    var weekUrl = Url.SandboxRouteTemplate("Week", "VisitPlanner", "residentId");
    var residents = new List<SelectListItem>
    {
        new SelectListItem("Margaret Hale", "margaret"),
        new SelectListItem("Harold Benson", "harold"),
    };
    var requestedTimes = new List<SelectListItem>
    {
        new SelectListItem("Mon 10:00 AM", "mon-10"),
        new SelectListItem("Sat 11:00 AM", "sat-11"),
        new SelectListItem("Sun 11:00 AM", "sun-11"),
    };

    Html.On(plan, t => t.DomReady(p =>
        p.Component<VisitPlanner>(m => m.VisitSlots).EmptyMessage.Set("Choose a resident to see this week's visit times.")));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Family Visits</native-heading>
        <native-text color="Secondary">
            Plan a family's visits with a resident for the week. Each wing offers its own times; quiet hours cannot be booked.
        </native-text>
    </div>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            <native-grid cols="C2" gap="Base">
                @{ Html.InputField(plan, m => m.ResidentId, o => o.Required().Label("Resident"))
                    .NativeDropDown(b => b.Items(residents).Placeholder("-- Choose a resident --").CssClass(Field))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        var resident = p.Component<NativeDropDown>(m => m.ResidentId);
                        p.When(resident.Value).NotEmpty()
                            .Then(load => load.Get(weekUrl)
                                .Gather<ResidentWeekRequest>(g => g.Set(x => x.ResidentId, resident.Value))
                                .Response(r => r.OnSuccess<ResidentWeekResponse>((week, s) =>
                                {
                                    var visitSlots = s.Component<VisitPlanner>(m => m.VisitSlots);
                                    visitSlots.Wing.Set(week.Get(x => x.Wing));
                                    visitSlots.Capacity.Set(week.Get(x => x.WeeklyVisits));
                                    visitSlots.Slots.Set(week.Get(x => x.Slots));
                                    s.Element("resident-name").Text.Set(week.Get(x => x.ResidentName));
                                })));
                    }); }

                @{ Html.InputField(plan, m => m.Visitors, o => o.Label("Visitors per visit"))
                    .FusionNumericTextBox(b => b.Min(1).Max(6).Format("n0")); }
            </native-grid>

            @{ Html.InputField(plan, m => m.VisitSlots, o => o.Required().Label("Visit times"))
                .VisitPlanner(capacity: 1)
                .Reactive(evt => evt.SlotsLoaded, (args, p) =>
                {
                    p.Element("offered-count").Text.Set(args.Count);
                    p.When(p.Component<VisitPlanner>(m => m.VisitSlots).OfferedDays).ArrayContains("Sunday")
                        .Then(sunday => sunday.Element("sunday-offered").Show())
                        .Else(none => none.Element("sunday-offered").Hide());
                })
                .Reactive(evt => evt.BeforeBook, (args, p) =>
                    p.When(args.Slot.Get(x => x.Quiet)).Truthy()
                        .Then(quiet =>
                        {
                            args.Cancel.Set(true);
                            quiet.Element("quiet-slot").Text.Set(args.Slot.Get(x => x.Label));
                            quiet.Element("quiet-hours").Show();
                        })
                        .Else(open => open.Element("quiet-hours").Hide()))
                .Reactive(evt => evt.Full, (args, p) =>
                    // Swapping releases and books from inside the planner's own full event: each
                    // raises change, whose handler runs before this one goes on.
                    p.When(p.Component<NativeCheckBox>(m => m.SwapWhenFull).Checked).Truthy()
                        .Then(swap =>
                        {
                            var planner = swap.Component<VisitPlanner>(m => m.VisitSlots);
                            planner.Release(planner.FirstBooked());
                            planner.Select(args.Attempted);
                        })
                        .Else(refuse =>
                        {
                            args.Waitlist();
                            refuse.Element("week-full-capacity").Text.Set(args.Capacity);
                            refuse.Element("week-full").Show();
                        }))
                .Reactive(evt => evt.WeekChanged, (args, p) =>
                {
                    var planner = p.Component<VisitPlanner>(m => m.VisitSlots);
                    p.Element("week-full").Hide();
                    p.Element("planned-count").Text.Set(args.Count);
                    p.Element("visits-left").Text.Set(planner.Remaining());
                    p.When(args.Added).NotEmpty()
                        .Then(added => added.Component<VisitPlanner>(m => m.VisitSlots).Book(args.Added,
                            added.Component<FusionNumericTextBox>(m => m.Visitors).Value,
                            added.Component<NativeTextBox>(m => m.Note).Value));
                    p.When(planner.Count).Gt(0)
                        .Then(some => some.Element("plan-empty").Hide())
                        .Else(none => none.Element("plan-empty").Show());
                    // Every visit the week allows is planned when the count meets the planner's capacity.
                    p.When(args.Count).NotEq(planner.Capacity)
                        .Then(open => open.Element("week-all-planned").Hide())
                        .Else(planned => planned.Element("week-all-planned").Show());
                    p.When(args.Value).ArrayContains("sun-11")
                        .Then(brunch => brunch.Element("brunch-planned").Show())
                        .Else(none => none.Element("brunch-planned").Hide());
                }); }

            @{ Html.InputField(plan, m => m.Note, o => o.Label("Note for the front desk"))
                .NativeTextBox(b => b.Placeholder("Bring the photo album").CssClass(Field)); }

            <native-grid cols="C2" gap="Base">
                @{ Html.InputField(plan, m => m.RequestedTime, o => o.Label("Time the family asked for"))
                    .NativeDropDown(b => b.Items(requestedTimes).Placeholder("-- Choose a time --").CssClass(Field)); }
                <native-vstack gap="Xs">
                    @(Html.NativeButton("check-requested", "Check the requested time")
                        .CssClass(ButtonSecondary)
                        .Reactive(plan, evt => evt.Click, (args, p) =>
                        {
                            var requested = p.Component<NativeDropDown>(m => m.RequestedTime);
                            p.When(p.Component<VisitPlanner>(m => m.VisitSlots).IsBooked(requested.Value)).Truthy()
                                .Then(t => t.Element("requested-status").Text.Set("That time is already booked for the family."))
                                .Else(e => e.Element("requested-status").Text.Set("That time is not booked yet."));
                        }))
                    <native-text color="Secondary"><span id="requested-status"></span></native-text>
                </native-vstack>
            </native-grid>

            @{ Html.InputField(plan, m => m.SwapWhenFull, o => o.Label("When the week is full, replace the earliest visit"))
                .NativeCheckBox(b => b.CssClass("rounded border-border")); }

            @{ Html.InputField(plan, m => m.LockWeek, o => o.Label("Lock this week"))
                .NativeCheckBox(b => b.CssClass("rounded border-border"))
                .Reactive(evt => evt.Change, (args, p) =>
                    p.Component<VisitPlanner>(m => m.VisitSlots).ReadOnly.Set(p.Component<NativeCheckBox>(m => m.LockWeek).Checked)); }

            <native-vstack gap="Xs">
                <native-text><span id="resident-name">No resident chosen</span> · <span id="offered-count">0</span> times offered</native-text>
                <native-text>Planned: <span id="planned-count">0</span> · Left this week: <span id="visits-left">1</span></native-text>
                <native-text color="Secondary"><span id="plan-empty">No visits planned yet.</span></native-text>
                <p id="sunday-offered" class="text-sm text-text-secondary" hidden>Sunday visits are offered this week.</p>
                <p id="quiet-hours" class="text-sm text-warning" hidden><span id="quiet-slot"></span> is during quiet hours; choose another time.</p>
                <p id="week-full" class="text-sm text-warning" hidden>This week is full: <span id="week-full-capacity"></span> visits.</p>
                <p id="brunch-planned" class="text-sm text-success" hidden>Sunday brunch with the family is planned.</p>
                <p id="week-all-planned" class="text-sm text-success" hidden>Every visit this week is planned.</p>
            </native-vstack>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("book-first-open", "Book the first open time")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var planner = p.Component<VisitPlanner>(m => m.VisitSlots);
                        planner.Select(planner.FirstOpen());
                    }))
                @(Html.NativeButton("check-brunch", "Is Sunday brunch booked?")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.When(p.Component<VisitPlanner>(m => m.VisitSlots).IsBooked("sun-11")).Truthy()
                            .Then(t => t.Element("brunch-status").Text.Set("Sunday brunch is booked."))
                            .Else(e => e.Element("brunch-status").Text.Set("Sunday brunch is still open."));
                    }))
                @(Html.NativeButton("clear-week", "Clear the week")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        // A locked week keeps its visits: it is cleared only while the lock is off.
                        p.When(p.Component<NativeCheckBox>(m => m.LockWeek).Checked).Falsy()
                            .Then(open =>
                            {
                                open.Component<VisitPlanner>(m => m.VisitSlots).Clear();
                                open.Element("clear-status").Text.Set("");
                            })
                            .Else(locked => locked.Element("clear-status").Text.Set("Unlock the week before clearing it."))))
                @(Html.NativeButton("share-week", "Share the week with the family")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var planner = p.Component<VisitPlanner>(m => m.VisitSlots);
                        p.Element("share-status").Text.Set("Preparing the summary...");
                        planner.PrepareSummary();
                        p.When(planner.Summary()).NotEmpty()
                            .Then(ready =>
                            {
                                ready.Element("family-summary").Text.Set(planner.Summary());
                                ready.Element("share-status").Text.Set("Summary ready to send.");
                            })
                            .Else(empty => empty.Element("share-status").Text.Set("Plan a visit before sharing the week."));
                    }))
                @(Html.NativeButton("save-visits", "Save visits")
                    .CssClass(ButtonSubmit)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Post(Url.SandboxRoute("Save", "VisitPlanner")).Gather(g => g.Form())
                            .Validate<FamilyVisitPlanValidator>(FormId)
                            .Response(r => r
                                .OnSuccess<VisitPlanSaved>((saved, s) =>
                                    s.Element("visit-confirmation").Text.Set(saved.Get(x => x.Confirmation)))
                                .OnError(400, e => e.ValidationErrors(FormId)));
                    }))
            </native-hstack>

            <native-text color="Secondary"><span id="brunch-status"></span> <span id="clear-status"></span></native-text>
            <native-text><span id="share-status"></span> <span id="family-summary"></span></native-text>
            <native-text><span id="visit-confirmation"></span></native-text>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-heading level="H2">Companion</native-heading>
            <native-text color="Secondary">Moving in with a spouse? Plan the companion's visits too; the front desk holds each time as it is booked.</native-text>
            <native-hstack gap="Sm">
                @(Html.NativeButton("companion-add", "Plan the companion's visits")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Get(Url.SandboxRoute("Companion", "VisitPlanner"))
                            .Response(r => r.OnSuccess(s => s.Into(CompanionSlotId)))))
                @(Html.NativeButton("companion-remove", "No companion")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Get(Url.SandboxRoute("NoCompanion", "VisitPlanner"))
                            .Response(r => r.OnSuccess(s => s.Into(CompanionSlotId)))))
            </native-hstack>
            <div id="@CompanionSlotId"></div>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
