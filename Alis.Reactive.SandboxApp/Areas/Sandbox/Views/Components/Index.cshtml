@{
    ViewData["Title"] = "Components";
}

<h1 class="text-2xl font-bold text-text-primary mb-2">Components</h1>
<p class="text-text-secondary mb-8">Input and display vertical slices, grouped by component family across the Native and Fusion vendors</p>

<div class="mt-2 mb-6 flex items-center gap-3">
    <span class="inline-flex items-center rounded-full bg-success/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-success ring-1 ring-success/20">Native</span>
    <div class="h-px flex-1 bg-border/50"></div>
</div>

<section class="mb-10">
    <div class="flex items-center gap-3 mb-4">
        <span class="w-1 h-6 rounded-full bg-success"></span>
        <h2 class="text-lg font-semibold text-text-primary">Inputs</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <a asp-area="Sandbox" asp-controller="NativeButton" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    NativeButton
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Fire drill: one button starts and ends the drill, and reporting a missing resident puts the cursor on calling the charge nurse
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NativeTextBox" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    NativeTextBox
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Visitor sign-in: a returning visitor's phone fills in their name and badge, and the visitor is signed in to see a resident
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NativeTextArea" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    NativeTextArea
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Shift handover: start from the template, flag an incident for the night nurse, and send the handover
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="CheckBox" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    CheckBox
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Shower log: the care plan ticks the shower chair, a declined shower puts the details away, and a skin concern asks to tell the nurse
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NativeCheckList" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    NativeCheckList
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Fall prevention round: confirm a resident's fall risk factors, tick tonight's precautions and record the round
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NativeCheckList" asp-action="DietPlan"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Diet Plan
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                A checklist bound to a List&lt;string&gt; opens with the restrictions on file checked and saves them back
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NativeDropDown" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    NativeDropDown
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Van booking: a medical trip sends a nurse aide, and when the van is out the next free time is chosen
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NativeRadioGroup" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    NativeRadioGroup
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Move-in preferences: care level, room type and meal plan; memory care books an assessment and a suite on that floor is warned against
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NativeHiddenField" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    NativeHiddenField
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Night room checks: hidden fields carry the wing, the round's start and the resident in the room with every check
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NativeHiddenField" asp-action="CareLevelChange"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Care Level Change
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                A server-decided yes/no flag carried in a hidden field ("False"/"True") reaches the server as the same answer
            </p>
        </a>
    </div>
</section>

<section class="mb-10">
    <div class="flex items-center gap-3 mb-4">
        <span class="w-1 h-6 rounded-full bg-success"></span>
        <h2 class="text-lg font-semibold text-text-primary">Operations</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <a asp-area="Sandbox" asp-controller="ArrayOps" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    ArrayOps
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Wing census: the morning stand-up reads each wing's census figures and the programs running today
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="DomOps" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    DomOps
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Lunch seating: read each table's seating, supervision, sodium plates and safety flags off its card
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="ShiftReport" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    ShiftReport
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Shift alert review: review a shift's alerts and what is still open before signing
            </p>
        </a>
    </div>
</section>

<div class="mt-2 mb-6 flex items-center gap-3">
    <span class="inline-flex items-center rounded-full bg-info/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-info ring-1 ring-info/20">Fusion</span>
    <div class="h-px flex-1 bg-border/50"></div>
</div>

<section class="mb-10">
    <div class="flex items-center gap-3 mb-4">
        <span class="w-1 h-6 rounded-full bg-info"></span>
        <h2 class="text-lg font-semibold text-text-primary">Buttons &amp; Actions</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <a asp-area="Sandbox" asp-controller="Button" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Button
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Syncfusion button with typed content, disabled state, styling, focus, and click methods
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="DropDownButton" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    DropDownButton
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Shift reports: the charge nurse prints the wing's end-of-shift reports from one menu, none printed twice
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="SplitButton" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    SplitButton
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Care note: write, sign and save a note to the chart, telling the family or the nurse in the same step when it matters
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="ProgressButton" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    ProgressButton
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Medication pass report: send the evening pass to the pharmacy from a button that shows how much has gone
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="Toolbar" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Toolbar
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Typed toolbar button state, content, click payloads, and enabled/disabled control
            </p>
        </a>
    </div>
</section>

<section class="mb-10">
    <div class="flex items-center gap-3 mb-4">
        <span class="w-1 h-6 rounded-full bg-info"></span>
        <h2 class="text-lg font-semibold text-text-primary">Text Entry</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <a asp-area="Sandbox" asp-controller="TextBox" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    TextBox
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Short text entry with typed value reads, writes, focus methods, icons, and input/change payloads
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="TextArea" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    TextArea
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Daily care log: write the day-shift note, start from the night shift's, sign it, and save it to the log
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="NumericTextBox" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    NumericTextBox
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                A resident's monthly service plan — set catered meals and wellness check-ins with steppers, plan templates, and guided entry
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="OtpInput" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    OtpInput
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Visitor check-in: match each visitor by the code texted to them, fix a mistyped digit, and give a code to a walk-in
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="InputMask" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    InputMask
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Family phone numbers: masked phone entry, refused until all ten digits are in; copy the son's number as the emergency contact
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="RichTextEditor" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    RichTextEditor
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Family newsletter: write the formatted paragraph, preview it as families will see it, and save it with its word count
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="FusionInPlaceEditor" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    FusionInPlaceEditor
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Resident profile: correct the face sheet in place, row by row, each correction checked by the server
