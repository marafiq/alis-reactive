@model RoomWhiteboardModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.SandboxApp.BroughtComponents
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.CoreBehaviors.RoomWhiteboard
@{
    ViewData["Title"] = "Room Whiteboard";

    const string Input = "rounded-md border border-border px-3 py-1.5 text-sm w-full";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";

    var plan = Html.ReactivePlan<RoomWhiteboardModel>();

    Html.On(plan, t => t
        // The check scheduled is read from the event and written into the board's nullable property.
        .CustomEvent(RoomWhiteboardEvents.CheckScheduled, (check, p) =>
            p.Component<Whiteboard>(RoomWhiteboardModel.BoardId).NextCheckMinutes.Set(check.Get(x => x.Minutes)))
        .CustomEvent(RoomWhiteboardEvents.BoardPosted, (post, p) =>
        {
            p.Element("posted-nurse").Text.Set(post.Get(x => x.Nurse));
            p.Element("posted-room").Text.Set(post.Get(x => x.Room));
            p.Element("posted-goal").Text.Set(post.Get(x => x.Check.Goal));
            // A board with no check scheduled posts its check as null, and the desk says so.
            p.When(post.Get(x => x.Check.Minutes)).IsNull()
                .Then(none =>
                {
                    none.Element("posted-no-check").Show();
                    none.Element("posted-check-in").Hide();
                })
                .Else(scheduled =>
                {
                    scheduled.Element("posted-minutes").Text.Set(post.Get(x => x.Check.Minutes));
                    scheduled.Element("posted-check-in").Show();
                    scheduled.Element("posted-no-check").Hide();
                });
            p.Element("posted").Show();
        }));
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Room Whiteboard</native-heading>
        <native-text color="Secondary">
            Margaret Hale's whiteboard, kept up to date by the evening nurse: who is on, the day's goal, the next check and the notes.
        </native-text>
    </div>

    <native-card><native-card-body id="room-card">
        <native-vstack gap="Base">
            @(plan.Whiteboard(RoomWhiteboardModel.BoardId, nurse: "Nurse Okafor")
                .Reactive(evt => evt.NoteAdded, (note, p) =>
                {
                    p.Element("heard-number").Text.Set(note.Number);
                    p.Element("heard-text").Text.Set(note.Text);
                    p.Element("heard-note").Show();
                })
                .Reactive(evt => evt.Wiped, p => p.Element("wiped-line").Show()))

            <p id="banner" class="text-sm text-text-secondary" hidden></p>

            <native-grid cols="C3" gap="Base">
                @{ Html.InputField(plan, m => m.Goal, o => o.Label("Today's goal"))
                    .NativeTextBox(b => b.Placeholder("Walk to the dining room").CssClass(Input)); }
                @{ Html.InputField(plan, m => m.PageWho, o => o.Label("Who to page"))
                    .NativeTextBox(b => b.Placeholder("Aide Reyes").CssClass(Input)); }
                @{ Html.InputField(plan, m => m.Note, o => o.Label("Note"))
                    .NativeTextBox(b => b.Placeholder("Likes the window open").CssClass(Input)); }
            </native-grid>

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("take-shift", "Take the shift")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var board = p.Component<Whiteboard>(RoomWhiteboardModel.BoardId);
                        board.Nurse.Set("Nurse Patel");
                        p.Element("on-duty").Text.Set(board.Nurse);
                    }))
                @(Html.NativeButton("post-goal", "Post the goal")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<Whiteboard>(RoomWhiteboardModel.BoardId).Goal.Set(p.Component<NativeTextBox>(m => m.Goal).Value)))
                @(Html.NativeButton("schedule-check", "Schedule a check in 30 minutes")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Dispatch(RoomWhiteboardEvents.CheckScheduled, new CheckSchedule { Minutes = 30 })))
                @(Html.NativeButton("clear-check", "Clear the check")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<Whiteboard>(RoomWhiteboardModel.BoardId).NextCheckMinutes.Set(null)))
                @(Html.NativeButton("page-charge", "Page the charge nurse")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<Whiteboard>(RoomWhiteboardModel.BoardId).Page("the charge nurse")))
                @(Html.NativeButton("page-who", "Page")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<Whiteboard>(RoomWhiteboardModel.BoardId).Page(p.Component<NativeTextBox>(m => m.PageWho).Value)))
                @(Html.NativeButton("highlight-goal", "Highlight the goal")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Component<Whiteboard>(RoomWhiteboardModel.BoardId).Highlight(Field.Of((WhiteboardRows r) => r.Goal))))
                @(Html.NativeButton("add-note", "Add the note")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        // The number is drawn once and used twice: by the board and by the line beside it.
                        var board = p.Component<Whiteboard>(RoomWhiteboardModel.BoardId);
                        var number = board.NextNoteNumber();
                        board.AddNote(number, p.Component<NativeTextBox>(m => m.Note).Value);
                        p.Element("last-number").Text.Set(number);
                        p.Element("note-count").Text.Set(board.Notes);
                    }))
                @(Html.NativeButton("refresh-board", "Refresh the board")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        // The refresh is a promise: what follows waits for it, and the motto arrives when its promise settles.
                        var board = p.Component<Whiteboard>(RoomWhiteboardModel.BoardId);
                        board.Refresh();
                        p.Element("refresh-line").Text.Set(board.LastRefresh);
                        p.Element("motto").Text.Set(board.LoadMotto());
                    }))
                @(Html.NativeButton("quiet-hours", "Start quiet hours")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Element("banner").Html.Set("<strong>Quiet hours</strong> from 9 PM");
                        p.Element("banner").Show();
                    }))
                @(Html.NativeButton("end-quiet-hours", "End quiet hours")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => p.Element("banner").Hide()))
                @(Html.NativeButton("flag-room", "Flag the room")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => p.Element("room-card").ClassList.Add("room-flagged")))
                @(Html.NativeButton("unflag-room", "Clear the flag")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => p.Element("room-card").ClassList.Remove("room-flagged")))
                @(Html.NativeButton("night-light", "Night light")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => p.Element("room-card").ClassList.Toggle("night-light")))
                @(Html.NativeButton("post-board", "Post the board to the desk")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        var board = p.Component<Whiteboard>(RoomWhiteboardModel.BoardId);
                        p.Dispatch(RoomWhiteboardEvents.BoardPosted, d => d
                            .Set(x => x.Nurse, board.Nurse)
                            .Set(x => x.Room, "12")
                            .Set(x => x.Check.Minutes, board.NextCheckMinutes)
                            .Set(x => x.Check.Goal, p.Component<NativeTextBox>(m => m.Goal).Value));
                    }))
                @(Html.NativeButton("hand-over", "Hand over to Nurse Okafor")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        // Each line runs after the one before it: the board names the nurse it held at that line.
                        var board = p.Component<Whiteboard>(RoomWhiteboardModel.BoardId);
                        p.Element("handover-from").Text.Set(board.Nurse);
                        board.Nurse.Set("Nurse Okafor");
                        p.Element("handover-to").Text.Set(board.Nurse);
                        p.Element("handover-line").Show();
                    }))
                @(Html.NativeButton("wipe-board", "Wipe the notes")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => p.Component<Whiteboard>(RoomWhiteboardModel.BoardId).Wipe()))
            </native-hstack>

            <native-vstack gap="Xs">
                <native-text color="Secondary">On duty: <span id="on-duty">Nurse Okafor</span></native-text>
                <native-text color="Secondary">Last note number <span id="last-number">none</span> · <span id="note-count">0</span> notes on the board</native-text>
                <p id="heard-note" class="text-sm" hidden>Desk heard note <span id="heard-number"></span>: <span id="heard-text"></span></p>
                <p id="wiped-line" class="text-sm text-text-secondary" hidden>The notes were wiped.</p>
                <native-text color="Secondary"><span id="refresh-line">Not refreshed yet</span> · Motto: <span id="motto"></span></native-text>
                <p id="posted" class="text-sm" hidden>Desk has the board: <span id="posted-nurse"></span> in room <span id="posted-room"></span>, <span id="posted-check-in" hidden>next check in <span id="posted-minutes"></span> min</span><span id="posted-no-check" hidden>no check scheduled</span>, goal "<span id="posted-goal"></span>".</p>
                <p id="handover-line" class="text-sm" hidden>Handed over from <span id="handover-from"></span> to <span id="handover-to"></span>.</p>
            </native-vstack>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
