@{
    ViewData["Title"] = "Core Behaviors";
}

<h1 class="text-2xl font-bold text-text-primary mb-2">Core Behaviors</h1>
<p class="text-text-secondary mb-8">Plan execution fundamentals</p>

<native-grid cols="C3" gap="Base">
    <a asp-area="Sandbox" asp-controller="Events" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Events
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Live 3-hop event chain firing in sequence, DOM updates on each hop, console trace output showing two-phase boot
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="Payload" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Payload
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Live display of all primitive types (int, string, bool) and nested objects (address.city, address.zip) resolved from event payload to DOM text
        </p>
    </a>

    <a asp-area="Sandbox" asp-controller="DispatchSource" asp-action="Index"
       class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
        <native-hstack justify="Between" align="Start">
            <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                Dispatch Source
            </h3>
            <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
        </native-hstack>
        <p class="mt-2 text-sm text-text-secondary leading-relaxed">
            Dispatch a custom event from a pipeline and see another behavior react to it -- cross-component messaging via the plan
        </p>
    </a>
</native-grid>
