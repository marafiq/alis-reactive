@model EventsViewModel
@{
    ViewData["Title"] = "Events & Dispatch";

    var plan = Html.ReactivePlan<EventsViewModel>();

    // DomReady dispatches after CustomEvent listeners are wired, so this chain runs in order.
    Html.On(plan, t => t.DomReady(p =>
    {
        p.Element("step-1").ClassList.Add("text-green-600");
        p.Element("step-1").Text.Set("dom-ready fired → dispatched \"test\"");
        p.Dispatch(EventsEvents.Test);
    }));

    Html.On(plan, t => t.CustomEvent(EventsEvents.Test, p =>
    {
        p.Element("step-2").ClassList.Add("text-green-600");
        p.Element("step-2").Text.Set("\"test\" received → dispatched \"test-received\"");
        p.Dispatch(EventsEvents.TestReceived);
    }));

    Html.On(plan, t => t.CustomEvent<EventsViewModel>(EventsEvents.TestReceived, (payload, p) =>
    {
        p.Element("step-3").ClassList.Add("text-green-600");
        p.Element("step-3").Text.Set("\"test-received\" received → dispatched \"final\" with payload");
        p.Dispatch(EventsEvents.Final, new EventsViewModel { EventName = "done" });
    }));

    Html.On(plan, t => t.CustomEvent(EventsEvents.Final, p =>
    {
        p.Element("chain-status").ClassList.Remove("text-text-muted");
        p.Element("chain-status").ClassList.Add("text-green-600");
        p.Element("chain-status").ClassList.Add("font-semibold");
        p.Element("chain-status").Text.Set("Chain complete — all 3 hops executed successfully");
    }));

    var formattedJson = plan.RenderFormatted();
}

<native-vstack gap="Lg">
    <native-heading level="H1">Events &amp; Dispatch</native-heading>
    <native-text color="Secondary">
        Three-hop event chain: dom-ready dispatches "test" &rarr; "test-received" &rarr; "final" with payload.
        Open DevTools console to see trace output.
    </native-text>

    <native-card><native-card-body>
        <native-heading level="H2">Event Chain Status</native-heading>
        <native-vstack gap="Sm" class="font-mono text-sm">
            <p id="step-1" class="text-text-muted">Step 1: waiting for dom-ready...</p>
            <p id="step-2" class="text-text-muted">Step 2: waiting for "test" event...</p>
            <p id="step-3" class="text-text-muted">Step 3: waiting for "test-received" event...</p>
            <p id="chain-status" class="text-text-muted mt-4">Chain not started</p>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Plan JSON</native-heading>
        <pre class="rounded-md bg-slate-900 text-emerald-400 p-4 font-mono text-xs overflow-x-auto"><code id="plan-json">@Html.Raw(formattedJson)</code></pre>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">C# DSL</native-heading>
        <pre class="rounded-md bg-slate-900 text-sky-400 p-4 font-mono text-xs overflow-x-auto"><code>Html.On(plan, t =&gt; t.DomReady(p =&gt;
{
    p.Element("step-1").ClassList.Add("text-green-600");
    p.Element("step-1").Text.Set("dom-ready fired");
    p.Dispatch(EventsEvents.Test);
}));

Html.On(plan, t =&gt; t.CustomEvent(EventsEvents.Test, p =&gt;
{
    p.Element("step-2").ClassList.Add("text-green-600");
    p.Dispatch(EventsEvents.TestReceived);
}));

Html.On(plan, t =&gt; t.CustomEvent&lt;EventsViewModel&gt;("test-received", (payload, p) =&gt;
{
    p.Element("step-3").ClassList.Add("text-green-600");
    p.Dispatch(EventsEvents.Final, new EventsViewModel { EventName = "done" });
}));

Html.On(plan, t =&gt; t.CustomEvent(EventsEvents.Final, p =&gt;
{
    p.Element("chain-status").ClassList.Remove("text-text-muted");
    p.Element("chain-status").ClassList.Add("text-green-600");
    p.Element("chain-status").Text.Set("Chain complete");
}));</code></pre>
    </native-card-body></native-card>

    <native-card><native-card-body>
        <native-heading level="H2">Runtime Boot (TypeScript)</native-heading>
        <pre class="rounded-md bg-slate-900 text-amber-400 p-4 font-mono text-xs overflow-x-auto"><code>// Two-phase boot: wire listeners first, then execute dom-ready
export function boot(plan: Plan): void {
  const deferred: Entry[] = [];

  for (const entry of plan.entries) {
    if (entry.trigger.kind === "dom-ready") {
      deferred.push(entry);
    } else {
      wireTrigger(entry.trigger, entry.reaction);
    }
  }

  for (const entry of deferred) {
    wireTrigger(entry.trigger, entry.reaction);
  }
}</code></pre>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
