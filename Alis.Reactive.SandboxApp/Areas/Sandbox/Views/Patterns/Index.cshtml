@{
    ViewData["Title"] = "Patterns";
}

<h1 class="text-2xl font-bold text-text-primary mb-2">Patterns</h1>
<p class="text-text-secondary mb-8">Integration scenarios combining multiple framework concerns</p>

<section class="mb-10">
    <div class="flex items-center gap-3 mb-4">
        <span class="w-1 h-6 rounded-full bg-info"></span>
        <h2 class="text-lg font-semibold text-text-primary">Cascading</h2>
    </div>
    <native-grid cols="C3" gap="Base">
        <a asp-area="Sandbox" asp-controller="BedAssignment" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Bed Assignment
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Choose a wing, then a room with an open bed, then the bed: each list follows the one before from the server, and the server confirms the bed assigned
            </p>
        </a>
    </native-grid>
</section>

<section class="mb-10">
    <div class="flex items-center gap-3 mb-4">
        <span class="w-1 h-6 rounded-full bg-success"></span>
        <h2 class="text-lg font-semibold text-text-primary">Reactive Wiring</h2>
    </div>
    <native-grid cols="C3" gap="Base">
        <a asp-area="Sandbox" asp-controller="RoomOffer" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Room Offer
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Prepare a room offer: the care level sets the deposit, the wing fills its floor and rate, and the deposit goes to whoever signs it off
            </p>
        </a>
    </native-grid>
</section>

<section class="mb-10">
    <div class="flex items-center gap-3 mb-4">
        <span class="w-1 h-6 rounded-full bg-accent"></span>
        <h2 class="text-lg font-semibold text-text-primary">Form Patterns</h2>
    </div>
    <native-grid cols="C3" gap="Base">
        <a asp-area="Sandbox" asp-controller="IdGenerator" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    IdGenerator
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                See how element IDs are auto-generated from model expressions — inspect DOM to verify deterministic IDs
            </p>
        </a>
    </native-grid>
</section>

<section class="mb-10">
    <div class="flex items-center gap-3 mb-4">
        <span class="w-1 h-6 rounded-full bg-[#9333EA]"></span>
        <h2 class="text-lg font-semibold text-text-primary">Workflows</h2>
    </div>
    <native-grid cols="C3" gap="Base">
        <a asp-area="Sandbox" asp-controller="MoveInPacket" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Move-in Packet
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Complete a new resident's packet with one answer from every kind of field, save it and send it to the business office; each confirms every answer it received
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="Todo" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Todo
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Complete Todo app: add items, toggle done, delete — full create/read/update/delete with validation and server persistence
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="BddExperiment" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Admit a Resident
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                An admissions coordinator admits a new resident: the page lists what is missing, and the server confirms the admission in its own words or refuses a physician whose panel is full
            </p>
        </a>

        <a asp-area="Sandbox" asp-controller="AdmissionWizard" asp-action="Index"
           class="group relative block rounded-2xl border border-border/60 bg-white p-6 shadow-sm ring-1 ring-black/[0.03] hover:shadow-lg hover:border-primary/20 hover:-translate-y-0.5 transition-all duration-200">
            <native-hstack justify="Between" align="Start">
                <h3 class="text-[15px] font-semibold text-text-primary group-hover:text-primary transition-colors">
                    Admission Wizard
                </h3>
                <span class="text-text-muted group-hover:text-primary transition-colors text-sm">&rarr;</span>
            </native-hstack>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                Server-loaded step workflow with partial replacement, draft persistence, per-step validation, and final server-side cross-step submission.
            </p>
        </a>
    </native-grid>
</section>
