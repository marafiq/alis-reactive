@model RoomEveningModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.SandboxApp.BroughtComponents
@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Patterns.RoomEvening
@{
    ViewData["Title"] = "Room 12 Evening";

    const string FormId = "evening-form";
    const string VisitSlotId = "visit-slot";
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm w-full";
    const string ButtonSecondary = "rounded-md border border-border bg-white px-4 py-2 text-sm font-medium text-text hover:bg-surface-subtle transition-colors";
    const string ButtonSubmit = "rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors";

    var plan = Html.ReactivePlan<RoomEveningModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Room 12 Evening</native-heading>
        <native-text color="Secondary">
            Margaret Hale's evening. The aide keeps the log, answers the bell, and opens a family visit as a card in the log; the visit's own escort card opens inside it.
        </native-text>
    </div>

    <native-card><native-card-body>
        <native-vstack gap="Base">
            <native-grid cols="C2" gap="Base">
                @(plan.CallBell(RoomEveningModel.BellId, room: Model.Room)
                    .Reactive(evt => evt.OnCleared, (call, p) =>
                    {
                        p.Element("bell-answered").Text.Set(call.Presses);
                        p.Element("answered-line").Show();
                    }))
                <native-vstack gap="Xs">
                    <native-text color="Secondary"><span id="shift-status">Evening shift on duty.</span></native-text>
                    <p id="answered-line" class="text-sm text-success" hidden>Bell answered after <span id="bell-answered"></span> calls.</p>
                </native-vstack>
            </native-grid>
            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("answer-bell", "Answer the bell")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) => p.Component<CallBell>(RoomEveningModel.BellId).Clear()))
                @(Html.NativeButton("shift-change", "Shift change")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        p.Dispatch(RoomEveningEvents.ShiftChanged);
                        p.Element("shift-status").Text.Set("Night shift on duty.");
                    }))
                @(Html.NativeButton("page-escort", "Page the escort")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                    {
                        // The escort card must be on the page: with no card, the first line fails and the second never runs.
                        p.Element("escort-status").Text.Set("Escort paged from the room.");
                        p.Element("shift-status").Text.Set("Escort paged.");
                    }))
            </native-hstack>
        </native-vstack>
    </native-card-body></native-card>

    <native-card><native-card-body id="@FormId">
        <native-vstack gap="Base">
            <native-heading level="H2">Evening log</native-heading>
            @{ Html.InputField(plan, m => m.RoomNote, o => o.Required().Label("Room note"))
                .NativeTextBox(b => b.CssClass(Field)); }

            <native-hstack gap="Sm" class="flex-wrap">
                @(Html.NativeButton("open-visit", "Open the family visit")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Get(Url.SandboxRoute("FamilyVisit", "RoomEvening"))
                            .Response(r => r.OnSuccess(s => s.Into(VisitSlotId)))))
                @(Html.NativeButton("end-visit", "End the visit")
                    .CssClass(ButtonSecondary)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Get(Url.SandboxRoute("QuietNight", "RoomEvening"))
                            .Response(r => r.OnSuccess(s => s.Into(VisitSlotId)))))
                @(Html.NativeButton("save-log", "Save the evening log")
                    .CssClass(ButtonSubmit)
                    .Reactive(plan, evt => evt.Click, (args, p) =>
                        p.Post(Url.SandboxRoute("SaveLog", "RoomEvening")).Gather(g => g.Form())
                            .Validate<RoomLogValidator>(FormId)
                            .Response(r => r.OnSuccess<RoomLogSaved>((saved, s) =>
                                s.Element("log-status").Text.Set(saved.Get(x => x.Confirmation))))))
            </native-hstack>

            <div id="@VisitSlotId"><native-text color="Secondary">No visit this evening.</native-text></div>
            <native-text><span id="log-status">The evening log is not saved yet.</span></native-text>
        </native-vstack>
    </native-card-body></native-card>
</native-vstack>

@Html.RenderPlan(plan)
