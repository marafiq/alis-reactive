@using Alis.Reactive.SandboxApp.Areas.Sandbox.Models.Patterns.ResidentAdmission
@model AdmitResidentModel
@using Alis.Reactive.Native.Components
@using Alis.Reactive.Fusion.Components
@{
    ViewData["Title"] = "Admit a Resident";

    const string FormId = "admission-form";
    const string Field = "rounded-md border border-border px-3 py-1.5 text-sm";

    var plan = Html.ReactivePlan<AdmitResidentModel>();
}

<native-vstack gap="Lg">
    <div>
        <native-heading level="H1">Admit a Resident</native-heading>
        <native-text color="Secondary">Maple Grove admissions: admitting <span id="admission-resident">a new resident</span>.</native-text>
    </div>

    <native-card><native-card-body>
        <form id="admission-form">
            <native-grid cols="C2" gap="Base">
                @{ Html.InputField(plan, m => m.ResidentName, o => o.Required().Label("Resident name"))
                    .NativeTextBox(b => b.Placeholder("Full name").CssClass(Field))
                    .Reactive(evt => evt.Change, (args, p) => p.Element("admission-resident").Text.Set(args.Value)); }

                @{ Html.InputField(plan, m => m.Physician, o => o.Required().Label("Attending physician"))
                    .FusionAutoComplete(b => b
                        .DataSource(AttendingPhysician.All)
                        .Fields<AttendingPhysician>(t => t.Name, v => v.NameWithCredentials)
                        .Placeholder("Search by name"))
                    .Reactive(evt => evt.Change, (args, p) => p.Element("physician-notice").Text.Set(args.Value)); }

                @{ Html.InputField(plan, m => m.CareLevel, o => o.Label("Care level"))
                    .FusionDropDownList(b => b
                        .DataSource(AdmissionCareLevel.All)
                        .Fields<AdmissionCareLevel>(t => t.Name, v => v.Code)
                        .Placeholder("Choose a care level"))
                    .Reactive(evt => evt.Change, (args, p) =>
                    {
                        p.When(args.Value).Eq("memory")
                            .Then(memory => memory.Element("memory-care-note").Show())
                            .Else(other => other.Element("memory-care-note").Hide());
                    }); }

                @{ Html.InputField(plan, m => m.MonthlyRate, o => o.Required().Label("Monthly rate"))
                    .FusionNumericTextBox(b => b.Min(0).Max(20000).Step(100).Format("c2")); }

                @{ Html.InputField(plan, m => m.MovesInToday, o => o.Label("Moving in today"))
                    .FusionSwitch(); }

                @{ Html.InputField(plan, m => m.Notes, o => o.Label("Notes"))
                    .NativeTextBox(b => b.Placeholder("Preferences, family requests").CssClass(Field)); }
            </native-grid>
        </form>

        <native-vstack gap="Xs" class="mt-4">
            <native-text>The admission notice goes to <span id="physician-notice">the attending physician</span>.</native-text>
            <p id="memory-care-note" hidden class="text-sm text-warning">
                Memory care admissions need a cognitive assessment on file before move-in.
            </p>
        </native-vstack>
    </native-card-body></native-card>

    <native-hstack gap="Base">
        @(Html.NativeButton("admit-resident-btn", "Admit Resident")
            .CssClass("rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors")
            .Reactive(plan, evt => evt.Click, (args, p) =>
            {
                p.Post(Url.SandboxRoute("Submit", "BddExperiment")).Gather(g => g.Form())
                 .Validate<AdmitResidentValidator>(FormId)
                 .WhileLoading(l => l.Element("admission-status").Text.Set("Admitting the resident..."))
                 .Response(r => r
                    .OnSuccess<ResidentAdmitted>((json, s) =>
                    {
                        s.Element("admission-status").Text.Set(json.Get(x => x.Message));
                        s.Element("admission-status").ClassList.Add("text-green-700");
                        s.Element("admission-status").ClassList.Remove("text-red-700");
                    })
                    .OnError(400, e =>
                    {
                        e.Element("admission-status").Text.Set("Not admitted: correct the marked fields.");
                        e.Element("admission-status").ClassList.Add("text-red-700");
                        e.Element("admission-status").ClassList.Remove("text-green-700");
                        e.ValidationErrors(FormId);
                    }));
            }))
        <p id="admission-status" class="text-sm text-text-muted">Not admitted yet.</p>
    </native-hstack>
</native-vstack>

@Html.RenderPlan(plan)
