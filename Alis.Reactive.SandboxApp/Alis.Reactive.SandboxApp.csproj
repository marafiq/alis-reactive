<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>alis-sandbox-secrets</UserSecretsId>
        <NoWarn>$(NoWarn);CS8603;CS8618;MVC1000</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alis.Reactive.Analyzers\Alis.Reactive.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <!-- The look this app chose; the component packages do not bring one. -->
        <ProjectReference Include="..\Alis.Reactive.DesignSystem\Alis.Reactive.DesignSystem.csproj" />
        <ProjectReference Include="..\Alis.Reactive.Fusion\Alis.Reactive.Fusion.csproj" />
        <ProjectReference Include="..\Alis.Reactive.Native\Alis.Reactive.Native.csproj" />
        <ProjectReference Include="..\Alis.Reactive.NativeTagHelpers\Alis.Reactive.NativeTagHelpers.csproj" />
        <ProjectReference Include="..\Alis.Reactive\Alis.Reactive.csproj" />
    </ItemGroup>

    <!-- The theme the design system copies into Styles\ before each build, as its NuGet does for an app. -->
    <Import Project="..\Alis.Reactive.DesignSystem\build\AlisReactive.DesignSystem.targets" />
    <Import Project="..\build\AlisReactiveBrowserAssets.targets" />

</Project>
