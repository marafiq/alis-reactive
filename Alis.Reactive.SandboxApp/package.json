{
  "name": "alis-reactive-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sandbox app — its own browser assets (plugins JS, sandbox CSS) and its copy of the Syncfusion files it links. Not shipped.",
  "scripts": {
    "build": "npm run build:vendor && npm run build:plugins && npm run build:css",
    "build:vendor": "node copy-vendor.mjs",
    "build:plugins": "node esbuild.config.mjs",
    "build:css": "tailwindcss -i Styles/sandbox.css -o wwwroot/css/sandbox.css --minify",
    "watch:plugins": "node esbuild.config.mjs --watch",
    "watch:css": "tailwindcss -i Styles/sandbox.css -o wwwroot/css/sandbox.css --watch",
    "typecheck": "tsc --project Scripts/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.11",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@syncfusion/ej2": "33.1.47",
    "tom-select": "2.6.2"
  }
}
