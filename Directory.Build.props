<Project>
  <PropertyGroup>
    <!-- VersionPrefix is the dev/local default only. Released versions come from the git tag:
         nuget-publish.yml derives the version from the pushed v* tag (v1.0.0-rc.1 -> 1.0.0-rc.1)
         and passes it to dotnet pack via -p:Version. Bump this only for local pack/dev convenience. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Alis Solutions</Authors>
    <Company>Alis Solutions</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/marafiq/alis-reactive</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/marafiq/alis-reactive</PackageProjectUrl>
    <Copyright>Copyright (c) Alis Solutions 2026</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>14.0</LangVersion>
    <!-- XML documentation warnings are suppressed solution-wide so
         GenerateDocumentationFile still emits XML docs without flooding normal builds. -->
    <NoWarn>$(NoWarn);CS0419;CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1591;CS1711;CS1712</NoWarn>
    <!-- Single handoff point between the npm build and dotnet pack: npm builds
         the framework browser bundles into Alis.Reactive.Assets/dist/; the
         asset-bearing packages (AlisReactive, .DesignSystem, .Fusion) pack
         their bundle from here. One definition, three consumers. -->
    <AlisAssetsDist>$(MSBuildThisFileDirectory)Alis.Reactive.Assets\dist</AlisAssetsDist>
    <!-- Production-grade package provenance: snupkg symbols + SourceLink (built into the .NET SDK
         for GitHub repos via PublishRepositoryUrl) + deterministic CI builds. Lets consumers step
         into the framework source and makes release builds reproducible. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
